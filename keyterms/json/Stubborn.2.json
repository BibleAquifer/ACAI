  "localizations": {
    "eng": {
      "preferred_label": "Stubborn (Discobedient)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Having a heart that refuses to listen or change, even when it should."
        }
      ]
    },
    "apd": {
      "preferred_label": "عنيد (عاصي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "امتلاك قلب رافض يسمع أو يتغيّر، حتى لمّا المفروض يتغيّر."
        }
      ]
    },
    "arb": {
      "preferred_label": "عنيد (عاصٍ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "امتلاك قلب يرفض الاستماع أو التغيير، حتى عندما ينبغي له ذلك."
        }
      ]
    },
    "bis": {
      "preferred_label": "stronghed (no wantem obei)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gat wan hat we i no wantem lesin no jenisim tingting, nating se i sud mekem olsem."
        }
      ]
    },
    "fra": {
      "preferred_label": "têtu (désobéissant)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Avoir un cœur qui refuse d'écouter ou de changer, même lorsqu'il le devrait."
        }
      ]
    },
    "hau": {
      "preferred_label": "Taurin Kai (Marar Biyayya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa da zuciyar da ta ƙi ji ko ta ƙi canjawa, ko da a lokacin da ya kamata a yi hakan."
        }
      ]
    },
    "hin": {
      "preferred_label": "हठी (आज्ञा न मानने वाला)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसा मन होना जो सुनने या बदलने से इनकार करता है, तब भी जब उसे ऐसा करना चाहिए।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Isiike (Nnupu isi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe obi nke jụrụ ige ntị ma ọ bụ ịgbanwe, ọbụna mgbe o kwesịrị ime otú ahụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "keras kepala (tidak taat)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memiliki hati yang menolak untuk mendengarkan atau berubah, bahkan ketika seharusnya ia mau berubah."
        }
      ]
    },
    "nep": {
      "preferred_label": "हठी (आज्ञा नमान्‍ने)",
      "descriptions": [
        {
          "source": "acai",
          "description": "सुन्‍नु वा बदलिनुपर्ने अवस्थामा पनि नसुन्‍ने वा बदलिन इन्कार गर्ने हृदय हुनु।"
        }
      ]
    },
    "por": {
      "preferred_label": "obstinado (desobediente)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ter um coração que se recusa a ouvir ou a mudar, mesmo quando deveria."
        }
      ]
    },
    "rus": {
      "preferred_label": "Упрямый (непокорный)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Свойство сердца, которое отказывается слушать или меняться, даже когда следовало бы."
        }
      ]
    },
    "spa": {
      "preferred_label": "obstinado (desobediente)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tener un corazón que se niega a escuchar o a cambiar, aun cuando debería hacerlo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mkaidi (Asiyetii)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa na moyo unaokataa kusikiliza au kubadilika, hata wakati unapopaswa kufanya hivyo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "biket (sakim tok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "I gat bel i pas na i no laik harim tok o senisim tingting, maski em i mas senis."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cứng lòng (không vâng lời)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Có tấm lòng từ chối lắng nghe hoặc không chịu thay đổi, ngay cả khi đáng lẽ phải làm vậy."
        }
      ]
    },
    "zhs": {
      "preferred_label": "顽梗（不顺服）",
      "descriptions": [
        {
          "source": "acai",
          "description": "内心顽梗不肯听从或改变，即便本应当改变。"
        }
      ]
    },
    "zht": {
      "preferred_label": "頑梗（悖逆）",
      "descriptions": [
        {
          "source": "acai",
          "description": "擁有一顆即便應當聽從或改變時，仍拒絕聽從或改變的心。"
        }
      ]
    }
  },
