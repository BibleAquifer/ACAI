{
  "id": "keyterm:Circumsize",
  "primary_id": "keyterm:Circumcision",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "003774001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "To Circumsize",
      "alternate_labels": [
        "Circumcision"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To cut off the skin on a male's private part to show belonging to God's people, which also should come with a change in the heart."
        }
      ]
    },
    "ind": {
      "preferred_label": "menyunat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memotong kulit pada alat kelamin laki-laki untuk menunjukkan keanggotaan dalam umat Allah, yang juga harus disertai dengan perubahan hati."
        }
      ]
    },
    "apd": {
      "preferred_label": "يختن (الجسد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "قطع الجلدة في العضو التناسلي للذكر لإظهار الانتماء لشعب الله، والشي دا كمان مفروض يجي مع تغيير في القلب."
        }
      ]
    },
    "arb": {
      "preferred_label": "خَتَنَ (أن يختن)",
      "descriptions": [
        {
          "source": "acai",
          "description": "قطع الجلد الذي يغطي العضو التناسلي للذكر لإظهار الانتماء إلى شعب الله، وهو ما ينبغي أن يقترن أيضًا بتغيير في القلب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem sakomsaes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong katemaot skin long sem blong man blong soemaot se hem i man blong God, we i mas kamaot wetem wan jenis long hat tu."
        }
      ]
    },
    "fra": {
      "preferred_label": "circoncire",
      "descriptions": [
        {
          "source": "acai",
          "description": "Couper la peau de la partie intime d'un homme pour manifester l'appartenance au peuple de Dieu, ce qui doit aussi s'accompagner d'un changement de cœur."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin kaciya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yanke fatar kan azakarin namiji don nuna zama na mutanen Allah, wanda kuma ya kamata ya zo tare da sauyi a zuciya."
        }
      ]
    },
    "hin": {
      "preferred_label": "खतना करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर की प्रजा से संबंध रखने के चिन्ह के रूप में पुरुष के गुप्तांग के अगले भाग की त्वचा को काटना, जो कि हृदय के परिवर्तन के साथ भी होना चाहिए।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ibi ugwu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igbubi akpụkpọ anụ ahụ dị nʼamụ nwoke iji gosi na a bụ onye nke Chineke, nke kwesịkwara iso mgbanwe nʼime obi bịa."
        }
      ]
    },
    "nep": {
      "preferred_label": "खतना गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरका मानिसहरूमा सामेल भएको देखाउन पुरुषको अङ्गको छाला काट्नु, जुन हृदयको परिवर्तनसँगै पनि आउनुपर्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "circuncidar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cortar a pele do órgão genital masculino para demonstrar pertencimento ao povo de Deus, o que também deve ser acompanhado por uma mudança no coração."
        }
      ]
    },
    "rus": {
      "preferred_label": "Обрезать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Удалять крайнюю плоть у мужчины в знак принадлежности к Божьему народу, что также должно сопровождаться изменением сердца."
        }
      ]
    },
    "spa": {
      "preferred_label": "circuncidar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cortar la piel de la parte íntima de un varón para mostrar pertenencia al pueblo de Dios, lo cual también debería ir acompañado de un cambio en el corazón."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutahiriwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kukata ngozi kwenye sehemu ya siri ya mwanamume ili kuonyesha kuwa mmoja wa watu wa Mungu, jambo ambalo pia linapaswa kuambatana na mabadiliko moyoni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Katim skin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Katim skin bilong kok bilong man bilong soim olsem em i bilong lain bilong God, na dispela pasin tu i mas kamap wantaim senis long bel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Làm lễ cắt bì",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cắt bỏ lớp da bọc quy đầu của nam giới để thể hiện việc thuộc về dân Đức Chúa Trời, điều này cũng cần đi đôi với sự đổi mới của tấm lòng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "受割礼",
      "descriptions": [
        {
          "source": "acai",
          "description": "切除男性私处的包皮以表明属于上帝的子民，这也当伴随着内心的改变。"
        }
      ]
    },
    "zht": {
      "preferred_label": "行割禮",
      "descriptions": [
        {
          "source": "acai",
          "description": "割除男性生殖器上的包皮，以表明屬於上帝的子民，這也應當伴隨著內心的改變。"
        }
      ]
    }
  },
