{
  "id": "keyterm:SimplePerson",
  "primary_id": "keyterm:SimplePerson",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "006076001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Simple Person",
      "alternate_labels": [
        "Simpleness",
        "Ignorance"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A person who is easily led or tricked because they do not have much wisdom or experience."
        }
      ]
    },
    "spa": {
      "preferred_label": "inexperto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una persona que es fácil de guiar o engañar porque no tiene mucha sabiduría o experiencia."
        }
      ]
    },
    "fra": {
      "preferred_label": "personne simple",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une personne facile à égarer ou à tromper parce qu'elle manque de sagesse ou d'expérience."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang yang tak berpengalaman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seseorang yang mudah dipengaruhi atau ditipu karena mereka tidak memiliki banyak hikmat atau pengalaman."
        }
      ]
    },
    "por": {
      "preferred_label": "pessoa simples",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma pessoa que é facilmente conduzida ou enganada porque não tem muita sabedoria ou experiência."
        }
      ]
    },
    "apd": {
      "preferred_label": "زول بسيط",
      "descriptions": [
        {
          "source": "acai",
          "description": "زول ساهل ينقاد أو يتخدع عشان ما عندو حكمة كتيرة أو خبرة."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَخصٌ بَسِيط",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَخصٌ يَسهُلُ قِيَادَتُهُ أَو خِدَاعُهُ لِأَنَّهُ لَا يَملِكُ كَثِيرًا مِنَ الحِكمَةِ أَوِ الخِبرَةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "man we i no gat hed",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we ol narawan oli save lidim no trikim hem kwiktaem from we hem i no gat tumas waes no eksperiens."
        }
      ]
    },
    "hau": {
      "preferred_label": "Marar Azanci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin da yake da sauƙin rinjaya ko ruɗa saboda ba shi da hikima ko gogewa sosai."
        }
      ]
    },
    "hin": {
      "preferred_label": "भोला व्यक्ति",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसा व्यक्ति जिसे आसानी से बहकाया या ठगा जा सकता है क्योंकि उसके पास अधिक बुद्धि या अनुभव नहीं होता।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye na-enweghị uche",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye a na-eduhie ma ọ bụ na-aghọgbu ngwa ngwa nʼihi na o nweghị amamihe ma ọ bụ ahụmahụ dị ukwuu."
        }
      ]
    },
    "nep": {
      "preferred_label": "सोझो मानिस",
      "descriptions": [
        {
          "source": "acai",
          "description": "धेरै ज्ञान वा अनुभव नभएको कारण सजिलै बहकिने वा ठगिने व्यक्ति।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Простой человек",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, которого легко обмануть или сбить с пути, потому что у него мало мудрости или опыта."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mtu Mjinga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu anayeongozwa au kudanganywa kwa urahisi kwa sababu hana hekima au uzoefu mwingi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "man i no gat gutpela tingting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man i no gat planti save o ekspiriens, olsem na em i isi long ol arapela man i giamanim em o stiaim em long rot kranki."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người đơn sơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người dễ bị dẫn dụ hoặc lừa gạt vì thiếu sự khôn ngoan hoặc kinh nghiệm."
        }
      ]
    },
    "zhs": {
      "preferred_label": "愚蒙人",
      "descriptions": [
        {
          "source": "acai",
          "description": "由于缺乏智慧或经验而容易受引导或受骗的人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "愚蒙人",
      "descriptions": [
        {
          "source": "acai",
          "description": "因為缺乏智慧或經驗而容易受引導或受騙的人。"
        }
      ]
    }
  },
