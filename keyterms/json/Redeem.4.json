  "type": "keyterm",
  "keyterm_type": "miscellaneous",
  "ubsdbh": [
    "005780001001000",
    "005783001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "To Redeem (Substitute)",
      "descriptions": [
        {
          "source": "acai",
          "description": "To save a person or animal from death or slavery by giving something else in their place."
        }
      ]
    },
    "spa": {
      "preferred_label": "redimir (sustituir)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Salvar a una persona o animal de la muerte o la esclavitud dando algo más en su lugar."
        }
      ]
    },
    "fra": {
      "preferred_label": "racheter (substituer)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sauver une personne ou un animal de la mort ou de l'esclavage en donnant autre chose à sa place."
        }
      ]
    },
    "ind": {
      "preferred_label": "menebus (pengganti)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyelamatkan seseorang atau hewan dari kematian atau perbudakan dengan memberikan sesuatu yang lain sebagai gantinya."
        }
      ]
    },
    "apd": {
      "preferred_label": "يفدي (بديل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنقاذ زول أو حيوان من الموت أو العبودية بتقديم حاجة تانية بدله."
        }
      ]
    },
    "arb": {
      "preferred_label": "فدى (بديل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنقاذ إنسان أو حيوان من الموت أو العبودية بتقديم شيء آخر مكانه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Pemaot (Jenis)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong sevem wan man no anamol long ded no wok slef tru long we yu givim narafala samting long ples blong hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fansa (Madadi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuɓutar da mutum ko dabba daga mutuwa ko bauta ta wurin bayar da wani abu a madadinsu."
        }
      ]
    },
    "hin": {
      "preferred_label": "छुड़ाना (बदला देकर)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या पशु के स्थान पर कुछ और देकर उसे मृत्यु या दासत्व से बचाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgbapụta (Ihe Nnọchi Anya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịzọpụta mmadụ ma ọ bụ anụmanụ site n'ọnwụ ma ọ bụ n'ohu site n'inye ihe ọzọ n'ọnọdụ ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "छुटाउनु (सट्टामा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै व्यक्तिको वा पशुको बदलामा अन्य केही दिएर मृत्यु वा दासत्वबाट छुटाउनु वा बचाउनु।"
        }
      ]
    },
    "por": {
      "preferred_label": "resgatar (substituição)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Salvar uma pessoa ou animal da morte ou da escravidão entregando outra coisa em seu lugar."
        }
      ]
    },
    "rus": {
      "preferred_label": "Выкупать (заменять)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Спасти человека или животное от смерти или рабства, отдав что-то другое взамен."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kukomboa (Kutoa Badala)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumwokoa mtu au mnyama kutoka kwenye kifo au utumwa kwa kutoa kitu kingine badala yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Baim bek (olsem senis)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Baim bek wanpela man o animal long dai o long stap kalabus long rot bilong givim narapela samting olsem senis."
        }
      ]
    },
    "vie": {
      "preferred_label": "Chuộc (thay thế)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cứu một người hoặc con vật khỏi phải chết hoặc khỏi ách nô lệ bằng cách nộp một vật khác để thế chỗ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赎回 (代赎)",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过付出其他事物代替，将人或动物从死亡或奴役中解救出来。"
        }
      ]
    },
    "zht": {
      "preferred_label": "代贖 (代替)",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由用其他事物替代，來拯救人或牲畜免於死亡或奴役。"
        }
      ]
    }
  },
