{
  "id": "keyterm:Dedicate",
  "primary_id": "keyterm:Consecration.2",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "53.44",
    "88.26"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Dedicate",
      "alternate_labels": [
        "Consecrate"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To give yourself or something fully to God with loyalty and for His service."
        }
      ]
    },
    "fra": {
      "preferred_label": "consacrer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Se donner ou donner quelque chose entièrement à Dieu avec fidélité et pour son service."
        }
      ]
    },
    "ind": {
      "preferred_label": "menguduskan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyerahkan diri sendiri atau sesuatu sepenuhnya kepada Allah dengan kesetiaan dan untuk melayani-Nya."
        }
      ]
    },
    "por": {
      "preferred_label": "dedicar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Entregar a si mesmo ou algo plenamente a Deus, com lealdade e para o Seu serviço."
        }
      ]
    },
    "apd": {
      "preferred_label": "تكريس",
      "descriptions": [
        {
          "source": "acai",
          "description": "تسليم نفسك أو شي بالكامل لله بأمانة ولخدمته."
        }
      ]
    },
    "arb": {
      "preferred_label": "يكرس",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يكرس المرء نفسه أو شيئًا بالكامل لله بأمانة وخدمة له."
        }
      ]
    },
    "bis": {
      "preferred_label": "Givim i go long God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong givim yu wan no wan samting fulwan i go long God wetem tru tingting mo blong mekem wok blong hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Keɓe kai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ba da kai ko wani abu gaba ɗaya ga Allah da aminci da kuma domin hidimarsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "समर्पण करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "अपने आप को या किसी वस्तु को पूरी निष्ठा के साथ और परमेश्वर की सेवा के लिए उसे पूरी तरह सौंपना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Inyefe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inyefe onwe gị ma ọ bụ ihe ọbụla kpamkpam nʼaka Chineke site nʼikwesị ntụkwasị obi nakwa maka ozi Ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "समर्पण गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफूलाई वा कुनै कुरालाई वफादारीसाथ र उहाँको सेवाका निम्ति पूर्ण रूपमा परमेश्‍वरमा अर्पण गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Посвящать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Полностью посвящать себя или что-либо Богу с верностью и для служения Ему."
        }
      ]
    },
    "spa": {
      "preferred_label": "consagrar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Entregarse a uno mismo o dar algo plenamente a Dios con lealtad y para su servicio."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuweka Wakfu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kujitoa mwenyewe au kutoa kitu kikamilifu kwa Mungu kwa uaminifu na kwa ajili ya huduma Yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Givim olgeta long God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long givim yu yet o wanpela samting olgeta long God wantaim pasin bilong stap tru long em na bilong mekim wok bilong en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Dâng hiến",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hiến dâng trọn vẹn bản thân hoặc một điều gì đó cho Đức Chúa Trời với lòng trung thành và để phục vụ Ngài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "奉献",
      "descriptions": [
        {
          "source": "acai",
          "description": "忠心且全然地将自己或某物献给上帝，供祂使用。"
        }
      ]
    },
    "zht": {
      "preferred_label": "奉獻",
      "descriptions": [
        {
          "source": "acai",
          "description": "忠心將自己或某物完全獻給上帝，為祂所用並服事祂。"
        }
      ]
    }
  },
