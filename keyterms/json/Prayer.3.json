{
  "id": "keyterm:Prayer.3",
  "primary_id": "keyterm:Pray",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "33.178",
    "33.179"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Prayer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Speaking to God to praise, thank, or ask for His help."
        }
      ]
    },
    "spa": {
      "preferred_label": "oración",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hablar con Dios para alabarle, darle gracias o pedir su ayuda."
        }
      ]
    },
    "fra": {
      "preferred_label": "prière",
      "descriptions": [
        {
          "source": "acai",
          "description": "S'adresser à Dieu pour le louer, le remercier ou lui demander son aide."
        }
      ]
    },
    "ind": {
      "preferred_label": "doa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Berbicara kepada Allah untuk memuji, bersyukur, atau memohon pertolongan-Nya."
        }
      ]
    },
    "por": {
      "preferred_label": "oração",
      "descriptions": [
        {
          "source": "acai",
          "description": "Falar com Deus para louvar, agradecer ou pedir a Sua ajuda."
        }
      ]
    },
    "apd": {
      "preferred_label": "صلاة",
      "descriptions": [
        {
          "source": "acai",
          "description": "الكلام مع الله عشان تحمده، تشكره، أو تطلب منه المساعدة."
        }
      ]
    },
    "arb": {
      "preferred_label": "صلاة",
      "descriptions": [
        {
          "source": "acai",
          "description": "التحدث إلى الله لتسبيحه أو شكره أو طلب معونته."
        }
      ]
    },
    "bis": {
      "preferred_label": "Prea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Toktok long God blong presem hem, talem tangkiu long hem, o askem hem blong givhan."
        }
      ]
    },
    "hau": {
      "preferred_label": "Addu’a",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin magana da Allah don yabon sa, gode masa, ko neman taimakonsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रार्थना",
      "descriptions": [
        {
          "source": "acai",
          "description": "स्तुति करने, धन्यवाद देने या सहायता माँगने के लिए परमेश्वर से बात करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ekpere",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịgwa Chineke okwu iji too ya, kelee ya, ma ọ bụ rịọ maka enyemaka ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रार्थना",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको प्रशंसा गर्न, धन्यवाद दिन वा उहाँको सहायता माग्न उहाँसँग बोल्ने काम।"
        }
      ]
    },
    "rus": {
      "preferred_label": "молитва",
      "descriptions": [
        {
          "source": "acai",
          "description": "Обращение к Богу, чтобы прославить Его, поблагодарить или попросить о Его помощи."
        }
      ]
    },
    "swh": {
      "preferred_label": "Maombi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuzungumza na Mungu ili kumsifu, kumshukuru, au kuomba msaada wake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Prea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Toktok wantaim God bilong litimapim nem bilong em, tenkyu long em, o askim long helpim bilong em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự cầu nguyện",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thưa chuyện với Đức Chúa Trời để ca ngợi, cảm tạ, hoặc cầu xin sự giúp đỡ của Ngài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "祷告",
      "descriptions": [
        {
          "source": "acai",
          "description": "向上帝说话以赞美、感谢或寻求祂的帮助。"
        }
      ]
    },
    "zht": {
      "preferred_label": "禱告",
      "descriptions": [
        {
          "source": "acai",
          "description": "對上帝說話，以讚美、感謝或尋求祂的幫助。"
        }
      ]
    }
  },
