{
  "id": "keyterm:Blaspheme",
  "primary_id": "keyterm:Blaspheme",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "33.400",
    "33.401"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Blaspheme",
      "alternate_labels": [
        "Revile",
        "Defame"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To speak badly about someone or God to hurt their honor or reputation."
        }
      ]
    },
    "spa": {
      "preferred_label": "blasfemar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hablar mal de alguien o de Dios para dañar su honor o reputación."
        }
      ]
    },
    "fra": {
      "preferred_label": "blasphémer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dire du mal de quelqu'un ou de Dieu pour porter atteinte à son honneur ou à sa réputation."
        }
      ]
    },
    "ind": {
      "preferred_label": "menghujat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Berbicara buruk tentang seseorang atau Allah untuk menjatuhkan kehormatan atau reputasi mereka."
        }
      ]
    },
    "por": {
      "preferred_label": "blasfemar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Falar mal de alguém ou de Deus para prejudicar sua honra ou reputação."
        }
      ]
    },
    "apd": {
      "preferred_label": "يجدف",
      "descriptions": [
        {
          "source": "acai",
          "description": "الكلام الشين عن زول أو عن الله عشان يجرح كرامتهم أو سمعتهم."
        }
      ]
    },
    "arb": {
      "preferred_label": "جدّف",
      "descriptions": [
        {
          "source": "acai",
          "description": "التحدث بالسوء عن شخص ما أو عن الله للإساءة إلى كرامته أو سمعته."
        }
      ]
    },
    "bis": {
      "preferred_label": "tok nogud agens long God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong tok nogud agens long wan man no agens long God blong spolem nem mo ona blong hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin saɓo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin magana marar kyau game da wani ko Allah don ɓata mutuncinsu ko sunansu."
        }
      ]
    },
    "hin": {
      "preferred_label": "निन्दा करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या परमेश्वर के आदर या प्रतिष्ठा को ठेस पहुँचाने के लिए उनके विरोध में बुरा बोलना या निन्दा करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kwuluo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikwu okwu ọjọọ megide mmadụ ma ọ bụ Chineke iji merụọ nsọpụrụ ma ọ bụ aha ọma ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "निन्दा गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैको वा परमेश्‍वरको आदर वा प्रतिष्ठामा आघात पुर्‍याउन तिनीहरूको विरुद्धमा खराब बोल्नु (ईश्‍वर-निन्दा गर्नु)।"
        }
      ]
    },
    "rus": {
      "preferred_label": "хулить",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дурно отзываться о ком-либо или о Боге, умаляя их честь или доброе имя."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kufuru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kusema vibaya kumhusu mtu au Mungu ili kuharibu heshima au sifa yao."
        }
      ]
    },
    "tpi": {
      "preferred_label": "mekim tok nogut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long mekim tok nogut long wanpela manmeri o long God bilong bagarapim nem o ona bilong em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Phạm thượng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nói xấu ai đó hoặc Đức Chúa Trời nhằm xúc phạm danh dự hoặc thanh danh của họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亵渎",
      "descriptions": [
        {
          "source": "acai",
          "description": "指说贬损某人或上帝的话，以损害其荣耀或名誉。"
        }
      ]
    },
    "zht": {
      "preferred_label": "褻瀆",
      "descriptions": [
        {
          "source": "acai",
          "description": "惡意談論某人或上帝，以損害其尊嚴或名譽。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Slander"
  ],
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
