  ],
  "localizations": {
    "eng": {
      "preferred_label": "Love (Platonic)",
      "alternate_labels": [
        "Be Fond Of"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To have warm feelings or affection for someone because of a close relationship or friendship."
        }
      ]
    },
    "spa": {
      "preferred_label": "querer (platónico)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tener sentimientos cálidos o afecto hacia alguien debido a una relación cercana o de amistad."
        }
      ]
    },
    "fra": {
      "preferred_label": "amour (platonique)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Éprouver des sentiments chaleureux ou de l'affection pour quelqu'un en raison d'une relation étroite ou d'une amitié."
        }
      ]
    },
    "ind": {
      "preferred_label": "kasih (platonis)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memiliki perasaan hangat atau kasih sayang kepada seseorang karena hubungan yang dekat atau persahabatan."
        }
      ]
    },
    "por": {
      "preferred_label": "amar (afeto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ter sentimentos afetuosos ou afeição por alguém por causa de um relacionamento próximo ou de amizade."
        }
      ]
    },
    "apd": {
      "preferred_label": "محبة (أخوية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنو الزول يكون عندو مشاعر دافية أو مودة تجاه زول بسبب علاقة قريبة أو صداقة."
        }
      ]
    },
    "arb": {
      "preferred_label": "محبة (أخوية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الشعور بمشاعر دافئة أو عاطفة تجاه شخص ما بسبب علاقة وثيقة أو صداقة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Lavem (Fren)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong gat ol filing blong lav no filing blong lavlavem wan man from wan klos rilesensip no fasin blong frengud."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙauna (Abota)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa da kyakkyawan ji ko shauƙi ga wani saboda dangantaka ta kusa ko abota."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रेम (स्नेह)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी घनिष्ठ संबंध या मित्रता के कारण किसी के प्रति स्नेह या आत्मीयता की भावना रखना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịhụnanya (Nkịtị)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe mmetụta ọma ma ọ bụ mmasị nʼebe mmadụ nọ nʼihi mmekọrịta chiri anya ma ọ bụ ọbụbụenyi."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रेम (मित्रवत्)",
      "descriptions": [
        {
          "source": "acai",
          "description": "घनिष्ट सम्बन्ध वा मित्रताको कारणले कसैप्रति न्यानो भावना वा स्नेह हुनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Любить (дружески)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Испытывать теплое чувство или привязанность к кому-либо в силу близких отношений или дружбы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kupenda (Kipendo cha Kirafiki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa na hisia za shauku au upendo kwa mtu kwa sababu ya uhusiano wa karibu au urafiki."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin Bilong Laikim Pren",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long gat gutpela pilim o laikim wanpela manmeri bikos long pasin bilong pren o sindaun gut wantaim em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Yêu mến (tình bạn hữu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Có tình cảm nồng ấm hoặc gắn bó với ai đó nhờ mối quan hệ thân thiết hoặc tình bạn hữu."
        }
      ]
    },
    "zhs": {
      "preferred_label": "爱（友情之爱）",
      "descriptions": [
        {
          "source": "acai",
          "description": "因亲密关系或友谊而对某人怀有温情或喜爱之意。"
        }
      ]
    },
    "zht": {
      "preferred_label": "愛（情誼）",
      "descriptions": [
        {
          "source": "acai",
          "description": "因親密關係或友誼而對某人產生溫暖的感情或喜愛。"
        }
      ]
    }
  },
