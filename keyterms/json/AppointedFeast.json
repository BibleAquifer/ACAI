  ],
  "localizations": {
    "eng": {
      "preferred_label": "Appointed Feast",
      "descriptions": [
        {
          "source": "acai",
          "description": "A special day set by God for people to worship and remember important events."
        }
      ]
    },
    "spa": {
      "preferred_label": "fiesta solemne",
      "descriptions": [
        {
          "source": "acai",
          "description": "Día especial fijado por Dios para que las personas adoren y recuerden acontecimientos importantes."
        }
      ]
    },
    "fra": {
      "preferred_label": "fête fixée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jour particulier fixé par Dieu pour que le peuple l’adore et se souvienne d’événements importants."
        }
      ]
    },
    "ind": {
      "preferred_label": "hari raya yang ditetapkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hari khusus yang ditetapkan oleh Allah bagi umat untuk beribadah dan mengingat peristiwa-peristiwa penting."
        }
      ]
    },
    "por": {
      "preferred_label": "festa fixa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um dia especial estabelecido por Deus para as pessoas adorarem e lembrarem acontecimentos importantes."
        }
      ]
    },
    "apd": {
      "preferred_label": "عيد معيّن",
      "descriptions": [
        {
          "source": "acai",
          "description": "يوم خاص حدده الله للناس ليعبدوه ويتذكروا أحداثاً مهمة."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَوْسِم مُعَيَّن",
      "descriptions": [
        {
          "source": "acai",
          "description": "يَوْمٌ خاصٌّ حَدَّدَهُ اللهُ لِيَعْبُدَهُ النّاسُ وَيَتَذَكَّروا أَحْداثًا مُهِمَّةً."
        }
      ]
    },
    "bis": {
      "preferred_label": "lafet we God i makemaot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan spesel dei we God i makemaot blong ol man oli wosip mo tingbaot ol impoten samting we oli hapen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙayyadadden biki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata rana ta musamman da Allah ya ƙayyade domin mutane su yi bauta su kuma tuna muhimman al’amura."
        }
      ]
    },
    "hin": {
      "preferred_label": "नियत पर्व",
      "descriptions": [
        {
          "source": "acai",
          "description": "आराधना करने और महत्वपूर्ण घटनाओं को स्मरण करने के लिए परमेश्वर द्वारा लोगों के लिए ठहराया गया एक विशेष दिन।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mmemme a kara aka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụbọchị pụrụ iche nke Chineke debere ka ndị mmadụ nwee ike ife ofufe ma cheta ihe ndị dị mkpa mere eme."
        }
      ]
    },
    "nep": {
      "preferred_label": "तोकिएको चाड",
      "descriptions": [
        {
          "source": "acai",
          "description": "आराधना गर्न र महत्त्वपूर्ण घटनाहरूको स्मरण गर्न मानिसहरूका निम्ति परमेश्‍वरले तोक्नुभएको विशेष दिन।"
        }
      ]
    },
    "rus": {
      "preferred_label": "установленный праздник",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особый день, установленный Богом для поклонения и воспоминания важных событий."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sikukuu iliyoamriwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Siku maalum iliyowekwa na Mungu kwa ajili ya watu kuabudu na kukumbuka matukio muhimu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bikpela de bilong lotu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela spesel de God i makim bilong ol manmeri i bung na mekim lotu na tingim ol bikpela samting i bin kamap."
        }
      ]
    },
    "vie": {
      "preferred_label": "kỳ lễ ấn định",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ngày đặc biệt do Đức Chúa Trời ấn định để dân chúng thờ phượng và tưởng niệm các biến cố quan trọng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "节期",
      "descriptions": [
        {
          "source": "acai",
          "description": "上帝为人们敬拜并纪念重要事件而设立的特别日子。"
        }
      ]
    },
    "zht": {
      "preferred_label": "節期",
      "descriptions": [
        {
          "source": "acai",
          "description": "上帝為讓人敬拜祂並記念重大事件所定下的特別日子。"
        }
      ]
    }
  },
