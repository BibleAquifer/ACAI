  "localizations": {
    "eng": {
      "preferred_label": "Redemption (from Slavery)",
      "alternate_labels": [
        "Deliverance",
        "Liberation"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "The act of setting someone free, like rescuing a slave to give them liberty."
        }
      ]
    },
    "spa": {
      "preferred_label": "redención (de la esclavitud)",
      "descriptions": [
        {
          "source": "acai",
          "description": "El acto de poner en libertad a alguien, como rescatar a un esclavo para darle libertad."
        }
      ]
    },
    "fra": {
      "preferred_label": "rédemption (de l'esclavage)",
      "descriptions": [
        {
          "source": "acai",
          "description": "L'action de libérer quelqu'un, comme racheter un esclave pour lui rendre sa liberté."
        }
      ]
    },
    "ind": {
      "preferred_label": "penebusan (dari perbudakan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tindakan membebaskan seseorang, seperti menyelamatkan seorang budak untuk memberinya kemerdekaan."
        }
      ]
    },
    "por": {
      "preferred_label": "resgate (da escravidão)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O ato de libertar alguém, como salvar um escravo para lhe dar liberdade."
        }
      ]
    },
    "apd": {
      "preferred_label": "عتق (من العبودية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "العمل بتاع تحرير زول، زي إنقاذ عبد عشان تخليه حر."
        }
      ]
    },
    "arb": {
      "preferred_label": "فداء (من العبودية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عملية إطلاق سراح شخص، مثل إنقاذ عبد لمنحه الحرية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Pemaot Bakegen (long Wok Slef)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin ya blong mekem wan man i kam fri, olsem blong sevem wan slef blong givim fridom long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fansa (daga Bauta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aikin ’yantar da wani, kamar ceto bawa don ba shi ’yanci."
        }
      ]
    },
    "hin": {
      "preferred_label": "छुड़ौती (दासत्व से)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी को स्वतंत्र करने का कार्य, जैसे किसी दास को स्वतंत्रता देने के लिए बचाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mgbapụta (site n'Ihu Ohu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Omume nke ịtọhapụ mmadụ, dị ka ịnapụta ohu iji nye ya nnwere onwe."
        }
      ]
    },
    "nep": {
      "preferred_label": "छुटकारा (दासत्वबाट)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दासलाई स्वतन्त्रता दिनलाई उद्धार गरेझैँ कसैलाई मुक्त गराउने काम।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Освобождение (из рабства)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Действие по освобождению кого-либо, подобно вызволению раба для дарования ему свободы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ukombozi (kutoka Utumwani)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitendo cha kumweka mtu huru, kama vile kumwokoa mtumwa ili kumpa uhuru."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong baim bek (long stap kalabus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong mekim wanpela man i kamap fri, olsem kisim bek wanpela wokboi nating bilong givim em fri."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự chuộc (khỏi ách nô lệ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành động phóng thích ai đó, như chuộc một người nô lệ để trả lại tự do cho họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "救赎 (脱离奴役)",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某人获得自由的举动，例如解救奴隶使其获得自由。"
        }
      ]
    },
    "zht": {
      "preferred_label": "贖放 (脫離奴役)",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某人獲得自由的行為，如解救奴隸使其獲得自由。"
        }
      ]
    }
  },
