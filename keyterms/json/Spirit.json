{
  "id": "keyterm:Spirit",
  "primary_id": "keyterm:Spirit",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "000175002001000",
    "000175002002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Necromancer",
      "alternate_labels": [
        "Necromancy"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A person who talks with the spirits of the dead or the spirit of someone who has died."
        }
      ]
    },
    "spa": {
      "preferred_label": "nigromante",
      "descriptions": [
        {
          "source": "acai",
          "description": "Persona que habla con los espíritus de los muertos o el espíritu de alguien que ha fallecido."
        }
      ]
    },
    "fra": {
      "preferred_label": "nécromancien",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une personne qui parle avec les esprits des morts ou l'esprit d'une personne décédée."
        }
      ]
    },
    "ind": {
      "preferred_label": "pemanggil arwah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang yang berbicara dengan roh orang mati atau arwah seseorang yang telah meninggal."
        }
      ]
    },
    "por": {
      "preferred_label": "necromante",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma pessoa que fala com os espíritos dos mortos ou o espírito de alguém que morreu."
        }
      ]
    },
    "apd": {
      "preferred_label": "محضّر أرواح",
      "descriptions": [
        {
          "source": "acai",
          "description": "زول بيتكلم مع أرواح الموتى أو روح زول مات."
        }
      ]
    },
    "arb": {
      "preferred_label": "مُسْتَحْضِرُ أَرْوَاحٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَخْصٌ يَتَوَاصَلُ مَعَ أَرْوَاحِ ٱلْمَوْتَى أَوْ رُوحِ مَيْتٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "man we i toktok wetem devel blong dedman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i stap toktok wetem ol devel blong dedman no spirit blong wan we i ded finis."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai sha’ani da matattu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin da yake magana da fatalwoyin matattu ko ruhun wanda ya mutu."
        }
      ]
    },
    "hin": {
      "preferred_label": "भूत साधनेवाला",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह व्यक्ति जो मृतकों की आत्माओं या किसी मरे हुए व्यक्ति की आत्मा से बात करता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye na-ajụ ndị nwụrụ anwụ ase",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye na-agwa mmụọ nke ndị nwụrụ anwụ ma ọ bụ mmụọ nke onye nwụrụ anwụ okwu."
        }
      ]
    },
    "nep": {
      "preferred_label": "मरेकाहरूसँग कुरा गर्ने मानिस",
      "descriptions": [
        {
          "source": "acai",
          "description": "मरेकाहरूका आत्मा वा मरेको कुनै व्यक्तिको आत्मासँग कुरा गर्ने व्यक्ति।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Вызывающий мертвых",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, который общается с духами умерших или духом умершего человека."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwaomba Wafu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu anayezungumza na roho za wafu au roho ya mtu aliyekufa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "man o meri bilong toktok wantaim tewel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man o meri i save toktok wantaim ol tewel bilong ol man i dai pinis."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thầy chiêu hồn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người giao tiếp với các vong linh của người chết hoặc linh hồn của một người đã qua đời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "问鬼的",
      "descriptions": [
        {
          "source": "acai",
          "description": "与亡灵或已故之人的灵沟通的人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "交鬼的",
      "descriptions": [
        {
          "source": "acai",
          "description": "能與死人或亡者的靈魂通話的人。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
