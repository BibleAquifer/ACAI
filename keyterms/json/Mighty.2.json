        }
      ]
    },
    "ind": {
      "preferred_label": "perkasa (kejam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menunjukkan kekuatan besar dengan cara yang bisa penuh kekerasan dan tanpa belas kasihan."
        }
      ]
    },
    "por": {
      "preferred_label": "poderoso (cruel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demonstrar grande poder de uma maneira que pode ser violenta e sem compaixão."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبار (قاسي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار قوة كبيرة بطريقة ممكن تكون عنيفة وبدون أي رحمة."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَاتٍ (قَاسٍ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إِظْهَارُ قُوَّةٍ عَظِيمَةٍ بِطَرِيقَةٍ قَدْ تَكُونُ عَنِيفَةً وَخَالِيَةً مِنَ ٱللُّطْفِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "strong (raf)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Soemaot bigfala paoa long fasin we i save raf mo we i no gat kaen fasin."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai ƙarfi (Azzalumi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna babban iko ta hanyar da za ta iya zama ta mugunta da rashin alheri."
        }
      ]
    },
    "hin": {
      "preferred_label": "पराक्रमी (उपद्रवी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसे तरीके से महान शक्ति का प्रदर्शन करना जो हिंसक और निर्दय हो सकता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Dị ike (Onye na-eme ihe ike)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosi ike dị ukwuu nʼụzọ nwere ike ịbụ ime ihe ike na enweghị obiọma."
        }
      ]
    },
    "nep": {
      "preferred_label": "शक्तिशाली (निर्दयी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "हिंस्रक र दयारहित हुनसक्ने गरी ठूलो शक्ति देखाउने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Грозный (жестокий)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявление великой силы, сопряженное с насилием и бессердечием."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwenye nguvu (Mkatili)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuonyesha nguvu kuu kwa namna inayoweza kuwa ya jeuri na isiyo na wema."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gat bikpela strong (Mekim nogut)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong i gat bikpela strong na pait o mekim nogut long ol arapela i no gat pasin sori."
        }
      ]
    },
    "vie": {
      "preferred_label": "bạo tàn (tàn bạo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thể hiện quyền lực lớn lao theo cách có thể mang tính bạo lực và tàn nhẫn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "强横 (残暴)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以可能带有暴力且毫无慈爱的方式显出巨大的力量。"
        }
      ]
    },
    "zht": {
      "preferred_label": "強暴（殘暴）",
      "descriptions": [
        {
          "source": "acai",
          "description": "以可能帶有暴力且毫無仁慈的方式展現強大力量。"
        }
      ]
    }
  },
