      "preferred_label": "पुरा गराउनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै महत्त्वपूर्ण उद्देश्य पुरा गर्नका निम्ति कुनै कुरा घटित गराउनु वा पुरा गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "исполнять",
      "descriptions": [
        {
          "source": "acai",
          "description": "Приводить к свершению чего-либо, часто ради исполнения важной цели."
