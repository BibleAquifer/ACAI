    "tpi": {
      "preferred_label": "Mekim i Kamap Tru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim wanpela samting i kamap tru, planti taim bilong inapim wanpela bikpela plen o as tingting."
