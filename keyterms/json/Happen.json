      "preferred_label": "पूरा करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी बात को घटित कराना, प्रायः किसी महत्वपूर्ण उद्देश्य को पूरा करने के लिए।"
        }
      ]
    },
