  "localizations": {
    "eng": {
      "preferred_label": "Change One's Mind",
      "alternate_labels": [
        "Repent",
        "Regret"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Deciding to think or act differently, often feeling sorry about the way before."
        }
      ]
    },
    "spa": {
      "preferred_label": "cambiar de opinión",
      "descriptions": [
        {
          "source": "acai",
          "description": "Decidir pensar o actuar de manera diferente, a menudo sintiendo pesar por lo anterior."
        }
      ]
    },
    "fra": {
      "preferred_label": "changer d'avis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Décider de penser ou d'agir différemment, en éprouvant souvent du regret par rapport à ce qui précédait."
        }
      ]
    },
    "ind": {
      "preferred_label": "menyesal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memutuskan untuk berpikir atau bertindak secara berbeda, sering kali disertai rasa sesal atas hal sebelumnya."
        }
      ]
    },
    "por": {
      "preferred_label": "mudar de ideia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Decidir pensar ou agir de forma diferente, muitas vezes lamentando o procedimento anterior."
        }
      ]
    },
    "apd": {
      "preferred_label": "يغيّر رأيه",
      "descriptions": [
        {
          "source": "acai",
          "description": "تقرر تفكر أو تتصرف بطريقة مختلفة، وغالباً مع الندم على الطريقة القبل كدا."
        }
      ]
    },
    "arb": {
      "preferred_label": "تغيير الرأي",
      "descriptions": [
        {
          "source": "acai",
          "description": "العزم على التفكير أو التصرف بطريقة مختلفة، وغالبًا مع الشعور بالأسف أو الندم على ما سبق."
        }
      ]
    },
    "bis": {
      "preferred_label": "tanem tingting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Desisen blong jenisim tingting o aksen, plante taem wetem sore from fasin blong bifo."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sāke tunani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yanke shawarar yin tunani ko aiki a wata hanya dabam, sau da yawa tare da yin nadama a kan abin da ya gabata."
        }
      ]
    },
    "hin": {
      "preferred_label": "मन बदलना",
      "descriptions": [
        {
          "source": "acai",
          "description": "अलग तरह से सोचने या कार्य करने का निर्णय लेना, अक्सर पहले के तौर-तरीके के बारे में पछतावा महसूस करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgbanwe obi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikpebi iche echiche ma ọ bụ ime omume nʼụzọ dị iche, ọkachasị inwe mwute banyere otu e si chee ma ọ bụ si mee ihe na mbụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "मन बदल्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "पहिलेको मार्गप्रति पछुतो मान्दै, फरक तरिकाले सोच्ने वा गर्ने निर्णय लिनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Передумать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Решение думать или поступать иначе, часто с чувством сожаления о прежнем."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kubadili nia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuamua kufikiri au kutenda tofauti, mara nyingi kwa kujuta kuhusu mwenendo wa hapo awali."
        }
      ]
    },
    "tpi": {
      "preferred_label": "senisim tingting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tingting long senisim tingting o pasin, planti taim wantaim bel hevi o sori long pasin i bin kamap bipo."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đổi ý",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quyết định suy nghĩ hoặc hành động khác đi, thường cảm thấy hối hận về cách thức trước đây."
        }
      ]
    },
    "zhs": {
      "preferred_label": "懊悔",
      "descriptions": [
        {
          "source": "acai",
          "description": "决定改变想法或做法，通常对先前的行为感到懊悔。"
        }
      ]
    },
    "zht": {
      "preferred_label": "改變心意",
      "descriptions": [
        {
          "source": "acai",
          "description": "決定以不同的方式思考或行動，通常對以往的做法感到後悔或抱歉。"
        }
      ]
    }
  },
