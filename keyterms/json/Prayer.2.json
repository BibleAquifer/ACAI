      "descriptions": [
        {
          "source": "acai",
          "description": "The act of talking to God, often to thank Him or ask for help."
        }
      ]
    },
    "apd": {
      "preferred_label": "صلاة",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل التكلم مع الله، غالباً عشان تشكره أو تطلب منه مساعدة."
        }
      ]
    },
    "arb": {
      "preferred_label": "صلاة",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل التحدث إلى الله، غالباً لشكره أو لطلب العون منه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Prea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wok blong toktok long God, plante taem blong talem tangkiu long hem o askem hem blong givhan."
        }
      ]
    },
    "fra": {
      "preferred_label": "prière",
      "descriptions": [
        {
          "source": "acai",
          "description": "L'acte de parler à Dieu, souvent pour le remercier ou lui demander de l'aide."
        }
      ]
    },
    "hau": {
      "preferred_label": "Addu’a",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aikin yin magana da Allah, sau da yawa don gode masa ko neman taimako."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रार्थना",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर से बात करने का कार्य, प्रायः उनका धन्यवाद करने या सहायता माँगने के लिए।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ekpere",
      "descriptions": [
        {
          "source": "acai",
          "description": "Omume nke ịgwa Chineke okwu, ọkachasị iji kelee ya ma ọ bụ rịọ maka enyemaka."
        }
      ]
    },
    "ind": {
      "preferred_label": "doa",
      "descriptions": [
        {
          "source": "acai",
