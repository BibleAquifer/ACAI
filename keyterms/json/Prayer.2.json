        }
      ]
    },
    "vie": {
      "preferred_label": "Lời cầu nguyện",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành động thưa chuyện với Đức Chúa Trời, thường là để tạ ơn Ngài hoặc xin Ngài giúp đỡ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "祷告",
