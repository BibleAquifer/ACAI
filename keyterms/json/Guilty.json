  "localizations": {
    "eng": {
      "preferred_label": "Guilty (Responsible)",
      "alternate_labels": [
        "To Be Held Guilty",
        "Suffer Punishment",
        "Declare Guilty"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Being responsible for doing something wrong, whether on purpose or by accident."
        }
      ]
    },
    "spa": {
      "preferred_label": "culpable (responsable)",
      "descriptions": [
        {
          "source": "acai",
          "description": "El ser responsable de hacer algo malo, ya sea a propósito o por accidente."
        }
      ]
    },
    "fra": {
      "preferred_label": "coupable (responsable)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait d’être responsable d’une mauvaise action commise, que ce soit intentionnellement ou par mégarde."
        }
      ]
    },
    "ind": {
      "preferred_label": "bersalah (bertanggung jawab)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bertanggung jawab karena telah melakukan suatu kesalahan, baik secara sengaja maupun tidak sengaja."
        }
      ]
    },
    "por": {
      "preferred_label": "culpado (responsável)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser responsável por fazer algo errado, seja intencionalmente ou por acidente."
        }
      ]
    },
    "apd": {
      "preferred_label": "مذنب (مسؤول)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الزول يكون مسؤول عن عمل حاجة غلط، سواء بقصد ولا من غير قصد."
        }
      ]
    },
    "arb": {
      "preferred_label": "مُذنِب (مسؤول)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تحمّل المسؤولية عن ارتكاب أمر خاطئ، سواء عن قصد أو عن غير قصد."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gat fol (risponsabol)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong gat fol from wan samting we man i mekem i rong, nating se hem i min blong mekem o i mekem mistek nomo."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai Laifi (Mai Alhaki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa da alhakin aikata wani abu marar kyau, ko da gangan ne ko ba da gangan ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "दोषी (उत्तरदायी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "जानबूझकर या अनजाने में कुछ गलत करने के लिए उत्तरदायी होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikpe ịmụma (Onye kpatara ya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye kpatara ma ọ bụ mere ihe ọjọọ, ma ọ̀ bụ na ama ma ọ bụ na amaghị ama."
        }
      ]
    },
    "nep": {
      "preferred_label": "दोषी (जिम्मेवार)",
      "descriptions": [
        {
          "source": "acai",
          "description": "जानीजानी वा नजानेर कुनै गलत काम गरेकोमा जिम्मेवार हुनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "виновный (несущий ответственность)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Несение ответственности за совершение дурного поступка, намеренно или случайно."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwenye hatia (Wenye wajibu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa na wajibu au kuhusika na kutenda jambo fulani lisilo sawa, iwe kwa kukusudia au pasipo kukusudia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gat Asua (I Gat Rong)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong i gat asua long mekim wanpela rong, maski long laik bilong em yet o long rong em i no tingting gut na mekim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Có tội (Chịu trách nhiệm)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chịu trách nhiệm về việc làm điều sai trái, dù là cố ý hay vô tình."
        }
      ]
    },
    "zhs": {
      "preferred_label": "有罪（负有责任）",
      "descriptions": [
        {
          "source": "acai",
          "description": "对所做错的事（无论故意还是无意）负有责任。"
        }
      ]
    },
    "zht": {
      "preferred_label": "有罪 (負有責任)",
      "descriptions": [
        {
          "source": "acai",
          "description": "對所犯的錯事負有責任，無論是有意還是無意的。"
        }
      ]
    }
  },
