  ],
  "localizations": {
    "eng": {
      "preferred_label": "Straight",
      "alternate_labels": [
        "Upright"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Being honest and fair, not crooked or wrong, and doing what is right."
        }
      ]
    },
    "spa": {
      "preferred_label": "derecho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser honesto y justo, no torcido ni malo, y hacer lo correcto."
        }
      ]
    },
    "fra": {
      "preferred_label": "droit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Être honnête et juste, sans détour ni faute, et faire ce qui est juste."
        }
      ]
    },
    "ind": {
      "preferred_label": "lurus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jujur dan adil, tidak bengkok atau salah, dan melakukan apa yang benar."
        }
      ]
    },
    "por": {
      "preferred_label": "reto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser honesto e justo, não desonesto ou errado, e fazer o que é certo."
        }
      ]
    },
    "apd": {
      "preferred_label": "مستقيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "الكون أمين وعادل، ما معوّج ولا غلط، وفعل الصح."
        }
      ]
    },
    "arb": {
      "preferred_label": "قويم",
      "descriptions": [
        {
          "source": "acai",
          "description": "الاتصاف بالنزاهة والعدل، دون اعوجاج أو باطل، وفعل الصواب."
        }
      ]
    },
    "bis": {
      "preferred_label": "stret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong stap ona mo fea, i no kruked no rong, mo stap mekem samting we i stret."
        }
      ]
    },
    "hau": {
      "preferred_label": "Miƙe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa mai gaskiya da adalci, ba karkatacce ko marar kyau ba, da kuma yin abin da yake daidai."
        }
      ]
    },
    "hin": {
      "preferred_label": "सीधा",
      "descriptions": [
        {
          "source": "acai",
          "description": "ईमानदार और निष्पक्ष होना, कुटिल या बुरा न होना, और जो सही है वही करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Guzosie ike",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye na-ekwu eziokwu na onye ziri ezi, nke na-ekweghị ekwe ma ọ bụ na-ezighị ezi, na ime ihe ziri ezi."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिधा",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरा छली वा गलत नभई, इमानदार र निष्पक्ष हुनु तथा जे ठीक छ त्यही गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Прямой",
      "descriptions": [
        {
          "source": "acai",
          "description": "Честный и справедливый, не искривленный и не порочный, совершающий правильные поступки."
        }
      ]
    },
    "swh": {
      "preferred_label": "-nyofu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa mwaminifu na mwenye haki, bila kupotoka au kukosea, na kutenda yaliyo sawa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "stretpela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong stap stret na bihainim stretpela pasin, i no kranki o nogut, na mekim ol samting i stret."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ngay thẳng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ngay thật và công bình, không quanh co hay sai trái, và làm điều đúng đắn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "修直",
      "descriptions": [
        {
          "source": "acai",
          "description": "为人诚实公正，不偏邪、不错谬，行合宜之事。"
        }
      ]
    },
    "zht": {
      "preferred_label": "筆直",
      "descriptions": [
        {
          "source": "acai",
          "description": "誠實公正，不歪斜、不犯錯，行事合宜。"
        }
      ]
    }
  },
  "referred_to_as": [
