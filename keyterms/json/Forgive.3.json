{
  "id": "keyterm:Forgive.3",
  "primary_id": "keyterm:Forgive",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "localizations": {
    "eng": {
      "preferred_label": "Forgive (Grant Pardon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "To pardon someone by choosing not to punish them for what they did wrong."
        }
      ]
    },
    "spa": {
      "preferred_label": "perdonar (conceder perdón)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Perdonar a alguien al decidir no castigarlo por lo que hizo mal."
        }
      ]
    },
    "fra": {
      "preferred_label": "pardonner (accorder le pardon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pardonner à quelqu'un en choisissant de ne pas le punir pour le mal qu'il a commis."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengampuni (memberi pengampunan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengampuni seseorang dengan memilih untuk tidak menghukum mereka atas kesalahan yang mereka perbuat."
        }
      ]
    },
    "por": {
      "preferred_label": "perdoar (conceder perdão)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Perdoar alguém ao decidir não puni-lo pelo mal que cometeu."
        }
      ]
    },
    "apd": {
      "preferred_label": "غفر (عفا عن)",
      "descriptions": [
        {
          "source": "acai",
          "description": "العفو عن شخص باختيار عدم معاقبتو على الغلط العملو."
        }
      ]
    },
    "arb": {
      "preferred_label": "غفر (صفح)",
      "descriptions": [
        {
          "source": "acai",
          "description": "العفو عن شخص ما باختيار عدم معاقبته على الخطأ الذي ارتكبه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fogivim (Lego Panis)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong fogivim wan man taem yu jusum blong no panisim hem from samting nogud we hem i mekem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gafarta (Yafewa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yafewa wani ta wurin zaɓar rashin yi masa horo a kan laifin da ya yi."
        }
      ]
    },
    "hin": {
      "preferred_label": "क्षमा करना (दण्ड क्षमा करना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी की ग़लती के लिए उसे सज़ा न देने का निर्णय करके क्षमा करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgbaghara (Nye mgbaghara)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịgbaghara mmadụ site n'ịhọrọ ịghara ịta ya ahụhụ maka ihe ọjọọ o mere."
        }
      ]
    },
    "nep": {
      "preferred_label": "क्षमा गर्नु (माफी दिनु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैले गरेको गल्तीको लागि उसलाई दण्ड नदिने निर्णय गरेर माफी दिनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Прощать (помиловать)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Даровать кому-либо прощение, решив не наказывать за совершенный проступок."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusamehe (Kutoa Msamaha)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumsamehe mtu kwa kuamua kutomwadhibu kwa kosa alilofanya."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tha thứ (Ban ơn xá tội)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tha thứ cho ai đó bằng cách quyết định không trừng phạt họ về những điều sai trái họ đã làm."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赦免（饶恕）",
      "descriptions": [
        {
          "source": "acai",
          "description": "选择不对某人的过错施加惩罚，从而宽恕此人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "赦免（饒恕）",
      "descriptions": [
        {
          "source": "acai",
          "description": "因選擇不懲罰某人的過錯而寬恕某人。"
        }
      ]
    }
  },
