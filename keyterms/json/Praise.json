{
  "id": "keyterm:Praise",
  "primary_id": "keyterm:Praise",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "007734001004000",
    "007734001001000",
    "007734001002000",
    "007734001003000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Praise",
      "alternate_labels": [
        "Choir",
        "Thank-Offering"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A way to publicly thank God for what He has done, which can include singing in a choir or giving an offering."
        }
      ]
    },
    "spa": {
      "preferred_label": "alabanza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una manera de agradecer públicamente a Dios por lo que ha hecho, lo cual puede incluir cantar en un coro o dar una ofrenda."
        }
      ]
    },
    "fra": {
      "preferred_label": "louange",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une façon de remercier publiquement Dieu pour ce qu'il a fait, ce qui peut inclure de chanter dans une chorale ou d'apporter une offrande."
        }
      ]
    },
    "ind": {
      "preferred_label": "pujian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cara untuk mengucap syukur kepada Allah di depan umum atas apa yang telah dilakukan-Nya, yang dapat mencakup bernyanyi dalam paduan suara atau memberikan persembahan."
        }
      ]
    },
    "por": {
      "preferred_label": "louvor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma forma de agradecer publicamente a Deus pelo que Ele fez, o que pode incluir cantar em um coral ou entregar uma oferta."
        }
      ]
    },
    "apd": {
      "preferred_label": "حمد",
      "descriptions": [
        {
          "source": "acai",
          "description": "طريقة عشان تشكر بيها الله علناً على الحاجات العملها، وده ممكن يشمل الغنا في كورال أو تقديم ذبيحة شكر أو عطية."
        }
      ]
    },
    "arb": {
      "preferred_label": "تسبيح",
      "descriptions": [
        {
          "source": "acai",
          "description": "طريقة لشكر الله علانية على ما صنعه، وقد تتضمن الترنيم في جوقة أو تقديم ذبيحة أو قربان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Presem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan fasin blong talem tangkiu long pablik long God from ol samting we hem i mekem, we i save tekem tu fasin blong sing long wan kwaea o givim wan presen sakrefaes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yabo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hanya ce ta yin godiya ga Allah a fili saboda abin da ya yi, wadda za ta iya haɗawa da rera waƙa a ƙungiyar mawaƙa ko ba da sadaka."
        }
      ]
    },
    "hin": {
      "preferred_label": "स्तुति",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर ने जो किया है उसके लिए सार्वजनिक रूप से उसका धन्यवाद करने का एक तरीका, जिसमें गायक-मण्डली में गाना या भेंट चढ़ाना शामिल हो सकता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Otuto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụzọ e si ekele Chineke nʼihu ọha maka ihe o mere, nke nwere ike ịgụnye ịbụ abụ nʼòtù ukwe ma ọ bụ inye onyinye."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रशंसा",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरले गर्नुभएका कामहरूका निम्ति सार्वजनिक रूपमा उहाँलाई धन्यवाद दिने एउटा तरिका, जसमा भजनमण्डलीमा गाउनु वा भेटी चढाउनु समावेश हुन सक्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "хвала",
      "descriptions": [
        {
          "source": "acai",
          "description": "Способ публично возблагодарить Бога за содеянное Им, который может включать пение в хоре или принесение пожертвования."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sifa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Njia ya kumshukuru Mungu hadharani kwa yale aliyotenda, ambayo inaweza kujumuisha kuimba katika kwaya au kutoa sadaka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Litimapim nem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pasin bilong givim tenkyu long ples klia long God long ol samting em i bin mekim, na dispela inap makim pasin bilong singim song long kwaya o givim ofa."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ngợi khen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cách công khai tạ ơn Đức Chúa Trời về những việc Ngài đã làm, có thể bao gồm việc ca hát trong ca đoàn hoặc dâng của lễ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赞美",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种公开感谢上帝作为的方式，包括在唱诗班歌唱或献祭。"
        }
      ]
    },
    "zht": {
      "preferred_label": "稱謝",
      "descriptions": [
        {
          "source": "acai",
          "description": "公開感謝上帝作為的一種方式，可包括在詩班中歌唱或獻上供物。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Acknowledge"
  ],
