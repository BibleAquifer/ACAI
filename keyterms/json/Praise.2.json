  "localizations": {
    "eng": {
      "preferred_label": "Praise (Glorify)",
      "alternate_labels": [
        "Glorify",
        "Honor"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To speak highly of someone or something and show respect and honor."
        }
      ]
    },
    "spa": {
      "preferred_label": "alabar (glorificar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hablar muy bien de alguien o de algo y mostrar respeto y honra."
        }
      ]
    },
    "fra": {
      "preferred_label": "louer (glorifier)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Parler avec éloge de quelqu'un ou de quelque chose et lui témoigner du respect et de l'honneur."
        }
      ]
    },
    "ind": {
      "preferred_label": "memuliakan (mempermuliakan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyanjung seseorang atau sesuatu serta menunjukkan rasa hormat dan kehormatan."
        }
      ]
    },
    "por": {
      "preferred_label": "glorificar (glorificar)",
      "alternate_labels": [
        "glorificar"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Falar muito bem de alguém ou algo e demonstrar respeito e honra."
        }
      ]
    },
    "apd": {
      "preferred_label": "يمجد (يعظم)",
      "descriptions": [
        {
          "source": "acai",
          "description": "المديح لزول أو شي وإظهار الاحترام والإكرام ليهو."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُمَجِّد (يُعَظِّم)",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يمدح شخصًا أو شيئًا بإعظام ويُظهر له الاحترام والإكرام."
        }
      ]
    },
    "bis": {
      "preferred_label": "Leftemap Nem (Ona)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong talem ol gudfala toktok long saed blong wan man no wan samting mo soemaot respek mo ona."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yabo (ɗaukaka)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faɗar kyawawan maganganu game da wani ko wani abu da nuna girmamawa da ɗaukaka."
        }
      ]
    },
    "hin": {
      "preferred_label": "महिमा करना (बड़ाई करना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या वस्तु की अत्यधिक प्रशंसा करना और आदर तथा सम्मान प्रकट करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Otuto (Inye otuto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikwu okwu dị elu banyere mmadụ ma ọ bụ ihe ma gosi nkwanye ùgwù na nsọpụrụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रशंसा गर्नु (महिमा गर्नु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैको वा कुनै कुराको उच्च प्रशंसा गर्नु र आदर तथा सम्मान देखाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Прославлять (славить)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Высоко отзываться о ком-либо или чем-либо, проявляя почтение и уважение."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusifu (Kutukuza)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumsifu mtu au kitu sana na kuonyesha heshima na utukufu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Litimapim Nem (Givim Biknem)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Litimapim nem bilong wanpela man o samting na soim rispek na biknem."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tôn vinh (làm rạng danh)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nói những lời ca ngợi ai đó hoặc điều gì đó và bày tỏ sự tôn kính và tôn vinh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赞美 (归荣耀)",
      "descriptions": [
        {
          "source": "acai",
          "description": "高度称赞某人或某事，并表达敬意与尊荣。"
        }
      ]
    },
    "zht": {
      "preferred_label": "讚美（榮耀）",
      "descriptions": [
        {
          "source": "acai",
          "description": "高度稱讚某人或某事，並表達尊重與尊榮。"
        }
      ]
    }
  },
