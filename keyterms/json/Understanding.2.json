  "localizations": {
    "eng": {
      "preferred_label": "Understanding (Awareness)",
      "descriptions": [
        {
          "source": "acai",
          "description": "The ability to know, learn, and make sense of things."
        }
      ]
    },
    "fra": {
      "preferred_label": "intelligence (conscience)",
      "descriptions": [
        {
          "source": "acai",
          "description": "La capacité de savoir, d'apprendre et de donner du sens aux choses."
        }
      ]
    },
    "ind": {
      "preferred_label": "pengertian (kesadaran)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kemampuan untuk mengetahui, belajar, dan memahami berbagai hal."
        }
      ]
    },
    "apd": {
      "preferred_label": "فهم (وعي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "القدرة على المعرفة والتعلّم وإدراك الأشياء وفهمها."
        }
      ]
    },
    "arb": {
      "preferred_label": "فَهْم (إِدْرَاك)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الْقُدْرَةُ عَلَى الْمَعْرِفَةِ، وَالتَّعَلُّمِ، وَإِدْرَاكِ الْأُمُورِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "haremsave (karem save)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Paoa no fasin blong save, lanem, mo kasemsave ol samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fahimi (Sanin ya kamata)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙwarewar sani, koya, da kuma fahimtar al’amura."
        }
      ]
    },
    "hin": {
      "preferred_label": "समझ (जागरूकता)",
      "descriptions": [
        {
          "source": "acai",
          "description": "बातों को जानने, सीखने और समझने की क्षमता।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nghọta (Ịmara ihe)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikike ịmata, ịmụta, na ịghọta ihe."
        }
      ]
    },
    "nep": {
      "preferred_label": "समझशक्ति (सचेतता)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुराहरू जान्‍ने, सिक्ने र बुझ्‍ने क्षमता।"
        }
      ]
    },
    "por": {
      "preferred_label": "entendimento (percepção)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A capacidade de conhecer, aprender e compreender as coisas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Разумение (осознание)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Способность познавать, учиться и осмысливать происходящее."
        }
      ]
    },
    "spa": {
      "preferred_label": "entendimiento (percepción)",
      "descriptions": [
        {
          "source": "acai",
          "description": "La capacidad de conocer, aprender y comprender las cosas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ufahamu (Utambuzi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uwezo wa kujua, kujifunza, na kuelewa mambo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gutpela tingting (save)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Save na strong bilong save, lainim, na kliagut long ol samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự thông sáng (Nhận thức)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Khả năng hiểu biết, học hỏi và nhận thức về mọi việc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "悟性（领悟）",
      "descriptions": [
        {
          "source": "acai",
          "description": "认识、学习和理解事物的能力。"
        }
      ]
    },
    "zht": {
      "preferred_label": "聰明 (領悟)",
      "descriptions": [
        {
          "source": "acai",
          "description": "理解、學習並明白事理的能力。"
        }
      ]
    }
