  ],
  "localizations": {
    "eng": {
      "preferred_label": "To Dishonor",
      "descriptions": [
        {
          "source": "acai",
          "description": "To do something that causes shame or shows no respect to someone or something."
        }
      ]
    },
    "spa": {
      "preferred_label": "deshonrar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer algo que causa vergüenza o muestra falta de respeto hacia alguien o algo."
        }
      ]
    },
    "fra": {
      "preferred_label": "déshonorer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faire quelque chose qui cause la honte ou qui manque de respect envers quelqu'un ou quelque chose."
        }
      ]
    },
    "ind": {
      "preferred_label": "mencemarkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Melakukan sesuatu yang menimbulkan rasa malu atau tidak menunjukkan rasa hormat kepada seseorang atau sesuatu."
        }
      ]
    },
    "por": {
      "preferred_label": "desonrar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fazer algo que causa vergonha ou demonstra falta de respeito para com alguém ou algo."
        }
      ]
    },
    "apd": {
      "preferred_label": "يهين",
      "descriptions": [
        {
          "source": "acai",
          "description": "تعمل حاجة بتجيب العار أو ما فيها احترام لي زول أو لي حاجة."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُهِين",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَنْ يَفْعَلَ المَرْءُ شَيْئًا يُسَبِّبُ العَارَ أَوْ يُظْهِرُ عَدَمَ الِاحْتِرَامِ لِشَخْصٍ أَوْ لِشَيْءٍ مَا."
        }
      ]
    },
    "bis": {
      "preferred_label": "mekem i sem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem wan samting we i mekem man i sem no we i soem se man i no gat respek long wan man no wan samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin rashin daraja",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin wani abu da yake jawo kunya ko nuna rashin daraja ga wani ko wani abu."
        }
      ]
    },
    "hin": {
      "preferred_label": "अपमान करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसा कुछ करना जिससे किसी व्यक्ति या वस्तु का अपमान हो अथवा उसके प्रति अनादर प्रदर्शित हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Imebi nsọpụrụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ihe na-eweta ihere maọbụ na-adịghị egosi nsọpụrụ nʼebe mmadụ maọbụ ihe nọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "अनादर गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई वा कुनै थोकलाई लज्जित पार्ने वा अनादर देखाउने काम गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Бесчестить",
      "descriptions": [
        {
          "source": "acai",
          "description": "Совершать то, что навлекает позор или выражает неуважение к кому-либо или чему-либо."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuvunjia Heshima",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kufanya jambo linaloleta aibu au linaloonyesha kutomheshimu mtu au kitu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "mekim nogut nem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim wanpela samting i bringim sem o soim olsem man i no givim biknem o rispek long wanpela man o samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Làm nhục",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm điều gì đó gây sỉ nhục hoặc tỏ ra không tôn trọng ai đó hay điều gì đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "羞辱",
      "descriptions": [
        {
          "source": "acai",
          "description": "做出使人蒙羞或对某人、某事表现出不尊重的事。"
        }
      ]
    },
    "zht": {
      "preferred_label": "使蒙羞／褻瀆",
      "descriptions": [
        {
          "source": "acai",
          "description": "做某事使人蒙羞，或對某人某事不敬。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Profane.2"
  ],
