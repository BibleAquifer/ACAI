        }
      ]
    },
    "hin": {
      "preferred_label": "मित्रता",
      "descriptions": [
        {
          "source": "acai",
          "description": "उन लोगों के बीच एक घनिष्ठ और स्नेही सम्बन्ध जो एक दूसरे को पसंद करते हैं और उन पर भरोसा करते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ịbụ enyi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmekọrịta chiri anya na nke nlekọta nʼetiti ndị mmadụ hụrụ onwe ha nʼanya ma tụkwasịkwa onwe ha obi."
        }
      ]
    },
    "nep": {
      "preferred_label": "मित्रता",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक-अर्कालाई मन पराउने र विश्‍वास गर्ने मानिसहरूबीचको घनिष्‍ठ र हितकारी सम्बन्ध।"
        }
      ]
    },
    "rus": {
      "preferred_label": "дружба",
      "descriptions": [
        {
          "source": "acai",
          "description": "Близкие и заботливые отношения между людьми, которые любят и доверяют друг другу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Urafiki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uhusiano wa karibu na wenye kujali kati ya watu wanaopendana na kuaminiana."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin pren",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kain pasin pren namel long ol manmeri i save laikim na bilipim ol yet."
        }
      ]
    },
    "vie": {
      "preferred_label": "tình bạn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mối quan hệ gắn bó và quan tâm lẫn nhau giữa những người quý mến và tin cậy nhau."
        }
      ]
    },
    "zhs": {
      "preferred_label": "友谊",
      "descriptions": [
        {
          "source": "acai",
          "description": "彼此喜欢并信任的人之间亲密而关怀的关系。"
        }
      ]
    },
    "zht": {
      "preferred_label": "友誼",
      "descriptions": [
        {
          "source": "acai",
          "description": "彼此喜歡並互相信任的人之間親密且關懷的關係。"
        }
      ]
    }
