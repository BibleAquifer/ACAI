        }
      ]
    },
    "por": {
      "preferred_label": "amizade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um relacionamento próximo e afetuoso entre pessoas que gostam uma da outra e confiam mutuamente."
        }
      ]
    },
    "apd": {
      "preferred_label": "صداقة",
      "descriptions": [
        {
