      "preferred_label": "Vengeance",
      "alternate_labels": [
        "Justice",
        "Punishment"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Giving back punishment to someone who has done wrong, to make things fair again."
        }
      ]
    },
    "spa": {
      "preferred_label": "venganza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dar un castigo como retribución a alguien que ha actuado mal, para restablecer la justicia."
        }
      ]
    },
    "fra": {
      "preferred_label": "vengeance",
      "descriptions": [
        {
          "source": "acai",
          "description": "Infliger un châtiment en retour à quelqu'un qui a mal agi, afin de rétablir la justice."
        }
      ]
    },
    "ind": {
      "preferred_label": "pembalasan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memberikan kembali hukuman kepada seseorang yang telah berbuat jahat, demi memulihkan keadilan."
        }
      ]
    },
    "por": {
      "preferred_label": "Vingança",
      "alternate_labels": [
        "vingança"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Retribuir com punição a alguém que cometeu um mal, para restabelecer a justiça."
        }
      ]
    },
    "apd": {
      "preferred_label": "انتقام",
      "descriptions": [
        {
          "source": "acai",
          "description": "معاقبة زول عمل غلط عشان ترجع الأمور عادلة."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَقْمَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "إيقاعُ العِقابِ بِمَن أَساءَ، لإِعادَةِ الأُمورِ إِلى نِصابِها العادِلِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong givimbak panis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong givimbak panis long wan man we i mekem samting i nogud, blong mekem ol samting i stret bakegen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ramuwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sāka wa wanda ya yi ba daidai ba da azaba ko hukunci, domin a mai da al’amura su zama daidai."
        }
      ]
    },
    "hin": {
      "preferred_label": "बदला",
      "descriptions": [
        {
          "source": "acai",
          "description": "गलत करने वाले को वापस दण्ड देना, ताकि सब कुछ फिर से न्यायसंगत हो सके।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịbọ ọbọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inyeghachi mmadụ ahụhụ maka ihe ọjọọ o mere, iji mee ka ihe dịghachi n'ụzọ ziri ezi."
        }
      ]
    },
    "nep": {
      "preferred_label": "बदला",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुराहरूलाई फेरि उचित बनाउन गलत काम गर्ने कसैलाई सजाय फिर्ता दिनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Отмщение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Возмездие наказанием тому, кто совершил зло, чтобы восстановить справедливость."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kisasi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kulipiza adhabu kwa mtu aliyetenda mabaya, ili kurudisha usawa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Bekim Rong",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bekim pe nogut long wanpela man i bin mekim rong, bilong mekim samting i stret gen."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự báo thù",
      "descriptions": [
        {
          "source": "acai",
          "description": "Trừng phạt người đã làm điều sai trái để lập lại sự công bằng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "报应/申冤",
      "descriptions": [
        {
          "source": "acai",
          "description": "对作恶者施加惩罚，以恢复公平。"
        }
      ]
    },
    "zht": {
      "preferred_label": "報應／伸冤",
      "descriptions": [
        {
          "source": "acai",
          "description": "向做錯事的人施行懲罰，使公道得以伸張。"
        }
      ]
    }
  },
