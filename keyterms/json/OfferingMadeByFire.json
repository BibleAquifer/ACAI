{
  "id": "keyterm:OfferingMadeByFire",
  "primary_id": "keyterm:Offering",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "000737001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Offering Made by Fire",
      "alternate_labels": [
        "Burnt Offering"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "An animal given to God by burning it completely or partly on the altar as a sign of devotion."
        }
      ]
    },
    "spa": {
      "preferred_label": "ofrenda quemada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Animal que se ofrece a Dios quemándolo total o parcialmente sobre el altar como señal de devoción."
        }
      ]
    },
    "fra": {
      "preferred_label": "sacrifice consumé par le feu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un animal offert à Dieu en le brûlant entièrement ou en partie sur l’autel en signe de dévotion."
        }
      ]
    },
    "ind": {
      "preferred_label": "korban api-apian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seekor hewan yang dipersembahkan kepada Allah dengan membakarnya secara menyeluruh atau sebagian di atas mezbah sebagai tanda pengabdian."
        }
      ]
    },
    "por": {
      "preferred_label": "oferta queimada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um animal oferecido a Deus sendo queimado total ou parcialmente sobre o altar como sinal de devoção."
        }
      ]
    },
    "apd": {
      "preferred_label": "ذبيحة بالنار",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان بيتقدّم لله بحرقه كلو أو جزء منو في المذبح كعلامة على الإخلاص والتكريس."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَقُود",
      "descriptions": [
        {
          "source": "acai",
          "description": "حَيَوَانٌ يُقَدَّمُ لِلهِ بِإِحْرَاقِهِ كَامِلًا أَوْ جُزْئِيًّا عَلَى ٱلْمَذْبَحِ كَعَلَامَةِ تَعَبُّدٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Presen we i blong bonem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan anamol we man i givim long God taem i bonem fulwan o haf blong hem long olta olsem wan saen blong givim hem wan long God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hadaya wadda aka yi da wuta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dabbobin da ake miƙa wa Allah ta wurin ƙone su gaba ɗaya ko a ɓangare a kan bagade a matsayin alamar sadaukarwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "हवन",
      "descriptions": [
        {
          "source": "acai",
          "description": "भक्ति के चिह्न के रूप में वेदी पर पूरी तरह या आंशिक रूप से जलाकर परमेश्वर को अर्पित किया जाने वाला पशु।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onyinye e nyere site n'ọkụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anụmanụ e nyere Chineke site n'ịkpọ ya ọkụ kpamkpam maọbụ n'akụkụ ụfọdụ n'elu ebe ịchụàjà dịka ihe ịrịba ama nke nraranye."
        }
      ]
    },
    "nep": {
      "preferred_label": "आगोद्वारा चढाइने बलि",
      "descriptions": [
        {
          "source": "acai",
          "description": "भक्तिको चिन्हको रूपमा वेदीमा पूरै वा आंशिक रूपमा जलाएर परमेश्‍वरलाई चढाइने पशु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Огненная жертва",
      "descriptions": [
        {
          "source": "acai",
          "description": "Животное, приносимое Богу посредством полного или частичного сожжения на жертвеннике в знак благоговения и преданности."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sadaka Iliyotolewa kwa Moto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama anayetolewa kwa Mungu kwa kuchomwa kabisa au kwa sehemu juu ya madhabahu kama ishara ya ibada."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ofa Bilong Kukim Long Paia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela abus ol i givim long God long rot bilong kukim olgeta o hap bilong en long paia antap long alta olsem mak bilong givim bel long God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tế lễ dùng lửa dâng lên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con vật được dâng cho Đức Chúa Trời bằng cách thiêu toàn phần hoặc một phần trên bàn thờ như một dấu hiệu của lòng tận hiến."
        }
      ]
    },
    "zhs": {
      "preferred_label": "火祭",
      "descriptions": [
        {
          "source": "acai",
          "description": "完全或部分在祭坛上焚烧献给上帝作为虔诚标志的动物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "火祭",
      "descriptions": [
        {
          "source": "acai",
          "description": "在祭壇上全部或部分焚燒獻給上帝作為敬虔標記的動物。"
        }
      ]
    }
  },
