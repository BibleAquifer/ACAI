    "arb": {
      "preferred_label": "جَسَدِيّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَا يَتَعَلَّقُ بِرَغَبَاتِ الإِنْسَانِ النَّابِعَةِ مِنَ الجَسَدِ، وَلَا سِيَّمَا الشَّهَوَاتِ الجَسَدِيَّةِ القَوِيَّةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "man blong bodi nomo",
      "descriptions": [
        {
          "source": "acai",
          "description": "I tokbaot ol samting we tingting blong bodi nomo i wantem, speseli ol strong samting we bodi i wantem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Na halin mutuntaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abin da ya shafi sha’awoyin mutum da ke fitowa daga jiki, musamman ƙaƙƙarfan buri na jiki."
        }
      ]
    },
    "hin": {
      "preferred_label": "शारीरिक",
      "descriptions": [
        {
          "source": "acai",
          "description": "शरीर से उत्पन्न होने वाली मानवीय अभिलाषाओं से संबंधित, विशेषकर प्रबल शारीरिक इच्छाएँ।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nke anụ ahụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe metụtara ọchịchọ mmadụ nke sitere nʼahụ, karịsịa agụụ anụ ahụ siri ike."
        }
      ]
    },
    "nep": {
      "preferred_label": "शारीरिक",
      "descriptions": [
        {
          "source": "acai",
          "description": "शरीरबाट आउने मानवीय इच्छाहरूसँग, विशेष गरी प्रबल शारीरिक चाहनाहरूसँग सम्बन्धित।"
        }
      ]
    },
    "rus": {
      "preferred_label": "плотский",
      "descriptions": [
        {
          "source": "acai",
          "description": "Относящийся к человеческим желаниям, исходящим от тела, особенно к сильным физическим влечениям."
        }
      ]
    },
    "swh": {
      "preferred_label": "-a kimwili",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhusiana na tamaa za kibinadamu zitokazo mwilini, hasa matamanio yenye nguvu ya kimwili."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong olpela bel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting i bilong ol laik bilong skin o bodi bilong man, moa yet ol strongpela laik bilong bodi."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thuộc về xác thịt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thuộc về những ham muốn của con người bắt nguồn từ thân thể, đặc biệt là những dục vọng thể xác mạnh mẽ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "属肉体的",
      "descriptions": [
        {
          "source": "acai",
          "description": "关于源自肉体的欲望，特别是强烈的身体渴求。"
        }
      ]
    },
    "zht": {
      "preferred_label": "屬肉體的",
      "descriptions": [
        {
          "source": "acai",
          "description": "與源自肉體的人類慾望有關，特別是強烈的肉體慾望。"
        }
      ]
    }
