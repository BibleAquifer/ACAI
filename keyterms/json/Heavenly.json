  "localizations": {
    "eng": {
      "preferred_label": "Heavenly",
      "alternate_labels": [
        "In Heaven",
        "From Heaven",
        "From God"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Coming from or connected to heaven or God."
        }
      ]
    },
    "fra": {
      "preferred_label": "céleste",
      "descriptions": [
        {
          "source": "acai",
          "description": "Qui vient du ciel ou de Dieu, ou qui y est rattaché."
        }
      ]
    },
    "ind": {
      "preferred_label": "surgawi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Berasal dari atau berhubungan dengan surga atau Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "celestial",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que vem do céu ou de Deus, ou que está ligado a eles."
        }
      ]
    },
    "apd": {
      "preferred_label": "سماوي",
      "descriptions": [
        {
          "source": "acai",
          "description": "جايي من السما أو الله، أو مرتبط بيهم."
        }
      ]
    },
    "arb": {
      "preferred_label": "سماوي",
      "descriptions": [
        {
          "source": "acai",
          "description": "آتٍ من السماء أو من الله، أو مرتبط بهما."
        }
      ]
    },
    "bis": {
      "preferred_label": "blong heven",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting we i kamaot long heven no long God, no i joen wetem tufala."
        }
      ]
    },
    "hau": {
      "preferred_label": "Na sama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanda ya fito daga sama ko yake da dangantaka da sama ko Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "स्वर्गीय",
      "descriptions": [
        {
          "source": "acai",
          "description": "स्वर्ग या परमेश्वर से आने वाला या उससे संबंधित।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nke eluigwe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe si nʼeluigwe ma ọ bụ nʼebe Chineke nọ, ma ọ bụ nke nwere njikọ na ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "स्वर्गीय",
      "descriptions": [
        {
          "source": "acai",
          "description": "स्वर्ग वा परमेश्‍वरबाट आउने वा उहाँसँग सम्बन्धित।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Небесный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Исходящий от неба или Бога, либо связанный с ними."
        }
      ]
    },
    "spa": {
      "preferred_label": "celestial",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que proviene del cielo o de Dios, o que está relacionado con ellos."
        }
      ]
    },
    "swh": {
      "preferred_label": "-a mbinguni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inayotoka au inayohusiana na mbinguni au Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bilong heven",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting i kam long heven o God, o i pas wantaim heven o God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thuộc về trời",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đến từ hoặc liên quan đến trời hoặc Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "天上的",
      "descriptions": [
        {
          "source": "acai",
          "description": "来自天或上帝，或与天或上帝相关。"
        }
      ]
    },
    "zht": {
      "preferred_label": "天上的",
      "descriptions": [
        {
          "source": "acai",
          "description": "來自天或上帝，或與天或上帝相關的。"
        }
      ]
    }
  },
