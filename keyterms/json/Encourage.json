  ],
  "localizations": {
    "eng": {
      "preferred_label": "Encourage",
      "alternate_labels": [
        "Console"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To help someone feel better and more hopeful by words or actions."
        }
      ]
    },
    "spa": {
      "preferred_label": "animar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ayudar a alguien a sentirse mejor y con más esperanza mediante palabras o acciones."
        }
      ]
    },
    "fra": {
      "preferred_label": "encourager",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aider quelqu'un à se sentir mieux et à reprendre espoir par des paroles ou des actions."
        }
      ]
    },
    "ind": {
      "preferred_label": "menghibur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membantu seseorang merasa lebih baik dan lebih berpengharapan melalui perkataan atau tindakan."
        }
      ]
    },
    "por": {
      "preferred_label": "encorajar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ajudar alguém a se sentir melhor e mais esperançoso por meio de palavras ou ações."
        }
      ]
    },
    "apd": {
      "preferred_label": "يشجع",
      "descriptions": [
        {
          "source": "acai",
          "description": "مساعدة الزول عشان يشعر بتحسن ورجاء أكتر بالكلام أو بالأفعال."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُعَزِّي",
      "descriptions": [
        {
          "source": "acai",
          "description": "مُسَاعَدَةُ شَخْصٍ مَا عَلَى ٱلشُّعُورِ بِتَحَسُّنٍ وَرَجَاءٍ أَكْبَرَ مِنْ خِلَالِ ٱلْكَلَامِ أَوْ ٱلْأَفْعَالِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "leftemap tingting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong givhan long wan man blong mekem hem i harem gud mo gat hop bakegen tru long ol toktok o aksen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙarfafa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taimaka wa wani ya ji daɗi da kuma ƙarin bege ta wurin kalmomi ko ayyuka."
        }
      ]
    },
    "hin": {
      "preferred_label": "उत्साहित करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "शब्दों या कार्यों के द्वारा किसी को बेहतर और अधिक आशावान महसूस करने में मदद करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgba Ume",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inyere mmadụ aka inwe mmetụta ka mma na olileanya karịa site nʼokwu ma ọ bụ nʼomume."
        }
      ]
    },
    "nep": {
      "preferred_label": "उत्साह दिनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै व्यक्तिलाई वचन वा कामद्वारा सान्त्वना दिनु र आशावादी बनाउन मद्दत गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "ободрять",
      "descriptions": [
        {
          "source": "acai",
          "description": "Словами или делами помогать человеку почувствовать себя лучше и обрести больше надежды."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutia Moyo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumsaidia mtu kujisikia vizuri zaidi na kuwa na tumaini zaidi kwa njia ya maneno au matendo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim isi bel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long helpim wanpela manmeri long bel bilong en i stap gut na i gat gutpela tingting moa long rot bilong ol tok o pasin."
        }
      ]
    },
    "vie": {
      "preferred_label": "Khích lệ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Giúp ai đó cảm thấy tốt hơn và có thêm hy vọng bằng lời nói hoặc hành động."
        }
      ]
    },
    "zhs": {
      "preferred_label": "勉励",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过言行帮助他人感觉更好并充满希望。"
        }
      ]
    },
    "zht": {
      "preferred_label": "勉勵",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉著言語或行動幫助某人心情轉好並更有盼望。"
        }
      ]
    }
  },
