{
  "id": "keyterm:NewMoonFestival",
  "primary_id": "keyterm:NewMoonFestival",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "002145001002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "New Moon Festival",
      "descriptions": [
        {
          "source": "acai",
          "description": "A special celebration by the Israelites held when the new moon first appears, marking the start of a new month."
        }
      ]
    },
    "spa": {
      "preferred_label": "fiesta de la luna nueva",
      "descriptions": [
        {
          "source": "acai",
          "description": "Celebración especial de los israelitas que se realizaba cuando aparecía por primera vez la luna nueva, marcando el inicio de un nuevo mes."
        }
      ]
    },
    "fra": {
      "preferred_label": "fête de la nouvelle lune",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une célébration particulière observée par les Israélites lors de l’apparition de la nouvelle lune, marquant le début d’un nouveau mois."
        }
      ]
    },
    "ind": {
      "preferred_label": "perayaan bulan baru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Perayaan khusus bangsa Israel yang diadakan ketika bulan baru pertama kali muncul, yang menandai awal bulan baru."
        }
      ]
    },
    "por": {
      "preferred_label": "festa da lua nova",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma celebração especial dos israelitas realizada quando a lua nova surge pela primeira vez, marcando o início de um novo mês."
        }
      ]
    },
    "apd": {
      "preferred_label": "عيد الهلال",
      "descriptions": [
        {
          "source": "acai",
          "description": "احتفال خاص عند بني إسرائيل بيتعمل أول ما يظهر الهلال الجديد، عشان يحدد بداية شهر جديد."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِيدُ رَأْسِ الشَّهْرِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "احْتِفَالٌ خَاصٌّ عِنْدَ بَنِي إِسْرَائِيلَ يُقَامُ عِنْدَ ظُهُورِ الْهِلَالِ، إِيذَانًا بِبِدَايَةِ شَهْرٍ جَدِيدٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Lafet blong Niumun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan spesel lafet we ol man Isrel oli stap mekem taem niumun i jes kamaot, blong makem stat blong wan niufala manis."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bikin Sabon Wata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani biki na musamman da Isra’ilawa suke yi sa’ad da sabon wata ya fara bayyana, wanda yake nuna farkon sabon wata."
        }
      ]
    },
    "hin": {
      "preferred_label": "नये चाँद का पर्व",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलियों द्वारा मनाया जाने वाला एक विशेष उत्सव जो नए चाँद के पहली बार दिखाई देने पर आयोजित किया जाता था, जो एक नए महीने की शुरुआत का प्रतीक था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mmemme ọnwa ọhụrụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmemme pụrụ iche ụmụ Izrel na-eme mgbe ọnwa ọhụrụ pụtara na nke mbụ ya, na-egosi mmalite nke ọnwa ọhụrụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "औंसीको चाड",
      "descriptions": [
        {
          "source": "acai",
          "description": "औंसी पहिलो पटक देखा पर्दा इस्राएलीहरूले मनाउने एक विशेष चाड, जसले नयाँ महिनाको सुरुआतलाई चिनाउँछ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "новомесячие",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особый праздник израильтян, отмечавшийся при первом появлении молодой луны и знаменовавший начало нового месяца."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sikukuu ya Mwezi Mwandamo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sherehe maalumu ya Waisraeli iliyofanywa wakati mwezi mpya unapoonekana mara ya kwanza, ikiashiria mwanzo wa mwezi mpya."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bikpela de bilong nupela mun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela de bilong selebret ol Israel i save mekim long taim nupela mun i kamap nambawan taim, bilong makim stat bilong nupela mun."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ trăng mới",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ngày lễ đặc biệt của dân Y-sơ-ra-ên được tổ chức khi trăng mới xuất hiện lần đầu, đánh dấu sự khởi đầu của một tháng mới."
        }
      ]
    },
    "zhs": {
      "preferred_label": "月朔节",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人在新月初现时举行的特别节庆，标志着新一个月的开始。"
        }
      ]
    },
    "zht": {
      "preferred_label": "月朔",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人在新月初現時舉行的特別慶祝節期，標誌著一個新月份的開始。"
        }
      ]
    }
  },
