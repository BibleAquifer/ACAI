  "localizations": {
    "eng": {
      "preferred_label": "Consecration (State)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Being set apart for God to serve Him at a special time or for a special reason."
        }
      ]
    },
    "spa": {
      "preferred_label": "consagración (estado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Estar apartado para Dios a fin de servirle en un momento especial o por una razón especial."
        }
      ]
    },
    "fra": {
      "preferred_label": "consécration (état)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le fait d'être mis à part pour Dieu afin de le servir à un moment particulier ou pour une raison particulière."
        }
      ]
    },
    "ind": {
      "preferred_label": "pengudusan (keadaan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Keadaan dikhususkan bagi Allah untuk melayani-Nya pada waktu khusus atau untuk tujuan khusus."
        }
      ]
    },
    "por": {
      "preferred_label": "consagração (estado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O estado de ser separado para Deus a fim de servi-lo em um momento especial ou por uma razão especial."
        }
      ]
    },
    "apd": {
      "preferred_label": "تقديس (حالة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الفرز لله عشان يخدمه في وقت خاص أو لسبب خاص."
        }
      ]
    },
    "arb": {
      "preferred_label": "تكريس (حالة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يُفرز المرء لله ليخدمه في وقت خاص أو لسبب خاص."
        }
      ]
    },
    "bis": {
      "preferred_label": "kam tabu (stap tabu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin we man i stap tabu mo i stap olsem man blong God nomo, blong mekem wok blong Hem long wan spesel taem o from wan spesel risen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zaman tsarki (Hali)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa a keɓe domin Allah don a bauta masa a wani lokaci na musamman ko domin wani dalili na musamman."
        }
      ]
    },
    "hin": {
      "preferred_label": "पवित्रता (स्थिति)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी विशेष समय पर या विशेष कारण से परमेश्वर की सेवा के लिए अलग किया जाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịdị nsọ (Ọnọdụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye e debere iche maka Chineke ijere Ya ozi n'otu oge pụrụ iche ma ọ bụ n'ihi otu ihe pụrụ iche."
        }
      ]
    },
    "nep": {
      "preferred_label": "पवित्रता (अवस्था)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै विशेष समयमा वा विशेष कारणको निम्ति उहाँको सेवा गर्न परमेश्‍वरका लागि अलग गरिएको अवस्था।"
        }
      ]
    },
    "rus": {
      "preferred_label": "освящение (состояние)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Состояние отделенности для Бога, чтобы служить Ему в особое время или с особой целью."
        }
      ]
    },
    "swh": {
      "preferred_label": "Utakaso (Hali)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutengwa kwa ajili ya Mungu ili kumtumikia wakati maalumu au kwa sababu maalumu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kamap holi (Stap holi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong stap olsem manmeri God i makim bilong em yet bilong mekim wok bilong em long wanpela bikpela taim o long wanpela as stret."
        }
      ]
    },
    "vie": {
      "preferred_label": "sự biệt riêng (tình trạng)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Việc được biệt riêng ra cho Đức Chúa Trời để hầu việc Ngài vào một thời điểm đặc biệt hoặc vì một lý do đặc biệt."
        }
      ]
    },
    "zhs": {
      "preferred_label": "成圣 (状态)",
      "descriptions": [
        {
          "source": "acai",
          "description": "为在特定时间或因特定缘由侍奉上帝，而被分别为圣的状态。"
        }
      ]
    },
    "zht": {
      "preferred_label": "成聖 (狀態)",
      "descriptions": [
        {
          "source": "acai",
          "description": "在特別的時刻或為了特別的緣由被分別出來歸給上帝事奉祂。"
        }
      ]
    }
  },
  "referred_to_as": [
