  "localizations": {
    "eng": {
      "preferred_label": "Mischief",
      "alternate_labels": [
        "Evil"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Doing wrong things that hurt others through thoughts, words, or actions."
        }
      ]
    },
    "spa": {
      "preferred_label": "maldad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer cosas malas que dañan a los demás mediante pensamientos, palabras o acciones."
        }
      ]
    },
    "fra": {
      "preferred_label": "iniquité",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait d’accomplir de mauvaises actions qui nuisent à autrui par des pensées, des paroles ou des actes."
        }
      ]
    },
    "ind": {
      "preferred_label": "kejahatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Melakukan hal-hal salah yang merugikan orang lain melalui pikiran, perkataan, atau perbuatan."
        }
      ]
    },
    "por": {
      "preferred_label": "maldade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prática do que é mau e prejudica outras pessoas por meio de pensamentos, palavras ou ações."
        }
      ]
    },
    "apd": {
      "preferred_label": "أذية",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل حاجات غلط بتضر الآخرين بالأفكار أو الأقوال أو الأفعال."
        }
      ]
    },
    "arb": {
      "preferred_label": "سوء",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل أمور خاطئة تؤذي الآخرين من خلال الأفكار أو الأقوال أو الأفعال."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rabis fasin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong mekem ol rabis samting we i spoelem narafala man tru long tingting, toktok, o aksen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mugunta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin munanan abubuwa da suke cutar da wasu ta wurin tunani, kalmomi, ko ayyuka."
        }
      ]
    },
    "hin": {
      "preferred_label": "अनर्थ",
      "descriptions": [
        {
          "source": "acai",
          "description": "विचारों, वचनों या कर्मों से गलत काम करना जिससे दूसरों को हानि पहुँचती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe ọjọọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ihe ọjọọ nke na-ewute ndị ọzọ site nʼechiche, okwu, ma ọ bụ omume."
        }
      ]
    },
    "nep": {
      "preferred_label": "दुष्ट्याइँ",
      "descriptions": [
        {
          "source": "acai",
          "description": "विचार, वचन वा कामद्वारा अरूलाई हानि पुर्‍याउने गलत कामहरू गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Злоумышление",
      "descriptions": [
        {
          "source": "acai",
          "description": "Совершение дурных поступков, причиняющих вред другим мыслями, словами или действиями."
        }
      ]
    },
    "swh": {
      "preferred_label": "Madhara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutenda mambo mabaya yanayowaumiza wengine kupitia mawazo, maneno, au matendo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin nogut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim ol samting nogut we i bagarapim ol arapela long tingting, tok, o pasin."
        }
      ]
    },
    "vie": {
      "preferred_label": "Điều ác",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm những điều sai trái gây tổn hại cho người khác qua tư tưởng, lời nói hoặc hành động."
        }
      ]
    },
    "zhs": {
      "preferred_label": "奸恶",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过思想、言语或行为伤害他人的作恶行径。"
        }
      ]
    },
    "zht": {
      "preferred_label": "危害",
      "descriptions": [
        {
          "source": "acai",
          "description": "透過思想、言語或行為做出傷害他人的錯事。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
