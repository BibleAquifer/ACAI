{
  "id": "keyterm:Uncleanness",
  "primary_id": "keyterm:Defilement",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "002699001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Uncleanness",
      "descriptions": [
        {
          "source": "acai",
          "description": "The condition of being ritually dirty and not suitable for use in religious ceremonies."
        }
      ]
    },
    "spa": {
      "preferred_label": "impureza",
      "descriptions": [
        {
          "source": "acai",
          "description": "La condición de estar ritualmente sucio y no ser apto para su uso en ceremonias religiosas."
        }
      ]
    },
    "fra": {
      "preferred_label": "impureté",
      "descriptions": [
        {
          "source": "acai",
          "description": "L'état d'être rituellement souillé et impropre à un usage dans les cérémonies religieuses."
        }
      ]
    },
    "ind": {
      "preferred_label": "kenajisan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Keadaan najis secara ritual dan tidak layak digunakan dalam upacara keagamaan."
        }
      ]
    },
    "por": {
      "preferred_label": "impureza",
      "descriptions": [
        {
          "source": "acai",
          "description": "A condição de estar ritualmente impuro e não ser apropriado para uso em cerimônias religiosas."
        }
      ]
    },
    "apd": {
      "preferred_label": "نجاسة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حالة النجاسة الطقسية وعدم الصلاحية للاستخدام في الشعائر الدينية."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَجَاسَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حَالَةُ أَنْ يَكُونَ الشَّخْصُ أَوْ الشَّيْءُ نَجِسًا طَقْسِيًّا وَغَيْرَ صَالِحٍ لِلِاسْتِخْدَامِ فِي الشَّعَائِرِ الدِّينِيَّةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin doti long fes blong God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kondisen blong stap doti folem ol kastom mo loa blong wosip we i mekem samting no man i no stret blong yusum long ol lafet mo wosip."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙazanta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yanayin kasancewa marar tsarki a al’ada kuma wanda bai dace a yi amfani da shi a bukukuwan addini ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "अशुद्धता",
      "descriptions": [
        {
          "source": "acai",
          "description": "धार्मिक विधियों के अनुसार अशुद्ध होने और धार्मिक अनुष्ठानों में उपयोग के लिए अयोग्य होने की अवस्था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọnọdụ adịghị ọcha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọnọdụ nke ịbụ onye rụrụ arụ ma ọ bụ onye na-adịghị ọcha n'ememe okpukpe ma ghara ikwesị maka iji mee ihe n'ememe okpukpe."
        }
      ]
    },
    "nep": {
      "preferred_label": "अशुद्धता",
      "descriptions": [
        {
          "source": "acai",
          "description": "धार्मिक विधिअनुसार फोहोर हुनु र धार्मिक विधिहरूमा प्रयोगका निम्ति उपयुक्त नहुनुको अवस्था।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Нечистота",
      "descriptions": [
        {
          "source": "acai",
          "description": "Состояние ритуальной оскверненности и непригодности для участия в религиозных обрядах."
        }
      ]
    },
    "swh": {
      "preferred_label": "Unajisi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hali ya kuwa mwenye unajisi wa kiibada na kutofaa kutumiwa katika sherehe za kidini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin doti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kain sindaun we samting o man i doti long pasin bilong lotu na i no stret long yusim long ol seremoni bilong lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự ô uế",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tình trạng ô uế theo nghi lễ và không thích hợp để dùng trong các nghi thức tôn giáo."
        }
      ]
    },
    "zhs": {
      "preferred_label": "不洁净",
      "descriptions": [
        {
          "source": "acai",
          "description": "礼仪上不洁净且不适合用于宗教礼仪的状态。"
        }
      ]
    },
    "zht": {
      "preferred_label": "污穢",
      "descriptions": [
        {
          "source": "acai",
          "description": "在禮儀上處於污穢且不適合用於宗教儀式的狀態。"
        }
      ]
    }
  },
