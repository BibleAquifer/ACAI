    "000192001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Foolish",
      "alternate_labels": [
        "Worthless",
        "Good-for-Nothing"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Showing lack of respect for God, not listening to advice, talking too much, and having a quick temper."
        }
      ]
    },
    "spa": {
      "preferred_label": "necio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mostrar falta de respeto hacia Dios, no escuchar consejos, hablar demasiado y enojarse con facilidad."
        }
      ]
    },
    "fra": {
      "preferred_label": "insensé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait de manquer de respect envers Dieu, de ne pas écouter les conseils, de trop parler et de s'emporter facilement."
        }
      ]
    },
    "ind": {
      "preferred_label": "bodoh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menunjukkan kurangnya rasa hormat kepada Allah, tidak mau mendengarkan nasihat, terlalu banyak bicara, dan lekas marah."
        }
      ]
    },
    "apd": {
      "preferred_label": "غبي",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار عدم احترام الله، وعدم الاستماع للنصيحة، والكلام الكتير، وسرعة الغضب."
        }
      ]
    },
    "arb": {
      "preferred_label": "أحمق",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار قلة الاحترام لله، وعدم الإصغاء إلى المشورة، والإكثار من الكلام، وسرعة الغضب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Krangke",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin we man i soemaot se hem i no gat hed no i krangke, i no gat rispek long God, i no wantem harem advaes, i toktok tumas, mo i kros kwiktaem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai wauta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna rashin girmamawa ga Allah, ƙin sauraron shawara, yawan magana, da rashin haƙuri."
        }
      ]
    },
    "hin": {
      "preferred_label": "मूर्खतापूर्ण",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर के प्रति आदर की कमी दिखाना, सलाह न सुनना, बहुत अधिक बोलना, और शीघ्र क्रोधित होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nzuzu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosipụta enweghị nkwanye ùgwù nye Chineke, ịjụ ige ntị na ndụmọdụ, ikwu okwu nke ukwuu, na inwe iwe ọsọ ọsọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "मूर्ख",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरप्रति आदरको कमी देखाउने, सल्लाह नसुन्ने, धेरै बोल्ने, र छिट्टै रिसाउने स्वभाव भएको।"
        }
      ]
    },
    "por": {
      "preferred_label": "insensato",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demonstrar falta de respeito a Deus, não ouvir conselhos, falar demais e perder o controle facilmente."
        }
      ]
    },
    "rus": {
      "preferred_label": "Глупый",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявление неуважения к Богу, нежелание слушать советы, многословие и несдержанность."
        }
      ]
    },
    "swh": {
      "preferred_label": "-pumbavu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuonyesha ukosefu wa heshima kwa Mungu, kutosikiliza mashauri, kuongea kupita kiasi, na kuwa na hasira ya haraka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "longlong",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong no rispek long Bikpela, no harim tok bilong skul, toktok planti tumas, na belhat kwik."
        }
      ]
    },
    "vie": {
      "preferred_label": "Điên rồ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bày tỏ sự thiếu tôn kính Đức Chúa Trời, không lắng nghe lời khuyên bảo, nói quá nhiều và nóng nảy."
        }
      ]
    },
    "zhs": {
      "preferred_label": "愚妄",
      "descriptions": [
        {
          "source": "acai",
          "description": "表现出对上帝缺乏敬畏、不听劝告、言语过多且脾气急躁。"
        }
      ]
    },
    "zht": {
      "preferred_label": "愚昧",
      "descriptions": [
        {
          "source": "acai",
          "description": "表現出對上帝缺乏敬畏、不聽勸告、多言多語，並且性情急躁。"
        }
      ]
    }
  },
  "referred_to_as": [
