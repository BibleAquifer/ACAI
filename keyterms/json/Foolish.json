{
  "id": "keyterm:Foolish",
  "primary_id": "keyterm:Foolish",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "33.376"
  ],
  "ubsdbh": [
    "000190001001000",
