{
  "id": "keyterm:Smear",
  "primary_id": "keyterm:Smear",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "004471001001000",
    "004471001002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Smear",
      "alternate_labels": [
        "Anoint"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To spread oil or another substance on someone, often as a sign of being chosen by God."
        }
      ]
    },
    "spa": {
      "preferred_label": "untar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Untar aceite u otra sustancia sobre alguien, a menudo como señal de haber sido elegido por Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "oindre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Répandre de l’huile ou une autre substance sur quelqu’un, souvent comme signe d’élection par Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengolesi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengoleskan minyak atau zat lain pada seseorang, sering kali sebagai tanda dipilih oleh Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "ungir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Passar óleo ou outra substância em alguém ou em algo, frequentemente como sinal de ter sido escolhido por Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "مسح",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسح الزيت أو مادة تانية على زول، وغالباً كعلامة على إنو الله اختارو."
        }
      ]
    },
    "arb": {
      "preferred_label": "مسح",
      "descriptions": [
        {
          "source": "acai",
          "description": "بسط زيت أو مادة أخرى على شخص ما، غالبًا كعلامة على اختياره من قِبل الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "rabem oel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kafsaedem no rabem oel o wan narafala samting long wan man, olsem wan saen we God i jusumaot hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shafawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shafa mai ko wani abu a kan wani, sau da yawa a matsayin alamar zaɓaɓɓen Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "अभिषेक करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी पर तेल या कोई अन्य पदार्थ लगाना, जो अक्सर परमेश्वर द्वारा चुने जाने का प्रतीक होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ite mmanụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ite mmadụ mmanụ ma ọ bụ ihe ọzọ n'ahụ, nke na-abụkarị ihe ịrịba ama nke ịbụ onye Chineke họọrọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "दल्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः परमेश्‍वरद्वारा चुनिएको चिन्हको रूपमा कसैलाई तेल वा अन्य कुनै पदार्थ दल्नु वा घस्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Помазывать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Возлияние или растирание масла либо другого вещества на кого-либо, часто как знак избранности Богом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kupaka Mafuta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kupaka mafuta au kitu kingine juu ya mtu, mara nyingi kama ishara ya kuteuliwa na Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "penim wel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Penim wel o narapela samting long wanpela manmeri, planti taim olsem mak bilong soim olsem God i bin makim em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bôi xức",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thoa hoặc bôi dầu hay một chất khác lên ai đó hoặc vật nào đó, thường là dấu hiệu của việc được Đức Chúa Trời lựa chọn hoặc biệt riêng ra thánh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "涂抹",
      "descriptions": [
        {
          "source": "acai",
          "description": "将油或其他物质涂抹在某人身上，通常作为被上帝选立的标志。"
        }
      ]
    },
    "zht": {
      "preferred_label": "塗抹",
      "descriptions": [
        {
          "source": "acai",
          "description": "把油或其他物質塗抹在某人身上，通常作為被上帝選召的記號。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
  "lemmas": {
    "he": [
      "משׁח"
    ]
  },
