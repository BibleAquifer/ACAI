          "description": "To help someone agree with an idea and take action based on it."
        }
      ]
    },
    "spa": {
      "preferred_label": "persuadir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ayudar a alguien a estar de acuerdo con una idea y a actuar en consecuencia."
        }
      ]
    },
    "fra": {
      "preferred_label": "persuader",
      "descriptions": [
        {
          "source": "acai",
          "description": "Amener quelqu'un à adhérer à une idée et à agir en conséquence."
        }
      ]
    },
    "ind": {
      "preferred_label": "meyakinkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membantu seseorang menyetujui suatu gagasan dan bertindak berdasarkan gagasan tersebut."
        }
      ]
    },
    "por": {
      "preferred_label": "persuadir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ajudar alguém a concordar com uma ideia e agir com base nela."
        }
      ]
    },
    "apd": {
      "preferred_label": "يقنع",
      "descriptions": [
        {
          "source": "acai",
          "description": "تخلي زول يقتنع بفكرة ويتصرف على أساسها."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِقْنَاع",
      "descriptions": [
        {
          "source": "acai",
          "description": "مُسَاعَدَةُ شَخْصٍ مَا عَلَى ٱلِٱقْتِنَاعِ بِفِكْرَةٍ وَٱلتَّصَرُّفِ بِنَاءً عَلَيْهَا."
        }
      ]
    },
    "bis": {
      "preferred_label": "pulum tingting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong givhan long wan man blong i agri long wan tingting mo mekem samting folem tingting ya."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rinjaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taimaka wa wani ya yarda da wani ra'ayi kuma ya ɗauki mataki bisa ga wannan ra'ayin."
        }
      ]
    },
    "hin": {
      "preferred_label": "समझाना-बुझाना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी विचार से सहमत होने और उसके आधार पर कदम उठाने के लिए किसी को समझाना या मनाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ime ka o kwenye",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inyere mmadụ aka ikweta nʼotu echiche na ime ihe dabere na ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "विश्‍वस्त पार्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै विचारमा सहमत हुन र त्यसको आधारमा कदम चाल्न कसैलाई मनाउनु वा विश्‍वस्त पार्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Убеждать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Помогать кому-либо согласиться с какой-либо мыслью и действовать в соответствии с ней."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kushawishi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumsaidia mtu akubaliane na wazo fulani na kuchukua hatua kulingana nalo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kirapim tingting bilong bilip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long helpim wanpela long wanbel wantaim wanpela tingting na mekim samting long dispela tingting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thuyết phục",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thuyết phục ai đó đồng ý với một ý tưởng và hành động dựa trên ý tưởng đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "劝说",
      "descriptions": [
        {
          "source": "acai",
          "description": "帮助某人赞同一个想法并据此采取行动。"
        }
      ]
    },
    "zht": {
      "preferred_label": "勸導",
      "descriptions": [
        {
          "source": "acai",
          "description": "使人認同某個想法並據此採取行動。"
        }
      ]
    }
  },
