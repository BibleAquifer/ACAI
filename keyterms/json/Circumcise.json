{
  "id": "keyterm:Circumcise",
  "primary_id": "keyterm:Circumcision",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "53.51",
    "11.51"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Circumcize",
      "descriptions": [
        {
          "source": "acai",
          "description": "To surgically remove the skin covering the head of a male's private part as a sign of belonging to God's people."
        }
      ]
    },
    "spa": {
      "preferred_label": "circuncidar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Extirpar quirúrgicamente la piel que cubre la cabeza de la parte íntima de un varón como señal de pertenencia al pueblo de Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "circoncire",
      "descriptions": [
        {
          "source": "acai",
          "description": "Enlever chirurgicalement le prépuce recouvrant le gland d'un homme en signe d'appartenance au peuple de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "menyunatkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memotong melalui pembedahan kulit penutup ujung alat kelamin laki-laki sebagai tanda menjadi bagian dari umat Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "circuncidar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Remover cirurgicamente a pele que cobre a cabeça do órgão genital masculino como sinal de pertencer ao povo de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "يختن",
      "descriptions": [
        {
          "source": "acai",
          "description": "قطع الجلدة البتغطي راس العضو التناسلي للذكر كعلامة للانتماء لشعب الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "خَتَنَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "إزالة الجلد الذي يغطي رأس العضو التناسلي للذكر جراحيًا كعلامة على الانتماء إلى شعب الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem sakomsaes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong katemaot skin we i kavremap hed blong sem blong man olsem wan saen blong soemaot se hem i wan man blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin kaciya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin aikin tiyata don cire fatar da take rufe kan azakarin namiji a matsayin alamar zama na mutanen Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "खतना करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर के लोगों से संबंध रखने के चिन्ह के रूप में पुरुष के गुप्तांग के अगले भाग की त्वचा को शल्यक्रिया द्वारा काटना या हटाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ibi ugwu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iji ịwa ahụ wepụ akpụkpọ anụ ahụ na-ekpuchi isi amụ nwoke dịka ihe ịrịba ama nke ịbụ ndị nke Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "खतना गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरका मानिसहरूमा सामेल भएको सङ्केतको रूपमा पुरुषको अङ्गको माथिल्लो छाला शल्यक्रिया गरेर हटाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Обрезывать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Хирургически удалять крайнюю плоть у мужчины в знак принадлежности к Божьему народу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutahiri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kukata kwa upasuaji ngozi inayofunika kichwa cha sehemu ya siri ya mwanamume kama ishara ya kuwa wa watu wa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Katim skin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Katam skin i karamapim het bilong kok bilong man olsem wanpela mak bilong stap olsem lain manmeri bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cắt bì",
      "descriptions": [
        {
          "source": "acai",
          "description": "Phẫu thuật cắt bỏ lớp da bọc quy đầu của nam giới như một dấu hiệu thuộc về dân của Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "行割礼",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过手术切除男性私处顶端包皮的仪式，作为属于上帝子民的记号。"
        }
      ]
    },
    "zht": {
      "preferred_label": "行割禮",
      "descriptions": [
        {
          "source": "acai",
          "description": "透過手術切除男性生殖器頂端包皮的行為，作為屬於上帝子民的記號。"
        }
      ]
    }
  },
