        }
      ]
    },
    "arb": {
      "preferred_label": "سَجَّلَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "تَدْوينُ اسْمِ الشَّخْصِ في قائِمَةٍ، غالِبًا أَثْناءَ إِحْصاءِ النّاسِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rejista",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong raetem nem blong wan man i go long wan lis, plante taem long taem blong kaontem ol man."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin Rajista",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rubuta sunan mutum a cikin jerin sunaye, musamman a lokacin ƙididdigar mutane."
        }
      ]
    },
    "hin": {
      "preferred_label": "नाम दर्ज़ करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "अक्सर लोगों की गिनती के दौरान किसी सूची में किसी व्यक्ति का नाम लिखना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịdebanye aha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ide aha mmadụ nʼime ndepụta, ọkachasị nʼoge ngụkọta ndị mmadụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "दर्ता गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः मानिसहरूको गणना गर्दा सूचीमा कुनै व्यक्तिको नाम दर्ता गर्नु वा लेख्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Записывать в список",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вносить чьё-либо имя в список, часто во время переписи людей."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusajili",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuandika jina la mtu katika orodha, mara nyingi wakati wa kuhesabu watu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "raitim nem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Raitim nem bilong wanpela manmeri long lista, planti taim em long taim bilong kauntim ol manmeri."
