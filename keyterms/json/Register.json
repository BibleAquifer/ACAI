      ]
    },
    "vie": {
      "preferred_label": "Ghi danh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ghi tên một người vào danh sách, thường trong một cuộc kiểm tra dân số."
        }
      ]
    },
    "zhs": {
      "preferred_label": "登记",
      "descriptions": [
        {
          "source": "acai",
          "description": "将人的名字写在名册上，通常是在人口普查时。"
        }
      ]
    },
    "zht": {
      "preferred_label": "登記報名",
      "descriptions": [
        {
          "source": "acai",
          "description": "將某人的名字登記在名冊上，通常發生在人口普查期間。"
        }
      ]
    }
