{
  "id": "keyterm:Thanks",
  "primary_id": "keyterm:Favor",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "25.89",
    "33.350",
    "88.66"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Gratitude",
      "alternate_labels": [
        "Thanksgiving",
        "Gratitude",
        "Credit"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Showing or saying you are happy and grateful for what someone has done."
        }
      ]
    },
    "fra": {
      "preferred_label": "reconnaissance",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait de montrer ou d'exprimer que l'on est heureux et reconnaissant pour ce que quelqu'un a fait."
        }
      ]
    },
    "ind": {
      "preferred_label": "syukur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menunjukkan atau menyatakan rasa senang dan berterima kasih atas apa yang telah dilakukan seseorang."
        }
      ]
    },
    "por": {
      "preferred_label": "gratidão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demonstrar ou expressar que se está alegre e grato pelo que alguém fez."
        }
      ]
    },
    "apd": {
      "preferred_label": "شُكُر",
      "descriptions": [
        {
          "source": "acai",
          "description": "تبين أو تقول إنك مبسوط وممتن للي عملو زول عشانك."
        }
      ]
    },
    "arb": {
      "preferred_label": "شُكْر",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار الفرح والامتنان أو التعبير عنهما لما فعله شخص ما."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tangkiu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong soemaot o talemaot se yu glad mo yu talem tangkiu from wanem we wan man i mekem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Godiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna ko faɗin cewa kana farin ciki da godiya ga abin da wani ya yi."
        }
      ]
    },
    "hin": {
      "preferred_label": "धन्यवाद",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी ने जो किया है उसके प्रति प्रसन्नता और आभार व्यक्त करना या कहना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ekele",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosipụta ma ọ bụ ikwu na obi dị gị ụtọ ma nwee ekele maka ihe mmadụ mere."
        }
      ]
    },
    "nep": {
      "preferred_label": "कृतज्ञता",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैले गरेको कामका लागि आफू खुसी र कृतज्ञ भएको देखाउने वा बताउने कार्य।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Благодарность",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявление или выражение радости и признательности за то, что кто-то сделал."
        }
      ]
    },
    "spa": {
      "preferred_label": "gratitud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mostrar o expresar alegría y agradecimiento por lo que alguien ha hecho."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shukrani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuonyesha au kusema kwamba una furaha na shukrani kwa kile ambacho mtu fulani amefanya."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong tenkyu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong soim o autim olsem yu amamas na tenkyu long samting wanpela i bin mekim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lòng biết ơn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bày tỏ hoặc nói ra rằng mình vui mừng và biết ơn về điều ai đó đã làm."
        }
      ]
    },
    "zhs": {
      "preferred_label": "感恩",
      "descriptions": [
        {
          "source": "acai",
          "description": "因某人所做的事而感到快乐并表达感激之情。"
        }
      ]
    },
    "zht": {
      "preferred_label": "感謝",
      "descriptions": [
        {
          "source": "acai",
          "description": "對某人所做的事表現或表達高興與感激。"
        }
      ]
    }
  },
  "referred_to_as": [
