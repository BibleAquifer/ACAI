      "preferred_label": "Gift (Offering)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Something given or offered, often as a sign of thanks or worship."
        }
      ]
    },
    "spa": {
      "preferred_label": "ofrenda (ofrenda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo que se da u ofrece, a menudo como señal de gratitud o adoración."
        }
      ]
    },
    "fra": {
      "preferred_label": "don (offrande)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chose donnée ou offerte, souvent en signe de reconnaissance ou d'adoration."
        }
      ]
    },
    "ind": {
      "preferred_label": "persembahan (korban)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sesuatu yang diberikan atau dipersembahkan, sering kali sebagai tanda terima kasih atau penyembahan."
        }
      ]
    },
    "por": {
      "preferred_label": "oferta (oferta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo dado ou oferecido, frequentemente como sinal de gratidão ou adoração."
        }
      ]
    },
    "apd": {
      "preferred_label": "عطية (قربان)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة بتتعطى أو بتتقدم، غالباً كعلامة للشكر أو العبادة."
        }
      ]
    },
    "arb": {
      "preferred_label": "قُرْبَان (تَقْدِمَة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "شيء يُعطى أو يُقدَّم، وغالبًا كعلامة على الشكر أو العبادة."
        }
      ]
    },
    "bis": {
      "preferred_label": "presen (ofa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we man i givim o ofrem, plante taem olsem wan saen blong talem tangkyu o wosip."
        }
      ]
    },
    "hau": {
      "preferred_label": "Baiko (Hadaya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da aka bayar ko aka miƙa, sau da yawa a matsayin alamar godiya ko sujada."
        }
      ]
    },
    "hin": {
      "preferred_label": "भेंट (चढ़ावा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दी या चढ़ाई जाने वाली कोई वस्तु, जो प्रायः धन्यवाद या आराधना के प्रतीक रूप में हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onyinye (Àjà)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe e nyere ma ọ bụ chụọ nʼaja, na-abụkarị ihe ịrịba ama nke ekele ma ọ bụ ofufe."
        }
      ]
    },
    "nep": {
      "preferred_label": "भेटी (उपहार)",
      "descriptions": [
        {
          "source": "acai",
          "description": "धन्यवाद वा आराधनाको चिन्हको रूपमा दिइएको वा चढाइएको थोक।"
        }
      ]
    },
    "rus": {
      "preferred_label": "дар (приношение)",
      "descriptions": [
        {
          "source": "acai",
          "description": "То, что дается или приносится в жертву, часто в знак благодарности или поклонения."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sadaka (Zawadi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu kinachotolewa kama zawadi au toleo, mara nyingi kama ishara ya shukrani au ibada."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ofa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting ol i givim o ofaim, planti taim olsem mak bilong tenkyu o lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ vật (Dâng hiến)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vật được cho hoặc dâng lên, thường như một dấu hiệu của sự cảm tạ hoặc thờ phượng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "礼物 (供物)",
      "descriptions": [
        {
          "source": "acai",
          "description": "所赠予或献上的物品，通常作为感恩或敬拜的表示。"
        }
      ]
    },
    "zht": {
      "preferred_label": "禮物 (奉獻)",
      "descriptions": [
        {
          "source": "acai",
          "description": "給予或獻上的事物，常作為感謝或敬拜的表示。"
        }
      ]
    }
  },
