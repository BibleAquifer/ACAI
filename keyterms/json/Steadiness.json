  "localizations": {
    "eng": {
      "preferred_label": "Steadiness (Quality)",
      "alternate_labels": [
        "Faithfulness",
        "Trust"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Being firm and dependable, showing trust and loyalty in all situations."
        }
      ]
    },
    "spa": {
      "preferred_label": "firmeza (cualidad)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Condición de ser firme y confiable, demostrando confianza y lealtad en toda situación."
        }
      ]
    },
    "fra": {
      "preferred_label": "fidélité (qualité)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait d'être ferme et digne de confiance, faisant preuve de fidélité et de loyauté en toute situation."
        }
      ]
    },
    "ind": {
      "preferred_label": "kemantapan (sifat)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sifat teguh dan dapat diandalkan, menunjukkan kepercayaan dan kesetiaan dalam segala situasi."
        }
      ]
    },
    "apd": {
      "preferred_label": "ثبات (صفة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الكون زول ثابت وموثوق فيه، وبيظهر الأمانة والوفاء في كل الظروف."
        }
      ]
    },
    "arb": {
      "preferred_label": "أمانة (صفة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الثبات والاعتمادية، وإظهار الأمانة والولاء في جميع الظروف."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong stap tru (Kualiti)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong stap strong mo stap tru, we man i soemaot se oli save trastem hem mo hem i stap tru long evri situesen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tsayin Daka (Hali)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zama mai tsayawa kyam da abin dogara, yana nuna amincewa da aminci a kowane hali."
        }
      ]
    },
    "hin": {
      "preferred_label": "दृढ़ता (गुण)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दृढ़ और भरोसेमंद होना, सभी परिस्थितियों में विश्वास और निष्ठा प्रदर्शित करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikwesị ntụkwasị obi (Àgwà)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye guzosiri ike na onye a pụrụ ịtụkwasị obi, na-egosi ntụkwasị obi na ikwesị ntụkwasị obi nʼọnọdụ niile."
        }
      ]
    },
    "nep": {
      "preferred_label": "स्थिरता (गुण)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दृढ र भरपर्दो हुनु, सबै परिस्थितिहरूमा भरोसा र निष्ठा देखाउनु।"
        }
      ]
    },
    "por": {
      "preferred_label": "firmeza (qualidade)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser firme e confiável, demonstrando confiança e lealdade em todas as situações."
        }
      ]
    },
    "rus": {
      "preferred_label": "Верность (качество)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Твердость и надежность, проявление верности и преданности в любых обстоятельствах."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uthabiti (Sifa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa imara na wa kutegemewa, ukidhihirisha uaminifu na utiifu katika hali zote."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong stap strong na tru (pasin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong stap strong na stap tru oltaim, na soim pasin bilong bilip na bihainim promis long olgeta taim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thành tín (Phẩm chất)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sự vững vàng và đáng tin cậy, thể hiện lòng tin và sự trung tín trong mọi hoàn cảnh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "信实可靠 (品质)",
      "descriptions": [
        {
          "source": "acai",
          "description": "坚定可靠，在所有处境中都显出可信与忠诚。"
        }
      ]
    },
    "zht": {
      "preferred_label": "信實 (特質)",
      "descriptions": [
        {
          "source": "acai",
          "description": "堅定可靠，在任何情況下都展現出值得信賴與忠誠。"
        }
      ]
    }
  },
