{
  "id": "keyterm:WaveOffering",
  "primary_id": "keyterm:Offering",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "007865001001000",
    "007865001002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Wave-Offering",
      "descriptions": [
        {
          "source": "acai",
          "description": "An offering that is lifted up and moved back and forth as a sign of giving it to God."
        }
      ]
    },
    "spa": {
      "preferred_label": "ofrenda mecida",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ofrenda que se levanta y se mece de un lado a otro como señal de entrega a Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "offrande agitée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une offrande qui est élevée et balancée d'avant en arrière en signe de consécration à Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "persembahan unjukan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Persembahan yang diangkat dan digerakkan ke depan dan ke belakang sebagai tanda mempersembahkannya kepada Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "oferta movida",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma oferta que é levantada e movida para a frente e para trás como sinal de dedicação a Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "ذبيحة ترديد",
      "descriptions": [
        {
          "source": "acai",
          "description": "قربان برفعوه ويحرّكوه قدام وورا كعلامة لتقديمه لله."
        }
      ]
    },
    "arb": {
      "preferred_label": "ذَبِيحَةُ تَرْدِيدٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "تَقْدِمَةٌ تُرْفَعُ وتُرَدَّدُ ذَهابًا وإِيابًا كَعَلامَةٍ عَلى تَقْدِيمِها للهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Spesel presen we oli leftemap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan sakrefaes we oli leftemap mo seksekem long fes blong Hae God olsem wan saen blong givim i go long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hadaya ta kaɗawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hadaya da ake ɗagawa ana kaɗawa a gaba da baya a matsayin alamar miƙa ta ga Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "हिलाने की भेंट",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक भेंट जिसे परमेश्वर को अर्पित करने के प्रतीक के रूप में ऊपर उठाया और आगे-पीछे हिलाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aja mfufe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyinye a na-ebuli elu ma na-efufe nʼihu na nʼazụ dịka ihe ịrịba ama nke inyefe ya nye Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "डोलाइने बलि",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरलाई अर्पण गरिएको सङ्केतको रूपमा उठाएर अघि र पछि डोलाइने बलि।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Жертва потрясания",
      "descriptions": [
        {
          "source": "acai",
          "description": "Приношение, которое поднимают и потрясают им вперед и назад в знак посвящения Богу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sadaka ya kuinuliwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sadaka inayoinuliwa na kutikiswa mbele na nyuma kama ishara ya kumtolea Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ofa bilong mekim i go i kam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ofa ol i save litimapim na mekim han i go i kam olsem mak bilong givim long God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tế lễ đưa qua đưa lại",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một của lễ được dâng lên và đưa qua đưa lại như một dấu hiệu dâng hiến cho Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "摇祭",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种被举起并前后摇动的祭物，以此作为献给上帝的标记。"
        }
      ]
    },
    "zht": {
      "preferred_label": "搖祭",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種被舉起並前後搖動以象徵獻給上帝的祭物。"
        }
      ]
    }
  },
  "referred_to_as": [
