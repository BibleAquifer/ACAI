{
  "id": "keyterm:Peace.2",
  "primary_id": "keyterm:Peace",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "22.42",
    "25.248"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Peace (State)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A time when everything is calm and safe, and people feel free from worry."
        }
      ]
    },
    "spa": {
      "preferred_label": "paz (estado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tiempo en que todo está en calma y seguro, y las personas se sienten libres de preocupación."
        }
      ]
    },
    "fra": {
      "preferred_label": "paix (état)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une période où tout est calme et sûr, et où les gens se sentent libres de toute inquiétude."
        }
      ]
    },
    "ind": {
      "preferred_label": "damai sejahtera (keadaan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Masa ketika segalanya tenang dan aman, dan orang-orang terbebas dari rasa cemas."
        }
      ]
    },
    "por": {
      "preferred_label": "paz (estado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um período em que tudo está calmo e seguro, e as pessoas se sentem livres de preocupações."
        }
      ]
    },
    "apd": {
      "preferred_label": "سلام (حالة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "وقت بيكون فيه كل شي هادي وآمن، والناس بيحسوا بإنهم مرتاحين من غير قلق."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَلَام (حَالَة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَقْتٌ يَكُونُ فِيهِ كُلُّ شَيْءٍ هَادِئًا وَآمِنًا، وَيَشْعُرُ فِيهِ ٱلنَّاسُ بِٱلتَّحَرُّرِ مِنَ ٱلْقَلَقِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Pis (Kondisen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taem we evri samting i stap kwaet mo i sef, mo ol man oli no gat wari."
        }
      ]
    },
    "hau": {
      "preferred_label": "Salama (Hali)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lokaci da komai yake da kwanciyar hankali da aminci, kuma mutane ba sa cikin damuwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "शान्ति (अवस्था)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक ऐसा समय जब सब कुछ शांत और सुरक्षित होता है, और लोग चिंता से मुक्त महसूस करते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Udo (Ọnọdụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oge ihe niile dị jụụ ma nọrọ na nchebe, ndị mmadụ enweghịkwa nchegbu."
        }
      ]
    },
    "nep": {
      "preferred_label": "शान्ति (अवस्था)",
      "descriptions": [
        {
          "source": "acai",
          "description": "सबै कुरा शान्त र सुरक्षित हुने, तथा मानिसहरू चिन्तामुक्त महसुस गर्ने समय वा अवस्था।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Мир (состояние)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Время спокойствия и безопасности, когда люди свободны от тревог."
        }
      ]
    },
    "swh": {
      "preferred_label": "Amani (hali)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wakati ambapo kila kitu kiko shwari na salama, na watu wanajisikia hawana wasiwasi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Bel isi (Sindaun)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taim we olgeta samting i stap bel isi na gutpela tasol, na ol manmeri i no gat tingting planti o hevi."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bình an (Trạng thái)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thời kỳ mọi sự đều êm đềm, an toàn, và con người cảm thấy không còn lo lắng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "平安 (状态)",
      "descriptions": [
        {
          "source": "acai",
          "description": "凡事平静而安全、人们心中没有忧虑的状态。"
        }
      ]
    },
    "zht": {
      "preferred_label": "平安（狀態）",
      "descriptions": [
        {
          "source": "acai",
          "description": "一切平靜安穩、人們毫無憂慮的狀態。"
        }
      ]
    }
  },
  "referred_to_as": [
