{
  "id": "keyterm:Salvation.4",
  "primary_id": "keyterm:Salvation",
  "type": "keyterm",
  "keyterm_type": "miscellaneous",
  "ubsdbh": [
    "007960001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Salvation (Deliverance)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Being rescued from trouble or danger by someone else's help."
        }
      ]
    },
    "spa": {
      "preferred_label": "salvación (liberación)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser rescatado de la angustia o el peligro mediante la ayuda de otra persona."
        }
      ]
    },
    "fra": {
      "preferred_label": "salut (délivrance)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le fait d'être délivré d'une épreuve ou d'un danger grâce à l'aide de quelqu'un d'autre."
        }
      ]
    },
    "ind": {
      "preferred_label": "keselamatan (kelepasan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dilepaskan dari kesulitan atau bahaya melalui pertolongan pihak lain."
        }
      ]
    },
    "por": {
      "preferred_label": "salvação (livramento)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser resgatado da aflição ou do perigo pelo socorro de outra pessoa."
        }
      ]
    },
    "apd": {
      "preferred_label": "خلاص (نجاة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الإنقاذ من الضيق أو الخطر بمساعدة زول تاني."
        }
      ]
    },
    "arb": {
      "preferred_label": "خلاص (إنقاذ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الإنقاذ من الضيق أو الخطر بمعونة شخص آخر."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong sevem man (Riliif)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong kam fri o we wan narafala man i sevem yu long trabol o denja."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ceto (Kuɓuta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samun tsira ko kuɓuta daga matsala ko haɗari ta wurin taimakon wani."
        }
      ]
    },
    "hin": {
      "preferred_label": "उद्धार (छुटकारा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी अन्य की सहायता से संकट या खतरे से छुड़ाया जाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nzọpụta (Nnapụta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye a napụtara ná nsogbu ma ọ bụ ihe ize ndụ site nʼenyemaka onye ọzọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "उद्धार (छुटकारा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरू कसैको सहायताद्वारा कष्ट वा खतराबाट बचाइनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Спасение (избавление)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Избавление от беды или опасности благодаря чьей-то помощи."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wokovu (Ukombozi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuokolewa kutoka taabuni au hatarini kupitia msaada wa mtu mwingine."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kisim bek (Helpim bilong kisim bek)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong kisim bek man long hevi o trabel long rot bilong helpim bilong narapela."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự cứu rỗi (sự giải cứu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Được giải cứu khỏi hoạn nạn hoặc nguy khốn nhờ sự trợ giúp của người khác."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拯救 (解救)",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉着他人的帮助从患难或危险中获救。"
        }
      ]
    },
    "zht": {
      "preferred_label": "拯救（解救）",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由他人的幫助從患難或危險中蒙解救。"
        }
      ]
    }
  },
