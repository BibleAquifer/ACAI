  "localizations": {
    "eng": {
      "preferred_label": "In Vain",
      "descriptions": [
        {
          "source": "acai",
          "description": "Having no use or meaning; doing something without any result or purpose."
        }
      ]
    },
    "spa": {
      "preferred_label": "en vano",
      "descriptions": [
        {
          "source": "acai",
          "description": "No tener utilidad ni sentido; hacer algo sin ningún resultado o propósito."
        }
      ]
    },
    "fra": {
      "preferred_label": "en vain",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sans utilité ni signification ; faire quelque chose sans aucun résultat ou but."
        }
      ]
    },
    "ind": {
      "preferred_label": "sia-sia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak berguna atau tidak ada artinya; melakukan sesuatu tanpa hasil atau tujuan apa pun."
        }
      ]
    },
    "por": {
      "preferred_label": "em vão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não ter utilidade ou sentido; fazer algo sem nenhum resultado ou propósito."
        }
      ]
    },
    "apd": {
      "preferred_label": "باطل",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة ما عندها فايدة ولا معنى؛ أو عمل حاجة من غير أي نتيجة أو هدف."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَاطِلًا",
      "descriptions": [
        {
          "source": "acai",
          "description": "عَديمُ النَّفْعِ أوِ المَعنى؛ فِعْلُ شَيءٍ دونَ أيِّ نَتيجةٍ أو غايةٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "blong nating",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong i no gat wok no mining blong hem; mekem wan samting we i no gat risal no stamba tingting nating."
        }
      ]
    },
    "hau": {
      "preferred_label": "A banza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin amfani ko ma'ana; yin wani abu ba tare da wani sakamako ko manufa ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "व्यर्थ",
      "descriptions": [
        {
          "source": "acai",
          "description": "जिसका कोई उपयोग या अर्थ न हो; बिना किसी परिणाम या उद्देश्य के कुछ करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nʼefu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Enweghị isi maọbụ ihe ọ pụtara; ime ihe nʼenweghị nsonaazụ ọ bụla maọbụ nzube ọ bụla."
        }
      ]
    },
    "nep": {
      "preferred_label": "व्यर्थ",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै काम नलाग्ने वा अर्थ नभएको; कुनै फल वा उद्देश्यविना केही गरिनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "напрасно",
      "descriptions": [
        {
          "source": "acai",
          "description": "Не имеющий пользы или смысла; совершение чего-либо без всякого результата или цели."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bure",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutokuwa na manufaa au maana; kufanya jambo bila matokeo yoyote au bila kusudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Wok nating",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting i no gat wok o as bilong en; mekim wanpela samting na i no gat wanpela gutpela samting o gutpela as bilong en i kamap."
        }
      ]
    },
    "vie": {
      "preferred_label": "Vô ích",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không có ích lợi hay ý nghĩa gì; làm việc gì đó mà không mang lại kết quả hay mục đích nào."
        }
      ]
    },
    "zhs": {
      "preferred_label": "徒然",
      "descriptions": [
        {
          "source": "acai",
          "description": "毫无用处或意义；做某事没有任何结果或目的。"
        }
      ]
    },
    "zht": {
      "preferred_label": "徒然",
      "descriptions": [
        {
          "source": "acai",
          "description": "毫無用處或意義；做事沒有任何結果或目的。"
        }
      ]
    }
  },
