{
  "id": "keyterm:BegForMercy",
  "primary_id": "keyterm:BegForMercy",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "002398001002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "To Beg for Mercy",
      "descriptions": [
        {
          "source": "acai",
          "description": "To ask someone for kindness or help in a very humble and serious way."
        }
      ]
    },
    "spa": {
      "preferred_label": "suplicar misericordia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pedir a alguien bondad o ayuda de una manera muy humilde y solemne."
        }
      ]
    },
    "fra": {
      "preferred_label": "implorer miséricorde",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demander à quelqu'un de la bienveillance ou de l'aide d'une manière très humble et solennelle."
        }
      ]
    },
    "ind": {
      "preferred_label": "memohon belas kasihan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Meminta kebaikan atau pertolongan kepada seseorang dengan cara yang sangat rendah hati dan sungguh-sungguh."
        }
      ]
    },
    "por": {
      "preferred_label": "implorar por misericórdia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pedir bondade ou ajuda a alguém de maneira muito humilde e séria."
        }
      ]
    },
    "apd": {
      "preferred_label": "يترجى رحمة",
      "descriptions": [
        {
          "source": "acai",
          "description": "يطلب من زول إحسان ولا مساعدة بطريقة متواضعة وشديدة الجدية."
        }
      ]
    },
    "arb": {
      "preferred_label": "يتضرع",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يطلب شخص من آخر لطفًا أو عونًا بطريقة ملؤها التواضع والجدية."
        }
      ]
    },
    "bis": {
      "preferred_label": "prea strong blong kasem sore",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong askem kaen fasin o givhan long wan man wetem tingting we i daon mo i hevi tumas."
        }
      ]
    },
    "hau": {
      "preferred_label": "Roƙon jin ƙai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roƙon wani domin samun alheri ko taimako cikin tawali’u da gaske."
        }
      ]
    },
    "hin": {
      "preferred_label": "दया की भीख माँगना",
      "descriptions": [
        {
          "source": "acai",
          "description": "अत्यंत नम्र और गंभीर रीति से किसी से दया या सहायता की याचना करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịrịọ ebere",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịrịọ mmadụ ka o mee ebere ma ọ bụ nye aka nʼụzọ dị nnọọ umeala nʼobi ma sie ike."
        }
      ]
    },
    "nep": {
      "preferred_label": "दयाको निम्ति बिन्ती गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "अत्यन्तै नम्र र गम्भीर रूपमा कसैसँग दया वा सहायता माग्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Умолять о пощаде",
      "descriptions": [
        {
          "source": "acai",
          "description": "Очень смиренно и искренне просить кого-либо о милости или помощи."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusihi kwa Rehema",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumwomba mtu fadhili au msaada kwa njia ya unyenyekevu na ya dhati kabisa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Krai long kisim marimari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long askim wanpela man long marimari o helpim long pasin daun tru na strongpela tingting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cầu xin lòng thương xót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cầu xin ai đó lòng thương xót hoặc sự giúp đỡ một cách rất khiêm nhường và tha thiết."
        }
      ]
    },
    "zhs": {
      "preferred_label": "恳求怜悯",
      "descriptions": [
        {
          "source": "acai",
          "description": "以极其谦卑和认真的方式请求某人的仁慈或帮助。"
        }
      ]
    },
    "zht": {
      "preferred_label": "懇求憐憫",
      "descriptions": [
        {
          "source": "acai",
          "description": "以極其謙卑且懇切的方式向某人祈求恩慈或幫助。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
