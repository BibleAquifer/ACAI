  "localizations": {
    "eng": {
      "preferred_label": "Fear (Awe)",
      "alternate_labels": [
        "Awe"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A deep respect and wonder that makes someone feel small before God's greatness."
        }
      ]
    },
    "spa": {
      "preferred_label": "temor (reverencia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Profundo respeto y asombro que hace sentir a alguien pequeño ante la grandeza de Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "crainte (respect mêlé d'admiration)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un profond respect et émerveillement qui fait que l'on se sent tout petit devant la grandeur de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "takut (kekaguman)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rasa hormat dan takjub yang mendalam yang membuat seseorang merasa kecil di hadapan kebesaran Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "Temor (Reverência)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um profundo respeito e reverência que faz a pessoa se sentir pequena diante da grandeza de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "خوف (مهابة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "احترام عميق ودهشة بتخلي الزول يحس بإنو صغير قدام عظمة الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "مخافة (خشية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "احترام ومهابة عميقة تجعل المرء يشعر بضآلته أمام عظمة الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fraet (Bigfala respek)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bigfala respek mo sapraes we i mekem man i harem se hem i smol nomo long fes blong bigfala paoa blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tsoro (Banmamaki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gagarumar girmamawa da banmamaki da suke sa mutum ya ji ƙanƙantarsa a gaban girman Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "भय (विस्मय)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक गहरा आदर और विस्मय जो परमेश्वर की महानता के सामने किसी को अपनी तुच्छता का अहसास कराता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Egwu (Nsọpụrụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nkwanye ùgwù miri emi na oke ịsọpụrụ nke na-eme ka mmadụ chee na ya dị nta nʼihu ịdị ukwuu Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "भय (आदर)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको महानताका अगाडि कसैलाई आफू सानो भएको महसुस गराउने गहिरो आदर र आश्‍चर्य।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Страх (трепет)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Глубокое почтение и трепет, заставляющие человека осознавать свое ничтожество перед величием Бога."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hofu (Kicho)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Heshima kuu na kicho vinavyomfanya mtu ajione mdogo mbele ya ukuu wa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pret (Rispek)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bikpela pasin bilong rispek na kirap nogut em i save mekim man i pilim em i liklik samting tasol long ai bilong biknem bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kính sợ (Kính phục)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lòng tôn kính và kinh ngạc sâu xa khiến một người cảm thấy mình nhỏ bé trước sự vĩ đại của Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "敬畏 (畏惧)",
      "descriptions": [
        {
          "source": "acai",
          "description": "在上帝的伟大面前感到自己渺小的深深敬意与惊叹。"
        }
      ]
    },
    "zht": {
      "preferred_label": "敬畏（畏懼）",
      "descriptions": [
        {
          "source": "acai",
          "description": "深刻的敬重與驚嘆，使人在上帝的偉大面前感到自身的渺小。"
        }
      ]
    }
  },
