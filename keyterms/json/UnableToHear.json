{
  "id": "keyterm:UnableToHear",
  "primary_id": "keyterm:UnableToHear",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "localizations": {
    "eng": {
      "preferred_label": "Unable to Hear",
      "alternate_labels": [
        "Unwilling to Hear"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Not listening or not willing to listen, like having ears that do not hear well."
        }
      ]
    },
    "apd": {
      "preferred_label": "ما يقدر يسمع",
      "descriptions": [
        {
          "source": "acai",
          "description": "الزول الما بسمع أو الما داير يسمع، زي الزول العندو أضان وما بتسمع كويس."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَاجِزٌ عَنِ السَّمْعِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "عَدَمُ الِاسْتِمَاعِ أَوْ عَدَمُ الرَّغْبَةِ فِي الِاسْتِمَاعِ، كَمَنْ لَهُ آذَانٌ لَا تَسْمَعُ جَيِّدًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "No save harem samting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin we man i no stap lisin no i no wantem lisin, olsem sora blong hem i fas no i no harem samting gud."
        }
      ]
    },
    "fra": {
      "preferred_label": "incapable d'entendre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le fait de ne pas écouter ou de refuser d'écouter, comme avoir des oreilles qui n'entendent pas bien."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kasa Ji",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙin ji ko rashin son saurare, kamar mai kunnuwan da ba sa jin magana sosai."
        }
      ]
    },
    "hin": {
      "preferred_label": "सुनने में असमर्थ",
      "descriptions": [
        {
          "source": "acai",
          "description": "न सुनना या सुनने के लिए तैयार न होना, जैसे ऐसे कान होना जो ठीक से नहीं सुनते।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Enweghị ike ịnụ ihe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịghara ige ntị maọbụ enweghị mmasị ige ntị, dịka inwe ntị na-anaghị anụ ihe nke ọma."
        }
      ]
    },
    "ind": {
      "preferred_label": "tidak dapat mendengar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak mendengar atau tidak mau mendengarkan, seperti memiliki telinga yang tidak dapat mendengar dengan baik."
        }
      ]
    },
    "nep": {
      "preferred_label": "सुन्न नसक्ने",
      "descriptions": [
        {
          "source": "acai",
          "description": "सुन्‍न नसकिने कान भएझैँ, नसुन्‍ने वा सुन्‍न नचाहने अवस्था।"
        }
      ]
    },
    "por": {
      "preferred_label": "incapaz de ouvir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não ouvir ou não estar disposto a ouvir, como ter ouvidos que não ouvem bem."
        }
      ]
    },
    "rus": {
      "preferred_label": "Не слышащий",
      "descriptions": [
        {
          "source": "acai",
          "description": "Неспособность или нежелание слушать, подобно тому как имеют уши, которые плохо слышат."
        }
      ]
    },
    "spa": {
      "preferred_label": "incapaz de oír",
      "descriptions": [
        {
          "source": "acai",
          "description": "No escuchar o no estar dispuesto a escuchar, como tener oídos que no oyen bien."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutoweza Kusikia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutokusikiliza au kutokuwa tayari kusikiliza, kama kuwa na masikio yasiyosikia vizuri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Yau I Pas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong no harim tok o no laik harim tok, olsem yau i pas na i no save harim gut tok."
        }
      ]
    },
    "vie": {
      "preferred_label": "không thể nghe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không lắng nghe hoặc không sẵn lòng lắng nghe, giống như có tai mà không nghe rõ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "听不进去",
      "descriptions": [
        {
          "source": "acai",
          "description": "不听或不愿听，好比耳朵听不见一样。"
        }
      ]
    },
    "zht": {
      "preferred_label": "聽不見",
      "descriptions": [
        {
          "source": "acai",
          "description": "不聽或不願意聽，就像耳朵聽不清楚一樣。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
