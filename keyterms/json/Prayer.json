{
  "id": "keyterm:Prayer",
  "primary_id": "keyterm:Pray",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "33.171"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Prayer",
      "alternate_labels": [
        "Supplication",
        "Petition"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Asking God earnestly for help or needs because you trust He can provide."
        }
      ]
    },
    "spa": {
      "preferred_label": "oración",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pedir fervientemente a Dios ayuda o provisiones porque se confía en que Él puede proveer."
        }
      ]
    },
    "fra": {
      "preferred_label": "prière",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demander instamment à Dieu son aide ou pour ses besoins, par confiance qu'il peut y pourvoir."
        }
      ]
    },
    "ind": {
      "preferred_label": "doa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memohon pertolongan atau kebutuhan kepada Allah dengan sungguh-sungguh karena percaya bahwa Dia dapat mencukupinya."
        }
      ]
    },
    "por": {
      "preferred_label": "súplica",
      "alternate_labels": [
        "oração"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Pedir a Deus fervorosamente por ajuda ou necessidades por confiar que Ele pode prover."
        }
      ]
    },
    "apd": {
      "preferred_label": "دعاء",
      "descriptions": [
        {
          "source": "acai",
          "description": "طلب المساعدة أو الاحتياجات من الله بإلحاح ومن كل القلب لأنك واثق إنه بيقدر يقدّمها."
        }
      ]
    },
    "arb": {
      "preferred_label": "طلبة",
      "descriptions": [
        {
          "source": "acai",
          "description": "التضرع إلى الله بحرارة لطلب المعونة أو الاحتياجات ثقةً بأنه قادر أن يسدها."
        }
      ]
    },
    "bis": {
      "preferred_label": "Prea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Askem God wetem strong tingting blong i givhan o givim samting we man i nidim from we man i trastem se hem i save givim."
        }
      ]
    },
    "hau": {
      "preferred_label": "Addu’a",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roƙon Allah da dukan zuciya don neman taimako ko buƙatu domin ka amince zai iya azurtawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "विनती",
      "descriptions": [
        {
          "source": "acai",
          "description": "सहायता या आवश्यकताओं के लिए परमेश्वर से दृढ़तापूर्वक याचना करना क्योंकि आपको विश्वास है कि वह प्रदान कर सकते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ekpere",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịrịọ Chineke maka enyemaka ma ọ bụ mkpa site nʼobi nʼihi na i kwere na ọ pụrụ inye ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "बिन्ती",
      "descriptions": [
        {
          "source": "acai",
          "description": "उहाँले प्रबन्ध गर्न सक्नुहुन्छ भन्‍ने विश्‍वास गरी सहायता वा खाँचोका निम्ति परमेश्‍वरसँग उत्कट रूपमा माग्नु वा बिन्ती गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "молитва",
      "descriptions": [
        {
          "source": "acai",
          "description": "Усердная просьба к Богу о помощи или нуждах с упованием на то, что Он может помочь."
        }
      ]
    },
    "swh": {
      "preferred_label": "Dua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumwomba Mungu kwa bidii msaada au mahitaji kwa sababu unaamini kwamba anaweza kutoa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Beten bilong krai long helpim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong strong long askim God long helpim o long ol samting yu nidim, bikos yu bilip tru olsem em inap givim long yu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự cầu xin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tha thiết cầu xin Đức Chúa Trời giúp đỡ hoặc ban cho những nhu cần vì tin cậy rằng Ngài có thể chu cấp."
        }
      ]
    },
    "zhs": {
      "preferred_label": "祈求",
      "descriptions": [
        {
          "source": "acai",
          "description": "因信赖上帝能够供应，而切切地向祂寻求帮助或所需。"
        }
      ]
    },
    "zht": {
      "preferred_label": "祈求",
      "descriptions": [
        {
          "source": "acai",
          "description": "因信賴上帝能夠供應，而切切向祂求助或求取所需。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Pray"
  ],
