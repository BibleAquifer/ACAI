{
  "id": "keyterm:Worship",
  "primary_id": "keyterm:Worship",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "53.53"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Worship (Act)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Acting in a way that shows love, respect, and honor to God through prayers, songs, and rituals."
        }
      ]
    },
    "spa": {
      "preferred_label": "adorar (acto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Actuar de una manera que muestre amor, respeto y honra a Dios mediante oraciones, cantos y rituales."
        }
      ]
    },
    "fra": {
      "preferred_label": "adoration (acte)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Agir d'une manière qui manifeste de l'amour, du respect et de l'honneur envers Dieu par des prières, des chants et des rituels."
        }
      ]
    },
    "ind": {
      "preferred_label": "sembah (tindakan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bertindak dengan cara yang menunjukkan kasih, hormat, dan penghormatan kepada Allah melalui doa, nyanyian, dan ritual."
        }
      ]
    },
    "por": {
      "preferred_label": "adorar (ato)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Agir de modo a demonstrar amor, respeito e honra a Deus por meio de orações, cânticos e rituais."
        }
      ]
    },
    "apd": {
      "preferred_label": "عبادة (فعل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "التصرف بطريقة تظهر المحبة والاحترام والإكرام لله من خلال الصلوات والترانيم والشعائر."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِبَادَة (فعل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "التصرف بطريقة تُظهر المحبة والاحترام والإكرام لله من خلال الصلوات والترانيم والطقوس."
        }
      ]
    },
    "bis": {
      "preferred_label": "mekem wosip (aksen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aksen we i soemaot lav, respek, mo ona long God tru long ol prea, singsing, mo kastom fasin blong wosip."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bauta (Aiki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aiki a hanyar da ke nuna ƙauna, ban girma, da daraja ga Allah ta wurin addu’o’i, waƙoƙi, da ayyukan ibada."
        }
      ]
    },
    "hin": {
      "preferred_label": "आराधना (कार्य)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रार्थनाओं, गीतों और विधियों के माध्यम से परमेश्वर के प्रति प्रेम, आदर और सम्मान प्रकट करने वाला कार्य करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ifè ofufe (Ime ihe)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Omume nke na-egosi ịhụnanya, nkwanye ùgwù, na nsọpụrụ nye Chineke site nʼekpere, abụ, na emume dị iche iche."
        }
      ]
    },
    "nep": {
      "preferred_label": "आराधना (काम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रार्थना, भजन र विधिहरूद्वारा परमेश्‍वरप्रति प्रेम, आदर र सम्मान देखाउने काम गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Поклонение (действие)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Действия, выражающие любовь, уважение и почтение к Богу через молитвы, песнопения и обряды."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuabudu (Kitendo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutenda kwa njia inayoonyesha upendo, heshima, na utukufu kwa Mungu kupitia maombi, nyimbo, na ibada."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lotu (Pasin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong mekim samting bilong soim lav, rispek na biknem long God long rot bilong ol prea, ol singsing na ol pasin bilong lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "thờ phượng (hành động)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành động bày tỏ tình yêu thương, sự tôn kính và danh dự đối với Đức Chúa Trời qua những lời cầu nguyện, bài ca và các nghi thức."
        }
      ]
    },
    "zhs": {
      "preferred_label": "敬拜 (行动)",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由祷告、诗歌和仪式向上帝表达爱、敬意和尊荣的行为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "敬拜（行動）",
      "descriptions": [
        {
          "source": "acai",
          "description": "透過禱告、詩歌和儀式，以顯明對上帝之愛、敬重與尊崇的方式行事。"
        }
      ]
    }
  },
  "referred_to_as": [
