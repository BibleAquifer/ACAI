{
  "id": "keyterm:Guiltiness",
  "primary_id": "keyterm:Sin",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "000755001001000",
    "000755001002000",
    "000755002001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Guiltiness",
      "alternate_labels": [
        "Guilt",
        "Guilt-Offering",
        "Gift of Restitution",
        "Gift of Atonement"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Being responsible for doing something wrong or a special offering given to make up for that wrong."
        }
      ]
    },
    "spa": {
      "preferred_label": "culpabilidad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser responsable de hacer algo malo o una ofrenda especial entregada para compensar ese mal."
        }
      ]
    },
    "fra": {
      "preferred_label": "culpabilité (sacrifice de culpabilité)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le fait d'être responsable d'avoir commis une faute, ou offrande particulière apportée pour expier cette faute."
        }
      ]
    },
    "ind": {
      "preferred_label": "kesalahan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bertanggung jawab karena melakukan kesalahan atau persembahan khusus yang diberikan untuk menebus kesalahan tersebut."
        }
      ]
    },
    "por": {
      "preferred_label": "culpabilidade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Estar responsável por fazer algo errado ou uma oferta especial apresentada para reparar esse erro."
        }
      ]
    },
    "apd": {
      "preferred_label": "إثم",
      "descriptions": [
        {
          "source": "acai",
          "description": "كون الزول مسؤول عن عمل غلط، أو تقديم ذبيحة خاصة للتكفير عن الغلط دا."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِثْم",
      "descriptions": [
        {
          "source": "acai",
          "description": "تَحَمُّلُ مَسْؤُولِيَّةِ ٱرْتِكَابِ خَطَأٍ، أَوْ ذَبِيحَةٌ خَاصَّةٌ تُقَدَّمُ كَفَّارَةً عَنْ ذَلِكَ ٱلْخَطَإِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong karem fol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong karem fol from we yu mekem wan samting i rong, no wan spesel sakrefaes we oli givim blong kavremap rong ya."
        }
      ]
    },
    "hau": {
      "preferred_label": "Alhakin laifi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa da alhakin yin wani abu da ba daidai ba ko kuma wata hadaya ta musamman da ake bayarwa don gyara wannan kuskure."
        }
      ]
    },
    "hin": {
      "preferred_label": "दोषिता",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुछ गलत करने के लिए उत्तरदायी होना या उस गलत काम की भरपाई के लिए चढ़ाया जाने वाला एक विशेष चढ़ावा।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikpe ọmụma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye na-aza ajụjụ maka ime ihe na-ezighị ezi maọbụ onyinye pụrụ iche a na-enye iji kwụọ ụgwọ maka ihe ọjọọ ahụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "दोषीपन",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै गलत काम गरेकोमा जिम्मेवार हुनु वा त्यस गलत कामको क्षतिपूर्तिको रूपमा दिइने विशेष भेटी।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Виновность",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ответственность за совершение проступка или особое приношение, совершаемое для искупления этого зла."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuwa na hatia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwajibika kwa kutenda kosa au sadaka maalumu inayotolewa ili kufidia kosa hilo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gat asua",
      "descriptions": [
        {
          "source": "acai",
          "description": "I stap olsem man i gat asua long rong em i mekim o wanpela espesel ofa bilong bekim dispela rong."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự mắc tội",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tình trạng chịu trách nhiệm vì đã làm điều sai trái, hoặc một của lễ đặc biệt dâng lên để đền bù cho điều sai trái đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "罪过",
      "descriptions": [
        {
          "source": "acai",
          "description": "对所犯错事负有罪责，或指为弥补该过错而献上的特殊祭物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "有罪",
      "descriptions": [
        {
          "source": "acai",
          "description": "對所犯之錯負有責任，或為彌補該過錯所獻的特別祭物。"
        }
      ]
    }
  },
  "referred_to_as": [
