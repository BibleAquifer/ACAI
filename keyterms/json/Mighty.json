  "localizations": {
    "eng": {
      "preferred_label": "Mighty (Majestic)",
      "alternate_labels": [
        "Majestic",
        "Noble"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Having great strength or power that makes others feel respect and wonder."
        }
      ]
    },
    "spa": {
      "preferred_label": "poderoso (majestuoso)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que tiene gran fuerza o poder que infunde en otros respeto y asombro."
        }
      ]
    },
    "fra": {
      "preferred_label": "puissant (majestueux)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Qui possède une grande force ou puissance suscitant le respect et l’admiration."
        }
      ]
    },
    "ind": {
      "preferred_label": "perkasa (mulia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memiliki kekuatan atau kekuasaan besar yang membuat orang lain merasa hormat dan kagum."
        }
      ]
    },
    "apd": {
      "preferred_label": "قدير (جليل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عنده قوة أو قدرة عظيمة بتخلي الآخرين يحسوا بالهيبة والإعجاب."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَدِير (جَلِيل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱمْتِلَاكُ قُوَّةٍ أَوْ بَأْسٍ عَظِيمٍ يَبْعَثُ فِي ٱلْآخَرِينَ ٱلِاحْتِرَامَ وَٱلتَّعَجُّبَ."
        }
      ]
    },
    "bis": {
      "preferred_label": "strong (hae)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gat bigfala paoa no paoa we i mekem ol narafala oli gat respek mo oli sapraes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai girma (Mai ɗaukaka)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa da babban ƙarfi ko iko da ke sa wasu su ji girmamawa da banmamaki."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रतापी (महिमामय)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अत्यधिक शक्ति या सामर्थ्य होना जो दूसरों में आदर और विस्मय की भावना जगाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Dị ike (Dị ebube)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe ike ma ọ bụ ike dị ukwuu nke na-eme ka ndị ọzọ nwee nkwanye ùgwù na ịtụnanya."
        }
      ]
    },
    "nep": {
      "preferred_label": "शक्तिशाली (महिमित)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरूलाई आदर र विस्मय महसुस गराउने ठूलो सामर्थ्य वा शक्ति हुनु।"
        }
      ]
    },
    "por": {
      "preferred_label": "majestoso (poderoso)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ter grande força ou poder que faz com que os outros sintam respeito e admiração."
        }
      ]
    },
    "rus": {
      "preferred_label": "Могущественный (величественный)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Обладающий великой силой или властью, внушающей уважение и благоговение."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwenye nguvu (Mwenye enzi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa na nguvu au uwezo mkuu unaowafanya wengine wajisikie heshima na kustaajabu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gat bikpela strong (Biknem)",
      "descriptions": [
        {
          "source": "acai",
          "description": "I gat traipela strong o pawa we i mekim ol arapela i aninit na kirap nogut long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "oai nghi (hùng vĩ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Có sức mạnh hoặc quyền năng lớn lao khiến người khác cảm thấy kính trọng và kinh ngạc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "威严 (尊荣)",
      "descriptions": [
        {
          "source": "acai",
          "description": "拥有巨大的力量或能力，令人感到敬畏和惊叹。"
        }
      ]
    },
    "zht": {
      "preferred_label": "威嚴（偉大）",
      "descriptions": [
        {
          "source": "acai",
          "description": "擁有令人心生敬佩與驚嘆的巨大力量或權能。"
        }
      ]
    }
  },
