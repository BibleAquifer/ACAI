{
  "id": "keyterm:PutRightWith",
  "primary_id": "keyterm:Just",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "88.16",
    "34.46",
    "56.34"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Put Right With",
      "descriptions": [
        {
          "source": "acai",
          "description": "To make someone have a good and correct relationship with another person, often with God."
        }
      ]
    },
    "fra": {
      "preferred_label": "justifier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rétablir une relation bonne et juste entre quelqu'un et une autre personne, en particulier avec Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "membenarkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menjadikan seseorang memiliki hubungan yang baik dan benar dengan orang lain, sering kali dengan Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "justificar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fazer com que alguém tenha um relacionamento bom e correto com outra pessoa, frequentemente com Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "يتبرر مع",
      "descriptions": [
        {
          "source": "acai",
          "description": "يخلّي الزول عنده علاقة كويسة وصحيحة مع زول تاني، وغالباً مع الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُبَرَّر مَعَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَنْ يَجْعَلَ المَرْءَ فِي عَلَاقَةٍ صَالِحَةٍ وَصَحِيحَةٍ مَعَ شَخْصٍ آخَرَ، غَالِبًا مَعَ اللهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "mekem i kam stret man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekem wan man i kam gat wan gudfala mo stret rilesensip wetem narafala man, mo plante taem wetem God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sulhanta da",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sa mutum ya kasance da kyakkyawar dangantaka da kuma madaidaiciya da wani, musamman da Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "धर्मी ठहराना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी का दूसरे व्यक्ति के साथ, विशेषकर परमेश्वर के साथ, अच्छा और सही संबंध स्थापित करना (धर्मी ठहराना)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgụ nʼonye ezi omume nʼihu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka mmadụ na onye ọzọ nwee ezi mmekọrịta ziri ezi, ọkachasị nʼetiti ya na Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "धर्मी ठहराउनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरू व्यक्तिसँग, प्रायः परमेश्‍वरसँग असल र सही सम्बन्धमा ल्याउनु वा धर्मी ठहराउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Оправдать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Приводить человека к правильным и должным отношениям с кем-либо, прежде всего с Богом."
        }
      ]
    },
    "spa": {
      "preferred_label": "justificar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer que alguien tenga una relación buena y correcta con otra persona, a menudo con Dios."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuhesabiwa Haki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumfanya mtu awe na uhusiano mzuri na unaofaa pamoja na mtu mwingine, mara nyingi pamoja na Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kamap wanbel wantaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim wanpela man i gat gutpela na stretpela pasin wantaim narapela man, planti taim wantaim God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Được xưng công chính",
      "descriptions": [
        {
          "source": "acai",
          "description": "Khiến một người có mối quan hệ tốt đẹp và đúng đắn với người khác, thường là với Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "称义",
      "descriptions": [
        {
          "source": "acai",
          "description": "使人与另一人（常指与上帝）恢复良好而正确的关系。"
        }
      ]
    },
    "zht": {
      "preferred_label": "使……稱義",
      "descriptions": [
        {
          "source": "acai",
          "description": "使人與另一人（常指與上帝）建立良好且正確的關係。"
        }
      ]
    }
  },
  "referred_to_as": [
