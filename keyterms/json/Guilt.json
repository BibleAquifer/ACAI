{
  "id": "keyterm:Guilt",
  "primary_id": "keyterm:Sin",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "002213001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Guilt (Consequence)",
      "descriptions": [
        {
          "source": "acai",
          "description": "The result of being responsible for a wrong action against God or others, which may require making amends."
        }
      ]
    },
    "spa": {
      "preferred_label": "culpa (consecuencia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "El resultado de ser responsable de una mala acción contra Dios o contra otros, lo cual puede requerir hacer enmiendas."
        }
      ]
    },
    "fra": {
      "preferred_label": "culpabilité (conséquence)",
      "descriptions": [
        {
          "source": "acai",
          "description": "La conséquence d'être responsable d'une mauvaise action envers Dieu ou son prochain, pouvant exiger réparation."
        }
      ]
    },
    "ind": {
      "preferred_label": "kesalahan (akibat)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Akibat dari bertanggung jawab atas perbuatan salah terhadap Allah atau sesama, yang mungkin menuntut pemulihan atau penggantian rugi."
        }
      ]
    },
    "apd": {
      "preferred_label": "ذنب (عاقبة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "النتيجة المترتبة على المسؤولية عن عمل غلط ضد الله أو الناس، والشي دا ممكن يتطلب تعويض أو كفارة."
        }
      ]
    },
    "arb": {
      "preferred_label": "ذَنْب (عَاقِبَة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "نَتِيجَةُ تَحَمُّلِ مَسْؤُولِيَّةِ فِعْلٍ خَاطِئٍ ضِدَّ ٱللهِ أَوْ ضِدَّ ٱلْآخَرِينَ، مِمَّا قَدْ يَسْتَلْزِمُ ٱلتَّعْوِيضَ أَوْ إِصْلَاحَ ٱلْأَمْرِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fol (Samting we i kamaot)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting we i kamaot from fasin blong karem fol blong wan rong aksen agens long God no ol narafala man, we maet i nidim blong pem no stret bakegen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Laifi (Sakamako)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sakamakon ɗaukar alhakin wani aikin da ba daidai ba ga Allah ko ga wasu, wanda yana iya buƙatar yin gyara."
        }
      ]
    },
    "hin": {
      "preferred_label": "दोष (परिणाम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर या दूसरों के विरुद्ध किसी गलत कार्य के लिए उत्तरदायी होने का परिणाम, जिसके लिए भरपाई करने की आवश्यकता हो सकती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikpe ọmụma (Ihe si na ya pụta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe na-apụta site nʼịbụ onye na-aza ajụjụ maka omume na-ezighị ezi megide Chineke maọbụ ndị ọzọ, nke nwere ike ịchọ idozi ihe."
        }
      ]
    },
    "nep": {
      "preferred_label": "दोष (परिणाम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर वा अरू मानिसहरूको विरुद्धमा गरिएको गलत कामको जिम्मेवारीको परिणाम, जसको निम्ति क्षतिपूर्ति आवश्यक हुन सक्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "culpa (consequência)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O resultado de ser responsável por uma ação errada contra Deus ou contra o próximo, o que pode exigir reparação."
        }
      ]
    },
    "rus": {
      "preferred_label": "Вина (последствие)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Последствие ответственности за неправедный поступок против Бога или ближних, которое может требовать возмещения ущерба."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hatia (Matokeo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Matokeo ya kuwajibika kwa tendo baya dhidi ya Mungu au wengine, ambayo yanaweza kuhitaji kufanya fidia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Asua (Kain hevi i kamap)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting i kamap bihain long man i bin mekim rong long ai bilong God o long ol narapela manmeri, na ating i mas stretim dispela rong."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tội trạng (hậu quả)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hậu quả của việc chịu trách nhiệm về một hành vi sai trái đối với Đức Chúa Trời hoặc người khác, có thể đòi hỏi sự đền bù."
        }
      ]
    },
    "zhs": {
      "preferred_label": "罪责 (后果)",
      "descriptions": [
        {
          "source": "acai",
          "description": "因对上帝或他人做出错误行为而承担责任所带来的后果，可能需要作出赔偿或弥补。"
        }
      ]
    },
    "zht": {
      "preferred_label": "罪責 (後果)",
      "descriptions": [
        {
          "source": "acai",
          "description": "得罪上帝或他人之過錯所導致的結果，可能需要進行賠償或贖罪。"
        }
      ]
    }
  },
  "referred_to_as": [
