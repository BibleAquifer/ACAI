  "localizations": {
    "eng": {
      "preferred_label": "Curse (Pronouncement Against)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A spoken statement asking for harm, damage, or destruction to come to someone or something."
        }
      ]
    },
    "spa": {
      "preferred_label": "maldición (pronunciamiento en contra)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Declaración hablada en la que se pide que sobrevenga daño, perjuicio o destrucción sobre alguien o algo."
        }
      ]
    },
    "fra": {
      "preferred_label": "malédiction (imprécation)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Déclaration orale réclamant que le malheur, le dommage ou la destruction frappe quelqu’un ou quelque chose."
        }
      ]
    },
    "ind": {
      "preferred_label": "kutuk (pernyataan hukuman)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pernyataan lisan yang meminta agar celaka, kerusakan, atau kebinasaan menimpa seseorang atau sesuatu."
        }
      ]
    },
    "apd": {
      "preferred_label": "لعنة (إعلان ضد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كلام منطوق بيطلب نزول الأذى أو الضرر أو الهلاك على زول أو حاجة."
        }
      ]
    },
    "arb": {
      "preferred_label": "لَعنة (إعلان ضد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تصريح أو قول منطوق يطلب حلول الأذى أو الضرر أو الهلاك بشخص أو شيء ما."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tok blong trabol (Tok Agens)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tok we man i talemaot blong askem se trabol, spael, no samting we i save brokdaon i mas kam long wan man no samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "La'ana (Furtar da Cutarwa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Furtacciyar magana da ake roƙon cutarwa, ɓarna, ko hallaka ta auku ga wani ko wani abu."
        }
      ]
    },
    "hin": {
      "preferred_label": "श्राप (विरुद्ध घोषणा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या वस्तु को हानि, क्षति या विनाश पहुँचने की घोषणा करने वाला कथन।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọbụbụ ọnụ (Nkwupụta Megide)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Okwu a na-ekwu nʼọnụ na-arịọ ka mmerụ ahụ, mmebi, ma ọ bụ mbibi dakwasị mmadụ ma ọ bụ ihe."
        }
      ]
    },
    "nep": {
      "preferred_label": "श्राप (विरुद्धको घोषणा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई वा कुनै थोकलाई हानि, नोक्सानी वा विनाश आइपरोस् भनी बोलिएको वचन वा घोषणा।"
        }
      ]
    },
    "por": {
      "preferred_label": "maldição (pronunciamento contra)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma declaração verbal pedindo que danos, destruição ou desgraça venham sobre alguém ou algo."
        }
      ]
    },
    "rus": {
      "preferred_label": "проклятие (произнесение приговора)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Произнесенное вслух высказывание с призыванием зла, вреда или уничтожения на кого-либо или что-либо."
        }
      ]
    },
    "swh": {
      "preferred_label": "Laana (Tamko Dhidi ya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kauli inayotamkwa ya kuomba madhara, uharibifu, au maangamizi yampate mtu au kitu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tok Bilong Bagarap (Tok Bilong Sakim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela tok aut bilong singautim bagarap o samting nogut i mas kamap long wanpela man o samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời nguyền rủa (Tuyên bố trừng phạt)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lời tuyên bố thốt ra nhằm khiến tai hại, sự hủy diệt hoặc tàn phá giáng xuống ai đó hoặc điều gì đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "咒诅 (谴责宣告)",
      "descriptions": [
        {
          "source": "acai",
          "description": "求灾害、伤害或毁灭临到某人或某物的口头宣告。"
        }
      ]
    },
    "zht": {
      "preferred_label": "咒詛 (宣告降禍)",
      "descriptions": [
        {
          "source": "acai",
          "description": "口頭宣告降禍、毀損或滅亡臨到某人或某物。"
        }
      ]
    }
  },
