        "Without Defect"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Having no moral faults or flaws, and being completely good and clean."
        }
      ]
    },
    "spa": {
      "preferred_label": "puro (sin defecto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "No tener faltas ni defectos morales, y ser completamente bueno y limpio."
        }
      ]
    },
    "fra": {
      "preferred_label": "pur (sans défaut)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sans faute ni défaut moral, totalement bon et net."
        }
      ]
    },
    "ind": {
      "preferred_label": "murni (tanpa cacat)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak memiliki cela atau cacat moral, dan sepenuhnya baik serta bersih."
        }
      ]
    },
    "por": {
      "preferred_label": "puro (sem defeito)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não ter falhas ou defeitos morais, e ser completamente bom e limpo."
        }
      ]
    },
    "apd": {
      "preferred_label": "طاهر (بلا عيب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ما فيهو أي عيوب أو أخطاء أخلاقية، وكونو صالح ونضيف بالكامل."
        }
      ]
    },
    "arb": {
      "preferred_label": "طَاهِر (بلا عيب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "خالٍ من العيوب أو النقائص الأخلاقية، وصالح ونقي بالكامل."
        }
      ]
    },
    "bis": {
      "preferred_label": "klin (no gat fol)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong no gat rong no fol long saed blong laef, mo we i gud olgeta mo klin evriwan."
        }
      ]
    },
    "hau": {
      "preferred_label": "Marar Aibi (Marar Lahani)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin kowace irin aibi ko nakasa ta ɗabi'a, da kasancewa mai kyau da tsabta sarai."
        }
      ]
    },
    "hin": {
      "preferred_label": "पवित्र (निर्दोष)",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिना किसी नैतिक दोष या खोट के होना, और पूरी तरह से भला व स्वच्छ होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Dị ọcha (Enweghị ntụpọ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Enweghị mmejọ ma ọ bụ ntụpọ omume, na ịbụ ihe zuru oke nʼịdị mma na ịdị ọcha."
        }
      ]
    },
    "nep": {
      "preferred_label": "शुद्ध (खोटरहित)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै पनि नैतिक खोट वा त्रुटि नभएको, र पूर्ण रूपमा असल तथा सफा हुनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "чистый (непорочный)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Не имеющий нравственных пороков или недостатков, совершенно благой и чистый."
        }
      ]
    },
    "swh": {
      "preferred_label": "-safi (Bila Dosari)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutokuwa na makosa au dosari za kimaadili, na kuwa mwema na safi kabisa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Klin (No gat asua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong i no gat rong o asua, na i stap gutpela olgeta na klin."
        }
      ]
    },
    "vie": {
      "preferred_label": "Trong sạch (Không tì vết)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không có lỗi lầm hay tì vết đạo đức nào, hoàn toàn tốt lành và trong sạch."
        }
      ]
    },
    "zhs": {
      "preferred_label": "纯洁（无瑕疵）",
      "descriptions": [
        {
          "source": "acai",
          "description": "毫无道德过失或瑕疵，并且完全良善与纯洁。"
        }
      ]
    },
    "zht": {
      "preferred_label": "潔淨 (無瑕疵)",
      "descriptions": [
        {
          "source": "acai",
          "description": "沒有道德瑕疵或缺陷，完全良善且潔淨。"
        }
      ]
    }
  },
