  "localizations": {
    "eng": {
      "preferred_label": "Oath (NT)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A promise that calls on God to punish someone if what they say is not true."
        }
      ]
    },
    "spa": {
      "preferred_label": "juramento (NT)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Promesa que invoca a Dios para que castigue a alguien si lo que dice no es verdad."
        }
      ]
    },
    "fra": {
      "preferred_label": "serment (NT)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une promesse qui prend Dieu à témoin pour punir quelqu'un si ce qu'il dit n'est pas vrai."
        }
      ]
    },
    "ind": {
      "preferred_label": "sumpah (PB)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Janji yang menyerukan Allah untuk menghukum seseorang jika apa yang dikatakannya tidak benar."
        }
      ]
    },
    "por": {
      "preferred_label": "juramento (NT)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma promessa que invoca a Deus para punir alguém caso o que essa pessoa diz não seja verdade."
        }
      ]
    },
    "apd": {
      "preferred_label": "قسم (العهد الجديد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "وعد بيطلب من الله يعاقب الزول لو كلامو طلع ما حقيقة."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَسَم (الْعَهْد الْجَدِيد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَعْدٌ يَسْتَدْعِي اللهَ لِيُعَاقِبَ الشَّخْصَ إِنْ كَانَ مَا يَقُولُهُ غَيْرَ صَحِيحٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Strong tok (Niu Testeman)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan promes we i singaot God blong panisim wan man sipos samting we hem i talem i no tru."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rantsuwa (TS)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani alƙawari da yake kira ga Allah ya hukunta mutum idan abin da ya faɗa ba gaskiya ba ne."
        }
      ]
    },
    "hin": {
      "preferred_label": "शपथ (नया नियम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक प्रतिज्ञा जो परमेश्वर का आह्वान करती है कि यदि कही गई बात सच न हो तो वह व्यक्ति को दंड दे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Iyi (Ọgbụgba Ndụ Ọhụrụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nkwa nke na-akpọku Chineke ka ọ taa mmadụ ahụhụ ma ọ bụrụ na ihe ha na-ekwu abụghị eziokwu."
        }
      ]
    },
    "nep": {
      "preferred_label": "शपथ (नयाँ नियम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफूले भनेको कुरा सत्य नभएमा परमेश्वरले दण्ड दिनुहोस् भनी आह्वान गरिने एक प्रतिज्ञा।"
        }
      ]
    },
    "rus": {
      "preferred_label": "клятва (НЗ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Обещание, призывающее Бога покарать человека, если сказанное им неправда."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kiapo (Agano Jipya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ahadi inayomwita Mungu amwadhibu mtu fulani ikiwa kile anachosema si kweli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "tok tru antap (Nupela Testamen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela promis we i singautim God long givim strafe long man sapos samting em i tok i no tru."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời thề (Tân Ước)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một lời cam kết kêu cầu Đức Chúa Trời trừng phạt một người nếu điều họ nói không phải là sự thật."
        }
      ]
    },
    "zhs": {
      "preferred_label": "誓言 (新约)",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种求告上帝在自己所言不实时降罚的承诺。"
        }
      ]
    },
    "zht": {
      "preferred_label": "誓言 (新約)",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種若自己所說不實便祈求上帝降罰的誓言。"
        }
      ]
    }
  },
