{
  "id": "keyterm:Word",
  "primary_id": "keyterm:Word",
  "type": "keyterm",
  "keyterm_type": "miscellaneous",
  "ubsdgnt": [
    "33.98",
    "33.9",
    "13.115"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Word",
      "alternate_labels": [
        "Saying",
        "Message",
        "Statement"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A single unit of speech or writing that carries meaning, usually what someone says or writes to share a message."
        }
      ]
    },
    "spa": {
      "preferred_label": "palabra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Unidad individual del habla o de la escritura con significado, generalmente lo que alguien dice o escribe para comunicar un mensaje."
        }
      ]
    },
    "fra": {
      "preferred_label": "parole",
      "descriptions": [
        {
          "source": "acai",
          "description": "Élément individuel du discours ou de l'écrit porteur de sens, généralement ce qu'une personne dit ou écrit pour transmettre un message."
        }
      ]
    },
    "ind": {
      "preferred_label": "perkataan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Satu satuan ujaran atau tulisan yang membawa makna, biasanya apa yang dikatakan atau ditulis seseorang untuk menyampaikan pesan."
        }
      ]
    },
    "por": {
      "preferred_label": "palavra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma única unidade de fala ou escrita que possui significado, geralmente o que alguém diz ou escreve para transmitir uma mensagem."
        }
      ]
    },
    "apd": {
      "preferred_label": "كلمة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة واحدة من الكلام أو الكتابة عندها معنى، وفي العادة بتكون الشي القالو زول أو كتبو عشان يوصّل رسالة."
        }
      ]
    },
    "arb": {
      "preferred_label": "كَلِمَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَحْدَةٌ وَاحِدَةٌ مِنَ ٱلْكَلَامِ أَوِ ٱلْكِتَابَةِ تَحْمِلُ مَعْنًى، وَعَادَةً مَا تَكُونُ مَا يَقُولُهُ شَخْصٌ أَوْ يَكْتُبُهُ لِمُشَارَكَةِ رِسَالَةٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pis tok no toktok we i gat mining blong hem, we klosap oltaem i samting we wan man i talem no i raetem blong givim wan mesej."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kalma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Guntun sashi na magana ko rubutu mai ɗauke da ma'ana, yawanci abin da mutum ya faɗa ko ya rubuta don isar da saƙo."
        }
      ]
    },
    "hin": {
      "preferred_label": "वचन",
      "descriptions": [
        {
          "source": "acai",
          "description": "बोलने या लिखने की एक ऐसी इकाई जिसका कोई अर्थ होता है, जो प्रायः किसी संदेश को साझा करने के लिए कहा या लिखा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Okwu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nkeji okwu ma ọ bụ ederede nwere nghọta, ọ na-abụkarị ihe mmadụ kwuru ma ọ bụ dee iji kesaa ozi."
        }
      ]
    },
    "nep": {
      "preferred_label": "वचन",
      "descriptions": [
        {
          "source": "acai",
          "description": "अर्थ बोक्ने बोली वा लेखाइको एक एकाइ, प्रायः कुनै सन्देश बाँड्न कसैले बोल्ने वा लेख्ने कुरा।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Слово",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отдельная единица речи или письма, несущая смысл; обычно то, что кто-то говорит или пишет для передачи вести."
        }
      ]
    },
    "swh": {
      "preferred_label": "Neno",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kipashio kimoja cha usemi au maandishi chenye maana, kwa kawaida kile mtu anachosema au kuandika ili kuwasilisha ujumbe."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela tok ol i mekim o raitim i gat mining bilong en, em tok wanpela man i mekim o raitim bilong salim wanpela tok i go."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một đơn vị ngôn ngữ nói hoặc viết mang ý nghĩa, thường là điều ai đó nói hoặc viết ra để truyền tải một thông điệp."
        }
      ]
    },
    "zhs": {
      "preferred_label": "话语",
      "descriptions": [
        {
          "source": "acai",
          "description": "承载意义的语言或文字的单一单位，通常是人说话或书写以传达信息的内容。"
        }
      ]
    },
    "zht": {
      "preferred_label": "話語",
      "descriptions": [
        {
          "source": "acai",
          "description": "具有意義的單一言語或文字單位，通常是某人為傳達信息而說出或寫下的內容。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
