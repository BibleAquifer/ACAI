      "descriptions": [
        {
          "source": "acai",
          "description": "Choosing someone or something special from several options because they are preferred."
        }
      ]
    },
    "spa": {
      "preferred_label": "elección",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elegir a alguien o algo especial de entre varias opciones por ser el preferido."
        }
      ]
    },
    "fra": {
      "preferred_label": "élection",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le fait de choisir quelqu'un ou quelque chose de particulier parmi plusieurs options parce qu'on le préfère."
        }
      ]
    },
    "ind": {
      "preferred_label": "pemilihan",
      "descriptions": [
        {
