        }
      ]
    },
    "por": {
      "preferred_label": "eleição",
      "alternate_labels": [
        "eleição"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Ato de escolher alguém ou algo especial entre várias opções por serem os preferidos."
        }
      ]
    },
    "apd": {
      "preferred_label": "الاختيار",
      "descriptions": [
        {
          "source": "acai",
          "description": "اختيار زول ولا حاجة خاصة من بين خيارات كتيرة بسبب تفضيلهم."
        }
      ]
    },
    "arb": {
      "preferred_label": "ٱخْتِيَار",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱخْتِيَارُ شَخْصٍ أَوْ شَيْءٍ مُمَيَّزٍ مِنْ بَيْنِ عِدَّةِ خِيَارَاتٍ لِأَنَّهُ مُفَضَّلٌ."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin blong jusumaot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong jusumaot wan man o wan samting we i spesel long medel blong plante samting from we oli wantem hem moa."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zaɓe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zaɓan wani ko wani abu na musamman daga cikin abubuwa da yawa domin an fi son su."
        }
      ]
    },
    "hin": {
      "preferred_label": "चुनाव",
      "descriptions": [
        {
          "source": "acai",
          "description": "कई विकल्पों में से किसी विशेष व्यक्ति या वस्तु को प्राथमिकता देकर चुनना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nhọpụta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịhọpụta mmadụ ma ọ bụ ihe pụrụ iche nʼime ọtụtụ nhọrọ nʼihi na a kacha nwee mmasị na ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "छनोट",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्राथमिकतामा परेका कारण धेरै विकल्पहरूबाट कुनै विशेष व्यक्ति वा थोक छान्ने काम।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Избрание",
      "descriptions": [
        {
          "source": "acai",
          "description": "Выбор кого-либо или чего-либо особенного из нескольких вариантов по предпочтению."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uchaguzi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumchagua mtu au kitu maalum kutoka miongoni mwa machaguo kadhaa kwa sababu kimependelewa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "makim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong makim wanpela man o samting namel long planti arapela bikos em i nambawan moa."
        }
      ]
    },
    "vie": {
      "preferred_label": "sự lựa chọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Việc chọn một ai đó hoặc điều gì đó đặc biệt từ nhiều lựa chọn khác nhau vì họ được ưa thích hơn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拣选",
      "descriptions": [
        {
          "source": "acai",
          "description": "因特别喜爱而从多个选项中挑选出某人或某物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "揀選",
      "descriptions": [
        {
          "source": "acai",
          "description": "出於偏愛或心意，從多個選項中選出特別之人或事物。"
        }
      ]
    }
  },
