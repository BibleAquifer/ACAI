{
  "id": "keyterm:Forbidden",
  "primary_id": "keyterm:Forbidden",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "localizations": {
    "eng": {
      "preferred_label": "Forbidden",
      "descriptions": [
        {
          "source": "acai",
          "description": "Something that is not allowed or stopped, like fruit that should not be eaten."
        }
      ]
    },
    "apd": {
      "preferred_label": "ممنوع",
      "descriptions": [
        {
          "source": "acai",
          "description": "شي ممنوع أو ما مسموح بيهو، زي الفاكهة الما مفروض تتاكل."
        }
      ]
    },
    "arb": {
      "preferred_label": "محرّم",
      "descriptions": [
        {
          "source": "acai",
          "description": "شيء غير مسموح به أو ممنوع، مثل الثمر الذي لا يجوز أكله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tambu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we i tambu no oli blokem we oli no letem man i mekem, olsem frut we man i no mas kakae."
        }
      ]
    },
    "fra": {
      "preferred_label": "interdit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quelque chose qui n'est pas permis ou qui est interdit, comme un fruit qui ne doit pas être mangé."
        }
      ]
    },
    "hau": {
      "preferred_label": "Haramtacce",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abin da aka hana ko aka haramta, kamar ’ya’yan itace da bai kamata a ci ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "वर्जित",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसी कोई वस्तु जिसकी मनाही हो या रोक लगाई गई हो, जैसे वह फल जिसे नहीं खाना चाहिए।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe a machibidoro iwu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe a na-anaghị ekwe ma ọ bụ nke a machibidoro iwu, dị ka mkpụrụ osisi a na-ekwesịghị iri."
        }
      ]
    },
    "ind": {
      "preferred_label": "terlarang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sesuatu yang tidak diperbolehkan atau dilarang, seperti buah yang tidak boleh dimakan."
        }
      ]
    },
    "nep": {
      "preferred_label": "निषेधित",
      "descriptions": [
        {
          "source": "acai",
          "description": "अनुमति नदिइएको वा रोकिएको कुनै थोक, जस्तै खान नहुने फल।"
        }
      ]
    },
    "por": {
      "preferred_label": "proibido",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo que não é permitido ou que é impedido, como um fruto que não deve ser comido."
        }
      ]
    },
    "rus": {
      "preferred_label": "Запретный",
      "descriptions": [
        {
          "source": "acai",
          "description": "То, что не разрешено или находится под запретом, например, плод, который нельзя есть."
        }
      ]
    },
    "spa": {
      "preferred_label": "prohibido",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo que no está permitido o que se prohíbe, como un fruto que no debe comerse."
        }
      ]
    },
    "swh": {
      "preferred_label": "-liyokatazwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu ambacho hakiruhusiwi au kimezuiliwa, kama vile tunda ambalo halipaswi kuliwa."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bị cấm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Điều gì đó không được phép hoặc bị ngăn cấm, chẳng hạn như trái cây không được ăn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "禁止",
      "descriptions": [
        {
          "source": "acai",
          "description": "不被允许或被禁止的事物，例如不可食用的果子。"
        }
      ]
    },
    "zht": {
      "preferred_label": "禁戒",
      "descriptions": [
        {
          "source": "acai",
          "description": "不被允許或被禁止的事物，例如不可吃的果子。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
