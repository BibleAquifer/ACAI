{
  "id": "keyterm:Clean",
  "primary_id": "keyterm:Clean",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "53.29",
    "79.48"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Clean (Ritually)",
      "alternate_labels": [
        "Pure",
        "Innocent"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Free from dirt or anything that makes you not pure, especially in a way that is right before God."
        }
      ]
    },
    "spa": {
      "preferred_label": "limpio (ritualmente)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Libre de suciedad o de cualquier cosa que impurifique, especialmente de una manera que es recta ante Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "pur (rituellement)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Exempt de souillure ou de tout ce qui rend impur, en particulier d'une manière qui est droite devant Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "tahir (secara ritual)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bebas dari kekotoran atau apa pun yang membuat seseorang tidak murni, khususnya dalam cara yang benar di hadapan Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "puro (ritualmente)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Livre de sujeira ou de qualquer coisa que torne alguém impuro, especialmente de um modo que seja correto diante de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "طاهر (طقسياً)",
      "descriptions": [
        {
          "source": "acai",
          "description": "خالي من الوساخة أو أي حاجة بتخليه ما نقي، خاصة بطريقة مقبولة وصحيحة قدام الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "طاهر (طقسيًا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "خالٍ من الدنس أو أي شيء يجعلك غير نقي، لا سيما بصورة صحيحة ومقبولة أمام الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Klin (Fasin blong wosip)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Klia long doti no eni samting we i mekem man i no klin, speseli long fes blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai tsarki (Ta Al'ada)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kubuta daga datti ko duk wani abu da yake hana ka zama mai tsarki, musamman a hanyar da ta dace a gaban Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "शुद्ध (रीति-अनुसार)",
      "descriptions": [
        {
          "source": "acai",
          "description": "गंदगी या किसी भी ऐसी वस्तु से मुक्त जो अशुद्ध करती हो, विशेषकर उस रीति से जो परमेश्वर के सम्मुख उचित और स्वीकार्य हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịdị ọcha (Nʼemume okpukpe)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwere onwe pụọ na unyi maọbụ ihe ọbụla na-eme ka mmadụ ghara ịdị ọcha, karịsịa nʼụzọ ziri ezi nʼihu Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "शुद्ध (धार्मिक रीतिअनुसार)",
      "descriptions": [
        {
          "source": "acai",
          "description": "फोहोर वा आफूलाई अशुद्ध बनाउने कुनै पनि कुराबाट मुक्त हुनु, विशेष गरी परमेश्‍वरको सामु ठीक हुने तरिकाले।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Чистый (ритуально)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Свободный от нечистоты или осквернения, особенно в смысле ритуальной чистоты перед Богом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Safi (Kiibada)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bila uchafu au chochote kinachokufanya usiwe safi, hasa kwa njia inayokubalika mbele za Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Klin (Long pasin bilong lotu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "I no gat doti o wanpela samting we i mekim yu i no klin, moa yet long pasin we i stret long ai bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thanh sạch (Nghi lễ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không bị ô uế hoặc không vướng phải bất cứ điều gì làm mất đi sự tinh khiết, đặc biệt là theo cách đúng đắn trước mặt Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "洁净 (礼仪上)",
      "descriptions": [
        {
          "source": "acai",
          "description": "没有污秽或任何使人成为不纯洁的事物，特指在上帝面前合宜的状态。"
        }
      ]
    },
    "zht": {
      "preferred_label": "潔淨 (禮儀上)",
      "descriptions": [
        {
          "source": "acai",
          "description": "沒有污垢或任何使人不潔淨的事物，特別是在上帝面前合宜潔淨的狀態。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
