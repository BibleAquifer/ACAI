        }
      ]
    },
    "por": {
      "preferred_label": "parábola",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma história curta que usa símbolos para ensinar uma lição moral ou espiritual."
        }
      ]
    },
    "apd": {
      "preferred_label": "مثل",
      "descriptions": [
        {
          "source": "acai",
          "description": "قصة قصيرة بتستخدم رموز عشان تعلّم درس أخلاقي أو روحي."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَثَل",
      "descriptions": [
        {
          "source": "acai",
          "description": "قِصَّةٌ قَصِيرَةٌ تَسْتَخْدِمُ ٱلرُّمُوزَ لِتَعْلِيمِ دَرْسٍ أَخْلَاقِيٍّ أَوْ رُوحِيٍّ."
        }
      ]
    },
    "bis": {
      "preferred_label": "parabol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan sot stori we i yusum ol saen blong tijim wan lesen long saed blong gudfala fasin no long saed blong spirit."
        }
      ]
    },
    "hau": {
      "preferred_label": "Misali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gajeriyar labari da ke amfani da alamomi don koyar da darasin ɗabi’a ko na ruhaniya."
        }
      ]
    },
    "hin": {
      "preferred_label": "दृष्टान्त",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक छोटी कहानी जो नैतिक या आत्मिक शिक्षा देने के लिए प्रतीकों का उपयोग करती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ilu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Akụkọ dị mkpirikpi nke na-eji ihe atụ na-akụzi ihe mmụta gbasara omume ọma ma ọ bụ nke ime mmụọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "दृष्टान्त",
      "descriptions": [
        {
          "source": "acai",
          "description": "नैतिक वा आत्मिक शिक्षा दिनका लागि प्रतीकहरू प्रयोग गरिएको छोटो कथा।"
        }
      ]
    },
    "rus": {
      "preferred_label": "притча",
      "descriptions": [
        {
          "source": "acai",
          "description": "Короткий рассказ, использующий символы для преподавания нравственного или духовного урока."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mfano",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hadithi fupi inayotumia mifano ili kufundisha somo la kimaadili au la kiroho."
        }
      ]
    },
    "tpi": {
      "preferred_label": "tok piksa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela sotpela stori i yusim ol piksa bilong skulim man long pasin i stret o long samting bilong spirit."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ẩn dụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một câu chuyện ngắn sử dụng các hình ảnh biểu tượng để dạy một bài học đạo đức hoặc tâm linh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "比喻",
      "descriptions": [
        {
          "source": "acai",
          "description": "用象征手法传达道德或属灵教训的简短故事。"
        }
      ]
    },
    "zht": {
      "preferred_label": "比喻",
      "descriptions": [
        {
          "source": "acai",
          "description": "使用象徵手法來教導道德或屬靈教訓的簡短故事。"
        }
      ]
    }
  },
