{
  "id": "keyterm:Merciless",
  "primary_id": "keyterm:Merciless",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "88.82"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Merciless",
      "descriptions": [
        {
          "source": "acai",
          "description": "Not showing any kindness or pity to others, especially those who are suffering."
        }
      ]
    },
    "spa": {
      "preferred_label": "despiadado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que no muestra ninguna compasión o piedad hacia los demás, especialmente hacia quienes están sufriendo."
        }
      ]
    },
    "fra": {
      "preferred_label": "sans pitié",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait de ne manifester aucune bonté ni pitié envers les autres, en particulier envers ceux qui souffrent."
        }
      ]
    },
    "ind": {
      "preferred_label": "tidak berbelaskasihan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak menunjukkan kebaikan hati atau belas kasihan sedikit pun kepada orang lain, terutama mereka yang sedang menderita."
        }
      ]
    },
    "por": {
      "preferred_label": "sem misericórdia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não demonstrar nenhuma bondade ou compaixão pelos outros, especialmente por aqueles que estão sofrendo."
        }
      ]
    },
    "apd": {
      "preferred_label": "قاسي القلب",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم إظهار أي لطف أو شفقة للآخرين، خاصة أولئك الذين يعانون."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَدِيمُ ٱلرَّحْمَةِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم إظهار أي لطف أو شفقة للآخرين، خاصة المتألمين منهم."
        }
      ]
    },
    "bis": {
      "preferred_label": "No gat sore",
      "descriptions": [
        {
          "source": "acai",
          "description": "No soemaot nating kaenfala fasin no sore long ol narafala man, speseli olgeta we oli stap safa."
        }
      ]
    },
    "hau": {
      "preferred_label": "Marar jin ƙai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin nuna kowane irin alheri ko tausayi ga wasu, musamman waɗanda suke shan wahala."
        }
      ]
    },
    "hin": {
      "preferred_label": "निर्दयी",
      "descriptions": [
        {
          "source": "acai",
          "description": "दूसरों के प्रति, विशेषकर जो पीड़ित हैं, कोई दया या तरस न दिखाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Enweghị ebere",
      "descriptions": [
        {
          "source": "acai",
          "description": "Egosipụtaghị obiọma ma ọ bụ ebere ọ bụla nʼebe ndị ọzọ nọ, karịsịa ndị na-ahụ ahụhụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "दयाहीन",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरूप्रति, विशेष गरी दुःख भोगिरहेकाहरूप्रति कुनै दया वा कृपा नदेखाउने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Безжалостный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Не проявляющий никакой доброты или жалости к другим, особенно к тем, кто страдает."
        }
      ]
    },
    "swh": {
      "preferred_label": "Asiye na Huruma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutoonyesha wema au huruma yoyote kwa wengine, hasa wale wanaoteseka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "No gat pasin marimari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong no gat sori o marimari liklik long ol arapela, moa yet long ol manmeri i karim pen o stap long hevi."
        }
      ]
    },
    "vie": {
      "preferred_label": "Không thương xót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không bày tỏ bất kỳ lòng tốt hay sự trắc ẩn nào đối với người khác, đặc biệt là những người đang chịu đau khổ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "毫无怜悯的",
      "descriptions": [
        {
          "source": "acai",
          "description": "对他人毫无仁慈或同情之心，尤其是对受苦的人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "無憐憫心的",
      "descriptions": [
        {
          "source": "acai",
          "description": "對他人毫不仁慈或憐惜，尤其是對正在受苦的人。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
