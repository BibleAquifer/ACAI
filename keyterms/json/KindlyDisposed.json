  "localizations": {
    "eng": {
      "preferred_label": "To Be Kindly Disposed",
      "alternate_labels": [
        "Be Generous",
        "Be Merciful"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To feel and show kindness and mercy toward others by caring for them and helping them."
        }
      ]
    },
    "spa": {
      "preferred_label": "ser compasivo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentir y mostrar bondad y misericordia hacia los demás, cuidando de ellos y ayudándolos."
        }
      ]
    },
    "fra": {
      "preferred_label": "être bien disposé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Éprouver et manifester de la bonté et de la miséricorde envers les autres en prenant soin d'eux et en les aidant."
        }
      ]
    },
    "ind": {
      "preferred_label": "menaruh belas kasihan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Merasakan dan menunjukkan kebaikan serta belas kasihan kepada orang lain dengan memedulikan dan menolong mereka."
        }
      ]
    },
    "por": {
      "preferred_label": "ter compaixão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentir e mostrar bondade e misericórdia para com os outros, cuidando deles e ajudando-os."
        }
      ]
    },
    "apd": {
      "preferred_label": "يترأف",
      "descriptions": [
        {
          "source": "acai",
          "description": "الشعور باللطف والرحمة وإظهارهم للآخرين بالاهتمام بيهم ومساعدتهم."
        }
      ]
    },
    "arb": {
      "preferred_label": "يترأف",
      "descriptions": [
        {
          "source": "acai",
          "description": "الشعور باللطف والرحمة وإظهارهما نحو الآخرين من خلال الرعاية والمساعدة."
        }
      ]
    },
    "bis": {
      "preferred_label": "gat sore",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong filim mo soemaot kaenfala fasin mo sore long ol narafala man taem man i lukaotem olgeta mo givhan long olgeta."
        }
      ]
    },
    "hau": {
      "preferred_label": "Nuna alheri da jinƙai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jin da kuma nuna alheri da jinƙai ga wasu ta hanyar kula da su da kuma taimaka musu."
        }
      ]
    },
    "hin": {
      "preferred_label": "कृपादृष्टि रखना",
      "descriptions": [
        {
          "source": "acai",
          "description": "दूसरों की परवाह करके और उनकी सहायता करके उनके प्रति दया और करुणा महसूस करना और दिखाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Iche echiche ọma nʼebe mmadụ nọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe na igosipụta obiọma na ebere nʼebe ndị ọzọ nọ site nʼilekọta ha na inyere ha aka."
        }
      ]
    },
    "nep": {
      "preferred_label": "कृपालु हुनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरूको हेरचाह गरेर र सहायता पुर्‍याएर उनीहरूप्रति दया र कृपा महसुस गर्नु तथा देखाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Быть благосклонным",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявление доброты и милосердия к другим через заботу о них и оказание им помощи."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuwa na Nia ya Huruma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhisi na kuonyesha wema na rehema kwa wengine kwa kuwajali na kuwasaidia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "marimari na mekim gut long arapela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pilim na soim pasin sori na marimari long ol arapela man long rot bilong lukautim ol na helpim ol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Có lòng nhân từ thương xót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cảm nhận và bày tỏ lòng nhân từ cùng sự thương xót đối với người khác bằng cách chăm sóc và giúp đỡ họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "施恩待人",
      "descriptions": [
        {
          "source": "acai",
          "description": "借着关怀和帮助他人，向他人存有并显出恩惠与怜悯。"
        }
      ]
    },
    "zht": {
      "preferred_label": "施恩憐憫",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由關懷與幫助他人，對他人心存並表現出仁慈與憐憫。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
