{
  "id": "keyterm:Fool",
  "primary_id": "keyterm:Fool",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "000186001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Fool",
      "descriptions": [
        {
          "source": "acai",
          "description": "A person who does not respect God, ignores good advice, talks too much, and often loses their temper."
        }
      ]
    },
    "spa": {
      "preferred_label": "necio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Persona que no respeta a Dios, ignora los buenos consejos, habla demasiado y a menudo pierde los estribos."
        }
      ]
    },
    "fra": {
      "preferred_label": "insensé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une personne qui ne respecte pas Dieu, ignore les bons conseils, parle trop et perd souvent son calme."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang bodoh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang yang tidak menghormati Allah, mengabaikan nasihat yang baik, terlalu banyak bicara, dan sering hilang kesabaran."
        }
      ]
    },
    "por": {
      "preferred_label": "tolo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma pessoa que não respeita a Deus, ignora bons conselhos, fala demais e com frequência perde o controle."
        }
      ]
    },
    "apd": {
      "preferred_label": "جاهل",
      "descriptions": [
        {
          "source": "acai",
          "description": "زول ما بيحترم الله، وما بيسمع النصيحة السمحة، وبيتكلم كتير وبسرعة بيغضب."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَاهِل",
      "descriptions": [
        {
          "source": "acai",
          "description": "شخص لا يهاب الله، ويتجاهل المشورة الصالحة، ويكثر من الكلام، وغالبًا ما يفقد السيطرة على غضبه."
        }
      ]
    },
    "bis": {
      "preferred_label": "man we i no gat hed",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i no gat respek long God, i no lesin long ol gudfala advaes, i toktok tumas, mo i kros kwiktaem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Wawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin da ba ya girmama Allah, yana ƙin karɓar shawara mai kyau, yana yawan surutu, kuma yakan yi saurin fushi."
        }
      ]
    },
    "hin": {
      "preferred_label": "मूर्ख",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसा व्यक्ति जो परमेश्वर का आदर नहीं करता, अच्छी सलाह की उपेक्षा करता है, बहुत अधिक बोलता है और प्रायः अपना आपा खो बैठता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye nzuzu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye na-adịghị asọpụrụ Chineke, na-elelị ezi ndụmọdụ, na-ekwu okwu gabiga ókè, ma na-ewekarị iwe ọsọsọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "मूर्ख",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको आदर नगर्ने, असल सल्लाहलाई बेवास्ता गर्ने, धेरै बोल्ने, र प्रायः रिस नियन्त्रण गर्न नसक्ने व्यक्ति।"
        }
      ]
    },
    "rus": {
      "preferred_label": "глупый",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, который не почитает Бога, пренебрегает добрыми советами, слишком много говорит и часто теряет самообладание."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mpumbavu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu asiyemheshimu Mungu, anayepuuza mashauri mazuri, anayeongea kupita kiasi, na ambaye mara nyingi hushindwa kuzuia hasira yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "man i no gat gutpela tingting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man i no save aninit long God, i sakim gutpela tok, i save toktok planti tumas, na belhat kwiktaim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kẻ dại dột",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người không kính sợ Đức Chúa Trời, phớt lờ lời khuyên tốt lành, nói quá nhiều và thường xuyên mất bình tĩnh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "愚妄人",
      "descriptions": [
        {
          "source": "acai",
          "description": "不敬畏上帝、忽视忠告、多言多语且常常发脾气的人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "愚妄人",
      "descriptions": [
        {
          "source": "acai",
          "description": "不敬畏上帝、無視良言、言語過多且常常發脾氣的人。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
