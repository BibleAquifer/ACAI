{
  "id": "keyterm:Anoint",
  "primary_id": "keyterm:Anointed",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "47.14"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Anoint (Pour)",
      "descriptions": [
        {
          "source": "acai",
          "description": "To pour oil or perfume on a person's body, usually on the head, as part of a special ceremony."
        }
      ]
    },
    "spa": {
      "preferred_label": "ungir (derramar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Derramar aceite o perfume sobre el cuerpo de una persona, normalmente sobre la cabeza, como parte de una ceremonia especial."
        }
      ]
    },
    "fra": {
      "preferred_label": "oindre (verser)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Verser de l'huile ou du parfum sur le corps d'une personne, généralement sur la tête, dans le cadre d'une cérémonie spéciale."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengurapi (menuang)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menuangkan minyak atau minyak wangi ke tubuh seseorang, biasanya di atas kepala, sebagai bagian dari upacara khusus."
        }
      ]
    },
    "por": {
      "preferred_label": "ungir (derramar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Derramar óleo ou perfume sobre o corpo de uma pessoa, geralmente sobre a cabeça, como parte de uma cerimônia especial."
        }
      ]
    },
    "apd": {
      "preferred_label": "مسح (صب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "صب الزيت أو الطيب على جسم الزول، عادةً على الراس، كجزء من طقس خاص."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَسَحَ (سَكَبَ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "سَكْبُ زَيتٍ أَو طِيبٍ عَلى جَسَدِ شَخصٍ، غالِبًا عَلى الرَّأْسِ، كَجُزءٍ مِن طَقْسٍ خاصٍّ."
        }
      ]
    },
    "bis": {
      "preferred_label": "kafsaedem oel (kafsaedem)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong kafsaedem oel o senta i go long bodi blong wan man, klosap oltaem long hed blong hem, olsem haf blong wan spesel seremoni."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shafa (Zubawa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zuba mai ko turare a jikin mutum, yawanci a kai, a matsayin wani ɓangare na wani biki na musamman."
        }
      ]
    },
    "hin": {
      "preferred_label": "अभिषेक करना (उंडेलना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी विशेष समारोह के अंग के रूप में किसी व्यक्ति के शरीर पर, प्रायः सिर पर, तेल या इत्र उंडेलना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịte mmanụ (Ịwụsa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịwụkwasị mmanụ ma ọ bụ ihe na-esi isi ụtọ n'ahụ mmadụ, karịsịa n'isi, dị ka akụkụ nke emume pụrụ iche."
        }
      ]
    },
    "nep": {
      "preferred_label": "अभिषेक गर्नु (खन्याउनु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विशेष समारोहको भागको रूपमा व्यक्तिको शरीरमा, प्रायजसो शिरमा, तेल वा अत्तर खन्याउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "помазывать (возливать)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Возливать елей или благовония на тело человека, обычно на голову, как часть особого обряда."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutia mafuta (Kumimina)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumimina mafuta au manukato juu ya mwili wa mtu, kwa kawaida kichwani, ikiwa sehemu ya sherehe maalum."
        }
      ]
    },
    "tpi": {
      "preferred_label": "welim (kapsaitim wel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kapsaitim wel o sanda long bodi bilong wanpela manmeri, planti taim long het, long wanpela bikpela bung o lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Xức dầu (đổ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đổ dầu hoặc dầu thơm lên thân thể của một người, thường là trên đầu, như một phần của nghi thức đặc biệt."
        }
      ]
    },
    "zhs": {
      "preferred_label": "膏抹 (倾倒)",
      "descriptions": [
        {
          "source": "acai",
          "description": "作为特殊仪式的一部分，将油或香膏倒在人的身体上（通常在头部）。"
        }
      ]
    },
    "zht": {
      "preferred_label": "抹油 (傾倒)",
      "descriptions": [
        {
          "source": "acai",
          "description": "通常在特殊儀式中，將油或香膏倒在人的身體上（通常在頭上）。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Anointed"
  ],
