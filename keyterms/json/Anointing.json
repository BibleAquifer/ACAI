  "localizations": {
    "eng": {
      "preferred_label": "Anointing (Act)",
      "alternate_labels": [
        "Appointment"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "The act of giving someone a special job with God's blessing and power."
        }
      ]
    },
    "spa": {
      "preferred_label": "unción (acto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "El acto de encomendar a alguien una tarea especial con la bendición y el poder de Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "onction (acte)",
      "descriptions": [
        {
          "source": "acai",
          "description": "L'acte de confier à quelqu'un une tâche spéciale avec la bénédiction et la puissance de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "pengurapan (tindakan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tindakan memberikan tugas khusus kepada seseorang dengan berkat dan kuasa Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "unção (ato)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O ato de conferir a alguém uma função especial com a bênção e o poder de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "مسح (فعل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل إعطاء شخص مهمة خاصة مع بركة وقوة من الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَسْح (فِعْل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "فِعْلُ إِعْطاءِ شَخْصٍ ما مَهَمَّةً خاصَّةً بِبَرَكَةِ اللهِ وَقُوَّتِهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Wok blong makemaot (Aksen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wok ya blong givim wan spesel wok long wan man wetem blesing mo paoa blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shafawa (Aiki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aikin ba wa wani aiki na musamman tare da albarka da ikon Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "अभिषेक (कार्य)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर की आशीष और सामर्थ्य के साथ किसी को कोई विशेष कार्य सौंपने का कार्य।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ite mmanụ (Omume)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Omume nke inye mmadụ ọrụ pụrụ iche site na ngọzi na ike Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "अभिषेक (कार्य)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको आशिष् र शक्तिका साथ कसैलाई विशेष काम दिने कार्य।"
        }
      ]
    },
    "rus": {
      "preferred_label": "помазание (действие)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Действие наделения кого-либо особым поручением с Божьим благословением и силой."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutia mafuta (Kitendo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitendo cha kumpa mtu kazi maalum pamoja na baraka na nguvu za Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "makim long wel (pasin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong makim wanpela man bilong mekim spesel wok wantaim blesing na strong bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "sự xức dầu (hành động)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành động giao phó cho ai đó một nhiệm vụ đặc biệt với sự ban phước và quyền năng của Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "膏立 (行动)",
      "descriptions": [
        {
          "source": "acai",
          "description": "借着上帝的赐福与大能，赋予某人特殊职责的行为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "受膏 (行動)",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉著上帝的賜福與能力，賦予某人特定職責的行動。"
        }
      ]
    }
  },
