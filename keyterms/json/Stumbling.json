      "alternate_labels": [
        "Obstacle"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Something that causes a person to trip or fall, or makes them do wrong."
        }
      ]
    },
    "spa": {
      "preferred_label": "piedra de tropiezo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo que hace que una persona tropiece o caiga, o que la induce a hacer lo malo."
        }
      ]
    },
    "fra": {
      "preferred_label": "pierre d'achoppement",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chose qui fait trébucher ou tomber une personne, ou la pousse à mal agir."
        }
      ]
    },
    "ind": {
      "preferred_label": "batu sandungan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sesuatu yang menyebabkan seseorang tersandung atau jatuh, atau membuat mereka berbuat salah."
        }
      ]
    },
    "por": {
      "preferred_label": "pedra de tropeço",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo que faz uma pessoa tropeçar ou cair, ou a faz fazer o que é errado."
        }
      ]
    },
    "apd": {
      "preferred_label": "حجر عثرة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة بتخلي الزول يتعثر ويقع، أو بتخليهو يعمل الغلط."
        }
      ]
    },
    "arb": {
      "preferred_label": "حجر عثرة",
      "descriptions": [
        {
          "source": "acai",
          "description": "شيء يجعل الشخص يتعثر أو يسقط، أو يدفعه إلى ارتكاب الخطأ."
        }
      ]
    },
    "bis": {
      "preferred_label": "samting we i mekem man i stambol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we i mekem man i trip no foldaon, no i mekem hem i mekem samting we i rong."
        }
      ]
    },
    "hau": {
      "preferred_label": "Abin sa tuntuɓe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da yake sa mutum ya yi tuntuɓe ko ya fāɗi, ko kuma ya sa shi ya yi abin da ba daidai ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "ठोकर का कारण",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसी कोई चीज़ जिसके कारण कोई व्यक्ति फिसल जाए या गिर पड़े, या जो उससे गलत काम करवाए।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe ịsụ ngọngọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe na-eme ka mmadụ daa ma ọ bụ tụfuo nguzozi ya, ma ọ bụ mee ka ọ mee ihe ọjọọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "ठेसको कारण",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै यस्तो थोक जसले मानिसलाई ठक्कर खुवाउँछ वा लडाउँछ, अथवा तिनीहरूलाई गलत काम गर्न लगाउँछ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Камень преткновения",
      "descriptions": [
        {
          "source": "acai",
          "description": "То, что заставляет человека споткнуться или упасть либо побуждает поступать дурно."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kikwazo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu kinachomfanya mtu ajikwae au aanguke, au kinachomfanya atende maovu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Samting bilong sutim lek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting i save sutim lek bilong man na mekim em i pundaun, o mekim em i mekim pasin rong."
        }
      ]
    },
    "vie": {
      "preferred_label": "Hòn đá vấp chân",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vật làm cho một người vấp té hoặc ngã, hoặc khiến họ làm điều sai trái."
        }
      ]
    },
    "zhs": {
      "preferred_label": "绊脚石",
      "descriptions": [
        {
          "source": "acai",
          "description": "导致人绊倒、摔倒或使人行恶的事物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "絆腳石",
      "descriptions": [
        {
          "source": "acai",
          "description": "致使人絆腳跌倒，或引誘人行惡的事物。"
        }
      ]
    }
  },
