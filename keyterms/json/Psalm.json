{
  "id": "keyterm:Psalm",
  "primary_id": "keyterm:Psalm",
  "type": "keyterm",
  "keyterm_type": "miscellaneous",
  "ubsdbh": [
    "003842001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Psalm",
      "descriptions": [
        {
          "source": "acai",
          "description": "A sacred song or poem that expresses worship, praise, or prayer to God."
        }
      ]
    },
    "spa": {
      "preferred_label": "salmo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cántico o poema sagrado que expresa adoración, alabanza u oración a Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "psaume",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chant sacré ou poème exprimant l’adoration, la louange ou la prière adressée à Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "mazmur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nyanyian atau puisi kudus yang mengungkapkan ibadah, pujian, atau doa kepada Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "salmo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um cântico sagrado ou poema que expressa adoração, louvor ou oração a Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "مزمور",
      "descriptions": [
        {
          "source": "acai",
          "description": "ترنيمة مقدسة أو شعر بيعبّر عن العبادة أو التسبيح أو الصلاة لله."
        }
      ]
    },
    "arb": {
      "preferred_label": "مزمور",
      "descriptions": [
        {
          "source": "acai",
          "description": "ترنيمة أو قصيدة مقدسة تعبر عن العبادة أو التسبيح أو الصلاة لله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tabu singsing no poetri we i soemaot wosip, presem God, no prea i go long Hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zabura",
      "descriptions": [
        {
          "source": "acai",
          "description": "Waƙa mai tsarki ko waƙar yabo da take bayyana sujada, yabo, ko addu’a ga Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "भजन",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक पवित्र गीत या कविता जो परमेश्वर की आराधना, स्तुति या प्रार्थना को व्यक्त करती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Abụ Ọma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abụ dị nsọ maọbụ abụ uri na-egosipụta ofufe, otuto, maọbụ ekpere e kpere nye Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "भजन",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरप्रति आराधना, प्रशंसा वा प्रार्थना व्यक्त गर्ने एक पवित्र गीत वा कविता।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Псалом",
      "descriptions": [
        {
          "source": "acai",
          "description": "Священная песнь или стихотворение, выражающее поклонение, хвалу или молитву к Богу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Zaburi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wimbo au shairi takatifu linaloonyesha ibada, sifa, au maombi kwa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Song",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela song holi o poem bilong lotuim, litimapim nem, o prea long God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thi thiên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một bài thánh ca hoặc bài thơ bày tỏ sự thờ phượng, ca ngợi hoặc cầu nguyện lên Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "诗篇",
      "descriptions": [
        {
          "source": "acai",
          "description": "向神表达敬拜、赞美或祈求的神圣诗歌或诗篇。"
        }
      ]
    },
    "zht": {
      "preferred_label": "詩篇",
      "descriptions": [
        {
          "source": "acai",
          "description": "表達對上帝的敬拜、讚美或祈禱的神聖詩歌或詩篇。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
