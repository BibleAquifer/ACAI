        }
      ]
    },
    "hin": {
      "preferred_label": "शिक्षा",
      "descriptions": [
        {
          "source": "acai",
          "description": "विश्वास और जीवन जीने के तौर-तरीकों के विषय में लोगों को सिखाने के लिए दी जाने वाली शिक्षाएं या निर्देश।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ozizi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe mmụta ma ọ bụ ntụziaka a na-ekerịta iji nyere ndị mmadụ aka ịmụta banyere okwukwe na otu ha ga-esi na-ebi ndụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "शिक्षा",
      "descriptions": [
        {
          "source": "acai",
          "description": "विश्वास र जीवन जिउने तरिकाबारे सिक्न मानिसहरूलाई मद्दत गर्न दिइने पाठ वा शिक्षाहरू।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Учение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Уроки или наставления, передаваемые с целью помочь людям узнать о вере и о том, как жить."
        }
      ]
    },
    "swh": {
      "preferred_label": "Fundisho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mafunzo au maagizo yanayotolewa ili kuwasaidia watu kujifunza kuhusu imani na jinsi ya kuishi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "tisaing o tok skul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol skul o tok i givim bilong helpim ol manmeri long kisim save long bilip na pasin bilong wokabaut."
        }
      ]
    },
    "vie": {
      "preferred_label": "sự dạy dỗ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Các bài học hoặc chỉ dẫn được chia sẻ để giúp mọi người học biết về đức tin và cách sống."
        }
      ]
    },
    "zhs": {
      "preferred_label": "教导",
      "descriptions": [
        {
          "source": "acai",
