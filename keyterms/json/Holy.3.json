{
  "id": "keyterm:Holy.3",
  "primary_id": "keyterm:Consecration.2",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "53.44",
    "88.26"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Make Holy",
      "alternate_labels": [
        "Sanctify"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To set someone or something apart as special and pure for God's use."
        }
      ]
    },
    "fra": {
      "preferred_label": "sanctifier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mettre à part quelqu'un ou quelque chose comme pur et réservé à l'usage de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "menguduskan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengkhususkan seseorang atau sesuatu sebagai hal yang istimewa dan murni untuk digunakan bagi Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "santificar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Separar alguém ou algo como especial e puro para o uso de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "تقديس",
      "descriptions": [
        {
          "source": "acai",
          "description": "إفراز زول أو شي وتخصيصه كحاجة مميزة وطاهرة لخدمة الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "يقدس",
      "descriptions": [
        {
          "source": "acai",
          "description": "إفراز شخص أو شيء وتخصيصه ليكون مميزًا وطاهرًا لاستخدام الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem i Tabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekem wan man o wan samting i kam spesel mo klin blong God i yusum."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tsarkakewa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Keɓe wani ko wani abu na musamman kuma mai tsabta don amfanin Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "पवित्र करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या वस्तु को परमेश्वर के उपयोग के लिए विशेष और शुद्ध रूप में अलग करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ido Nsọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ido mmadụ maọbụ ihe iche ka ọ dị iche ma dịkwa ọcha maka ojiji Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "पवित्र पार्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई वा कुनै थोकलाई परमेश्‍वरको सेवाको निम्ति विशेष र शुद्ध रूपमा अलग गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "освящать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отделять кого-либо или что-либо как особое и чистое для служения Богу."
        }
      ]
    },
    "spa": {
      "preferred_label": "santificar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Apartar a alguien o algo como especial y puro para el uso de Dios."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutakasa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutenga mtu au kitu kuwa cha pekee na safi kwa ajili ya matumizi ya Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim i kamap holi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Makim wanpela man o samting i stap klin na i stap bilong God yet tasol."
        }
      ]
    },
    "vie": {
      "preferred_label": "thánh hóa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Biệt riêng ai đó hoặc điều gì đó trở nên đặc biệt và thanh sạch để dùng cho Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "使之圣洁",
      "descriptions": [
        {
          "source": "acai",
          "description": "将某人或某物分别出来，作为特别而纯洁之物供上帝使用。"
        }
      ]
    },
    "zht": {
      "preferred_label": "使成聖",
      "descriptions": [
        {
          "source": "acai",
          "description": "將某人或某物分別為聖，作為專屬於上帝且純潔之用。"
        }
      ]
    }
  },
  "referred_to_as": [
