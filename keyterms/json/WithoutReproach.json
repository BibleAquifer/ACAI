{
  "id": "keyterm:WithoutReproach",
  "primary_id": "keyterm:WithoutReproach",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "33.433"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Without Reproach",
      "alternate_labels": [
        "Blameless"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Having a good reputation with no one able to blame or accuse of wrongdoing."
        }
      ]
    },
    "spa": {
      "preferred_label": "irreprensible",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tener una buena reputación sin que nadie pueda culpar o acusar de una mala acción."
        }
      ]
    },
    "fra": {
      "preferred_label": "sans reproche",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le fait d'avoir une bonne réputation, sans que personne ne puisse blâmer ou accuser d'une mauvaise action."
        }
      ]
    },
    "ind": {
      "preferred_label": "tak bercacat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memiliki reputasi yang baik tanpa ada seorang pun yang dapat mencela atau menuduh melakukan kesalahan."
        }
      ]
    },
    "por": {
      "preferred_label": "irrepreensível",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ter boa reputação, sem que ninguém possa culpar ou acusar de conduta errada."
        }
      ]
    },
    "apd": {
      "preferred_label": "بلا لوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "امتلاك سمعة طيبة بدون ما يقدر زول يلومك أو يتهمك بفعل غلط."
        }
      ]
    },
    "arb": {
      "preferred_label": "بِلَا لَوْمٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "التمتع بسمعة طيبة دون أن يتمكن أحد من لوم الشخص أو اتهامه بسوء تصرف."
        }
      ]
    },
    "bis": {
      "preferred_label": "No gat rabis poen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong gat wan gudfala nem we i no gat wan man we i save blemem no putum poen agens long hem from wan rong."
        }
      ]
    },
    "hau": {
      "preferred_label": "Marar abin zargi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samun kyakkyawan suna ba tare da wani ya sami damar zargi ko zargin yin ba daidai ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "निर्दोष",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अच्छी प्रतिष्ठा होना ताकि कोई भी बुराई का आरोप या दोष न लगा सके।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Enweghị ịta ụta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe ezi aha ebe ọ na-enweghị onye nwere ike ịta ụta ma ọ bụ boo ebubo ime ihe ọjọọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "दोषरहित",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैले पनि दोष लगाउन वा गलत कामको आरोप लगाउन नसक्ने असल प्रतिष्ठा भएको।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Беспорочный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Обладание доброй репутацией, при которой никто не может упрекнуть или обвинить в дурных поступках."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bila Lawama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa na sifa nzuri bila mtu yeyote kuweza kulaumu au kushtaki kwa uovu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "I no gat rong",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong i gat gutpela nem na i no gat wanpela man inap sutim tok o putim hevi long em long wanpela rong."
        }
      ]
    },
    "vie": {
      "preferred_label": "Không chỗ trách được",
      "descriptions": [
        {
          "source": "acai",
          "description": "Có tiếng tốt, không ai có thể chê trách hay cáo buộc điều sai trái."
        }
      ]
    },
    "zhs": {
      "preferred_label": "无可指责",
      "descriptions": [
        {
          "source": "acai",
          "description": "具有良好的名声，无人能挑剔或指责其有过失。"
        }
      ]
    },
    "zht": {
      "preferred_label": "無可責備",
      "descriptions": [
        {
          "source": "acai",
          "description": "具有良好的名聲，無人能責難或指控其過錯。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
