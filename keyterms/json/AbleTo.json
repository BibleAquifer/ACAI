  ],
  "localizations": {
    "eng": {
      "preferred_label": "Be Able To",
      "alternate_labels": [
        "Be Capable Of"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Having the personal skill or power needed to do or experience something."
        }
      ]
    },
    "apd": {
      "preferred_label": "يقدر",
      "descriptions": [
        {
          "source": "acai",
          "description": "الزول يكون عنده المهارة أو القوة الشخصية المحتاج ليها عشان يعمل أو يمر بحاجة."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَدَرَ عَلَى",
      "descriptions": [
        {
          "source": "acai",
          "description": "امتلاك المهارة أو القوة الشخصية اللازمة لفعل شيء ما أو معايشته."
        }
      ]
    },
    "bis": {
      "preferred_label": "Save mekem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong gat save o paoa we i nidim blong mekem o blong harem wan samting."
        }
      ]
    },
    "fra": {
      "preferred_label": "pouvoir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Avoir la compétence ou la force personnelle requise pour accomplir ou éprouver quelque chose."
        }
      ]
    },
    "hau": {
      "preferred_label": "Iya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samun fasahar mutum kansa ko ikon da ake bukata domin yin ko dandana wani abu."
        }
      ]
    },
    "hin": {
      "preferred_label": "समर्थ होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुछ करने या अनुभव करने के लिए आवश्यक व्यक्तिगत कौशल या शक्ति होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Inwe ike",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe nkà ma ọ bụ ike achọrọ iji mee ma ọ bụ nweta ahụmahụ nke ihe."
        }
      ]
    },
    "ind": {
      "preferred_label": "mampu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memiliki keahlian atau kuasa pribadi yang dibutuhkan untuk melakukan atau mengalami sesuatu."
        }
      ]
    },
    "nep": {
      "preferred_label": "सक्षम हुनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरा गर्न वा अनुभव गर्नका लागि आवश्यक व्यक्तिगत सिप वा शक्ति हुनु।"
        }
      ]
    },
    "por": {
      "preferred_label": "ser capaz de",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ter a habilidade pessoal ou poder necessário para fazer ou experimentar algo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Быть способным",
      "descriptions": [
        {
          "source": "acai",
          "description": "Обладание личным умением или силой, необходимыми для того, чтобы совершить или пережить что-либо."
        }
      ]
    },
    "spa": {
      "preferred_label": "poder",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tener la destreza personal o el poder necesario para hacer o experimentar algo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuweza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa na ustadi au nguvu za kibinafsi zinazohitajika kufanya au kupitia jambo fulani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Inap Long",
      "descriptions": [
        {
          "source": "acai",
          "description": "I gat skil o strong bilong mekim o kisim wanpela samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Có thể",
      "descriptions": [
        {
          "source": "acai",
          "description": "Có kỹ năng hoặc năng lực cá nhân cần thiết để làm hoặc trải nghiệm điều gì đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "能够",
      "descriptions": [
        {
          "source": "acai",
          "description": "具备做某事或经历某事所需的个人技能或力量。"
        }
      ]
    },
    "zht": {
      "preferred_label": "能夠",
      "descriptions": [
        {
          "source": "acai",
          "description": "擁有去做或經歷某事所必需的個人技能或力量。"
        }
      ]
    }
  },
