  ],
  "localizations": {
    "eng": {
      "preferred_label": "(Metaphorical) Way to Live",
      "alternate_labels": [
        "Path"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "The correct path people should follow to live their lives the way God wants."
        }
      ]
    },
    "fra": {
      "preferred_label": "voie à suivre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le droit chemin que les personnes devraient suivre pour vivre leur vie comme Dieu le désire."
        }
      ]
    },
    "ind": {
      "preferred_label": "(kiasan) jalan hidup",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jalan benar yang seharusnya diikuti orang-orang untuk menjalani hidup sebagaimana yang dikehendaki Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "modo de viver (metafórico)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O caminho correto que as pessoas devem seguir para viver a vida de acordo com a vontade de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "درب الحياة (مجازي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الدرب الصح البيفترض الناس يمشوا فيه عشان يعيشوا حياتهم زي ما الله داير."
        }
      ]
    },
    "arb": {
      "preferred_label": "طَرِيقُ العَيْشِ (مَجازِيّ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "المَسارُ الصَّحِيحُ الَّذِي يَنْبَغِي لِلنّاسِ اتِّباعُهُ لِيَعِيشُوا حَياتَهُمْ كَما يُرِيدُ اللهُ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Stret rod blong laef",
      "descriptions": [
        {
          "source": "acai",
          "description": "Stret rod we ol man oli mas folem blong laef folem samting we God i wantem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hanyar yin rayuwa (a misalance)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hanya madaidaiciya da ya kamata mutane su bi domin yin rayuwarsu yadda Allah yake so."
        }
      ]
    },
    "hin": {
      "preferred_label": "जीने का मार्ग",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह सही मार्ग जिस पर लोगों को चलना चाहिए ताकि वे परमेश्वर की इच्छानुसार अपना जीवन जी सकें।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụzọ e si ebi ndụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụzọ ziri ezi nke ndị mmadụ kwesịrị ịgbaso iji bie ndụ ha dịka Chineke chọrọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "जिउने मार्ग (लाक्षणिक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको इच्छा अनुसार जीवन जिउन मानिसहरूले हिँड्नुपर्ने सही मार्ग।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Путь жизни",
      "descriptions": [
        {
          "source": "acai",
          "description": "Верный путь, по которому людям надлежит идти, чтобы жить так, как угодно Богу."
        }
      ]
    },
    "spa": {
      "preferred_label": "camino a seguir (metafórico)",
      "descriptions": [
        {
          "source": "acai",
          "description": "El camino correcto que las personas deben seguir para vivir según la voluntad de Dios."
        }
      ]
    },
    "swh": {
      "preferred_label": "Njia ya kuishi (ya sitiari)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Njia sahihi ambayo watu wanapaswa kuifuata ili kuishi maisha yao jinsi Mungu anavyotaka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rot bilong bihainim long laip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Stretpela rot manmeri i mas bihainim long laip bilong ol olsem God i laikim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đường lối sống (Nghĩa bóng)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con đường đúng đắn mà con người nên theo để sống cuộc đời theo ý muốn của Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "(隐喻) 当行的道",
      "descriptions": [
        {
          "source": "acai",
          "description": "人们为了按上帝的心意生活而应当跟随的正道。"
        }
      ]
    },
    "zht": {
      "preferred_label": "（比喻）生命之道",
      "descriptions": [
        {
          "source": "acai",
          "description": "人應當遵循的正確道路，以按照上帝的心意生活。"
        }
      ]
    }
  },
