{
  "id": "keyterm:Proclamation",
  "primary_id": "keyterm:Proclaim",
  "type": "keyterm",
  "keyterm_type": "miscellaneous",
  "ubsdgnt": [
    "33.258"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Proclamation",
      "alternate_labels": [
        "Preaching"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "The message that is shared with others, often about God and what He wants."
        }
      ]
    },
    "spa": {
      "preferred_label": "proclamación",
      "descriptions": [
        {
          "source": "acai",
          "description": "El mensaje que se comparte con los demás, a menudo acerca de Dios y de lo que él desea."
        }
      ]
    },
    "fra": {
      "preferred_label": "prédication",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le message transmis aux autres, souvent au sujet de Dieu et de sa volonté."
        }
      ]
    },
    "ind": {
      "preferred_label": "pemberitaan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pesan yang dibagikan kepada orang lain, sering kali mengenai Allah dan kehendak-Nya."
        }
      ]
    },
    "por": {
      "preferred_label": "proclamação",
      "descriptions": [
        {
          "source": "acai",
          "description": "A mensagem compartilhada com outros, muitas vezes sobre Deus e o que Ele deseja."
        }
      ]
    },
    "apd": {
      "preferred_label": "مناداة",
      "descriptions": [
        {
          "source": "acai",
          "description": "الرسالة البتتقال للناس، وغالباً عن الله وعن الحاجه الدايرها."
        }
      ]
    },
    "arb": {
      "preferred_label": "كرازة",
      "descriptions": [
        {
          "source": "acai",
          "description": "الرسالة التي يتم نقلها للآخرين، وغالبًا ما تكون عن الله وعما يريده."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tok we oli talemaot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mesej we oli serem wetem ol narafala man, we plante taem i tokbaot God mo samting we hem i wantem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Saƙon da ake sanar da wasu, sau da yawa game da Allah da abin da yake so."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रचार",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह संदेश जो दूसरों के साथ साझा किया जाता है, जो प्रायः परमेश्वर और उसकी इच्छा के विषय में होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nkwusa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ozi ahụ a na-ezisara ndị ọzọ, nke na-abụkarị maka Chineke na ihe ọ chọrọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रचार",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरूलाई सुनाइने सन्देश, जुन प्रायः परमेश्‍वर र उहाँको इच्छाको बारेमा हुन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Проповедь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Весть, передаваемая другим, часто о Боге и Его воле."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tangazo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ujumbe unaoshirikiwa na wengine, mara nyingi kuhusu Mungu na yale anayoyataka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tok ol i autim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dispela tok ol i autim long ol arapela manmeri, planti taim em i tok bilong God na samting em i laikim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời rao giảng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sứ điệp được chia sẻ với người khác, thường là về Đức Chúa Trời và những điều Ngài muốn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "宣讲的信息",
      "descriptions": [
        {
          "source": "acai",
          "description": "向他人传达的信息，通常关乎上帝及其旨意。"
        }
      ]
    },
    "zht": {
      "preferred_label": "所傳的道",
      "descriptions": [
        {
          "source": "acai",
          "description": "與他人分享的信息，通常關於上帝及其旨意。"
        }
      ]
    }
  },
  "referred_to_as": [
