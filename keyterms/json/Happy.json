  "localizations": {
    "eng": {
      "preferred_label": "Happy",
      "alternate_labels": [
        "Blessed",
        "Blessed One"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Feeling joy and peace because of good things happening in life."
        }
      ]
    },
    "spa": {
      "preferred_label": "dichoso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentir gozo y paz debido a las cosas buenas que suceden en la vida."
        }
      ]
    },
    "fra": {
      "preferred_label": "heureux",
      "descriptions": [
        {
          "source": "acai",
          "description": "Éprouver de la joie et de la paix en raison de bonnes choses qui arrivent dans la vie."
        }
      ]
    },
    "ind": {
      "preferred_label": "berbahagia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Merasakan sukacita dan damai sejahtera karena hal-hal baik yang terjadi dalam hidup."
        }
      ]
    },
    "por": {
      "preferred_label": "feliz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentir alegria e paz devido a coisas boas que acontecem na vida."
        }
      ]
    },
    "apd": {
      "preferred_label": "فرحان",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاسس بفرح وسلام عشان حاجات كويسة قاعدة تحصل في الحياة."
        }
      ]
    },
    "arb": {
      "preferred_label": "سعيد",
      "descriptions": [
        {
          "source": "acai",
          "description": "الشعور بالفرح والسلام بسبب حدوث أمور صالحة في الحياة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Harem gud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Harem joi mo pis from ol gudfala samting we oli stap hapen long laef."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai Farin Ciki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jin farin ciki da salama saboda abubuwa masu kyau da ke faruwa a rayuwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "धन्य",
      "descriptions": [
        {
          "source": "acai",
          "description": "जीवन में अच्छी बातें होने के कारण आनंद और शांति का अनुभव करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Inwe obi ụtọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe mmetụta nke ọṅụ na udo nʼihi ihe ọma na-eme na ndụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "सुखी",
      "descriptions": [
        {
          "source": "acai",
          "description": "जीवनमा असल कुराहरू घट्दा आनन्द र शान्ति अनुभव गर्ने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "блаженный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ощущение радости и мира благодаря доброму, происходящему в жизни."
        }
      ]
    },
    "swh": {
      "preferred_label": "-enye furaha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhisi furaha na amani kwa sababu ya mambo mazuri yanayotendeka maishani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Amamas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pilim amamas na bel isi long wanem ol gutpela samting i kamap long laip."
        }
      ]
    },
    "vie": {
      "preferred_label": "Có phước",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cảm thấy vui sướng và bình an nhờ những điều tốt đẹp xảy đến trong cuộc sống."
        }
      ]
    },
    "zhs": {
      "preferred_label": "有福",
      "descriptions": [
        {
          "source": "acai",
          "description": "因生命中发生美好事物而体会到喜乐与平安。"
        }
      ]
    },
    "zht": {
      "preferred_label": "有福的",
      "descriptions": [
        {
          "source": "acai",
          "description": "因生活中發生的好事而感到喜樂與平安。"
        }
      ]
    }
  },
