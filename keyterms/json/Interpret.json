  "localizations": {
    "eng": {
      "preferred_label": "Interpret",
      "alternate_labels": [
        "Examine",
        "Test",
        "Judge to Be Genuine",
        "Approve"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To carefully examine something to understand it well and decide if it is real or true."
        }
      ]
    },
    "spa": {
      "preferred_label": "discernir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Examinar con cuidado algo para entenderlo bien y decidir si es auténtico o verdadero."
        }
      ]
    },
    "fra": {
      "preferred_label": "éprouver",
      "descriptions": [
        {
          "source": "acai",
          "description": "Examiner attentivement quelque chose pour bien le comprendre et décider si c'est réel ou vrai."
        }
      ]
    },
    "ind": {
      "preferred_label": "menguji",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memeriksa sesuatu dengan teliti untuk memahaminya dengan baik dan memutuskan apakah hal itu sungguh-sungguh atau benar."
        }
      ]
    },
    "por": {
      "preferred_label": "discernir",
      "alternate_labels": [
        "discernir"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Examinar cuidadosamente algo para compreendê-lo bem e determinar se é autêntico ou verdadeiro."
        }
      ]
    },
    "apd": {
      "preferred_label": "فحص وتمييز",
      "descriptions": [
        {
          "source": "acai",
          "description": "فحص الشي بعناية عشان يتفهم كويس ويتعرف إذا كان حقيقي أو صاح."
        }
      ]
    },
    "arb": {
      "preferred_label": "اختبار",
      "descriptions": [
        {
          "source": "acai",
          "description": "الفحص الدقيق لشيء ما لفهمه جيدًا والبت فيما إذا كان حقيقيًا أو صادقًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "jekem gud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong luklukgud mo jekem wan samting blong kasem save long hem mo disaed sipos hem i tru no i stret."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gwada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bincika wani abu da kyau domin fahimtarsa da kyau da kuma tabbatar ko na gaske ne ko gaskiya ne."
        }
      ]
    },
    "hin": {
      "preferred_label": "परखना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी बात को अच्छी तरह समझने और यह तय करने के लिए कि वह असली या सच्ची है या नहीं, उसकी सावधानीपूर्वक जाँच करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịnwapụta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iji nlezianya nyochaa ihe iji ghọta ya nke ọma ma kpebie ma ọ bụ nke dị adị ma ọ bụ nke bụ eziokwu."
        }
      ]
    },
    "nep": {
      "preferred_label": "जाँच्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरालाई राम्ररी बुझ्न र त्यो वास्तविक वा सत्य हो कि होइन भनी निर्णय गर्न ध्यानपूर्वक जाँच्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Испытывать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Тщательное исследование чего-либо с целью хорошо это понять и определить, подлинно ли оно или истинно."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kupima",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuchunguza jambo fulani kwa makini ili kulielewa vizuri na kuamua ikiwa ni halisi au kweli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "skelim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong skelim gut wanpela samting bilong kliagut long en na bilong save em i tru o nogat."
        }
      ]
    },
    "vie": {
      "preferred_label": "thử nghiệm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Xem xét kỹ lưỡng một điều gì đó để hiểu rõ và xác định xem điều đó có thật hoặc đúng hay không."
        }
      ]
    },
    "zhs": {
      "preferred_label": "察验",
      "descriptions": [
        {
          "source": "acai",
          "description": "仔细察验某事以便充分理解它，并判定其是否真实或真确。"
        }
      ]
    },
    "zht": {
      "preferred_label": "察驗",
      "descriptions": [
        {
          "source": "acai",
          "description": "仔細省察某事以徹底明白它，並斷定其是否真實或正確。"
        }
      ]
    }
  },
