{
  "id": "keyterm:Circumcision.2",
  "primary_id": "keyterm:Circumcision",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "53.51",
    "11.51"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Circumcision (NT)",
      "descriptions": [
        {
          "source": "acai",
          "description": "The religious act of cutting off the skin covering the head of a male's private part to show dedication to God and belonging to a group."
        }
      ]
    },
    "spa": {
      "preferred_label": "circuncisión (NT)",
      "descriptions": [
        {
          "source": "acai",
          "description": "El acto religioso de cortar la piel que cubre la cabeza de la parte íntima de un varón para mostrar dedicación a Dios y pertenencia a un grupo."
        }
      ]
    },
    "fra": {
      "preferred_label": "circoncision (NT)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Acte religieux consistant à couper le prépuce d'un homme pour manifester son attachement à Dieu et son appartenance à un groupe."
        }
      ]
    },
    "ind": {
      "preferred_label": "sunat (PB)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tindakan keagamaan memotong kulit penutup ujung alat kelamin laki-laki untuk menunjukkan pembaktian kepada Allah dan keterikatan pada suatu kelompok."
        }
      ]
    },
    "por": {
      "preferred_label": "circuncisão (NT)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O ato religioso de cortar a pele que cobre a cabeça do órgão genital masculino para demonstrar dedicação a Deus e pertencimento a um grupo."
        }
      ]
    },
    "apd": {
      "preferred_label": "ختان (العهد الجديد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "العمل الديني لقطع الجلدة البتغطي راس العضو التناسلي للذكر لإظهار التكريس لله والانتماء لجماعة."
        }
      ]
    },
    "arb": {
      "preferred_label": "خِتان (العهد الجديد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "العمل الديني المتمثل في قطع الجلد الذي يغطي رأس العضو التناسلي للذكر لإظهار التكريس لله والانتماء إلى جماعة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sakomsaes (Niu Testeman)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rilijis fasin blong katemaot skin we i kavremap hed blong sem blong man blong soemaot se hem i givim hem fulwan long God mo hem i stap long wan grup."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kaciya (sababbin alkawari)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aikin addini na yanke fatar da take rufe kan azakarin namiji don nuna keɓewa ga Allah da kuma zama ɗaya daga cikin wata ƙungiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "खतना (नया नियम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर के प्रति समर्पण और किसी समूह से संबंध रखने को दर्शाने के लिए पुरुष के गुप्तांग के अगले भाग की त्वचा को काटने की धार्मिक क्रिया।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Obibi ugwu (Agba Ọhụrụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Emume okpukpe nke igbubi akpụkpọ anụ ahụ na-ekpuchi isi amụ nwoke iji gosi nraranye nʼebe Chineke nọ na ịbụ akụkụ nke otu ndị mmadụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "खतना (नयाँ नियम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरप्रतिको समर्पण र कुनै समूहमा सामेल भएको देखाउन पुरुषको अङ्गको माथिल्लो छाला काट्ने धार्मिक कार्य।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Обрезание (НЗ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Религиозный обряд удаления крайней плоти у мужчины в знак посвящения Богу и принадлежности к народу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tohara (AG)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitendo cha kidini cha kukata ngozi inayofunika kichwa cha sehemu ya siri ya mwanamume ili kuonyesha wakfu kwa Mungu na kuwa sehemu ya kikundi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong katim skin (Nupela Testamen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong lotu long katim skin i karamapim het bilong kok bilong man bilong soim olsem em i dediket long God na bilong wanpela grup."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cắt bì (Tân Ước)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nghi thức tôn giáo cắt bỏ lớp da bọc quy đầu của nam giới để thể hiện sự dâng hiến cho Đức Chúa Trời và thuộc về một cộng đồng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "割礼 (新约)",
      "descriptions": [
        {
          "source": "acai",
          "description": "切除男性私处顶端包皮的宗教仪式，以此表明奉献给上帝并属于某一群体。"
        }
      ]
    },
    "zht": {
      "preferred_label": "割禮 (新約)",
      "descriptions": [
        {
          "source": "acai",
          "description": "割除男性生殖器頂端包皮的宗教儀式，以表明奉獻給上帝並歸屬於一個群體。"
        }
      ]
    }
  },
