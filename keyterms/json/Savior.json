  "localizations": {
    "eng": {
      "preferred_label": "Savior",
      "descriptions": [
        {
          "source": "acai",
          "description": "A person who rescues or helps others from danger or trouble."
        }
      ]
    },
    "spa": {
      "preferred_label": "salvador",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una persona que rescata o ayuda a otros frente al peligro o la aflicción."
        }
      ]
    },
    "fra": {
      "preferred_label": "Sauveur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une personne qui délivre ou secourt les autres du danger ou de la détresse."
        }
      ]
    },
    "ind": {
      "preferred_label": "Juruselamat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seseorang yang menyelamatkan atau menolong orang lain dari bahaya atau kesusahan."
        }
      ]
    },
    "por": {
      "preferred_label": "salvador",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma pessoa que resgata ou ajuda outros no perigo ou aflição."
        }
      ]
    },
    "apd": {
      "preferred_label": "مخلّص",
      "descriptions": [
        {
          "source": "acai",
          "description": "شخص بينقذ أو بيساعد غيره من الخطر أو المشاكل."
        }
      ]
    },
    "arb": {
      "preferred_label": "مُخَلِّص",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَخْصٌ يُنْقِذُ الْآخَرِينَ أَوْ يُعِينُهُمْ فِي الْخَطَرِ أَوِ الضِّيقِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sevia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i sevem no i helpem ol narafala man long denja no long trabol."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai Ceto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin da yake ceto ko taimakon wasu daga haɗari ko matsala."
        }
      ]
    },
    "hin": {
      "preferred_label": "उद्धारकर्ता",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह व्यक्ति जो दूसरों को संकट या खतरे से बचाता है या सहायता करता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye Nzọpụta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye na-anapụta ma ọ bụ na-enyere ndị ọzọ aka site n'ihe ize ndụ ma ọ bụ nsogbu."
        }
      ]
    },
    "nep": {
      "preferred_label": "मुक्तिदाता",
      "descriptions": [
        {
          "source": "acai",
          "description": "खतरा वा सङ्कष्टबाट अरूलाई उद्धार गर्ने वा सहायता गर्ने व्यक्ति।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Спаситель",
      "descriptions": [
        {
          "source": "acai",
          "description": "Тот, кто спасает или избавляет других от опасности или беды."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwokozi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu anayeokoa au kuwasaidia wengine kutoka hatarini au taabuni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Man bilong kisim bek yumi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man i save kisim bek o helpim ol arapela man long taim bilong hevi o bagarap."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đấng Cứu Rỗi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người giải cứu hoặc giúp đỡ người khác thoát khỏi nguy hiểm hay hoạn nạn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "救主",
      "descriptions": [
        {
          "source": "acai",
          "description": "将他人从危险或患难中解救或帮助他人的人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "救主",
      "descriptions": [
        {
          "source": "acai",
          "description": "將他人從危險或患難中解救或幫助出來的人。"
        }
      ]
    }
  },
