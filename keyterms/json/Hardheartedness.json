      "preferred_label": "हठ",
      "descriptions": [
        {
          "source": "acai",
          "description": "सुन्न वा परिवर्तन हुन इन्कार गर्नु, र हठी तथा दयाहीन मनोवृत्ति देखाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Ожесточение сердца",
      "descriptions": [
        {
          "source": "acai",
