        }
      ]
    },
    "por": {
      "preferred_label": "dureza de coração",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recusar-se a ouvir ou mudar, demonstrando atitudes obstinadas e cruéis."
        }
      ]
    },
    "apd": {
      "preferred_label": "قساوة القلب",
