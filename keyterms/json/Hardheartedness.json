    "swh": {
      "preferred_label": "Ugumu wa moyo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kukataa kusikiliza au kubadilika, kuonyesha mtazamo wa ukaidi na ukosefu wa wema."
