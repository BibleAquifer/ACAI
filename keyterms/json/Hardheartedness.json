      "descriptions": [
        {
          "source": "acai",
          "description": "Refusing to listen or change, showing a stubborn and unkind attitudes."
        }
      ]
    },
    "spa": {
      "preferred_label": "dureza de corazón",
      "descriptions": [
        {
          "source": "acai",
