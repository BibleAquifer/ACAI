      ]
    },
    "bis": {
      "preferred_label": "hathed",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong no wantem lesin no jenisim tingting, we i soemaot wan stronghed tingting mo i no kaen."
