  "localizations": {
    "eng": {
      "preferred_label": "To Redeem (Deliver)",
      "alternate_labels": [
        "To Deliver"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To rescue someone from danger or death."
        }
      ]
    },
    "spa": {
      "preferred_label": "redimir (librar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rescatar a alguien del peligro o de la muerte."
        }
      ]
    },
    "fra": {
      "preferred_label": "racheter (délivrer)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Délivrer quelqu'un du danger ou de la mort."
        }
      ]
    },
    "ind": {
      "preferred_label": "menebus (menyelamatkan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyelamatkan seseorang dari bahaya atau kematian."
        }
      ]
    },
    "apd": {
      "preferred_label": "يخلّص (إنقاذ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنقاذ زول من الخطر أو الموت."
        }
      ]
    },
    "arb": {
      "preferred_label": "فدى (إنقاذ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنقاذ شخص من الخطر أو الموت."
        }
      ]
    },
    "bis": {
      "preferred_label": "Pemaot (Sevem)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong sevem wan man long denja no ded."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fansa (Ceto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ceto wani daga haɗari ko mutuwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "छुड़ाना (उद्धार करना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी को संकट या मृत्यु से बचाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgbapụta (Ịnapụta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịnapụta mmadụ site n'ihe ize ndụ ma ọ bụ n'ọnwụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "छुटाउनु (उद्धार)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई खतरा वा मृत्युबाट बचाउनु वा उद्धार गर्नु।"
        }
      ]
    },
    "por": {
      "preferred_label": "resgatar (livramento)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Livrar alguém do perigo ou da morte."
        }
      ]
    },
    "rus": {
      "preferred_label": "Избавлять (освобождать)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Спасти кого-либо от опасности или смерти."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kukomboa (Kuokoa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumwokoa mtu kutoka katika hatari au kifo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kisim bek (helpim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kisim bek o helpim wanpela manmeri long taim bilong hevi, bagarap, o dai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Chuộc (giải cứu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Giải cứu ai đó khỏi cơn nguy hiểm hoặc cái chết."
        }
      ]
    },
    "zhs": {
      "preferred_label": "救赎 (拯救)",
      "descriptions": [
        {
          "source": "acai",
          "description": "将某人从危险或死亡中解救出来。"
        }
      ]
    },
    "zht": {
      "preferred_label": "救贖 (拯救)",
      "descriptions": [
        {
          "source": "acai",
          "description": "將某人從危險或死亡中拯救出來。"
        }
      ]
    }
  },
