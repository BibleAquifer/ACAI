{
  "id": "keyterm:Atonement",
  "primary_id": "keyterm:Atonement",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "003411001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Atonement",
      "descriptions": [
        {
          "source": "acai",
          "description": "Making things right with God by fixing or forgiving wrongs."
        }
      ]
    },
    "spa": {
      "preferred_label": "expiación",
      "descriptions": [
        {
          "source": "acai",
          "description": "Reconciliarse con Dios mediante la reparación o el perdón de las faltas."
        }
      ]
    },
    "fra": {
      "preferred_label": "expiation",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rétablir de bonnes relations avec Dieu en réparant les fautes ou en obtenant le pardon des péchés."
        }
      ]
    },
    "ind": {
      "preferred_label": "pendamaian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memperbaiki hubungan dengan Allah dengan memulihkan atau mengampuni kesalahan."
        }
      ]
    },
    "por": {
      "preferred_label": "expiação",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ajustar as coisas com Deus por meio da reparação ou do perdão dos erros."
        }
      ]
    },
    "apd": {
      "preferred_label": "كفارة",
      "descriptions": [
        {
          "source": "acai",
          "description": "تصليح العلاقة مع الله عن طريق تصليح الغلط أو غفرانه."
        }
      ]
    },
    "arb": {
      "preferred_label": "كَفَّارَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "إِصْلَاحُ ٱلْعَلَاقَةِ مَعَ ٱللهِ عَنْ طَرِيقِ التَّكْفِيرِ عَنِ ٱلْخَطَايَا أَوْ مَغْفِرَتِهَا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong Stretem Sin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong mekem ol samting i kam stret wetem God tru long fasin blong stretem o fogivim ol rong."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kafara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Daidaita dangantaka da Allah ta wurin gyara ko gafarta laifofi."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रायश्चित",
      "descriptions": [
        {
          "source": "acai",
          "description": "गलतियों को सुधारकर या क्षमा पाकर परमेश्वर के साथ संबंध ठीक करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mkpuchi Mmehie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Imezi ihe nʼetiti mmadụ na Chineke site nʼimezi ma ọ bụ ịgbaghara mmejọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रायश्‍चित्त",
      "descriptions": [
        {
          "source": "acai",
          "description": "खराब कामहरूको क्षतिपूर्ति गरेर वा क्षमा गरेर परमेश्‍वरसँगको सम्बन्ध ठीक पार्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Искупление",
      "descriptions": [
        {
          "source": "acai",
          "description": "Восстановление правильных отношений с Богом через заглаживание или прощение грехов."
        }
      ]
    },
    "swh": {
      "preferred_label": "Upatanisho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuweka mambo sawa na Mungu kwa kutengeneza au kusamehe makosa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin bilong rausim sin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong stretim bek sindaun wantaim God long rot bilong tekewe o fogivim ol rong."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự chuộc tội",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm hòa lại với Đức Chúa Trời bằng cách sửa chữa sai trật hoặc tha thứ tội lỗi."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赎罪",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过弥补过错或使过错得蒙饶恕，从而与上帝和好。"
        }
      ]
    },
    "zht": {
      "preferred_label": "贖罪",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由彌補或赦免過犯，使人與上帝恢復合宜的關係。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
