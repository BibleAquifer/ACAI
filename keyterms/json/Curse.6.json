  "localizations": {
    "eng": {
      "preferred_label": "Curse (Formula)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A set of words spoken to cause harm or bad things to happen to someone or something."
        }
      ]
    },
    "spa": {
      "preferred_label": "maldición (fórmula)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Conjunto de palabras pronunciadas para causar daño o desgracias a alguien o algo."
        }
      ]
    },
    "fra": {
      "preferred_label": "malédiction (formule)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ensemble de paroles prononcées pour causer du tort ou provoquer des malheurs à quelqu’un ou à quelque chose."
        }
      ]
    },
    "ind": {
      "preferred_label": "kutuk (rumusan kutukan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rangkaian kata-kata yang diucapkan untuk menyebabkan celaka atau hal buruk terjadi pada seseorang atau sesuatu."
        }
      ]
    },
    "por": {
      "preferred_label": "maldição (fórmula)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um conjunto de palavras pronunciadas para causar danos ou desgraças a alguém ou a algo."
        }
      ]
    },
    "apd": {
      "preferred_label": "لعنة (صيغة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "صيغة كلام محددة بتتقال عشان تسبب الأذى أو الشر لزول أو لحاجة."
        }
      ]
    },
    "arb": {
      "preferred_label": "لَعنة (صيغة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "صيغة من الكلمات تُنطق لإلحاق الأذى أو السوء بشخص أو شيء ما."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tok blong trabol (Formiula blong Tok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan set blong ol tok we man i talem blong mekem trabol no samting nogud i kam kasem wan man no samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "La'ana (Fasalin Kalmomi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tsarin kalmomin da ake faɗa don haifar da cutarwa ko mugayen abubuwa su sami wani ko wani abu."
        }
      ]
    },
    "hin": {
      "preferred_label": "श्राप (श्राप-विधि)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या वस्तु के साथ बुरा होने या हानि पहुँचाने के लिए बोले जाने वाले शब्दों का एक निर्धारित समूह।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọbụbụ ọnụ (Usoro Okwu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Usoro okwu a na-ekwu iji mee ka mmerụ ahụ ma ọ bụ ihe ọjọọ dakwasị mmadụ ma ọ bụ ihe."
        }
      ]
    },
    "nep": {
      "preferred_label": "श्राप (श्राप-वचन)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई वा कुनै थोकलाई हानि वा नराम्रो कुरा आइपरोस् भनी बोलिने शब्दहरूको सूत्र वा वचन।"
        }
      ]
    },
    "rus": {
      "preferred_label": "проклятие (формула)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Установленная словесная формула, произносимая для того, чтобы причинить вред или навлечь беду на кого-либо или что-либо."
        }
      ]
    },
    "swh": {
      "preferred_label": "Laana (Fomula)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Maneno maalumu yanayotamkwa ili kusababisha madhara au mambo mabaya kumpata mtu au kitu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tok Bilong Bagarap (Ol Tok Bilong Singautim Bagarap)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol stretpela tok ol i mekim bilong bringim bagarap o samting nogut long wanpela man o samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời nguyền rủa (Công thức)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chuỗi từ ngữ theo khuôn mẫu được nói ra để gây tổn hại hoặc khiến điều xấu xảy đến cho ai đó hoặc vật gì đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "咒诅 (咒语程式)",
      "descriptions": [
        {
          "source": "acai",
          "description": "为使受害或恶事临到某人或某物而念诵的一套套语。"
        }
      ]
    },
    "zht": {
      "preferred_label": "咒詛 (咒語公式)",
      "descriptions": [
        {
          "source": "acai",
          "description": "為使某人或某物遭受傷害或禍害而說出的一套固定言詞。"
        }
      ]
    }
  },
