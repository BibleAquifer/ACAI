{
  "id": "keyterm:Sacrifice",
  "primary_id": "keyterm:Offering",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "53.20"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Sacrifice (Offering)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Something given to God to show love, thanks, or to ask for forgiveness."
        }
      ]
    },
    "spa": {
      "preferred_label": "sacrificio (ofrenda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo entregado a Dios para mostrar amor, gratitud o para pedir perdón."
        }
      ]
    },
    "fra": {
      "preferred_label": "sacrifice (offrande)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quelque chose offert à Dieu pour exprimer son amour, sa reconnaissance ou pour demander le pardon."
        }
      ]
    },
    "ind": {
      "preferred_label": "korban (persembahan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sesuatu yang diberikan kepada Allah untuk menunjukkan kasih, ucapan syukur, atau untuk memohon pengampunan."
        }
      ]
    },
    "por": {
      "preferred_label": "sacrifício (oferta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo oferecido a Deus para demonstrar amor, gratidão ou para pedir perdão."
        }
      ]
    },
    "apd": {
      "preferred_label": "ذبيحة (تقدمة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة بتتقدم لله عشان تظهر المحبة، الشكر، أو لطلب المغفرة."
        }
      ]
    },
    "arb": {
      "preferred_label": "ذَبِيحَة (تَقْدِمَة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَيْءٌ يُقَدَّمُ لِلهِ إِظْهَارًا لِلْمَحَبَّةِ أَوِ ٱلشُّكْرِ، أَوْ لِطَلَبِ ٱلْمَغْفِرَةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sakrefaes (Ofring)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we man i givim long God blong soemaot lav, tangkiu, o blong askem fogifnes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hadaya (Kyauta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da aka ba Allah domin nuna ƙauna, godiya, ko don neman gafara."
        }
      ]
    },
    "hin": {
      "preferred_label": "बलिदान (भेंट)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रेम, धन्यवाद प्रकट करने या क्षमा माँगने के लिए परमेश्वर को दी जाने वाली कोई वस्तु।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aja (Onyinye)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe e nyere Chineke iji gosi ịhụnanya, ekele, ma ọ bụ ịrịọ mgbaghara mmehie."
        }
      ]
    },
    "nep": {
      "preferred_label": "बलिदान (भेटी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रेम, धन्यवाद देखाउन वा क्षमा माग्‍नको निम्ति परमेश्‍वरलाई चढाइने थोक।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Жертва (приношение)",
      "descriptions": [
        {
          "source": "acai",
          "description": "То, что отдается Богу в знак любви, благодарности или с просьбой о прощении."
        }
      ]
    },
    "swh": {
      "preferred_label": "Dhabihu (Sadaka)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu kinachotolewa kwa Mungu ili kuonesha upendo, shukrani, au kuomba msamaha."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ofa (Samting ol i givim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting ol i givim long God bilong soim pasin laikim, tenkyu, o bilong askim em long lusim ol sin."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sinh tế (Của lễ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lễ vật dâng lên Đức Chúa Trời để bày tỏ tình yêu thương, sự cảm tạ hoặc để cầu xin sự tha thứ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "祭物 (供物)",
      "descriptions": [
        {
          "source": "acai",
          "description": "献给上帝以表达爱、感恩或祈求赦免之物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "祭物（供物）",
      "descriptions": [
        {
          "source": "acai",
          "description": "獻給上帝用以表達愛、感恩或祈求赦免之物。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Offering"
  ],
