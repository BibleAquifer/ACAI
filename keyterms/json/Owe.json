        }
      ]
    },
    "arb": {
      "preferred_label": "مَدْيُون",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَنْ يَكُونَ عَلَيْكَ دَيْنٌ يَلْزَمُكَ سَدَادُهُ أَوْ إِرْجَاعُ شَيْءٍ أَخَذْتَهُ مِنْ قَبْلُ."
        }
      ]
    },
    "bis": {
      "preferred_label": "gat kaon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong mas pem no givimbak wan samting from we yu bin karem fastaem."
        }
      ]
