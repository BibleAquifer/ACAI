    "hau": {
      "preferred_label": "Bin bashi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bukatar biya ko mayar da wani abu saboda ka karɓe shi a dā."
        }
      ]
    },
    "hin": {
      "preferred_label": "कर्जदार होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी चीज़ का भुगतान करने या वापस लौटाने की आवश्यकता होना क्योंकि आपने इसे पहले प्राप्त किया था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ijide ụgwọ",
      "descriptions": [
        {
