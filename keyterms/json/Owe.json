  "localizations": {
    "eng": {
      "preferred_label": "Owe",
      "descriptions": [
        {
          "source": "acai",
          "description": "To need to pay or give something back because you received it before."
        }
      ]
    },
    "spa": {
      "preferred_label": "deber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tener la necesidad de pagar o devolver algo porque se recibió anteriormente."
        }
      ]
    },
    "fra": {
      "preferred_label": "devoir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Avoir besoin de payer ou de rendre quelque chose parce qu'on l'a reçu auparavant."
        }
      ]
    },
    "ind": {
      "preferred_label": "berutang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Keharusan untuk membayar atau mengembalikan sesuatu karena telah menerimanya sebelumnya."
        }
      ]
    },
    "por": {
      "preferred_label": "dever",
      "alternate_labels": [
        "ter dívida para com alguém"
