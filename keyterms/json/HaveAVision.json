  "localizations": {
    "eng": {
      "preferred_label": "Have a Vision",
      "alternate_labels": [
        "See in a Dream"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Seeing a special image or message in a dream or spiritual experience."
        }
      ]
    },
    "spa": {
      "preferred_label": "tener una visión",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ver una imagen o un mensaje especial en un sueño o experiencia espiritual."
        }
      ]
    },
    "fra": {
      "preferred_label": "avoir une vision",
      "descriptions": [
        {
          "source": "acai",
          "description": "Apercevoir une image ou un message particulier dans un rêve ou lors d'une expérience spirituelle."
        }
      ]
    },
    "ind": {
      "preferred_label": "melihat penglihatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Melihat gambaran khusus atau pesan dalam mimpi atau pengalaman spiritual."
        }
      ]
    },
    "por": {
      "preferred_label": "ter uma visão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ver uma imagem ou mensagem especial em um sonho ou experiência espiritual."
        }
      ]
    },
    "apd": {
      "preferred_label": "يشوف رؤيا",
      "descriptions": [
        {
          "source": "acai",
          "description": "رؤية صورة أو رسالة خاصة في حلم أو خبرة روحية."
        }
      ]
    },
    "arb": {
      "preferred_label": "رُؤْيَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "رُؤْيَةُ صُورَةٍ أَوْ رِسَالَةٍ خَاصَّةٍ فِي حُلْمٍ أَوْ اخْتِبَارٍ رُوحِيٍّ."
        }
      ]
    },
    "bis": {
      "preferred_label": "luk vison",
      "descriptions": [
        {
          "source": "acai",
          "description": "Luk wan spesel pija o mesej long wan drim o long wan samting long saed blong spirit."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ganin wahayi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ganin wani hoto ko saƙo na musamman a cikin mafarki ko wata ƙwarewa ta ruhaniya."
        }
      ]
    },
    "hin": {
      "preferred_label": "दर्शन पाना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी स्वप्न या आत्मिक अनुभव में एक विशेष छवि या संदेश देखना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịhụ ọhụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịhụ ihe oyiyi ma ọ bụ ozi pụrụ iche na nrọ ma ọ bụ nʼahụmahụ nke ime mmụọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "दर्शन देख्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "सपना वा आत्मिक अनुभवमा कुनै विशेष दृश्य वा सन्देश देख्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Видеть видение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Видение особого образа или вести во сне либо в духовном переживании."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuona maono",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuona taswira au ujumbe wa pekee katika ndoto au uzoefu wa kiroho."
        }
      ]
    },
    "tpi": {
      "preferred_label": "lukim samting olsem driman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lukim wanpela piksa o tok bilong God long driman o long spirit."
        }
      ]
    },
    "vie": {
      "preferred_label": "thấy khải tượng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thấy một hình ảnh hoặc thông điệp đặc biệt trong một chiêm bao hoặc trải nghiệm tâm linh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "见异象",
      "descriptions": [
        {
          "source": "acai",
          "description": "在异梦或属灵经历中看见特别的景象或信息。"
        }
      ]
    },
    "zht": {
      "preferred_label": "見異象",
      "descriptions": [
        {
          "source": "acai",
          "description": "在異夢或屬靈經歷中看見特殊的景象或信息。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
