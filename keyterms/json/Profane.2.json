  "localizations": {
    "eng": {
      "preferred_label": "To Profane",
      "descriptions": [
        {
          "source": "acai",
          "description": "To do something that makes a person or place spiritually unclean according to religious rules."
        }
      ]
    },
    "spa": {
      "preferred_label": "profanar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer algo que vuelve a una persona o lugar espiritualmente inmundo según las normas religiosas."
        }
      ]
    },
    "fra": {
      "preferred_label": "profaner",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faire quelque chose qui rend une personne ou un lieu spirituellement impur selon les règles religieuses."
        }
      ]
    },
    "ind": {
      "preferred_label": "melanggar kekudusan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Melakukan sesuatu yang membuat seseorang atau suatu tempat najis secara rohani menurut aturan-aturan keagamaan."
        }
      ]
    },
    "por": {
      "preferred_label": "profanar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fazer algo que torne uma pessoa ou lugar espiritualmente impuro segundo preceitos religiosos."
        }
      ]
    },
    "apd": {
      "preferred_label": "يدنس",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل شي بخلي الزول أو المكان نجس روحياً حسب القوانين الدينية."
        }
      ]
    },
    "arb": {
      "preferred_label": "يدنس",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل شيء يجعل شخصًا أو مكانًا نجسًا روحيًا وفقًا للأحكام الدينية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem i no moa tabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem wan samting we i mekem wan man no wan ples i no moa tabu no i kam doti folem ol rul blong laef blong bilif."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙazantarwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin wani abu da ke sa mutum ko wuri ya zama marar tsarki a ruhaniya bisa ga ƙa'idodin addini."
        }
      ]
    },
    "hin": {
      "preferred_label": "अपवित्र करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "धार्मिक नियमों के अनुसार किसी व्यक्ति या स्थान को आत्मिक रूप से अशुद्ध या अपवित्र करने वाला कोई कार्य करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Imerụ nsọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ihe na-eme ka mmadụ ma ọ bụ ebe ghara ịdị ọcha n'ụzọ ime mmụọ dịka iwu okpukpe siri dị."
        }
      ]
    },
    "nep": {
      "preferred_label": "अशुद्ध पार्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "धार्मिक नियमहरूअनुसार कुनै व्यक्ति वा स्थानलाई आत्मिक रूपमा अशुद्ध बनाउने काम गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Осквернять",
      "descriptions": [
        {
          "source": "acai",
          "description": "Совершать поступок, делающий человека или место духовно нечистым согласно религиозным установлениям."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kunajisi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kufanya jambo linalomfanya mtu au mahali kuwa najisi kiroho kulingana na kanuni za kidini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim i kamap doti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long mekim wanpela samting we i mekim wanpela man o ples i kamap doti long ai bilong God inap long ol lo bilong lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Làm ô uế",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm điều gì đó khiến một người hoặc một nơi trở nên ô uế về mặt tâm linh theo các luật lệ tôn giáo."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亵渎",
      "descriptions": [
        {
          "source": "acai",
          "description": "根据宗教规条做出使人或地方在属灵上不洁净的事。"
        }
      ]
    },
    "zht": {
      "preferred_label": "褻瀆",
      "descriptions": [
        {
          "source": "acai",
          "description": "按宗教規例做出使人或地方在屬靈上不潔淨的行為；褻瀆或干犯。"
        }
      ]
    }
  },
