        {
          "source": "acai",
          "description": "कसैको जीवनमा असल कुराहरू भइरहेको कारणले उसलाई आनन्दित वा भाग्यमानी ठान्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Считать блаженным",
      "descriptions": [
        {
          "source": "acai",
          "description": "Считать кого-либо счастливым или удачливым из-за происходящего с ним блага."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuhesabu kuwa Mwenye Heri",
      "descriptions": [
        {
          "source": "acai",
