    },
    "tpi": {
      "preferred_label": "tingim olsem man i amamas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lukim wanpela manmeri olsem em i amamas o em i gat blesing bikos long ol gutpela samting i kamap long em."
