        {
          "source": "acai",
          "description": "Xem ai đó là có phước hoặc may mắn vì những điều tốt lành xảy đến cho họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "视为有福",
      "descriptions": [
        {
          "source": "acai",
          "description": "因某人经历美事而视其为幸福或有福的。"
        }
      ]
    },
    "zht": {
      "preferred_label": "以為有福",
      "descriptions": [
        {
          "source": "acai",
          "description": "因某人經歷好事而認為其是有福或幸運的。"
        }
      ]
    }
