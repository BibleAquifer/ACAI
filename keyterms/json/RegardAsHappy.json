        {
          "source": "acai",
          "description": "رُؤْيَةُ الشَّخْصِ سَعيدًا أَوْ مَحْظوظًا بِسَبَبِ أُمورٍ صالِحَةٍ تَحْدُثُ لَهُ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Luk se i blesed",
      "descriptions": [
