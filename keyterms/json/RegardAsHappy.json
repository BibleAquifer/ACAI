        "Consider Blessed",
        "Call Blessed"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To see someone as happy or lucky because of good things happening to them."
        }
      ]
    },
    "spa": {
      "preferred_label": "considerar dichoso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Considerar a alguien dichoso o afortunado debido a las cosas buenas que le suceden."
        }
      ]
    },
    "fra": {
      "preferred_label": "estimer heureux",
      "descriptions": [
        {
          "source": "acai",
          "description": "Considérer quelqu'un comme heureux ou béni en raison des bonnes choses qui lui arrivent."
        }
      ]
    },
    "ind": {
      "preferred_label": "menyebut berbahagia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memandang seseorang bahagia atau beruntung karena hal-hal baik yang terjadi pada mereka."
        }
      ]
    },
    "por": {
      "preferred_label": "considerar feliz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ver alguém como feliz ou afortunado por causa de coisas boas que lhe acontecem."
        }
      ]
    },
    "apd": {
      "preferred_label": "اعتبر سعيد",
      "descriptions": [
        {
          "source": "acai",
          "description": "رؤية الزول سعيد أو محظوظ عشان حاجات سمحة حصلت ليهو."
