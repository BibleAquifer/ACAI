  "localizations": {
    "eng": {
      "preferred_label": "Be Complete",
      "alternate_labels": [
        "Finished",
        "Show Oneself Blameless",
        "Complete",
        "Make Perfect"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To finish something fully and without any mistakes, showing that it is perfect and whole."
        }
      ]
    },
    "spa": {
      "preferred_label": "estar completo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Terminar algo completamente y sin falta alguna, mostrando que es perfecto y pleno."
        }
      ]
    },
    "fra": {
      "preferred_label": "être achevé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Achever quelque chose complètement et sans aucun défaut, montrant que cela est parfait et accompli."
        }
      ]
    },
    "ind": {
      "preferred_label": "selesai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyelesaikan sesuatu sepenuhnya dan tanpa kesalahan apa pun, menunjukkan bahwa hal itu sempurna dan utuh."
        }
      ]
    },
    "por": {
      "preferred_label": "estar completo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Terminar algo plenamente e sem falhas, mostrando que é perfeito e completo."
        }
      ]
    },
    "apd": {
      "preferred_label": "يكمل",
      "descriptions": [
        {
          "source": "acai",
          "description": "تتميم أو تكملة الحاجة للآخر ومن غير أي نقص، بحيث تظهر إنها كاملة وتامة."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَكْتَمِلُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "إِتْمامُ شَيْءٍ بِالكامِلِ ودونَ أَيِّ أخطاءٍ، مِمّا يُظهِرُ أَنَّهُ كامِلٌ وتامٌّ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Finis gud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong finisim evri samting fulwan we i no gat mastik, blong soemaot se hem i stret gud mo i komplit."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zama Cikakke",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kammala wani abu gaba ɗaya ba tare da wani kuskure ba, yana nuna cewa ya cika kuma ya zama cikakke."
        }
      ]
    },
    "hin": {
      "preferred_label": "पूर्ण होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी कार्य को बिना किसी त्रुटि के पूरी तरह समाप्त करना, यह दिखाते हुए कि वह सिद्ध और संपूर्ण है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Izuchazu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Imecha ihe nʼuju na nʼenweghị mmejọ ọ bụla, na-egosi na o zuru oke ma zuo ezu."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिद्ध हुनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरा त्रुटिरहित र पूर्ण रूपमा समाप्त गर्नु, जसले त्यो सिद्ध र सिङ्गो छ भनी देखाउँछ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Быть совершенным",
      "descriptions": [
        {
          "source": "acai",
          "description": "Завершать что-либо полностью и безошибочно, являя это совершенным и цельным."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kukamilika",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kukamilisha jambo kikamilifu na bila makosa yoyote, kuonyesha kwamba ni kamilifu na zima."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kamap olgeta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pinisim tru wanpela samting na i no gat wanpela rong o liklik hap i stap yet, i soim olsem em i gutpela tru na i kamap olgeta."
        }
      ]
    },
    "vie": {
      "preferred_label": "Trọn vẹn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hoàn tất một điều gì đó trọn vẹn và không tì vết, thể hiện sự hoàn hảo và toàn vẹn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "完全",
      "descriptions": [
        {
          "source": "acai",
          "description": "完全且毫无差错地完成某事，表明其完美与完整。"
        }
      ]
    },
    "zht": {
      "preferred_label": "得以完全",
      "descriptions": [
        {
          "source": "acai",
          "description": "完全且毫無瑕疵地完成某事，表明其完美而完整。"
        }
      ]
    }
  },
