{
  "id": "keyterm:Faultless",
  "primary_id": "keyterm:Blameless",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "88.317"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Faultless",
      "alternate_labels": [
        "Blameless",
        "Innocent"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Being without any mistakes or blame, pure and right in the eyes of God."
        }
      ]
    },
    "fra": {
      "preferred_label": "irréprochable",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait d'être sans faute ni reproche, pur et droit aux yeux de Dieu."
        }
      ]
    },
    "por": {
      "preferred_label": "irrepreensível",
      "descriptions": [
        {
          "source": "acai",
          "description": "Estar sem falhas ou culpa, puro e correto aos olhos de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "بلا لوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنك تكون بلا أي غلط أو لوم، ونقي ومستقيم في عيون الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "بلا لوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يكون المرء بلا عيب أو لوم، نقيًّا ومستقيمًا في عيني الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Stret gud we i no gat poen agens long hem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin we man i no gat wan mastik o fol, we i klin mo stret gud long fes blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Marar laifi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa ba tare da wani kuskure ko abin zargi ba, mai tsarki da kuma mai adalci a gaban Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "निर्दोष",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी भी गलती या दोष से रहित होना, परमेश्वर की दृष्टि में शुद्ध और खरा होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Enweghị ntụpọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye na-enweghị mmejọ maọbụ ụta ọbụla, dị ọcha ma zie ezi nʼanya Chineke."
        }
      ]
    },
    "ind": {
      "preferred_label": "tidak bercacat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tanpa kesalahan atau cela apa pun, murni dan benar di hadapan Allah."
        }
      ]
    },
    "nep": {
      "preferred_label": "दोषरहित",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै गल्ती वा दोषविना हुनु, परमेश्‍वरका नजरमा शुद्ध र ठीक हुनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Непорочный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Не имеющий ошибок или вины, чистый и праведный в глазах Бога."
        }
      ]
    },
    "spa": {
      "preferred_label": "intachable",
      "descriptions": [
        {
          "source": "acai",
          "description": "Estar libre de faltas o culpa, siendo puro y recto ante los ojos de Dios."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bila Lawama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa bila makosa yoyote au lawama, safi na mwenye haki machoni pa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "No gat asua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Stap nating long wanpela asua o rong, stap klin na stret long ai bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Không chỗ trách được",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không có bất kỳ sai sót hay điều gì đáng trách, thanh sạch và ngay thẳng trước mắt Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "无可指责",
      "descriptions": [
        {
          "source": "acai",
          "description": "毫无过错或无可指责，在上帝眼中纯洁而正直。"
        }
      ]
    },
    "zht": {
      "preferred_label": "無可指摘",
      "descriptions": [
        {
          "source": "acai",
          "description": "毫無瑕疵或過失，在上帝眼中純潔且正直。"
        }
      ]
    }
  },
  "referred_to_as": [
