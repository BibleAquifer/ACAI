    "vie": {
      "preferred_label": "Nắp thi ân",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nơi chốn hoặc cách thức mà sự tha thứ của Đức Chúa Trời được ban cho để che đậy tội lỗi."
        }
      ]
    },
    "zhs": {
      "preferred_label": "施恩座",
      "descriptions": [
        {
          "source": "acai",
          "description": "上帝施予赦免以遮盖罪恶的地方或方式。"
        }
      ]
    },
    "zht": {
      "preferred_label": "施恩座",
      "descriptions": [
        {
          "source": "acai",
          "description": "上帝賜下赦免以遮蓋罪孽的所在或方式。"
        }
      ]
    }
  },
