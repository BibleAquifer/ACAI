          "description": "The place or way where God’s forgiveness is given to cover sins."
        }
      ]
    },
    "spa": {
      "preferred_label": "propiciatorio",
      "descriptions": [
        {
          "source": "acai",
          "description": "El lugar o la forma en que se otorga el perdón de Dios para cubrir los pecados."
        }
      ]
    },
    "fra": {
      "preferred_label": "propitiatoire",
      "descriptions": [
        {
          "source": "acai",
