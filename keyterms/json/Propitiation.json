    "hau": {
      "preferred_label": "Murfin gafara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wuri ko hanyar da ake ba da gafara ta Allah domin a rufe zunubai."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रायश्चित का ढकना",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह स्थान या उपाय जहाँ पापों को ढाँपने के लिए परमेश्वर की क्षमा प्रदान की जाती है।"
        }
      ]
    },
    "ibo": {
