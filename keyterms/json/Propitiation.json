        }
      ]
    },
    "apd": {
      "preferred_label": "كرسي الرحمة",
      "descriptions": [
        {
          "source": "acai",
          "description": "المكان أو الطريقة البتتقدّم بيها مغفرة الله عشان تغطي الخطايا."
        }
      ]
    },
    "arb": {
      "preferred_label": "كرسي الرحمة",
      "descriptions": [
        {
          "source": "acai",
          "description": "المكان أو الوسيلة التي تُمنح بها مغفرة الله لستر الخطايا."
        }
      ]
    },
    "bis": {
      "preferred_label": "ples blong sore",
      "descriptions": [
        {
          "source": "acai",
