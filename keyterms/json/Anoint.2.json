      "descriptions": [
        {
          "source": "acai",
          "description": "To rub or smear oil or special substances on someone or something."
        }
      ]
    },
    "spa": {
      "preferred_label": "ungir (untar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Frotar o untar aceite o sustancias especiales sobre alguien o algo."
        }
      ]
    },
    "fra": {
      "preferred_label": "oindre (enduire)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Frotter ou étaler de l'huile ou des substances spéciales sur quelqu'un ou quelque chose."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengurapi (mengoles)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengoleskan atau melumurkan minyak atau zat khusus pada seseorang atau sesuatu."
        }
      ]
    },
    "por": {
      "preferred_label": "ungir (untar)",
      "alternate_labels": [
        "untar"
      ],
      "descriptions": [
