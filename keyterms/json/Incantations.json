      "preferred_label": "عزائم سحرية",
      "descriptions": [
        {
          "source": "acai",
          "description": "كلام سحر أو عزائم بيستعملوها عشان يحاولوا يتحكموا في الحاجات أو يغيروها."
        }
      ]
    },
    "arb": {
      "preferred_label": "رُقَى",
      "descriptions": [
        {
          "source": "acai",
          "description": "كَلِماتٌ أو تَعاوِيذُ سِحْرِيَّةٌ تُستَخدَمُ لِمُحاوَلَةِ التَّحَكُّمِ فِي الأُمورِ أو تَغْييرِها."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol spil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol majik tok no ol spil we man i stap yusum blong traem kontrolem no jenisim ol samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sihiri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kalaman sihiri ko asiri da ake amfani da su wajen ƙoƙarin sarrafawa ko sauya abubuwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "तंत्र-मंत्र",
      "descriptions": [
        {
          "source": "acai",
          "description": "चीजों को नियंत्रित करने या बदलने के प्रयास में प्रयुक्त जादुई शब्द या मंत्र।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mgbaasị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Okwu anwansi maọbụ nsụgharị okwu anwansi e ji agbalị ịchịkwa maọbụ gbanwee ihe."
        }
      ]
    },
    "nep": {
      "preferred_label": "तन्त्रमन्त्र",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुराहरूलाई नियन्त्रण गर्न वा बदल्न प्रयोग गरिने जादुई शब्दहरू वा मन्त्रहरू।"
        }
      ]
    },
    "rus": {
      "preferred_label": "заклинания",
      "descriptions": [
        {
          "source": "acai",
          "description": "Магические слова или заклинания, используемые в попытке управлять событиями или изменять вещи."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uaguzi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Maneno ya kigauni au ya kichawi yanayotumiwa kujaribu kudhibiti au kubadilisha mambo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Marila",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol tok bilong mekim marila o posin samting ol i save yusim bilong traim long bosim o senisim ol samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thần chú",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những lời ma thuật hoặc bùa chú dùng để cố gắng kiểm soát hoặc thay đổi mọi sự."
        }
      ]
    },
    "zhs": {
      "preferred_label": "符咒",
      "descriptions": [
        {
          "source": "acai",
          "description": "用来试图控制或改变事物的咒语或巫术言辞。"
        }
      ]
    },
    "zht": {
      "preferred_label": "符咒",
      "descriptions": [
        {
          "source": "acai",
          "description": "用來試圖控制或改變事物的咒語或法術。"
        }
      ]
    }
  },
