{
  "id": "keyterm:WayOfLife",
  "primary_id": "keyterm:TheWay",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "001719001005000",
    "001719001001000",
    "001719001003000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Way of Life",
      "alternate_labels": [
        "Way of God"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A life seen as a journey that focuses on how a person or God behaves and what is right or wrong."
        }
      ]
    },
    "fra": {
      "preferred_label": "voie",
      "descriptions": [
        {
          "source": "acai",
          "description": "La vie envisagée comme un cheminement axé sur la conduite d'une personne ou de Dieu et sur ce qui est juste ou mauvais."
        }
      ]
    },
    "ind": {
      "preferred_label": "jalan hidup",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kehidupan yang dipandang sebagai suatu perjalanan yang berfokus pada bagaimana seseorang atau Allah bertindak dan apa yang benar atau salah."
        }
      ]
    },
    "apd": {
      "preferred_label": "طريق الحياة",
      "descriptions": [
        {
          "source": "acai",
          "description": "الحياة كرحلة بتركّز على تصرف الزول أو تصرف الله وإيه هو الصاح أو الغلط."
        }
      ]
    },
    "arb": {
      "preferred_label": "طَرِيقُ الحَياةِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "الحَياةُ بِمَثابَةِ رِحْلَةٍ تُرَكِّزُ عَلى كَيْفِيَّةِ سُلوكِ الإِنْسانِ أَوِ اللهِ وما هُوَ صَوابٌ أَو خَطَأٌ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rod blong laef",
      "descriptions": [
        {
          "source": "acai",
          "description": "Laef we i olsem wan rod we i soemaot fasin we man no God i stap mekem mo wanem i stret mo wanem i rong."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tafarkin rayuwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rayuwa da ake ɗauka a matsayin tafiya mai mai da hankali a kan yadda mutum ko Allah yake aikatawa da kuma abin da yake daidai ko ba daidai ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "जीवन का मार्ग",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक यात्रा के रूप में देखा जाने वाला जीवन जो इस बात पर केंद्रित है कि कोई व्यक्ति या परमेश्वर कैसा व्यवहार करता है और क्या सही या गलत है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụzọ ndụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndụ a na-ele anya dịka njem nke na-elekwasị anya nʼotu mmadụ ma ọ bụ Chineke si akpa àgwà na ihe ziri ezi ma ọ bụ ihe na-ezighị ezi."
        }
      ]
    },
    "nep": {
      "preferred_label": "जीवनको मार्ग",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै व्यक्ति वा परमेश्‍वरको व्यवहार तथा के सही वा गलत छ भन्‍ने कुरामा केन्द्रित भई यात्राको रूपमा हेरिएको जीवन।"
        }
      ]
    },
    "por": {
      "preferred_label": "caminho de vida",
      "descriptions": [
        {
          "source": "acai",
          "description": "A vida vista como uma jornada que se concentra no comportamento de uma pessoa ou de Deus e no que é certo ou errado."
        }
      ]
    },
    "rus": {
      "preferred_label": "Жизненный путь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жизнь, рассматриваемая как путь, с точки зрения того, как ведет себя человек или Бог, и что есть добро или зло."
        }
      ]
    },
    "spa": {
      "preferred_label": "camino de vida",
      "descriptions": [
        {
          "source": "acai",
          "description": "La vida vista como un camino que se enfoca en cómo se comporta una persona o Dios y en lo que es correcto o incorrecto."
        }
      ]
    },
    "swh": {
      "preferred_label": "Njia ya maisha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Maisha yakionekana kama safari inayolenga jinsi mtu au Mungu anavyoenenda na kile kilicho chema au kibaya."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rot bilong laip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Laip ol i lukim olsem wanpela rot o wokabaut we i lukluk long pasin bilong wanpela man o bilong God na wanem samting i stret o i rong."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đường lối sống",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cuộc đời được nhìn như một hành trình, chú trọng vào cách một người hoặc Đức Chúa Trời hành xử và điều gì là đúng hoặc sai."
        }
      ]
    },
    "zhs": {
      "preferred_label": "道路",
      "descriptions": [
        {
          "source": "acai",
          "description": "被视为一段旅程的生命历程，重点在于人或上帝的行为举止以及何为对错。"
        }
      ]
    },
    "zht": {
      "preferred_label": "道路",
      "descriptions": [
        {
          "source": "acai",
          "description": "將生命視為一段旅程，聚焦於人或上帝的行為以及何為是非對錯。"
        }
      ]
    }
  },
  "referred_to_as": [
