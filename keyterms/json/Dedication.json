  "localizations": {
    "eng": {
      "preferred_label": "Dedication (Ceremony)",
      "alternate_labels": [
        "Dedication Offering"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A special ceremony that sets a building apart for God's use and honors Him."
        }
      ]
    },
    "fra": {
      "preferred_label": "dédicace (cérémonie)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une cérémonie particulière qui met un édifice à part pour l'usage de Dieu et qui lui rend hommage."
        }
      ]
    },
    "ind": {
      "preferred_label": "pentahbisan (upacara)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Upacara khusus yang mengkhususkan suatu bangunan bagi penggunaan Allah dan menghormati-Nya."
        }
      ]
    },
    "apd": {
      "preferred_label": "تدشين (احتفال)",
      "descriptions": [
        {
          "source": "acai",
          "description": "احتفال خاص بيفرز مبنى لاستخدام الله ويكرّمه."
        }
      ]
    },
    "arb": {
      "preferred_label": "تدشين (احتفال)",
      "descriptions": [
        {
          "source": "acai",
          "description": "احتفال خاص يخصص مبنى لاستخدام الله وإكرامه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Seremoni blong mekem i tabu (Seremoni)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan spesel lafet no seremoni we i putum wan bilding i stap wanples blong God nomo i yusum mo blong ona long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Keɓewa (Biki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Biki na musamman da yake keɓe gini domin amfanin Allah da kuma girmama Shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रतिष्ठा (समारोह)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक विशेष समारोह जो किसी भवन को परमेश्वर के उपयोग के लिए अलग करता है और उसका आदर करता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mmemme ido nsọ (Mmemme)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmemme pụrụ iche nke na-ewepụta ụlọ ma na-edo ya nsọ maka iji ya na-efe Chineke nakwa iji sọpụrụ Ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "समर्पण (समारोह)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै भवनलाई परमेश्‍वरको सेवाका निम्ति अलग गर्ने र उहाँलाई आदर गर्ने एउटा विशेष समारोह।"
        }
      ]
    },
    "por": {
      "preferred_label": "dedicação (cerimônia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cerimônia especial que separa um edifício para o uso de Deus e o honra."
        }
      ]
    },
    "rus": {
      "preferred_label": "Освящение (церемония)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особая церемония, посредством которой здание отделяется для Божьего служения и почитания Его."
        }
      ]
    },
    "spa": {
      "preferred_label": "dedicación (ceremonia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ceremonia especial que aparta un edificio para el uso de Dios y le rinde honor."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuweka Wakfu (Sherehe)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sherehe maalum inayotenga jengo kwa ajili ya matumizi ya Mungu na kumtukuza Yeye."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Bikpela bung bilong makim samting i bilong God (Lotu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela bung o lotu bilong makim wanpela haus i bilong God tasol na bilong givim biknem long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ cung hiến (Nghi lễ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nghi lễ đặc biệt nhằm biệt riêng một công trình cho Đức Chúa Trời sử dụng và tôn vinh Ngài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "奉献礼 (仪式)",
      "descriptions": [
        {
          "source": "acai",
          "description": "将一座建筑物分别出来归上帝使用并尊崇祂的特别仪式。"
        }
      ]
    },
    "zht": {
      "preferred_label": "奉獻禮（儀式）",
      "descriptions": [
        {
          "source": "acai",
          "description": "將建築物分別為聖歸給上帝使用並尊崇祂的特別儀式。"
        }
      ]
    }
  },
