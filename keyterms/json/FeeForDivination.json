      "descriptions": [
        {
          "source": "acai",
          "description": "Ce qui est donné à une personne qui prédit l'avenir en paiement de ses services."
        }
      ]
    },
    "ind": {
      "preferred_label": "upah penenung",
      "descriptions": [
        {
