          "description": "Sesuatu yang diberikan kepada seseorang yang meramal masa depan sebagai upah atas jasanya."
        }
      ]
    },
    "apd": {
      "preferred_label": "أجرة العِرافة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة بتتدفع للشخص البيتنباً بالمستقبل كأجرة على خدمتو."
        }
      ]
    },
    "arb": {
      "preferred_label": "حلوان عرافة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ما يُعطى لمن يتكهن بالمستقبل كأجر على خدمته (حلوان العرافة)."
        }
      ]
    },
    "bis": {
      "preferred_label": "pei blong kleva",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting we oli givim long wan man we i stap talemaot fiuja olsem pei blong wok blong hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ladan duba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da ake ba mutumin da yake duba ko bayyana gaibi a matsayin ladan aikinsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "भावी कहने का मेहनताना",
      "descriptions": [
        {
          "source": "acai",
          "description": "भविष्य बताने वाले किसी व्यक्ति को उसकी सेवा के बदले दी जाने वाली भेंट या पारिश्रमिक।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụgwọ ịgba afa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe a na-enye onye na-agba afa ma ọ bụ na-ebu amụma ọdịnihu dị ka ụgwọ maka ọrụ ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "जोखनाको दस्तुर",
      "descriptions": [
        {
          "source": "acai",
          "description": "भविष्य बताउने व्यक्तिलाई उसको सेवाको भुक्तानीको रूपमा दिइने वस्तु वा दस्तुर।"
        }
      ]
    },
    "por": {
      "preferred_label": "Paga de adivinhação",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo dado a uma pessoa que prediz o futuro como pagamento por seu serviço."
        }
      ]
    },
    "rus": {
      "preferred_label": "Плата за гадание",
      "descriptions": [
        {
          "source": "acai",
          "description": "Плата, отдаваемая предсказателю будущего за его услугу."
        }
      ]
    },
    "spa": {
      "preferred_label": "paga de adivinación",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo que se entrega a una persona que predice el futuro como pago por su servicio."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ujira wa uaguzi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu kinachotolewa kwa mtu anayetabiri mambo yajayo kama malipo ya huduma yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pe bilong mekim pasin bilong glasman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting ol i givim long man i save tokaut long ol samting bai kamap bihain (glasman) olsem pe bilong wok bilong en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tiền bói toán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Khoản được trao cho người bói toán tương lai như tiền công cho việc làm của họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "占卜的卦金",
      "descriptions": [
        {
          "source": "acai",
          "description": "作为预卜未来者的酬劳而付给其的服务报酬。"
        }
      ]
    },
    "zht": {
      "preferred_label": "占卜的卦金",
      "descriptions": [
        {
          "source": "acai",
          "description": "付給預言未來者作為其服務報酬的物品或錢財。"
        }
      ]
    }
  },
