  ],
  "localizations": {
    "eng": {
      "preferred_label": "Consecration (Dedication)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Giving yourself fully to serve and be loyal to God."
        }
      ]
    },
    "spa": {
      "preferred_label": "consagración (dedicación)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Entregarse por completo para servir a Dios y serle fiel."
        }
      ]
    },
    "fra": {
      "preferred_label": "consécration (dédicace)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Se donner entièrement pour servir Dieu et lui être fidèle."
        }
      ]
    },
    "ind": {
      "preferred_label": "pengudusan (penyerahan diri)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyerahkan diri sepenuhnya untuk melayani dan setia kepada Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "consagração (dedicação)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Entregar-se plenamente para servir a Deus e ser leal a Ele."
        }
      ]
    },
    "apd": {
      "preferred_label": "تقديس (تكريس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الزول يسلّم نفسه بالكامل عشان يخدم الله ويكون مخلص ليه."
        }
      ]
    },
    "arb": {
      "preferred_label": "تكريس (تخصيص)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بذل المرء نفسه بالكامل لخدمة الله والولاء له."
        }
      ]
    },
    "bis": {
      "preferred_label": "kam tabu (givim yu wan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin we man i givim hem fulwan blong mekem wok blong God mo stap tru long Hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Keɓe kai (Bada kai)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bada kai gabaki ɗaya domin bauta da kuma yin biyayya ga Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "समर्पण (पवित्रीकरण)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर की सेवा करने और उनके प्रति वफादार रहने के लिए स्वयं को पूरी तरह समर्पित करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ido nsọ (Nraranye)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inyefe onwe gị kpamkpam ijere Chineke ozi na ikwesị ntụkwasị obi n'ebe Ọ nọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "समर्पण (प्रतिष्ठा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको सेवा गर्न र उहाँप्रति वफादार हुन आफूलाई पूर्ण रूपमा दिनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "посвящение (преданность)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Полная отдача себя служению и верности Богу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Utakaso (Kujitolea)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kujitoa kikamilifu ili kumtumikia na kuwa mwaminifu kwa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kamap holi (Givim bel olgeta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong givim yu yet olgeta bilong mekim wok bilong God na stap aninit long em tasol."
        }
      ]
    },
    "vie": {
      "preferred_label": "sự biệt riêng (dâng hiến)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dâng trọn chính mình để phục vụ và trung thành với Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "奉献 (献身)",
      "descriptions": [
        {
          "source": "acai",
          "description": "将自己完全献上，以忠心侍奉上帝。"
        }
      ]
    },
    "zht": {
      "preferred_label": "奉獻 (獻身)",
      "descriptions": [
        {
          "source": "acai",
          "description": "將自己完全獻上，事奉並忠於上帝。"
        }
      ]
    }
  },
