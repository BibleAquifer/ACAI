        }
      ]
    },
    "hin": {
      "preferred_label": "सुरक्षा (अवस्था)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसी स्थिति जिसमें आप स्वयं को सुरक्षित महसूस करते हैं और आपको विश्वास होता है कि आपको कोई हानि नहीं पहुँचेगी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nchekwa (Ọnọdụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọnọdụ ebe mmadụ na-enwe nchebe na obi ike na ọ dịghị ihe ọjọọ ga-eme ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "सुरक्षा (अवस्था)",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफू सुरक्षित रहेको र कुनै हानि आउनेछैन भनी ढुक्क महसुस हुने अवस्था।"
        }
      ]
    },
    "por": {
      "preferred_label": "segurança (estado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma condição em que a pessoa se sente segura e confiante de que nenhum mal lhe acontecerá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Безопасность (состояние)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Состояние, в котором вы чувствуете себя защищенным и уверенным, что вам не причинят вреда."
        }
      ]
    },
    "swh": {
      "preferred_label": "Usalama (Hali)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hali ambayo unajisikia salama na mwenye uhakika kwamba hakuna madhara yatakayokupata."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Stap gut na i no ken pret (Sindaun)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sindaun we yu pilim olsem yu stap gut tru na yu bilip strong olsem i no gat wanpela samting bai i bagarapim yu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự an toàn (tình trạng)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tình trạng cảm thấy an toàn và tin chắc rằng sẽ không có điều tai hại nào xảy đến cho mình."
        }
      ]
    },
    "zhs": {
      "preferred_label": "安全 (状态)",
