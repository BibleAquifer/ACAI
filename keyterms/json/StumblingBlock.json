  "localizations": {
    "eng": {
      "preferred_label": "Stumbling Block (Figurative)",
      "alternate_labels": [
        "Temptation to Sin",
        "Offenses",
        "Offensive Thing"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Something or someone that leads a person to sin or causes others to be upset."
        }
      ]
    },
    "spa": {
      "preferred_label": "piedra de tropiezo (sentido figurado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo o alguien que induce a pecar a una persona o que causa disgusto o aflicción a otros."
        }
      ]
    },
    "fra": {
      "preferred_label": "pierre d'achoppement (figuré)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chose ou personne qui conduit quelqu'un au péché ou cause du scandale chez autrui."
        }
      ]
    },
    "ind": {
      "preferred_label": "batu sandungan (kiasan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sesuatu atau seseorang yang menuntun orang berbuat dosa atau menyebabkan orang lain tersandung/kesal."
        }
      ]
    },
    "por": {
      "preferred_label": "pedra de tropeço (figurativo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo ou alguém que leva uma pessoa a pecar ou faz outros ficarem indignados ou angustiados."
        }
      ]
    },
    "apd": {
      "preferred_label": "حجر عثرة (مجازي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة أو زول بيقود الزول للخطية أو بيسبب الزعل للآخرين."
        }
      ]
    },
    "arb": {
      "preferred_label": "معثرة (مجازي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "شيء أو شخص يقود الإنسان إلى الخطيئة أو يسبب الانزعاج للآخرين."
        }
      ]
    },
    "bis": {
      "preferred_label": "samting we i mekem man i stambol (pija tok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting no wan man we i lidim narafala man i go long sin no i mekem ol narafala man oli harem nogud."
        }
      ]
    },
    "hau": {
      "preferred_label": "Abin sa tuntuɓe (A siffance)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu ko wani wanda yake sa mutum ya yi zunubi ko kuma ya ɓata wa wasu rai."
        }
      ]
    },
    "hin": {
      "preferred_label": "ठोकर का कारण (लाक्षणिक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसी कोई वस्तु या व्यक्ति जो किसी को पाप की ओर ले जाए या दूसरों के परेशान होने का कारण बने।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe ịsụ ngọngọ (N'ụzọ atụmatụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe ma ọ bụ onye na-eduga mmadụ nʼime mmehie ma ọ bụ na-eme ka ndị ọzọ iwe wee ma ọ bụ daa mbà."
        }
      ]
    },
    "nep": {
      "preferred_label": "ठेसको कारण (लाक्षणिक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरा वा व्यक्ति जसले कसैलाई पाप गर्न डोऱ्याउँछ वा अरूलाई व्याकुल तुल्याउँछ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Камень преткновения (в переносном значении)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Что-то или кто-то, вводящий человека во грех или вызывающий огорчение у других."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kikwazo (Kijazanda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu au mtu anayemwongoza mtu kutenda dhambi au kuwafanya wengine wakasirike au kukwazika."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Samting bilong sutim lek (Tok piksa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting o wanpela man i save pulim man long mekim sin o mekim ol arapela i bel hevi."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cớ vấp phạm (Nghĩa bóng)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Điều gì đó hoặc ai đó dẫn dụ một người phạm tội hoặc khiến người khác khó chịu, tổn thương."
        }
      ]
    },
    "zhs": {
      "preferred_label": "绊脚石 (比喻)",
      "descriptions": [
        {
          "source": "acai",
          "description": "引人犯罪或使人跌倒、不安的人或事物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "絆腳石（比喻）",
      "descriptions": [
        {
          "source": "acai",
          "description": "引誘人犯罪或使人跌倒不安的事物或人。"
        }
      ]
    }
  },
