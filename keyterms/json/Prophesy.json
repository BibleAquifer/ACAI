{
  "id": "keyterm:Prophesy",
  "primary_id": "keyterm:Speak",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "33.459"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "To Prophesy",
      "descriptions": [
        {
          "source": "acai",
          "description": "To speak messages from God, sometimes about what will happen in the future."
        }
      ]
    },
    "spa": {
      "preferred_label": "profetizar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Comunicar mensajes de parte de Dios, a veces acerca de lo que sucederá en el futuro."
        }
      ]
    },
    "fra": {
      "preferred_label": "prophétiser",
      "descriptions": [
        {
          "source": "acai",
          "description": "Transmettre des messages de la part de Dieu, parfois au sujet de ce qui se produira dans l'avenir."
        }
      ]
    },
    "ind": {
      "preferred_label": "bernubuat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyampaikan pesan-pesan dari Allah, terkadang tentang apa yang akan terjadi di masa depan."
        }
      ]
    },
    "por": {
      "preferred_label": "profetizar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Falar mensagens da parte de Deus, às vezes sobre o que acontecerá no futuro."
        }
      ]
    },
    "apd": {
      "preferred_label": "يتنبأ",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنو زول يقول رسائل من الله، وأحياناً عن الحاجات الحاتحصل في المستقبل."
        }
      ]
    },
    "arb": {
      "preferred_label": "تنبأ",
      "descriptions": [
        {
          "source": "acai",
          "description": "إعلان رسائل من الله، وتكون أحيانًا عما سيحدث في المستقبل."
        }
      ]
    },
    "bis": {
      "preferred_label": "talemaot tok we God i givim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong talemaot ol tok we i kamaot long God, we sam samtaem i tokbaot wanem we bambae i hapen long fiuja."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin annabci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin magana da saƙonni daga Allah, a wasu lokuta game da abin da zai faru a gaba."
        }
      ]
    },
    "hin": {
      "preferred_label": "भविष्यद्वाणी करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर की ओर से संदेश देना, कभी-कभी भविष्य में क्या होगा इस बारे में बताना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ibu amụma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikwupụta ozi si nʼaka Chineke, mgbe ụfọdụ gbasara ihe ga-eme nʼọdịnihu."
        }
      ]
    },
    "nep": {
      "preferred_label": "अगमवाणी गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरबाट आएका सन्देशहरू बोल्नु, कहिलेकाहीँ भविष्यमा के हुनेछ भन्‍ने विषयमा।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Пророчествовать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Возвещать вести от Бога, иногда о том, что произойдет в будущем."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutabiri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kusema jumbe kutoka kwa Mungu, wakati mwingine kuhusu kile kitakachotokea wakati ujao."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim tok profet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long autim ol tok i kam long God, sampela taim em ol tok bilong ol samting bai kamap bihain."
        }
      ]
    },
    "vie": {
      "preferred_label": "Nói tiên tri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nói ra những thông điệp từ Đức Chúa Trời, đôi khi nói về những điều sẽ xảy ra trong tương lai."
        }
      ]
    },
    "zhs": {
      "preferred_label": "说预言",
      "descriptions": [
        {
          "source": "acai",
          "description": "传讲从上帝而来的信息，有时涉及未来将要发生的事。"
        }
      ]
    },
    "zht": {
      "preferred_label": "說預言",
      "descriptions": [
        {
          "source": "acai",
          "description": "傳達來自上帝的信息，有時是關於未來將要發生的事。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Speak"
  ],
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
