        }
      ]
    },
    "por": {
      "preferred_label": "participar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Participar de algo em comum, como comida ou fazer parte de um grupo."
        }
      ]
    },
    "apd": {
      "preferred_label": "يشترك",
      "descriptions": [
        {
          "source": "acai",
          "description": "تشترك في تقاسم حاجة، زي الأكل أو إنك تكون جزء من مجموعة."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَشْتَرِك",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱلْمُشَارَكَةُ فِي شَيْءٍ، كَٱلطَّعَامِ أَوْ كَوْنِ ٱلْمَرْءِ جُزْءًا مِنْ جَمَاعَةٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "joen blong serem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong joen blong seremaot wan samting, olsem kakae no blong kam haf blong wan grup."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ci tarayya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Haɗa hannu wajen cin moriyar wani abu, kamar abinci ko kuma kasancewa cikin wani rukuni."
        }
      ]
    },
    "hin": {
      "preferred_label": "भागी होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी चीज़ को साझा करने में शामिल होना, जैसे भोजन करना या किसी समूह का हिस्सा बनना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "iketa oke",
      "descriptions": [
        {
          "source": "acai",
          "description": "Isonye nʼikekọta ihe, dịka nri ma ọ bụ ịbụ akụkụ nke otu ìgwè mmadụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "सहभागी हुनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरामा सहभागी हुनु, जस्तै भोजन बाँड्नु वा समूहको भाग हुनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "причащаться",
      "descriptions": [
        {
          "source": "acai",
          "description": "Участие в разделении чего-либо с другими, например пищи, или сопричастность группе."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kushiriki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kushiriki katika kupokea au kugawa kitu, kama vile chakula au kuwa sehemu ya kundi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kaikai wantaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kisim hap bilong wanpela samting o bung wantaim narapela long serem samting, olsem kaikai o stap insait long wanpela grup."
        }
      ]
    },
    "vie": {
      "preferred_label": "Dự phần",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cùng chung phần vào một điều gì đó, như thức ăn hoặc cùng là một phần của một nhóm."
        }
      ]
    },
    "zhs": {
      "preferred_label": "同享",
      "descriptions": [
        {
          "source": "acai",
          "description": "指共同分享某物，例如食物或加入一个群体。"
        }
      ]
    },
    "zht": {
      "preferred_label": "分受",
      "descriptions": [
        {
          "source": "acai",
          "description": "一同分享或領受某事物，例如食物或成為群體的一部分。"
        }
      ]
    }
  },
