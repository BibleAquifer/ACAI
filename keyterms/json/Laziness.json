{
  "id": "keyterm:Laziness",
  "primary_id": "keyterm:Deceit",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "006823001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Laziness",
      "alternate_labels": [
        "Slackness",
        "Sluggish Behaviour"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Not wanting to work or make an effort; being slow or careless in doing tasks."
        }
      ]
    },
    "spa": {
      "preferred_label": "pereza",
      "descriptions": [
        {
          "source": "acai",
          "description": "No querer trabajar ni esforzarse; ser lento o descuidado al realizar las tareas."
        }
      ]
    },
    "fra": {
      "preferred_label": "paresse",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait de ne pas vouloir travailler ou faire d'effort ; lenteur ou négligence dans l'accomplissement des tâches."
        }
      ]
    },
    "ind": {
      "preferred_label": "kemalasan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak mau bekerja atau berusaha; lamban atau lalai dalam mengerjakan tugas."
        }
      ]
    },
    "por": {
      "preferred_label": "preguiça",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não querer trabalhar ou se esforçar; ser lento ou descuidado na realização de tarefas."
        }
      ]
    },
    "apd": {
      "preferred_label": "كسل",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم الرغبة في الشغل أو بذل مجهود؛ والتراخي أو الإهمال في عمل الواجبات."
        }
      ]
    },
    "arb": {
      "preferred_label": "كَسَل",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم الرغبة في العمل أو بذل الجَهد، والتكاسل أو الإهمال في إنجاز المهمّات."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin blong les",
      "descriptions": [
        {
          "source": "acai",
          "description": "No wantem wok no mekem efot; slou no slak blong mekem ol wok."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ragwanci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin son yin aiki ko ƙoƙari; zama mai saƙaci ko sanyi wajen gudanar da ayyuka."
        }
      ]
    },
    "hin": {
      "preferred_label": "आलस्य",
      "descriptions": [
        {
          "source": "acai",
          "description": "काम करने या प्रयास करने की इच्छा न होना; कार्यों को करने में धीमा या लापरवाह होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Umengwụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Achọghị ịrụ ọrụ ma ọ bụ ịgba mbọ; ịdị nwayọọ ma ọ bụ ịkpachapụghị anya nʼịrụ ọrụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "अल्छीपना",
      "descriptions": [
        {
          "source": "acai",
          "description": "काम गर्न वा प्रयास गर्न नचाहने; कामहरू गर्दा ढिलासुस्ती गर्ने वा लापरबाही गर्ने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Лень",
      "descriptions": [
        {
          "source": "acai",
          "description": "Нежелание трудиться или прилагать усилия; медлительность или небрежность в выполнении дел."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uvivu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutotaka kufanya kazi au kujitahidi; kuwa mzito au mzembe katika kufanya kazi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin les",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong i no laik wok o hatwok; mekim ol wok slo tumas o nating nating."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự lười biếng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không muốn làm việc hoặc nỗ lực; chậm chạp hoặc cẩu thả khi làm công việc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "懒惰",
      "descriptions": [
        {
          "source": "acai",
          "description": "不想做工或付出努力；做任务时行动缓慢或敷衍怠惰。"
        }
      ]
    },
    "zht": {
      "preferred_label": "懶惰",
      "descriptions": [
        {
          "source": "acai",
          "description": "不想工作或付出努力；在執行事務上遲緩或敷衍。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Deceit"
  ],
