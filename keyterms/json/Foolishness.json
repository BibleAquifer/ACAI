{
  "id": "keyterm:Foolishness",
  "primary_id": "keyterm:Foolish",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "000192001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Foolishness",
      "alternate_labels": [
        "Folly"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Being unwise by not respecting God, ignoring advice, talking too much, and losing control of your temper."
        }
      ]
    },
    "spa": {
      "preferred_label": "necedad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Falta de sabiduría demostrada al no respetar a Dios, ignorar los consejos, hablar demasiado y no poder controlar el enojo."
        }
      ]
    },
    "fra": {
      "preferred_label": "folie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait de manquer de sagesse en ne respectant pas Dieu, en ignorant les conseils, en parlant trop et en perdant la maîtrise de soi."
        }
      ]
    },
    "ind": {
      "preferred_label": "kebodohan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bersikap tidak bijak dengan tidak menghormati Allah, mengabaikan nasihat, terlalu banyak bicara, dan tidak mampu mengendalikan amarah."
        }
      ]
    },
    "apd": {
      "preferred_label": "غباء",
      "descriptions": [
        {
          "source": "acai",
          "description": "قلة الحكمة بعدم احترام الله، وتجاهل النصيحة، والكلام الكتير، وفقدان السيطرة على الغضب."
        }
      ]
    },
    "arb": {
      "preferred_label": "حماقة",
      "descriptions": [
        {
          "source": "acai",
          "description": "التصرف بغير حكمة من خلال عدم احترام الله، وتجاهل المشورة، والإكثار من الكلام، وفقدان السيطرة على الغضب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Krangke fasin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong no gat waes, we man i no rispektem God, i no wantem harem advaes, i toktok tumas, mo i no save blokem kros blong hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Wauta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin hikima ta wurin rashin girmama Allah, share shawara, yawan surutu, da kasa kame fushi."
        }
      ]
    },
    "hin": {
      "preferred_label": "मूर्खता",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर का आदर न करके, सलाह की उपेक्षा करके, बहुत अधिक बोलकर, और अपने क्रोध पर नियंत्रण खोकर निर्बुद्धि होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Enweghị uche",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye na-enweghị amamihe site n'enweghị nkwanye ùgwù nye Chineke, ileghara ndụmọdụ anya, ikwu okwu nke ukwuu, na enweghị njide onwe n'iwe."
        }
      ]
    },
    "nep": {
      "preferred_label": "मूर्खता",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको आदर नगरेर, सल्लाहलाई बेवास्ता गरेर, धेरै बोलेर, र आफ्नो रिस नियन्त्रण बाहिर पुर्‍याएर निर्बुद्धि हुनु।"
        }
      ]
    },
    "por": {
      "preferred_label": "insensatez",
      "descriptions": [
        {
          "source": "acai",
          "description": "Agir sem sabedoria por não respeitar a Deus, ignorar conselhos, falar demais e perder o controle das próprias emoções."
        }
      ]
    },
    "rus": {
      "preferred_label": "Глупость",
      "descriptions": [
        {
          "source": "acai",
          "description": "Неразумие, проявляющееся в неуважении к Богу, пренебрежении советами, многословии и неспособности сдерживать гнев."
        }
      ]
    },
    "swh": {
      "preferred_label": "Upumbavu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa bila hekima kwa kutomheshimu Mungu, kupuuza mashauri, kuongea kupita kiasi, na kushindwa kuzuia hasira yako."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự điên rồ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sự thiếu khôn ngoan do không tôn kính Đức Chúa Trời, phớt lờ lời khuyên bảo, nói quá nhiều và mất kiểm soát sự nóng giận."
        }
      ]
    },
    "zhs": {
      "preferred_label": "愚昧",
      "descriptions": [
        {
          "source": "acai",
          "description": "因不敬畏上帝、忽视劝告、言语过多以及无法控制脾气而显得不明智。"
        }
      ]
    },
    "zht": {
      "preferred_label": "愚妄",
      "descriptions": [
        {
          "source": "acai",
          "description": "因不敬畏上帝、不聽勸告、多言多語以及無法控制自己的脾氣而顯得不明智。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Foolish"
  ],
