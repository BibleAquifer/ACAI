  "localizations": {
    "eng": {
      "preferred_label": "Deceit (Covert)",
      "alternate_labels": [
        "Betrayal"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Hiding the truth or lying to someone in a secret way to harm or betray them."
        }
      ]
    },
    "fra": {
      "preferred_label": "tromperie (secrète)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cacher la vérité ou mentir à quelqu'un de façon secrète pour lui nuire ou le trahir."
        }
      ]
    },
    "ind": {
      "preferred_label": "tipu daya (sembunyi-sembunyi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyembunyikan kebenaran atau membohongi seseorang secara diam-diam untuk mencelakakan atau mengkhianati mereka."
        }
      ]
    },
    "apd": {
      "preferred_label": "خداع (بالدس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "دس الحقيقة أو الكضب على زول بالدس عشان يضروه أو يخونوه."
        }
      ]
    },
    "arb": {
      "preferred_label": "غِشّ (خفي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إخفاء الحقيقة أو الكذب على شخص بطريقة سرية لإيذائه أو خيانته."
        }
      ]
    },
    "bis": {
      "preferred_label": "Trik (Fasin haed)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong haedem trutok no giaman long man long fasin haed blong spolem hem no mekem nogud long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ruɗu (A Asirce)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɓoye gaskiya ko yi wa wani ƙarya a asirce domin a cutar da shi ko a ci amanarsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "कपट (गुप्त)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी को हानि पहुँचाने या विश्वासघात करने के लिए गुप्त रीति से सच छिपाना या झूठ बोलना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aghụghọ (Na Nzuzo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Izobe eziokwu maọbụ ịgwa mmadụ okwu ụgha na nzuzo iji merụọ ya ahụ maọbụ raara ya nye."
        }
      ]
    },
    "nep": {
      "preferred_label": "छलकपट (गुप्त)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई हानि पुऱ्याउन वा धोका दिन गुप्त रूपमा सत्य लुकाउने वा झुट बोल्ने काम।"
        }
      ]
    },
    "por": {
      "preferred_label": "engano (dissimulação)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ocultar a verdade ou mentir para alguém de maneira secreta a fim de prejudicá-lo ou traí-lo."
        }
      ]
    },
    "rus": {
      "preferred_label": "коварство (тайное)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Скрытие правды или тайный обман кого-либо с целью причинить вред или предать."
        }
      ]
    },
    "spa": {
      "preferred_label": "engaño (encubierto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ocultar la verdad o mentir a alguien de manera encubierta para perjudicarlo o traicionarlo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hila (Siri)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuficha ukweli au kumwambia mtu uongo kwa njia ya siri ili kumdhuru au kumsaliti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin giaman (Pasin hait)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Haitim tok i tru o tok giaman long narapela man long pasin hait bilong bagarapim em o givim baksait long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lừa dối (Lén lút)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Che giấu sự thật hoặc nói dối ai đó một cách lén lút nhằm làm hại hoặc phản bội họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "诡诈（暗中）",
      "descriptions": [
        {
          "source": "acai",
          "description": "为了伤害或背叛某人，而暗中隐瞒真相或对其说谎。"
        }
      ]
    },
    "zht": {
      "preferred_label": "詭詐 (隱秘)",
      "descriptions": [
        {
          "source": "acai",
          "description": "隱瞞真相或以隱秘的方式向人說謊，以傷害或背叛對方。"
        }
      ]
    }
  },
