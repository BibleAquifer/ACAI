  "localizations": {
    "eng": {
      "preferred_label": "Praise (Respect)",
      "alternate_labels": [
        "Honor",
        "Respect"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To show respect and honor by speaking well of someone or something."
        }
      ]
    },
    "fra": {
      "preferred_label": "louange (respect)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Témoigner du respect et de l'honneur en disant du bien de quelqu'un ou de quelque chose."
        }
      ]
    },
    "ind": {
      "preferred_label": "pujian (hormat)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menunjukkan rasa hormat dan kehormatan dengan memuji seseorang atau sesuatu."
        }
      ]
    },
    "por": {
      "preferred_label": "glória (respeito)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demonstrar respeito e honra ao falar bem de alguém ou de algo."
        }
      ]
    },
    "apd": {
      "preferred_label": "مدح (احترام)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار الاحترام والإكرام بالكلام الكويس عن زول أو شي."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَجْد (إِكْرَام)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار الاحترام والإكرام بمدح شخص أو شيء وحسن الثناء عليه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Presem (Ona)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong soemaot respek mo ona long rod blong toktok gud long saed blong wan man no wan samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yabo (girmamawa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna girmamawa da girma ta wurin faɗar alheri game da wani ko wani abu."
        }
      ]
    },
    "hin": {
      "preferred_label": "आदर (महिमा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या वस्तु के विषय में अच्छी बातें कहकर आदर और सम्मान प्रकट करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Otuto (Nsọpụrụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosipụta nkwanye ùgwù na nsọpụrụ site nʼikwu okwu ọma banyere mmadụ ma ọ bụ ihe."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रशंसा (आदर)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैको वा कुनै कुराको बारेमा राम्रो बोलेर आदर र सम्मान देखाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Хвала (слава)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Оказывать почтение и уважение, отзываясь с похвалой о ком-либо или чем-либо."
        }
      ]
    },
    "spa": {
      "preferred_label": "alabanza (respeto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mostrar respeto y honra hablando bien de alguien o de algo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusifu (Heshima)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuonyesha heshima na utukufu kwa kusema vizuri juu ya mtu au kitu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Litimapim Nem (Rispek)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Soim rispek na ona long rot bilong toknogut i no stap, tasol toktok gut long wanpela man o samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Khen ngợi (tôn trọng)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bày tỏ sự tôn kính và danh dự bằng cách khen ngợi ai đó hoặc điều gì đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赞誉 (尊重)",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过称赞某人或某事来表达敬意与尊荣。"
        }
      ]
    },
    "zht": {
      "preferred_label": "稱讚（尊榮）",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由稱讚某人或某事來表達尊重與尊榮。"
        }
      ]
    }
  },
