  "localizations": {
    "eng": {
      "preferred_label": "Double, Tongued",
      "alternate_labels": [
        "Double-Tongued",
        "Hypocritical"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Saying one thing but doing something different, showing a false or fake attitude."
        }
      ]
    },
    "spa": {
      "preferred_label": "de doble ánimo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Decir una cosa pero hacer otra diferente, mostrando una actitud falsa o fingida."
        }
      ]
    },
    "fra": {
      "preferred_label": "fourbe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait de dire une chose et d’en faire une autre, manifestant une attitude hypocrite ou trompeuse."
        }
      ]
    },
    "ind": {
      "preferred_label": "bercabang lidah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengatakan satu hal tetapi melakukan hal yang berbeda, menunjukkan sikap yang palsu atau berpura-pura."
        }
      ]
    },
    "por": {
      "preferred_label": "de língua dobre",
      "alternate_labels": [
        "(literalmente"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Dizer uma coisa mas fazer algo diferente, demonstrando uma atitude falsa ou fingida."
        }
      ]
    },
    "apd": {
      "preferred_label": "أبو لسانين",
      "descriptions": [
        {
          "source": "acai",
          "description": "تقول حاجة وتسوي حاجة تانية، وتبيّن موقف كضّاب أو مزيف."
        }
      ]
    },
    "arb": {
      "preferred_label": "ذو لسانين",
      "descriptions": [
        {
          "source": "acai",
          "description": "قول شيء وفعل شيء آخر مختلف، مما يُظهر موقفًا زائفًا أو مرائيًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong gat tu tang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong talem wan samting be mekem narafala samting, we i soemaot wan giaman fasin."
        }
      ]
    },
    "hau": {
      "preferred_label": "Harshe biyu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faɗin wani abu amma kuma a aikata wani daban, yana nuna halin riya ko rashin gaskiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "दोमुंहापन",
      "descriptions": [
        {
          "source": "acai",
          "description": "कहना कुछ और करना कुछ और, जिससे झूठा या कपटी स्वभाव प्रकट होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ire abụọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikwu otu ihe ma na-eme ihe ọzọ dị iche, na-egosi àgwà ihu abụọ ma ọ bụ aghụghọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "दुईजिब्रे",
      "descriptions": [
        {
          "source": "acai",
          "description": "एउटा कुरा भन्‍ने तर अर्कै कुरा गर्ने, जसले झूटो वा कपटी मनोवृत्ति देखाउँछ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Двуязычный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Когда говорят одно, а делают другое, проявляя ложное или притворное отношение."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kauli Mbili",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kusema jambo moja lakini kufanya tofauti, kuonyesha mtazamo wa unafiki au uongo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tupela maus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong toktok narapela kain na bihain mekim narapela kain, na soim pasin bilong giaman o tupela maus."
        }
      ]
    },
    "vie": {
      "preferred_label": "Nói hai lời",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nói một đằng làm một nẻo, thể hiện thái độ giả dối hoặc hai lòng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "口是心非",
      "descriptions": [
        {
          "source": "acai",
          "description": "言行不一，显出虚假或做作的态度。"
        }
      ]
    },
    "zht": {
      "preferred_label": "一口兩舌",
      "descriptions": [
        {
          "source": "acai",
          "description": "言行不一，表現出虛假或裝假之態。"
        }
      ]
    }
  },
