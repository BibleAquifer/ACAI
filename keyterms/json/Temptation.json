  "localizations": {
    "eng": {
      "preferred_label": "Temptation",
      "descriptions": [
        {
          "source": "acai",
          "description": "A situation where someone is encouraged to do wrong or disobey God."
        }
      ]
    },
    "spa": {
      "preferred_label": "tentación",
      "descriptions": [
        {
          "source": "acai",
          "description": "Situación en la que se incita a alguien a hacer lo malo o a desobedecer a Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "tentation",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une situation où quelqu'un est incité à faire le mal ou à désobéir à Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "pencobaan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suatu situasi ketika seseorang didorong untuk berbuat salah atau tidak menaati Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "tentação",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma situação em que alguém é incentivado a praticar o mal ou desobedecer a Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "تجربة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حالة بكون فيها الزول مُشجَّع عشان يعمل الغلط أو يعصى الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَجْرِبَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "موقف يُشجَّع فيه المرء على فعل الخطإ أو عصيان الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "samting we i stap traem man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan situesen we oli traem pusum wan man blong mekem rong no blong no obei long God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Jarraba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani yanayi inda ake ƙarfafa wani ya aikata mugunta ko kuma ya saɓa wa Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "परीक्षा",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसी परिस्थिति जहाँ किसी को गलत काम करने या परमेश्वर की आज्ञा न मानने के लिए उकसाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọnwụnwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọnọdụ ebe a na-agba mmadụ ume ime ihe ọjọọ ma ọ bụ inupụrụ Chineke isi."
        }
      ]
    },
    "nep": {
      "preferred_label": "परीक्षा",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई गलत काम गर्न वा परमेश्‍वरको अनाज्ञाकारी हुन प्रोत्साहन दिइने अवस्था।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Искушение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ситуация, в которой кого-либо побуждают поступить дурно или ослушаться Бога."
        }
      ]
    },
    "swh": {
      "preferred_label": "Jaribu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hali ambapo mtu anashawishiwa kutenda maovu au kutomtii Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "traim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sitiuesen we man i kisim traim o kain samting i kirapim em long mekim rong o sakim tok bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự cám dỗ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tình huống mà một người bị thúc giục làm điều sai trái hoặc không vâng phục Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "诱惑",
      "descriptions": [
        {
          "source": "acai",
          "description": "使人受到诱导去行恶或违背上帝的情境。"
        }
      ]
    },
    "zht": {
      "preferred_label": "試探",
      "descriptions": [
        {
          "source": "acai",
          "description": "某人受到鼓勵去做錯事或違背上帝的情境。"
        }
      ]
    }
  },
