{
  "id": "keyterm:NotALoverOfMoney",
  "primary_id": "keyterm:NotALoverOfMoney",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "25.109"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Not a Lover of Money",
      "alternate_labels": [
        "Not Greedy"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Not wanting or chasing after money in a selfish or greedy way."
        }
      ]
    },
    "spa": {
      "preferred_label": "no amante del dinero",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que no desea ni persigue el dinero de manera egoísta o codiciosa."
        }
      ]
    },
    "fra": {
      "preferred_label": "ami de l'argent (non)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ne pas désirer ou poursuivre l'argent de manière égoïste ou cupide."
        }
      ]
    },
    "ind": {
      "preferred_label": "bukan hamba uang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak menginginkan atau mengejar uang secara mementingkan diri sendiri atau serakah."
        }
      ]
    },
    "por": {
      "preferred_label": "não apegado ao dinheiro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não desejar ou buscar o dinheiro de maneira egoísta ou gananciosa."
        }
      ]
    },
    "apd": {
      "preferred_label": "ما محب للقروش",
      "descriptions": [
        {
          "source": "acai",
          "description": "ما بيشتهي القروش ولا بيجري وراها بأنانيّة أو طمع."
        }
      ]
    },
    "arb": {
      "preferred_label": "غَيْرُ مُحِبٍّ لِلْمَالِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "عَدَمُ الرَّغْبَةِ فِي الْمَالِ أَوِ السَّعْيِ وَرَاءَهُ بِأَنَانِيَّةٍ أَوْ طَمَعٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "No laekem mane tumas",
      "descriptions": [
        {
          "source": "acai",
          "description": "We i no wantem o ronem mane long fasin blong karem olgeta samting blong hem nomo o fasin griri."
        }
      ]
    },
    "hau": {
      "preferred_label": "Marar son kuɗi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin son kuɗi ko bibiyarsa ta hanyar son kai ko kwaɗayi."
        }
      ]
    },
    "hin": {
      "preferred_label": "रुपये का लोभी न होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "स्वार्थी या लालची तरीके से धन की चाह या उसके पीछे न भागना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye na-abụghị onye na-ahụ ego nʼanya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịghara ịbụ onye na-achọsi ma ọ bụ na-achụ ego ike nʼụzọ nke ịchọ ọdịmma onwe nanị ma ọ bụ anyaukwu."
        }
      ]
    },
    "nep": {
      "preferred_label": "पैसाको लोभ नगर्ने",
      "descriptions": [
        {
          "source": "acai",
          "description": "स्वार्थी वा लोभी रूपमा पैसाको इच्छा नगर्ने वा त्यसको पछि नलाग्ने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "несребролюбивый",
      "descriptions": [
        {
          "source": "acai",
          "description": "Не стремящийся к деньгам и не гонящийся за ними из корысти или жадности."
        }
      ]
    },
    "swh": {
      "preferred_label": "asiyependa fedha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutotamani au kutofuatilia fedha kwa ubinafsi au kwa ulafi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "i no mangal long mani",
      "descriptions": [
        {
          "source": "acai",
          "description": "I no mangal o ron bihainim mani long pasin bilong gridi o bilong tingim em yet tasol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Không tham tiền",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không ham muốn hay theo đuổi tiền bạc một cách ích kỷ hoặc tham lam."
        }
      ]
    },
    "zhs": {
      "preferred_label": "不贪财",
      "descriptions": [
        {
          "source": "acai",
          "description": "不以自私或贪婪的方式渴求或追求金钱。"
        }
      ]
    },
    "zht": {
      "preferred_label": "不貪愛錢財",
      "descriptions": [
        {
          "source": "acai",
          "description": "不以自私或貪婪的方式渴望或追求金錢。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
