  "localizations": {
    "eng": {
      "preferred_label": "Show Kindness Towards",
      "descriptions": [
        {
          "source": "acai",
          "description": "To be kind and caring to someone, showing them grace and goodness."
        }
      ]
    },
    "spa": {
      "preferred_label": "mostrar bondad hacia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser bondadoso y atento con alguien, mostrándole gracia y bondad."
        }
      ]
    },
    "fra": {
      "preferred_label": "user de bonté envers",
      "descriptions": [
        {
          "source": "acai",
          "description": "Être bienveillant et attentionné envers quelqu'un, en lui témoignant de la grâce et de la bonté."
        }
      ]
    },
    "ind": {
      "preferred_label": "menunjukkan kebaikan kepada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bersikap baik hati dan peduli kepada seseorang, menunjukkan kasih karunia dan kebaikan kepada mereka."
        }
      ]
    },
    "por": {
      "preferred_label": "demonstrar bondade para com",
      "alternate_labels": [
        "dar gratuitamente"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser bondoso e atencioso com alguém, demonstrando-lhe graça e bondade."
        }
      ]
    },
    "apd": {
      "preferred_label": "يعمل إحسان",
      "descriptions": [
        {
          "source": "acai",
          "description": "تكون طيب وحنين مع زول، وتوريه نعمة وإحسان."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُظهِرُ لُطفًا نَحوَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَن يَكُونَ المَرءُ لَطِيفًا ومُهتَمًّا بِشَخصٍ مَا، مُظهِرًا لَهُ النِّعمَةَ والصَّلَاحَ."
        }
      ]
    },
    "bis": {
      "preferred_label": "soemaot kaenfasin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong kaen mo kea long wan man, mo soemaot gladhat mo gudfala fasin long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Nuna Alheri Zuwa Ga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna wa wani alheri da kulawa, nuna masa tagomashi da nagarta."
        }
      ]
    },
    "hin": {
      "preferred_label": "कृपा दिखाना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी के प्रति दयालु और परवाह करने वाला होना, उन पर अनुग्रह और भलाई दिखाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Igosipụta obiọma nʼebe mmadụ nọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe obiọma na ịma mma nʼebe mmadụ nọ, na-egosi ha amara na ịdị mma."
        }
      ]
    },
    "nep": {
      "preferred_label": "दया देखाउनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैप्रति दयालु र संवेदनशील हुनु, उनीहरूलाई अनुग्रह र भलाइ देखाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Оказывать милость",
      "descriptions": [
        {
          "source": "acai",
          "description": "Быть добрым и заботливым по отношению к кому-либо, проявляя к нему благодать и благость."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutendea Wema",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumtendea mtu wema na kumjali, ukimwonyesha neema na hisani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "marimari long",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim gutpela na sori pasin long narapela man, na soim marimari na gutpela pasin long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bày tỏ lòng nhân từ đối với",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tử tế và quan tâm đến ai đó, bày tỏ ân điển và sự nhân từ đối với họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "施恩",
      "descriptions": [
        {
          "source": "acai",
          "description": "善待并关怀某人，向其显明恩典与良善。"
        }
      ]
    },
    "zht": {
      "preferred_label": "施恩",
      "descriptions": [
        {
          "source": "acai",
          "description": "仁慈而體貼地對待某人，向他們施恩並顯出恩惠。"
        }
      ]
    }
  },
