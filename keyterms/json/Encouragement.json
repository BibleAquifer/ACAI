    "arb": {
      "preferred_label": "تَعْزِيَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "كَلِمَاتٌ أَوْ أَفْعَالٌ تُسَاعِدُ ٱلْمَرْءَ عَلَى ٱلشُّعُورِ بِتَحَسُّنٍ وَرَجَاءٍ أَكْبَرَ."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin blong leftemap tingting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol toktok o aksen we oli givhan long wan man blong mekem hem i harem gud mo gat hop bakegen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙarfafawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kalmomi ko ayyuka da suke taimaka wa wani ya ji daɗi da kuma ƙarin bege."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रोत्साहन",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसे शब्द या कार्य जो किसी को बेहतर और अधिक आशावान महसूस करने में मदद करते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Agbamume",
      "descriptions": [
        {
          "source": "acai",
          "description": "Okwu ma ọ bụ omume na-enyere mmadụ aka inwe mmetụta ka mma na olileanya karịa."
        }
      ]
    },
    "nep": {
      "preferred_label": "उत्साह",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै व्यक्तिलाई राम्रो र बढी आशावादी महसुस गराउन मद्दत गर्ने वचन वा कामहरू।"
        }
      ]
    },
    "rus": {
      "preferred_label": "ободрение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Слова или действия, которые помогают человеку почувствовать себя лучше и обрести надежду."
        }
      ]
    },
    "swh": {
      "preferred_label": "Faraja",
      "descriptions": [
        {
          "source": "acai",
          "description": "Maneno au matendo yanayomsaidia mtu kujisikia vizuri zaidi na kuwa na tumaini zaidi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong mekim isi bel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol tok o pasin we i save helpim manmeri long pilim gutpela moa na i gat gutpela tingting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự khích lệ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lời nói hoặc hành động giúp ai đó cảm thấy tốt hơn và có thêm hy vọng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "勉励",
      "descriptions": [
        {
          "source": "acai",
          "description": "帮助他人感觉更好并充满希望的言语或行动。"
        }
      ]
    },
    "zht": {
      "preferred_label": "安慰",
      "descriptions": [
        {
          "source": "acai",
          "description": "幫助某人心情轉好並更有盼望的言語或行動。"
        }
      ]
    }
  },
