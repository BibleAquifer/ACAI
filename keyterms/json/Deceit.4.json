{
  "id": "keyterm:Deceit.4",
  "primary_id": "keyterm:Deceit",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "localizations": {
    "eng": {
      "preferred_label": "Deceit (Betrayal)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Breaking trust by lying or tricking someone, causing harm or betrayal."
        }
      ]
    },
    "fra": {
      "preferred_label": "tromperie (trahison)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Trahir la confiance en mentant ou en trompant quelqu'un, causant du tort ou une trahison."
        }
      ]
    },
    "ind": {
      "preferred_label": "penipuan (pengkhianatan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Merusak kepercayaan dengan berbohong atau memperdaya seseorang, sehingga menimbulkan celaka atau pengkhianatan."
        }
      ]
    },
    "apd": {
      "preferred_label": "خداع (خيانة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "خيانة الثقة بالكضب أو خداع زول، والتسبب في أذى أو خيانة."
        }
      ]
    },
    "arb": {
      "preferred_label": "مكر (خيانة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "خيانة الأمانة بالكذب أو مخادعة شخص ما، مما يسبب ضررًا أو خيانة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong giaman (Betrayal)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong brokomaot tras taem man i giaman no i trikim narafala man, we i mekem trabol no fasin blong betrayedem narawan."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yaudara (Cin amana)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Karya amana ta hanyar yin ƙarya ko ruɗin wani, wanda yake jawo lahani ko cin amana."
        }
      ]
    },
    "hin": {
      "preferred_label": "छल (विश्वासघात)",
      "descriptions": [
        {
          "source": "acai",
          "description": "झूठ बोलकर या धोखा देकर विश्वास तोड़ना, जिससे नुकसान या विश्वासघात हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aghụghọ (Ịrara Mmadụ Nye)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Imebi ntụkwasị obi site nʼịgha ụgha ma ọ bụ ịghọgbu mmadụ, na-akpata mmerụ ahụ ma ọ bụ ịrara mmadụ nye."
        }
      ]
    },
    "nep": {
      "preferred_label": "छल (विश्‍वासघात)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरूलाई हानि पुर्‍याउन वा विश्‍वासघात गर्न झूट बोलेर वा झुक्याएर विश्‍वास तोड्ने काम।"
        }
      ]
    },
    "por": {
      "preferred_label": "Engano (traição)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quebra de confiança por meio de mentiras ou engano, causando dano ou traição."
        }
      ]
    },
    "rus": {
      "preferred_label": "Обман (предательство)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Нарушение доверия путем лжи или хитрости, причиняющее вред или предательство."
        }
      ]
    },
    "spa": {
      "preferred_label": "engaño (traición)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quebrantar la confianza mintiendo o engañando a alguien, causando daño o traición."
        }
      ]
    },
    "swh": {
      "preferred_label": "Udanganyifu (Usaliti)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuvunja uaminifu kwa kusema uongo au kumhadaa mtu, na kusababisha madhara au usaliti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin giaman (Pasin hapsait)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong brukim promis o bilip long rot bilong tok giaman o trikim man, na givim bagarap o mekim pasin hapsait."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lừa dối (Phản bội)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Phá vỡ sự tin cậy bằng cách nói dối hoặc lừa gạt ai đó, gây tổn hại hoặc bội phản."
        }
      ]
    },
    "zhs": {
      "preferred_label": "诡诈 (背叛)",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过说谎或诱骗他人来破坏信任，从而造成伤害或背叛。"
        }
      ]
    },
    "zht": {
      "preferred_label": "詭詐（背叛）",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由說謊或誘騙他人破壞信任，造成傷害或背叛。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Deceit"
  ],
