  ],
  "localizations": {
    "eng": {
      "preferred_label": "Circumcision",
      "descriptions": [
        {
          "source": "acai",
          "description": "The removal of the skin on a male's private part as a sign of God's special promise to Abraham's family."
        }
      ]
    },
    "ind": {
      "preferred_label": "penyunatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pemotongan kulit pada alat kelamin laki-laki sebagai tanda perjanjian khusus Allah dengan keluarga Abraham."
        }
      ]
    },
    "apd": {
      "preferred_label": "ختان",
      "descriptions": [
        {
          "source": "acai",
          "description": "قطع الجلدة في العضو التناسلي للذكر كعلامة على وعد الله الخاص لعيلة إبراهيم."
        }
      ]
    },
    "arb": {
      "preferred_label": "خِتان",
      "descriptions": [
        {
          "source": "acai",
          "description": "إزالة الجلد الذي يغطي العضو التناسلي للذكر كعلامة على وعد الله الخاص لنسل إبراهيم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sakomsaes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Katem aot skin long sem blong man olsem wan saen blong spesel promes blong God wetem famle blong Ebraham."
        }
      ]
    },
    "fra": {
      "preferred_label": "circoncision",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ablation du prépuce d'un homme en signe de l'alliance particulière de Dieu avec la descendance d'Abraham."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kaciya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cire fatar kan azakarin namiji a matsayin alamar alkawari na musamman na Allah ga iyalin Ibrahim."
        }
      ]
    },
    "hin": {
      "preferred_label": "खतना",
      "descriptions": [
        {
          "source": "acai",
          "description": "इब्राहीम के घराने से परमेश्वर की विशेष वाचा या प्रतिज्ञा के चिन्ह के रूप में पुरुष के गुप्तांग के अगले भाग की त्वचा को काटना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Obibi ugwu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iwepụ akpụkpọ anụ ahụ dị nʼamụ nwoke dịka ihe ịrịba ama nke nkwa pụrụ iche Chineke kwere ezinụlọ Ebraham."
        }
      ]
    },
    "nep": {
      "preferred_label": "खतना",
      "descriptions": [
        {
          "source": "acai",
          "description": "अब्राहामको परिवारसँग परमेश्‍वरले गर्नुभएको विशेष प्रतिज्ञाको सङ्केतको रूपमा पुरुषको अङ्गको छाला हटाउने कार्य।"
        }
      ]
    },
    "por": {
      "preferred_label": "circuncisão",
      "descriptions": [
        {
          "source": "acai",
          "description": "A remoção da pele do órgão genital masculino como sinal da promessa especial de Deus à família de Abraão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Обрезание",
      "descriptions": [
        {
          "source": "acai",
          "description": "Удаление крайней плоти у мужчины как знак особого Божьего завета с потомками Авраама."
        }
      ]
    },
    "spa": {
      "preferred_label": "circuncisión",
      "descriptions": [
        {
          "source": "acai",
          "description": "La extirpación de la piel de la parte íntima de un varón como señal de la promesa especial de Dios a la familia de Abraham."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tohara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuondolewa kwa ngozi kwenye sehemu ya siri ya mwanamume kama ishara ya ahadi ya pekee ya Mungu kwa familia ya Abrahamu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong katim skin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong tekewe skin bilong kok bilong man olsem wanpela mak bilong promis bilong God long lain famili bilong Abraham."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ cắt bì",
      "descriptions": [
        {
          "source": "acai",
          "description": "Việc cắt bỏ lớp da bọc quy đầu của nam giới như một dấu hiệu về lời hứa đặc biệt của Đức Chúa Trời với dòng dõi Áp-ra-ham."
        }
      ]
    },
    "zhs": {
      "preferred_label": "割礼",
      "descriptions": [
        {
          "source": "acai",
          "description": "切除男性私处的包皮，作为上帝向亚伯拉罕家族所立特别应许的记号。"
        }
      ]
    },
    "zht": {
      "preferred_label": "割禮",
      "descriptions": [
        {
          "source": "acai",
          "description": "切除男性生殖器上的包皮，作為上帝對亞伯拉罕家族特別應許的記號。"
        }
      ]
    }
  },
