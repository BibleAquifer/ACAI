{
  "id": "keyterm:Knowledge",
  "primary_id": "keyterm:Intention",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "001700001001000",
    "001700001002000",
    "001700001004000",
    "001700001003000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Knowledge",
      "descriptions": [
        {
          "source": "acai",
          "description": "Understanding facts and truth, and having the ability to use them, often seen as a gift from God."
        }
      ]
    },
    "spa": {
      "preferred_label": "conocimiento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Comprensión de hechos y de la verdad, y la capacidad de utilizarlos, a menudo considerada como un don de Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "connaissance",
      "descriptions": [
        {
          "source": "acai",
          "description": "Compréhension des faits et de la vérité, ainsi que capacité à les mettre en œuvre, souvent considérée comme un don de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "pengetahuan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pemahaman akan fakta dan kebenaran, serta memiliki kemampuan untuk menggunakannya, yang sering kali dipandang sebagai pemberian dari Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "Conhecimento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Compreensão de fatos e da verdade, e a capacidade de usá-los, frequentemente vista como um dom de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "معرفة",
      "descriptions": [
        {
          "source": "acai",
          "description": "فهم الحقائق والحق، والقدرة على استخدامهم، وغالباً ما بتتشاف كعطية من الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَعْرِفَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "فَهْمُ الحَقائِقِ والحَقِّ، والْقُدْرَةُ عَلى اسْتِخْدامِها، وغالِبًا ما تُعْتَبَرُ عَطِيَّةً مِنَ اللهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Save",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong kasemsave long ol trutok mo ol samting we i tru, mo blong gat paoa blong yusum olgeta, we plante taem i olsem wan presen we i kamaot long God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fahimtar hujjoji da gaskiya, da kuma samun ikon amfani da su, wanda sau da yawa ake ɗauka a matsayin kyauta daga Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "ज्ञान",
      "descriptions": [
        {
          "source": "acai",
          "description": "तथ्यों और सत्य की समझ तथा उनका उपयोग करने की क्षमता, जिसे प्रायः परमेश्वर का वरदान माना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe Ọmụma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịghọta eziokwu na ihe mere eme, na inwe ike iji ha mee ihe, nke a na-ahụkarị dị ka onyinye sitere na Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "ज्ञान",
      "descriptions": [
        {
          "source": "acai",
          "description": "तथ्य र सत्यतालाई बुझ्नु, र तिनीहरूलाई प्रयोग गर्ने क्षमता हुनु, जसलाई प्रायः परमेश्‍वरबाटको वरदानको रूपमा हेरिन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Знание",
      "descriptions": [
        {
          "source": "acai",
          "description": "Понимание фактов и истины, а также способность применять их, часто рассматриваемое как дар от Бога."
        }
      ]
    },
    "swh": {
      "preferred_label": "Maarifa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuelewa mambo ya hakika na ukweli, na kuwa na uwezo wa kuyatumia, mara nyingi huonekana kama zawadi kutoka kwa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Save",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong kliagut long ol trutok na ol samting i stap tru, na i gat save bilong mekim wok long ol, em planti taim ol i lukim olsem wanpela presen i kam long God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tri thức",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sự hiểu biết các sự kiện và lẽ thật, cùng khả năng vận dụng chúng, thường được xem là món quà từ Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "知识",
      "descriptions": [
        {
          "source": "acai",
          "description": "对事实和真理的理解以及运用它们的能力，常被视作来自上帝的恩赐。"
        }
      ]
    },
    "zht": {
      "preferred_label": "知識",
      "descriptions": [
        {
          "source": "acai",
          "description": "理解事實與真理並能夠運用它們的能力，常被視為上帝的賜予。"
        }
      ]
    }
  },
  "referred_to_as": [
