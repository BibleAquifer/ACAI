{
  "id": "keyterm:Testimony",
  "primary_id": "keyterm:BearWitness",
  "type": "keyterm",
  "keyterm_type": "miscellaneous",
  "ubsdgnt": [
    "33.264",
    "33.262",
    "33.265"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Testimony (Evidence)",
      "alternate_labels": [
        "Witness",
        "Evidence",
        "Reputation"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "What someone says about a person or event based on what they have seen or judged."
        }
      ]
    },
    "spa": {
      "preferred_label": "testimonio (evidencia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lo que alguien dice sobre una persona o suceso basándose en lo que ha visto o juzgado."
        }
      ]
    },
    "fra": {
      "preferred_label": "témoignage (preuve)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ce qu'une personne déclare à propos de quelqu'un ou d'un événement sur la base de ce qu'elle a vu ou jugé."
        }
      ]
    },
    "ind": {
      "preferred_label": "kesaksian (bukti)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Apa yang dikatakan seseorang tentang seseorang atau suatu peristiwa berdasarkan apa yang telah mereka lihat atau nilai."
        }
      ]
    },
    "por": {
      "preferred_label": "testemunho (evidência)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O que alguém declara a respeito de uma pessoa ou acontecimento com base no que viu ou avaliou."
        }
      ]
    },
    "apd": {
      "preferred_label": "شهادة (دليل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "القول البيقولو الزول عن شخص أو حدث بناءً على الشي الشافو أو حَكَم عليه."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَهَادَة (دليل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ما يقوله شخص عن إنسان أو حدث بناءً على ما رآه أو حكم به."
        }
      ]
    },
    "bis": {
      "preferred_label": "witnes (pruf)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting we wan man i talem long saed blong wan narafala man no wan samting we i hapen folem samting we hem i luk no i jajem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shaida (Hujja)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abin da wani yake faɗa game da wani mutum ko aukuwa bisa ga abin da ya gani ko ya yanke hukunci a kai."
        }
      ]
    },
    "hin": {
      "preferred_label": "गवाही (प्रमाण)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या घटना के बारे में वह बात जो कोई अपने देखे या परखे हुए के आधार पर कहता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Akaebe (Ihe akaebe)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe mmadụ na-ekwu banyere onye ma ọ bụ ihe merenụ dabere nʼihe ọ hụrụ ma ọ bụ kpebie."
        }
      ]
    },
    "nep": {
      "preferred_label": "गवाही (प्रमाण)",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफूले देखेको वा जाँचेको आधारमा कसैले कुनै व्यक्ति वा घटनाको बारेमा भन्ने कुरा।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Свидетельство (доказательство)",
      "descriptions": [
        {
          "source": "acai",
          "description": "То, что кто-либо говорит о человеке или событии на основании увиденного или оцененного им."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ushuhuda (Ushahidi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kile mtu anachosema kuhusu mtu au tukio kulingana na kile alichokiona au kukihukumu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "tok i kamapim trutok (evidens)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting man i tok long narapela man o samting i bin kamap, olsem em yet i bin lukim o skelim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời chứng (Bằng cớ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những điều một người nói về một nhân vật hay sự kiện dựa trên điều họ đã thấy hoặc nhận định."
        }
      ]
    },
    "zhs": {
      "preferred_label": "见证 (证据)",
      "descriptions": [
        {
          "source": "acai",
          "description": "某人基于自己的所见或判断，针对某人或某事所做的陈述。"
        }
      ]
    },
    "zht": {
      "preferred_label": "見證（證據）",
      "descriptions": [
        {
          "source": "acai",
          "description": "某人根據自己的所見或判斷，對某人或某事所作的陳述。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:BearWitness"
  ],
