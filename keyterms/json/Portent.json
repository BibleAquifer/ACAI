{
  "id": "keyterm:Portent",
  "primary_id": "keyterm:Portent",
  "type": "keyterm",
  "keyterm_type": "miscellaneous",
  "ubsdgnt": [
    "33.480"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Portent",
      "alternate_labels": [
        "Wonder"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A strange or amazing sign, often in the sky, that shows something important will happen soon."
        }
      ]
    },
    "spa": {
      "preferred_label": "prodigio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una señal extraña o asombrosa, a menudo en el cielo, que muestra que algo importante sucederá pronto."
        }
      ]
    },
    "fra": {
      "preferred_label": "prodige",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un signe étrange ou étonnant, souvent dans le ciel, qui annonce qu'un événement important va bientôt se produire."
        }
      ]
    },
    "ind": {
      "preferred_label": "mujizat tanda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tanda yang aneh atau menakjubkan, sering kali di langit, yang menunjukkan bahwa sesuatu yang penting akan segera terjadi."
        }
      ]
    },
    "por": {
      "preferred_label": "prodígio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um sinal estranho ou surpreendente, muitas vezes no céu, que indica que algo importante acontecerá em breve."
        }
      ]
    },
    "apd": {
      "preferred_label": "عجيبة",
      "descriptions": [
        {
          "source": "acai",
          "description": "علامة عجيبة أو مدهشة، غالباً في السماء، بتبيّن إنو في حاجة مهمة حتحصل قريب."
        }
      ]
    },
    "arb": {
      "preferred_label": "أعجوبة",
      "descriptions": [
        {
          "source": "acai",
          "description": "علامة غريبة أو مذهلة، غالبًا ما تكون في السماء، تُبيّن أنّ أمرًا مهمًا سيحدث قريبًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "samting blong sapraes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan narakaen saen no samting blong sapraes, plante taem long skae, we i soemaot se wan impoten samting i klosap blong hapen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Alamar banmamaki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alama mai banmamaki ko ban al’ajabi, yawanci a sararin sama, wadda take nuna cewa wani muhimmin abu zai faru ba da daɗewa ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "अद्भुत काम",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक विचित्र या अद्भुत चिन्ह, जो प्रायः आकाश में दिखाई देता है और यह दर्शाता है कि शीघ्र ही कुछ महत्वपूर्ण घटित होने वाला है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe ịrịba ama dị ịtụnanya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe ịrịba ama dị ịtụnanya ma ọ bụ nke na-eju anya, nke na-apụtakarị na mbara eluigwe, na-egosi na ihe dị mkpa ga-eme nʼoge na-adịghị anya."
        }
      ]
    },
    "nep": {
      "preferred_label": "अलौकिक चिन्ह",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः आकाशमा देखिने एउटा अनौठो वा आश्‍चर्यजनक चिन्ह, जसले चाँडै नै केही महत्त्वपूर्ण घटना घट्दैछ भनी देखाउँछ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Знамение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Удивительное или необычайное знамение, часто на небе, показывающее, что вскоре произойдет нечто важное."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ajabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ishara ya ajabu au ya kustaajabisha, mara nyingi angani, inayoonyesha kuwa jambo muhimu litatokea hivi karibuni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Narakain mak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela narakain mak o mirakel, planti taim long skai, i soim olsem wanpela bikpela samting i laik kamap klostu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Hiện tượng lạ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một dấu hiệu kỳ lạ hoặc đáng kinh ngạc, thường ở trên trời, cho thấy một điều quan trọng sắp xảy ra."
        }
      ]
    },
    "zhs": {
      "preferred_label": "奇事",
      "descriptions": [
        {
          "source": "acai",
          "description": "奇特或惊人的征兆，常显于天上，预示某件大事即将发生。"
        }
      ]
    },
    "zht": {
      "preferred_label": "奇事",
      "descriptions": [
        {
          "source": "acai",
          "description": "奇異或令人驚嘆的預兆（常出現在天上），預示重大事件即將發生。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
  "lemmas": {
