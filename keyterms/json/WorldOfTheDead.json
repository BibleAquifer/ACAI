  ],
  "localizations": {
    "eng": {
      "preferred_label": "World of the Dead",
      "alternate_labels": [
        "Hades"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "The place where people go after they die, including both good and bad people."
        }
      ]
    },
    "spa": {
      "preferred_label": "mundo de los muertos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lugar adonde van las personas después de morir, tanto las buenas como las malas."
        }
      ]
    },
    "fra": {
      "preferred_label": "séjour des morts",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lieu où vont les personnes après leur mort, qu'elles soient bonnes ou mauvaises."
        }
      ]
    },
    "ind": {
      "preferred_label": "dunia orang mati",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tempat orang-orang pergi setelah mereka meninggal, baik orang baik maupun orang jahat."
        }
      ]
    },
    "por": {
      "preferred_label": "mundo dos mortos",
      "descriptions": [
        {
          "source": "acai",
          "description": "O lugar para onde as pessoas vão depois de morrer, incluindo pessoas boas e más."
        }
      ]
    },
    "apd": {
      "preferred_label": "عالم الموتى",
      "descriptions": [
        {
          "source": "acai",
          "description": "المكان البيمشوا ليهو الناس بعد ما يموتوا، وفيهو الصالحين والبطالين."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَالَمُ ٱلْأَمْوَاتِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱلْمَكَانُ ٱلَّذِي يَذْهَبُ إِلَيْهِ ٱلنَّاسُ بَعْدَ مَوْتِهِمْ، بِمَنْ فِيهِمِ ٱلْأَخْيَارُ وَٱلْأَشْرَارُ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ples blong ol dedman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ples we ol man oli stap go long hem afta we oli ded, we i tekem ol gudfala man wetem ol rabis man tu."
        }
      ]
    },
    "hau": {
      "preferred_label": "Duniyar Matattu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wurin da mutane suke tafiya bayan sun mutu, ciki har da nagargaru da mugaye."
        }
      ]
    },
    "hin": {
      "preferred_label": "अधोलोक",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह स्थान जहाँ लोग मरने के बाद जाते हैं, जिसमें भले और बुरे दोनों लोग शामिल हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ala mmụọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ebe ndị mmadụ na-aga ma ha nwụsịa, gụnyere ma ndị ezi omume ma ndị ajọ omume."
        }
      ]
    },
    "nep": {
      "preferred_label": "मरेकाहरूको संसार",
      "descriptions": [
        {
          "source": "acai",
          "description": "मानिसहरू मरेपछि जाने ठाउँ, जसमा असल र खराब दुवै मानिसहरू पर्दछन्।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Мир мертвых",
      "descriptions": [
        {
          "source": "acai",
          "description": "Место, куда люди попадают после смерти, как праведные, так и нечестивые."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuzimu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahali ambapo watu huenda baada ya kufa, wakiwemo watu wema na waovu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples bilong ol man i dai pinis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ples we ol manmeri i save go long en taim ol i dai pinis, wantaim ol gutpela man na ol man nogut wantaim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Âm phủ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nơi con người đi về sau khi qua đời, bao gồm cả người lành lẫn người dữ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "阴间",
      "descriptions": [
        {
          "source": "acai",
          "description": "人死后去的地方，包括善人和恶人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "陰間",
      "descriptions": [
        {
          "source": "acai",
          "description": "人死後所去的地方，包括善人和惡人。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
