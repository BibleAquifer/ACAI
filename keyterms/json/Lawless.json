{
  "id": "keyterm:Lawless",
  "primary_id": "keyterm:Lawless",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "88.141",
    "88.140",
    "11.42",
    "33.57",
    "88.139"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Lawless (Noncompliance)",
      "alternate_labels": [
        "Unruly",
        "Not Complying With Law"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Refusing to follow or obey the rules and laws that others must follow."
        }
      ]
    },
    "spa": {
      "preferred_label": "transgresor (incumplimiento)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Negarse a seguir u obedecer las reglas y leyes que otros deben cumplir."
        }
      ]
    },
    "fra": {
      "preferred_label": "sans loi (insoumission)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Refus de suivre ou d'obéir aux règles et aux lois que les autres doivent respecter."
        }
      ]
    },
    "ind": {
      "preferred_label": "tak kenal hukum (pembangkangan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menolak untuk mengikuti atau menaati aturan dan hukum yang wajib diikuti orang lain."
        }
      ]
    },
    "por": {
      "preferred_label": "sem lei (desobediência)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recusar-se a seguir ou obedecer às regras e leis que outros devem seguir."
        }
      ]
    },
    "apd": {
      "preferred_label": "متعدي (عدم طاعة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "رفض إتباع أو طاعة القواعد والقوانين المفروض الناس التانيين يتبعوها."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَثِيم (عَدَمُ الامْتِثال)",
      "descriptions": [
        {
          "source": "acai",
          "description": "رَفْض اتِّباع أو إطاعة القواعد والقوانين التي يجب على الآخرين اتّباعها."
        }
      ]
    },
    "bis": {
      "preferred_label": "brekem loa (no wantem obei)",
      "descriptions": [
        {
          "source": "acai",
          "description": "No wantem folem no obei long ol rul mo ol loa we ol narafala man oli mas folem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai Tawaye (Ƙin Biyayya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙin bin ko yin biyayya ga ƙa'idodi da dokokin da dole ne wasu su bi."
        }
      ]
    },
    "hin": {
      "preferred_label": "अधर्मी (अवज्ञा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "उन नियमों और व्यवस्थाओं को मानने या उनका पालन करने से इनकार करना जिनका पालन दूसरों को करना आवश्यक है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mmebi iwu (Inupụ isi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịjụ ịgbaso ma ọ bụ irubere ụkpụrụ na iwu ndị ndị ọzọ ga-erubererịrị isi."
        }
      ]
    },
    "nep": {
      "preferred_label": "व्यवस्थाविहीन (अनाज्ञाकारिता)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरूले पालन गर्नुपर्ने नियमहरू र व्यवस्थाहरू पालन गर्न वा मान्न अस्वीकार गर्ने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Беззаконный (непокорный)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отказ следовать правилам и законам, обязательным для других, либо неподчинение им."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mvunja sheria (Kutotii)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kukataa kufuata au kutii kanuni na sheria ambazo wengine lazima wazifuate."
        }
      ]
    },
    "tpi": {
      "preferred_label": "sakim lo (bikhet)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bikhet na i no laik bihainim ol lo em ol arapela i mas bihainim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bất tuân luật pháp (Không tuân phục)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Từ chối tuân theo hoặc vâng phục các quy tắc và luật pháp mà người khác phải làm theo."
        }
      ]
    },
    "zhs": {
      "preferred_label": "不法的 (抗拒遵从)",
      "descriptions": [
        {
          "source": "acai",
          "description": "拒绝遵行或服从他人必须遵守的规则与律法。"
        }
      ]
    },
    "zht": {
      "preferred_label": "不法的（不遵行）",
      "descriptions": [
        {
          "source": "acai",
          "description": "拒絕遵循或順從他人必須遵行的規矩與律法。"
        }
      ]
    }
  },
