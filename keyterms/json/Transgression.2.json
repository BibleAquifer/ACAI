{
  "id": "keyterm:Transgression.2",
  "primary_id": "keyterm:Sin",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "88.297"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Trespass (Sin)",
      "alternate_labels": [
        "Transgression"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "An action that breaks God's law or will, showing a failure to do what is right."
        }
      ]
    },
    "spa": {
      "preferred_label": "ofensa (pecado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Acción que quebranta la ley o la voluntad de Dios, mostrando una falta al no hacer lo correcto."
        }
      ]
    },
    "fra": {
      "preferred_label": "offense (péché)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Action qui enfreint la loi ou la volonté de Dieu, manifestant un manquement à faire ce qui est juste."
        }
      ]
    },
    "ind": {
      "preferred_label": "pelanggaran (dosa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Perbuatan yang melanggar hukum atau kehendak Allah, yang menunjukkan kegagalan untuk melakukan apa yang benar."
        }
      ]
    },
    "por": {
      "preferred_label": "transgressão (pecado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma ação que viola a lei ou a vontade de Deus, demonstrando uma falha em fazer o que é correto."
        }
      ]
    },
    "apd": {
      "preferred_label": "زلة (خطية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل بيكسر شريعة الله أو إرادته، وبيوضح الفشل في عمل الحاجة الصح."
        }
      ]
    },
    "arb": {
      "preferred_label": "زَلَّة (خَطِيَّة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل يكسر شريعة الله أو مشيئته، ويُظهر فشلًا في فعل ما هو صواب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem i nogud (Sin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan aksen we i brekem loa o wanem we God i wantem, we i soemaot se man i fel blong mekem samting we i stret."
        }
      ]
    },
    "hau": {
      "preferred_label": "Laifi (Zunubi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aikin da ya saba wa doka ko nufin Allah, wanda yake nuna gāsa wajen yin abin da yake daidai."
        }
      ]
    },
    "hin": {
      "preferred_label": "अपराध (पाप)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर की व्यवस्था या इच्छा का उल्लंघन करनेवाला ऐसा कार्य, जो सही कार्य करने की विफलता को दर्शाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Njehie (Mmehie)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Omume nke na-emebi iwu Chineke ma ọ bụ uche Ya, na-egosi ọdịda ime ihe ziri ezi."
        }
      ]
    },
    "nep": {
      "preferred_label": "अपराध (पाप)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको व्यवस्था वा इच्छा उल्लङ्घन गर्ने कार्य, जसले जे सही छ त्यो गर्न असफल भएको देखाउँछ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Согрешение (грех)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Действие, нарушающее закон или волю Бога и показывающее неспособность поступать правильно."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kosa (Dhambi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tendo linalovunja sheria au mapenzi ya Mungu, linaloonyesha kutofaulu kufanya yaliyo sawa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rong (Sin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pasin we i brukim lo o laik bilong God, na i soim olsem man i no mekim gutpela pasin."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tội lỗi (Lỗi phạm)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành động vi phạm luật pháp hoặc ý muốn của Đức Chúa Trời, thể hiện sự không làm theo điều đúng đắn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "过犯（罪）",
      "descriptions": [
        {
          "source": "acai",
          "description": "违背上帝的律法或旨意、表明未能行正事的行为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "過犯 (罪)",
      "descriptions": [
        {
          "source": "acai",
          "description": "違背上帝律法或旨意的行為，顯明未能行合宜之事。"
        }
      ]
    }
  },
