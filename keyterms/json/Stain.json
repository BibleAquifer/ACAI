  "localizations": {
    "eng": {
      "preferred_label": "Defile",
      "alternate_labels": [
        "Pollute",
        "Stain"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To make something unclean or dirty, especially in a moral or spiritual way."
        }
      ]
    },
    "spa": {
      "preferred_label": "contaminar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer que algo quede impuro o sucio, especialmente en un sentido moral o espiritual."
        }
      ]
    },
    "fra": {
      "preferred_label": "souiller",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rendre quelque chose impur ou souillé, particulièrement sur le plan moral ou spirituel."
        }
      ]
    },
    "ind": {
      "preferred_label": "mencemarkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membuat sesuatu menjadi najis atau kotor, khususnya secara moral atau rohani."
        }
      ]
    },
    "por": {
      "preferred_label": "manchar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tornar algo impuro ou sujo, especialmente de modo moral ou espiritual."
        }
      ]
    },
    "apd": {
      "preferred_label": "ينجس",
      "descriptions": [
        {
          "source": "acai",
          "description": "يخلي شي نجس أو وسخان، خصوصاً بطريقة أخلاقية أو روحية."
        }
      ]
    },
    "arb": {
      "preferred_label": "تنجيس",
      "descriptions": [
        {
          "source": "acai",
          "description": "جعل الشيء غير طاهر أو دنسًا، لا سيما من الناحية الأخلاقية أو الروحية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem i doti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekem wan samting i kam doti no no klin, speseli long saed blong fasin no long saed blong spirit."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙazantarwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin wani abu ya zama marar tsarki ko ƙazantacce, musamman ta hanyar ɗabi'a ko ta ruhaniya."
        }
      ]
    },
    "hin": {
      "preferred_label": "अपवित्र करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी वस्तु को विशेष रूप से नैतिक या आत्मिक रीति से अशुद्ध या गंदा करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Imerụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka ihe bụrụ nke na-adịghị ọcha maọbụ nke rụrụ arụ, karịsịa nʼụzọ omume maọbụ nʼụzọ ime mmụọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "अशुद्ध पार्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरालाई अशुद्ध वा मैला बनाउनु, विशेष गरी नैतिक वा आत्मिक रूपमा।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Осквернять",
      "descriptions": [
        {
          "source": "acai",
          "description": "Делать что-либо нечистым или грязным, особенно в моральном или духовном смысле."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutia Unajisi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kufanya kitu kiwe kichafu au kichafuliwe, hasa kwa njia ya kimaadili au ya kiroho."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim i kamap doti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim wanpela samting i kamap doti, moa yet long pasin o long sait bilong spirit."
        }
      ]
    },
    "vie": {
      "preferred_label": "Làm ô uế",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm cho điều gì đó trở nên không thanh sạch hoặc dơ bẩn, đặc biệt về mặt đạo đức hoặc tâm linh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "玷污",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某物不洁净或污秽，尤指在道德或属灵层面上。"
        }
      ]
    },
    "zht": {
      "preferred_label": "玷污",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某物不潔淨或骯髒，尤指在道德或屬靈層面上。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
