  "localizations": {
    "eng": {
      "preferred_label": "To Dedicate",
      "descriptions": [
        {
          "source": "acai",
          "description": "To set a building apart for God's use by making it special and ready for worship."
        }
      ]
    },
    "spa": {
      "preferred_label": "dedicar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Apartar un edificio para el uso de Dios, haciéndolo especial y apto para la adoración."
        }
      ]
    },
    "fra": {
      "preferred_label": "dédier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mettre un édifice à part pour l'usage de Dieu en le rendant saint et prêt pour le culte."
        }
      ]
    },
    "ind": {
      "preferred_label": "mentahbiskan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengkhususkan suatu bangunan untuk digunakan bagi Allah dengan menjadikannya istimewa dan siap untuk ibadah."
        }
      ]
    },
    "por": {
      "preferred_label": "dedicar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Separar um edifício para o uso de Deus, tornando-o especial e preparado para a adoração."
        }
      ]
    },
    "apd": {
      "preferred_label": "كرّس",
      "descriptions": [
        {
          "source": "acai",
          "description": "تخصيص مبنى لاستخدام الله بجعله مميز وجاهز للعبادة."
        }
      ]
    },
    "arb": {
      "preferred_label": "يدشن",
      "descriptions": [
        {
          "source": "acai",
          "description": "تخصيص مبنى لاستخدام الله بجعله مميزًا ومهيأً للعبادة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem i tabu blong God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong putum wan bilding i stap wanples blong God nomo i yusum, taem oli mekem i spesel mo i rere blong wosipim hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Keɓe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Keɓe gini domin amfanin Allah ta wurin mai da shi na musamman da kuma shirye domin bauta."
        }
      ]
    },
    "hin": {
      "preferred_label": "समर्पित करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी भवन को परमेश्वर की आराधना के लिए विशेष और तैयार करके उसके उपयोग के लिए अलग करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ido nsọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịwepụta ma ọ bụ ido ụlọ nsọ maka iji ya na-efe Chineke site nʼime ka ọ dị iche ma dị njikere maka ofufe."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रतिष्ठा गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै भवनलाई विशेष र आराधनाको निम्ति तयार गरी परमेश्‍वरको सेवाका लागि अलग गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Освящать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Освящать здание для Божьего служения, делая его особым и готовым для поклонения."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuweka Wakfu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutenga jengo kwa ajili ya matumizi ya Mungu kwa kulifanya maalum na tayari kwa ajili ya ibada."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Makim i bilong God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long makim wanpela haus i bilong God tasol, long mekim em i holi na redi long lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cung hiến",
      "descriptions": [
        {
          "source": "acai",
          "description": "Biệt riêng một công trình cho Đức Chúa Trời sử dụng bằng cách làm cho công trình ấy trở nên đặc biệt và sẵn sàng cho việc thờ phượng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "奉献",
      "descriptions": [
        {
          "source": "acai",
          "description": "将一座建筑物分别出来归上帝使用，使其成为圣洁并可用于敬拜。"
        }
      ]
    },
    "zht": {
      "preferred_label": "奉獻（建築物）",
      "descriptions": [
        {
          "source": "acai",
          "description": "將建築物分別為聖歸給上帝使用，使之成為特別且預備好用於敬拜。"
        }
      ]
    }
  },
