  "localizations": {
    "eng": {
      "preferred_label": "Tempt",
      "descriptions": [
        {
          "source": "acai",
          "description": "To try to make someone do something wrong or against God's will."
        }
      ]
    },
    "spa": {
      "preferred_label": "tentar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Intentar hacer que alguien haga algo malo o contrario a la voluntad de Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "tenter",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chercher à inciter quelqu'un à faire le mal ou à agir contre la volonté de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "mencobai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mencoba membuat seseorang melakukan sesuatu yang salah atau bertentangan dengan kehendak Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "tentar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tentar fazer com que alguém pratique algo errado ou contra a vontade de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "يجرّب",
      "descriptions": [
        {
          "source": "acai",
          "description": "محاولة تخلي زول يعمل حاجة غلط أو ضد مشيئة الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُجَرِّب",
      "descriptions": [
        {
          "source": "acai",
          "description": "محاولة دفع شخص ما إلى ارتكاب خطأ أو عصيان مشيئة الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "traem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong traem mekem wan man i mekem samting we i rong no i agensem tingting blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Jarraba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙoƙarin sa wani ya aikata wani abu marar kyau ko kuma saɓa wa nufin Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "परीक्षा करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी को कुछ गलत या परमेश्वर की इच्छा के विरुद्ध करने के लिए लुभाना या उकसाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịnwa ọnwụnwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịnwale ime ka mmadụ mee ihe ọjọọ ma ọ bụ ihe megidere uche Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "परीक्षा गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई कुनै गलत काम गर्न वा परमेश्‍वरको इच्छाविपरीत जान उक्साउने प्रयास गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Искушать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пытаться склонить кого-либо к дурному поступку или к действию вопреки воле Бога."
        }
      ]
    },
    "swh": {
      "preferred_label": "Jaribu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kujaribu kumfanya mtu atende jambo lisilo sahihi au kinyume na mapenzi ya Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "traim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Traim long mekim man i mekim samting i no stret o samting i krosim laik bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cám dỗ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cố gắng khiến ai đó làm điều sai trái hoặc nghịch lại ý muốn của Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "试探",
      "descriptions": [
        {
          "source": "acai",
          "description": "企图使人做错事或违背上帝的旨意。"
        }
      ]
    },
    "zht": {
      "preferred_label": "試探",
      "descriptions": [
        {
          "source": "acai",
          "description": "試圖使某人做出錯誤或違背上帝旨意的事。"
        }
      ]
    }
  },
