  "localizations": {
    "eng": {
      "preferred_label": "Sin (Incur Guilt)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A wrong action against God or others that causes guilt and may need to be fixed."
        }
      ]
    },
    "spa": {
      "preferred_label": "pecado (contraer culpa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Acción incorrecta contra Dios o los demás que acarrea culpa y que puede necesitar ser reparada."
        }
      ]
    },
    "fra": {
      "preferred_label": "péché (culpabilité)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Action mauvaise contre Dieu ou autrui qui rend coupable et peut devoir être réparée."
        }
      ]
    },
    "ind": {
      "preferred_label": "dosa (menanggung kesalahan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tindakan salah terhadap Allah atau sesama yang mendatangkan rasa bersalah dan mungkin perlu diperbaiki."
        }
      ]
    },
    "apd": {
      "preferred_label": "خطيّة (يتحمّل ذنب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل غلط ضد الله أو الناس التانيين بيجيب الذنب وممكن يحتاج يتصلّح."
        }
      ]
    },
    "arb": {
      "preferred_label": "خَطِيَّة (تَحَمُّل الذَّنْب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "فِعْلٌ خاطئٌ ضِدَّ اللهِ أَوِ الآخَرِينَ يَجْلِبُ الذَّنْبَ وقَدْ يَحْتاجُ إِلى إِصْلاحٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sin (Mekem Man i Gat Fol)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan rong fasin agensim God o narafala man we i mekem man i gat fol mo ating i nidim blong stretim bakegen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zunubi (Jawo Laifi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuskure ko mugun aiki a kan Allah ko wasu wanda ke jawo laifi kuma yana iya buƙatar a gyara shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "पाप (दोषी ठहरना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर या दूसरों के विरुद्ध किया गया एक गलत कार्य जो दोष उत्पन्न करता है और जिसका समाधान करना आवश्यक हो सकता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mmehie (Inwe Ikpe Ọmụma)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Omume na-ezighị ezi e mere megide Chineke maọbụ ndị ọzọ nke na-eweta ikpe ọmụma ma nwee ike ịchọ ka e mee ka ọ dị mma."
        }
      ]
    },
    "nep": {
      "preferred_label": "पाप (दोषी ठहरिनु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वर वा अरू कसैको विरुद्धमा गरिएको खराब काम जसले दोषी बनाउँछ र जसलाई सुधार्नु आवश्यक हुन सक्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "Pecado (contrair culpa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma ação errada contra Deus ou o próximo que gera culpa e que pode precisar de reparação."
        }
      ]
    },
    "rus": {
      "preferred_label": "Грех (навлечь вину)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дурной поступок против Бога или ближних, который влечет за собой вину и может требовать исправления."
        }
      ]
    },
    "swh": {
      "preferred_label": "Dhambi (Kupata Hatia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tendo baya dhidi ya Mungu au wengine linalosababisha hatia na ambalo huenda likahitaji kurekebishwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sin (Kisim Asua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pasin nogut i go agensim God o ol arapela manmeri em i save kamapim asua na ating i nidim stretim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tội (Mắc tội)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành vi sai trái chống lại Đức Chúa Trời hoặc người khác gây ra tội lỗi và có thể cần phải được sửa chữa hoặc đền bù."
        }
      ]
    },
    "zhs": {
      "preferred_label": "罪（招致罪责）",
      "descriptions": [
        {
          "source": "acai",
          "description": "指冒犯上帝或他人、招致罪责且可能需要弥补的不当行为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "罪（擔罪）",
      "descriptions": [
        {
          "source": "acai",
          "description": "對上帝或他人所犯、會招致罪咎且可能需要彌補的錯誤行為。"
        }
      ]
    }
  },
