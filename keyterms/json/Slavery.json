  "localizations": {
    "eng": {
      "preferred_label": "Enslavement",
      "alternate_labels": [
        "Slavery"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Being owned and controlled by another person, with no freedom to make decisions."
        }
      ]
    },
    "spa": {
      "preferred_label": "esclavitud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Estar bajo la propiedad y el control de otra persona, sin libertad para tomar decisiones."
        }
      ]
    },
    "fra": {
      "preferred_label": "esclavage",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait d'être la propriété d'une autre personne et sous son contrôle, sans liberté de prendre des décisions."
        }
      ]
    },
    "ind": {
      "preferred_label": "perhambaan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dimiliki dan dikendalikan oleh orang lain, tanpa kebebasan untuk mengambil keputusan."
        }
      ]
    },
    "por": {
      "preferred_label": "escravidão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser propriedade e estar sob o controle de outra pessoa, sem a liberdade de tomar decisões."
        }
      ]
    },
    "apd": {
      "preferred_label": "عبودية",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنو الزول يكون ملك لزول تاني ومتحكم فيهو، ومن غير حرية عشان ياخد قرارات."
        }
      ]
    },
    "arb": {
      "preferred_label": "عبودية",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يكون المرء مملوكًا ومسيطرًا عليه من قِبل شخص آخر، دون أدنى حرية في اتخاذ القرارات."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin blong slef",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong stap aninit long han blong wan narafala man we hem i bos long yu, we yu no fri nating blong jusum wanem yu wantem mekem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bauta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa a ƙarƙashin mallakar wani mutum da ikon sa, ba tare da ’yancin yanke shawara ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "दासत्व",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी अन्य व्यक्ति के अधीन और नियंत्रण में होना, तथा निर्णय लेने की कोई स्वतंत्रता न होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịbụ ohu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye onye ọzọ nwere ma na-achịkwa, n'enweghị nnwere onwe ime mkpebi."
        }
      ]
    },
    "nep": {
      "preferred_label": "दासत्व",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै निर्णय गर्ने स्वतन्त्रता नभई अर्को व्यक्तिको अधीन र नियन्त्रणमा रहनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Рабство",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пребывание в собственности и под властью другого человека без свободы принимать решения."
        }
      ]
    },
    "swh": {
      "preferred_label": "Utumwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumilikiwa na kutawaliwa na mtu mwingine, bila uhuru wa kufanya maamuzi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin bilong stap wokboi nating",
      "descriptions": [
        {
          "source": "acai",
          "description": "Stap aninit long narapela man i bosim na lukautim yu olsem samting bilong em yet, na yu no gat fridom long mekim ol disisen."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cảnh nô lệ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bị người khác sở hữu và kiểm soát, không có tự do để đưa ra quyết định."
        }
      ]
    },
    "zhs": {
      "preferred_label": "受奴役",
      "descriptions": [
        {
          "source": "acai",
          "description": "受另一个人所有和控制，没有自由做决定。"
        }
      ]
    },
    "zht": {
      "preferred_label": "為奴",
      "descriptions": [
        {
          "source": "acai",
          "description": "被他人所擁有和控制，毫無作決定的自由。"
        }
      ]
    }
  },
