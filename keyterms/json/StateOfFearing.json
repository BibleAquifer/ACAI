{
  "id": "keyterm:StateOfFearing",
  "primary_id": "keyterm:Fear",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "003082001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Awe (State)",
      "alternate_labels": [
        "Standing in Awe"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Feeling deep respect mixed with fear, often toward God or something very powerful."
        }
      ]
    },
    "spa": {
      "preferred_label": "temor reverente (estado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentimiento de profundo respeto mezclado con temor, a menudo hacia Dios o hacia algo muy poderoso."
        }
      ]
    },
    "fra": {
      "preferred_label": "crainte (état)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentiment de profond respect mêlé de crainte, souvent envers Dieu ou une réalité très puissante."
        }
      ]
    },
    "ind": {
      "preferred_label": "rasa takut (keadaan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Merasakan rasa hormat yang mendalam bercampur rasa takut atau gentar, sering kali terhadap Allah atau sesuatu yang sangat berkuasa."
        }
      ]
    },
    "por": {
      "preferred_label": "temor (estado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentimento de profundo respeito misturado com temor, frequentemente em relação a Deus ou a algo muito poderoso."
        }
      ]
    },
    "apd": {
      "preferred_label": "مهابة (حالة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إحساس بالاحترام الشديد مخلوط بالخوف، غالباً تجاه الله أو حاجة قوية شديد."
        }
      ]
    },
    "arb": {
      "preferred_label": "مهابة (حالة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الشعور باحترام عميق ممزوج بالرهبة أو الخوف، لا سيما تجاه الله أو كائن ذي سلطان عظيم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ona mo fraet (Situesen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong gat bigfala ona mo rispek wetem fraet, plante taem i go long God no wan samting we i gat bigfala paoa."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tsoro da Ban-Girma (Hali)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jin matuƙar girmamawa mai gauraye da tsoro, sau da yawa ga Allah ko ga wani abu mai iko ƙwarai."
        }
      ]
    },
    "hin": {
      "preferred_label": "भय (अवस्था)",
      "descriptions": [
        {
          "source": "acai",
          "description": "भय मिश्रित गहरा आदर महसूस करना, प्रायः परमेश्वर या किसी अत्यंत सामर्थी के प्रति।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Egwu na nkwanye ùgwù (Ọnọdụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe nkwanye ùgwù miri emi agwakọtara na egwu, karịsịa nʼebe Chineke nọ maọbụ ihe dị ike nke ukwuu."
        }
      ]
    },
    "nep": {
      "preferred_label": "भय (अवस्था)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः परमेश्‍वर वा अत्यन्त शक्तिशाली कुराप्रति डरमिश्रित गहिरो आदर महसुस गर्ने अवस्था।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Благоговение (состояние)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Глубокое почтение, смешанное со страхом, чаще всего по отношению к Богу или чему-то могущественному."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kicho (Hali)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kujisikia heshima kubwa iliyochanganyika na hofu, mara nyingi kuelekea Mungu au kitu chenye nguvu sana."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin pret na aninit (pasin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "I gat bikpela rispek wantaim pret, planti taim long God o long wanpela samting i gat bikpela strong tru."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kính sợ (Trạng thái)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cảm giác vô cùng tôn kính pha lẫn sợ hãi, thường hướng về Đức Chúa Trời hoặc điều gì đó hết sức uy quyền."
        }
      ]
    },
    "zhs": {
      "preferred_label": "敬畏 (状态)",
      "descriptions": [
        {
          "source": "acai",
          "description": "夹杂着惧怕的深切敬重之感，通常是针对上帝或极其强大的事物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "敬畏 (狀態)",
      "descriptions": [
        {
          "source": "acai",
          "description": "感受到深深的敬意並伴有恐懼，通常是針對上帝或極有威能之事物。"
        }
      ]
    }
  },
  "referred_to_as": [
