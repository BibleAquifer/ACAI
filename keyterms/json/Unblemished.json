{
  "id": "keyterm:Unblemished",
  "primary_id": "keyterm:Unblemished",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "88.34",
    "79.61"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Unblemished",
      "alternate_labels": [
        "Blameless"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Having no defects or faults; being morally pure and without blame."
        }
      ]
    },
    "spa": {
      "preferred_label": "sin mancha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que no tiene defectos ni faltas; ser moralmente puro y sin mancha."
        }
      ]
    },
    "fra": {
      "preferred_label": "sans défaut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sans défaut ni imperfection ; être moralement pur et sans reproche."
        }
      ]
    },
    "ind": {
      "preferred_label": "tak bercacat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak memiliki cacat atau cela; murni secara moral dan tanpa cela."
        }
      ]
    },
    "por": {
      "preferred_label": "sem defeito",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não ter defeitos ou falhas; ser moralmente puro e inculpável."
        }
      ]
    },
    "apd": {
      "preferred_label": "بلا عيب",
      "descriptions": [
        {
          "source": "acai",
          "description": "الما عندو أي عيب أو نقص؛ نقي في الأخلاق وما عليهو لوم."
        }
      ]
    },
    "arb": {
      "preferred_label": "بِلَا عَيْبٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "خَالٍ مِنَ الْعُيُوبِ أَوِ النَّقَائِصِ؛ طَاهِرٌ أَخْلَاقِيًّا وَبِلَا لَوْمٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Klin gud we i no gat mak",
      "descriptions": [
        {
          "source": "acai",
          "description": "We i no gat wan samting i rong long hem; i klin gud long saed blong laef mo i no gat rabis poen nating long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Marar Aibi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin aibi ko lahani; kasancewa mai tsarki a ɗabi'ance da marar abin zargi."
        }
      ]
    },
    "hin": {
      "preferred_label": "निष्कलंक",
      "descriptions": [
        {
          "source": "acai",
          "description": "जिसमें कोई खोट या दोष न हो; नैतिक रूप से शुद्ध और निर्दोष होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Na-enweghị ntụpọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Enweghị ntụpọ maọbụ mmejọ ọbụla; ịdị ọcha nʼakparamàgwà mmadụ na enweghị ịta ụta."
        }
      ]
    },
    "nep": {
      "preferred_label": "दोषरहित",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै खोट वा दोष नभएको; नैतिक रूपमा शुद्ध र निष्कलङ्क भएको अवस्था।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Непорочный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Не имеющий изъянов или недостатков; морально чистый и безупречный."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bila Dosari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutokuwa na hitilafu wala dosari; kuwa safi kimaadili na bila lawama."
        }
      ]
    },
    "tpi": {
      "preferred_label": "I No Gat Mak o Sua",
      "descriptions": [
        {
          "source": "acai",
          "description": "I no gat mak o sua o hevi samting; klin tru na i no gat asua."
        }
      ]
    },
    "vie": {
      "preferred_label": "không tì vết",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không có khuyết tật hay tì vết; trong sạch về mặt đạo đức và không có chỗ nào đáng chê trách."
        }
      ]
    },
    "zhs": {
      "preferred_label": "无瑕疵",
      "descriptions": [
        {
          "source": "acai",
          "description": "毫无瑕疵或缺点；在道德上纯全、无可指责。"
        }
      ]
    },
    "zht": {
      "preferred_label": "無瑕疵",
      "descriptions": [
        {
          "source": "acai",
          "description": "毫無瑕疵或缺點；在道德上純全無可責備。"
        }
      ]
    }
  },
