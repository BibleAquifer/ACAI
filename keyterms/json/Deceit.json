  "localizations": {
    "eng": {
      "preferred_label": "Deceit (Act)",
      "alternate_labels": [
        "Betrayal"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "An action where someone lies or tricks another to cause harm or betrayal."
        }
      ]
    },
    "fra": {
      "preferred_label": "tromperie (acte)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Action par laquelle quelqu'un ment ou trompe autrui pour lui causer du tort ou le trahir."
        }
      ]
    },
    "ind": {
      "preferred_label": "penipuan (tindakan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tindakan di mana seseorang berbohong atau memperdaya orang lain sehingga menimbulkan celaka atau pengkhianatan."
        }
      ]
    },
    "apd": {
      "preferred_label": "خداع (عمل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل فيه زول بيكضب أو يخدع زول تاني عشان يسبب ليه أذى أو خيانة."
        }
      ]
    },
    "arb": {
      "preferred_label": "غش (فعل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل يكذب فيه شخص ما أو يخدع غيره ليسبب ضررًا أو خيانة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong giaman (Aksen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan aksen we wan man i giaman long narafala man no i trikim hem blong mekem trabol no fasin blong betrayedem narawan."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ruɗu (Aiki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aiki inda wani yake yin ƙarya ko ruɗin wani don jawo lahani ko cin amana."
        }
      ]
    },
    "hin": {
      "preferred_label": "छल (कार्य)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसा कार्य जिसमें कोई व्यक्ति नुकसान पहुँचाने या विश्वासघात करने के लिए झूठ बोलता है या धोखा देता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aghụghọ (Omume)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe mmadụ mere ebe ọ na-agha ụgha ma ọ bụ na-aghọgbu onye ọzọ iji kpata mmerụ ahụ ma ọ bụ ịrara ya nye."
        }
      ]
    },
    "nep": {
      "preferred_label": "छल (काम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरूलाई हानि पुर्‍याउन वा विश्‍वासघात गर्न कसैले झूट बोल्ने वा झुक्याउने काम।"
        }
      ]
    },
    "por": {
      "preferred_label": "Engano (ato)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma ação em que alguém mente ou engana outra pessoa para causar dano ou traição."
        }
      ]
    },
    "rus": {
      "preferred_label": "Обман (действие)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Действие, при котором кто-то лжет или обманывает другого, чтобы причинить вред или предать."
        }
      ]
    },
    "spa": {
      "preferred_label": "engaño (acto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Acción en la que alguien miente o engaña a otro para causarle daño o traición."
        }
      ]
    },
    "swh": {
      "preferred_label": "Udanganyifu (Kitendo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitendo ambacho mtu husema uongo au kumhadaa mwingine ili kusababisha madhara au usaliti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin giaman (Mekim pasin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pasin we man i tok giaman o trikim narapela man bilong givim bagarap o mekim pasin hapsait long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lừa dối (Hành động)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành động nói dối hoặc lừa gạt người khác nhằm gây tổn hại hoặc bội phản."
        }
      ]
    },
    "zhs": {
      "preferred_label": "诡诈 (行径)",
      "descriptions": [
        {
          "source": "acai",
          "description": "故意通过说谎或诱骗他人来造成伤害或背叛的行径。"
        }
      ]
    },
    "zht": {
      "preferred_label": "詭詐（行為）",
      "descriptions": [
        {
          "source": "acai",
          "description": "某人為造成傷害或背叛而向他人說謊或行欺騙的行為。"
        }
      ]
    }
  },
