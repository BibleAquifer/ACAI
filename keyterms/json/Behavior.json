  "localizations": {
    "eng": {
      "preferred_label": "Behavior",
      "alternate_labels": [
        "Conduct"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "The way a person acts or carries out their daily life that others can see."
        }
      ]
    },
    "spa": {
      "preferred_label": "conducta",
      "descriptions": [
        {
          "source": "acai",
          "description": "La manera en que una persona actúa o se desenvuelve en su vida diaria a la vista de los demás."
        }
      ]
    },
    "fra": {
      "preferred_label": "conduite",
      "descriptions": [
        {
          "source": "acai",
          "description": "La façon dont une personne agit ou mène sa vie quotidienne de manière visible pour les autres."
        }
      ]
    },
    "ind": {
      "preferred_label": "kelakuan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cara seseorang bertindak atau menjalani kehidupan sehari-harinya yang dapat dilihat orang lain."
        }
      ]
    },
    "por": {
      "preferred_label": "conduta",
      "descriptions": [
        {
          "source": "acai",
          "description": "A maneira como uma pessoa age ou conduz sua vida diária diante dos outros."
        }
      ]
    },
    "apd": {
      "preferred_label": "سلوك",
      "descriptions": [
        {
          "source": "acai",
          "description": "الطريقة البتصرّف بيها الزول ولا بعيش بيها حياتو اليومية والناس التانين بشوفوها."
        }
      ]
    },
    "arb": {
      "preferred_label": "سيرة",
      "descriptions": [
        {
          "source": "acai",
          "description": "الطريقة التي يتصرف بها الشخص أو يسلك بها في حياته اليومية أمام الآخرين."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin we wan man i mekem o i karem laef blong hem evri dei we ol narafala man oli save luk."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yadda mutum yake aikatawa ko yake tafiyar da rayuwarsa ta yau da kullum wadda wasu za su iya gani."
        }
      ]
    },
    "hin": {
      "preferred_label": "चाल-चलन",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति के कार्य करने या अपना दैनिक जीवन बिताने का वह तरीका जिसे दूसरे देख सकते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Àgwà",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụzọ mmadụ si akpa àgwà ma ọ bụ na-ebi ndụ ya kwa ụbọchị nke ndị ọzọ na-ahụ anya."
        }
      ]
    },
    "nep": {
      "preferred_label": "आचरण",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरूले देख्‍न सक्‍ने गरी कुनै व्यक्तिको काम गर्ने वा दैनिक जीवन बिताउने शैली।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Поведение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Образ действий человека или то, как протекает его повседневная жизнь на виду у других."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwenendo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jinsi mtu anavyotenda au anavyoendesha maisha yake ya kila siku mbele ya wengine."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin wanpela man i save mekim long olgeta de na ol arapela manmeri inap lukim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Hành vi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cách một người cư xử hoặc sống đời sống hằng ngày mà người khác có thể thấy được."
        }
      ]
    },
    "zhs": {
      "preferred_label": "行为",
      "descriptions": [
        {
          "source": "acai",
          "description": "一个人外在可见的行事为人或日常生活方式。"
        }
      ]
    },
    "zht": {
      "preferred_label": "行為",
      "descriptions": [
        {
          "source": "acai",
          "description": "一個人為人處世或在日常生活中展現給他人看見的舉止作為。"
        }
      ]
    }
  },
