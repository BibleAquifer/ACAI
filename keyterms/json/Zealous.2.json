        }
      ]
    },
    "arb": {
      "preferred_label": "غَيُور",
      "descriptions": [
        {
          "source": "acai",
          "description": "الرَّغْبَةُ الشَّدِيدَةُ فِي أَنْ تَكُونَ مَحَطَّ الاِهْتِمَامِ وَالاِحْتِرَامِ بِسَبَبِ مَكَانَتِكَ."
        }
      ]
    },
    "bis": {
      "preferred_label": "jalus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong wantem tumas we ol man oli lukluk mo ona long yu nomo from posisen blong yu."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai kishi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neman zama ainihin abin da kowa ke maida hankali da girmamawa a kansa saboda matsayinka."
        }
      ]
    },
    "hin": {
      "preferred_label": "जलन रखनेवाला",
      "descriptions": [
        {
          "source": "acai",
          "description": "अपने पद के कारण सम्मान और ध्यान का केंद्र बनने की प्रबल इच्छा रखना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ekworo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe ọchịchọ siri ike ịbụ ebe a na-elekwasị anya na ebe a na-asọpụrụ nʼihi ọnọdụ gị."
        }
      ]
    },
    "nep": {
      "preferred_label": "डाही",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफ्नो ओहोदा वा स्थानको कारणले गर्दा ध्यान र आदरको मुख्य केन्द्र बन्न तीव्र चाहना राख्ने।"
        }
      ]
    },
    "por": {
      "preferred_label": "zeloso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Desejar intensamente ser o centro das atenções e do respeito por causa de sua posição."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ревнитель",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сильное стремление быть в центре внимания и почтения в силу своего положения."
        }
      ]
    },
    "spa": {
      "preferred_label": "celoso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Desear intensamente ser el centro de atención y respeto debido a la propia posición."
        }
      ]
    },
    "swh": {
      "preferred_label": "-enye wivu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutaka sana kuwa kitovu cha kuangaliwa na kuheshimiwa kwa sababu ya cheo au nafasi yako."
        }
      ]
    },
    "tpi": {
      "preferred_label": "No larim wanpela i senisim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igat strongpela laik long ol arapela i mas tingim yu na givim biknem long yu wanpela tasol bikos long posisin bilong yu."
        }
      ]
    },
    "vie": {
      "preferred_label": "kỵ tà",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rất muốn được là trung tâm của sự chú ý và tôn kính vì địa vị của mình (thường dùng để chỉ tính chất kỵ tà/ghen tuông của Đức Chúa Trời)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "忌邪",
      "descriptions": [
        {
          "source": "acai",
          "description": "因自己的地位而极力想要成为注意与尊重的中心。"
        }
      ]
    },
    "zht": {
      "preferred_label": "忌邪的",
      "descriptions": [
        {
          "source": "acai",
          "description": "因自己的地位而強烈渴望成為關注與尊重的焦點。"
        }
      ]
    }
