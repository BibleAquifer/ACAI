      "alternate_labels": [
        "Question",
        "Discern",
        "Judge",
        "Be Discerned (Pass.)"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To carefully look at something to understand it better and decide if it is true or right."
        }
      ]
    },
    "spa": {
      "preferred_label": "examinar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Observar atentamente algo para comprenderlo mejor y determinar si es verdadero o correcto."
        }
      ]
    },
    "fra": {
      "preferred_label": "examiner",
      "descriptions": [
        {
          "source": "acai",
          "description": "Examiner attentivement quelque chose afin de mieux le comprendre et d'établir si cela est vrai ou juste."
        }
      ]
    },
    "ind": {
      "preferred_label": "menyelidiki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Melihat atau menyelidiki sesuatu dengan saksama untuk lebih memahaminya dan menentukan apakah itu benar atau tepat."
        }
      ]
    },
    "por": {
      "preferred_label": "examinar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Examinar algo com cuidado para compreender melhor e decidir se é verdadeiro ou correto."
        }
      ]
    },
    "apd": {
      "preferred_label": "يفحص",
      "descriptions": [
        {
          "source": "acai",
          "description": "الواحد يعاين لحاجة بدقة عشان يفهمها أحسن ويقرر إذا كانت صحيحة أو حقيقية."
        }
      ]
    },
    "arb": {
      "preferred_label": "فحص",
      "descriptions": [
        {
          "source": "acai",
          "description": "النظر بعناية في أمر ما لفهمه بصورة أفضل والحكم إن كان حقًا أو صوابًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "ekyaminen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Luklukgud long wan samting blong kasemsave gud long hem mo luk se hem i tru no i stret."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bincika",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bincika wani abu da kyau domin fahimtarsa sosai da kuma yanke shawara ko gaskiya ne ko daidai."
        }
      ]
    },
    "hin": {
      "preferred_label": "जाँचना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी बात को अच्छी तरह समझने और यह तय करने के लिए कि वह सत्य या उचित है, उसकी सावधानीपूर्वक जाँच-पड़ताल करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Inyocha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iji nlezianya leba anya n'ihe iji ghọtakwuo ya na ikpebi ma ọ bụ eziokwu ma ọ bụ ihe ziri ezi."
        }
      ]
    },
    "nep": {
      "preferred_label": "जाँच्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरालाई अझ राम्ररी बुझ्न र त्यो सत्य वा सही छ भनी निर्णय गर्नलाई त्यसलाई ध्यानपूर्वक हेर्नु वा जाँच्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Исследовать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Внимательно рассматривать что-либо, чтобы лучше это понять и определить, истинно ли оно или правильно."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuchunguza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuangalia kitu kwa makini ili kukielewa vizuri zaidi na kuamua ikiwa ni kweli au sawa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "skelim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lukim gut wanpela samting na skelim bilong save gut long en na save sapos em i tru o i stret."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tra xét",
      "descriptions": [
        {
          "source": "acai",
          "description": "Xem xét kỹ lưỡng một điều gì đó để hiểu rõ hơn và xác định xem điều đó có đúng hay không."
        }
      ]
    },
    "zhs": {
      "preferred_label": "查考",
      "descriptions": [
        {
          "source": "acai",
          "description": "仔细察看某事，以便更清楚地了解它并判断其是否真实或正确。"
        }
      ]
    },
    "zht": {
      "preferred_label": "考查",
      "descriptions": [
        {
          "source": "acai",
          "description": "仔細察看某事，以便更清楚理解並判斷其是否真實或正確。"
        }
      ]
    }
  },
