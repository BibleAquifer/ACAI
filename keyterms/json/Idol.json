  "localizations": {
    "eng": {
      "preferred_label": "Idol",
      "descriptions": [
        {
          "source": "acai",
          "description": "An object that people wrongly worship as a god but has no real power."
        }
      ]
    },
    "spa": {
      "preferred_label": "ídolo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Objeto al que la gente rinde culto erróneamente como si fuera un dios, pero que carece de poder real."
        }
      ]
    },
    "fra": {
      "preferred_label": "idole",
      "descriptions": [
        {
          "source": "acai",
          "description": "Objet que les gens adorent à tort comme un dieu, mais qui n'a aucun pouvoir réel."
        }
      ]
    },
    "ind": {
      "preferred_label": "berhala",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah benda yang salah disembah orang sebagai dewa padahal tidak memiliki kuasa yang nyata."
        }
      ]
    },
    "por": {
      "preferred_label": "ídolo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um objeto que as pessoas adoram erroneamente como um deus, mas que não tem poder real."
        }
      ]
    },
    "apd": {
      "preferred_label": "صنم",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة الناس بيعبدوها غلط كأنها إله، لكن ما عندها أي قوة حقيقية."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَثَن",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَيْءٌ يَعْبُدُهُ ٱلنَّاسُ خَطَأً كَإِلَهٍ لَكِنْ لَا قُوَّةَ حَقِيقِيَّةَ لَهُ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Aedol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we ol man oli mekem rong wosip long hem olsem wan god, be hem i no gat wan paoa nating."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gunkin bauta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da mutane suke bauta masa a matsayin allah bisa kuskure amma ba shi da wani iko na gaske."
        }
      ]
    },
    "hin": {
      "preferred_label": "मूरत",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक ऐसी वस्तु जिसे लोग झूठे रूप में देवता मानकर पूजते हैं, परन्तु उसमें कोई वास्तविक सामर्थ्य नहीं होती।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Arụsị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe ndị mmadụ na-efe nʼụzọ na-ezighị ezi dị ka chi mana nke na-enweghị ezigbo ike ọ bụla."
        }
      ]
    },
    "nep": {
      "preferred_label": "मूर्ति",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै वस्तु जसलाई मानिसहरूले झूटो रूपमा ईश्‍वर मानेर पूजा गर्छन् तर जसमा कुनै वास्तविक शक्ति हुँदैन।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Идол",
      "descriptions": [
        {
          "source": "acai",
          "description": "Предмет, которому ошибочно поклоняются как божеству, но не имеющий никакой подлинной силы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sanamu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu ambacho watu hukiabudu kimakosa kama mungu lakini hakina nguvu halisi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "giaman god",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting ol manmeri i save lotuim olsem god tasol i no gat wanpela trupela strong."
        }
      ]
    },
    "vie": {
      "preferred_label": "Hình tượng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vật thể mà người ta tôn thờ sai lầm như một vị thần nhưng không có quyền năng thật sự nào."
        }
      ]
    },
    "zhs": {
      "preferred_label": "偶像",
      "descriptions": [
        {
          "source": "acai",
          "description": "人们错误地当作神来敬拜、但并无实际能力的物品。"
        }
      ]
    },
    "zht": {
      "preferred_label": "偶像",
      "descriptions": [
        {
          "source": "acai",
          "description": "人們錯誤地當作神來敬拜，但毫無真正力量的器物。"
        }
      ]
    }
  },
