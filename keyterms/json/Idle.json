  "localizations": {
    "eng": {
      "preferred_label": "Useless",
      "alternate_labels": [
        "Idle",
        "Lazy",
        "Useless",
        "Careless",
        "Ineffective"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Not working or acting, often avoiding work or careful thought."
        }
      ]
    },
    "spa": {
      "preferred_label": "inútil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que no trabaja ni actúa, a menudo evitando el trabajo o la debida reflexión."
        }
      ]
    },
    "fra": {
      "preferred_label": "oisif",
      "descriptions": [
        {
          "source": "acai",
          "description": "Qui ne travaille pas ou n'agit pas, évitant souvent le travail ou la réflexion approfondie."
        }
      ]
    },
    "ind": {
      "preferred_label": "menganggur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak bekerja atau tidak bertindak, sering kali menghindari pekerjaan atau pemikiran yang cermat."
        }
      ]
    },
    "por": {
      "preferred_label": "inútil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não estar trabalhando ou agindo, muitas vezes evitando o trabalho ou a reflexão cuidadosa."
        }
      ]
    },
    "apd": {
      "preferred_label": "كسلان",
      "descriptions": [
        {
          "source": "acai",
          "description": "الما شغال أو ما بيعمل حاجة، وغالباً بيتجنب الشغل أو التفكير الواعي."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَاطِل",
      "descriptions": [
        {
          "source": "acai",
          "description": "عَدَمُ ٱلْعَمَلِ أَوِ ٱلْفِعْلِ، وَغَالِبًا تَجَنُّبُ ٱلْعَمَلِ أَوِ ٱلتَّفْكِيرِ ٱلْمُتَأَنِّي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Leziman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong no wok o no mekem samting, we plante taem man i stap ronwe long wok o no tingting gud."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zaman banza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin aiki ko rashin yin wani abu, sau da yawa ƙaurace wa aiki ko tunani mai kyau."
        }
      ]
    },
    "hin": {
      "preferred_label": "बेकार",
      "descriptions": [
        {
          "source": "acai",
          "description": "कार्य या क्रिया न करना, प्रायः परिश्रम या सावधानीपूर्वक विचार करने से बचना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Enweghị uru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịghara ịrụ ọrụ ma ọ bụ ime ihe, na-ezerekarị ọrụ ma ọ bụ iche echiche nke ọma."
        }
      ]
    },
    "nep": {
      "preferred_label": "व्यर्थ",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै काम वा कार्य नगर्ने, प्रायः काम वा गम्भीर विचार गर्नबाट पन्छिने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Праздный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пребывающий без дела или действия, часто избегающий труда либо внимательного размышления."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutofaa kitu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutofanya kazi au kutotenda, mara nyingi kukwepa kazi au kufikiri kwa makini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "lespasin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong no wok o no mekim wanpela samting, planti taim em pasin bilong les long wok o no tingting gut."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ở không",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không làm việc hoặc không hoạt động, thường là trốn tránh công việc hoặc sự suy xét cẩn thận."
        }
      ]
    },
    "zhs": {
      "preferred_label": "无用",
      "descriptions": [
        {
          "source": "acai",
          "description": "不工作或不行动，往往逃避工作或审慎思考。"
        }
      ]
    },
    "zht": {
      "preferred_label": "閒懶",
      "descriptions": [
        {
          "source": "acai",
          "description": "不工作或不行動，常指逃避工作或不用心思考。"
        }
      ]
    }
  },
