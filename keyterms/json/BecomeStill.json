  "localizations": {
    "eng": {
      "preferred_label": "Become Still",
      "descriptions": [
        {
          "source": "acai",
          "description": "To be quiet and calm, like when a storm stops and everything becomes peaceful."
        }
      ]
    },
    "spa": {
      "preferred_label": "aquietarse",
      "descriptions": [
        {
          "source": "acai",
          "description": "Estar quieto y en calma, como cuando cesa una tormenta y todo queda en paz."
        }
      ]
    },
    "fra": {
      "preferred_label": "s'apaiser",
      "descriptions": [
        {
          "source": "acai",
          "description": "Devenir silencieux et calme, comme lorsqu'une tempête s'arrête et que tout redevient paisible."
        }
      ]
    },
    "ind": {
      "preferred_label": "menjadi tenang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menjadi tenang dan hening, seperti saat badai reda dan segalanya menjadi damai."
        }
      ]
    },
    "por": {
      "preferred_label": "aquietar-se",
      "descriptions": [
        {
          "source": "acai",
          "description": "Estar quieto e calmo, como quando uma tempestade cessa e tudo fica em paz."
        }
      ]
    },
    "apd": {
      "preferred_label": "يهدأ",
      "descriptions": [
        {
          "source": "acai",
          "description": "يبقى هادي وساكت، زي وكتين العاصفة تقيف وكل شي يبقى مسالم."
        }
      ]
    },
    "arb": {
      "preferred_label": "يسكن",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يصير المرء هادئًا وساكنًا، كأن تهدأ العاصفة ويحلّ السلام في كل مكان."
        }
      ]
    },
    "bis": {
      "preferred_label": "kam kwaet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong stap kwaet mo kwaet gud, olsem taem wan bigfala win i finis mo evri samting i kam kwaet mo gat pis."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zama shiru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zama shiru da kwanciyar hankali, kamar lokacin da hadari ya lafa kome ya zama lafiya lafiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "शांत होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "शांत और स्थिर होना, जैसे कि जब आंधी-तूफान थम जाता है और सब कुछ शांत हो जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Dajụọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịdị jụụ ma dajụọ, dị ka mgbe oké ifufe kwụsịrị ma ihe niile dịrị nʼudo."
        }
      ]
    },
    "nep": {
      "preferred_label": "शान्त हुनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "शान्त र स्थिर हुनु, जस्तै आँधी थामिएपछि सबै कुरा शान्त बन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Утихать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Быть тихим и спокойным, подобно тому как прекращается буря и все вокруг успокаивается."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutulia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutulia na kuwa kimya, kama dhoruba inapotulia na kila kitu kuwa na amani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Stap isi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long stap isi na no mekim nois, olsem taim bikpela win i dai na olgeta samting i stap bel isi."
        }
      ]
    },
    "vie": {
      "preferred_label": "Yên lặng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yên lặng và phẳng lặng, như khi cơn bão dứt và mọi sự trở nên thanh bình."
        }
      ]
    },
    "zhs": {
      "preferred_label": "平静",
      "descriptions": [
        {
          "source": "acai",
          "description": "平静下来，安静祥和，就像风暴平息后一切归于平静。"
        }
      ]
    },
    "zht": {
      "preferred_label": "平靜",
      "descriptions": [
        {
          "source": "acai",
          "description": "安靜下來、平息，如同風暴止息後萬物歸於平靜。"
        }
      ]
    }
  },
