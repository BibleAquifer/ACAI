{
  "id": "keyterm:BringHonorAndGloryOnOneself",
  "primary_id": "keyterm:BringHonorAndGloryOnOneself",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "003220001007000",
    "003220001009000",
    "003220001015000",
    "003220001010000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Bring Honor and Glory on Oneself",
      "descriptions": [
        {
          "source": "acai",
          "description": "To receive respect and praise because of one's actions or character."
        }
      ]
    },
    "spa": {
      "preferred_label": "cubrirse de honra y gloria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recibir respeto y alabanza debido a las acciones o el carácter de uno mismo."
        }
      ]
    },
    "fra": {
      "preferred_label": "s'attirer l'honneur et la gloire",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recevoir le respect et la louange en raison de ses actes ou de son caractère."
        }
      ]
    },
    "ind": {
      "preferred_label": "mendatangkan kehormatan dan kemuliaan bagi diri sendiri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menerima rasa hormat dan pujian karena perbuatan atau karakter seseorang."
        }
      ]
    },
    "por": {
      "preferred_label": "granjear honra e glória para si mesmo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Receber respeito e louvor por causa das ações ou do caráter de alguém."
        }
      ]
    },
    "apd": {
      "preferred_label": "يجيب الكرامة والمجد لنفسه",
      "descriptions": [
        {
          "source": "acai",
          "description": "نيل الاحترام والمديح بسبب أفعال الزول أو شخصيته."
        }
      ]
    },
    "arb": {
      "preferred_label": "نالَ إكراماً ومَجْداً",
      "descriptions": [
        {
          "source": "acai",
          "description": "نيل الاحترام والمديح بسبب أفعال المرء أو شخصيته."
        }
      ]
    },
    "bis": {
      "preferred_label": "Karem ona mo glori i kam long yu wan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong kasem respek mo presem nem from ol aksen no fasin blong wan man."
        }
      ]
    },
    "hau": {
      "preferred_label": "Nemo wa kai girma da ɗaukaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samun girmamawa da yabo saboda ayyukan mutum ko halinsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "अपने लिए आदर और महिमा पाना",
      "descriptions": [
        {
          "source": "acai",
          "description": "अपने कर्मों या चरित्र के कारण सम्मान और प्रशंसा प्राप्त करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Iweta nsọpụrụ na otuto nʼonwe onye",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịnata nkwanye ùgwù na otuto n'ihi omume ma ọ bụ agwa mmadụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "आफैँमाथि आदर र महिमा ल्याउनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफ्नो काम वा चरित्रको कारणले आदर र प्रशंसा पाउनु वा कमाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Стяжать честь и славу",
      "descriptions": [
        {
          "source": "acai",
          "description": "Получать уважение и славу благодаря своим поступкам или характеру."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kujiletea Heshima na Utukufu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kupokea heshima na sifa kwa sababu ya matendo au tabia ya mtu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kisim biknem na glori long yu yet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kisim rispek na amamas bilong pasin o gutpela nem bilong wanpela man yet."
        }
      ]
    },
    "vie": {
      "preferred_label": "Được tôn vinh và vinh hiển",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nhận được sự tôn trọng và khen ngợi vì hành động hoặc phẩm cách của một người."
        }
      ]
    },
    "zhs": {
      "preferred_label": "使自己得荣耀尊贵",
      "descriptions": [
        {
          "source": "acai",
          "description": "因个人的行为或品格而获得尊重和赞美。"
        }
      ]
    },
    "zht": {
      "preferred_label": "使自己得尊榮",
      "descriptions": [
        {
          "source": "acai",
          "description": "因著個人的行為或品格而獲得尊重與讚美。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:TreatWithHonorAndRespect",
    "keyterm:WorthyOfHonor"
  ],
