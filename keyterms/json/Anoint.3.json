  ],
  "localizations": {
    "eng": {
      "preferred_label": "Anoint (Assign)",
      "alternate_labels": [
        "Assign",
        "Appoint"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To choose and give someone a special job with God's blessing and power."
        }
      ]
    },
    "spa": {
      "preferred_label": "ungir (asignar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elegir a alguien y asignarle una labor especial con la bendición y el poder de Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "oindre (investir)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Choisir quelqu'un et lui confier une tâche spéciale avec la bénédiction et la puissance de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengurapi (menugaskan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memilih dan memberi seseorang tugas khusus disertai berkat dan kuasa Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "ungir (designar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Escolher e designar alguém para uma função especial com a bênção e o poder de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "مسح (تكليف)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اختيار زول وتكليفه بمهمة خاصة مع بركة الله وقوته."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَسَحَ (عَيَّنَ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اختِيارُ شَخصٍ وَإِعطاؤُهُ مَهَمَّةً خاصَّةً بِبَرَكَةِ اللهِ وَقُوَّتِهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "jusumaot (wok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong jusumaot mo givim wan spesel wok long wan man wetem blesing mo paoa blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shafa (Ɗora wa Aiki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zaɓa da kuma ba wani aiki na musamman tare da albarka da ikon Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "अभिषेक करना (नियुक्त करना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर की आशीष और सामर्थ्य के साथ किसी विशेष कार्य के लिए किसी को चुनना और नियुक्त करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịte mmanụ (Ịhọpụta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịhọpụta na inye mmadụ ọrụ pụrụ iche site na ngọzi na ike nke Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "अभिषेक गर्नु (नियुक्त गर्नु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वरको आशिष्‌ र सामर्थ्यसहित कसैलाई कुनै विशेष कामका लागि चुन्नु र सुम्पनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "помазывать (назначать)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Избирать и наделять кого-либо особым поручением с Божьим благословением и силой."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutia mafuta (Kuteua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumchagua na kumpa mtu kazi maalum pamoja na baraka na nguvu za Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "makim (givim wok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Makim wanpela manmeri na givim bikpela wok wantaim blesing na strong bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Xức dầu (bổ nhiệm)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tuyển chọn và giao cho ai đó một trọng trách đặc biệt với phước hạnh và quyền năng của Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "膏立 (委任)",
      "descriptions": [
        {
          "source": "acai",
          "description": "借着上帝的赐福与大能，拣选并交付某人一项特殊的使命。"
        }
      ]
    },
    "zht": {
      "preferred_label": "膏立 (委派)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以神的賜福和能力，揀選並託付某人承擔一項特殊的職責。"
        }
      ]
    }
  },
