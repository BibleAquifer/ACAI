{
  "id": "keyterm:LoveOfMoney",
  "primary_id": "keyterm:LoveOfMoney",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "25.107"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Love of Money",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanting money or wealth very much, often more than what is good or right."
        }
      ]
    },
    "spa": {
      "preferred_label": "amor al dinero",
      "descriptions": [
        {
          "source": "acai",
          "description": "Desear mucho el dinero o las riquezas, a menudo más de lo que es bueno o correcto."
        }
      ]
    },
    "fra": {
      "preferred_label": "amour de l'argent",
      "descriptions": [
        {
          "source": "acai",
          "description": "Désirer ardemment l'argent ou la richesse, souvent plus qu'il n'est bon ou juste."
        }
      ]
    },
    "ind": {
      "preferred_label": "cinta uang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sangat menginginkan uang atau kekayaan, sering kali melebihi apa yang baik atau benar."
        }
      ]
    },
    "por": {
      "preferred_label": "amor ao dinheiro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Desejar muito dinheiro ou riquezas, muitas vezes mais do que é bom ou correto."
        }
      ]
    },
    "apd": {
      "preferred_label": "محبة القروش",
      "descriptions": [
        {
          "source": "acai",
          "description": "الرغبة الشديدة في القروش أو الثروة، غالباً أكتر من الصاح والحق."
        }
      ]
    },
    "arb": {
      "preferred_label": "محبة المال",
      "descriptions": [
        {
          "source": "acai",
          "description": "الرغبة الشديدة في المال أو الثروة، وغالبًا ما تفوق ما هو صالح أو حق."
        }
      ]
    },
    "bis": {
      "preferred_label": "Lavem mane",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong wantem mane no rij samting bitim mak, plante taem i moa bitim samting we i gud no i stret."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙaunar kuɗi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mugun marmari ko ƙaunar kuɗi ko dukiya ƙwarai da gaske, sau da yawa fiye da abin da yake da kyau ko daidai."
        }
      ]
    },
    "hin": {
      "preferred_label": "रुपये का लोभ",
      "descriptions": [
        {
          "source": "acai",
          "description": "धन या संपत्ति की बहुत अधिक चाह रखना, जो अक्सर उचित या भली सीमा से अधिक होती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịhụ ego nʼanya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọchịchọ siri ike ịnwe ego ma ọ bụ akụ̀ na ụba, nke na-akarakarị ihe dị mma ma ọ bụ ziri ezi."
        }
      ]
    },
    "nep": {
      "preferred_label": "रुपियाँ-पैसाको प्रेम",
      "descriptions": [
        {
          "source": "acai",
          "description": "पैसा वा धन-सम्पत्तिको अत्यधिक चाहना गर्नु, प्रायः उचित वा असल कुराभन्दा पनि बढी।"
        }
      ]
    },
    "rus": {
      "preferred_label": "сребролюбие",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сильное стремление к деньгам или богатству, часто превышающее то, что правильно и хорошо."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kupenda fedha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutamani sana fedha au utajiri, mara nyingi zaidi ya kile kilicho chema au sahihi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong mangalim mani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong mangalim tumas mani o gutpela samting, planti taim em i winim samting i gutpela o stret."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lòng tham tiền bạc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lòng ham muốn tiền bạc hoặc của cải quá mức, thường vượt quá điều tốt lành hoặc đúng đắn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "贪财",
      "descriptions": [
        {
          "source": "acai",
          "description": "极度渴望金钱或财富，往往超过了美善或正义的限度。"
        }
      ]
    },
    "zht": {
      "preferred_label": "貪財",
      "descriptions": [
        {
          "source": "acai",
          "description": "極其渴望金錢或財富，往往超過良善或正義的事物。"
        }
      ]
    }
  },
