{
  "id": "keyterm:Offering.3",
  "primary_id": "keyterm:Offering",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "localizations": {
    "eng": {
      "preferred_label": "Offering (Special)",
      "alternate_labels": [
        "Contribution",
        "Special Portion"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A special gift given to God, often as a sign of dedication or thanks."
        }
      ]
    },
    "fra": {
      "preferred_label": "offrande (spéciale)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un don particulier fait à Dieu, souvent en signe de consécration ou de reconnaissance."
        }
      ]
    },
    "ind": {
      "preferred_label": "persembahan (khusus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pemberian khusus kepada Allah, sering kali sebagai tanda penyerahan atau ucapan syukur."
        }
      ]
    },
    "apd": {
      "preferred_label": "تقدمة (خاصة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "هدية خاصة بتِتقدّم لله، غالباً كعلامة على التكريس أو الشكر."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَقْدِمَة (خَاصَّة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عَطِيَّةٌ خَاصَّةٌ تُقَدَّمُ لِلهِ، غَالِبًا كَعَلَامَةٍ عَلَى ٱلتَّكْرِيسِ أَوِ ٱلشُّكْرِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Presen (Spesel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan spesel presen we man i givim long God, plante taem olsem wan saen blong dedikesen o tangkiu."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hadaya (Ta Musamman)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata kyauta ta musamman da ake ba wa Allah, sau da yawa a matsayin alamar keɓewa ko godiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "भेंट (विशेष)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर को दिया जाने वाला एक विशेष उपहार, जो अक्सर समर्पण या धन्यवाद के चिह्न के रूप में दिया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onyinye (Pụrụ iche)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyinye pụrụ iche e nyere Chineke, na-abụkarị ihe ịrịba ama nke nraranye maọbụ ekele."
        }
      ]
    },
    "nep": {
      "preferred_label": "भेटी (विशेष)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः समर्पण वा धन्यवादको चिन्हको रूपमा परमेश्‍वरलाई दिइने विशेष उपहार।"
        }
      ]
    },
    "por": {
      "preferred_label": "oferta (especial)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma dádiva especial oferecida a Deus, frequentemente como sinal de dedicação ou gratidão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Приношение (особое)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особый дар, приносимый Богу, часто в знак посвящения или благодарности."
        }
      ]
    },
    "spa": {
      "preferred_label": "ofrenda (especial)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ofrenda especial que se da a Dios, a menudo como señal de consagración o agradecimiento."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sadaka (Maalumu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zawadi ya pekee inayotolewa kwa Mungu, mara nyingi kama ishara ya kujiweka wakfu au shukrani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ofa (Spesel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela spesel presen ol i givim long God, planti taim olsem mak bilong dediketim o tenkyu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ vật (Đặc biệt)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một của lễ đặc biệt dâng lên Đức Chúa Trời, thường như một dấu hiệu của sự cung hiến hoặc cảm tạ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "奉献（特别）",
      "descriptions": [
        {
          "source": "acai",
          "description": "献给上帝的特别礼物，通常作为奉献或感恩的标志。"
        }
      ]
    },
    "zht": {
      "preferred_label": "供物（特別）",
      "descriptions": [
        {
          "source": "acai",
          "description": "獻給上帝的特別禮物，常作為奉獻或感恩的標記。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Offering"
  ],
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
