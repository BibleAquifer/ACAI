{
  "id": "keyterm:Inherit",
  "primary_id": "keyterm:Dispossess",
  "type": "keyterm",
  "keyterm_type": "miscellaneous",
  "ubsdbh": [
    "003132001001000",
    "003132001002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Inherit",
      "alternate_labels": [
        "Possess"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To receive land or other things from someone, usually after they die."
        }
      ]
    },
    "spa": {
      "preferred_label": "heredar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recibir tierras u otras cosas de alguien, por lo general después de su muerte."
        }
      ]
    },
    "fra": {
      "preferred_label": "hériter",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recevoir un territoire ou d’autres biens de quelqu’un, généralement après sa mort."
        }
      ]
    },
    "ind": {
      "preferred_label": "mewarisi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menerima tanah atau hal-hal lain dari seseorang, biasanya setelah orang tersebut meninggal."
        }
      ]
    },
    "por": {
      "preferred_label": "herdar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Receber terras ou outras coisas de alguém, geralmente após a morte dessa pessoa."
        }
      ]
    },
    "apd": {
      "preferred_label": "يورث",
      "descriptions": [
        {
          "source": "acai",
          "description": "ياخد أرض أو حاجات تانية من زول، غالباً بعد ما يموت."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَرِثَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يَنَالَ الشَّخْصُ أرْضًا أو أُمورًا أُخْرى مِنْ أحَدٍ، عادَةً بَعْدَ وَفاتِهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "kasem laen samting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong kasem graon no ol narafala samting long wan man, plante taem afta we hem i ded."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gādo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Karɓar ƙasa ko wasu abubuwa daga wani, yawanci bayan mutuwarsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "अधिकार पाना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी से भूमि या अन्य वस्तुएँ प्राप्त करना, आमतौर पर उसकी मृत्यु के बाद।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Iketa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inweta ala maọbụ ihe ndị ọzọ site nʼaka mmadụ, ọkachasị mgbe ha nwụsịrị."
        }
      ]
    },
    "nep": {
      "preferred_label": "उत्तराधिकारमा पाउनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः कसैको मृत्युपछि तिनीहरूबाट जमिन वा अन्य थोकहरू प्राप्त गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "наследовать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Получать землю или другое имущество от кого-либо, обычно после его смерти."
        }
      ]
    },
    "swh": {
      "preferred_label": "Rithi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kupokea ardhi au vitu vingine kutoka kwa mtu, kwa kawaida baada ya kufa kwake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kisim graun o samting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kisim graun o ol arapela samting long wanpela man o meri, planti taim em bihain long ol i dai pinis."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kế tự",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nhận đất đai hoặc những thứ khác từ một người nào đó, thường là sau khi người ấy qua đời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "继承",
      "descriptions": [
        {
          "source": "acai",
          "description": "从某人那里继承土地或其他财物，通常发生在对方去世之后。"
        }
      ]
    },
    "zht": {
      "preferred_label": "承受為業",
      "descriptions": [
        {
          "source": "acai",
          "description": "從某人那裡繼承土地或其他事物，通常是在其過世之後。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Dispossess"
  ],
