  "localizations": {
    "eng": {
      "preferred_label": "Become Worthless",
      "alternate_labels": [
        "Become Nonsense"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To stop being useful or important, becoming like nonsense or having no value."
        }
      ]
    },
    "spa": {
      "preferred_label": "hacerse vano",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dejar de ser útil o importante, volviéndose como algo sin sentido o sin valor."
        }
      ]
    },
    "fra": {
      "preferred_label": "perdre sa valeur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cesser d'être utile ou important, perdre toute valeur ou devenir insignifiant."
        }
      ]
    },
    "ind": {
      "preferred_label": "menjadi sia-sia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Berhenti menjadi berguna atau penting, menjadi seperti omong kosong atau tidak bernilai."
        }
      ]
    },
    "por": {
      "preferred_label": "tornar-se inútil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Deixar de ser útil ou importante, tornando-se sem sentido ou sem valor."
        }
      ]
    },
    "apd": {
      "preferred_label": "يبقى بلا فايدة",
      "descriptions": [
        {
          "source": "acai",
          "description": "يبطّل يكون مفيد ولا مهم، ويبقى زي الفارغ ولا ما عندو أي قيمة."
        }
      ]
    },
    "arb": {
      "preferred_label": "يصير باطلًا",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يتوقف عن كونه نافعًا أو مهمًا، فيصير بلا قيمة أو كشيء باطل."
        }
      ]
    },
    "bis": {
      "preferred_label": "kam nating",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong no moa gat wok blong hem o impoten, we i kam olsem samting we i blong nating nomo o i no gat valyu."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zama banza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dainawa zama mai amfani ko mai muhimmanci, ya zama kamar banza ko kuma marar amfani ko daraja."
        }
      ]
    },
    "hin": {
      "preferred_label": "व्यर्थ होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "उपयोगी या महत्वपूर्ण न रह जाना, व्यर्थ हो जाना या जिसका कोई मूल्य न रहे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịghọ ihe na-abaghị uru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịkwụsị ịba uru ma ọ bụ ịbụ ihe dị mkpa, ịghọ ihe na-enweghị isi ma ọ bụ ihe na-enweghị uru."
        }
      ]
    },
    "nep": {
      "preferred_label": "व्यर्थ हुनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "उपयोगी वा महत्त्वपूर्ण हुन छाड्नु, निरर्थक बन्नु वा कुनै मोल नहुनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Становиться негодным",
      "descriptions": [
        {
          "source": "acai",
          "description": "Перестать быть полезным или важным, уподобившись бессмыслице или потеряв всякую ценность."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kukosa Thamani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kukoma kuwa na manufaa au umuhimu, na kuwa kama upuuzi au kutokuwa na thamani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kamap samting nating",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long lusim wok o bikpela nem bilong en, na kamap olsem samting nating o samting i no gat pe o helpim bilong en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Trở nên vô giá trị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không còn hữu ích hay quan trọng nữa, trở nên vô nghĩa hoặc không có giá trị."
        }
      ]
    },
    "zhs": {
      "preferred_label": "变为无用",
      "descriptions": [
        {
          "source": "acai",
          "description": "不再有用或重要，变得荒谬或毫无价值。"
        }
      ]
    },
    "zht": {
      "preferred_label": "變為無用",
      "descriptions": [
        {
          "source": "acai",
          "description": "不再有用或不再重要，變得毫無意義或失去價值。"
        }
      ]
    }
  },
