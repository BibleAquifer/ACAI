  "localizations": {
    "eng": {
      "preferred_label": "Disbelieve",
      "alternate_labels": [
        "Be Unfaithful"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To not accept something as true or to refuse to trust someone or something."
        }
      ]
    },
    "spa": {
      "preferred_label": "no creer",
      "descriptions": [
        {
          "source": "acai",
          "description": "No aceptar algo como verdadero o negarse a confiar en alguien o algo."
        }
      ]
    },
    "fra": {
      "preferred_label": "ne pas croire",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ne pas accepter quelque chose comme vrai ou refuser de faire confiance à quelqu'un ou à quelque chose."
        }
      ]
    },
    "ind": {
      "preferred_label": "tidak percaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak menerima sesuatu sebagai hal yang benar atau menolak untuk memercayai seseorang atau sesuatu."
        }
      ]
    },
    "por": {
      "preferred_label": "não crer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não aceitar algo como verdadeiro ou recusar-se a confiar em alguém ou em algo."
        }
      ]
    },
    "apd": {
      "preferred_label": "ما يصدق",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم قبول حاجة كإنها حقيقة أو رفض الثقة في زول أو حاجة."
        }
      ]
    },
    "arb": {
      "preferred_label": "لَا يُؤْمِن",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم قبول شيء على أنه حقيقة، أو رفض الثقة بشخص ما أو بشيء ما."
        }
      ]
    },
    "bis": {
      "preferred_label": "No bilif",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong no bilif se wan samting i tru no no wantem trastem wan man no wan samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "rashin gaskatawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin yarda da wani abu a matsayin gaskiya ko ƙin amincewa da wani ko wani abu."
        }
      ]
    },
    "hin": {
      "preferred_label": "अविश्वास करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी बात को सच न मानना या किसी व्यक्ति अथवा वस्तु पर भरोसा करने से इनकार करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ekweghị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịghara ịnabata ihe dị ka eziokwu maọbụ ịjụ ịtụkwasị mmadụ maọbụ ihe obi."
        }
      ]
    },
    "nep": {
      "preferred_label": "अविश्वास गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरालाई सत्य नमान्नु वा कसैलाई वा कुनै थोकलाई विश्वास गर्न इन्कार गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Не верить",
      "descriptions": [
        {
          "source": "acai",
          "description": "Не принимать что-либо за истину или отказываться доверять кому-либо или чему-либо."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutoamini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutokukubali kitu kuwa cha kweli au kukataa kumwamini mtu au kitu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "no bilip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong no bilip olsem wanpela samting em i tru o pasin bilong sakim na no bilip long wanpela manmeri o samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Không tin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không chấp nhận điều gì là đúng hoặc từ chối tin cậy ai đó hay điều gì đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "不信",
      "descriptions": [
        {
          "source": "acai",
          "description": "不承认某事属实，或拒绝信任某人或某事。"
        }
      ]
    },
    "zht": {
      "preferred_label": "不信",
      "descriptions": [
        {
          "source": "acai",
          "description": "不承認某事為真，或拒絕信任某人或某事。"
        }
      ]
    }
  },
  "referred_to_as": [
