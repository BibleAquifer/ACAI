{
  "id": "keyterm:Unfaithfulness",
  "primary_id": "keyterm:Unfaithful",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "004218001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Unfaithfulness",
      "alternate_labels": [
        "Treachery"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "The act of breaking promises or not being loyal to what someone has committed to."
        }
      ]
    },
    "spa": {
      "preferred_label": "infidelidad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Acción de romper promesas o no ser leal a aquello con lo que uno se ha comprometido."
        }
      ]
    },
    "fra": {
      "preferred_label": "infidélité",
      "descriptions": [
        {
          "source": "acai",
          "description": "L'acte de rompre des promesses ou de manquer de loyauté envers ce à quoi quelqu'un s'est engagé."
        }
      ]
    },
    "ind": {
      "preferred_label": "ketidaksetiaan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tindakan mengingkari janji atau tidak setia terhadap apa yang telah dikomitmenkan seseorang."
        }
      ]
    },
    "apd": {
      "preferred_label": "عدم أمانة",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل نكث العهود أو عدم الوفاء بالشيء الإلتزم بيه الزول."
        }
      ]
    },
    "arb": {
      "preferred_label": "خِيَانَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل نقض العهود أو عدم الأمانة تجاه ما التزم به المرء."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin blong no stap tru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong brokempromis o no stap tru long samting we man i bin mekem promes blong mekem."
        }
      ]
    },
    "hau": {
      "preferred_label": "cin amana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aikin karya alkawura ko rashin yin aminci ga abin da mutum ya ɗauki alkawari a kai."
        }
      ]
    },
    "hin": {
      "preferred_label": "विश्वासघात",
      "descriptions": [
        {
          "source": "acai",
          "description": "वादों को तोड़ने या जिसके प्रति प्रतिबद्धता जताई गई हो उसके प्रति निष्ठावान न रहने का कार्य।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ekwesighị ntụkwasị obi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Omume nke imebi nkwa ma ọ bụ enweghị iguzosi ike n'ihe nye ihe mmadụ kwere na ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "विश्‍वासहीनता",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफूले गरेको प्रतिबद्धता पूरा नगर्ने वा प्रतिज्ञा तोड्ने काम।"
        }
      ]
    },
    "por": {
      "preferred_label": "infidelidade",
      "descriptions": [
        {
          "source": "acai",
          "description": "O ato de quebrar promessas ou não ser leal àquilo com o que se comprometeu."
        }
      ]
    },
    "rus": {
      "preferred_label": "неверность",
      "descriptions": [
        {
          "source": "acai",
          "description": "Нарушение обещаний или неверность тому, чему человек себя посвятил."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutokuwa mwaminifu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitendo cha kuvunja ahadi au kutokuwa mwaminifu kwa kile mtu alichojitoa kwacho."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin bilong no stap gut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong brukim promis o no stap gut long ol promis o samting man i bin tok long mekim."
        }
      ]
    },
    "vie": {
      "preferred_label": "sự bất trung",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành động thất hứa hoặc không trung thành với điều mình đã cam kết."
        }
      ]
    },
    "zhs": {
      "preferred_label": "不忠",
      "descriptions": [
        {
          "source": "acai",
          "description": "违背诺言，或对自己所承诺之事不忠实的行为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "不忠",
      "descriptions": [
        {
          "source": "acai",
          "description": "背棄承諾或不忠於自己所委身之事的行為。"
        }
      ]
    }
  },
