  "localizations": {
    "eng": {
      "preferred_label": "Woe (Future Suffering)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A strong expression of sadness or warning about bad things that will happen to a person or group."
        }
      ]
    },
    "apd": {
      "preferred_label": "ويل (عذاب في المستقبل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تعبير قوي عن الحزن أو تحذير من حاجات كعبة حتحصل لزول أو لجماعة."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَيْل (مُعَانَاة مُسْتَقْبَلِيَّة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تعبير قوي عن الحزن أو تحذير من أمور سيئة ستحل بشخص أو جماعة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sore tumas (Trabol we i stap kam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan strong tok blong soemaot sore no givim woning long saed blong ol rabis samting we bambae oli hapen long wan man no long wan grup."
        }
      ]
    },
    "fra": {
      "preferred_label": "malheur (souffrance future)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Expression forte de tristesse ou avertissement concernant de grands malheurs qui frapperont une personne ou un groupe."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kaito (Wahala ta Gaba)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kalami mai ƙarfi na baƙin ciki ko gargaɗi game da munanan abubuwan da za su sami mutum ko ƙungiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "हाय (भावी कष्ट)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या समूह पर आने वाली बुरी घटनाओं के विषय में उदासी या चेतावनी की एक प्रबल अभिव्यक्ति।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ahụhụ (Ahụhụ ga-abịa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Okwu siri ike nke mwute ma ọ bụ ịdọ aka ná ntị banyere ihe ọjọọ ga-adakwasị mmadụ ma ọ bụ otu ndị mmadụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "celaka (penderitaan masa depan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ungkapan kesedihan atau peringatan yang keras tentang hal-hal buruk yang akan menimpa seseorang atau kelompok."
        }
      ]
    },
    "nep": {
      "preferred_label": "धिक्कार (भविष्यको दुःख)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै व्यक्ति वा समूहमाथि आइपर्ने खराब कुराहरूका बारेमा गरिने दुःखको वा चेतावनीको कडा अभिव्यक्ति।"
        }
      ]
    },
    "por": {
      "preferred_label": "ai (sofrimento futuro)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Forte expressão de tristeza ou advertência sobre calamidades que sobrevirão a uma pessoa ou grupo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Горе (грядущее страдание)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сильное выражение скорби или предостережение о грядущих бедствиях, которые постигнут человека или народ."
        }
      ]
    },
    "spa": {
      "preferred_label": "¡ay! (sufrimiento futuro)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Expresión enérgica de tristeza o advertencia sobre cosas malas que le ocurrirán a una persona o grupo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ole (Mateso ya Baadaye)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Usemi wenye uzito wa huzuni au onyo kuhusu mambo mabaya yatakayompata mtu au kikundi cha watu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sori tumas (Bagarap bai kamap)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bikpela tok bilong sori o tok lukaut long bikpela hevi na bagarap bai kamap long wanpela man o lain manmeri."
        }
      ]
    },
    "vie": {
      "preferred_label": "Khốn thay (Sự đau khổ tương lai)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lời bày tỏ mạnh mẽ về sự đau buồn hoặc lời cảnh báo về những tai họa sẽ giáng xuống một cá nhân hay một nhóm người."
        }
      ]
    },
    "zhs": {
      "preferred_label": "有祸了 (未来的苦难)",
      "descriptions": [
        {
          "source": "acai",
          "description": "对某人或群体将遭遇的不幸所发出的深切悲伤或警告之词。"
        }
      ]
    },
    "zht": {
      "preferred_label": "禍哉（未來的苦難）",
      "descriptions": [
        {
          "source": "acai",
          "description": "對個人或群體即將遭遇之厄運所發出的強烈悲痛感嘆或警告。"
        }
      ]
    }
  },
