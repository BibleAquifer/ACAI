  "localizations": {
    "eng": {
      "preferred_label": "Fairness (Justice)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Making sure everyone gets what is right and fair, especially in how people are treated and decisions are made."
        }
      ]
    },
    "spa": {
      "preferred_label": "justicia (rectitud)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Asegurarse de que todos reciban lo que es justo y debido, especialmente en el trato a las personas y en la toma de decisiones."
        }
      ]
    },
    "fra": {
      "preferred_label": "équité (justice)",
      "descriptions": [
        {
          "source": "acai",
          "description": "S'assurer que chacun reçoit ce qui est juste et équitable, en particulier dans la manière dont les personnes sont traitées et dont les décisions sont prises."
        }
      ]
    },
    "ind": {
      "preferred_label": "keadilan (keadilan hukum)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memastikan setiap orang memperoleh apa yang benar dan adil, terutama dalam cara memperlakukan orang dan mengambil keputusan."
        }
      ]
    },
    "por": {
      "preferred_label": "equidade (justiça)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Garantir que todos recebam o que é certo e justo, especialmente na maneira como as pessoas são tratadas e as decisões são tomadas."
        }
      ]
    },
    "apd": {
      "preferred_label": "عدل (إنصاف)",
      "descriptions": [
        {
          "source": "acai",
          "description": "التأكد من إنه كل زول ياخد حقه بالعدل والإنصاف، خصوصاً في طريقة معاملة الناس واتخاذ القرارات."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِنْصَاف (عَدْل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "التأكد من نيل الجميع ما هو حق وعادل، لا سيما في طريقة معاملة الناس واتخاذ القرارات."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin we i stret (jastis)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekem sua we evri man oli kasem samting we i stret mo stret nomo, speseli long fasin we oli tritim ol man mo long fasin blong mekem ol desisen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Adalci (Shari'a)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tabbatar da cewa kowa ya sami abin da yake daidai kuma na gaskiya, musamman a yadda ake bi da mutane da kuma yanke shawara."
        }
      ]
    },
    "hin": {
      "preferred_label": "निष्पक्षता (न्याय)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यह सुनिश्चित करना कि सभी को वह मिले जो सही और उचित है, विशेषकर लोगों के साथ किए जाने वाले व्यवहार और निर्णयों में।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikpe ziri ezi (Ikpe ziri ezi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka o doo anya na onye ọ bụla nwetara ihe ziri ezi ma kwụ ọtọ, karịsịa nʼotu e si emeso ndị mmadụ na otu e si eme mkpebi."
        }
      ]
    },
    "nep": {
      "preferred_label": "निष्पक्षता (न्याय)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विशेष गरी मानिसहरूलाई गरिने व्यवहार र लिइने निर्णयहरूमा सबैले सही र उचित कुरा पाएको कुरा सुनिश्चित गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Справедливость (Правосудие)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Обеспечение того, чтобы каждый получал то, что справедливо и правильно, особенно в том, как относятся к людям и как принимаются решения."
        }
      ]
    },
    "swh": {
      "preferred_label": "Usawa (Haki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhakikisha kila mtu anapata yaliyo sawa na ya haki, hasa katika namna watu wanavyotendewa na maamuzi yanavyofanywa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "stretpela pasin (stretpela kot)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim olsem olgeta manmeri i kisim stretpela samting, moa yet long wei bilong mekim pasin long ol na skelim ol kot."
        }
      ]
    },
    "vie": {
      "preferred_label": "Công bằng (Công lý)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bảo đảm mọi người đều nhận được điều đúng đắn và công bằng, đặc biệt là trong cách đối xử và các quyết định được đưa ra."
        }
      ]
    },
    "zhs": {
      "preferred_label": "公正 (公义)",
      "descriptions": [
        {
          "source": "acai",
          "description": "确保人人得到合理且公平的对待，特别是在待人和做决定方面。"
        }
      ]
    },
    "zht": {
      "preferred_label": "公義（公正）",
      "descriptions": [
        {
          "source": "acai",
          "description": "確保每個人都得到應得的公道與公平，特別是在待人接物和做出決策方面。"
        }
      ]
    }
  },
  "referred_to_as": [
