{
  "id": "keyterm:FoolishTalk",
  "primary_id": "keyterm:Foolish",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "33.376"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Foolish Talk",
      "descriptions": [
        {
          "source": "acai",
          "description": "Talking without meaning or sense, often wasting time or not saying anything important."
        }
      ]
    },
    "spa": {
      "preferred_label": "palabrería vacía",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hablar sin sentido ni significado, a menudo perdiendo el tiempo o sin decir nada importante."
        }
      ]
    },
    "fra": {
      "preferred_label": "propos insensés",
      "descriptions": [
        {
          "source": "acai",
          "description": "Parler de manière vide ou dénuée de sens, souvent en perdant son temps ou sans rien dire d'important."
        }
      ]
    },
    "ind": {
      "preferred_label": "omongan kosong",
      "descriptions": [
        {
          "source": "acai",
          "description": "Berbicara tanpa makna atau akal budi, sering kali membuang-buang waktu atau tidak mengatakan hal yang penting."
        }
      ]
    },
    "por": {
      "preferred_label": "conversa tola",
      "descriptions": [
        {
          "source": "acai",
          "description": "Falar sem sentido ou propósito, frequentemente perdendo tempo ou não dizendo nada importante."
        }
      ]
    },
    "apd": {
      "preferred_label": "كلام فارغ",
      "descriptions": [
        {
          "source": "acai",
          "description": "كلام من غير معنى أو فايدة، غالباً تضييع وقت أو ما فيهو أي شي مهم."
        }
      ]
    },
    "arb": {
      "preferred_label": "كلام باطل",
      "descriptions": [
        {
          "source": "acai",
          "description": "الكلام بغير معنى أو عقل، وغالبًا ما يكون مضيعة للوقت أو خاليًا من أي فائدة مهمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Krangke toktok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Toktok we i no gat mining no i no gat hed, we plante taem i stap westem taem nomo mo i no talem wan impoten samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "Maganganun wauta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin magana marar ma’ana ko hankali, sau da yawa ɓata lokaci ko rashin faɗin wani abu mai muhimmanci."
        }
      ]
    },
    "hin": {
      "preferred_label": "मूर्खतापूर्ण बातचीत",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिना किसी अर्थ या समझ के बातें करना, प्रायः समय व्यर्थ करना या कोई महत्वपूर्ण बात न कहना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Okwu nzuzu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikwu okwu na-enweghị isi ma ọ bụ nghọta, na-abụkarị igbu oge ma ọ bụ ịghara ikwu ihe ọ bụla bara uru."
        }
      ]
    },
    "nep": {
      "preferred_label": "मूर्ख कुराकानी",
      "descriptions": [
        {
          "source": "acai",
          "description": "अर्थ वा समझविना बोल्ने, प्रायः समय खेर फाल्ने वा कुनै महत्त्वपूर्ण कुरा नबोल्ने कार्य।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Пустословие",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пустые или бессмысленные разговоры, часто тратящие время впустую или лишенные важного содержания."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mazungumzo ya Upumbavu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuzungumza bila maana wala busara, mara nyingi kupoteza wakati au kutosema jambo lolote la maana."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời nói dại dột",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nói năng vô nghĩa hoặc không có lý lẽ, thường làm lãng phí thì giờ hoặc không nói điều gì quan trọng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "愚妄的言语",
      "descriptions": [
        {
          "source": "acai",
          "description": "毫无意义或不明智的谈论，通常是浪费时间或毫无重要内容。"
        }
      ]
    },
    "zht": {
      "preferred_label": "愚妄的話",
      "descriptions": [
        {
          "source": "acai",
          "description": "毫無意義或常理的說話，往往是浪費時間或言之無物。"
        }
      ]
    }
  },
  "referred_to_as": [
