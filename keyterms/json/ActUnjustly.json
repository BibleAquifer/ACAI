  ],
  "localizations": {
    "eng": {
      "preferred_label": "Act Unjustly",
      "alternate_labels": [
        "Do What Is Wrong",
        "Mistreat"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To do something unfair or wrong, especially by treating others badly."
        }
      ]
    },
    "spa": {
      "preferred_label": "cometer injusticia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer algo injusto o malo, especialmente al tratar mal a los demás."
        }
      ]
    },
    "fra": {
      "preferred_label": "commettre l'injustice",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faire quelque chose d'injuste ou de mal, en particulier en traitant mal les autres."
        }
      ]
    },
    "ind": {
      "preferred_label": "berbuat tidak adil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Melakukan sesuatu yang tidak adil atau salah, terutama dengan memperlakukan orang lain secara buruk."
        }
      ]
    },
    "por": {
      "preferred_label": "cometer injustiça",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fazer algo injusto ou errado, especialmente tratando mal os outros."
        }
      ]
    },
    "apd": {
      "preferred_label": "يظلم",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل شيء غير عادل أو خاطئ، وبخاصة معاملة الآخرين معاملة سيئة أو ظلمهم."
        }
      ]
    },
    "arb": {
      "preferred_label": "ظُلْم",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل شيء غير عادل أو خاطئ، لا سيما بالإساءة إلى معاملة الآخرين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem i No Stret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem wan samting we i no stret no i rong, speseli taem yu mekem i nogud long narafala man."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin rashin adalci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin wani abu marar adalci ko marar kyau, musamman ta wurin wulaƙanta wasu."
        }
      ]
    },
    "hin": {
      "preferred_label": "अन्याय करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "विशेषकर दूसरों के साथ बुरा व्यवहार करके कोई अनुचित या गलत कार्य करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Imejọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ihe na-ezighị ezi maọbụ ihe ọjọọ, karịsịa site n'imegbu ndị ọzọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "अन्याय गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "अन्यायपूर्ण वा अनुचित काम गर्नु, विशेष गरी अरूसँग नराम्रो व्यवहार गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Обижать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Поступать несправедливо или неправильно, особенно дурно обращаясь с другими."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kudhulumu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kufanya jambo lisilo la haki au baya, hasa kwa kuwatendea wengine vibaya."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim pasin i no stret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long mekim wanpela samting i no stret o mekim rong, moa yet long rot bilong mekim nogut long ol arapela."
        }
      ]
    },
    "vie": {
      "preferred_label": "Hành động bất công",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm điều gì đó bất công hoặc sai trái, đặc biệt là đối xử tệ bạc với người khác."
        }
      ]
    },
    "zhs": {
      "preferred_label": "行不义",
      "descriptions": [
        {
          "source": "acai",
          "description": "做出不公或错误的事，尤指恶待他人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "行事不義",
      "descriptions": [
        {
          "source": "acai",
          "description": "行不公義或錯誤的事，特別是不當對待他人。"
        }
      ]
    }
  },
  "referred_to_as": [
