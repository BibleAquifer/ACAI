  "localizations": {
    "eng": {
      "preferred_label": "Utterance",
      "alternate_labels": [
        "Oracle"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A spoken message from God or a formal statement made by a prophet."
        }
      ]
    },
    "ind": {
      "preferred_label": "ucapan ilahi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pesan yang diucapkan dari Allah atau pernyataan resmi yang disampaikan oleh seorang nabi."
        }
      ]
    },
    "apd": {
      "preferred_label": "وحي",
      "descriptions": [
        {
          "source": "acai",
          "description": "رسالة منطوقة من الله أو إعلان رسمي قاله نبي."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَحْي",
      "descriptions": [
        {
          "source": "acai",
          "description": "رسالة منطوقة من الله أو إعلان رسمي ينطق به نبي."
        }
      ]
    },
    "bis": {
      "preferred_label": "tok we God i givim blong talemaot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan mesej we i kamaot long maot blong God o wan tok we profet i talemaot."
        }
      ]
    },
    "fra": {
      "preferred_label": "oracle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un message prononcé de la part de Dieu ou une déclaration formelle faite par un prophète."
        }
      ]
    },
    "hau": {
      "preferred_label": "saƙo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Saƙo da aka faɗa da baki daga Allah ko kuma maganar da annabi ya bayyana a hukumance."
        }
      ]
    },
    "hin": {
      "preferred_label": "भारी वचन",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर की ओर से बोला गया एक सन्देश या भविष्यद्वक्ता द्वारा दिया गया औपचारिक कथन।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Okwu amụma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ozi a na-ekwu n'ọnụ sitere na Chineke ma ọ bụ nkwupụta iwu nke onye amụma kwuru."
        }
      ]
    },
    "nep": {
      "preferred_label": "घोषणा",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरबाट बोलिएको कुनै सन्देश वा अगमवक्ताद्वारा गरिएको औपचारिक घोषणा।"
        }
      ]
    },
    "por": {
      "preferred_label": "pronunciamento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma mensagem falada da parte de Deus ou uma declaração formal feita por um profeta."
        }
      ]
    },
    "rus": {
      "preferred_label": "пророческое слово",
      "descriptions": [
        {
          "source": "acai",
          "description": "Изреченное послание от Бога или торжественное заявление, сделанное пророком."
        }
      ]
    },
    "spa": {
      "preferred_label": "profecía",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mensaje hablado de parte de Dios o declaración formal pronunciada por un profeta."
        }
      ]
    },
    "swh": {
      "preferred_label": "Neno la unabii",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ujumbe unaonenwa kutoka kwa Mungu au kauli rasmi inayotolewa na nabii."
        }
      ]
    },
    "tpi": {
      "preferred_label": "tok profet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela tok i kam long God o wanpela bikpela tok profet i autim."
        }
      ]
    },
    "vie": {
      "preferred_label": "sứ điệp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thông điệp bằng lời phán từ Đức Chúa Trời hoặc một lời tuyên bố chính thức do một nhà tiên tri công bố."
        }
      ]
    },
    "zhs": {
      "preferred_label": "默示",
      "descriptions": [
        {
          "source": "acai",
          "description": "来自上帝的传讲信息，或先知所作的正式宣告（默示）。"
        }
      ]
    },
    "zht": {
      "preferred_label": "默示",
      "descriptions": [
        {
          "source": "acai",
          "description": "來自上帝口傳的信息，或先知所作的正式宣告。"
        }
      ]
    }
  },
