  "localizations": {
    "eng": {
      "preferred_label": "Proclaim",
      "alternate_labels": [
        "Announce"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To announce something important clearly and loudly so everyone can hear."
        }
      ]
    },
    "spa": {
      "preferred_label": "proclamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anunciar algo importante de manera clara y en voz alta para que todos puedan oír."
        }
      ]
    },
    "fra": {
      "preferred_label": "proclamer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Annoncer clairement et à haute voix quelque chose d'important pour que chacun puisse l'entendre."
        }
      ]
    },
    "ind": {
      "preferred_label": "memberitakan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengumumkan sesuatu yang penting dengan jelas dan lantang sehingga semua orang dapat mendengar."
        }
      ]
    },
    "por": {
      "preferred_label": "proclamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anunciar algo importante de maneira clara e em alta voz para que todos possam ouvir."
        }
      ]
    },
    "apd": {
      "preferred_label": "ينادي",
      "descriptions": [
        {
          "source": "acai",
          "description": "إعلان شي مهم بصوت عالي وواضح عشان الكل يسمع."
        }
      ]
    },
    "arb": {
      "preferred_label": "يكرز",
      "descriptions": [
        {
          "source": "acai",
          "description": "إعلان أمر مهم بوضوح وبصوت عالٍ حتى يتمكن الجميع من سماعه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Talemaot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong talemaot klia mo wetem laod voes wan impoten toktok blong evri man i save harem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin Shela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sanar da wani muhimmin abu a sarari da kuma da babbar murya domin kowa ya ji."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रचार करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी महत्वपूर्ण बात की स्पष्ट और ऊँचे स्वर में घोषणा करना ताकि हर कोई सुन सके।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikwusa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikwusa ihe dị mkpa nke ọma na n'olu dara ụda ka onye ọ bụla nụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रचार गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "सबैले सुन्‍न सकून् भनेर कुनै महत्त्वपूर्ण कुरा स्पष्ट र ठूलो स्वरमा घोषणा गर्नु वा सुनाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Провозглашать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ясно и громко объявлять о чем-либо важном во всеуслышание."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutangaza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutangaza jambo muhimu kwa uwazi na kwa sauti kubwa ili kila mtu aweze kusikia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Autim tok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long autim wanpela bikpela tok klia na strong bai olgeta manmeri i ken harim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Rao giảng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Công bố điều gì đó quan trọng một cách rõ ràng và lớn tiếng để mọi người có thể nghe."
        }
      ]
    },
    "zhs": {
      "preferred_label": "宣告",
      "descriptions": [
        {
          "source": "acai",
          "description": "清晰且大声地宣布重要的事，使人人都能听见。"
        }
      ]
    },
    "zht": {
      "preferred_label": "宣告",
      "descriptions": [
        {
          "source": "acai",
          "description": "清楚且大聲地宣佈重要的事情，使所有人都能聽見。"
        }
      ]
    }
  },
  "referred_to_as": [
