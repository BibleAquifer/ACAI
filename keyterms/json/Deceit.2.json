  "localizations": {
    "eng": {
      "preferred_label": "Deceit (Deception)",
      "alternate_labels": [
        "Betrayal"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "An act of tricking or lying to someone to harm or betray them."
        }
      ]
    },
    "ind": {
      "preferred_label": "tipu daya (penipuan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tindakan memperdaya atau membohongi seseorang untuk mencelakakan atau mengkhianati mereka."
        }
      ]
    },
    "apd": {
      "preferred_label": "خداع (غش)",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل بتاع غش أو كضب على زول عشان يضروه أو يخونوه."
        }
      ]
    },
    "arb": {
      "preferred_label": "غِشّ (خداع)",
      "descriptions": [
        {
          "source": "acai",
          "description": "فعل خداع شخص أو الكذب عليه لإيذائه أو خيانته."
        }
      ]
    },
    "bis": {
      "preferred_label": "Trik (Fasin giaman)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan aksen blong trikim no giaman long wan man blong spolem hem no mekem nogud long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "tromperie (tromperie)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Acte consistant à tromper quelqu'un ou à lui mentir pour lui nuire ou le trahir."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ruɗu (Yaudara)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aikin yaudara ko yi wa wani ƙarya domin a cutar da shi ko a ci amanarsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "धोखा (छल)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी को हानि पहुँचाने या विश्वासघात करने के लिए धोखा देने या झूठ बोलने का कृत्य।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aghụghọ (Nghọgbu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Omume ịghọ mmadụ aghụghọ maọbụ ịgwa ya okwu ụgha iji merụọ ya ahụ maọbụ raara ya nye."
        }
      ]
    },
    "nep": {
      "preferred_label": "छलकपट (धोका)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई हानि पुऱ्याउन वा धोका दिन झुक्याउने वा झुट बोल्ने काम।"
        }
      ]
    },
    "por": {
      "preferred_label": "engano (enganação)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um ato de enganar ou mentir para alguém a fim de prejudicá-lo ou traí-lo."
        }
      ]
    },
    "rus": {
      "preferred_label": "коварство (обман)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Поступок, заключающийся в обмане или введении кого-либо в заблуждение с целью причинить вред или предать."
        }
      ]
    },
    "spa": {
      "preferred_label": "engaño (decepción)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Acto de engañar o mentir a alguien para perjudicarlo o traicionarlo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hila (Udanganyifu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tendo la kumdanganya au kumhadaa mtu ili kumdhuru au kumsaliti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin giaman (Giamanim man)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong giamanim o trikim narapela man bilong bagarapim em o givim baksait long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lừa dối (Hành vi dối trá)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành vi lừa gạt hoặc nói dối ai đó nhằm gây hại hoặc phản bội họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "诡诈（欺骗）",
      "descriptions": [
        {
          "source": "acai",
          "description": "为伤害或出卖某人而对其进行的欺骗或说谎行为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "詭詐 (欺騙)",
      "descriptions": [
        {
          "source": "acai",
          "description": "欺騙或向人說謊以傷害或背叛對方的行為。"
        }
      ]
    }
  },
  "referred_to_as": [
