        }
      ]
    },
    "apd": {
      "preferred_label": "المكر",
      "descriptions": [
        {
          "source": "acai",
          "description": "الكون شاطر وحذر، واستخدام طرق ذكية أو خبيثة عشان الزول يوصل لغرضه."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَمكُر",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يكون المرء ذكيًّا وحذرًا، مستخدمًا طرقًا ماكرة أو حيلة لتحقيق هدف ما."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem trik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong stap waes mo lukaotgud, we man i stap yusum ol smat wei no trik blong kasem wan mak."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin Wayo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zama mai wayo da taka-tsantsan, ta yin amfani da dabarun wayo ko maƙarƙashiya don cimma wata manufa."
        }
      ]
    },
    "hin": {
      "preferred_label": "धूर्त होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी लक्ष्य को प्राप्त करने के लिए चतुर और सावधान होना, तथा होशियारी या चालबाज़ी भरे तरीकों का उपयोग करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịbụ onye aghụghọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye amamihe na onye nwere nlezianya, na-eji ụzọ aghụghọ ma ọ bụ amamihe eme ihe iji ruo ihe a tụrụ anya ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "धूर्त हुनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "लक्ष्य हासिल गर्न चलाख वा धूर्त उपायहरू अपनाउँदै चतुर र सतर्क हुनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "быть хитрым",
      "descriptions": [
        {
          "source": "acai",
          "description": "Быть умным и осторожным, использовать сообразительные или хитрые способы для достижения цели."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuwa Mwerevu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa mwerevu na mwangalifu, kwa kutumia mbinu zenye akili au hila ili kufikia lengo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "I Stap Smat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong i stap smat na lukaut gut, na yusim ol pasin bilong giaman o trik bilong kamapim samting man i laik mekim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Mưu mô",
      "descriptions": [
        {
          "source": "acai",
          "description": "Khôn khéo và cẩn trọng, dùng mưu mẹo hoặc cách thức tinh ranh để đạt được mục tiêu."
        }
      ]
    },
    "zhs": {
      "preferred_label": "行事狡猾",
      "descriptions": [
        {
          "source": "acai",
          "description": "行事聪明谨慎，运用机巧或诡计来达到目的。"
        }
      ]
    },
    "zht": {
      "preferred_label": "狡猾",
      "descriptions": [
        {
          "source": "acai",
          "description": "精明且謹慎，使用巧妙或詭詐的方式以達到目的。"
        }
      ]
    }
  },
