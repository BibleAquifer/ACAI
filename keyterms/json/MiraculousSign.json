{
  "id": "keyterm:MiraculousSign",
  "primary_id": "keyterm:MiraculousSign",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "000214001003000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Miraculous Sign",
      "alternate_labels": [
        "Miracle"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A special and powerful act from God that shows His power and greatness."
        }
      ]
    },
    "spa": {
      "preferred_label": "señal milagrosa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un acto especial y poderoso de parte de Dios que manifiesta su poder y grandeza."
        }
      ]
    },
    "fra": {
      "preferred_label": "signe miraculeux",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un acte spécial et puissant de Dieu qui manifeste sa puissance et sa grandeur."
        }
      ]
    },
    "ind": {
      "preferred_label": "tanda ajaib",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tindakan istimewa dan penuh kuasa dari Allah yang menunjukkan kuasa dan kebesaran-Nya."
        }
      ]
    },
    "apd": {
      "preferred_label": "آية معجزية",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل مميز وعظيم من الله بيبيّن قدرتو وعظمتو."
        }
      ]
    },
    "arb": {
      "preferred_label": "آية إعجازية",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل خاص وقوي من الله يُظهر قدرته وعظمته."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bigfala saen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan sprol wok we i klia mo i gat bigfala paoa we i kamaot long God blong soemaot paoa mo bigfala nem blong hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Alamar Mu’ujiza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aiki na musamman mai iko daga Allah wanda yake nuna ikonsa da girmansa."
        }
      ]
    },
    "hin": {
      "preferred_label": "अद्भुत चिन्ह",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर का एक विशेष और सामर्थी कार्य जो उसके सामर्थ्य और महानता को दर्शाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe ịrịbama nke ọrụ ebube",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọrụ pụrụ iche na nke dị ike sitere na Chineke nke na-egosi ike na ịdị ukwuu ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "चमत्कारी चिन्ह",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको एउटा विशेष र शक्तिशाली काम जसले उहाँको शक्ति र महानतालाई देखाउँछ।"
        }
      ]
    },
    "por": {
      "preferred_label": "sinal miraculoso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um ato especial e poderoso da parte de Deus que manifesta seu poder e sua grandeza."
        }
      ]
    },
    "rus": {
      "preferred_label": "Знамение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особое и могущественное действие Бога, являющее Его силу и величие."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ishara ya Muujiza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tendo maalum na lenye nguvu kutoka kwa Mungu linaloonyesha uwezo wake na ukuu wake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sain bilong mirakel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela wok o sain bilong strong bilong God we i soim strong na biknem bilong em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Dấu kỳ phép lạ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một hành động đặc biệt và đầy quyền năng từ Đức Chúa Trời nhằm bày tỏ quyền năng và sự vĩ đại của Ngài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "神迹",
      "descriptions": [
        {
          "source": "acai",
          "description": "彰显上帝大能与伟大作为的特殊且充满力量的作为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "神蹟兆頭",
      "descriptions": [
        {
          "source": "acai",
          "description": "來自上帝的特別且有能力之作為，彰顯祂的大能與偉大。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
