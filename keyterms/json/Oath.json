  "localizations": {
    "eng": {
      "preferred_label": "Oath",
      "descriptions": [
        {
          "source": "acai",
          "description": "A serious promise that shows someone is telling the truth or will do what they say."
        }
      ]
    },
    "spa": {
      "preferred_label": "juramento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una promesa solemne que demuestra que alguien dice la verdad o que hará lo que dice."
        }
      ]
    },
    "fra": {
      "preferred_label": "serment",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une promesse solennelle qui atteste que quelqu'un dit la vérité ou fera ce qu'il affirme."
        }
      ]
    },
    "ind": {
      "preferred_label": "sumpah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Janji yang sungguh-sungguh yang menunjukkan bahwa seseorang mengatakan kebenaran atau akan melakukan apa yang dikatakannya."
        }
      ]
    },
    "apd": {
      "preferred_label": "قسم",
      "descriptions": [
        {
          "source": "acai",
          "description": "وعد قاطع بيبيّن إنو الزول بقول الحقيقة أو حيسوي الحاجه القالها."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَسَم",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَعْدٌ جادٌّ يُظْهِرُ أَنَّ الشَّخْصَ يَقُولُ الْحَقَّ أَوْ أَنَّهُ سَيَفْعَلُ مَا يَقُولُهُ."
        }
      ]
    },
    "bis": {
      "preferred_label": "strong promes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan strong promes we i soemaot se wan man i stap tok tru no bambae i mekem samting we hem i talem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rantsuwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alkawari mai tsanani da ke nuna mutum yana faɗar gaskiya ko kuma zai cika abin da ya faɗa."
        }
      ]
    },
    "hin": {
      "preferred_label": "शपथ",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक गंभीर प्रतिज्ञा जो यह दर्शाती है कि कोई सत्य बोल रहा है या वह वही करेगा जो उसने कहा है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Iyi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nkwa siri ike nke na-egosi na mmadụ na-ekwu eziokwu ma ọ bụ na ọ ga-eme ihe o kwuru."
        }
      ]
    },
    "nep": {
      "preferred_label": "शपथ",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैले सत्य बोलिरहेको छ वा उसले भनेको कुरा पूरा गर्नेछ भनी देखाउने एक गम्भीर प्रतिज्ञा।"
        }
      ]
    },
    "por": {
      "preferred_label": "juramento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma promessa solene que demonstra que alguém está dizendo a verdade ou fará o que diz."
        }
      ]
    },
    "rus": {
      "preferred_label": "Клятва",
      "descriptions": [
        {
          "source": "acai",
          "description": "Серьезное обещание, свидетельствующее о том, что человек говорит правду или исполнит сказанное."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kiapo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ahadi thabiti inayoonyesha kwamba mtu anasema ukweli au atafanya kile anachosema."
        }
      ]
    },
    "tpi": {
      "preferred_label": "tok tru antap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bikpela promis i soim olsem man i mekim i save tok tru o em bai mekim olsem em i tok."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời thề",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lời hứa long trọng chứng tỏ một người đang nói sự thật hoặc sẽ làm điều mình đã nói."
        }
      ]
    },
    "zhs": {
      "preferred_label": "誓言",
      "descriptions": [
        {
          "source": "acai",
          "description": "庄严的许诺，表明某人说的是实话或会照自己所说的去行。"
        }
      ]
    },
    "zht": {
      "preferred_label": "誓言",
      "descriptions": [
        {
          "source": "acai",
          "description": "表明某人說的是實話或將遵行其言的莊重誓言。"
        }
      ]
    }
  },
