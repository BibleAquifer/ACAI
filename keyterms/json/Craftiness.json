  "localizations": {
    "eng": {
      "preferred_label": "Craftiness",
      "alternate_labels": [
        "Prudence"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Being clever and careful to do things in a smart or tricky way."
        }
      ]
    },
    "spa": {
      "preferred_label": "astucia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser ingenioso y cauteloso para hacer las cosas de manera astuta o hábil."
        }
      ]
    },
    "fra": {
      "preferred_label": "ruse",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait d'être habile et avisé pour agir d'une manière ingénieuse ou rusée."
        }
      ]
    },
    "ind": {
      "preferred_label": "kecerdikan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pintar dan cermat dalam melakukan sesuatu dengan cara yang cerdik atau penuh siasat."
        }
      ]
    },
    "apd": {
      "preferred_label": "مكر",
      "descriptions": [
        {
          "source": "acai",
          "description": "تكون شاطر وحريص عشان تسوي حاجات بطريقة ذكية أو فيها حيلة."
        }
      ]
    },
    "arb": {
      "preferred_label": "دهاء",
      "descriptions": [
        {
          "source": "acai",
          "description": "التحلي بالدهاء والحرص لفعل الأمور بطريقة ذكية أو ماكرة."
        }
      ]
    },
    "bis": {
      "preferred_label": "trik fasin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong gat klia hed o waes tingting blong mekem ol samting long wan triki fasin o long wan smat fasin."
        }
      ]
    },
    "hau": {
      "preferred_label": "Wayon Dabara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa mai wayo da basira wajen yin abubuwa ta hanyar hikima ko kuma dabarar ruɗu."
        }
      ]
    },
    "hin": {
      "preferred_label": "चतुराई",
      "descriptions": [
        {
          "source": "acai",
          "description": "चतुर या धूर्त तरीके से काम करने के लिए चालाक और सावधान होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aghụghọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye nwere amamihe na ịkpachara anya ime ihe nʼụzọ aghụghọ ma ọ bụ nʼụzọ amamihe."
        }
      ]
    },
    "nep": {
      "preferred_label": "धूर्तता",
      "descriptions": [
        {
          "source": "acai",
          "description": "चलाखीपूर्ण वा धूर्त तरिकाले काम गर्न सिपालु र होसियार हुनु।"
        }
      ]
    },
    "por": {
      "preferred_label": "astúcia",
      "descriptions": [
        {
          "source": "acai",
          "description": "A capacidade de ser esperto e prudente para agir de modo inteligente ou ardiloso."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хитрость",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ум, сообразительность или осторожность при выполнении чего-либо хитрым либо искусным образом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hila",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa mwerevu na mwangalifu ili kufanya mambo kwa namna ya werevu au ya hila."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin bilong trik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong i gat planti kain tingting na save long mekim ol samting long rot bilong trik o kain kain gutpela rot bilong wokabaut."
        }
      ]
    },
    "vie": {
      "preferred_label": "Mưu kế",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sự khôn khéo và cẩn trọng để làm việc theo cách thông minh hoặc mưu mẹo."
        }
      ]
    },
    "zhs": {
      "preferred_label": "机巧",
      "descriptions": [
        {
          "source": "acai",
          "description": "行事机敏、审慎，懂得运用巧妙或狡黠的手段。"
        }
      ]
    },
    "zht": {
      "preferred_label": "詭詐／精明",
      "descriptions": [
        {
          "source": "acai",
          "description": "精明敏捷，以巧妙或詭詐的方式行事的特質。"
        }
      ]
    }
  },
