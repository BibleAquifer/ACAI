  "localizations": {
    "eng": {
      "preferred_label": "Mighty One",
      "descriptions": [
        {
          "source": "acai",
          "description": "A powerful being known for strength and might, often linked to fighting or war."
        }
      ]
    },
    "spa": {
      "preferred_label": "valiente",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser poderoso conocido por su fuerza y poder, a menudo relacionado con la lucha o la guerra."
        }
      ]
    },
    "fra": {
      "preferred_label": "homme fort",
      "descriptions": [
        {
          "source": "acai",
          "description": "Être puissant réputé pour sa force et sa vaillance, souvent associé au combat ou à la guerre."
        }
      ]
    },
    "ind": {
      "preferred_label": "yang perkasa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Makhluk atau pribadi berkuasa yang dikenal karena kekuatan dan keperkasaannya, sering kali dikaitkan dengan pertempuran atau peperangan."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبار",
      "descriptions": [
        {
          "source": "acai",
          "description": "كائن قوي معروف بالقوة والشدة، وغالباً مرتبط بالقتال أو الحرب."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَدِيد",
      "descriptions": [
        {
          "source": "acai",
          "description": "كَائِنٌ قَوِيٌّ مَعْرُوفٌ بِٱلْبَأْسِ وَٱلْقُوَّةِ، وَغَالِبًا مَا يَرْتَبِطُ بِٱلْقِتَالِ أَوِ ٱلْحَرْبِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "strong man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan strong samting no man we oli save hem from paoa mo strong blong hem, we plante taem i joen wetem faet."
        }
      ]
    },
    "hau": {
      "preferred_label": "Jarumi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mai iko da aka sani da ƙarfi da jaruntaka, sau da yawa yana da nasaba da faɗa ko yaƙi."
        }
      ]
    },
    "hin": {
      "preferred_label": "शूरवीर",
      "descriptions": [
        {
          "source": "acai",
          "description": "बल और पराक्रम के लिए जाना जाने वाला एक शक्तिशाली प्राणी, जो प्रायः युद्ध या लड़ाई से जुड़ा होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye dị ike",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye dị ike nke a maara maka ike na idi ike, nke na-ejikarịkarị agha ma ọ bụ ọgụ akpakọrịta."
        }
      ]
    },
    "nep": {
      "preferred_label": "शक्तिशाली वीर",
      "descriptions": [
        {
          "source": "acai",
          "description": "सामर्थ्य र शक्तिका निम्ति परिचित एक शक्तिशाली प्राणी, जो प्रायः लडाइँ वा युद्धसँग सम्बन्धित हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "poderoso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um ser poderoso conhecido por força e poder, frequentemente associado a batalhas ou guerra."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сильный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сильное существо, известное своей силой и мощью, часто связанное с битвами или войной."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwenye nguvu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kiumbe mwenye nguvu anayejulikana kwa nguvu na uwezo, mara nyingi akihusishwa na mapigano au vita."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Strongpela man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man o samting i gat traipela strong, planti taim ol i save tingim long ol pait o soldia."
        }
      ]
    },
    "vie": {
      "preferred_label": "người dũng mãnh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một đấng hoặc người đầy quyền năng, nổi tiếng về sức mạnh và dũng lực, thường gắn liền với chiến trận hoặc chiến tranh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "勇士",
      "descriptions": [
        {
          "source": "acai",
          "description": "以力量和大能著称的有权能者，常与争战或战争相关。"
        }
      ]
    },
    "zht": {
      "preferred_label": "勇士",
      "descriptions": [
        {
          "source": "acai",
          "description": "以力量和大能著稱的強大個體，通常與爭戰或戰事有關。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:StrongWilled"
  ],
