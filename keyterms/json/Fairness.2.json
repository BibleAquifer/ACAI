  "localizations": {
    "eng": {
      "preferred_label": "Fairness (Integrity)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Treating others equally and honestly, without cheating or taking sides."
        }
      ]
    },
    "spa": {
      "preferred_label": "equidad (integridad)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tratar a los demás con igualdad y honestidad, sin hacer trampa ni tomar partido."
        }
      ]
    },
    "fra": {
      "preferred_label": "droiture (intégrité)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Traiter les autres avec égalité et honnêteté, sans tricher ni faire de favoritisme."
        }
      ]
    },
    "ind": {
      "preferred_label": "kejujuran (integritas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memperlakukan orang lain secara setara dan jujur, tanpa curang atau memihak."
        }
      ]
    },
    "por": {
      "preferred_label": "retidão (integridade)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tratar os outros com igualdade e honestidade, sem trapacear ou tomar partido."
        }
      ]
    },
    "apd": {
      "preferred_label": "إنصاف (استقامة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "معاملة الآخرين بالسوية وبأمانة، من غير غش أو انحياز لجهة."
        }
      ]
    },
    "arb": {
      "preferred_label": "اسْتِقَامَة (نَزَاهَة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "معاملة الآخرين بالمساواة والنزاهة، من دون غش أو تحيز."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin we i stret (ona)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tritim ol narafala man long sem fasin nomo mo long fasin we i tru, we yu no giaman o no tekem saed."
        }
      ]
    },
    "hau": {
      "preferred_label": "Daidaito (Gaskiya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mu’amala da wasu cikin daidaito da gaskiya, ba tare da cuta ko nuna bambanci ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "निष्पक्षता (खराई)",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिना किसी कपट या पक्षपात के, दूसरों के साथ निष्पक्ष और सच्चाई से व्यवहार करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikpe ziri ezi (Iguzosi ike nʼezi ihe)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Imeso ndị ọzọ nʼotu nʼotu na nʼeziokwu, na-enweghị aghụghọ ma ọ bụ ịkpọfe mmadụ nʼotu akụkụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "निष्पक्षता (इमानदारी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "छलकपट वा पक्षपात नगरी, अरूलाई समान र इमानदारीपूर्वक व्यवहार गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Справедливость (Честность)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Одинаково честное отношение ко всем, без обмана или лицеприятия."
        }
      ]
    },
    "swh": {
      "preferred_label": "Usawa (Uadilifu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutendea wengine kwa usawa na kwa uaminifu, bila kudanganya au kupendelea upande wowote."
        }
      ]
    },
    "tpi": {
      "preferred_label": "stretpela pasin (pasin i stret olgeta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim wankain stretpela pasin long ol arapela manmeri na bihainim stretpela tingting, i no giaman o sapotim wanpela sait tasol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ngay thẳng (Chính trực)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đối xử với người khác một cách bình đẳng và thành thật, không gian lận hay thiên vị."
        }
      ]
    },
    "zhs": {
      "preferred_label": "公正 (正直)",
      "descriptions": [
        {
          "source": "acai",
          "description": "平等且诚实地对待他人，不欺诈，也不偏袒。"
        }
      ]
    },
    "zht": {
      "preferred_label": "正直（正直）",
      "descriptions": [
        {
          "source": "acai",
          "description": "平等且誠實地對待他人，不欺騙也不偏袒。"
        }
      ]
    }
  },
  "referred_to_as": [
