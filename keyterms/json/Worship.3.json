      ]
    },
    "vie": {
      "preferred_label": "sùng kính",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thể hiện tình yêu sâu sắc và sự tận hiến cho Đức Chúa Trời qua lời cầu nguyện và hành động."
        }
      ]
    },
    "zhs": {
