    "hau": {
      "preferred_label": "Mai ibada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna ƙauna da sadaukarwa mai zurfi ga Allah ta wurin addu’a da ayyuka."
        }
      ]
    },
    "hin": {
      "preferred_label": "भक्त",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रार्थना और कार्यों के द्वारा परमेश्वर के प्रति गहरा प्रेम और समर्पण दिखाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịsọpụrụ Chineke",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosi ịhụnanya miri emi na nraranye nye Chineke site nʼekpere na omume."
        }
      ]
    },
    "nep": {
      "preferred_label": "भक्त",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रार्थना र कार्यहरूद्वारा परमेश्‍वरप्रति गहिरो प्रेम र समर्पण देखाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Благочестивый",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявление глубокой любви и преданности Богу через молитву и поступки."
