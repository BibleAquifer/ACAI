      ]
    },
    "swh": {
      "preferred_label": "Mcha Mungu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuonyesha upendo mwingi na kujitoa kwa Mungu kupitia maombi na matendo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong lotu strong",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong soim bikpela lav na givim bel olgeta long God long rot bilong prea na ol pasin bilong yu."
