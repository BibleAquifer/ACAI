      ]
    },
    "bis": {
      "preferred_label": "mekem i gud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong mekem wan gudfala samting we i givhan long narafala man from we man i kaen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin kirki",
