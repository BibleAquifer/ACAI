        }
      ]
    },
    "ibo": {
      "preferred_label": "Inwe obiọma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ihe dị mma na nke bara uru maka onye ọzọ site nʼobiọma."
        }
      ]
    },
    "nep": {
      "preferred_label": "दयालु हुनु",
      "descriptions": [
