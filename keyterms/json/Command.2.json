{
  "id": "keyterm:Command.2",
  "primary_id": "keyterm:Command",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "33.331",
    "33.419"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "To Command",
      "descriptions": [
        {
          "source": "acai",
          "description": "To tell someone to do something with authority, often expecting it to be done."
        }
      ]
    },
    "fra": {
      "preferred_label": "commander",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dire à quelqu’un de faire quelque chose avec autorité, en s’attendant souvent à ce que cela soit exécuté."
        }
      ]
    },
    "ind": {
      "preferred_label": "menghardik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyuruh seseorang melakukan sesuatu dengan penuh wibawa, sering kali mengharapkan hal itu terlaksana."
        }
      ]
    },
    "por": {
      "preferred_label": "ordenar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dizer a alguém para fazer algo com autoridade, muitas vezes esperando que seja feito."
        }
      ]
    },
    "apd": {
      "preferred_label": "أمر",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنك تقول لزول يعمل حاجة بسلطان، وغالباً متوقع إنها تتعمل."
        }
      ]
    },
    "arb": {
      "preferred_label": "يأمر",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن تأمر شخصًا بفعل شيء ما بسلطان، مع توقع تنفيذه في الغالب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Givim oda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong talem long wan man wetem paoa se i mas mekem wan samting, wetem tingting se bambae hem i mekem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Umarci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faɗa wa wani ya yi wani abu da iko, sau da yawa ana sa ran za a aikata shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "आज्ञा देना",
      "descriptions": [
        {
          "source": "acai",
          "description": "अधिकार के साथ किसी को कुछ करने के लिए कहना, अक्सर यह अपेक्षा करते हुए कि वह पूरा किया जाए।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Inye iwu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iji ikike gwa mmadụ ka o mee ihe, na-atụkarị anya ka e mee ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "आज्ञा दिनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "अधिकारसहित कसैलाई केही गर्न लगाउनु वा आज्ञा दिनु, जुन प्रायः पूरा हुने अपेक्षा गरिन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "повелевать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Властно велеть кому-либо сделать что-либо, обычно с ожиданием повиновения."
        }
      ]
    },
    "spa": {
      "preferred_label": "ordenar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Decirle a alguien con autoridad que haga algo, a menudo con la expectativa de que se cumpla."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuamuru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumwambia mtu afanye jambo fulani kwa mamlaka, mara nyingi kwa kutarajia litekelezwe."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Givim tok bilong bosim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong givim strongpela tok long wanpela man long mekim wanpela samting, na i ting em i mas bihainim dispela tok."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ra lệnh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bảo ai đó làm điều gì đó với uy quyền, thường đòi hỏi điều đó phải được thực hiện."
        }
      ]
    },
    "zhs": {
      "preferred_label": "吩咐",
      "descriptions": [
        {
          "source": "acai",
          "description": "凭借权柄吩咐某人做某事，通常指望其遵行。"
        }
      ]
    },
    "zht": {
      "preferred_label": "吩咐",
      "descriptions": [
        {
          "source": "acai",
          "description": "憑權柄吩咐某人做事，通常期望其遵行。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Command",
    "keyterm:Rebuke"
  ],
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
