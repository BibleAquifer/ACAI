        }
      ]
    },
    "por": {
      "preferred_label": "testemunho (conteúdo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "As palavras ou o relato que alguém dá para mostrar o que viu ou sabe."
        }
      ]
    },
    "apd": {
      "preferred_label": "شهادة (مضمون)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الكلام أو القصة البيقولها الزول عشان يورّي الحاجة الشافها أو العارفها."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَهَادَة (محتوى)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الكلمات أو الرواية التي يقدمها شخص ما ليُبين ما رآه أو يعرفه."
        }
      ]
    },
    "bis": {
      "preferred_label": "witnes (tok we oli talem)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol tok no stori we wan man i talem blong soemaot samting we hem i bin luk no i save."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shaida (Abin da aka faɗa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kalmomi ko labari da wani ya bayar don nuna abin da ya gani ko ya sani."
        }
      ]
    },
    "hin": {
      "preferred_label": "गवाही (विषय-वस्तु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "वे शब्द या वृत्तांत जो कोई यह दिखाने के लिए प्रस्तुत करता है कि उसने क्या देखा है या वह क्या जानता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Akaebe (Ọdịnaya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Okwu ma ọ bụ akụkọ mmadụ na-enye iji gosi ihe ọ hụrụ ma ọ bụ ihe ọ maara."
        }
      ]
    },
    "nep": {
      "preferred_label": "गवाही (विषयवस्तु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफूले देखेको वा जानेको कुरा देखाउन कसैले व्यक्त गर्ने वचन वा कथा।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Свидетельство (содержание)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Слова или рассказ, которые кто-либо приводит, чтобы показать то, что он видел или знает."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ushuhuda (Maudhui)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Maneno au masimulizi ambayo mtu anatoa kuonyesha kile alichokiona au anachokijua."
        }
      ]
    },
    "tpi": {
      "preferred_label": "tok i kamapim trutok (tok yet)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol tok o stori man i givim bilong soim samting em i bin lukim o save long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời chứng (Nội dung)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những lời nói hoặc câu chuyện mà một người thuật lại để bày tỏ những gì họ đã thấy hoặc biết."
        }
      ]
    },
    "zhs": {
      "preferred_label": "见证 (内容)",
      "descriptions": [
        {
          "source": "acai",
          "description": "某人为说明自己所见或所知而表达的话语或讲述的故事。"
        }
      ]
    },
    "zht": {
      "preferred_label": "見證（內容）",
      "descriptions": [
        {
          "source": "acai",
          "description": "某人為了表明自己所見或所知而說的話或陳述的事。"
        }
      ]
    }
  },
