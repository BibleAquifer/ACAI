{
  "id": "keyterm:Exempt",
  "primary_id": "keyterm:Exempt",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "004905001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Exempt",
      "alternate_labels": [
        "Free From",
        "Free From Guilt"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Not required to do something or not blamed for something."
        }
      ]
    },
    "spa": {
      "preferred_label": "exento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que no está obligado a hacer algo o que no es culpado por algo."
        }
      ]
    },
    "fra": {
      "preferred_label": "exempt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Qui n'est pas tenu de faire quelque chose ou n'est pas tenu pour coupable de quelque chose."
        }
      ]
    },
    "ind": {
      "preferred_label": "bebas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak diwajibkan untuk melakukan sesuatu atau tidak dipersalahkan atas sesuatu."
        }
      ]
    },
    "por": {
      "preferred_label": "isento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não obrigado a fazer algo ou não considerado culpado por algo."
        }
      ]
    },
    "apd": {
      "preferred_label": "معفي",
      "descriptions": [
        {
          "source": "acai",
          "description": "ما ملزم بعمل حاجة معينة أو ما بيلوموه على حاجة."
        }
      ]
    },
    "arb": {
      "preferred_label": "معفى",
      "descriptions": [
        {
          "source": "acai",
          "description": "غير ملزم بفعل شيء أو غير مدان بأمر ما."
        }
      ]
    },
    "bis": {
      "preferred_label": "fri long",
      "descriptions": [
        {
          "source": "acai",
          "description": "We man i fri long wan wok no oli no jikim hem from wan samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "Karewa Daga Wajibi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanda ba a wajabta masa yin wani abu ba ko kuma ba a ɗora masa laifin wani abu ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "मुक्त",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी काम को करने की बाध्यता से मुक्त या किसी बात के लिए दोषी न ठहराया गया।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịnwere onwe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye a na-achọghị n'aka ya ime otu ihe ma ọ bụ onye a na-adịghị ata ụta maka ihe ọ bụla."
        }
      ]
    },
    "nep": {
      "preferred_label": "छूट पाएको",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरा गर्न नपर्ने वा कुनै कुराको निम्ति दोषी नठहरिने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Освобожденный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Освобожденный от обязательства делать что-либо или невиновный в чем-либо."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusamehewa Wajibu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutotakiwa kufanya jambo fulani au kutolaumiwa kwa jambo fulani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "i stap fri",
      "descriptions": [
        {
          "source": "acai",
          "description": "I stap fri long mekim wanpela wok o i no gat asua long wanpela samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Miễn trừ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không bị buộc phải làm một việc gì đó hoặc không bị đổ lỗi về điều gì đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "免除",
      "descriptions": [
        {
          "source": "acai",
          "description": "免于做某事，或免于被归咎、免于承担责任。"
        }
      ]
    },
    "zht": {
      "preferred_label": "免除",
      "descriptions": [
        {
          "source": "acai",
          "description": "不被要求做某事，或免於被歸咎責難。"
        }
      ]
    }
  },
