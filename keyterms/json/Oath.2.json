{
  "id": "keyterm:Oath.2",
  "primary_id": "keyterm:Oath",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "007154001001000",
    "007154001002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Oath (Promise)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A serious promise made to God or others to do something or tell the truth."
        }
      ]
    },
    "spa": {
      "preferred_label": "juramento (promesa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Promesa solemne hecha a Dios o a otros para hacer algo o decir la verdad."
        }
      ]
    },
    "fra": {
      "preferred_label": "serment (promesse)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une promesse solennelle faite à Dieu ou à d'autres de faire quelque chose ou de dire la vérité."
        }
      ]
    },
    "ind": {
      "preferred_label": "sumpah (janji)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Janji yang sungguh-sungguh yang diikrarkan kepada Allah atau sesama untuk melakukan sesuatu atau menyatakan kebenaran."
        }
      ]
    },
    "apd": {
      "preferred_label": "قسم (وعد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "وعد جادي بيتعمل لله أو للناس عشان زول يعمل حاجة أو يقول الحقيقة."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَسَم (وَعْد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَعْدٌ جَادٌّ يُقْطَعُ للهِ أَوْ لِلْآخَرِينَ لِفِعْلِ شَيْءٍ أَوْ لِقَوْلِ الْحَقِيقَةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Promes (Strong Promes)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan strong promes we man i mekem long God o long ol narafala man blong mekem wan samting o blong talem trutok."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rantsuwa (Alƙawari)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban alƙawari da aka ɗauka ga Allah ko ga wasu mutane don a aikata wani abu ko a faɗi gaskiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "शपथ (प्रतिज्ञा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुछ करने या सच बोलने के लिए परमेश्वर या दूसरों से की गई एक गंभीर प्रतिज्ञा।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Iyi (Nkwa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nkwa siri ike e kwere Chineke ma ọ bụ ndị ọzọ ime otu ihe ma ọ bụ ikwu eziokwu."
        }
      ]
    },
    "nep": {
      "preferred_label": "शपथ (प्रतिज्ञा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "केही गर्न वा सत्य बोल्न परमेश्वर वा अरूहरूसामु गरिएको एक गम्भीर प्रतिज्ञा।"
        }
      ]
    },
    "por": {
      "preferred_label": "juramento (promessa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma promessa solene feita a Deus ou a outros de fazer algo ou falar a verdade."
        }
      ]
    },
    "rus": {
      "preferred_label": "клятва (обетование)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Торжественное обещание Богу или другим людям сделать что-либо или говорить правду."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kiapo (Ahadi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ahadi thabiti inayotolewa kwa Mungu au kwa wengine ya kufanya jambo fulani au kusema ukweli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "promis (tok promis)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela strongpela promis man i mekim long God o long ol arapela man long mekim wanpela samting o long autim tok i tru."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời thề (Lời hứa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lời hứa nghiêm túc được lập trước Đức Chúa Trời hoặc người khác để làm một điều gì đó hoặc nói sự thật."
        }
      ]
    },
    "zhs": {
      "preferred_label": "誓言 (应许)",
      "descriptions": [
        {
          "source": "acai",
          "description": "向上帝或他人作出的庄严承诺，保证去行某事或说出实话。"
        }
      ]
    },
    "zht": {
      "preferred_label": "誓言 (承諾)",
      "descriptions": [
        {
          "source": "acai",
          "description": "向上帝或他人所立的莊重誓言，保證會做某事或說實話。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Oath"
  ],
