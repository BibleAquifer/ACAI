  "localizations": {
    "eng": {
      "preferred_label": "Blood",
      "alternate_labels": [
        "Murder",
        "Death"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "The red liquid inside the body, often used to show life, death, or sacrifice."
        }
      ]
    },
    "spa": {
      "preferred_label": "sangre",
      "descriptions": [
        {
          "source": "acai",
          "description": "El líquido rojo dentro del cuerpo, usado a menudo para representar la vida, la muerte o el sacrificio."
        }
      ]
    },
    "fra": {
      "preferred_label": "sang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le liquide rouge à l'intérieur du corps, souvent utilisé pour représenter la vie, la mort ou le sacrifice."
        }
      ]
    },
    "ind": {
      "preferred_label": "darah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cairan merah di dalam tubuh, sering kali digunakan untuk melambangkan kehidupan, kematian, atau pengorbanan."
        }
      ]
    },
    "por": {
      "preferred_label": "sangue",
      "descriptions": [
        {
          "source": "acai",
          "description": "O líquido vermelho dentro do corpo, frequentemente usado para representar a vida, a morte ou o sacrifício."
        }
      ]
    },
    "apd": {
      "preferred_label": "دم",
      "descriptions": [
        {
          "source": "acai",
          "description": "السائل الأحمر الجوة الجسم، وغالباً بيستعملوهو عشان يبين الحياة، أو الموت، أو الذبيحة."
        }
      ]
    },
    "arb": {
      "preferred_label": "دم",
      "descriptions": [
        {
          "source": "acai",
          "description": "السائل الأحمر داخل الجسم، يُستخدم غالبًا للإشارة إلى الحياة أو الموت أو الذبيحة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Blad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Redfala wota we i stap insaed long bodi, we plante taem oli yusum blong soemaot laef, ded, no sakrefaes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Jini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ruwa ja da ke cikin jiki, wanda sau da yawa ake amfani da shi don nuna rai, mutuwa, ko hadaya."
        }
      ]
    },
    "hin": {
      "preferred_label": "लहू",
      "descriptions": [
        {
          "source": "acai",
          "description": "शरीर के भीतर का लाल तरल पदार्थ, जो अक्सर जीवन, मृत्यु या बलिदान को दर्शाने के लिए प्रयुक्त होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọbara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmiri na-acha ọbara ọbara dị nʼime ahụ, nke a na-ejikarị egosipụta ndụ, ọnwụ, ma ọ bụ àjà."
        }
      ]
    },
    "nep": {
      "preferred_label": "रगत",
      "descriptions": [
        {
          "source": "acai",
          "description": "शरीरभित्रको रातो तरल पदार्थ, जसलाई प्रायः जीवन, मृत्यु वा बलिदान दर्शाउन प्रयोग गरिन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Кровь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Красная жидкость внутри тела, часто служащая символом жизни, смерти или жертвы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Damu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Maji mekundu yaliyo ndani ya mwili, mara nyingi yakitumiwa kuonyesha uzima, kifo, au dhabihu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Blut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Retpela wara i stap insait long bodi, planti taim ol i save yusim bilong soim laip, dai, o ofa."
        }
      ]
    },
    "vie": {
      "preferred_label": "Máu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chất lỏng màu đỏ bên trong cơ thể, thường được dùng để chỉ sự sống, sự chết hoặc sự hy sinh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "血",
      "descriptions": [
        {
          "source": "acai",
          "description": "身体里的红色液体，常用来象征生命、死亡或祭物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "血",
      "descriptions": [
        {
          "source": "acai",
          "description": "體內的紅色液體，常象徵生命、死亡或獻祭。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
