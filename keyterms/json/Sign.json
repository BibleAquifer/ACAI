  "localizations": {
    "eng": {
      "preferred_label": "Sign (Miracle)",
      "descriptions": [
        {
          "source": "acai",
          "description": "An event that shows a special message or meaning from God."
        }
      ]
    },
    "spa": {
      "preferred_label": "señal (milagro)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un acontecimiento que muestra un mensaje especial o un significado de parte de Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "signe (miracle)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un événement qui transmet un message ou une signification particulière de la part de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "tanda (mukjizat)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suatu peristiwa yang menunjukkan pesan atau makna khusus dari Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "sinal (milagre)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um acontecimento que manifesta uma mensagem ou significado especial da parte de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "آية (معجزة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حادث يظهر رسالة خاصة أو معنى من الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "آيَة (مُعجِزَة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حَدَثٌ يُظهِرُ رِسَالَةً أَوْ مَعنًى خَاصًّا مِنَ اللهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "saen (merikel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we i hapen we i soemaot wan spesel mesej no mining we i kam long God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Alama (Mu’ujiza)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da ya faru wanda yake nuna saƙo na musamman ko ma’ana daga Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "चिह्न (आश्चर्यकर्म)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसी घटना जो परमेश्वर की ओर से किसी विशेष संदेश या अर्थ को दर्शाती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe ịrịbama (Ọrụ ebube)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe na-eme nke na-egosi ozi ma ọ bụ nkọwa pụrụ iche sitere na Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "चिह्न (आश्‍चर्यकर्म)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरबाट आएको कुनै विशेष सन्देश वा अर्थ देखाउने घटना।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Знамение (чудо)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Событие, указывающее на особое весть или значение от Бога."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ishara (Muujiza)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tukio linaloonyesha ujumbe maalum au maana kutoka kwa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "mak (mirakel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting o mirakel i kamap bilong soim bikpela tok o mak i kam long God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Dấu lạ (Phép lạ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một sự kiện bày tỏ một thông điệp hoặc ý nghĩa đặc biệt từ Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "神迹 (奇事)",
      "descriptions": [
        {
          "source": "acai",
          "description": "显明来自上帝的特别信息或意义的事件。"
        }
      ]
    },
    "zht": {
      "preferred_label": "神蹟（奇事）",
      "descriptions": [
        {
          "source": "acai",
          "description": "表明來自上帝的特別信息或意義的事件。"
        }
      ]
    }
  },
