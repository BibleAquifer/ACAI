  "localizations": {
    "eng": {
      "preferred_label": "Forgive (Remove Guilt)",
      "alternate_labels": [
        "Pardon"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To take away the feeling of guilt from someone who has done wrong."
        }
      ]
    },
    "spa": {
      "preferred_label": "perdonar (quitar la culpa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quitar el sentimiento de culpa a alguien que ha actuado mal."
        }
      ]
    },
    "fra": {
      "preferred_label": "pardonner (ôter la culpabilité)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Enlever le sentiment de culpabilité de quelqu'un qui a mal agi."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengampuni (menghapuskan rasa bersalah)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menghilangkan perasaan bersalah dari seseorang yang telah berbuat salah."
        }
      ]
    },
    "por": {
      "preferred_label": "perdoar (remover a culpa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tirar o sentimento de culpa de alguém que cometeu um erro."
        }
      ]
    },
    "apd": {
      "preferred_label": "غفر (رفع الذنب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إزالة الإحساس بالذنب من زول عمل غلط."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَغْفِرُ (إزالة الذنب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إزالة الشعور بالذنب عن شخص ارتكب خطأً."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fogivim (Tekemaot Sin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong tekemaot filing blong gilt long wan man we i mekem samting we i rong."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gafarta (Ɗauke Laifi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗauke jin laifi daga mutumin da ya yi ba daidai ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "क्षमा करना (दोष दूर करना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी ऐसे व्यक्ति के अपराध-बोध को दूर करना जिसने कुछ गलत किया हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gbaghara (Wepụ Ikpe Ọmụma)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iwere ihu ọmụma ma ọ bụ mmetụta ikpe ọmụma pụọ nʼebe onye mehiere nọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "क्षमा गर्नु (दोष हटाउनु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "गल्ती गर्ने कुनै व्यक्तिबाट दोषको भावना हटाइदिनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Прощать (снимать вину)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Снять чувство вины с того, кто поступил дурно."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusamehe (Kuondoa Hatia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuondoa hisia ya hatia kutoka kwa mtu aliyetenda makosa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lusim rong (Tekewe bel hevi bilong rong)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long tekewe bel hevi o pilim bilong rong long wanpela manmeri em i bin mekim rong."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tha thứ (Xóa bỏ tội lỗi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cất đi cảm giác tội lỗi khỏi một người đã làm điều sai quấy."
        }
      ]
    },
    "zhs": {
      "preferred_label": "饶恕（除去罪咎）",
      "descriptions": [
        {
          "source": "acai",
          "description": "除去犯错之人的负罪感。"
        }
      ]
    },
    "zht": {
      "preferred_label": "赦免（免除罪疚）",
      "descriptions": [
        {
          "source": "acai",
          "description": "免除犯錯之人的罪疚感。"
        }
      ]
    }
  },
