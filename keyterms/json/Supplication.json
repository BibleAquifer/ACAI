        }
      ]
    },
    "por": {
      "preferred_label": "pedido de misericórdia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pedir humildemente ajuda ou misericórdia a alguém com profundo respeito."
        }
      ]
    },
    "apd": {
      "preferred_label": "طلب رحمة",
      "descriptions": [
        {
          "source": "acai",
          "description": "طلب المساعدة أو الرحمة من زول بتواضع واحترام شديد."
        }
      ]
    },
    "arb": {
      "preferred_label": "طلب رحمة",
      "descriptions": [
        {
          "source": "acai",
          "description": "التماس المساعدة أو الرحمة بتواضع واحترام عميق."
        }
      ]
    },
    "bis": {
      "preferred_label": "Krae blong wantem sore",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong askem help no sore wetem tingting we i daon mo wetem bigfala respek."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kukan Neman Jinƙai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neman taimako ko jinƙai cikin kankan da kai da girmamawa mai zurfi daga wani."
        }
      ]
    },
    "hin": {
      "preferred_label": "दया की याचना",
      "descriptions": [
        {
          "source": "acai",
          "description": "गहरे आदर के साथ नम्रतापूर्वक किसी से सहायता या दया की याचना करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Arịrịọ maka ebere",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iji obi umeala na nkwanye ùgwù miri emi na-arịọ mmadụ enyemaka ma ọ bụ ebere."
        }
      ]
    },
    "nep": {
      "preferred_label": "दयाको निम्ति बिन्ती",
      "descriptions": [
        {
          "source": "acai",
          "description": "गहिरो आदरसहित कसैसँग सहायता वा दयाको निम्ति नम्र भई माग्ने काम।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Мольба о помиловании",
      "descriptions": [
        {
          "source": "acai",
          "description": "Смиренная просьба о помощи или милости, выраженная с глубоким почтением."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kilio cha Rehema",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumwomba mtu msaada au rehema kwa unyenyekevu na heshima kubwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Askim long marimari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hambol na askim man long helpim o marimari wantaim bikpela rispek."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời nài xin thương xót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Khiêm nhường cầu xin ai đó giúp đỡ hoặc thương xót với lòng tôn kính sâu sắc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "恳求怜悯",
      "descriptions": [
        {
          "source": "acai",
          "description": "带着深深的敬意，谦卑地向某人寻求帮助或怜悯。"
        }
      ]
    },
    "zht": {
      "preferred_label": "求憐憫",
      "descriptions": [
        {
          "source": "acai",
          "description": "懷著深切的敬意，謙卑地向某人尋求幫助或憐憫。"
        }
      ]
    }
  },
