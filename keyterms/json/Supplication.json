      "descriptions": [
        {
          "source": "acai",
          "description": "Le fait de demander humblement à quelqu'un de l'aide ou de la miséricorde avec un profond respect."
        }
      ]
    },
    "ind": {
      "preferred_label": "permohonan belas kasihan",
      "descriptions": [
        {
          "source": "acai",
