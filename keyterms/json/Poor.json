  "localizations": {
    "eng": {
      "preferred_label": "Poor",
      "alternate_labels": [
        "Humble",
        "Meek",
        "Before God"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "People who have little money or power and rely on God for help."
        }
      ]
    },
    "spa": {
      "preferred_label": "pobre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas que tienen poco dinero o poder y dependen de Dios para recibir ayuda."
        }
      ]
    },
    "fra": {
      "preferred_label": "pauvre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes qui ont peu d’argent ou de pouvoir et qui s’en remettent à Dieu pour obtenir de l’aide."
        }
      ]
    },
    "ind": {
      "preferred_label": "miskin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang memiliki sedikit uang atau kekuasaan dan bergantung pada bantuan Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "pobre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas que têm pouco dinheiro ou poder e dependem de Deus para obter ajuda."
        }
      ]
    },
    "apd": {
      "preferred_label": "مساكين",
      "descriptions": [
        {
          "source": "acai",
          "description": "الناس الما عندهم قروش كتيرة أو سلطة وبيعتمِدوا على الله للمساعدة."
        }
      ]
    },
    "arb": {
      "preferred_label": "مسكين",
      "descriptions": [
        {
          "source": "acai",
          "description": "أشخاص يملكون القليل من المال أو القوّة ويعتمدون على الله في طلب المعونة."
        }
      ]
    },
    "bis": {
      "preferred_label": "puaman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli no gat plante mane no paoa mo oli dipen long God blong i givhan long olgeta."
        }
      ]
    },
    "hau": {
      "preferred_label": "Matalauci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da ba su da kuɗi ko iko sosai, waɗanda suke dogara ga Allah domin taimako."
        }
      ]
    },
    "hin": {
      "preferred_label": "दीन",
      "descriptions": [
        {
          "source": "acai",
          "description": "वे लोग जिनके पास धन या सामर्थ्य बहुत कम होती है और जो सहायता के लिए परमेश्वर पर निर्भर रहते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị ogbenye",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị nwere obere ego ma ọ bụ ike, na-adaberekwa na Chineke maka enyemaka."
        }
      ]
    },
    "nep": {
      "preferred_label": "गरिब",
      "descriptions": [
        {
          "source": "acai",
          "description": "थोरै पैसा वा सामर्थ्य भएका र सहायताको निम्ति परमेश्‍वरमाथि भर पर्ने मानिसहरू।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Бедные",
      "descriptions": [
        {
          "source": "acai",
          "description": "Люди, имеющие мало денег или власти и уповающие на помощь Бога."
        }
      ]
    },
    "swh": {
      "preferred_label": "Maskini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wenye pesa au uwezo mdogo na wanaomtegemea Mungu kwa msaada."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rabismen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i no gat planti mani kago o strong na ol i save wetim God long helpim ol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người nghèo khó",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người có ít tiền của hoặc quyền thế và nương cậy nơi Đức Chúa Trời để được giúp đỡ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "贫穷人",
      "descriptions": [
        {
          "source": "acai",
          "description": "缺乏金钱或权势、仰赖上帝帮助的人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "貧窮人",
      "descriptions": [
        {
          "source": "acai",
          "description": "少有金錢或權勢、依靠上帝幫助的人。"
        }
      ]
    }
  },
