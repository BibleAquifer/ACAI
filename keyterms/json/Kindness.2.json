  "localizations": {
    "eng": {
      "preferred_label": "Kindness (Graciousness)",
      "alternate_labels": [
        "Forbearance",
        "Graciousness"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Showing patience, gentleness, and grace to others, even when it is difficult."
        }
      ]
    },
    "spa": {
      "preferred_label": "amabilidad (gracia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mostrar paciencia, mansedumbre y gracia a los demás, incluso cuando resulta difícil."
        }
      ]
    },
    "fra": {
      "preferred_label": "bonté (grâce)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faire preuve de patience, de douceur et de grâce envers les autres, même lorsque c'est difficile."
        }
      ]
    },
    "ind": {
      "preferred_label": "kemurahan (kasih karunia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menunjukkan kesabaran, kelemahlembutan, dan kasih karunia kepada orang lain, bahkan ketika hal itu sulit."
        }
      ]
    },
    "por": {
      "preferred_label": "bondade (benevolência)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demonstrar paciência, mansidão e graça aos outros, mesmo quando é difícil."
        }
      ]
    },
    "apd": {
      "preferred_label": "لطف (نعمة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار الصبر والوداعة والنعمة للآخرين، حتى لما يكون الموضوع صعب."
        }
      ]
    },
    "arb": {
      "preferred_label": "لطف (نعمة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار الصبر والوداعة والنعمة للآخرين، حتى عندما يكون ذلك صعبًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "gudfala fasin (gladhat)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong soemaot longfala tingting, kwaet fasin, mo gladhat long ol narafala man, nating se i had."
        }
      ]
    },
    "hau": {
      "preferred_label": "Alheri (Sauƙinkai)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna haƙuri, sauƙinkai, da alheri ga wasu, ko da a lokacin da yake da wuya."
        }
      ]
    },
    "hin": {
      "preferred_label": "दया (अनुग्रह)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दूसरों के प्रति धीरज, नम्रता और अनुग्रह दिखाना, तब भी जब यह कठिन हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Obiọma (Amara)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosipụta ndidi, nwayọọ, na amara nʼebe ndị ọzọ nọ, ọbụna mgbe o siri ike."
        }
      ]
    },
    "nep": {
      "preferred_label": "दया (अनुग्रह)",
      "descriptions": [
        {
          "source": "acai",
          "description": "गाह्रो हुँदा पनि अरूप्रति धैर्य, नम्रता र अनुग्रह देखाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Доброта (великодушие)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявление терпения, кротости и милости к другим, даже когда это трудно."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wema (Neema)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuonyesha subira, upole, na neema kwa wengine, hata wakati inapokuwa vigumu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "gutpela pasin (marimari)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Soim pasin bilong i no belhat kwik, isi pasin, na marimari long ol arapela, maski i hatwok long mekim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lòng nhân từ (ân điển)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bày tỏ sự nhẫn nại, dịu dàng và ân sủng đối với người khác, ngay cả khi điều đó khó khăn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "仁慈 (恩典)",
      "descriptions": [
        {
          "source": "acai",
          "description": "向他人表现出忍耐、温柔和恩典，即便在艰难之时。"
        }
      ]
    },
    "zht": {
      "preferred_label": "恩慈 (恩惠)",
      "descriptions": [
        {
          "source": "acai",
          "description": "即使在困難之際，仍對他人表現出忍耐、溫和與恩典。"
        }
      ]
    }
  },
