        }
      ]
    },
    "por": {
      "preferred_label": "símbolo (sinal)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo que mostra ou representa uma ideia, ensino ou verdade."
        }
      ]
    },
    "apd": {
      "preferred_label": "رمز (علامة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة بتوضح أو بتمثّل فكرة، أو تعليم، أو حقيقة."
        }
      ]
    },
    "arb": {
      "preferred_label": "رمز (آية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "شيء يظهر أو يمثل فكرة أو تعليمًا أو حقيقة."
        }
      ]
    },
    "bis": {
      "preferred_label": "saen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we i soemaot wan tingting, tijing, no trutok."
        }
      ]
    },
    "hau": {
      "preferred_label": "Alama (Abin Nuni)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da yake nuna ko wakiltar wani tunani, koyarwa, ko gaskiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रतीक (चिन्ह)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुछ ऐसा जो किसी विचार, शिक्षा या सत्य को दर्शाता या प्रस्तुत करता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe nnọchianya (Ihe ịrịbama)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe na-egosi ma ọ bụ na-anọchi anya echiche, ozizi, ma ọ bụ eziokwu."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रतीक (चिन्ह)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै विचार, शिक्षा वा सत्यलाई देखाउने वा प्रतिनिधित्व गर्ने कुरा।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Символ (знамение)",
      "descriptions": [
        {
          "source": "acai",
          "description": "То, что показывает или представляет какую-либо идею, учение или истину."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ishara (Kielelezo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu kinachoonyesha au kuwakilisha wazo, fundisho, au ukweli fulani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "mak (sain)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting i makim o soim wanpela tingting, tok skul, o tok i tru."
        }
      ]
    },
    "vie": {
      "preferred_label": "Biểu tượng (Dấu hiệu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Điều chỉ ra hoặc tượng trưng cho một ý tưởng, lời dạy, hoặc lẽ thật."
        }
      ]
    },
    "zhs": {
      "preferred_label": "象征 (神迹)",
      "descriptions": [
        {
          "source": "acai",
          "description": "表现或代表某种观点、教导或真理的事物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "象徵（記號）",
      "descriptions": [
        {
          "source": "acai",
          "description": "表明或代表某種觀念、教導或真理的事物。"
        }
      ]
    }
  },
