  "localizations": {
    "eng": {
      "preferred_label": "Cause to Stumble",
      "alternate_labels": [
        "Cause to Sin"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To make someone do wrong or sin, often by creating a hard or tricky situation."
        }
      ]
    },
    "spa": {
      "preferred_label": "hacer tropezar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer que alguien obre mal o peque, a menudo al crear una situación difícil o engañosa."
        }
      ]
    },
    "fra": {
      "preferred_label": "faire trébucher",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pousser quelqu’un à mal agir ou à pécher, souvent en créant une situation difficile ou piégeuse."
        }
      ]
    },
    "ind": {
      "preferred_label": "menyesatkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyebabkan seseorang berbuat salah atau berdosa, sering kali dengan menciptakan situasi yang sulit atau menjebak."
        }
      ]
    },
    "por": {
      "preferred_label": "fazer tropeçar",
      "alternate_labels": [
        "fazer tropeçar"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Fazer alguém fazer o que é errado ou pecar, frequentemente criando uma situação difícil ou enganosa."
        }
      ]
    },
    "apd": {
      "preferred_label": "يوقّع في عثرة",
      "descriptions": [
        {
          "source": "acai",
          "description": "تخلي زول يغلط أو يرتكب خطية، وغالباً بإنك تعمل موقف صعب أو مخادع."
        }
      ]
    },
    "arb": {
      "preferred_label": "إعثار",
      "descriptions": [
        {
          "source": "acai",
          "description": "جعل شخص يرتكب خطأ أو يخطئ، غالبًا من خلال خلق موقف صعب أو خادع."
        }
      ]
    },
    "bis": {
      "preferred_label": "mekem i foldaon long sin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekem wan man i mekem samting we i no stret o mekem sin, plante taem tru long wan hadfala o triki situesen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sa yin tuntuɓe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sa wani ya yi zunubi ko ya yi laifi, sau da yawa ta wurin sa shi cikin mawuyacin hali ko tarko."
        }
      ]
    },
    "hin": {
      "preferred_label": "ठोकर खिलाना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी से गलत काम या पाप करवाना, अक्सर एक कठिन या पेचीदा स्थिति पैदा करके।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ime ka ọ jehie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka mmadụ mee ihe ọjọọ ma ọ bụ mee mmehie, ọkachasị site nʼime ka ihe sie ike ma ọ bụ site nʼọnyà."
        }
      ]
    },
    "nep": {
      "preferred_label": "ठेस पुऱ्याउनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः कठिन वा जटिल परिस्थिति सिर्जना गरेर कसैलाई गलत काम वा पाप गर्न लगाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Соблазнять",
      "descriptions": [
        {
          "source": "acai",
          "description": "Побуждать кого-либо поступать дурно или грешить, часто создавая трудную или двусмысленную ситуацию."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kukwaza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumfanya mtu atende kosa au dhambi, mara nyingi kwa kutengeneza hali ngumu au yenye mitego."
        }
      ]
    },
    "tpi": {
      "preferred_label": "mekim i pundaun long sin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim wanpela man o meri i mekim pasin kranki o pundaun long sin, planti taim long rot bilong kamapim wanpela hevi o traim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Làm cho vấp phạm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Khiến ai đó làm điều sai trái hoặc phạm tội, thường bằng cách tạo ra một tình huống khó khăn hoặc cám dỗ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "叫人跌倒",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某人做错事或犯罪，通常是通过制造困难或棘手的境况。"
        }
      ]
    },
    "zht": {
      "preferred_label": "叫人跌倒",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某人做錯事或犯罪，通常是藉由製造艱難或棘手的情境。"
        }
      ]
    }
  },
