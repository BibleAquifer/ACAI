{
  "id": "keyterm:Redeem.3",
  "primary_id": "keyterm:Redeem",
  "type": "keyterm",
  "keyterm_type": "miscellaneous",
  "ubsdbh": [
    "001245001004000",
    "001245001002000",
    "001245001001000",
    "001245001003000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "To Redeem (Liberate)",
      "alternate_labels": [
        "To Deliver"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To free someone or something from being owned by another, often by paying money."
        }
      ]
    },
    "spa": {
      "preferred_label": "redimir (liberar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Liberar a alguien o algo del dominio o posesión ajena, a menudo mediante el pago de un precio."
        }
      ]
    },
    "fra": {
      "preferred_label": "racheter (libérer)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Libérer quelqu'un ou quelque chose qui appartenait à autrui, souvent en payant un prix."
        }
      ]
    },
    "ind": {
      "preferred_label": "menebus (membebaskan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membebaskan seseorang atau sesuatu dari kepemilikan pihak lain, sering kali dengan membayar tebusan."
        }
      ]
    },
    "por": {
      "preferred_label": "resgatar (libertar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Libertar alguém ou algo do domínio de outro, frequentemente mediante pagamento."
        }
      ]
    },
    "apd": {
      "preferred_label": "يفدي (يحرر)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تحرير زول أو حاجة من ملكية زول تاني، غالباً بدفع قروش."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَفْدِي (يُحَرِّرُ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تَحْرِيرُ شَخْصٍ أَوْ شَيْءٍ مِنَ التَّبَعِيَّةِ لِآخَرَ، وَغَالِبًا مَا يَكُونُ ذَلِكَ بِدَفْعِ مَالٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Pem blong mekem i fri (mekem i fri)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong mekem wan man o wan samting i fri long han blong narafala man, plante taem tru long fasin blong pem mane."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fansarwa (’Yantarwa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "’Yantar da wani ko wani abu daga mallakar wani, sau da yawa ta wurin biyan kuɗi."
        }
      ]
    },
    "hin": {
      "preferred_label": "छुड़ाना (मुक्त करना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या वस्तु को किसी दूसरे के स्वामित्व से मुक्त कराना, प्रायः मूल्य चुकाकर।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgbapụta (Ịtọhapụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịtọhapụ mmadụ ma ọ bụ ihe site nʼịbụ nke onye ọzọ nwe, na-abụkarị site nʼịkwụ ụgwọ ego."
        }
      ]
    },
    "nep": {
      "preferred_label": "छुटकारा दिनु (मुक्त गर्नु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः मोल तिरेर कसैलाई वा कुनै थोकलाई अरूको स्वामित्वबाट मुक्त गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Искупать (освобождать)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Освободить кого-либо или что-либо из чужого владения, часто путем уплаты выкупа."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kukomboa (Kuweka Huru)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumuweka mtu au kitu huru kutoka katika kumilikiwa na mwingine, mara nyingi kwa kutoa malipo au fidia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kisim bek (Mekim i kamap fri)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Baim bek o mekim wanpela samting o man i kamap fri long kalabus o han bilong arapela man, planti taim long rot bilong baim long pe."
        }
      ]
    },
    "vie": {
      "preferred_label": "Chuộc (giải phóng)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Giải thoát ai đó hoặc vật gì khỏi sự sở hữu của người khác, thường bằng cách trả tiền chuộc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "救赎 (释放)",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某人或某物脱离他人的所有权而得自由，通常是通过付钱。"
        }
      ]
    },
    "zht": {
      "preferred_label": "救贖（釋放）",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某人或某物脫離他人的所有權而獲自由，通常透過付費贖回。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Redeem"
  ],
