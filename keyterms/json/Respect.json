  "localizations": {
    "eng": {
      "preferred_label": "Respect (Among People)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Feeling deep honor and sometimes fear for someone because of their importance or power."
        }
      ]
    },
    "apd": {
      "preferred_label": "احترام (بين الناس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إحساس بالإكرام العميق وأحياناً الخوف من زول بسبب مكانتو العالية أو سلطتو."
        }
      ]
    },
    "arb": {
      "preferred_label": "احترام (بين الناس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الشعور بإكرام عميق وخوف أحيانًا نحو شخص ما بسبب أهميته أو سلطانه."
        }
      ]
    },
    "bis": {
      "preferred_label": "ona (long medel blong ol man)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filing blong gat dip ona mo samtaem fraet long wan man from we hem i impoten o i gat paoa."
        }
      ]
    },
    "fra": {
      "preferred_label": "respect (entre les hommes)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Éprouver un profond respect et parfois de la crainte envers quelqu'un en raison de son importance ou de son pouvoir."
        }
      ]
    },
    "hau": {
      "preferred_label": "Girmamawa (A Tsakanin Mutane)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jin babban girmamawa da kuma wani lokaci tsoro ga wani saboda muhimmancinsa ko ikonsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "आदर (लोगों के बीच)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति के महत्व या शक्ति के कारण उसके प्रति गहरा आदर और कभी-कभी भय महसूस करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nsọpụrụ (Nʼetiti Mmadụ na Ibe Ya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe mmetụta nsọpụrụ miri emi na mgbe ụfọdụ egwu nʼebe mmadụ nọ nʼihi ịdị mkpa ya ma ọ bụ ike ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "hormat (antarsesama manusia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Merasakan rasa hormat yang mendalam dan terkadang rasa takut kepada seseorang karena kedudukan penting atau kekuasaannya."
        }
      ]
    },
    "nep": {
      "preferred_label": "आदर (मानिसहरूबीच)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैको महत्त्व वा शक्तिको कारणले उसको निम्ति गहिरो आदर र कहिलेकाहीँ भय महसुस गर्नु।"
        }
      ]
    },
    "por": {
      "preferred_label": "respeito (entre pessoas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentir profunda honra e, às vezes, temor por alguém por causa da importância ou do poder dessa pessoa."
        }
      ]
    },
    "rus": {
      "preferred_label": "Уважение (между людьми)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Глубокое почтение и иногда страх перед кем-либо из-за его значимости или власти."
        }
      ]
    },
    "spa": {
      "preferred_label": "respeto (entre personas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentir profunda honra y a veces temor por alguien debido a su importancia o poder."
        }
      ]
    },
    "swh": {
      "preferred_label": "Heshima (Kati ya Watu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhisi heshima kuu na wakati mwingine hofu kwa mtu fulani kwa sababu ya umuhimu au mamlaka yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ona (namel long ol manmeri)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bikpela pasin bilong givim biknem na sampela taim pret long man long wanem em i gat bikpela nem o strong."
        }
      ]
    },
    "vie": {
      "preferred_label": "kính trọng (giữa con người)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cảm thấy hết lòng tôn kính và đôi khi kính sợ một người vì tầm quan trọng hoặc quyền thế của họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "尊重（人与人之间）",
      "descriptions": [
        {
          "source": "acai",
          "description": "因某人的重要性或权柄而对其深怀尊崇，有时甚至带有惧怕。"
        }
      ]
    },
    "zht": {
      "preferred_label": "敬重（人與人之間）",
      "descriptions": [
        {
          "source": "acai",
          "description": "因某人的崇高身分或權柄而產生的深切敬意，有時甚至包含敬畏。"
        }
      ]
    }
  },
