        }
      ]
    },
    "hin": {
      "preferred_label": "ऐश्वर्य",
      "descriptions": [
        {
          "source": "acai",
          "description": "महानता और गरिमा जो किसी व्यक्ति या वस्तु को प्रभावशाली और आदरणीय बनाती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebube",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịdị ukwuu na ùgwù nke na-eme ka mmadụ ma ọ bụ ihe mara mma nke ukwuu ma bụrụkwa nke a na-asọpụrụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रताप",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई वा कुनै थोकलाई प्रभावकारी र आदरणीय बनाउने महानता र गरिमा।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Величие",
      "descriptions": [
        {
          "source": "acai",
          "description": "Величие и достоинство, которые делают кого-либо или что-либо впечатляющим и исполненным чести."
        }
      ]
    },
    "swh": {
      "preferred_label": "Enzi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ukuu na heshima inayomfanya mtu au kitu kionekane chenye kuvutia sana na cha kuheshimika."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Biknem na strong bilong king",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bikpela strong, bilas na biknem i mekim wanpela man o samting i luk naispela na i stap antap tru na manmeri i mas givim biknem long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Uy nghiêm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sự vĩ đại và phẩm giá làm cho ai đó hoặc điều gì đó trông uy nghi và đáng tôn kính."
        }
      ]
    },
    "zhs": {
      "preferred_label": "威严",
      "descriptions": [
        {
          "source": "acai",
          "description": "使人或事物显得令人敬畏且受人尊敬的伟大与尊严。"
        }
      ]
    },
    "zht": {
      "preferred_label": "威嚴",
      "descriptions": [
        {
          "source": "acai",
          "description": "使人或事物顯得令人肅然起敬且尊貴的偉大與尊榮。"
        }
      ]
    }
  },
