  "localizations": {
    "eng": {
      "preferred_label": "Hand Over",
      "alternate_labels": [
        "Forgive",
        "Hand Over",
        "Give Freely",
        "Be Restored"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To freely give something to someone, often showing kindness or forgiveness."
        }
      ]
    },
    "spa": {
      "preferred_label": "conceder",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dar libremente algo a alguien, a menudo mostrando bondad o perdón."
        }
      ]
    },
    "fra": {
      "preferred_label": "remettre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Donner gratuitement quelque chose à quelqu'un, souvent en faisant preuve de bienveillance ou de pardon."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengaruniakan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memberikan sesuatu secara cuma-cuma kepada seseorang, sering kali menunjukkan kebaikan hati atau pengampunan."
        }
      ]
    },
    "por": {
      "preferred_label": "conceder",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dar algo livremente a alguém, muitas vezes demonstrando bondade ou perdão."
        }
      ]
    },
    "apd": {
      "preferred_label": "يهب",
      "descriptions": [
        {
          "source": "acai",
          "description": "إعطاء شيء ما مجاناً لزول، وغالباً يظهر لطف أو مسامحة."
        }
      ]
    },
    "arb": {
      "preferred_label": "سامح",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن تمنح شخصًا شيئًا عن طيب خاطر، وغالبًا ما يُظهر ذلك لطفًا أو مسامحة."
        }
      ]
    },
    "bis": {
      "preferred_label": "fogivim fri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong givim wan samting fri long narafala man, we plante taem i soemaot kaen fasin o fogif."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yafewa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bada wani abu ga wani kyauta, sau da yawa yana nuna alheri ko gafara."
        }
      ]
    },
    "hin": {
      "preferred_label": "क्षमा करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी को स्वेच्छा से कुछ देना, प्रायः दया या क्षमा प्रकट करते हुए।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgbaghara nʼefu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iwere ihe nʼefu nye mmadụ, na-egosikarị obiọma ma ọ bụ mgbaghara."
        }
      ]
    },
    "nep": {
      "preferred_label": "सुम्पिदिनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः दया वा क्षमा देखाउँदै कसैलाई कुनै कुरा स्वतन्त्र रूपमा दिनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Даровать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Безвозмездно отдавать что-либо кому-либо, часто проявляя доброту или прощение."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusamehe kwa Neema",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumpa mtu kitu kwa hiari, mara nyingi ikionyesha fadhili au msamaha."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Givim nating",
      "descriptions": [
        {
          "source": "acai",
          "description": "Givim wanpela samting nating long narapela man, planti taim bilong soim pasin marimari o lusim rong."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ban cho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ban cho ai điều gì một cách nhưng không, thường bày tỏ lòng nhân từ hoặc sự tha thứ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "施恩免除",
      "descriptions": [
        {
          "source": "acai",
          "description": "自愿把某事物赐给某人，通常显出仁慈或宽恕。"
        }
      ]
    },
    "zht": {
      "preferred_label": "恩免",
      "descriptions": [
        {
          "source": "acai",
          "description": "白白地將某物賜給某人，常展現出仁慈或寬恕。"
        }
      ]
    }
  },
