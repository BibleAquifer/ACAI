        }
      ]
    },
    "nep": {
      "preferred_label": "पुजारी पद (भूमिका)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वर र मानिसहरूको सेवा गर्न पुजारीले गर्ने काम र कर्तव्यहरू।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Священство (роль)",
      "descriptions": [
        {
          "source": "acai",
