        }
      ]
    },
    "tpi": {
      "preferred_label": "Wok pris (Wok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol wok na samting wanpela pris i save mekim bilong mekim wok bilong God na bilong ol manmeri."
