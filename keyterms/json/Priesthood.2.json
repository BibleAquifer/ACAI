      "preferred_label": "Chức tế lễ (Vai trò)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Công việc và nhiệm vụ mà một thầy tế lễ thực hiện để phục vụ Đức Chúa Trời và dân chúng."
        }
      ]
