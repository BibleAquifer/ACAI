        {
          "source": "acai",
          "description": "परमेश्वर और लोगों की सेवा करने के लिए एक याजक द्वारा किए जाने वाले कार्य और कर्तव्य।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọrụ nchụaja (Ọrụ)",
      "descriptions": [
        {
          "source": "acai",
