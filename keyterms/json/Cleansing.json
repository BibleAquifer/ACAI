      ]
    },
    "bis": {
      "preferred_label": "Fasin blong mekem i klin (NT)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wok no aksen blong mekem wan samting i klin tru long fasin blong tekemaot doti no samting we i mekem man i no klin long kastom no wosip."
        }
      ]
    },
