        }
      ]
    },
    "hin": {
      "preferred_label": "शुद्धिकरण (नया नियम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "धार्मिक गंदगी या अशुद्धता को दूर करके किसी चीज़ को शुद्ध करने का कार्य।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ido ọcha (Agba Ọhụrụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Omume nke ime ka ihe dị ọcha site nʼiwepụ unyi ma ọ bụ adịghị ọcha nke ememe."
        }
      ]
    },
    "nep": {
      "preferred_label": "शुद्धिकरण (नयाँ नियम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विधिको फोहोर वा अशुद्धता हटाएर कुनै थोकलाई सफा वा शुद्ध पार्ने कार्य।"
        }
      ]
    },
    "rus": {
      "preferred_label": "очищение (НЗ)",
