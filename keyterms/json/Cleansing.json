        }
      ]
    },
    "swh": {
      "preferred_label": "Utakaso (AJ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitendo cha kufanya kitu kuwa safi kwa kuondoa uchafu au unajisi wa kiibada."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong mekim i kamap klin (Nupela Testamen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wok bilong mekim samting i kamap klin long rot bilong rausim doti o pasin i no klin long ai bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự thanh tẩy (Tân Ước)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành động làm cho một vật trở nên sạch sẽ bằng cách loại bỏ sự ô uế hoặc bẩn thỉu theo nghi lễ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "洁净 (新约)",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过除去礼仪上的污秽或不洁使某物洁净的行为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "潔淨 (新約)",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由除去禮儀上的污垢或不潔使事物潔淨的行動。"
        }
      ]
    }
