{
  "id": "keyterm:Admit",
  "primary_id": "keyterm:Repent",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "002792001002000",
    "002792001003000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "To Admit",
      "alternate_labels": [
        "Confess",
        "Acknowledge (One's Sins Before God)"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To honestly tell God about your sins, whether alone or with others."
        }
      ]
    },
    "spa": {
      "preferred_label": "confesar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Decir honestamente a Dios los pecados propios, ya sea a solas o con otros."
        }
      ]
    },
    "fra": {
      "preferred_label": "avouer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Reconnaître sincèrement ses péchés devant Dieu, seul ou avec d'autres."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengaku",
      "descriptions": [
        {
          "source": "acai",
          "description": "Secara jujur mengakui dosa kepada Allah, baik secara pribadi maupun bersama orang lain."
        }
      ]
    },
    "por": {
      "preferred_label": "confessar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Declarar honestamente a Deus os próprios pecados, a sós ou diante de outros."
        }
      ]
    },
    "apd": {
      "preferred_label": "يعترف (يقر بالخطية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الاعتراف لله بالخطايا بصدق، سواء على انفراد أو مع الآخرين."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِقْرَار",
      "descriptions": [
        {
          "source": "acai",
          "description": "إخبار الله بالخطايا بصدق، سواء على انفراد أو مع الآخرين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Talemaot Sin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong talemaot klia ol sin blong yu long God, yu wan no wetem ol narafala man."
        }
      ]
    },
    "hau": {
      "preferred_label": "Furtawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faɗa wa Allah zunubanka da gaskiya, ko kai kaɗai ne ko kuma tare da wasu."
        }
      ]
    },
    "hin": {
      "preferred_label": "मान लेना",
      "descriptions": [
        {
          "source": "acai",
          "description": "अकेले या दूसरों के साथ, परमेश्वर के सामने ईमानदारी से अपने पापों को बताना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikwupụta mmehie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iji eziokwu gwa Chineke banyere mmehie gị niile, ma ọ bụ naanị gị maọbụ gị na ndị ọzọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "स्वीकार गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक्लै वा अरूहरूसँग मिलेर इमानदारीपूर्वक परमेश्‍वरको सामु आफ्ना पापहरू भन्‍नु वा स्वीकार गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Исповедовать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Искренне говорить Богу о своих грехах, наедине или вместе с другими."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kukiri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumweleza Mungu dhambi zako kwa unyoofu, iwe peke yako au pamoja na wengine."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Autim sin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long autim klia ol sin bilong yu long God, long yu yet wanpela o wantaim ol arapela."
        }
      ]
    },
    "vie": {
      "preferred_label": "Xưng tội",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thành thật giãi bày với Đức Chúa Trời về tội lỗi của mình, dù là riêng tư hay cùng với người khác."
        }
      ]
    },
    "zhs": {
      "preferred_label": "认罪",
      "descriptions": [
        {
          "source": "acai",
          "description": "无论是独自还是与他人一起，向上帝坦诚承认自己的罪。"
        }
      ]
    },
    "zht": {
      "preferred_label": "認罪",
      "descriptions": [
        {
          "source": "acai",
          "description": "誠實地向上帝陳明自己的罪，無論是獨自一人還是與他人一起。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Repent"
  ],
