  "localizations": {
    "eng": {
      "preferred_label": "Universe",
      "alternate_labels": [
        "Age",
        "Era"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "All creation, including everything in space and time, often understood as a period or age that will pass away."
        }
      ]
    },
    "spa": {
      "preferred_label": "universo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Toda la creación, incluido todo en el espacio y el tiempo, a menudo entendida como un período o era que pasará."
        }
      ]
    },
    "fra": {
      "preferred_label": "univers",
      "descriptions": [
        {
          "source": "acai",
          "description": "Toute la création, y compris tout ce qui se trouve dans l'espace et le temps, souvent comprise comme une période ou un âge qui passera."
        }
      ]
    },
    "ind": {
      "preferred_label": "alam semesta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seluruh ciptaan, termasuk segala sesuatu di ruang dan waktu, sering kali dipahami sebagai suatu periode atau zaman yang akan berlalu."
        }
      ]
    },
    "por": {
      "preferred_label": "universo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Toda a criação, incluindo tudo no espaço e no tempo, frequentemente compreendida como um período ou era que passará."
        }
      ]
    },
    "apd": {
      "preferred_label": "الكون",
      "descriptions": [
        {
          "source": "acai",
          "description": "كل الخليقة، بما فيها كل شي في المكان والزمان، وغالباً بتتفهم كفترة أو دهر ح ينتهي."
        }
      ]
    },
    "arb": {
      "preferred_label": "كَوْن",
      "descriptions": [
        {
          "source": "acai",
          "description": "كل الخليقة، بما يشمل كل ما في المكان والزمان، وغالبًا ما يُفهم كحقبة أو دهر يزول."
        }
      ]
    },
    "bis": {
      "preferred_label": "yunives",
      "descriptions": [
        {
          "source": "acai",
          "description": "Olgeta samting we God i mekem, wetem heven mo wol mo evri samting insaed long olgeta, we samtaem oli luk olsem wan taem o wan laef we bambae i pas."
        }
      ]
    },
    "hau": {
      "preferred_label": "sararin samaniya da duniya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dukan halitta, haɗe da kowane abu a sararin samaniya da lokaci, wanda sau da yawa ake fahimta a matsayin zamani ko kwanaki da za su shuɗe."
        }
      ]
    },
    "hin": {
      "preferred_label": "सृष्टि",
      "descriptions": [
        {
          "source": "acai",
          "description": "समस्त सृष्टि, जिसमें देश (स्थान) और काल की सभी वस्तुएं सम्मिलित हैं, जिसे प्रायः ऐसे काल या युग के रूप में समझा जाता है जो बीत जाएगा।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụwa niile",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe niile e kere eke, gụnyere ihe niile dị n'ime mbara igwe na oge, nke a na-aghọtakarị dị ka oge ma ọ bụ ọgbọ nke ga-agafe agafe."
        }
      ]
    },
    "nep": {
      "preferred_label": "ब्रह्माण्ड",
      "descriptions": [
        {
          "source": "acai",
          "description": "सम्पूर्ण सृष्टि, जसमा अन्तरिक्ष र समयका सबै थोक समावेश छन्, प्रायः बितेर जाने एक युग वा अवधिको रूपमा बुझिने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "вселенная",
      "descriptions": [
        {
          "source": "acai",
          "description": "Все творение, включая всё существующее в пространстве и времени; часто понимается как период или век, который пройдет."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ulimwengu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uumbaji wote, pamoja na kila kitu katika anga na wakati, mara nyingi ikieleweka kama kipindi au enzi itakayopita."
        }
      ]
    },
    "tpi": {
      "preferred_label": "heven na graun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Olgeta samting God i bin wokim, em olgeta heven na graun na olgeta hap na taim, em planti taim ol i tingim olsem wanpela hap taim we bai i pinis."
        }
      ]
    },
    "vie": {
      "preferred_label": "vũ trụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Toàn bộ cõi tạo vật, bao gồm mọi sự trong không gian và thời gian, thường được hiểu là một thời kỳ hay thời đại sẽ qua đi."
        }
      ]
    },
    "zhs": {
      "preferred_label": "宇宙",
      "descriptions": [
        {
          "source": "acai",
          "description": "受造的万物，包含时空中的一切，常被理解为一个将要过去的世代或时期。"
        }
      ]
    },
    "zht": {
      "preferred_label": "宇宙",
      "descriptions": [
        {
          "source": "acai",
          "description": "一切受造物，包括時空中的萬事萬物，常被理解為將會消逝的時期或世代。"
        }
      ]
    }
  },
