{
  "id": "keyterm:Offering.2",
  "primary_id": "keyterm:Offering",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "localizations": {
    "eng": {
      "preferred_label": "Offering (Contribution)",
      "alternate_labels": [
        "Contribution"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Something given to God or others to show love, thanks, or support."
        }
      ]
    },
    "spa": {
      "preferred_label": "ofrenda (contribución)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo que se da a Dios o a otros para mostrar amor, gratitud o apoyo."
        }
      ]
    },
    "fra": {
      "preferred_label": "offrande (contribution)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quelque chose donné à Dieu ou à d’autres pour manifester son amour, sa reconnaissance ou son soutien."
        }
      ]
    },
    "ind": {
      "preferred_label": "persembahan (sumbangan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sesuatu yang diberikan kepada Allah atau orang lain untuk menunjukkan kasih, ucapan syukur, atau dukungan."
        }
      ]
    },
    "por": {
      "preferred_label": "oferta (contribuição)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo dado a Deus ou a outros para demonstrar amor, gratidão ou apoio."
        }
      ]
    },
    "apd": {
      "preferred_label": "تقدمة (مساهمة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة بتِتقدّم لله أو للناس عشان تبيّن المحبة، أو الشكر، أو الدعم."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَقْدِمَة (تَبَرُّع)",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَيْءٌ يُعْطَى لِلهِ أَوْ لِلْآخَرِينَ إِظْهَارًا لِلْمَحَبَّةِ أَوِ ٱلشُّكْرِ أَوِ ٱلدَّعْمِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Presen (Kontribiusen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we man i givim long God o long ol narafala man blong soemaot lav, tangkiu, o givhan."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hadaya (Gudummawa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da ake ba wa Allah ko wasu don nuna ƙauna, godiya, ko taimako."
        }
      ]
    },
    "hin": {
      "preferred_label": "भेंट (अंशदान)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रेम, धन्यवाद या सहायता प्रकट करने के लिए परमेश्वर या दूसरों को दी जाने वाली कोई वस्तु।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onyinye (Ntinye aka)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe e nyere Chineke maọbụ ndị ọzọ iji gosi ịhụnanya, ekele, maọbụ nkwado."
        }
      ]
    },
    "nep": {
      "preferred_label": "भेटी (दान)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रेम, धन्यवाद वा समर्थन देखाउन परमेश्‍वर वा अरू कसैलाई दिइने थोक।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Приношение (пожертвование)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Нечто, отдаваемое Богу или другим людям в знак любви, благодарности или поддержки."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sadaka (Mchango)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu kinachotolewa kwa Mungu au kwa wengine ili kuonyesha upendo, shukrani, au msaada."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ofa (Givim Samting)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting ol i givim long God o long ol arapela manmeri bilong soim pasin laikim, tenkyu, o helpim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ vật (Đóng góp)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vật được dâng lên Đức Chúa Trời hoặc người khác để bày tỏ tình yêu thương, lòng biết ơn hoặc sự hỗ trợ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "奉献（捐献）",
      "descriptions": [
        {
          "source": "acai",
          "description": "献给上帝或他人以表达爱心、感谢或支持的物品。"
        }
      ]
    },
    "zht": {
      "preferred_label": "供物（捐獻）",
      "descriptions": [
        {
          "source": "acai",
          "description": "獻給上帝或他人以表達愛、感恩或支持的事物。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Offering"
  ],
