{
  "id": "keyterm:Deceive",
  "primary_id": "keyterm:Deceit",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "006815002001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Deceive",
      "alternate_labels": [
        "Betray"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To make someone believe something false or to trick them on purpose."
        }
      ]
    },
    "spa": {
      "preferred_label": "engañar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer que alguien crea algo falso o engañarlo a propósito."
        }
      ]
    },
    "fra": {
      "preferred_label": "tromper",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faire croire à quelqu'un quelque chose de faux ou le tromper délibérément."
        }
      ]
    },
    "ind": {
      "preferred_label": "menipu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membuat seseorang memercayai sesuatu yang salah atau sengaja memperdaya mereka."
        }
      ]
    },
    "por": {
      "preferred_label": "Enganar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fazer alguém acreditar em algo falso ou enganar intencionalmente."
        }
      ]
    },
    "apd": {
      "preferred_label": "يخدع",
      "descriptions": [
        {
          "source": "acai",
          "description": "تخلي زول يصدق حاجة كضب أو تغشه عن قصد."
        }
      ]
    },
    "arb": {
      "preferred_label": "خدع",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن تجعل شخصًا يصدق أمرًا باطلًا أو أن تخدعه عن قصد."
        }
      ]
    },
    "bis": {
      "preferred_label": "Giaman long / Trikim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem narafala man i bilivim wan samting we i giaman no blong trikim hem wetem tingting blong mekem olsem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ruɗa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sa wani ya gaskata wani abu na ƙarya ko kuma ruɗinsa da gangan."
        }
      ]
    },
    "hin": {
      "preferred_label": "धोखा देना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी को किसी झूठी बात पर विश्वास दिलाना या जानबूझकर धोखा देना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịghọgbu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka mmadụ kwere ihe na-abụghị eziokwu ma ọ bụ ịkpacha anya ghọgbuo ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "छल गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई कुनै असत्य कुरा विश्‍वास गराउनु वा जानाजानी झुक्याउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Обманывать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Заставлять кого-либо верить в ложь или намеренно вводить в заблуждение."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kudanganya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kufanya mtu aamini jambo la uongo au kumhadaa kimakusudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Giamanim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong mekim narapela man i bilipim tok giaman o trikim em long laik bilong em yet."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lừa dối",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm cho ai đó tin vào điều sai quấy hoặc cố ý lừa gạt họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "欺骗",
      "descriptions": [
        {
          "source": "acai",
          "description": "使人相信虚假的事，或故意诱骗他人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "欺哄",
      "descriptions": [
        {
          "source": "acai",
          "description": "故意使人相信虛假的事物或欺騙他人。"
        }
      ]
    }
  },
