{
  "id": "keyterm:Slander",
  "primary_id": "keyterm:Blaspheme",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "33.401",
    "33.400"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Blasphemy",
      "alternate_labels": [
        "Slander"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Speaking harmful and untrue words about someone or God that damage their reputation."
        }
      ]
    },
    "spa": {
      "preferred_label": "blasfemia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Decir palabras perjudiciales y falsas acerca de alguien o de Dios que dañan su reputación."
        }
      ]
    },
    "fra": {
      "preferred_label": "blasphème",
      "descriptions": [
        {
          "source": "acai",
          "description": "Paroles blessantes et mensongères proférées contre quelqu'un ou contre Dieu, qui portent atteinte à sa réputation."
        }
      ]
    },
    "ind": {
      "preferred_label": "hujat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengucapkan kata-kata yang menyakitkan dan tidak benar tentang seseorang atau Allah yang merusak reputasi mereka."
        }
      ]
    },
    "por": {
      "preferred_label": "blasfêmia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Falar palavras prejudiciais e falsas a respeito de alguém ou de Deus que prejudicam a reputação deles."
        }
      ]
    },
    "apd": {
      "preferred_label": "تجديف",
      "descriptions": [
        {
          "source": "acai",
          "description": "كلام كعب وما حقيقي بيتقال عن زول أو عن الله عشان يخرب سمعتو."
        }
      ]
    },
    "arb": {
      "preferred_label": "تجديف",
      "descriptions": [
        {
          "source": "acai",
          "description": "التفوه بكلمات مؤذية وغير صحيحة عن شخص ما أو عن الله، بما يسيء إلى السمعة أو المكانة."
        }
      ]
    },
    "bis": {
      "preferred_label": "tok nogud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Toktok ol nogud tok we i no tru agens long wan man no agens long God we i spolem nem blong olgeta."
        }
      ]
    },
    "hau": {
      "preferred_label": "Saɓo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faɗin munanan kalmomi marasa gaskiya game da wani ko Allah waɗanda suke ɓata sunansu."
        }
      ]
    },
    "hin": {
      "preferred_label": "निन्दा",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या परमेश्वर के बारे में हानिकारक और झूठी बातें बोलना जिससे उनकी प्रतिष्ठा को ठेस पहुँचे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nkwulu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikwu okwu ọjọọ na okwu ụgha banyere mmadụ maọbụ Chineke nke na-emebi aha ọma ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "निन्दा",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैको वा परमेश्‍वरको प्रतिष्ठामा आँच पुर्‍याउने गरी बोलिएका हानिकारक र असत्य वचनहरू।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Хула",
      "descriptions": [
        {
          "source": "acai",
          "description": "Произнесение пагубных и ложных слов о ком-либо или о Боге, порочащих их репутацию."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kufuru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kusema maneno mabaya na yasiyo ya kweli kuhusu mtu fulani au kuhusu Mungu yanayoharibu sifa zao."
        }
      ]
    },
    "tpi": {
      "preferred_label": "tok bilas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim ol tok i save bagarapim nem na tok giaman long narapela man o long God bilong bagarapim gutpela nem bilong ol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Phạm thượng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nói những lời tai hại và sai sự thật về ai đó hoặc về Đức Chúa Trời làm tổn hại đến danh dự của họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亵渎",
      "descriptions": [
        {
          "source": "acai",
          "description": "说关于某人或上帝的有害且不实的话，损害其声誉。"
        }
      ]
    },
    "zht": {
      "preferred_label": "褻瀆",
      "descriptions": [
        {
          "source": "acai",
          "description": "說出有關他人或上帝的有害且不真實的話語，敗壞其名譽。"
        }
      ]
    }
  },
  "referred_to_as": [
