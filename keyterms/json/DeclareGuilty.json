{
  "id": "keyterm:DeclareGuilty",
  "primary_id": "keyterm:DeclareGuilty",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "006945001002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "To Declare Guilty",
      "alternate_labels": [
        "To Condemn as Guilty"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To say that someone has done wrong or broken the law, either by people or before God."
        }
      ]
    },
    "spa": {
      "preferred_label": "declarar culpable",
      "descriptions": [
        {
          "source": "acai",
          "description": "Decir que alguien ha hecho el mal o ha quebrantado la ley, ya sea ante las personas o ante Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "déclarer coupable",
      "descriptions": [
        {
          "source": "acai",
          "description": "Déclarer que quelqu'un a mal agi ou enfreint la loi, que ce soit par des hommes ou devant Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "menyatakan bersalah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyatakan bahwa seseorang telah berbuat salah atau melanggar hukum, baik oleh manusia maupun di hadapan Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "Declarar culpado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dizer que alguém errou ou violou a lei, seja perante pessoas ou diante de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "يدين",
      "descriptions": [
        {
          "source": "acai",
          "description": "يقول إنه في زول عمل غلط أو كسر القانون، سواء من الناس أو قدام الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "يحكم بالذنب",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يُقال إن شخصًا قد أخطأ أو خالف الشريعة، سواء من قِبَل الناس أو أمام الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Talemaot se i rong",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong talemaot se wan man i mekem samting we i rong no i brekem loa, i save kam long ol man no long fes blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ba da laifi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faɗin cewa wani ya yi kuskure ko ya karya doka, ko a wurin mutane ko a gaban Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "दोषी ठहराना",
      "descriptions": [
        {
          "source": "acai",
          "description": "लोगों द्वारा या परमेश्वर के सामने यह कहना कि किसी ने गलत काम किया है या कानून तोड़ा है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịma Ikpe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikwu na mmadụ mere ihe ọjọọ ma ọ bụ mebie iwu, ma ọ bụ site nʼaka ụmụ mmadụ ma ọ bụ nʼihu Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "दोषी ठहराउनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "मानिसहरूद्वारा वा परमेश्‍वरको सामु कसैले गल्ती गरेको वा नियम तोडेको भनी भन्‍नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Обвинять",
      "descriptions": [
        {
          "source": "acai",
          "description": "Признавать кого-либо виновным в совершении проступка или нарушении закона — перед людьми или перед Богом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuhukumu kuwa na Hatia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kusema kwamba mtu ametenda kosa au amevunja sheria, iwe na wanadamu au mbele za Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kotim na makim olsem i gat asua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tokaut olsem wanpela man i mekim rong o brukim lo, long ai bilong ol man o long ai bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Định tội",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tuyên bố rằng ai đó đã làm điều sai trái hoặc phạm luật, bởi con người hoặc trước mặt Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "定罪",
      "descriptions": [
        {
          "source": "acai",
          "description": "指某人做了错事或触犯律法，由人或在上帝面前定其有罪。"
        }
      ]
    },
    "zht": {
      "preferred_label": "定罪",
      "descriptions": [
        {
          "source": "acai",
          "description": "由人或在上帝面前宣告某人有過錯或犯了法。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
