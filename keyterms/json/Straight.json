  "localizations": {
    "eng": {
      "preferred_label": "Be Straight",
      "alternate_labels": [
        "Make Straight (One's Way)"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To live or act in a clear and honest way, fixing problems to follow the right path."
        }
      ]
    },
    "spa": {
      "preferred_label": "enderezar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vivir o actuar de una manera clara y honesta, solucionando problemas para seguir el camino correcto."
        }
      ]
    },
    "fra": {
      "preferred_label": "marcher droit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vivre ou agir d'une manière claire et honnête, en rectifiant ce qui ne va pas pour suivre le droit chemin."
        }
      ]
    },
    "ind": {
      "preferred_label": "hidup lurus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hidup atau bertindak dengan cara yang jelas dan jujur, membenahi masalah demi mengikuti jalan yang benar."
        }
      ]
    },
    "por": {
      "preferred_label": "ser reto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Viver ou agir de modo claro e honesto, corrigindo problemas para seguir o caminho certo."
        }
      ]
    },
    "apd": {
      "preferred_label": "استقام",
      "descriptions": [
        {
          "source": "acai",
          "description": "العيشة أو التصرّف بطريقة واضحة وأمينة، وإصلاح المشاكل عشان اتّباع الطريق الصح."
        }
      ]
    },
    "arb": {
      "preferred_label": "استقام",
      "descriptions": [
        {
          "source": "acai",
          "description": "العيش أو التصرف بوضوح ونزاهة، وإصلاح العيوب لاتباع الطريق الصحيح."
        }
      ]
    },
    "bis": {
      "preferred_label": "stap stret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong laef no mekem samting long wan klia mo ona fasin, mo fiksimap ol trabol blong folem stret rod."
        }
      ]
    },
    "hau": {
      "preferred_label": "Miƙarwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin rayuwa ko aiki a hanya mai kyau da gaskiya, ana gyara matsaloli domin a bi tafarki madaidaici."
        }
      ]
    },
    "hin": {
      "preferred_label": "सीधा होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "सही मार्ग पर चलने के लिए समस्याओं को दूर करते हुए स्पष्ट और ईमानदार तरीके से जीना या कार्य करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikwụ ọtọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ibi ndụ ma ọ bụ ime ihe nʼụzọ doro anya na nke ziri ezi, na-edozi nsogbu iji soro ụzọ ziri ezi."
        }
      ]
    },
    "nep": {
      "preferred_label": "सोझो हुनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "ठीक मार्गमा हिँड्नका निम्ति समस्याहरू सुल्झाउँदै स्पष्ट र इमानदार ढङ्गले जिउनु वा काम गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Быть прямым",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жить или поступать открыто и честно, исправляя ошибки, чтобы следовать верным путем."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kunnyooka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuishi au kutenda kwa njia iliyo wazi na ya uaminifu, kurekebisha matatizo ili kufuata njia iliyo sawa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "wokabaut stret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong bihainim stretpela rot long laip na wokabaut, na stretim ol samting bilong bihainim stretpela rot."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ăn ở ngay thẳng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sống hoặc hành động một cách rõ ràng và trung thực, sửa chữa các sai trật để đi theo đường lối ngay lành."
        }
      ]
    },
    "zhs": {
      "preferred_label": "走正路",
      "descriptions": [
        {
          "source": "acai",
          "description": "以光明诚实的方式生活或行事，纠正偏差以走上正道。"
        }
      ]
    },
    "zht": {
      "preferred_label": "修直",
      "descriptions": [
        {
          "source": "acai",
          "description": "以光明磊落且誠實的方式生活或行事，糾正偏差以跟隨正道。"
        }
      ]
    }
  },
