  "localizations": {
    "eng": {
      "preferred_label": "Most Holy Place",
      "descriptions": [
        {
          "source": "acai",
          "description": "The special inner room in the temple or tabernacle where God's presence is closest."
        }
      ]
    },
    "fra": {
      "preferred_label": "lieu très saint",
      "descriptions": [
        {
          "source": "acai",
          "description": "La pièce intérieure spéciale du temple ou du tabernacle où la présence de Dieu est la plus proche."
        }
      ]
    },
    "ind": {
      "preferred_label": "tempat mahakudus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ruang dalam yang istimewa di bait suci atau kemah suci tempat kehadiran Allah paling dekat."
        }
      ]
    },
    "por": {
      "preferred_label": "Lugar Santíssimo",
      "descriptions": [
        {
          "source": "acai",
          "description": "O cômodo interior especial no templo ou no tabernáculo onde a presença de Deus está mais próxima."
        }
      ]
    },
    "apd": {
      "preferred_label": "قدس الأقداس",
      "descriptions": [
        {
          "source": "acai",
          "description": "الأوضة الجوانية الخاصة في الهيكل ولا خيمة الإجتماع، المحل الفيهو حضور الله قريب شديد."
        }
      ]
    },
    "arb": {
      "preferred_label": "قُدْسُ الأَقْدَاسِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "الحجرة الداخلية الخاصة في الهيكل أو خيمة الاجتماع حيث يكون حضور الله في أقرب ما يكون."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rum we i Tabu we i Tabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prapa insaed rum long haos tapolen no tempol we i stap klosap moa long fes blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Wuri Mafi Tsarki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗaki na ciki na musamman a cikin haikali ko tabanakul inda gaban Allah ya fi kusa."
        }
      ]
    },
    "hin": {
      "preferred_label": "परमपवित्र स्थान",
      "descriptions": [
        {
          "source": "acai",
          "description": "मंदिर या मिलापवाले तम्बू का वह विशेष भीतरी कक्ष जहाँ परमेश्वर की उपस्थिति सबसे निकट होती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebe Kachasị Nsọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọnụ ụlọ dị n'ime pụrụ iche n'ụlọ nsọ ma ọ bụ ụlọ ikwu ebe ọnụnọ Chineke kacha nọrọ nso."
        }
      ]
    },
    "nep": {
      "preferred_label": "महा-पवित्रस्थान",
      "descriptions": [
        {
          "source": "acai",
          "description": "मन्दिर वा बासस्थानको विशेष भित्री कोठा जहाँ परमेश्‍वरको उपस्थिति सबैभन्दा नजिक हुन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Святое святых",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особое внутреннее помещение храма или скинии, где Божье присутствие ближе всего."
        }
      ]
    },
    "spa": {
      "preferred_label": "Lugar Santísimo",
      "descriptions": [
        {
          "source": "acai",
          "description": "La habitación interior especial en el templo o tabernáculo donde la presencia de Dios está más cercana."
        }
      ]
    },
    "swh": {
      "preferred_label": "Patakatifu pa Patakatifu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chumba cha ndani cha pekee katika hekalu au hema ya kukutania ambapo uwepo wa Mungu unakaribiana zaidi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rum Tambu Tru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rum i stap insait tru long haus lotu o haus sel we presens bilong God i stap klostu tru."
        }
      ]
    },
    "vie": {
      "preferred_label": "Nơi Chí Thánh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Căn phòng đặc biệt bên trong của đền thờ hoặc đền tạm, nơi sự hiện diện của Đức Chúa Trời ở gần nhất."
        }
      ]
    },
    "zhs": {
      "preferred_label": "至圣所",
      "descriptions": [
        {
          "source": "acai",
          "description": "圣殿或圣幕中最里面的特殊房间，是与上帝同在最近之处。"
        }
      ]
    },
    "zht": {
      "preferred_label": "至聖所",
      "descriptions": [
        {
          "source": "acai",
          "description": "聖殿或會幕中最深處的特別房間，是上帝臨在最親近之處。"
        }
      ]
    }
  },
