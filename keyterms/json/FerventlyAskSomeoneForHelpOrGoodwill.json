  "localizations": {
    "eng": {
      "preferred_label": "Fervently Ask",
      "descriptions": [
        {
          "source": "acai",
          "description": "To plead earnestly and humbly for someone's help or kindness."
        }
      ]
    },
    "spa": {
      "preferred_label": "rogar fervientemente",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suplicar con fervor y humildad la ayuda o la bondad de alguien."
        }
      ]
    },
    "fra": {
      "preferred_label": "implorer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Supplier ardemment et humblement pour obtenir l'aide ou la bienveillance de quelqu'un."
        }
      ]
    },
    "ind": {
      "preferred_label": "memohon dengan sungguh-sungguh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memohon dengan sungguh-sungguh dan rendah hati untuk meminta pertolongan atau kebaikan seseorang."
        }
      ]
    },
    "apd": {
      "preferred_label": "يتضرع بحرارة",
      "descriptions": [
        {
          "source": "acai",
          "description": "الترجي بإلحاح وتواضع عشان زول يساعد أو يتكرم بالمعونة."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَضَرَّعَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يتوسل المرء بحرارة وتواضع طلبًا لعون شخص ما أو لطفه."
        }
      ]
    },
    "bis": {
      "preferred_label": "krae strong blong askem help",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong plis wetem olgeta tingting mo wetem tingting we i stap daon blong askem help no kaenfasin blong wan man."
        }
      ]
    },
    "hau": {
      "preferred_label": "Roƙo da ƙwazo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roƙo da ƙwazo da kuma tawali’u don neman taimako ko alherin wani."
        }
      ]
    },
    "hin": {
      "preferred_label": "गिड़गिड़ाना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी की सहायता या कृपा के लिए सच्चे मन और नम्रता से विनती या याचना करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịrịọsi arịrịọ ike",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịrịọsi arịrịọ ike na nʼobi umeala maka enyemaka maọbụ obiọma nke mmadụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "बिन्ती गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैको सहायता वा दयाको निम्ति गम्भीरता र नम्रतापूर्वक बिन्ती गर्नु।"
        }
      ]
    },
    "por": {
      "preferred_label": "suplicar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suplicar com fervor e humildade pela ajuda ou bondade de alguém."
        }
      ]
    },
    "rus": {
      "preferred_label": "умолять",
      "descriptions": [
        {
          "source": "acai",
          "description": "Усердно и смиренно молить кого-либо о помощи или милости."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusihi kwa Bidii",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuomba kwa bidii na kwa unyenyekevu msaada au wema wa mtu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "askim strong",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long askim strong tru na daunim yu yet long kisim helpim o gutpela pasin bilong narapela man."
        }
      ]
    },
    "vie": {
      "preferred_label": "Khẩn cầu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nài xin một cách tha thiết và khiêm nhường để nhận được sự giúp đỡ hoặc ân huệ của ai đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "恳求",
      "descriptions": [
        {
          "source": "acai",
          "description": "恳切谦卑地向某人寻求帮助或恩典。"
        }
      ]
    },
    "zht": {
      "preferred_label": "懇求",
      "descriptions": [
        {
          "source": "acai",
          "description": "懇切而謙卑地請求某人的幫助或恩惠。"
        }
      ]
    }
  },
