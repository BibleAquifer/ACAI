{
  "id": "keyterm:Declare",
  "primary_id": "keyterm:Declare",
  "type": "keyterm",
  "keyterm_type": "miscellaneous",
  "ubsdgnt": [
    "33.425",
    "33.319",
    "33.223"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Declare",
      "alternate_labels": [
        "Assert",
        "Charge Under Solemn Oath",
        "Warn",
        "Insist"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To say something clearly and with confidence, often to warn or teach based on personal knowledge."
        }
      ]
    },
    "spa": {
      "preferred_label": "testificar solemnemente",
      "descriptions": [
        {
          "source": "acai",
          "description": "Decir algo con claridad y firmeza, a menudo para advertir o enseñar basándose en el conocimiento personal."
        }
      ]
    },
    "fra": {
      "preferred_label": "déclarer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dire quelque chose clairement et avec assurance, souvent pour avertir ou enseigner sur la base d'une connaissance personnelle."
        }
      ]
    },
    "ind": {
      "preferred_label": "bersaksi dengan sungguh-sungguh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyatakan sesuatu secara jelas dan dengan yakin, sering kali untuk memperingatkan atau mengajar berdasarkan pengetahuan pribadi."
        }
      ]
    },
    "por": {
      "preferred_label": "Declarar",
      "alternate_labels": [
        "testemunhar solenemente"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Dizer algo claramente e com confiança, frequentemente para advertir ou ensinar com base em conhecimento pessoal."
        }
      ]
    },
    "apd": {
      "preferred_label": "يعلن",
      "descriptions": [
        {
          "source": "acai",
          "description": "يقول حاجة بوضوح وثقة، غالباً للتحذير أو التعليم بناءً على معرفة شخصية."
        }
      ]
    },
    "arb": {
      "preferred_label": "شهد",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يقول أمرًا بوضوح وثقة، غالبًا للتحذير أو التعليم بناءً على معرفة شخصية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Talemaot klia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong talemaot wan samting klia mo wetem konfidens, plante taem blong wonem no tijim man folem save we hem wan i gat."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bayyana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faɗin wani abu a sarari kuma da gaba gaɗi, sau da yawa don gargaɗi ko koyarwa bisa ga sani na kai."
        }
      ]
    },
    "hin": {
      "preferred_label": "घोषणा करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "व्यक्तिगत ज्ञान के आधार पर अक्सर चेतावनी देने या सिखाने के लिए स्पष्टता और दृढ़ता के साथ कुछ कहना या गवाही देना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikwuwapụta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikwu ihe nʼụzọ doro anya nakwa nʼatụghị egwu, na-abụkarị iji dọọ aka ná ntị ma ọ bụ kụzie ihe dabere nʼihe onwe onye maara."
        }
      ]
    },
    "nep": {
      "preferred_label": "घोषणा गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "व्यक्तिगत ज्ञानको आधारमा चेतावनी दिन वा सिकाउनका लागि स्पष्ट र विश्‍वासका साथ केही कुरा बताउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Возвещать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Говорить что-либо ясно и уверенно, часто с целью предостеречь или научить на основе личного знания."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutangaza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kusema jambo kwa uwazi na kwa ujasiri, mara nyingi ili kuonya au kufundisha kulingana na ufahamu binafsi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tokaut klia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tokaut klia na wantaim strong, planti taim bilong givim tok lukaut o lainim ol arapela man long samting man yet i save pinis long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tuyên bố",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nói điều gì đó một cách rõ ràng và quả quyết, thường là để cảnh báo hoặc dạy dỗ dựa trên sự hiểu biết riêng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "宣告",
      "descriptions": [
        {
          "source": "acai",
          "description": "清楚且自信地说出某事，通常是基于亲身了解而发出警告或施教。"
        }
      ]
    },
    "zht": {
      "preferred_label": "證明",
      "descriptions": [
        {
          "source": "acai",
          "description": "清楚且自信地陳述某事，常指基於親身所知進行警告或教導。"
        }
      ]
    }
  },
  "referred_to_as": [
