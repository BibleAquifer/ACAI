  ],
  "localizations": {
    "eng": {
      "preferred_label": "Fear (Reverence)",
      "alternate_labels": [
        "Worship",
        "Reverence (God)"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Showing deep respect and honor to God, feeling a mix of awe and serious reverence."
        }
      ]
    },
    "apd": {
      "preferred_label": "خوف (مهابة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار احترام عميق وإكرام لله، وإحساس فيهو هيبة ومهابة شديدة."
        }
      ]
    },
    "arb": {
      "preferred_label": "مخافة (توقير)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار الاحترام والتوقير العميقين لله، مع الشعور بمزيج من الهيبة والمهابة الشديدة."
        }
      ]
    },
    "bis": {
      "preferred_label": "ona gud long God (ona)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Soemaot bigfala respek mo ona long God, we man i filim we hem i ona gud mo i tinghevi long God."
        }
      ]
    },
    "fra": {
      "preferred_label": "crainte (révérence)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Témoignage d'un profond respect et d'honneur envers Dieu, mêlant vénération et sincère déférence."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tsoro (Ladabi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna matuƙar girmamawa da ɗaukaka ga Allah, tare da jin haɗin ban tsoro da tsananin ladabi."
        }
      ]
    },
    "hin": {
      "preferred_label": "भय (श्रद्धा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर के प्रति गहरा आदर और सम्मान प्रकट करना, जिसमें विस्मय और गंभीर श्रद्धा का भाव सम्मिलित हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Egwu (Nsọpụrụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosipụta nkwanye ùgwù na nsọpụrụ miri emi nye Chineke, inwe ngwakọta nke egwu na nkwanye ùgwù siri ike."
        }
      ]
    },
    "ind": {
      "preferred_label": "takut (penghormatan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menunjukkan rasa hormat yang mendalam dan penghormatan kepada Allah, merasakan perpaduan antara kekaguman dan takzim yang sungguh-sungguh."
        }
      ]
    },
    "nep": {
      "preferred_label": "भय (श्रद्धा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरप्रति गहिरो आदर र सम्मान देखाउने, भय र गम्भीर श्रद्धाको सम्मिश्रण महसुस गर्ने भाव।"
        }
      ]
    },
    "por": {
      "preferred_label": "Temor (reverência)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demonstração de profundo respeito e honra a Deus, sentindo uma mistura de reverência e temor solene."
        }
      ]
    },
    "rus": {
      "preferred_label": "Страх (благоговение)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявление глубокого почтения и уважения к Богу, сочетание трепета и благоговейного страха."
        }
      ]
    },
    "spa": {
      "preferred_label": "temor (reverencia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Manifestar profundo respeto y honra a Dios, experimentando una mezcla de asombro y solemne reverencia."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kicho (Heshima)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuonyesha heshima kuu na adhama kwa Mungu, kuhisi mchanganyiko wa kicho na kicho kikuu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pret (Bikpela Rispek)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pas bilong givim bikpela rispek na ona long God, na pilim bikpela reverens na guria wantaim amamas long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kính sợ (tôn kính)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bày tỏ lòng tôn kính và tôn vinh sâu sắc đối với Đức Chúa Trời, cảm nhận sự kết hợp giữa niềm kính sợ và tôn kính nghiêm cẩn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "敬畏 (尊崇)",
      "descriptions": [
        {
          "source": "acai",
          "description": "向上帝表达深切的尊敬与尊崇，心中交织着敬畏与庄重之情。"
        }
      ]
    },
    "zht": {
      "preferred_label": "敬畏（虔敬）",
      "descriptions": [
        {
          "source": "acai",
          "description": "對上帝表現出深切的尊敬與尊榮，兼具敬畏與莊重崇敬之情。"
        }
      ]
    }
  },
