{
  "id": "keyterm:Forgive.2",
  "primary_id": "keyterm:Forgive",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "003861001004000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Forgive (Wipe Out)",
      "descriptions": [
        {
          "source": "acai",
          "description": "To completely remove or cancel sins, making them as if they never happened."
        }
      ]
    },
    "spa": {
      "preferred_label": "perdonar (borrar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eliminar o cancelar por completo los pecados, haciendo como si nunca hubieran sucedido."
        }
      ]
    },
    "fra": {
      "preferred_label": "effacer (faire disparaître)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Supprimer ou effacer totalement les péchés, faisant comme s'ils n'avaient jamais eu lieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengampuni (menghapus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menghapus atau membatalkan dosa sepenuhnya, menjadikannya seolah-olah tidak pernah terjadi."
        }
      ]
    },
    "por": {
      "preferred_label": "perdoar (apagar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Remover ou cancelar completamente os pecados, fazendo com que seja como se nunca tivessem acontecido."
        }
      ]
    },
    "apd": {
      "preferred_label": "غفر (مسح)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إزالة الخطايا أو محيها تماماً، لدرجة كأنها ما حصلت أبداً."
        }
      ]
    },
    "arb": {
      "preferred_label": "غفر (محا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إزالة الخطايا أو إلغاؤها تمامًا، وجعلها كأنها لم تحدث أبدًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fogivim (Ravemaot)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong ravemaot no tekemaot ol sin fulwan, olsem we oli no bin hapen samtaem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gafarta (Shafe)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kawar da zunubai ko share su gaba ɗaya, wanda zai sa su zama kamar ba su taɓa faruwa ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "क्षमा करना (मिटा देना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "पापों को पूरी तरह से मिटा देना या रद्द कर देना, जिससे वे ऐसे हो जाएँ मानो कभी हुए ही न हों।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgbaghara (Hichapụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iwezuga ma ọ bụ ikpochapụ mmehie kpamkpam, na-eme ka ọ dị ka ha emeghị ma ọlị."
        }
      ]
    },
    "nep": {
      "preferred_label": "क्षमा गर्नु (मेटिदिनु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "पापहरूलाई पूर्ण रूपमा हटाउनु वा मेटिदिनु, जसले गर्दा ती कहिल्यै नभएजस्ता हुन्छन्।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Прощать (изглаживать)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Полностью изглаживать или отменять грехи, делая так, будто их никогда не было."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusamehe (Kufuta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuondoa au kufuta dhambi kabisa, na kuzifanya kana kwamba hazikutokea kamwe."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tha thứ (Xóa bỏ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Loại bỏ hoặc hủy bỏ hoàn toàn tội lỗi, khiến chúng như thể chưa từng xảy ra."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赦免（涂抹）",
      "descriptions": [
        {
          "source": "acai",
          "description": "完全除去或涂抹罪恶，使其如同从未发生过一样。"
        }
      ]
    },
    "zht": {
      "preferred_label": "赦免（塗抹）",
      "descriptions": [
        {
          "source": "acai",
          "description": "完全除去或消除罪過，使其宛如從未發生過一樣。"
        }
      ]
    }
  },
  "referred_to_as": [
