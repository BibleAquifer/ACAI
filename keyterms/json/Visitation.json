        }
      ]
    },
    "nep": {
      "preferred_label": "आगमन",
      "descriptions": [
        {
          "source": "acai",
          "description": "मानिसहरूलाई हेर्न वा सहायता गर्न परमेश्‍वर आउनुहुने विशेष समय।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Посещение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особое время, когда Бог приходит, чтобы явить Свое присутствие людям или помочь им."
