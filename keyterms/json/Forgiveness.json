{
  "id": "keyterm:Forgiveness",
  "primary_id": "keyterm:Forgive",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "localizations": {
    "eng": {
      "preferred_label": "Forgiveness (Pardon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "When someone chooses to pardon another person and not punish them for their mistake."
        }
      ]
    },
    "spa": {
      "preferred_label": "perdón (indulto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cuando alguien decide perdonar a otra persona y no castigarla por su falta."
        }
      ]
    },
    "fra": {
      "preferred_label": "pardon (pardon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait de choisir de pardonner à une autre personne et de ne pas la punir pour sa faute."
        }
      ]
    },
    "ind": {
      "preferred_label": "pengampunan (pengampunan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ketika seseorang memilih untuk mengampuni orang lain dan tidak menghukum mereka atas kesalahan mereka."
        }
      ]
    },
    "apd": {
      "preferred_label": "غفران (صفح)",
      "descriptions": [
        {
          "source": "acai",
          "description": "لما زول يختار يعفو عن زول تاني وما يعاقبو على غلطتو."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَغْفِرَة (صفح)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حين يختار شخص أن يعفو عن شخص آخر وألا يعاقبه على خطئه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong fogivim (Fogivim Man)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taem wan man i jusum blong fogivim wan narafala man mo no panisim hem from mastik blong hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gafara (Yafiya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sa’ad da mutum ya zaɓi ya yafe wa wani kuma bai hukunta shi ba saboda kuskurensa."
        }
      ]
    },
    "hin": {
      "preferred_label": "क्षमा (माफी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "जब कोई व्यक्ति किसी अन्य को क्षमा करने और उसकी गलती के लिए उसे दण्ड न देने का चुनाव करता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mgbaghara (Ngosipụta Ebere)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mgbe mmadụ họọrọ ịgbaghara onye ọzọ na ịghara ịta ya ahụhụ maka mmejọ ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "क्षमा (माफी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "जब कसैले अर्को व्यक्तिलाई माफी दिने र उसको गल्तीको निम्ति दण्ड नदिने निर्णय गर्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "perdão (indulto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quando alguém decide conceder perdão a outra pessoa e não puni-la pelo seu erro."
        }
      ]
    },
    "rus": {
      "preferred_label": "Прощение (помилование)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Когда кто-либо решает помиловать другого человека и не наказывать его за проступок."
        }
      ]
    },
    "swh": {
      "preferred_label": "Msamaha (Ondoleo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wakati mtu anapochagua kumsamehe mtu mwingine na kutomwadhibu kwa makosa yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong lusim rong (Lusim asua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taim wanpela manmeri i makim long lusim rong bilong narapela na i no mekim save long em long rong bilong en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự tha thứ (Ân xá)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Khi một người quyết định tha thứ cho người khác và không trừng phạt họ vì lỗi lầm của họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "饶恕（赦免）",
      "descriptions": [
        {
          "source": "acai",
          "description": "选择宽免他人并不因其过错施加惩罚。"
        }
      ]
    },
    "zht": {
      "preferred_label": "饒恕（寬恕）",
      "descriptions": [
        {
          "source": "acai",
          "description": "某人選擇寬恕他人，不因對方的過錯而施加懲罰。"
        }
      ]
    }
  },
