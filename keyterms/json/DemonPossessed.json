  "localizations": {
    "eng": {
      "preferred_label": "Be Demon Possessed",
      "descriptions": [
        {
          "source": "acai",
          "description": "Having an evil spirit living inside a person, controlling them."
        }
      ]
    },
    "spa": {
      "preferred_label": "estar endemoniado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tener un espíritu maligno morando dentro de una persona y controlándola."
        }
      ]
    },
    "fra": {
      "preferred_label": "être possédé par un démon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Avoir un esprit mauvais vivant en soi, qui prend le contrôle."
        }
      ]
    },
    "ind": {
      "preferred_label": "kerasukan setan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kondisi ketika roh jahat tinggal di dalam diri seseorang dan mengendalikannya."
        }
      ]
    },
    "por": {
      "preferred_label": "estar endemoninhado",
      "alternate_labels": [
        "estar endemoninhado"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Ter um espírito maligno vivendo dentro de uma pessoa, controlando-a."
        }
      ]
    },
    "apd": {
      "preferred_label": "ممسوس بأرواح شريرة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وجود روح شرير ساكن جوة زول ومسيطر عليه."
        }
      ]
    },
    "arb": {
      "preferred_label": "ممسوس بشيطان",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يسكن روح شرير داخل شخص ويسيطر عليه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gat devel i stap long hem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taem wan devel i stap laef insaed long wan man mo i kontrolem hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai aljanu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewar mugun ruhu yana zama a cikin mutum, yana iko da shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "दुष्टात्मा ग्रस्त होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति के भीतर दुष्टात्मा का वास होना और उसके नियंत्रण में होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mmụọ ọjọọ ịnọ n'ime",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe mmụọ ọjọọ bi n'ime mmadụ, na-achịkwa ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "भूतात्मा लाग्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "मानिसभित्र दुष्टात्मा बसेर उसलाई नियन्त्रण गरेको अवस्था।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Быть одержимым бесами",
      "descriptions": [
        {
          "source": "acai",
          "description": "Нахождение злого духа внутри человека, контролирующего его."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kupagawa na pepo wachafu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa na roho mwovu anayeishi ndani ya mtu, akimdhibiti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gat spirit nogut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela spirit nogut i stap insait long manmeri na i bosim ol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bị quỷ ám",
      "descriptions": [
        {
          "source": "acai",
          "description": "Có một tà linh sống bên trong một người và khống chế người đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "被鬼附身",
      "descriptions": [
        {
          "source": "acai",
          "description": "邪灵住在人体内并控制其人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "被鬼附",
      "descriptions": [
        {
          "source": "acai",
          "description": "有邪靈住在人裡面並控制著該人。"
        }
      ]
    }
  },
