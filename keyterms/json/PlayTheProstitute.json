{
  "id": "keyterm:PlayTheProstitute",
  "primary_id": "keyterm:PlayTheProstitute",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "002011001001000",
    "002011001003000",
    "002011001004000",
    "002011001002000",
    "002011001005000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Play the Prostitute (Idiom)",
      "descriptions": [
        {
          "source": "acai",
          "description": "To act unfaithfully, either by doing wrong or by turning away from God to other things."
        }
      ]
    },
    "spa": {
      "preferred_label": "prostituirse (modismo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Actuar con infidelidad, ya sea haciendo lo malo o alejándose de Dios hacia otras cosas."
        }
      ]
    },
    "fra": {
      "preferred_label": "se prostituer (idiome)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Agir infidèlement, soit en faisant le mal, soit en se détournant de Dieu vers d'autres choses."
        }
      ]
    },
    "ind": {
      "preferred_label": "berlaku sebagai pelacur (ungkapan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bertindak tidak setia, baik dengan berbuat jahat maupun dengan berpaling dari Allah kepada hal-hal lain."
        }
      ]
    },
    "por": {
      "preferred_label": "prostituir-se (expressão)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Agir com infidelidade, seja praticando o mal ou afastando-se de Deus em direção a outras coisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "يزني (تعبير مجازي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "التصرف بعدم أمانة، إما بفعل الشر أو بالابتعاد عن الله والتوجه لحاجات تانية."
        }
      ]
    },
    "arb": {
      "preferred_label": "الزنى (تعبير مجازي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "التصرّف بعدم أمانة، إمّا بفعل الشرّ أو بالابتعاد عن الله إلى أمور أخرى."
        }
      ]
    },
    "bis": {
      "preferred_label": "mekem fasin blong pampro (tok haed)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong no stap tru, maet long mekem wanem i rong no long tanem baksaed long God blong folem ol narafala samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin karuwanci (Karin magana)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin rashin aminci, ta wurin aikata mugunta ko kuma ta wurin barin Allah zuwa ga waɗansu abubuwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "व्यभिचार करना (मुहावरा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "गलत काम करके या परमेश्वर से मुँह मोड़कर अन्य बातों की ओर लग जाने के द्वारा अविश्वासयोग्य रीति से कार्य करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgba akwụna (Ahịrịokwu nka)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịkpa àgwà nʼụzọ nke ekwesịghị ntụkwasị obi, ma ọ bụ site nʼime ihe ọjọọ ma ọ bụ site nʼịhapụ Chineke gbanahụ ihe ndị ọzọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "वेश्यावृत्ति गर्नु (टुक्का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "गलत काम गरेर वा परमेश्‍वरबाट तर्केर अन्य थोकहरूतर्फ लागेर विश्‍वासघाती व्यवहार गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Блудодействовать (идиома)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Поступать неверно, либо совершая зло, либо отворачиваясь от Бога к иному."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kufanya ukahaba (Nahau)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutenda kwa kukosa uaminifu, ama kwa kutenda maovu au kwa kumwacha Mungu na kugeukia mambo mengine."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim pasin pamuk (Tok piksa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong givim baksait long promis o pasin bilong mekim rong o givim baksait long God na lotuim ol arapela samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thông dâm (thành ngữ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành động bất trung, hoặc bằng cách làm điều sai trái, hoặc bằng cách lìa bỏ Đức Chúa Trời để quay sang những điều khác."
        }
      ]
    },
    "zhs": {
      "preferred_label": "行淫 (习语)",
      "descriptions": [
        {
          "source": "acai",
          "description": "行事不忠，表现为行恶，或是离弃上帝转从别事。"
        }
      ]
    },
    "zht": {
      "preferred_label": "行邪淫（習語）",
      "descriptions": [
        {
          "source": "acai",
          "description": "行事不忠，無論是作惡，或是離棄上帝歸向別的事物。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
  "lemmas": {
