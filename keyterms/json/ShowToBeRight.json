  ],
  "localizations": {
    "eng": {
      "preferred_label": "Justify (Vindicate)",
      "alternate_labels": [
        "Prove to Be Right"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To prove that something is fair, honest, or true."
        }
      ]
    },
    "fra": {
      "preferred_label": "justifier (défendre)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prouver que quelque chose est juste, intègre ou vrai."
        }
      ]
    },
    "ind": {
      "preferred_label": "membenarkan (menyatakan benar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membuktikan bahwa sesuatu itu adil, jujur, atau benar."
        }
      ]
    },
    "por": {
      "preferred_label": "justificar (reivindicar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Provar que algo é justo, honesto ou verdadeiro."
        }
      ]
    },
    "apd": {
      "preferred_label": "يبرر (يثبت صحة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تثبت إنو حاجة معينة عادلة، أمينة، أو صحيحة."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُبَرِّرُ (يُثبِتُ حَقًّا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إِثبَاتُ أَنَّ شَيئًا مَا عَادِلٌ، أَوْ صَادِقٌ، أَوْ حَقٌّ."
        }
      ]
    },
    "bis": {
      "preferred_label": "soemaot we i stret (pruvum se i stret)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong pruvum se wan samting i stret, i onest, no i tru."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tabbatar da Gaskiya (Kuɓutarwa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tabbatar da cewa wani abu na gaskiya ne, marar laifi, ko kuma abin amincewa."
        }
      ]
    },
    "hin": {
      "preferred_label": "सच्चा ठहराना (निर्दोष सिद्ध करना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यह प्रमाणित करना कि कोई बात उचित, ईमानदार या सच्ची है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Igosi na ihe ziri ezi (Ịgụ nʼonye ziri ezi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosipụta ma ọ bụ ime ka a mara na ihe ziri ezi, kwụ ọtọ, ma ọ bụ bụrụ eziokwu."
        }
      ]
    },
    "nep": {
      "preferred_label": "धर्मी ठहरिनु (सही प्रमाणित गर्नु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरा न्यायसङ्गत, इमानदार वा सत्य छ भनी प्रमाणित गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Оправдывать (доказывать правоту)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Доказывать, что что-либо справедливо, честно или истинно."
        }
      ]
    },
    "spa": {
      "preferred_label": "justificar (reivindicar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demostrar que algo es justo, honesto o verdadero."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuthibitisha Kuwa Mwenye Haki (Kutetewa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuthibitisha kwamba kitu fulani ni cha haki, uaminifu, au kweli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "soim olsem em i stretpela (kamapim klia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Soim klia olsem wanpela samting em i stret, i tru, na i no gat giaman."
        }
      ]
    },
    "vie": {
      "preferred_label": "Xưng công bình (Minh oan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chứng minh rằng điều gì đó là công bằng, ngay thẳng hoặc đúng đắn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "显明为义 (证明有理)",
      "descriptions": [
        {
          "source": "acai",
          "description": "证明某事是公正、诚实或真实的。"
        }
      ]
    },
    "zht": {
      "preferred_label": "顯為義（證實）",
      "descriptions": [
        {
          "source": "acai",
          "description": "證明某事是公正、誠實或真實的。"
        }
      ]
    }
  },
