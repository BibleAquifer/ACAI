{
  "id": "keyterm:Curse.3",
  "primary_id": "keyterm:Curse",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "000718001001000",
    "000718001002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Curse (Consign to Death)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sending someone or something to harm or death, often by calling on God’s name as punishment or out of anger."
        }
      ]
    },
    "spa": {
      "preferred_label": "maldecir (condenar a muerte)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Destinar a alguien o algo al daño o a la muerte, a menudo invocando el nombre de Dios como castigo o por ira."
        }
      ]
    },
    "fra": {
      "preferred_label": "malédiction (vouer à la mort)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vouer quelqu’un ou quelque chose au malheur ou à la mort, souvent en invoquant le nom de Dieu comme punition ou sous le coup de la colère."
        }
      ]
    },
    "ind": {
      "preferred_label": "kutuk (penyerahan kepada maut)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyerahkan seseorang atau sesuatu kepada celaka atau kematian, sering kali dengan menyerukan nama Allah sebagai hukuman atau karena murka."
        }
      ]
    },
    "por": {
      "preferred_label": "maldição (destinar à morte)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Destinar alguém ou algo ao dano ou à morte, muitas vezes invocando o nome de Deus como punição ou por ira."
        }
      ]
    },
    "apd": {
      "preferred_label": "لعنة (الحكم بالموت)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تسليم زول أو حاجة للأذى أو الموت، وغالباً بذكر اسم الله كعقاب أو بدافع الغضب."
        }
      ]
    },
    "arb": {
      "preferred_label": "لَعنة (الحكم بالهلاك)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الحكم على شخص أو شيء بالأذى أو الموت، وغالبًا باستدعاء اسم الله كعقاب أو بدافع الغضب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Panis blong ded (Sanem i Go long Ded)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong sanem wan man no samting i go long trabol no ded, we plante taem man i singaot nem blong God olsem panis no from we hem i kros."
        }
      ]
    },
    "hau": {
      "preferred_label": "La'ana (Miƙa ga Mutuwa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tura wani ko wani abu ga cutarwa ko mutuwa, sau da yawa ta wurin kiran sunan Allah a matsayin horo ko saboda fushi."
        }
      ]
    },
    "hin": {
      "preferred_label": "श्राप (मृत्यु के हवाले करना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "क्रोध में या दंड के रूप में प्रायः परमेश्वर के नाम का आह्वान करके किसी व्यक्ति या वस्तु को हानि या मृत्यु के हवाले करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọbụbụ ọnụ (Ịtụnye nʼỌnwụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iwere mmadụ ma ọ bụ ihe ziga nʼime mmerụ ahụ ma ọ bụ ọnwụ, ọkachasị site nʼịkpọku aha Chineke dị ka ntaramahụhụ ma ọ bụ site nʼiwe."
        }
      ]
    },
    "nep": {
      "preferred_label": "श्राप (मृत्युको निम्ति सुम्पनु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दण्ड वा क्रोधको रूपमा प्रायः परमेश्‍वरको नाउँ पुकारेरे कसैलाई वा कुनै थोकलाई हानि वा मृत्युको निम्ति सुम्पनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "проклятие (обречение на смерть)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Обречение кого-либо или чего-либо на вред или смерть, часто с призыванием имени Бога в качестве наказания или в гневе."
        }
      ]
    },
    "swh": {
      "preferred_label": "Laana (Kuhukumia Kifo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kupeleka mtu au kitu kwenye madhara au kifo, mara nyingi kwa kuliitia jina la Mungu kama adhabu au kwa hasira."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tok Bilong Bagarap (Salim i Go Long Dai)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Salim wanpela man o samting i go long bagarap o dai, planti taim long rot bilong singautim nem bilong God olsem pe nogut o long belhat."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời rủa sả (Định án tử vong)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đẩy ai đó hoặc điều gì đó vào chỗ tổn hại hoặc cái chết, thường bằng cách nhân danh Đức Chúa Trời như một sự trừng phạt hoặc trong cơn giận dữ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "咒诅 (判处死地)",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某人或某物归于毁灭或死亡，通常是出于惩罚或愤怒而呼求上帝之名所施行的。"
        }
      ]
    },
    "zht": {
      "preferred_label": "咒詛 (致於死地)",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某人或某物歸於受害或死亡，常出於懲罰或憤怒藉著呼求上帝之名而行。"
        }
      ]
    }
  },
  "referred_to_as": [
