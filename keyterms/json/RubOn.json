  "localizations": {
    "eng": {
      "preferred_label": "Anoint (Rub On)",
      "descriptions": [
        {
          "source": "acai",
          "description": "To put oil or other substances on someone's skin by rubbing."
        }
      ]
    },
    "spa": {
      "preferred_label": "ungir (frotar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Poner aceite u otras sustancias sobre la piel de alguien mediante frotamiento."
        }
      ]
    },
    "fra": {
      "preferred_label": "oindre (frictionner)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Appliquer de l'huile ou d'autres substances sur la peau de quelqu'un en frottant."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengurapi (mengoleskan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengoleskan minyak atau zat lain pada kulit seseorang dengan cara menggosok."
        }
      ]
    },
    "por": {
      "preferred_label": "Ungir (Esfregar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Passar óleo ou outras substâncias na pele de alguém esfregando."
        }
      ]
    },
    "apd": {
      "preferred_label": "مسح (دهن)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسح جلد الزول بزيت أو بمواد تانية بالفرك."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَسْح (دَهْن)",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَضْعُ الزَّيْتِ أو مَوادَّ أُخْرى على جِلْدِ شَخْصٍ ما عَبْرَ الدَّهْنِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "kapu (rabem)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong rabem oel o narafala samting long skin blong wan man."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shafa (Goge)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shafa māi ko wasu abubuwa a jikin mutum ta hanyar shafawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "अभिषेक करना (मलना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मलकर किसी की त्वचा पर तेल या अन्य पदार्थ लगाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ite mmanụ (Ịhịa nʼahụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Itinye mmanụ maọbụ ihe ndị ọzọ nʼanụ ahụ mmadụ site nʼịhịa ya nʼahụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "अभिषेक गर्नु (दल्नु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैको छालामा दलेर तेल वा अन्य पदार्थ लगाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Умащать (натирать)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Нанесение масла или других веществ на чью-либо кожу путем растирания или втирания."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kupaka (Kusugua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kupaka mafuta au vitu vingine kwenye ngozi ya mtu kwa kusugua au kusugua taratibu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Welim (rabim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong welim o putim wel o arapela samting long skin bilong manmeri."
        }
      ]
    },
    "vie": {
      "preferred_label": "Xức dầu (Thoa lên)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thoa dầu hoặc các chất khác lên da của ai đó bằng cách chà xát."
        }
      ]
    },
    "zhs": {
      "preferred_label": "膏抹（涂抹）",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过涂抹的方式把油或其他物质涂在某人的皮肤上。"
        }
      ]
    },
    "zht": {
      "preferred_label": "膏抹（塗擦）",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由塗抹的方式將油或其他物質擦在某人的皮膚上。"
        }
      ]
    }
  },
  "referred_to_as": [
