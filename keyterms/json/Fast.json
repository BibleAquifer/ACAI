{
  "id": "keyterm:Fast",
  "primary_id": "keyterm:Fast",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "53.65",
    "51.11",
    "23.31"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Abstain from Food",
      "alternate_labels": [
        "Fast"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To not eat food for a certain time to show respect or pray to God."
        }
      ]
    },
    "spa": {
      "preferred_label": "abstenerse de comer",
      "descriptions": [
        {
          "source": "acai",
          "description": "No comer alimentos durante cierto tiempo para mostrar respeto u orar a Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "jeûner",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ne pas manger de nourriture pendant un certain temps pour manifester du respect envers Dieu ou pour le prier."
        }
      ]
    },
    "ind": {
      "preferred_label": "berpuasa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak makan untuk jangka waktu tertentu demi menunjukkan rasa hormat atau berdoa kepada Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "jejuar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não comer alimento por um determinado tempo para demonstrar respeito ou orar a Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "يمتنع عن الأكل",
      "descriptions": [
        {
          "source": "acai",
          "description": "الامتناع عن الأكل لزمن محدد لإظهار الاحترام أو الصلاة لله."
        }
      ]
    },
    "arb": {
      "preferred_label": "صام",
      "descriptions": [
        {
          "source": "acai",
          "description": "الامتناع عن تناول الطعام لفترة معينة لإظهار الاحترام أو للصلاة إلى الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Livim kakae",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong livim kakae blong wan taem blong soemaot respek o mekem prea long God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙaurace wa abinci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin ƙaurace wa cin abinci na wani lokaci domin nuna girmamawa ko yin addu’a ga Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "भोजन से अलग रहना",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर के प्रति आदर दिखाने या प्रार्थना करने के लिए एक निश्चित समय तक भोजन न करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ibu ọnụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịghara iri nri nwa oge iji gosipụta nkwanye ùgwù maọbụ kpee ekpere nye Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "उपवास बस्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरप्रति आदर देखाउन वा प्रार्थना गर्न निश्चित समयसम्म खाना नखाई बस्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Поститься",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отказываться от пищи на определенное время, чтобы выразить почтение Богу или молиться Ему."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kujinyima Chakula",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutokula chakula kwa muda fulani ili kuonesha heshima au kuomba kwa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tambu long kaikai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong no kaikai inap long wanpela hap taim bilong soim biknem o mekim beten long God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kiêng ăn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không ăn thức ăn trong một khoảng thời gian nhất định nhằm bày tỏ lòng tôn kính hoặc cầu nguyện với Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "禁食",
      "descriptions": [
        {
          "source": "acai",
          "description": "在特定时间内不进食，以向上帝表达敬意或向祂祈祷。"
        }
      ]
    },
    "zht": {
      "preferred_label": "禁食",
      "descriptions": [
        {
          "source": "acai",
          "description": "為表示敬畏或向上帝祈禱，在特定時間內不吃食物。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Fasting"
  ],
