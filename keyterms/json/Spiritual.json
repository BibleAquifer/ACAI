  "localizations": {
    "eng": {
      "preferred_label": "Ability (Spiritual)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Relating to the inner life or the non-physical part of a person that connects with God."
        }
      ]
    },
    "spa": {
      "preferred_label": "capacidad (espiritual)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Relativo a la vida interior o a la parte no física de una persona que se conecta con Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "spirituel (spirituel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Qui a trait à la vie intérieure ou à la partie immatérielle d'une personne qui entre en relation avec Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "kemampuan (rohani)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Berhubungan dengan kehidupan batiniah atau bagian non-fisik dari seseorang yang terhubung dengan Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "Capacidade (espiritual)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Relativo à vida interior ou à parte não física de uma pessoa que se conecta com Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "قدرة (روحية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بتتعلق بالحياة الجوانية أو الجزء الما مادي من الزول البيتوصل مع الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "روحي (روحي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ما يتعلق بالحياة الداخلية أو بالجانب غير المادي في الإنسان الذي يتواصل مع الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Paoa (Blong Spirit)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin we i joen wetem laef insaed long man no pat ya blong man we bodi i no save tajem, we i stap joen wetem God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ruhaniya (Iko)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abin da ya shafi rayuwar ciki ko ɓangaren mutum marar ganuwa wanda yake haɗa shi da Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "आत्मिक (क्षमता)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मनुष्य के आंतरिक जीवन या उसके उस अभौतिक भाग से संबंधित जो परमेश्वर के साथ जुड़ता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nke mmụọ (Mmụọ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Metụtara ndụ ime mmụọ maọbụ akụkụ ahụ na-abụghị nke anụ ahụ nke mmadụ nke na-ejikọ ya na Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "आत्मिक (क्षमता)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मानिसको भित्री जीवन वा परमेश्‍वरसँग जोडिने अभौतिक भागसँग सम्बन्धित।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Духовный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Относящийся к внутренней жизни или нематериальной части человека, соединяющей его с Богом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uwezo (Kiroho)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhusiana na maisha ya ndani au sehemu isiyoonekana ya mtu inayoungana na Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Save na strong (bilong spirit)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting i go long laip bilong insait o hap bilong manmeri i no bilong bodi we i save bung wantaim God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Năng lực (Thuộc linh)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Liên quan đến đời sống nội tâm hoặc phần phi vật chất của một người kết nối với Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "属灵 (内在特质)",
      "descriptions": [
        {
          "source": "acai",
          "description": "与人的内心生活或与上帝联结的非物质部分有关。"
        }
      ]
    },
    "zht": {
      "preferred_label": "屬靈 (能力)",
      "descriptions": [
        {
          "source": "acai",
          "description": "指與人的內在生命或與上帝相通的非物質部分相關。"
        }
      ]
    }
  },
