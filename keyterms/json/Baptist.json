{
  "id": "keyterm:Baptist",
  "primary_id": "keyterm:Baptist",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "53.42"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Baptist",
      "descriptions": [
        {
          "source": "acai",
          "description": "A person who performs baptism, especially John the Baptist who baptized Jesus and others."
        }
      ]
    },
    "spa": {
      "preferred_label": "bautista",
      "descriptions": [
        {
          "source": "acai",
          "description": "Persona que realiza el bautismo, en especial Juan el Bautista, quien bautizó a Jesús y a otros."
        }
      ]
    },
    "fra": {
      "preferred_label": "baptiste",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personne qui administre le baptême, en particulier Jean-Baptiste qui a baptisé Jésus et d'autres personnes."
        }
      ]
    },
    "ind": {
      "preferred_label": "pembaptis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang yang melakukan pembaptisan, khususnya Yohanes Pembaptis yang membaptis Yesus dan orang-orang lain."
        }
      ]
    },
    "por": {
      "preferred_label": "batista",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma pessoa que realiza o batismo, especialmente João Batista, que batizou Jesus e outros."
        }
      ]
    },
    "apd": {
      "preferred_label": "معمدان",
      "descriptions": [
        {
          "source": "acai",
          "description": "زول بيعمّد الناس، وخصوصاً يوحنا المعمدان الكان بيعمّد يسوع والناس التانيين."
        }
      ]
    },
    "arb": {
      "preferred_label": "مُعَمِّد",
      "descriptions": [
        {
          "source": "acai",
          "description": "شخص يُجري المعمودية، وخاصة يوحنا المعمدان الذي عمّد يسوع وآخرين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Man blong baptaes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i stap baptaesem ol man, speseli Jon Baptaes we i baptaesem Jisas mo ol narafala man."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai Baftisma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin da yake yin baftisma, musamman Yohanna Mai Baftisma wanda ya yi wa Yesu da wasu mutane baftisma."
        }
      ]
    },
    "hin": {
      "preferred_label": "बपतिस्मा देनेवाला",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह व्यक्ति जो बपतिस्मा देता है, विशेष रूप से यूहन्ना बपतिस्मा देनेवाला जिसने यीशु और अन्य लोगों को बपतिस्मा दिया।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Omee baptizim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye na-eme baptizim, karịsịa Jọn omee baptizim onye mere Jisọs na ndị ọzọ baptizim."
        }
      ]
    },
    "nep": {
      "preferred_label": "बप्तिस्मा-दिने",
      "descriptions": [
        {
          "source": "acai",
          "description": "बप्तिस्मा दिने व्यक्ति, विशेष गरी बप्तिस्मा-दिने यूहन्ना जसले येशू र अरूहरूलाई बप्तिस्मा दिएका थिए।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Креститель",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, совершающий крещение, в особенности Иоанн Креститель, крестивший Иисуса и других."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mbatizaji",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu anayebatiza watu, hasa Yohana Mbatizaji aliyembatiza Yesu na wengine."
        }
      ]
    },
    "tpi": {
      "preferred_label": "man bilong givim baptais",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man i save givim baptais, moa yet Jon Bilong Baptais em man i bin baptaisim Jisas na ol arapela manmeri."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người làm phép báp-tem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người cử hành phép báp-tem, đặc biệt là Giăng Báp-tít, người đã làm phép báp-tem cho Chúa Giê-xu và những người khác."
        }
      ]
    },
    "zhs": {
      "preferred_label": "施洗者",
      "descriptions": [
        {
          "source": "acai",
          "description": "施行洗礼的人，尤指为耶稣和他人施洗的施洗约翰。"
        }
      ]
    },
    "zht": {
      "preferred_label": "施洗者",
      "descriptions": [
        {
          "source": "acai",
          "description": "執行洗禮的人，尤指為耶穌及其他人施洗的施洗約翰。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
