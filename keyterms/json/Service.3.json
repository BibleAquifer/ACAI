  "localizations": {
    "eng": {
      "preferred_label": "Service (Role)",
      "alternate_labels": [
        "Priestly Service",
        "Divine Service"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A job or role in helping others, either in everyday life or during religious ceremonies."
        }
      ]
    },
    "spa": {
      "preferred_label": "servicio (función)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Trabajo o función de ayuda a los demás, ya sea en la vida cotidiana o durante las ceremonias religiosas."
        }
      ]
    },
    "fra": {
      "preferred_label": "service (rôle)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fonction ou rôle consistant à aider les autres, soit dans la vie quotidienne, soit au cours de cérémonies religieuses."
        }
      ]
    },
    "ind": {
      "preferred_label": "tugas jabatan (peran)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pekerjaan atau peran dalam membantu orang lain, baik dalam kehidupan sehari-hari maupun selama upacara keagamaan."
        }
      ]
    },
    "por": {
      "preferred_label": "serviço (função)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um trabalho ou função de ajudar os outros, seja no cotidiano ou durante cerimônias religiosas."
        }
      ]
    },
    "apd": {
      "preferred_label": "خدمة (دور)",
      "descriptions": [
        {
          "source": "acai",
          "description": "شغل أو دور في مساعدة الآخرين، سواء في الحياة اليومية أو أثناء الاحتفالات الدينية."
        }
      ]
    },
    "arb": {
      "preferred_label": "خِدْمَة (دور)",
      "descriptions": [
        {
          "source": "acai",
          "description": "وظيفة أو دور في مساعدة الآخرين، إما في الحياة اليومية أو أثناء الشعائر الدينية."
        }
      ]
    },
    "bis": {
      "preferred_label": "wok blong givhan (rol)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan wok blong givhan long ol narafala man, maet long evri dei laef no long taem blong ol seremoni blong skul."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hidima (Matsayi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aiki ko matsayi wajen taimakon wasu, ko a rayuwar yau da kullum ko a lokacin bukukuwan addini."
        }
      ]
    },
    "hin": {
      "preferred_label": "सेवा (भूमिका)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दैनिक जीवन में या धार्मिक अनुष्ठानों के दौरान दूसरों की सहायता करने का कार्य या भूमिका।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ije ozi (Ọrụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọrụ ma ọ bụ ọnọdụ nʼinyere ndị ọzọ aka, ma ọ bụ na ndụ kwa ụbọchị ma ọ bụ nʼoge emume okpukpe."
        }
      ]
    },
    "nep": {
      "preferred_label": "सेवा-कार्य (भूमिका)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दैनिक जीवनमा वा धार्मिक समारोहहरूका दौरान अरूलाई मद्दत गर्ने कुनै काम वा भूमिका।"
        }
      ]
    },
    "rus": {
      "preferred_label": "служение (роль)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Обязанность или роль по оказанию помощи другим, будь то в повседневной жизни или во время религиозных церемоний."
        }
      ]
    },
    "swh": {
      "preferred_label": "Huduma (Wajibu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kazi au wajibu wa kuwasaidia wengine, iwe katika maisha ya kila siku au wakati wa sherehe za kidini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Wok bilong helpim (Asua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela wok o asua bilong helpim ol arapela manmeri, maski em long olgeta de sindaun o long taim bilong mekim ol serimoni bilong lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự phục vụ (Vai trò)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một công việc hoặc vai trò giúp đỡ người khác, hoặc trong đời sống hằng ngày hoặc trong các nghi lễ tôn giáo."
        }
      ]
    },
    "zhs": {
      "preferred_label": "职分（职责）",
      "descriptions": [
        {
          "source": "acai",
          "description": "在日常生活或宗教仪式中帮助他人的工作或职责。"
        }
      ]
    },
    "zht": {
      "preferred_label": "職任（職能）",
      "descriptions": [
        {
          "source": "acai",
          "description": "在日常生活或宗教儀式中幫助他人的工作或職分。"
        }
      ]
    }
  },
  "referred_to_as": [
