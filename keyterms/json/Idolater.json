        }
      ]
    },
    "arb": {
      "preferred_label": "عَابِدُ وَثَنٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَخْصٌ يَعْبُدُ ٱلْأَوْثَانَ بَدَلًا مِنَ ٱلْإِلَهِ ٱلْوَاحِدِ ٱلْحَقِيقِيِّ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Man we i mekem wosip long ol aedol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i stap mekem wosip long ol aedol bitim we i wosipim trufala God ya nomo."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai bautar gumaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin da yake bauta wa gumaka maimakon bauta wa Allah ɗaya na gaskiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "मूर्तिपूजक",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह व्यक्ति जो एकमात्र सच्चे परमेश्वर के स्थान पर मूर्तियों की पूजा करता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye na-efe arụsị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye na-efe arụsị kama ife naanị otu ezi Chineke ahụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "मूर्तिपूजक",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक मात्र साँचो परमेश्‍वरको सट्टा मूर्तिहरूको पूजा गर्ने व्यक्ति।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Идолопоклонник",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, поклоняющийся идолам вместо единого истинного Бога."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwabudu sanamu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu anayeabudu sanamu badala ya Mungu mmoja wa kweli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "man bilong lotu long giaman god",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man i save mekim lotu long ol giaman god na i no long wanpela trupela God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người thờ hình tượng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người thờ cúng các hình tượng thay vì thờ phượng một Đức Chúa Trời chân thật duy nhất."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拜偶像的人",
      "descriptions": [
        {
          "source": "acai",
          "description": "不敬拜独一真神而去敬拜偶像的人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "拜偶像者",
      "descriptions": [
        {
          "source": "acai",
          "description": "敬拜偶像而非敬拜獨一真神的人。"
