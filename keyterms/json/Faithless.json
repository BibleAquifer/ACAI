{
  "id": "keyterm:Faithless",
  "primary_id": "keyterm:Unfaithful",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "31.98",
    "31.106",
    "11.19"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Faithless",
      "alternate_labels": [
        "Unbelieving"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Not believing or refusing to trust God or His promises."
        }
      ]
    },
    "spa": {
      "preferred_label": "incrédulo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que no cree o rehúsa confiar en Dios o en sus promesas."
        }
      ]
    },
    "fra": {
      "preferred_label": "incrédule",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ne pas croire ou refuser de faire confiance à Dieu ou à ses promesses."
        }
      ]
    },
    "ind": {
      "preferred_label": "tidak percaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak percaya atau menolak untuk percaya kepada Allah atau janji-janji-Nya."
        }
      ]
    },
    "por": {
      "preferred_label": "incrédulo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não crer ou recusar-se a confiar em Deus ou em Suas promessas."
        }
      ]
    },
    "apd": {
      "preferred_label": "غير مؤمن",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم الإيمان أو رفض الوثوق في الله أو في وعوده."
        }
      ]
    },
    "arb": {
      "preferred_label": "غير مؤمن",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم الإيمان بالله أو رفض الثقة به أو بوعوده."
        }
      ]
    },
    "bis": {
      "preferred_label": "No bilif",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin we man i no bilif o i no wantem trastem God o ol promes blong hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Marar bangaskiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin ba da gaskiya ko ƙin dogara ga Allah ko alkawurransa."
        }
      ]
    },
    "hin": {
      "preferred_label": "अविश्वासी",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर या उसकी प्रतिज्ञाओं पर विश्वास न करना या भरोसा करने से इनकार करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Enweghị okwukwe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịghara ikwere maọbụ ịjụ ịtụkwasị Chineke maọbụ nkwa ya niile obi."
        }
      ]
    },
    "nep": {
      "preferred_label": "अविश्‍वासी",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वर वा उहाँका प्रतिज्ञाहरूमाथि विश्‍वास नगर्नु वा भरोसा गर्न अस्वीकार गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Неверный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Не верящий или отказывающийся доверять Богу или Его обещаниям."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutokuamini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutoamini au kukataa kumtumaini Mungu au ahadi zake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "No bilip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong no bilip o sakim pasin bilong bilip long God o long ol promis bilong em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Không tin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không tin hoặc từ chối tin cậy Đức Chúa Trời hay những lời hứa của Ngài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "不信的",
      "descriptions": [
        {
          "source": "acai",
          "description": "不信或拒绝信靠上帝或祂的应许。"
        }
      ]
    },
    "zht": {
      "preferred_label": "不信",
      "descriptions": [
        {
          "source": "acai",
          "description": "不相信或拒絕信靠上帝或祂的應許。"
        }
      ]
    }
  },
