  "localizations": {
    "eng": {
      "preferred_label": "Make Righteous",
      "alternate_labels": [
        "Pronounce Just"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To declare someone as right or good before God."
        }
      ]
    },
    "spa": {
      "preferred_label": "justificar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Declarar a alguien justo o bueno delante de Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "justifier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Déclarer quelqu'un juste ou droit devant Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "membenarkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menyatakan seseorang benar atau baik di hadapan Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "Declarar Justo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Declarar alguém como justo ou bom diante de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "تبرير",
      "descriptions": [
        {
          "source": "acai",
          "description": "إعلان شخص إنه بار أو صالح قدام الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَبْرير",
      "descriptions": [
        {
          "source": "acai",
          "description": "إِعْلانُ كَوْنِ الشَّخْصِ بارًّا أو صالِحًا أمامَ اللهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "mekem i stret long fes blong God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong talemaot se wan man i stret no i gud long fes blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kuɓutarwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bayyana wani a matsayin mai adalci ko nagari a gaban Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "धर्मी ठहराना",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर के सम्मुख किसी को सही या भला ठहराना (घोषित करना)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ime ka ọ bụrụ onye ezi omume",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịkpọ mmadụ onye ziri ezi maọbụ onye dị mma nʼihu Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "धर्मी ठहराउनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको सामु कसैलाई ठीक वा धर्मी घोषणा गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Оправдывать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Объявлять кого-либо правым или непорочным пред Богом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuhesabia Haki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumtangaza mtu kuwa mwenye haki au mwema mbele za Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim i kamap stretpela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong kolim o makim wanpela manmeri olsem stretpela manmeri long ai bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Xưng công chính",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tuyên bố ai đó là ngay thẳng hoặc tốt lành trước mặt Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "称义",
      "descriptions": [
        {
          "source": "acai",
          "description": "在上帝面前宣告某人为义或良善。"
        }
      ]
    },
    "zht": {
      "preferred_label": "稱義",
      "descriptions": [
        {
          "source": "acai",
          "description": "在上帝面前宣告某人為義或良善（稱義）。"
        }
      ]
    }
  },
