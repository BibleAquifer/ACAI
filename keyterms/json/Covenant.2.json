        }
      ]
    },
    "apd": {
      "preferred_label": "عهد (العهد الجديد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اتفاق خاص بين طرفين بيتضمن وعود ومسؤوليات على الطرفين."
        }
      ]
    },
    "arb": {
      "preferred_label": "عهد (العهد الجديد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اتفاق خاص بين طرفين يتضمن وعودًا ومسؤوليات على كلا الجانبين."
        }
      ]
    },
    "bis": {
      "preferred_label": "promes (Niutesteman)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan spesel agrimen bitwin tu pati we i gat ol promes mo ol responsabiliti blong tufala saed tugeta."
        }
      ]
    },
    "hau": {
      "preferred_label": "Alkawari (Sabon Alkawari)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata yarjejeniya ta musamman tsakanin bangarori biyu wadda ta ƙunshi alkawura da kuma nauyin da ya rataya a wuyan kowane ɓangare."
        }
      ]
    },
    "hin": {
      "preferred_label": "वाचा (नया नियम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दो पक्षों के बीच एक विशेष समझौता जिसमें दोनों पक्षों के लिए प्रतिज्ञाएँ और जिम्मेदारियाँ शामिल होती हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọgbụgba ndụ (Agba Ọhụrụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nkwekọrịta pụrụ iche dị nʼetiti akụkụ abụọ nke gụnyere nkwa na ibu ọrụ dịịrị akụkụ abụọ ahụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "करार (नयाँ नियम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दुई पक्षबीचको एउटा विशेष सम्झौता जसमा दुवै पक्षका निम्ति प्रतिज्ञाहरू र जिम्मेवारीहरू समावेश हुन्छन्।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Завет (НЗ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особый союз или договор между двумя сторонами, включающий обещания и обязанности для обеих сторон."
        }
      ]
    },
    "swh": {
      "preferred_label": "Agano (Agano Jipya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Makubaliano maalum kati ya pande mbili yanayojumuisha ahadi na wajibu kwa pande zote mbili."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kontrak (NT)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela spesel kontrak namel long tupela lain we i gat ol promis na ol wok bilong ol tupela wantaim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Giao ước (Tân Ước)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thỏa ước đặc biệt giữa hai bên bao gồm những lời hứa và trách nhiệm cho cả hai phía."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约 (新约)",
      "descriptions": [
        {
          "source": "acai",
          "description": "双方之间包含彼此的应许和责任的特殊协议。"
        }
      ]
    },
    "zht": {
      "preferred_label": "約（新約）",
      "descriptions": [
        {
          "source": "acai",
          "description": "雙方之間包含應許與責任的特殊約定。"
        }
      ]
    }
  },
