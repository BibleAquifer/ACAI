{
  "id": "keyterm:Compassionate",
  "primary_id": "keyterm:Compassionate",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "88.81"
  ],
  "ubsdbh": [
    "006753001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Compassionate",
      "alternate_labels": [
        "Loving"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A quality of God that shows deep, loving care and gentle kindness, like a mother for her children."
        }
      ]
    },
    "spa": {
      "preferred_label": "misericordioso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cualidad de Dios que muestra un cuidado profundo y amoroso, y una ternura apacible, como la de una madre por sus hijos."
        }
      ]
    },
    "fra": {
      "preferred_label": "miséricordieux",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une qualité de Dieu qui manifeste une sollicitude profonde et aimante ainsi qu'une douce bienveillance, semblable à celle d'une mère envers ses enfants."
        }
      ]
    },
    "ind": {
      "preferred_label": "penyayang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sifat Allah yang menunjukkan kepedulian yang mendalam, penuh kasih, dan kebaikan yang lembut, seperti seorang ibu terhadap anak-anaknya."
        }
      ]
    },
    "apd": {
      "preferred_label": "رحيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "صفة من صفات الله بتبيّن اهتمام مليان محبة وحنان لطيف، زي حنان الأم على أولادها."
        }
      ]
    },
    "arb": {
      "preferred_label": "رَحِيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "صِفَةٌ لِلّهِ تُظْهِرُ عِنايَةً مُحِبَّةً عَميقَةً ورِقَّةً ولُطْفًا، كَعِنايَةِ الأُمِّ بِأَوْلادِها."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gat sore",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan gudfala fasin blong God we i soemaot lav we i dip tumas mo kaenfala fasin, olsem wan mama long ol pikinini blong hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai Tausayi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Halayyar Allah da ke nuna zurfin kulawa ta ƙauna da sauƙin kai mai tausayi, kamar yadda uwa take yi wa 'ya'yanta."
        }
      ]
    },
    "hin": {
      "preferred_label": "दयालु",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर का एक ऐसा गुण जो गहरे, प्रेमपूर्ण ध्यान और कोमल भलाई को प्रकट करता है, जैसे एक माँ अपने बच्चों के प्रति दिखाती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Inwe ọmịiko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Àgwà nke Chineke nke na-egosi nlekọta miri emi nke ịhụnanya na obiọma dị nwayọọ, dị ka nne nʼebe ụmụ ya nọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "करुणामय",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफ्ना छोराछोरीप्रति आमाले जस्तै गहिरो, मायालु हेरचाह र कोमल दया देखाउने परमेश्वरको एक गुण।"
        }
      ]
    },
    "por": {
      "preferred_label": "compassivo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma qualidade de Deus que demonstra cuidado profundo e amoroso e terna bondade, como uma mãe por seus filhos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Милосердный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Свойство Бога, проявляющее глубокую, исполненную любви заботу и нежную доброту, подобно матери к своим детям."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwenye Huruma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sifa ya Mungu inayoonyesha utunzaji wenye upendo wa kina na fadhili za upole, kama za mama kwa watoto wake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin sori na marimari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pasin bilong God i soim bikpela pasin sori, marimari na gutpela bel, olsem wanpela mama i mekim long ol pikinini bilong en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Có lòng thương xót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một mỹ đức của Đức Chúa Trời thể hiện sự chăm sóc yêu thương sâu sắc và lòng nhân từ dịu dàng, như mẹ đối với con mình."
        }
      ]
    },
    "zhs": {
      "preferred_label": "有怜悯的",
      "descriptions": [
        {
          "source": "acai",
          "description": "上帝的一种属性，彰显出深切、慈爱的关怀与温柔的仁慈，如同母亲对待自己的儿女一样。"
        }
      ]
    },
    "zht": {
      "preferred_label": "有憐憫的",
      "descriptions": [
        {
          "source": "acai",
          "description": "上帝的一種屬性，顯出深刻慈愛的關懷與溫柔的恩待，如同母親對待兒女一般。"
        }
      ]
    }
  },
