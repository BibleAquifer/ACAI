  "localizations": {
    "eng": {
      "preferred_label": "To Act Wickedly",
      "descriptions": [
        {
          "source": "acai",
          "description": "To behave in a way that breaks God's law and causes guilt."
        }
      ]
    },
    "spa": {
      "preferred_label": "hacer lo malo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Comportarse de una manera que quebranta la ley de Dios y acarrea culpa."
        }
      ]
    },
    "fra": {
      "preferred_label": "agir injustement",
      "descriptions": [
        {
          "source": "acai",
          "description": "Se comporter d'une manière qui enfreint la loi de Dieu et engendre la culpabilité."
        }
      ]
    },
    "ind": {
      "preferred_label": "bertindak jahat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Berperilaku dengan cara yang melanggar hukum Allah dan mendatangkan kesalahan."
        }
      ]
    },
    "por": {
      "preferred_label": "agir com impiedade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Comportar-se de maneira que viole a lei de Deus e cause culpa."
        }
      ]
    },
    "apd": {
      "preferred_label": "يفعل الشر (يأثم)",
      "descriptions": [
        {
          "source": "acai",
          "description": "التصرف بطريقة تكسر ناموس الله وتجلب الذنب والإثم."
        }
      ]
    },
    "arb": {
      "preferred_label": "صُنْعُ ٱلشَّرِّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "التصرف بطريقة تكسر شريعة الله وتجلب الذنب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem Fasin we i No Stret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem fasin we i brekem loa blong God mo i mekem man i gat fol."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin mugunta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin ɗabi’ar da ta keta dokar Allah kuma ta kawo laifi."
        }
      ]
    },
    "hin": {
      "preferred_label": "बुराई करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस प्रकार का आचरण करना जो परमेश्वर की व्यवस्था को तोड़ता है और दोष का कारण बनता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ime ihe ọjọọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịkpa àgwà n'ụzọ na-emebi iwu Chineke ma na-eweta ikpe ọmụma."
        }
      ]
    },
    "nep": {
      "preferred_label": "दुष्ट काम गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको व्यवस्था उल्लङ्घन गर्ने र दोषी बनाउने तरिकाले व्यवहार गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Поступать нечестиво",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вести себя так, что это нарушает Божий закон и влечет за собой вину."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutenda Maovu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kujiendesha kwa namna inayovunja sheria ya Mungu na kuleta hatia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim pasin nogut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long mekim pasin i brukim lo bilong God na i kamapim asua."
        }
      ]
    },
    "vie": {
      "preferred_label": "Hành ác",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cư xử theo cách vi phạm luật pháp của Đức Chúa Trời và mang lại tội lỗi."
        }
      ]
    },
    "zhs": {
      "preferred_label": "作恶",
      "descriptions": [
        {
          "source": "acai",
          "description": "做出违犯上帝律法并招致罪责的行为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "作惡",
      "descriptions": [
        {
          "source": "acai",
          "description": "以違犯上帝律法並招致罪責的方式行事。"
        }
      ]
    }
  },
  "referred_to_as": [
