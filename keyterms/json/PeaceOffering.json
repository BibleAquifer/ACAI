{
  "id": "keyterm:PeaceOffering",
  "primary_id": "keyterm:Offering",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "localizations": {
    "eng": {
      "preferred_label": "Peace Offering",
      "descriptions": [
        {
          "source": "acai",
          "description": "A special gift given to God to show thanks and have a close relationship with Him."
        }
      ]
    },
    "spa": {
      "preferred_label": "sacrificio de comunión",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ofrenda especial dada a Dios para mostrar gratitud y tener una relación cercana con Él."
        }
      ]
    },
    "fra": {
      "preferred_label": "sacrifice de paix",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un don spécial offert à Dieu pour lui rendre grâce et entretenir une relation étroite avec lui."
        }
      ]
    },
    "ind": {
      "preferred_label": "korban keselamatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Persembahan khusus yang diberikan kepada Allah untuk menyatakan syukur dan memiliki hubungan yang akrab dengan-Nya."
        }
      ]
    },
    "por": {
      "preferred_label": "oferta de paz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma oferta especial dada a Deus para demonstrar gratidão e ter um relacionamento íntimo com Ele."
        }
      ]
    },
    "apd": {
      "preferred_label": "ذبيحة سلامة",
      "descriptions": [
        {
          "source": "acai",
          "description": "هدية مخصوصة بتتقدم لله عشان تعبّر عن الشكر وتكون في علاقة قريبة معاه."
        }
      ]
    },
    "arb": {
      "preferred_label": "ذَبِيحَةُ سَلَامَةٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "تَقْدِمَةٌ خَاصَّةٌ تُقَدَّمُ لِلهِ إِظْهَارًا لِلشُّكْرِ وَإِقَامَةً لِعَلَاقَةٍ وَثِيقَةٍ مَعَهُ."
        }
      ]
    },
    "bis": {
      "preferred_label": "sakrefaes blong soemaot we man i stap fren gud wetem God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan spesel presen we oli givim long God blong talem tangkiu mo blong stap fren gud wetem Hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hadaya ta salama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kyauta ta musamman da ake ba Allah don nuna godiya da kuma samun dangantaka ta kusa da shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "मेलबलि",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर को धन्यवाद देने और उनके साथ निकट संबंध स्थापित करने के लिए दिया जाने वाला एक विशेष उपहार।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aja udo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyinye pụrụ iche a na-enye Chineke iji gosi ekele na inwe mmekọrịta chiri anya nʼebe ọ nọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "मेलबलि",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरलाई धन्यवाद दिन र उहाँसँग घनिष्ठ सम्बन्ध राख्नको निम्ति चढाइने विशेष भेटी वा बलिदान।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Мирная жертва",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особое приношение Богу в знак благодарности и для пребывания в близких отношениях с Ним."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sadaka ya Amani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sadaka ya pekee inayotolewa kwa Mungu ili kutoa shukrani na kuwa na uhusiano wa karibu naye."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ofa bilong kamap wanbel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela spesel presen ol i givim long God bilong soim tenkyu na bilong i stap klostu wantaim em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ thù ân",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một lễ vật đặc biệt dâng lên Đức Chúa Trời để tạ ơn và duy trì mối tương giao mật thiết với Ngài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "平安祭",
      "descriptions": [
        {
          "source": "acai",
          "description": "为表达感谢并与上帝保持亲密关系而献给祂的特殊礼物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "平安祭",
      "descriptions": [
        {
          "source": "acai",
          "description": "獻給上帝以表達感謝並與祂建立親密關係的特別禮物。"
        }
      ]
    }
  },
