  "localizations": {
    "eng": {
      "preferred_label": "Repentance",
      "descriptions": [
        {
          "source": "acai",
          "description": "The process of turning away from sin and making a new choice to live in a right and good way."
        }
      ]
    },
    "spa": {
      "preferred_label": "arrepentimiento",
      "descriptions": [
        {
          "source": "acai",
          "description": "El proceso de apartarse del pecado y tomar la nueva decisión de vivir de una manera recta y buena."
        }
      ]
    },
    "fra": {
      "preferred_label": "repentance",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le processus consistant à se détourner du péché et à faire le nouveau choix de vivre d'une manière juste et bonne."
        }
      ]
    },
    "ind": {
      "preferred_label": "pertobatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Proses berbalik dari dosa dan membuat pilihan baru untuk hidup dalam jalan yang benar dan baik."
        }
      ]
    },
    "por": {
      "preferred_label": "arrependimento",
      "descriptions": [
        {
          "source": "acai",
          "description": "O processo de afastar-se do pecado e fazer uma nova escolha de viver de maneira correta e boa."
        }
      ]
    },
    "apd": {
      "preferred_label": "توبة",
      "descriptions": [
        {
          "source": "acai",
          "description": "الرجوع عن الخطيّة واختيار العيش بطريقة صحيحة وصالحة."
        }
      ]
    },
    "arb": {
      "preferred_label": "توبة",
      "descriptions": [
        {
          "source": "acai",
          "description": "عملية الرجوع عن الخطيئة واتخاذ قرار جديد للعيش بطريقة صالحة وحسنة."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin blong tanem tingting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong tanem tingting blong gowe long sin mo mekem wan niufala jus blong laef long wan fasin we i stret mo gud."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tuba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hanyar juyowa daga zunubi da kuma yin sabon zaɓi na rayuwa a hanya mai kyau da adalci."
        }
      ]
    },
    "hin": {
      "preferred_label": "मन फिराव",
      "descriptions": [
        {
          "source": "acai",
          "description": "पाप से मुड़ने और सही तथा भले मार्ग पर जीने का नया निर्णय लेने की प्रक्रिया।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nchegharị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Usoro nke ịhapụ mmehie na ime mkpebi ọhụrụ ibi ndụ nʼụzọ ziri ezi ma dị mma."
        }
      ]
    },
    "nep": {
      "preferred_label": "पश्‍चात्ताप",
      "descriptions": [
        {
          "source": "acai",
          "description": "पापबाट फर्कने र उचित तथा असल मार्गमा जिउने नयाँ निर्णय लिने प्रक्रिया।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Покаяние",
      "descriptions": [
        {
          "source": "acai",
          "description": "Процесс отвращения от греха и принятия нового решения жить праведной и доброй жизнью."
        }
      ]
    },
    "swh": {
      "preferred_label": "Toba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mchakato wa kuacha dhambi na kufanya uamuzi mpya wa kuishi kwa njia iliyo sahihi na njema."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin bilong tanim bel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong givim baksait long sin na mekim nupela disisen bilong bihainim stretpela na gutpela pasin."
        }
      ]
    },
    "vie": {
      "preferred_label": "sự ăn năn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quá trình từ bỏ tội lỗi và đưa ra quyết định mới để sống một lối sống ngay thẳng và tốt lành."
        }
      ]
    },
    "zhs": {
      "preferred_label": "悔改",
      "descriptions": [
        {
          "source": "acai",
          "description": "远离罪恶并重新选择过正直与良善生活的过程。"
        }
      ]
    },
    "zht": {
      "preferred_label": "悔改",
      "descriptions": [
        {
          "source": "acai",
          "description": "離開罪惡並作出新選擇去行正道與良善的過程。"
        }
      ]
    }
  },
