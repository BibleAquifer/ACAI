  "localizations": {
    "eng": {
      "preferred_label": "Rely On",
      "alternate_labels": [
        "Trust In",
        "Depend On",
        "Have (Complete) Confidence In",
        "Confidence",
        "Trust"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To have full trust in someone or something and depend on them for help or support."
        }
      ]
    },
    "spa": {
      "preferred_label": "confiar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tener plena confianza en alguien o algo y depender de ellos para recibir ayuda o apoyo."
        }
      ]
    },
    "fra": {
      "preferred_label": "compter sur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Avoir une totale confiance en quelqu'un ou quelque chose et dépendre de lui pour obtenir de l'aide ou du soutien."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengandalkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memiliki kepercayaan penuh kepada seseorang atau sesuatu dan bergantung kepada mereka untuk pertolongan atau dukungan."
        }
      ]
    },
    "por": {
      "preferred_label": "confiar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Confiar plenamente em alguém ou algo e depender dele para ajuda ou apoio."
        }
      ]
    },
    "apd": {
      "preferred_label": "اعتمد على",
      "descriptions": [
        {
          "source": "acai",
          "description": "الثقة الكاملة في زول أو شي والاعتماد عليه للمساعدة أو الدعم."
        }
      ]
    },
    "arb": {
      "preferred_label": "اتَّكَلَ عَلى",
      "descriptions": [
        {
          "source": "acai",
          "description": "الثِّقَةُ التّامَّةُ بِشَخْصٍ أَوْ شَيْءٍ والاعْتِمادُ عَلَيْهِ لِلْمُساعَدَةِ أَوِ الدَّعْمِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Dipen long",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong trastem fulwan wan man no wan samting mo dipen long hem blong kasem help no sapot."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dogara Ga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa da cikakkiyar amana ga wani ko wani abu da kuma dogara gare su don taimako ko goyon baya."
        }
      ]
    },
    "hin": {
      "preferred_label": "भरोसा रखना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या वस्तु पर पूरा भरोसा रखना और सहायता या सहारे के लिए उन पर निर्भर रहना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịtụkwasị obi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe ntụkwasị obi zuru oke nʼebe mmadụ maọbụ ihe nọ na ịdabere nʼebe ha nọ maka enyemaka maọbụ nkwado."
        }
      ]
    },
    "nep": {
      "preferred_label": "भरोसा गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै व्यक्ति वा कुरामा पूर्ण भरोसा राख्नु र सहायता वा सहाराको निम्ति तिनीहरूमा निर्भर हुनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Полагаться",
      "descriptions": [
        {
          "source": "acai",
          "description": "Полностью доверять кому-либо или чему-либо и полагаться на чью-либо помощь или поддержку."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutegemea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa na imani thabiti kwa mtu au kitu na kumtegemea kwa msaada au utegemezo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "hangamap long",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bilip tru long wanpela man o samting na hangamap long em long kisim helpim o sapot."
        }
      ]
    },
    "vie": {
      "preferred_label": "Nhờ cậy",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hoàn toàn tin cậy ai đó hoặc điều gì đó và nhờ cậy nơi họ để được giúp đỡ hay hỗ trợ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "信靠",
      "descriptions": [
        {
          "source": "acai",
          "description": "完全信赖某人或某事，并倚靠他们获取帮助或支持。"
        }
      ]
    },
    "zht": {
      "preferred_label": "倚靠",
      "descriptions": [
        {
          "source": "acai",
          "description": "完全信任某人或某事物，並依靠他們獲得幫助或支持。"
        }
      ]
    }
  },
