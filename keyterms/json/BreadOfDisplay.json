  "localizations": {
    "eng": {
      "preferred_label": "Bread of Display",
      "alternate_labels": [
        "Bread of the Presence",
        "Sacred Bread"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Special bread kept on a table in the temple as a symbol of God's presence."
        }
      ]
    },
    "spa": {
      "preferred_label": "pan de la proposición",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pan especial que se colocaba sobre una mesa en el templo como símbolo de la presencia de Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "pain de proposition",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pain spécial disposé sur une table dans le sanctuaire comme symbole de la présence de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "roti sajian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roti khusus yang ditaruh di atas meja di bait suci sebagai lambang kehadiran Allah."
        }
      ]
    },
    "apd": {
      "preferred_label": "خبز الوجوه",
      "descriptions": [
        {
          "source": "acai",
          "description": "عيش مخصوص محفوظ على طربيزة في بيت الله كرمز لحضور الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "خُبْز الوُجوه",
      "descriptions": [
        {
          "source": "acai",
          "description": "خبز خاص يوضع على مائدة في الهيكل كرمز لحضور الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tabu bred blong God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Spesel bred we oli stap putum long wan tebol long haos blong God olsem wan saen blong presens blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Burodin Kasancewa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Burodi na musamman da ake ajiye a kan teburi a cikin haikali a matsayin alamar kasancewar Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "भेंट की रोटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मंदिर में मेज़ पर रखी जाने वाली विशेष रोटी जो परमेश्वर की उपस्थिति का प्रतीक थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Achịcha nke iche nʼIhu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Achịcha pụrụ iche a na-edobe n'elu tebul n'ụlọnsọ dị ka ihe ịrịba ama nke ọnụnọ Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "उपस्थितिको रोटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको उपस्थितिको प्रतीकको रूपमा मन्दिरको टेबलमा राखिने विशेष रोटी।"
        }
      ]
    },
    "por": {
      "preferred_label": "pães da proposição",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pão especial guardado sobre uma mesa no templo como símbolo da presença de Deus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хлебы предложения",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особый хлеб, находившийся на столе в храме как символ Божьего присутствия."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mikate ya Wonyesho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mikate ya pekee iliyowekwa juu ya meza hekaluni kama ishara ya uwepo wa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bret tambu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Spesel bret ol i save putim long tebol insait long haus bilong God olsem mak bilong presens bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bánh trần thiết",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bánh đặc biệt được đặt trên bàn trong đền thờ như một biểu tượng về sự hiện diện của Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "供饼",
      "descriptions": [
        {
          "source": "acai",
          "description": "圣殿中摆在桌子上象征神同在的特别饼。"
        }
      ]
    },
    "zht": {
      "preferred_label": "陳設餅",
      "descriptions": [
        {
          "source": "acai",
          "description": "常擺放在聖殿桌子上作為神同在象徵的特製餅。"
        }
      ]
    }
  },
