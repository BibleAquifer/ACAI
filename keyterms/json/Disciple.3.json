        }
      ]
    },
    "spa": {
      "preferred_label": "discípula (mujer)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mujer que sigue a un maestro o líder y aprende de él."
        }
      ]
    },
    "fra": {
      "preferred_label": "disciple (femme)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une femme qui suit un maître ou un chef et reçoit son enseignement."
        }
      ]
    },
    "ind": {
      "preferred_label": "murid (perempuan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang perempuan yang mengikuti dan belajar dari seorang guru atau pemimpin."
        }
      ]
    },
    "por": {
      "preferred_label": "discípula",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma mulher que segue e aprende com um mestre ou líder."
        }
      ]
    },
    "apd": {
      "preferred_label": "تلميذة (أنثى)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مرة بتمشي ورا أستاذ أو قائد وبتتعلم منه."
        }
      ]
    },
    "arb": {
      "preferred_label": "تِلْمِيذ (أُنْثَى)",
      "descriptions": [
        {
          "source": "acai",
          "description": "امْرَأَةٌ تَتْبَعُ مُعَلِّمًا أَوْ قَائِدًا وَتَتَعَلَّمُ مِنْهُ."
        }
      ]
    },
    "bis": {
      "preferred_label": "disaepol (woman)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan woman we i folem wan tija o lida mo i stap lanem samting long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Almajira (Mace)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mace mai bin wani malami ko shugaba tana kuma koyo daga wurinsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "चेली",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक स्त्री जो किसी शिक्षक या अगुवे का अनुसरण करती है और उससे सीखती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye na-eso ụzọ (Nwanyị)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwanyị na-eso ma na-amụta ihe nʼaka onye nkuzi maọbụ onye ndu."
        }
      ]
    },
    "nep": {
      "preferred_label": "चेला (महिला)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै शिक्षक वा अगुवालाई पछ्याउने र उसबाट सिक्ने स्त्री।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Ученица",
      "descriptions": [
        {
          "source": "acai",
          "description": "Женщина, которая следует за учителем или лидером и учится у него."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwanafunzi (Mwanamke)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamke anayemfuata na kujifunza kutoka kwa mwalimu au kiongozi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "disaipel (meri)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela meri i bihainim na kisim save long wanpela tisa o lida."
        }
      ]
    },
    "vie": {
      "preferred_label": "Môn đệ (nữ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người nữ đi theo và học hỏi từ một người thầy hoặc một nhà lãnh đạo."
        }
      ]
    },
    "zhs": {
      "preferred_label": "门徒 (女性)",
      "descriptions": [
        {
          "source": "acai",
          "description": "跟随老师或领袖并向其学习的女性。"
        }
      ]
    },
    "zht": {
      "preferred_label": "門徒 (女性)",
      "descriptions": [
        {
          "source": "acai",
          "description": "跟隨老師或領袖並向其學習的女性。"
        }
      ]
    }
  },
