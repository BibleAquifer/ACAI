{
  "id": "keyterm:LoyalPerson",
  "primary_id": "keyterm:LoyalPerson",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "002416001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Loyal Person",
      "alternate_labels": [
        "Pious Person"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A person who is faithful and keeps promises, showing kindness to those who have been kind to them."
        }
      ]
    },
    "spa": {
      "preferred_label": "fiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Persona fiel que cumple sus promesas y muestra bondad hacia quienes han sido bondadosos con ella."
        }
      ]
    },
    "fra": {
      "preferred_label": "homme fidèle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personne fidèle qui tient ses promesses et fait preuve de bonté envers ceux qui ont été bons envers elle."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang yang setia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seseorang yang setia dan menepati janji, menunjukkan kebaikan kepada mereka yang telah berbuat baik kepadanya."
        }
      ]
    },
    "por": {
      "preferred_label": "pessoa fiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoa fiel que cumpre promessas, demonstrando bondade àqueles que foram bondosos com ela."
        }
      ]
    },
    "apd": {
      "preferred_label": "زول مخلص",
      "descriptions": [
        {
          "source": "acai",
          "description": "زول أمين وبيحفظ العهود، وبيظهر معروف للناس الكانوا كويسين معاه."
        }
      ]
    },
    "arb": {
      "preferred_label": "شخص وفيّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "شخص أمين يفي بوعوده، ويُظهر لطفًا لمن أحسنوا إليه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Man we i fetful",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i fetful mo i holem promes blong hem, we i soem kaenfala fasin long olgeta we oli bin kaen long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai aminci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin da yake da aminci kuma yana cika alkawura, yana nuna alheri ga waɗanda suka nuna masa alheri."
        }
      ]
    },
    "hin": {
      "preferred_label": "विश्वासयोग्य जन",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक ऐसा व्यक्ति जो विश्वासयोग्य है और प्रतिज्ञाओं को निभाता है, तथा उनके प्रति भलाई दिखाता है जिन्होंने उसके साथ भलाई की हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye kwesịrị ntụkwasị obi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye kwesịrị ntụkwasị obi ma na-edebe nkwa, na-egosikwa obiọma nʼebe ndị mesoro ya obiọma nọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "विश्वासयोग्य व्यक्ति",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक व्यक्ति जो विश्वासयोग्य हुन्छ र प्रतिज्ञाहरू पूरा गर्छ, तथा आफूलाई दया देखाउनेहरूप्रति दया देखाउँछ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "верный человек",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, который верен, хранит обещания и проявляет доброту к тем, кто был добр к нему."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mtu mwaminifu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu ambaye ni mwaminifu na anayetimiza ahadi, akionyesha wema kwa wale waliomtendea wema."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Man i save stap gut tru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man i save stap gut long narapela na bihainim promis bilong en, na mekim gutpela pasin long ol lain i bin mekim gut long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người trung tín",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người trung tín và giữ trọn lời hứa, bày tỏ lòng nhân từ đối với những người đã đối đãi tốt với mình."
        }
      ]
    },
    "zhs": {
      "preferred_label": "忠心的人",
      "descriptions": [
        {
          "source": "acai",
          "description": "信实且守信用的人，对以善相待者报以恩慈。"
        }
      ]
    },
    "zht": {
      "preferred_label": "忠誠的人",
      "descriptions": [
        {
          "source": "acai",
          "description": "忠實且信守承諾，並向以恩慈待自己的人展現恩慈的人。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
