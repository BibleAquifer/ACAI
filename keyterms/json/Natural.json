      "descriptions": [
        {
          "source": "acai",
          "description": "Related to the physical world and living things, not spiritual or supernatural."
        }
      ]
    },
    "spa": {
      "preferred_label": "natural",
      "descriptions": [
        {
          "source": "acai",
          "description": "Relacionado con el mundo físico y los seres vivos, no espiritual ni sobrenatural."
        }
      ]
    },
    "fra": {
      "preferred_label": "naturel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lié au monde physique et aux êtres vivants, et non spirituel ou surnaturel."
        }
      ]
    },
    "ind": {
      "preferred_label": "alamiah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Terkait dengan dunia fisik dan makhluk hidup, bukan rohani atau supranatural."
        }
      ]
    },
    "por": {
      "preferred_label": "natural",
      "descriptions": [
        {
          "source": "acai",
          "description": "Relacionado ao mundo físico e aos seres vivos, não espiritual ou sobrenatural."
        }
      ]
    },
    "apd": {
      "preferred_label": "طبيعي",
      "descriptions": [
        {
          "source": "acai",
          "description": "متعلق بالعالم المادي والكائنات الحية، وماهوش روحي ولا فوق الطبيعة."
        }
      ]
    },
    "arb": {
      "preferred_label": "طَبِيعِيّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَا يَتَعَلَّقُ بِالْعَالَمِ الْمَادِّيِّ وَالْكَائِنَاتِ الْحَيَّةِ، وَلَيْسَ رُوحِيًّا أَوْ فَائِقًا لِلطَّبِيعَةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "blong wol ya",
      "descriptions": [
        {
          "source": "acai",
          "description": "I joen wetem wol ya mo ol samting we oli gat laef, we i no samting blong spirit o samting we i kamaot long God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Na zahiri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mai dangantaka da duniyar zahiri da rayayyun halittu, ba na ruhaniya ko na abin mamaki na sama ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "शारीरिक / स्वाभाविक",
      "descriptions": [
        {
          "source": "acai",
          "description": "भौतिक संसार और जीवित प्राणियों से संबंधित, आत्मिक या अलौकिक नहीं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "nke nkịtị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Banyere ụwa anụ ahụ na ihe ndị dị ndụ, ọ bụghị nke mmụọ ma ọ bụ nke gafere okike."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्राकृतिक",
      "descriptions": [
        {
          "source": "acai",
          "description": "भौतिक संसार र जीवित प्राणीहरूसँग सम्बन्धित, आत्मिक वा अलौकिक नभएको।"
        }
      ]
    },
    "rus": {
      "preferred_label": "душевный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Относящийся к физическому миру и живым существам; не духовный и не сверхъестественный."
        }
      ]
    },
    "swh": {
      "preferred_label": "-a asili",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhusiana na ulimwengu wa kimwili na viumbe hai, si wa kiroho au usio wa kawaida."
        }
      ]
    },
    "tpi": {
      "preferred_label": "samting bilong dispela graun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting bilong dispela graun na bilong ol samting i gat laip, i no samting bilong spirit o bilong heven."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tự nhiên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thuộc về thế giới vật chất và các sinh vật sống, không thuộc về tâm linh hay siêu nhiên."
        }
      ]
    },
    "zhs": {
      "preferred_label": "属血气",
      "descriptions": [
        {
          "source": "acai",
          "description": "与物质世界和生物相关，而非属灵或超自然的。"
        }
      ]
    },
    "zht": {
      "preferred_label": "屬血氣的",
      "descriptions": [
        {
          "source": "acai",
          "description": "與物質世界和生物相關，而非屬靈或超自然的。"
        }
      ]
    }
  },
