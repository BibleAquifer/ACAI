  "localizations": {
    "eng": {
      "preferred_label": "To Command (Give Orders)",
      "descriptions": [
        {
          "source": "acai",
          "description": "To give clear orders that show authority or official power."
        }
      ]
    },
    "spa": {
      "preferred_label": "mandar (dar órdenes)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dar órdenes claras que muestran autoridad o poder oficial."
        }
      ]
    },
    "fra": {
      "preferred_label": "ordonner (donner des ordres)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Donner des ordres clairs manifestant une autorité ou un pouvoir officiel."
        }
      ]
    },
    "ind": {
      "preferred_label": "memerintahkan (memberi perintah)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memberikan perintah yang jelas yang menunjukkan wewenang atau kuasa resmi."
        }
      ]
    },
    "por": {
      "preferred_label": "mandar (dar ordens)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dar ordens claras que mostram autoridade ou poder oficial."
        }
      ]
    },
    "apd": {
      "preferred_label": "يأمر (يدي أوامر)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إعطاء أوامر واضحة بتبيّن السلطة أو القوة الرسمية."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَأْمُرُ (يُصْدِرُ أَوامِرَ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إِعْطاءُ أَوامِرَ واضِحَةٍ تُظهِرُ سُلْطَةً أَو نُفوذًا رَسْمِيًّا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Givim oda (Tok strong)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong givim wan klia oda we i soemaot paoa o atoriti."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ba da Umarni (Ba da Doka)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ba da tabbataccen umarni da ke nuna iko ko ikon hukuma."
        }
      ]
    },
    "hin": {
      "preferred_label": "आज्ञा देना (हुक्म देना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "स्पष्ट आज्ञा देना जो अधिकार या आधिकारिक सामर्थ्य को प्रकट करता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Inye iwu (Inye Iwu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inye iwu doro anya nke na-egosi ikike ma ọ bụ ike ọchịchị."
        }
      ]
    },
    "nep": {
      "preferred_label": "आदेश दिनु (हुकुम दिनु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अधिकार वा औपचारिक शक्ति देखाउने स्पष्ट आदेश दिनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Повелевать (отдавать приказы)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отдавать четкие распоряжения, выражающие власть или официальные полномочия."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuamuru (Kutoa Maagizo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutoa maagizo ya wazi yanayoonyesha mamlaka au uwezo rasmi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Givim oda (Givim tok strong)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long givim klia oda o tok i kam long bikpela namba o pawa."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ra lệnh (Ban mệnh lệnh)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ban ra những chỉ thị rõ ràng thể hiện thẩm quyền hoặc quyền hạn chính thức."
        }
      ]
    },
    "zhs": {
      "preferred_label": "吩咐（发号施令）",
      "descriptions": [
        {
          "source": "acai",
          "description": "发出明确的命令，显示出权柄或官方权力。"
        }
      ]
    },
    "zht": {
      "preferred_label": "吩咐（發布命令）",
      "descriptions": [
        {
          "source": "acai",
          "description": "發出表明權柄或官方權力的明確命令。"
        }
      ]
    }
  },
