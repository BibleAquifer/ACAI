  ],
  "localizations": {
    "eng": {
      "preferred_label": "Be Rebellious",
      "descriptions": [
        {
          "source": "acai",
          "description": "To refuse to follow rules or respect those in authority."
        }
      ]
    },
    "spa": {
      "preferred_label": "ser rebelde",
      "descriptions": [
        {
          "source": "acai",
          "description": "Negarse a cumplir las normas o a respetar a quienes tienen autoridad."
        }
      ]
    },
    "fra": {
      "preferred_label": "être rebelle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Refuser de suivre les règles ou de respecter les personnes détenant l'autorité."
        }
      ]
    },
    "ind": {
      "preferred_label": "memberontak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menolak untuk menaati aturan atau menghormati pihak yang berwenang."
        }
      ]
    },
    "por": {
      "preferred_label": "ser rebelde",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recusar-se a seguir regras ou a respeitar autoridades."
        }
      ]
    },
    "apd": {
      "preferred_label": "يتمرد",
      "descriptions": [
        {
          "source": "acai",
          "description": "رفض إتباع القوانين أو إحترام الناس العندهم سلطة."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَتَمَرَّدُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "رَفْضُ اتِّبَاعِ الْقَوَاعِدِ أَوِ احْتِرَامِ أَصْحَابِ السُّلْطَةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Agens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong no wantem folem ol rul o no wantem respektem olgeta we oli gat haenem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin tawaye",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙin bin dokoki ko rashin girmama masu iko."
        }
      ]
    },
    "hin": {
      "preferred_label": "बलवा करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "नियमों का पालन करने या अधिकार रखने वालों का सम्मान करने से इनकार करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Inupu isi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịjụ ịgbaso iwu ma ọ bụ ịsọpụrụ ndị nọ nʼọchịchị."
        }
      ]
    },
    "nep": {
      "preferred_label": "विद्रोही बन्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "नियमहरू पालन गर्न वा अधिकारमा भएकाहरूलाई आदर गर्न इन्कार गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Быть непокорным",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отказываться соблюдать правила или проявлять неуважение к власть имущим."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuwa Mwasi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kukataa kufuata sheria au kutoheshimu wale walio na mamlaka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sakim tok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong no bihainim ol lo o no rispektim ol man i gat namba."
        }
      ]
    },
    "vie": {
      "preferred_label": "Nổi loạn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Từ chối tuân theo luật lệ hoặc không tôn trọng những người có thẩm quyền."
        }
      ]
    },
    "zhs": {
      "preferred_label": "叛逆",
      "descriptions": [
        {
          "source": "acai",
          "description": "拒绝遵守规条或不尊重掌权者。"
        }
      ]
    },
    "zht": {
      "preferred_label": "悖逆",
      "descriptions": [
        {
          "source": "acai",
          "description": "拒絕遵守規矩或不尊重掌權者。"
        }
      ]
    }
  },
