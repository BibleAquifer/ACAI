        }
      ]
    },
    "hin": {
      "preferred_label": "शुद्धता (अनुष्ठानिक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विशेष धार्मिक नियमों के अनुसार शुद्ध और स्वीकार्य होने की अवस्था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịdị ọcha (Nke omenaala)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọnọdụ nke ịdị ọcha na ịbụ onye a na-anabata dịka usoro iwu okpukpe pụrụ iche si dị."
        }
      ]
    },
    "nep": {
      "preferred_label": "शुद्धता (विधिगत)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विशेष धार्मिक नियमहरूअनुसार शुद्ध र स्वीकार्य हुनुको अवस्था।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Чистота (ритуальная)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Состояние ритуальной чистоты и угодности Богу согласно особым религиозным правилам."
        }
      ]
    },
    "swh": {
      "preferred_label": "Usafi wa Kiasili (Kiibada)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hali ya kuwa safi na mwenye kukubalika kulingana na kanuni maalum za kidini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "stap klin (bilong lotu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Stap klin na stret long ai bilong God long rot bilong bihainim ol lo bilong lotu."
