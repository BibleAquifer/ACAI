        }
      ]
    },
    "zhs": {
      "preferred_label": "洁净（仪式）",
      "descriptions": [
        {
          "source": "acai",
          "description": "根据特别的宗教条例而处于洁净且为人所接受的状态。"
        }
      ]
    },
    "zht": {
      "preferred_label": "潔淨 (禮儀)",
