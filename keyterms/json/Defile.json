{
  "id": "keyterm:Defile",
  "primary_id": "keyterm:Defilement",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "53.33",
    "53.40"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Defile (Become Unclean)",
      "descriptions": [
        {
          "source": "acai",
          "description": "To make something dirty or unclean, especially in a way that breaks religious laws."
        }
      ]
    },
    "spa": {
      "preferred_label": "hacer impuro (volverse impuro)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer que algo se vuelva sucio o impuro, especialmente de una manera que quebranta las leyes religiosas."
        }
      ]
    },
    "fra": {
      "preferred_label": "souiller (devenir impur)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rendre quelque chose souillé ou impur, en particulier d'une manière qui enfreint les lois religieuses."
        }
      ]
    },
    "ind": {
      "preferred_label": "menajiskan (menjadi najis)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menjadikan sesuatu kotor atau najis, khususnya dengan cara yang melanggar hukum-hukum keagamaan."
        }
      ]
    },
    "por": {
      "preferred_label": "tornar impuro (tornar-se impuro)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tornar algo sujo ou impuro, especialmente de uma maneira que viole preceitos religiosos."
        }
      ]
    },
    "apd": {
      "preferred_label": "يتنجّس (يصير نجس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "توسيخ شي أو تنجيسه، خصوصاً بطريقة بتكسر الشرايع الدينية."
        }
      ]
    },
    "arb": {
      "preferred_label": "ينجس (يصير نجسًا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "جعل شيء غير طاهر أو نجسًا، خصوصًا بطريقة تكسر الشريعة الدينية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem i doti (Kam doti)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem wan samting i doti no i no klin, speseli long wan fasin we i brekem ol lo blong wosip."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙazantarwa (Zama Marar Tsarki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mai da wani abu mai datti ko marar tsarki, musamman a hanyar da take karya dokokin addini."
        }
      ]
    },
    "hin": {
      "preferred_label": "अशुद्ध होना (अशुद्ध बनना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी वस्तु को गंदा या अशुद्ध करना, विशेषकर इस प्रकार कि जिससे धार्मिक नियमों का उल्लंघन हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Imerụ (Ịghọ ihe na-adịghị ọcha)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka ihe bụrụ ihe rụrụ arụ ma ọ bụ na-adịghị ọcha, karịsịa nʼụzọ na-emebi iwu okpukpe."
        }
      ]
    },
    "nep": {
      "preferred_label": "अपवित्र बनाउनु (अशुद्ध हुनु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कुरालाई मैला वा अशुद्ध बनाउनु, विशेष गरी धार्मिक नियमहरू उल्‍लंघन हुने तरिकाले।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Осквернять (становиться нечистым)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Делать что-либо грязным или нечистым, особенно в нарушение религиозных законов."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutia Najisi (Kuwa Najisi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kufanya kitu kuwa kichafu au najisi, hasa kwa njia inayovunja sheria za kidini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim i kamap doti (Kamap doti)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long mekim wanpela samting i kamap doti, moa yet long kain pasin i brukim ol lo bilong lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Làm ô uế (Trở nên ô uế)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm cho điều gì đó trở nên dơ bẩn hoặc ô uế, đặc biệt là theo cách vi phạm luật tôn giáo."
        }
      ]
    },
    "zhs": {
      "preferred_label": "玷污 (变不洁)",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某物变脏或不洁净，尤其是以违背宗教律法的方式。"
        }
      ]
    },
    "zht": {
      "preferred_label": "污穢（成為不潔）",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某物骯髒或不潔，尤指違反宗教律法的方式。"
        }
      ]
    }
  },
