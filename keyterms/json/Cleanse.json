  "localizations": {
    "eng": {
      "preferred_label": "Cleanse",
      "alternate_labels": [
        "Be Cleansed",
        "Purify",
        "Be Purified"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To make something clean by removing ritual dirt or impurity."
        }
      ]
    },
    "spa": {
      "preferred_label": "limpiar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer limpio algo quitando la suciedad o la impureza ritual."
        }
      ]
    },
    "fra": {
      "preferred_label": "rendre pur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rendre quelque chose pur en ôtant la souillure ou l'impureté rituelle."
        }
      ]
    },
    "ind": {
      "preferred_label": "mentahirkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menjadikan sesuatu bersih dengan menyingkirkan kotoran atau kecemaran ritual."
        }
      ]
    },
    "por": {
      "preferred_label": "purificar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tornar algo limpo ao remover a sujeira ou impureza ritual."
        }
      ]
    },
    "apd": {
      "preferred_label": "يطهّر",
      "descriptions": [
        {
          "source": "acai",
          "description": "جعل حاجة نظيفة بإزالة الوسخ الطقسي أو النجاسة."
        }
      ]
    },
    "arb": {
      "preferred_label": "طَهَّرَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "جعل الشيء طاهرًا بإزالة النجاسة الطقسية أو الدنس."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem i klin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem wan samting i klin tru long fasin blong tekemaot doti no samting we i mekem man i no klin long kastom no wosip."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tsabtacewa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mayar da wani abu mai tsabta ta wurin cire dattin al’ada ko ƙazanta."
        }
      ]
    },
    "hin": {
      "preferred_label": "शुद्ध करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "धार्मिक अशुद्धता या गंदगी को दूर करके किसी चीज़ को शुद्ध करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ime ka ọ dị ọcha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka ihe dị ọcha site nʼiwepụ unyi ma ọ bụ adịghị ọcha nke ememe."
        }
      ]
    },
    "nep": {
      "preferred_label": "शुद्ध गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "विधिको फोहोर वा अशुद्धता हटाएर कुनै थोक सफा पार्नु वा शुद्ध गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "очищать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сделать что-либо чистым, удалив ритуальную грязь или нечистоту."
        }
      ]
    },
    "swh": {
      "preferred_label": "Takasa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kufanya kitu kuwa safi kwa kuondoa uchafu au unajisi wa kiibada."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim i klin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong mekim samting i kamap klin long rot bilong rausim doti o pasin i no klin long ai bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thanh tẩy",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm cho một vật trở nên sạch sẽ bằng cách loại bỏ sự ô uế hoặc bẩn thỉu theo nghi lễ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "洁净",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过除去礼仪上的污秽或不洁使某物洁净。"
        }
      ]
    },
    "zht": {
      "preferred_label": "使潔淨",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由除去禮儀上的污垢或不潔，使某物潔淨。"
        }
      ]
    }
  },
