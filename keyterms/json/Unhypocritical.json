  "localizations": {
    "eng": {
      "preferred_label": "Unhypocritical",
      "alternate_labels": [
        "Without Hypocrisy",
        "Genuine"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Being real and honest, without pretending or faking."
        }
      ]
    },
    "spa": {
      "preferred_label": "sin hipocresía",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser auténtico y sincero, sin fingimiento ni engaño."
        }
      ]
    },
    "fra": {
      "preferred_label": "sans hypocrisie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Être vrai et honnête, sans feinte ni faux-semblant."
        }
      ]
    },
    "ind": {
      "preferred_label": "tidak munafik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bersikap tulus dan jujur, tanpa kepura-puraan."
        }
      ]
    },
    "por": {
      "preferred_label": "sem hipocrisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser autêntico e honesto, sem fingimento ou dissimulação."
        }
      ]
    },
    "apd": {
      "preferred_label": "بدون نفاق",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنك تكون حقيقي وصادق، بدون تظاهر أو نفاق."
        }
      ]
    },
    "arb": {
      "preferred_label": "بِلَا رِيَاء",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يكون المرء حقيقيًا وصادقًا، من دون تظاهر أو تصنع."
        }
      ]
    },
    "bis": {
      "preferred_label": "no blong giaman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong stap tru mo no giaman, we man i no giaman o no stap traem trikim narafala man."
        }
      ]
    },
    "hau": {
      "preferred_label": "marar riya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zama na ainihi kuma na gaskiya, ba tare da nuna fuska biyu ko riya ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "निष्कपट",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिना किसी दिखावे या ढोंग के वास्तविक और ईमानदार होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Enweghị ihu abụọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ ezigbo onye na onye na-ekwu eziokwu, n'emeghị ka a ga-asị ma ọ bụ ihu abụọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "निष्कपट",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै कपट वा देखावटीपनविना वास्तविक र इमानदार हुनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "нелицемерный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Искренний и честный, без притворства и фальши."
        }
      ]
    },
    "swh": {
      "preferred_label": "-sio na unafiki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa halisi na mnyofu, bila kujifanya au kuwa bandia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "no save giaman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong stap tru na stret, i no bilong giaman o mekim pasin kranki bilong gipim ai tasol."
        }
      ]
    },
    "vie": {
      "preferred_label": "không giả dối",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chân thật và thành thật, không giả vờ hay dối trá."
        }
      ]
    },
    "zhs": {
      "preferred_label": "无伪",
      "descriptions": [
        {
          "source": "acai",
          "description": "真实而诚恳，毫无假装或虚伪。"
        }
      ]
    },
    "zht": {
      "preferred_label": "無偽",
      "descriptions": [
        {
          "source": "acai",
          "description": "真實而誠實，毫無虛假或偽裝。"
        }
      ]
    }
  },
