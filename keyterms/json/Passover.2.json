  "localizations": {
    "eng": {
      "preferred_label": "Passover",
      "descriptions": [
        {
          "source": "acai",
          "description": "A Jewish festival that celebrates when God saved the Israelites from slavery in Egypt."
        }
      ]
    },
    "spa": {
      "preferred_label": "Pascua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fiesta judía que celebra cuando Dios salvó a los israelitas de la esclavitud en Egipto."
        }
      ]
    },
    "fra": {
      "preferred_label": "Pâque (fête)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une fête juive qui célèbre le moment où Dieu a sauvé les Israélites de l'esclavage en Égypte."
        }
      ]
    },
    "ind": {
      "preferred_label": "hari raya Paskah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hari raya Yahudi yang merayakan saat Allah menyelamatkan orang Israel dari perbudakan di Mesir."
        }
      ]
    },
    "por": {
      "preferred_label": "Páscoa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma festa judaica que celebra quando Deus salvou os israelitas da escravidão no Egito."
        }
      ]
    },
    "apd": {
      "preferred_label": "عيد الفصح",
      "descriptions": [
        {
          "source": "acai",
          "description": "عيد يهودي بيحتفلوا بيه بإنقاذ الله لبني إسرائيل من العبودية في مصر."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِيدُ ٱلْفِصْحِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "عِيدٌ يَهُودِيٌّ يَحْتَفِلُ بِإِنْقَاذِ ٱللهِ لِبَنِي إِسْرَائِيلَ مِنَ ٱلْعُبُودِيَّةِ فِي مِصْرَ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Lafet blong Pasova",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan lafet blong ol man Jiu we oli selebretem taem we God i sevem ol laen blong Isrel aot long fasin slef long Ijip."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bikin Ƙetarewa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bikin Yahudawa wanda yake bikin tunawa da lokacin da Allah ya ceci Isra’ilawa daga bauta a Masar."
        }
      ]
    },
    "hin": {
      "preferred_label": "फसह पर्व",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक यहूदी पर्व जो यह स्मरण करने के लिए मनाया जाता है कि परमेश्वर ने इस्राएलियों को मिस्र की दासता से छुड़ाया था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mmemme Ngabiga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmemme ndị Juu nke na-eme emume mgbe Chineke zọpụtara ụmụ Izrel site nʼịbụ ohu nʼIjipt."
        }
      ]
    },
    "nep": {
      "preferred_label": "निस्तार-चाड",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरले इस्राएलीहरूलाई मिश्रको दासत्वबाट छुटकारा दिनुभएको सम्झनामा मनाइने एउटा यहूदी चाड।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Пасха (праздник)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Иудейский праздник в память об избавлении израильтян Богом из египетского рабства."
        }
      ]
    },
    "swh": {
      "preferred_label": "Pasaka (sikukuu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sikukuu ya Kiyahudi inayoadhimisha wakati Mungu alipowaokoa Waisraeli kutoka utumwani Misri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Bikpela De Bilong Pasova",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela de bilong ol Juda bilong tingim taim God i bin kisim bek ol Israel long kalabus long Isip."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ Vượt Qua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một lễ hội của người Do Thái kỷ niệm việc Đức Chúa Trời giải cứu dân Y-sơ-ra-ên khỏi cảnh nô lệ tại Ai Cập."
        }
      ]
    },
    "zhs": {
      "preferred_label": "逾越节",
      "descriptions": [
        {
          "source": "acai",
          "description": "一个犹太节日，庆祝上帝拯救以色列人脱离在埃及的奴役。"
        }
      ]
    },
    "zht": {
      "preferred_label": "逾越節",
      "descriptions": [
        {
          "source": "acai",
          "description": "慶祝上帝拯救以色列人脫離埃及為奴之地的猶太節期。"
        }
      ]
    }
  },
