{
  "id": "keyterm:UncircumcisedPerson",
  "primary_id": "keyterm:UncircumcisedPerson",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "localizations": {
    "eng": {
      "preferred_label": "Uncircumcised Person",
      "descriptions": [
        {
          "source": "acai",
          "description": "A person who has not had the physical sign of circumcision, often symbolizing those outside the people of God."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang yang tidak bersunat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang yang belum menerima tanda fisik sunat, sering kali melambangkan orang-orang di luar umat Allah."
        }
      ]
    },
    "apd": {
      "preferred_label": "زول أغلف",
      "descriptions": [
        {
          "source": "acai",
          "description": "الزول الما اتختن وما عندو علامة الختان الجسدية، وغالباً برمز للناس البرّة شعب الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَخْصٌ أَغْلَفُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَخْصٌ لَمْ يَنَلْ عَلَامَةَ الْخِتَانِ الْجَسَدِيَّةَ، وَغَالِبًا مَا يُرْمَزُ بِهِ إِلَى مَنْ هُمْ خَارِجَ شَعْبِ اللهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Man we i no sakomsaes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i no mekem mak blong sakomsaes long bodi blong hem, we plante taem i pija blong olgeta we oli stap aotsaed long ol man blong God."
        }
      ]
    },
    "fra": {
      "preferred_label": "incirconcis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personne qui n'a pas reçu le signe physique de la circoncision, symbolisant souvent ceux qui ne font pas partie du peuple de Dieu."
        }
      ]
    },
    "hau": {
      "preferred_label": "Marar Kaciya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin da ba a yi masa alamar kaciya a jiki ba, wanda yakan nuna waɗanda suke wajen mutanen Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "खतनारहित व्यक्ति",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसा व्यक्ति जिसका शारीरिक रूप से खतना न हुआ हो, जो अक्सर परमेश्वर के लोगों से बाहर के लोगों का प्रतीक होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye a na-ebighị ugwu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye na-enwebeghị akara nke ibi ugwu nke anụ ahụ, nke na-egosipụtakarị ndị na-anọghị nʼime ndị Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "बेखतने व्यक्ति",
      "descriptions": [
        {
          "source": "acai",
          "description": "खतनाको शारीरिक चिह्न नभएको व्यक्ति, जसले प्रायः परमेश्वरका जनहरूभन्दा बाहिरका मानिसहरूलाई जनाउँछ।"
        }
      ]
    },
    "por": {
      "preferred_label": "incircunciso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoa que não recebeu a marca física da circuncisão, muitas vezes simbolizando aqueles que estão fora do povo de Deus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Необрезанный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, не принявший физического знака обрезания; часто символизирует тех, кто находится вне народа Божьего."
        }
      ]
    },
    "spa": {
      "preferred_label": "incircunciso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Persona que no tiene la señal física de la circuncisión, a menudo como símbolo de quienes están fuera del pueblo de Dios."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mtu Asiyetahiriwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu ambaye hajapata ishara ya kimwili ya tohara, mara nyingi huashiria wale walio nje ya watu wa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Man I No Bin Katim Skin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man ol i no bin katim skin bilong en, na planti taim dispela i makim ol manmeri i stap ausait long lain bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "người không chịu cắt bì",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người chưa chịu dấu hiệu thể xác của phép cắt bì, thường biểu trưng cho những người nằm ngoài dân tộc của Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "未受割礼的人",
      "descriptions": [
        {
          "source": "acai",
          "description": "没有受过割礼身体记号的人，通常象征属上帝子民之外的人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "未受割禮的人",
      "descriptions": [
        {
          "source": "acai",
          "description": "未受割禮肉身記號的人，常象徵屬上帝子民之外的人。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
