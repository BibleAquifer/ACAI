  "localizations": {
    "eng": {
      "preferred_label": "Arrow",
      "descriptions": [
        {
          "source": "acai",
          "description": "A thin, pointed stick used with a bow, often symbolizing danger or punishment."
        }
      ]
    },
    "spa": {
      "preferred_label": "flecha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vara delgada y puntiaguda que se dispara con un arco, a menudo símbolo de peligro o castigo."
        }
      ]
    },
    "fra": {
      "preferred_label": "flèche",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tige fine et pointue utilisée avec un arc, symbolisant souvent le danger ou le châtiment."
        }
      ]
    },
    "ind": {
      "preferred_label": "anak panah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Batang tipis dan runcing yang digunakan dengan busur, sering kali melambangkan bahaya atau hukuman."
        }
      ]
    },
    "por": {
      "preferred_label": "flecha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma vara fina e pontiaguda usada com um arco, frequentemente simbolizando perigo ou punição."
        }
      ]
    },
    "apd": {
      "preferred_label": "سهم",
      "descriptions": [
        {
          "source": "acai",
          "description": "عود رفيع ومسنن بيستعملوه مع القوس، وغالباً برمز للخطر أو العقاب."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَهْم",
      "descriptions": [
        {
          "source": "acai",
          "description": "عَصًا رَفِيعَةٌ مُدَبَّبَةُ ٱلطَّرَفِ تُسْتَعْمَلُ مَعَ ٱلْقَوْسِ، وَغَالِبًا مَا تَرْمُزُ إِلَى ٱلْخَطَرِ أَوِ ٱلْعِقَابِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Smol stik we i sap mo man i stap sutum wetem bofren, we plante taem i makem denja o panis."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kibiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Siririn itace mai tsini da ake amfani da shi tare da baka, yakan nuna alamar haɗari ko hukunci sau da yawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "तीर",
      "descriptions": [
        {
          "source": "acai",
          "description": "धनुष के साथ उपयोग की जाने वाली एक पतली, नुकीली तीली, जो प्रायः खतरे या दण्ड का प्रतीक होती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Àkụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu osisi dị gịrịgịrị, dị nkọ nʼọnụ nke a na-eji ụta agba, na-anọchite anya ihe egwu ma ọ bụ ntaramahụhụ mgbe mgbe."
        }
      ]
    },
    "nep": {
      "preferred_label": "काँड",
      "descriptions": [
        {
          "source": "acai",
          "description": "धनुषसँग प्रयोग गरिने एउटा पातलो, तिखो काठ, जसले प्रायः खतरा वा दण्डलाई सङ्केत गर्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Стрела",
      "descriptions": [
        {
          "source": "acai",
          "description": "Тонкая заостренная палочка, используемая с луком, часто символизирующая опасность или наказание."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mshale",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kijiti chembamba chenye ncha kali kinachotumiwa pamoja na upinde, mara nyingi kikiashiria hatari au adhabu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "spia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bun stik i sap na man i save sutim long banara, planti taim em i makim bagarap o hevi bilong strafe."
        }
      ]
    },
    "vie": {
      "preferred_label": "Mũi tên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thanh gỗ mỏng, có đầu nhọn dùng với cung, thường tượng trưng cho sự nguy hiểm hoặc hình phạt."
        }
      ]
    },
    "zhs": {
      "preferred_label": "箭",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种带尖头的细长杆，与弓配合使用，常象征危险或惩罚。"
        }
      ]
    },
    "zht": {
      "preferred_label": "箭",
      "descriptions": [
        {
          "source": "acai",
          "description": "與弓配合使用的細長尖銳木棒，常象徵危險或懲罰。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
