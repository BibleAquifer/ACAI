  "localizations": {
    "eng": {
      "preferred_label": "Land Flowing of Milk and Honey",
      "alternate_labels": [
        "Fruitful Land"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A very rich and fertile land that provides plenty of food and blessings."
        }
      ]
    },
    "spa": {
      "preferred_label": "tierra que fluye leche y miel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tierra muy rica y fértil que proporciona abundante alimento y bendiciones."
        }
      ]
    },
    "fra": {
      "preferred_label": "pays où coulent le lait et le miel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Terre très riche et fertile qui fournit une abondance de nourriture et de bénédictions."
        }
      ]
    },
    "ind": {
      "preferred_label": "negeri yang berlimpah-limpah susu dan madunya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Negeri yang sangat kaya dan subur yang menyediakan banyak makanan dan berkat."
        }
      ]
    },
    "por": {
      "preferred_label": "Terra que mana leite e mel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma terra muito rica e fértil que fornece alimento e bênçãos em abundância."
        }
      ]
    },
    "apd": {
      "preferred_label": "أرض بتفيض لبن وعسل",
      "descriptions": [
        {
          "source": "acai",
          "description": "أرض خصبة وغنية بالحيل، بتوفر أكل وبركات كتيرة."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَرْضٌ تَفيضُ لَبَنًا وعَسَلًا",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَرْضٌ غَنِيَّةٌ وخِصْبَةٌ جِدًّا تُوَفِّرُ طَعامًا وبَرَكاتٍ وفِيرَةً."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kantri we i karem fulap kakae",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kantri we graon blong hem i gud we i gud tumas mo i karem fulap kakae mo blesing."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙasa mai zub da madara da zuma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙasa mai wadata sosai da ƙasa mai albarka wadda ke ba da abinci mai yawa da albarkatu."
        }
      ]
    },
    "hin": {
      "preferred_label": "दूध और मधु की धारा बहने वाला देश",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक बहुत ही समृद्ध और उपजाऊ भूमि जो प्रचुर मात्रा में भोजन और आशीषें प्रदान करती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ala Mmiri Ara Ehi na Mmanụ Aṅụ Na-eru na Ya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ala mara mma nke ukwuu ma na-eme nri nke na-ewepụta nri na ngọzi dị ukwuu."
        }
      ]
    },
    "nep": {
      "preferred_label": "दूध र मह बग्ने देश",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रशस्त भोजन र आशिष् प्रदान गर्ने एक धेरै धनी र उर्वर भूमि।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Земля, где течет молоко и мед",
      "descriptions": [
        {
          "source": "acai",
          "description": "Очень богатая и плодородная земля, дающая изобилие пищи и благословений."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nchi Inayotiririka Maziwa na Asali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nchi tajiri sana na yenye rutuba inayotoa chakula tele na baraka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Graun i gat planti gris na gutpela kaikai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela graun i gat planti gris na gutpela tumas we i save givim planti kaikai na ol blesing."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đất đượm sữa và mật",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vùng đất rất màu mỡ và phì nhiêu, cung cấp dồi dào thực phẩm và ơn phước."
        }
      ]
    },
    "zhs": {
      "preferred_label": "流奶与蜜之地",
      "descriptions": [
        {
          "source": "acai",
          "description": "提供丰富食物与福分的极肥沃富饶之地。"
        }
      ]
    },
    "zht": {
      "preferred_label": "流奶與蜜之地",
      "descriptions": [
        {
          "source": "acai",
          "description": "一處極其豐饒肥沃、出產豐盛食物與福分之地。"
        }
      ]
    }
  },
