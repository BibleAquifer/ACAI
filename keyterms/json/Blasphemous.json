{
  "id": "keyterm:Blasphemous",
  "primary_id": "keyterm:Blasphemous",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "33.402",
    "33.403"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Blasphemous",
      "alternate_labels": [
        "Slanderous",
        "Blasphemer",
        "Slanderer"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Showing disrespect or insulting God or others by speaking badly about them."
        }
      ]
    },
    "spa": {
      "preferred_label": "blasfemo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que muestra falta de respeto o insulta a Dios o a los demás hablando mal de ellos."
        }
      ]
    },
    "fra": {
      "preferred_label": "blasphématoire",
      "descriptions": [
        {
          "source": "acai",
          "description": "Qui fait preuve d'irrespect ou insulte Dieu ou d'autres personnes en disant du mal d'eux."
        }
      ]
    },
    "ind": {
      "preferred_label": "menghujat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menunjukkan rasa tidak hormat atau menghina Allah atau orang lain dengan berbicara buruk tentang mereka."
        }
      ]
    },
    "por": {
      "preferred_label": "blasfemo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demonstrar desrespeito ou insultar a Deus ou a outros falando mal deles."
        }
      ]
    },
    "apd": {
      "preferred_label": "مجدف",
      "descriptions": [
        {
          "source": "acai",
          "description": "التقليل من الاحترام أو إهانة الله أو الناس التانين بالكلام الشين عنهم."
        }
      ]
    },
    "arb": {
      "preferred_label": "تجديفي",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار عدم الاحترام أو إهانة الله أو الآخرين من خلال التحدث بالسوء عنهم."
        }
      ]
    },
    "bis": {
      "preferred_label": "fasin blong tok nogud agens long God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong soemaot we man i no respektem God no narafala man, no i jikim olgeta taem i tok nogud agens long olgeta."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai saɓo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna rashin girmamawa ko zagin Allah ko wasu ta wurin faɗin mugun abu a kansu."
        }
      ]
    },
    "hin": {
      "preferred_label": "ईशनिन्दक",
      "descriptions": [
        {
          "source": "acai",
          "description": "बुरा बोलकर परमेश्वर या अन्य लोगों का अनादर करना या उनका अपमान करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nkwulu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosipụta enweghị nsọpụrụ ma ọ bụ ịkparị Chineke ma ọ bụ ndị ọzọ site nʼikwu okwu ọjọọ megide ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "निन्दापूर्ण",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैको वा परमेश्‍वरको विरुद्धमा खराब बोलेर अनादर देखाउने वा अपमान गर्ने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "богохульный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявляющий неуважение или оскорбляющий Бога либо других людей дурными речами о них."
        }
      ]
    },
    "swh": {
      "preferred_label": "-A Kufuru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuonyesha kukosa heshima au kumtukana Mungu au wengine kwa kusema maneno mabaya kuwahusu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin bilong mekim tok nogut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong daunim God o ol arapela manmeri na mekim tok nogut bilong bagarapim nem bilong ol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Mang tính phạm thượng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tỏ ra bất kính hoặc xúc phạm Đức Chúa Trời hoặc người khác bằng cách nói xấu họ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亵渎的",
      "descriptions": [
        {
          "source": "acai",
          "description": "指通过说贬损的话来对上帝或他人表现出不敬或羞辱。"
        }
      ]
    },
    "zht": {
      "preferred_label": "褻瀆的",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉著惡言中傷而對上帝或他人表現出不敬或侮辱。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
  "lemmas": {
