{
  "id": "keyterm:Fear.6",
  "primary_id": "keyterm:Fear",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "25.251",
    "53.59",
    "25.254"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Fear (Terror)",
      "alternate_labels": [
        "Terror"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A strong feeling of terror or panic caused by thinking that something very bad or dangerous is about to happen."
        }
      ]
    },
    "spa": {
      "preferred_label": "temor (terror)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentimiento intenso de terror o pánico provocado por la idea de que algo muy malo o peligroso está a punto de suceder."
        }
      ]
    },
    "fra": {
      "preferred_label": "frayeur (terreur)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentiment intense de terreur ou de panique provoqué par la pensée qu'une chose très mauvaise ou dangereuse est sur le point d'arriver."
        }
      ]
    },
    "ind": {
      "preferred_label": "takut (kengerian)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Perasaan teror atau panik yang kuat yang disebabkan oleh anggapan bahwa sesuatu yang sangat buruk atau berbahaya akan segera terjadi."
        }
      ]
    },
    "por": {
      "preferred_label": "Medo (terror)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sentimento intenso de pavor ou pânico causado pelo pensamento de que algo muito ruim ou perigoso está prestes a acontecer."
        }
      ]
    },
    "apd": {
      "preferred_label": "خوف (رعب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إحساس قوي بالرعب أو الهلع ناتج من التفكير في إنو في حاجة كعبة شديد أو خطيرة قربت تحصل."
        }
      ]
    },
    "arb": {
      "preferred_label": "خوف (رعب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعور قوي بالرعب أو الذعر ينشأ عن الظن بأن أمراً سيئاً للغاية أو خطيراً على وشك الوقوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "fraet tumas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bigfala filing blong fraet tumas no panik we i kamaot from man i ting se wan samting we i nogud tumas no i denja i klosap blong kamtru."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tsoro (Firgita)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙaƙƙarfan jin firgita ko tsananin tsoro sakamakon tunanin cewa wani abu mai muni ƙwarai ko mai haɗari yana shirin faruwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "डर (आतंक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "आतंक या घबराहट की तीव्र भावना जो यह सोचने से उत्पन्न होती है कि कुछ बहुत बुरा या खतरनाक होने वाला है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Egwu (Oke egwu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oke mmetụta nke oke egwu ma ọ bụ ụjọ nke echiche na ihe dị ezigbo njọ ma ọ bụ dị ize ndụ na-aga ime na-akpata."
        }
      ]
    },
    "nep": {
      "preferred_label": "डर (त्रास)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै धेरै नराम्रो वा खतरनाक कुरा हुन लागेको छ भन्‍ने सोचेर उत्पन्‍न हुने त्रास वा आतंकको तीव्र भावना।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Страх (ужас)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сильное чувство ужаса или паники, вызванное мыслью о приближении чего-то крайне плохого или опасного."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hofu (Utisho)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hisia kali ya utisho au hofu kuu inayosababishwa na kuwaza kwamba jambo baya sana au la hatari liko karibu kutokea."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pret (Bikpela Pret Tru)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bikpela pret tru o guria i kamap taim man i ting wanpela samting i nogut tru o birua i laik kamap."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kinh hãi (hoảng sợ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cảm giác kinh hãi hoặc hoảng loạn tột độ do nghĩ rằng một điều rất tồi tệ hoặc nguy hiểm sắp xảy ra."
        }
      ]
    },
    "zhs": {
      "preferred_label": "恐惧 (惊恐)",
      "descriptions": [
        {
          "source": "acai",
          "description": "因认为极其糟糕或危险的事情即将发生而产生的一种强烈的恐惧或惊慌感。"
        }
      ]
    },
    "zht": {
      "preferred_label": "懼怕（恐懼）",
      "descriptions": [
        {
          "source": "acai",
          "description": "因認為極壞或危險的事即將發生而產生的強烈恐懼或驚慌感。"
        }
      ]
    }
  },
