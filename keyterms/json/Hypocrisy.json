{
  "id": "keyterm:Hypocrisy",
  "primary_id": "keyterm:Hypocrisy",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "88.227"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Hypocrisy",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pretending to have good intentions or feelings while really having different ones."
        }
      ]
    },
    "spa": {
      "preferred_label": "hipocresía",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fingir que se tienen buenas intenciones o sentimientos cuando en realidad se tienen otros diferentes."
        }
      ]
    },
    "fra": {
      "preferred_label": "hypocrisie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait de feindre de bonnes intentions ou de bons sentiments alors qu'on en éprouve en réalité d'autres."
        }
      ]
    },
    "ind": {
      "preferred_label": "kemunafikan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Berpura-pura memiliki niat atau perasaan yang baik sementara sebenarnya memiliki niat atau perasaan yang berbeda."
        }
      ]
    },
    "por": {
      "preferred_label": "hipocrisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fingir ter boas intenções ou sentimentos enquanto, na verdade, se tem outros diferentes."
        }
      ]
    },
    "apd": {
      "preferred_label": "نفاق",
      "descriptions": [
        {
          "source": "acai",
          "description": "التظاهر بنوايا أو مشاعر طيبة بينما في الحقيقة المشاعر مختلفة."
        }
      ]
    },
    "arb": {
      "preferred_label": "رِيَاء",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱلتَّظَاهُرُ بِمَشَاعِرَ أَوْ نَوَايَا حَسَنَةٍ بَيْنَمَا ٱلْوَاقِعُ بِخِلَافِ ذَلِكَ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong gat tu fes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong giaman se yu gat ol gudfala tingting o filing, be long insaed yu gat narafala tingting (fasin blong gat tu fes)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Munafunci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna kamar mutum yana da kyakkyawar niyya ko ra'ayi alhali kuwa yana da wata daban a zuciyarsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "कपट",
      "descriptions": [
        {
          "source": "acai",
          "description": "अच्छे इरादे या भावनाएँ रखने का ढोंग करना जबकि वास्तव में मन में कुछ और होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihu abụọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka a ga-asị na e nwere ezi ebumnuche ma ọ bụ mmetụta ebe e nwere ihe dị iche na nzuzo."
        }
      ]
    },
    "nep": {
      "preferred_label": "कपट",
      "descriptions": [
        {
          "source": "acai",
          "description": "भित्र अर्कै भावना वा मनसाय हुँदाहुँदै बाहिर राम्रो देखाउने ढोङ गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Лицемерие",
      "descriptions": [
        {
          "source": "acai",
          "description": "Притворство, когда человек выдает свои намерения или чувства за благородные, хотя на самом деле испытывает иные."
        }
      ]
    },
    "swh": {
      "preferred_label": "Unafiki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kujifanya kuwa na nia au hisia nzuri wakati kwa hakika mtu anazo tofauti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin giaman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong giaman olsem yu gat gutpela tingting o bel, tasol long insait tru yu gat narapela kain tingting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đạo đức giả",
      "descriptions": [
        {
          "source": "acai",
          "description": "Giả vờ có ý định hoặc tình cảm tốt lành trong khi thực chất lại mang ý nghĩ khác."
        }
      ]
    },
    "zhs": {
      "preferred_label": "伪善",
      "descriptions": [
        {
          "source": "acai",
          "description": "表面装作心怀善意或美善情感，内心却截然不同。"
        }
      ]
    },
    "zht": {
      "preferred_label": "假冒為善",
      "descriptions": [
        {
          "source": "acai",
          "description": "假裝有好的意圖或情感，內心卻完全不同。"
        }
      ]
    }
  },
  "referred_to_as": [
