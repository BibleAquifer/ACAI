  "localizations": {
    "eng": {
      "preferred_label": "The Way",
      "descriptions": [
        {
          "source": "acai",
          "description": "The early name for the group of people who follow Jesus and live by his teachings."
        }
      ]
    },
    "fra": {
      "preferred_label": "la Voie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nom donné aux débuts au groupe de personnes qui suivaient Jésus et vivaient selon ses enseignements."
        }
      ]
    },
    "ind": {
      "preferred_label": "Jalan Tuhan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebutan awal bagi kelompok orang yang mengikut Yesus dan hidup menurut ajaran-Nya."
        }
      ]
    },
    "por": {
      "preferred_label": "O Caminho",
      "descriptions": [
        {
          "source": "acai",
          "description": "O primeiro nome dado ao grupo de pessoas que seguiam a Jesus e viviam de acordo com os seus ensinamentos."
        }
      ]
    },
    "apd": {
      "preferred_label": "الطريق",
      "descriptions": [
        {
          "source": "acai",
          "description": "الاسم القديم لجماعة الناس اللي بيتبعوا يسوع وبيعيشوا بتعاليمه."
        }
      ]
    },
    "arb": {
      "preferred_label": "الطَّرِيق",
      "descriptions": [
        {
          "source": "acai",
          "description": "الاسم المبكر لجماعة الذين يتبعون يسوع ويعيشون بتعاليمه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rod",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fas nem blong grup blong ol man we oli stap folem Jisas mo oli laef folem ol tijing blong hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hanya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tsohon sunan rukunin mutanen da suke bin Yesu kuma suke rayuwa bisa ga koyarwarsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "पंथ",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु का अनुसरण करनेवाले और उनकी शिक्षाओं के अनुसार जीनेवाले लोगों के समूह का आरंभिक नाम।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụzọ ahụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aha mbụ a kpọrọ otu ndị mmadụ na-eso Jisọs ma na-ebi ndụ dị ka ozizi ya si dị."
        }
      ]
    },
    "nep": {
      "preferred_label": "त्यस मार्ग",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूलाई पछ्याउने र उहाँका शिक्षाहरूअनुसार जिउने मानिसहरूको समूहको लागि सुरुको नाम।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Путь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Раннее название общины людей, следовавших за Иисусом и живших по Его учению."
        }
      ]
    },
    "spa": {
      "preferred_label": "el Camino",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nombre que se le daba en los primeros tiempos al grupo de personas que seguían a Jesús y vivían según sus enseñanzas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Njia Ile",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jina la awali la kundi la watu wanaomfuata Yesu na kuishi kulingana na mafundisho yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bipo nem bilong lain manmeri husat i save bihainim Jisas na bihainim ol tok bilong em long laip bilong ol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đạo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tên gọi thời ban đầu dành cho nhóm người theo Chúa Giê-xu và sống theo lời dạy của Ngài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "这道",
      "descriptions": [
        {
          "source": "acai",
          "description": "早期跟随耶稣并按祂教导生活的群体之名称。"
        }
      ]
    },
    "zht": {
      "preferred_label": "這道",
      "descriptions": [
        {
          "source": "acai",
          "description": "跟隨耶穌並按其教訓生活之人早期的群體名稱。"
        }
      ]
    }
  },
