{
  "id": "keyterm:VoluntaryOffering",
  "primary_id": "keyterm:Offering",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "004649001002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Voluntary Offering",
      "descriptions": [
        {
          "source": "acai",
          "description": "A gift given freely to show love or thanks to God without being required."
        }
      ]
    },
    "spa": {
      "preferred_label": "ofrenda voluntaria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dádiva entregada voluntariamente para mostrar amor o gratitud a Dios sin que sea obligatoria."
        }
      ]
    },
    "fra": {
      "preferred_label": "offrande volontaire",
      "descriptions": [
        {
          "source": "acai",
          "description": "Don fait librement pour exprimer son amour ou sa reconnaissance à Dieu, sans y être obligé."
        }
      ]
    },
    "ind": {
      "preferred_label": "persembahan sukarela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pemberian yang diserahkan secara sukarela untuk menunjukkan kasih atau ucapan syukur kepada Allah tanpa diwajibkan."
        }
      ]
    },
    "por": {
      "preferred_label": "oferta voluntária",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma dádiva entregue livremente para demonstrar amor ou gratidão a Deus, sem que seja exigida."
        }
      ]
    },
    "apd": {
      "preferred_label": "ذبيحة طوعية",
      "descriptions": [
        {
          "source": "acai",
          "description": "عطية بتتقدم برضا وطواعية لإظهار المحبة أو الشكر لله من غير ما تكون مفروضة."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَبَرُّع",
      "descriptions": [
        {
          "source": "acai",
          "description": "عطية تُقدَّم طواعية لإظهار المحبة أو الشكر لله دون أن تكون مفروضة."
        }
      ]
    },
    "bis": {
      "preferred_label": "sakrefaes long gladhat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan presen we man i givim long gladhat blong hem nomo blong soemaot lav no tangkiu long God we i no gat loa i fosem hem blong givim."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hadayar yardar rai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kyautar da aka bayar da yardar rai don nuna ƙauna ko godiya ga Allah ba tare da an wajabta ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "स्वेच्छाबलि",
      "descriptions": [
        {
          "source": "acai",
          "description": "अनिवार्य न होते हुए भी, परमेश्वर के प्रति प्रेम या धन्यवाद प्रकट करने के लिए अपनी इच्छा से दिया गया उपहार या भेंट।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onyinye afọ ofufu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyinye a na-eji afọ ofufo enye iji gosi ịhụnanya ma ọ bụ ekele nye Chineke nʼenweghị iwu manyere ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "स्वैच्छिक भेटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरलाई प्रेम वा धन्यवाद देखाउन बाध्य नभई स्वेच्छाले दिइने उपहार।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Добровольное приношение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дар, приносимый добровольно из любви или благодарности к Богу, без обязательного предписания."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sadaka ya Hiari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zawadi inayotolewa kwa hiari ili kuonyesha upendo au shukrani kwa Mungu bila kushurutishwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ofa long laik bilong man yet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela presen man i givim long laik bilong em yet bilong soim lav o givim tenkyu long God, we i no olsem wanpela lo i tambuim o fosim em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ vật tự nguyện",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lễ vật được dâng cách tự nguyện để bày tỏ tình yêu thương hoặc lòng biết ơn đối với Đức Chúa Trời mà không bị bắt buộc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "甘心祭",
      "descriptions": [
        {
          "source": "acai",
          "description": "非出于规定、为向上帝表达爱或感恩而自愿献上的礼物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "甘心祭",
      "descriptions": [
        {
          "source": "acai",
          "description": "出於自願獻給上帝以表達愛或感謝的禮物，並非出於規定。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Offering"
  ],
