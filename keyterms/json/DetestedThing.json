  "localizations": {
    "eng": {
      "preferred_label": "Detested Thing",
      "alternate_labels": [
        "Idol"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Something very bad or hated, often a false god or idol."
        }
      ]
    },
    "spa": {
      "preferred_label": "cosa detestable",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo muy malo o detestado, a menudo un dios falso o un ídolo."
        }
      ]
    },
    "fra": {
      "preferred_label": "abomination",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chose particulièrement mauvaise ou détestée, souvent un faux dieu ou une idole."
        }
      ]
    },
    "ind": {
      "preferred_label": "kejijikan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sesuatu yang sangat buruk atau dibenci, sering kali berupa allah palsu atau berhala."
        }
      ]
    },
    "por": {
      "preferred_label": "abominação",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo muito ruim ou odiado, frequentemente um falso deus ou ídolo."
        }
      ]
    },
    "apd": {
      "preferred_label": "رجاسة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة كعبة شديد أو مكروهة، وغالباً إله مزيف أو صنم."
        }
      ]
    },
    "arb": {
      "preferred_label": "رِجْس",
      "descriptions": [
        {
          "source": "acai",
          "description": "شيء سيئ للغاية أو مكروه، وغالبًا ما يكون إلهًا باطلًا أو وثنًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Samting we i nogud we i nogud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we i nogud we i nogud no we oli hetem tumas, plante taem hem i wan giaman god no wan aedol."
        }
      ]
    },
    "hau": {
      "preferred_label": "abin banƙyama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu mara kyau ƙwarai ko abin ƙyama, sau da yawa allahn ƙarya ko gunki."
        }
      ]
    },
    "hin": {
      "preferred_label": "घिनौनी वस्तु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कोई अत्यंत बुरी या घृणित वस्तु, प्रायः कोई झूठा देवता या मूरत।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe arụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe jọgburu onwe ya maọbụ ihe a kpọrọ asị, nke na-abụkarị chi ụgha maọbụ arụsị."
        }
      ]
    },
    "nep": {
      "preferred_label": "घृणित थोक",
      "descriptions": [
        {
          "source": "acai",
          "description": "धेरै नराम्रो वा घृणित थोक, विशेष गरी झूटो देवता वा मूर्ति।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Мерзость",
      "descriptions": [
        {
          "source": "acai",
          "description": "Нечто крайне отвратительное или ненавистное, часто ложный бог или идол."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kitu cha kuchukiza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu kibaya sana au chenye kuchukiwa, mara nyingi mungu wa uongo au sanamu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "samting nogut tru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting i nogut tru o ol manmeri i heitim tumas, planti taim em giaman god o trausel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Điều đáng ghê tởm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một điều rất xấu xa hoặc bị ghê ghét, thường là một thần giả hoặc thần tượng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "可憎之物",
      "descriptions": [
        {
          "source": "acai",
          "description": "极恶劣或令人厌恶的事物，通常指假神或偶像。"
        }
      ]
    },
    "zht": {
      "preferred_label": "可憎之物",
      "descriptions": [
        {
          "source": "acai",
          "description": "極其邪惡或令人憎惡的事物，通常指假神或偶像。"
        }
      ]
    }
  },
