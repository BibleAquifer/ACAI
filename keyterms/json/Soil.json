  ],
  "localizations": {
    "eng": {
      "preferred_label": "To Soil",
      "alternate_labels": [
        "Be Defiled (Pass.)"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To make something dirty or unclean, often in a way that shows disrespect."
        }
      ]
    },
    "spa": {
      "preferred_label": "contaminar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer que algo quede sucio o impuro, a menudo de una manera que muestra falta de respeto."
        }
      ]
    },
    "fra": {
      "preferred_label": "souiller",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rendre une chose sale ou impure, souvent d’une manière qui témoigne d’un manque de respect."
        }
      ]
    },
    "ind": {
      "preferred_label": "menodai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membuat sesuatu menjadi kotor atau najis, sering kali dengan cara yang menunjukkan rasa tidak hormat."
        }
      ]
    },
    "por": {
      "preferred_label": "contaminar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tornar algo sujo ou impuro, muitas vezes de uma forma que demonstra desrespeito."
        }
      ]
    },
    "apd": {
      "preferred_label": "يدنّس",
      "descriptions": [
        {
          "source": "acai",
          "description": "توسيخ الحاجة أو تدنيسها، وغالباً بطريقة بتبيّن قلة احترام."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُلَوِّثُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَنْ يُلَوِّثَ شَيْئًا أَوْ يُنَجِّسَهُ، غَالِبًا بِطَرِيقَةٍ تَدُلُّ عَلَى قِلَّةِ ٱلِٱحْتِرَامِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "mekem i doti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong mekem wan samting i doti no i kam doti, plante taem long wan fasin we i no gat respek."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙazantarwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙazantar da wani abu ko mai da shi marar tsarki, sau da yawa ta hanyar da ke nuna rashin daraja."
        }
      ]
    },
    "hin": {
      "preferred_label": "अपवित्र करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी वस्तु को गंदा या अशुद्ध करना, अक्सर ऐसे तरीके से जिससे अनादर प्रकट होता हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Imerụ unyi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Imerụ ihe ruru unyi ma ọ bụ ihe na-adịghị ọcha, nke na-abụkarị nʼụzọ na-egosi nlelị."
        }
      ]
    },
    "nep": {
      "preferred_label": "अशुद्ध पार्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः अनादर देखाउने गरी कुनै थोकलाई फोहोर वा अशुद्ध बनाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Осквернять",
      "descriptions": [
        {
          "source": "acai",
          "description": "Делать что-либо грязным или нечистым, часто проявляя тем самым неуважение."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutia Unajisi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kufanya kitu kiwe kichafu au najisi, mara nyingi kwa namna inayoonyesha utovu wa heshima."
        }
      ]
    },
    "tpi": {
      "preferred_label": "mekim i kamap doti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim wanpela samting i kamap doti o i no klin, planti taim long pasin i soim olsem man i no rispektim dispela samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Làm ô uế",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm cho vật gì đó trở nên bẩn thỉu hoặc ô uế, thường theo cách thể hiện sự bất kính."
        }
      ]
    },
    "zhs": {
      "preferred_label": "玷污",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某物变得肮脏或不洁，通常带有不敬的意味。"
        }
      ]
    },
    "zht": {
      "preferred_label": "玷污",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某物變髒或不潔，通常帶有不敬的意味。"
        }
      ]
    }
  },
