{
  "id": "keyterm:Stubborn",
  "primary_id": "keyterm:Stubborn",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "006617001010000",
    "006617001008000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Stubborn (Rebellious)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Refusing to obey or change, like someone who holds their head stiff and will not listen."
        }
      ]
    },
    "spa": {
      "preferred_label": "terco (rebelde)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Negarse a obedecer o a cambiar, como alguien que mantiene la cerviz tiesa y no quiere escuchar."
        }
      ]
    },
    "fra": {
      "preferred_label": "obstiné (rebelle)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Refus d'obéir ou de changer, à la manière de quelqu'un qui raidit son cou et refuse d'écouter."
        }
      ]
    },
    "ind": {
      "preferred_label": "tegar tengkuk (pemberontak)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menolak untuk taat atau berubah, seperti orang yang menegarkan kepalanya dan tidak mau mendengar."
        }
      ]
    },
    "por": {
      "preferred_label": "obstinado (rebelde)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recusar-se a obedecer ou a mudar, como alguém que mantém a cerviz dura e não quer ouvir."
        }
      ]
    },
    "apd": {
      "preferred_label": "عنيد (متمرد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "رفض الطاعة أو التغيير، زي الزول الراسو ناشف وما بيسمع الكلام."
        }
      ]
    },
    "arb": {
      "preferred_label": "عنيد (متمرد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "رفض الطاعة أو التغيير، كشخص يقسي رقبته ولا يريد أن يسمع."
        }
      ]
    },
    "bis": {
      "preferred_label": "stronghed (rebelians)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong no wantem obei no jenisim fasin, olsem wan man we i mekem hed blong hem i strong mo i no wantem lesin."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai taurinkai (Mai tawaye)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙin yin biyayya ko canjawa, kamar wanda yake da taurin kai kuma ba zai saurara ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "हठीला (विद्रोही)",
      "descriptions": [
        {
          "source": "acai",
          "description": "आज्ञा मानने या बदलने से इनकार करना, जैसे कोई व्यक्ति अपनी गर्दन अकड़ाकर रखे और सुनने को तैयार न हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Isiike (Inupu isi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịjụ irube isi ma ọ bụ ịgbanwe omume, dịka onye gbasiri olu ya ike nke na-achọghị ịnụ ihe."
        }
      ]
    },
    "nep": {
      "preferred_label": "हठी (विद्रोही)",
      "descriptions": [
        {
          "source": "acai",
          "description": "आज्ञा मान्‍न वा परिवर्तन हुन इन्कार गर्ने, जसरी कसैले आफ्नो गर्दन कडा पारेर सुन्‍न मान्दैन।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Упрямый (мятежный)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отказ повиноваться или меняться, подобно тому, кто упрямо держит голову и не желает слушать."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ukaidi (Uasi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kukataa kutii au kubadilika, kama mtu anayeshupaza shingo yake na asiyetaka kusikiliza."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Bikhet (Sakim tok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong bikhet na sakim tok, olsem man i mekim het bilong en i pas strong na em i no laik harim tok."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cứng đầu (Ương ngạnh)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Từ chối vâng lời hoặc thay đổi, giống như một người cứng đầu cứng cổ không chịu lắng nghe."
        }
      ]
    },
    "zhs": {
      "preferred_label": "顽固 (叛逆)",
      "descriptions": [
        {
          "source": "acai",
          "description": "拒绝顺服或改变，就像一个人硬着颈项不肯听从。"
        }
      ]
    },
    "zht": {
      "preferred_label": "頑梗（悖逆）",
      "descriptions": [
        {
          "source": "acai",
          "description": "拒絕順從或改變，就像有人硬著頸項不肯聽從一樣。"
        }
      ]
    }
  },
