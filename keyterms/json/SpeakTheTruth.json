  "localizations": {
    "eng": {
      "preferred_label": "Speak the Truth",
      "alternate_labels": [
        "Hold to the Truth"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To say what is real and honest without lying or hiding facts."
        }
      ]
    },
    "spa": {
      "preferred_label": "decir la verdad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Decir lo que es real y sincero sin mentir ni ocultar hechos."
        }
      ]
    },
    "fra": {
      "preferred_label": "dire la vérité",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dire ce qui est réel et honnête, sans mentir ni dissimuler les faits."
        }
      ]
    },
    "ind": {
      "preferred_label": "mengatakan kebenaran",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengatakan apa yang nyata dan jujur tanpa berbohong atau menyembunyikan fakta."
        }
      ]
    },
    "por": {
      "preferred_label": "falar a verdade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dizer o que é real e sincero sem mentir ou esconder fatos."
        }
      ]
    },
    "apd": {
      "preferred_label": "يقول الحق",
      "descriptions": [
        {
          "source": "acai",
          "description": "قول الحقيقة والأمانة من غير كذب أو دس للحقيقة."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَتَكَلَّمُ بِٱلْحَقِّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَنْ يَقُولَ ٱلْمَرْءُ ٱلْحَقِيقَةَ بِصِدْقٍ وَأَمَانَةٍ دُونَ كَذِبٍ أَوْ إِخْفَاءِ ٱلْوَقَائِعِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "talem trutok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong talem samting we i tru mo stret we man i no giaman no haedem samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "Faɗin gaskiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faɗin abin da yake na gaskiya da sahihanci ba tare da yin ƙarya ko ɓoye gaskiya ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "सच बोलना",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिना झूठ बोले या तथ्यों को छिपाए जो वास्तविक और सच्चा है उसे कहना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikwu eziokwu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ikwu ihe bụ eziokwu na ihe na-eme eme nʼekwughị okwu ụgha ma ọ bụ izo eziokwu."
        }
      ]
    },
    "nep": {
      "preferred_label": "सत्य बोल्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "झूट नबोली वा तथ्यहरू नलुकाई वास्तविक र इमानदार कुरा बोल्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Говорить истину",
      "descriptions": [
        {
          "source": "acai",
          "description": "Говорить то, что истинно и честно, без лжи и утаивания фактов."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kusema Kweli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kusema yaliyo ya kweli na ya uaminifu bila kusema uongo au kuficha ukweli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "toktru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Autim tok i tru na stret, na i no giaman o haitim ol samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Nói sự thật",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nói điều chân thật và ngay thẳng mà không nói dối hay che giấu sự thật."
        }
      ]
    },
    "zhs": {
      "preferred_label": "说实话",
      "descriptions": [
        {
          "source": "acai",
          "description": "说出真实且诚实的话，不撒谎也不隐瞒事实。"
        }
      ]
    },
    "zht": {
      "preferred_label": "說實話",
      "descriptions": [
        {
          "source": "acai",
          "description": "講述真實而誠實的話，不說謊也不隱瞞事實。"
        }
      ]
    }
  },
