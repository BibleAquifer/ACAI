  "localizations": {
    "eng": {
      "preferred_label": "Make Alive",
      "alternate_labels": [
        "Give Life"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To bring someone or something to life or keep them living."
        }
      ]
    },
    "spa": {
      "preferred_label": "dar vida",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dar vida a alguien o algo, o mantenerlo con vida."
        }
      ]
    },
    "fra": {
      "preferred_label": "rendre à la vie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Donner la vie à quelqu'un ou à quelque chose, ou le maintenir en vie."
        }
      ]
    },
    "ind": {
      "preferred_label": "menghidupkan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menghidupkan seseorang atau sesuatu atau memelihara mereka tetap hidup."
        }
      ]
    },
    "por": {
      "preferred_label": "dar vida",
      "descriptions": [
        {
          "source": "acai",
          "description": "Trazer alguém ou algo à vida ou mantê-los vivos."
        }
      ]
    },
    "apd": {
      "preferred_label": "إحياء",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنك تدي زول أو شي حياة، أو تحافظ على حياته."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُحْيِي",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَن يَبُثَّ الحَياةَ في شَخصٍ أَو شَيءٍ أَو يُبقِيَهُ حَيًّا."
        }
      ]
    },
    "bis": {
      "preferred_label": "mekem i laef",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem wan man o wan samting i laef o kipim hem i stap laef."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ba da rai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rayar da wani ko wani abu ko kuma kiyaye shi a raye."
        }
      ]
    },
    "hin": {
      "preferred_label": "जिलाना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति या वस्तु को जीवित करना या उन्हें जीवित रखना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ime ka ọ dị ndụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka mmadụ ma ọ bụ ihe dịrị ndụ ma ọ bụ mee ka ha nọgide na-adị ndụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "जीवित पार्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैलाई वा कुनै थोकलाई जीवनमा ल्याउनु वा तिनीहरूलाई जीवित राख्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "оживлять",
      "descriptions": [
        {
          "source": "acai",
          "description": "Возвращать кого-либо или что-либо к жизни или сохранять их живыми."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuhuisha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumfanya mtu au kitu kuwa hai, au kudumisha uzima wao."
        }
      ]
    },
    "tpi": {
      "preferred_label": "givim laip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Givim laip long wanpela manmeri o samting o mekim ol i stap laip."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ban sự sống",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ban sự sống cho ai đó hoặc vật gì đó, hay gìn giữ cho họ tiếp tục sống."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赐生命",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某人或某物获得生命，或使其存活。"
        }
      ]
    },
    "zht": {
      "preferred_label": "使之活著",
      "descriptions": [
        {
          "source": "acai",
          "description": "使某人或某物得著生命，或使之存活。"
        }
      ]
    }
  },
