{
  "id": "keyterm:Baptism",
  "primary_id": "keyterm:Baptism",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdgnt": [
    "53.41",
    "53.49",
    "24.82",
    "53.31"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Baptism",
      "descriptions": [
        {
          "source": "acai",
          "description": "A ceremony where water is used to show that a person is clean from sin and has started a new life following God."
        }
      ]
    },
    "spa": {
      "preferred_label": "bautismo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ceremonia en la que se usa agua para mostrar que una persona está limpia de pecado y ha comenzado una nueva vida siguiendo a Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "baptême",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cérémonie où l’eau est utilisée pour signifier qu’une personne est purifiée du péché et a commencé une nouvelle vie en suivant Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "baptisan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Upacara di mana air digunakan untuk menunjukkan bahwa seseorang telah bersih dari dosa dan telah memulai hidup baru mengikut Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "batismo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cerimônia em que a água é usada para mostrar que uma pessoa está purificada do pecado e iniciou uma nova vida seguindo a Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "معمودية",
      "descriptions": [
        {
          "source": "acai",
          "description": "طقس ديني بيستعملوا فيه الموية عشان يبينوا إنو الزول اتطهر من الخطية وبدأ حياة جديدة في اتباع الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَعْمُودِيَّة",
      "descriptions": [
        {
          "source": "acai",
          "description": "طقس يُستخدم فيه الماء لإظهار أن الشخص قد تطهر من الخطية وبدأ حياة جديدة في اتباع الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Baptaes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan lafet o kastom we oli yusum wota blong soemaot se wan man i klin long sin mo i statem wan niufala laef blong folem God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Baftisma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani biki na addini inda ake amfani da ruwa don nuna cewa mutum ya tsarkaka daga zunubi kuma ya soma sabuwar rayuwa ta bin Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "बपतिस्मा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक विधि जिसमें पानी का उपयोग यह दर्शाने के लिए किया जाता है कि व्यक्ति पाप से शुद्ध हो गया है और उसने परमेश्वर के पीछे चलने का एक नया जीवन आरंभ किया है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Baptizim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Emume ebe a na-eji mmiri egosi na mmadụ dị ọcha site na mmehie ma bido ndụ ọhụrụ nʼiso Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "बप्तिस्मा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक संस्कार जसमा कुनै व्यक्ति पापबाट शुद्ध भएको छ र परमेश्वरको पछि लागेर नयाँ जीवन सुरु गरेको छ भनी देखाउन पानीको प्रयोग गरिन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Крещение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Обряд, в котором используется вода в знак очищения человека от греха и начала новой жизни в послушании Богу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ubatizo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ibada au sherehe ambapo maji hutumiwa kuonyesha kwamba mtu ametakaswa kutoka dhambini na ameanza maisha mapya ya kumfuata Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "baptais",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela pasin bilong lotu we ol i yusim wara bilong soim olsem wanpela manmeri i klin pinis long sin na i kirapim nupela laip bilong bihainim God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Phép báp-tem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nghi lễ dùng nước để bày tỏ một người được tẩy sạch tội lỗi và bắt đầu đời sống mới bước theo Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "洗礼",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种仪式，用水表明一个人脱离了罪恶并开始过跟从上帝的新生活。"
        }
      ]
    },
    "zht": {
      "preferred_label": "洗禮",
      "descriptions": [
        {
          "source": "acai",
          "description": "用水表明一個人脫離罪惡、得著潔淨，並開始跟隨上帝過新生活的儀式。"
        }
      ]
    }
  },
  "referred_to_as": [
    "keyterm:Baptize",
    "keyterm:Washing"
  ],
