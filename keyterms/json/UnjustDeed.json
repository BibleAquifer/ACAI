  "localizations": {
    "eng": {
      "preferred_label": "Unjust Deed",
      "alternate_labels": [
        "Unrighteousness",
        "Doing What Is Unjust"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "An action that is unfair, wrong, or against what is right."
        }
      ]
    },
    "spa": {
      "preferred_label": "injusticia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Acción injusta, equivocada o contraria a lo recto."
        }
      ]
    },
    "fra": {
      "preferred_label": "injustice",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une action injuste, mauvaise ou contraire à ce qui est droit."
        }
      ]
    },
    "ind": {
      "preferred_label": "kelaliman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tindakan yang tidak adil, salah, atau bertentangan dengan apa yang benar."
        }
      ]
    },
    "por": {
      "preferred_label": "injustiça",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma ação que é injusta, errada ou contrária ao que é correto."
        }
      ]
    },
    "apd": {
      "preferred_label": "عمل ظالم",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل ما عادل، غلط، أو ضد الصاح."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَمَلٌ ظَالِم",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل غير عادل أو باطل أو مخالف لما هو حق وصواب."
        }
      ]
    },
    "bis": {
      "preferred_label": "rabis aksen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan aksen we i no fea, i rong, o i agensem samting we i stret."
        }
      ]
    },
    "hau": {
      "preferred_label": "aikin rashin adalci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aikin da bai dace ba, ba daidai ba ne, ko kuma ya saɓa wa abin da yake daidai."
        }
      ]
    },
    "hin": {
      "preferred_label": "अधर्म का काम",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक ऐसा कार्य जो अनुचित, गलत या जो सही है उसके विरुद्ध हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ajọ omume",
      "descriptions": [
        {
          "source": "acai",
          "description": "Omume nke na-ezighị ezi, jọrọ njọ, ma ọ bụ megidere ihe ziri ezi."
        }
      ]
    },
    "nep": {
      "preferred_label": "अन्यायपूर्ण काम",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै अनुचित, गलत वा ठीक कुराको विरुद्धमा भएको काम।"
        }
      ]
    },
    "rus": {
      "preferred_label": "неправедный поступок",
      "descriptions": [
        {
          "source": "acai",
          "description": "Поступок, который является несправедливым, дурным или противоречащим тому, что правильно."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tendo lisilo la haki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitendo kisicho cha haki, kibaya, au kinyume na yaliyo sawa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin i no stret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pasin o samting man i mekim we i no fea, i kranki, o i go agensim pasin i stret."
        }
      ]
    },
    "vie": {
      "preferred_label": "hành vi bất công",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một hành động không công bằng, sai trái hoặc đi ngược lại điều đúng đắn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "不义之举",
      "descriptions": [
        {
          "source": "acai",
          "description": "不公平、错误或违背正道的事端或行为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "不公之舉",
      "descriptions": [
        {
          "source": "acai",
          "description": "不公、錯誤或違背正義的行為。"
        }
      ]
    }
  },
