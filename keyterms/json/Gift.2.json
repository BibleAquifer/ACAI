{
  "id": "keyterm:Gift.2",
  "primary_id": "keyterm:Favor",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "57.103"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Gift (Spiritual)",
      "alternate_labels": [
        "Free Gift"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Something given freely without expecting anything back, especially from God."
        }
      ]
    },
    "spa": {
      "preferred_label": "don (espiritual)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo dado libremente sin esperar nada a cambio, especialmente de parte de Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "don (spirituel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ce qui est accordé gratuitement sans rien attendre en retour, en particulier de la part de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "karunia (rohani)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sesuatu yang diberikan secara cuma-cuma tanpa mengharapkan balasan apa pun, terutama dari Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "dom (espiritual)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo dado gratuitamente sem esperar nada em troca, especialmente da parte de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "موهبة (روحية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة بتتعطى مجاناً من غير توقع أي مقابل، خاصة من الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "هِبَة (رُوحِيَّة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "شيء يُعطى مجانًا دون توقع أي مقابل، لا سيما من الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "presen (blong spirit)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we man i givim fri nomo we i no stap lukaot blong karem samting bakegen, speseli we i kamaot long God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kyauta (Na Ruhu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da aka bayar kyauta ba tare da tsammanin samun wani abu ba, musamman daga wurin Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "वरदान (आत्मिक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिना किसी बदले की आशा के सेंतमेंत दी गई वस्तु, विशेषकर परमेश्वर की ओर से।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onyinye (Nke Mmụọ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe e nyere nʼefu na-enweghị atụmanya nke ịnata ihe ọ bụla na nloghachi, karịsịa nke sitere na Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "वरदान (आत्मिक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "केही फिर्ता पाउने आशा नराखी सित्तैँमा दिइएको थोक, विशेष गरी परमेश्‍वरबाट।"
        }
      ]
    },
    "rus": {
      "preferred_label": "дар (духовный)",
      "descriptions": [
        {
          "source": "acai",
          "description": "То, что дается даром без ожидания чего-либо взамен, особенно от Бога."
        }
      ]
    },
    "swh": {
      "preferred_label": "Karama (ya Kiroho)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu kinachotolewa bure bila kutarajia malipo yoyote, hasa kutoka kwa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Presen (bilong spirit)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting ol i givim nating na i no bilong bekim pe, moa yet dispela i kam long God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ân tứ (Thuộc linh)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Điều gì đó được ban tặng nhưng không đòi hỏi đáp lại, đặc biệt là từ Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "恩赐 (属灵)",
      "descriptions": [
        {
          "source": "acai",
          "description": "白白赐下且不求回报的事物，尤指来自上帝的恩赐。"
        }
      ]
    },
    "zht": {
      "preferred_label": "恩賜 (屬靈)",
      "descriptions": [
        {
          "source": "acai",
          "description": "白白賜予而不求回報的事物，尤指來自上帝的賜予。"
        }
      ]
    }
  },
