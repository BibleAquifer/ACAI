  "localizations": {
    "eng": {
      "preferred_label": "Forgiveness (Remove Guilt)",
      "descriptions": [
        {
          "source": "acai",
          "description": "When God or someone else takes away the blame for doing wrong."
        }
      ]
    },
    "spa": {
      "preferred_label": "perdón (quitar la culpa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cuando Dios u otra persona quita la culpa por haber actuado mal."
        }
      ]
    },
    "fra": {
      "preferred_label": "pardon (ôter la culpabilité)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lorsque Dieu ou quelqu'un d'autre ôte la faute pour une mauvaise action."
        }
      ]
    },
    "ind": {
      "preferred_label": "pengampunan (menghapuskan rasa bersalah)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ketika Allah atau orang lain meniadakan kesalahan karena berbuat salah."
        }
      ]
    },
    "por": {
      "preferred_label": "perdão (remover a culpa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quando Deus ou outra pessoa tira a culpa por se ter feito algo de errado."
        }
      ]
    },
    "apd": {
      "preferred_label": "غفران (رفع الذنب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "لما الله أو أي زول تاني يرفع اللوم عن عمل الغلط."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَغْفِرَة (إزالة الذنب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حين يرفع الله أو شخص آخر اللوم عن ارتكاب الخطأ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong fogivim (Tekemaot Sin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taem God no wan narafala man i tekemaot blemaot from mekem wan rong samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gafara (Ɗauke Laifi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sa’ad da Allah ko wani ya ɗauke laifi na yin abin da ba daidai ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "क्षमा (दोष दूर करना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "जब परमेश्वर या कोई अन्य व्यक्ति गलत काम करने का दोष हटा देता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mgbaghara (Wepụ Ikpe Ọmụma)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mgbe Chineke ma ọ bụ onye ọzọ na-ewepụ ebubo ma ọ bụ ikpe ọmụma nke ime ihe ọjọọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "क्षमा (दोष हटाउनु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "जब परमेश्‍वर वा अरू कसैले गलत काम गरेको दोष हटाइदिनुहुन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Прощение (снятие вины)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Когда Бог или кто-либо другой снимает вину за совершенный проступок."
        }
      ]
    },
    "swh": {
      "preferred_label": "Msamaha (Kuondoa Hatia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wakati Mungu au mtu mwingine anapoondoa lawama ya kutenda maovu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong lusim rong (Tekewe bel hevi bilong rong)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taim God o narapela manmeri i tekewe asua bilong mekim rong."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự tha thứ (Xóa bỏ tội lỗi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Khi Đức Chúa Trời hoặc một người nào đó cất bỏ trách nhiệm hay sự định tội cho hành vi sai trái."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赦免（除去罪咎）",
      "descriptions": [
        {
          "source": "acai",
          "description": "神或他人除去做错事所招致的责罚。"
        }
      ]
    },
    "zht": {
      "preferred_label": "赦免（免除罪疚）",
      "descriptions": [
        {
          "source": "acai",
          "description": "指上帝或其他人免除人犯錯的責任或罪名。"
        }
      ]
    }
  },
