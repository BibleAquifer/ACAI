{
  "id": "keyterm:FeelSympathy",
  "primary_id": "keyterm:Affection",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "25.49"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Feel Sympathy",
      "alternate_labels": [
        "Feel Compassion"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To care deeply and feel kindness toward someone who is suffering or in need."
        }
      ]
    },
    "spa": {
      "preferred_label": "tener compasión",
      "descriptions": [
        {
          "source": "acai",
          "description": "Preocuparse profundamente y sentir bondad hacia alguien que está sufriendo o pasando necesidad."
        }
      ]
    },
    "fra": {
      "preferred_label": "être ému de compassion",
      "descriptions": [
        {
          "source": "acai",
          "description": "Se soucier profondément et faire preuve de bonté envers une personne qui souffre ou qui est dans le besoin."
        }
      ]
    },
    "ind": {
      "preferred_label": "tergerak oleh belas kasihan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sangat peduli dan berbelas kasihan kepada seseorang yang sedang menderita atau berkekurangan."
        }
      ]
    },
    "por": {
      "preferred_label": "compadecer-se",
      "descriptions": [
        {
          "source": "acai",
          "description": "Preocupar-se profundamente e sentir bondade por alguém que está sofrendo ou em necessidade."
        }
      ]
    },
    "apd": {
      "preferred_label": "يشفق",
      "descriptions": [
        {
          "source": "acai",
          "description": "الاهتمام الشديد والشعور بالعطف والرحمة تجاه زول متألم أو محتاج."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَحَنَّنَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "أن يهتم المرء بعمق ويشعر بالرأفة تجاه شخص يعاني أو في عوز."
        }
      ]
    },
    "bis": {
      "preferred_label": "sore",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong kea we i godaon dip mo filing blong kaen fasin i go long wan man we i stap harem nogud no stap long nid."
        }
      ]
    },
    "hau": {
      "preferred_label": "Jin tausayi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kula sosai da kuma jin ƙai ko tausayi ga wanda yake shan wahala ko yake cikin bukata."
        }
      ]
    },
    "hin": {
      "preferred_label": "तरस खाना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी पीड़ित या जरूरतमंद व्यक्ति की गहराई से परवाह करना और उसके प्रति दया या तरस महसूस करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Inwe ọmịiko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe nchegbu miri emi na inwe obiọma nʼebe onye na-ata ahụhụ maọbụ nọ na mkpa nọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "टिठ्याउनु / दया देखाउनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै दुःखी वा खाँचोमा परेको व्यक्तिप्रति गहिरो चासो राख्‍नु र दया देखाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "сострадать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Глубоко заботиться и проявлять доброту к тому, кто страдает или находится в нужде."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuhurumia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kujali sana na kuwa na wema kwa mtu anayeteseka au mwenye uhitaji."
        }
      ]
    },
    "tpi": {
      "preferred_label": "sori tru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long wari na sori tru long wanpela man i karim hevi o i stap rabis, na mekim gutpela pasin long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Động lòng thương xót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quan tâm sâu sắc và cảm thấy nhân từ đối với một người đang chịu đau khổ hoặc cần sự giúp đỡ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "怜悯",
      "descriptions": [
        {
          "source": "acai",
          "description": "对受苦或身处困境之人深切关怀并心存仁慈。"
        }
      ]
    },
    "zht": {
      "preferred_label": "憐憫",
      "descriptions": [
        {
          "source": "acai",
          "description": "對受苦或有需要的人深切關懷並心存仁慈。"
        }
      ]
    }
  },
  "referred_to_as": [
