{
  "id": "keyterm:Shield",
  "primary_id": "keyterm:Shield",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "003700001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Shield",
      "alternate_labels": [
        "Protector"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Something that protects you from harm, like how God keeps you safe."
        }
      ]
    },
    "fra": {
      "preferred_label": "bouclier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quelque chose qui protège du danger, à la manière dont Dieu assure la sécurité."
        }
      ]
    },
    "ind": {
      "preferred_label": "perisai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sesuatu yang melindungi seseorang dari bahaya, seperti cara Allah menjaga seseorang tetap aman."
        }
      ]
    },
    "apd": {
      "preferred_label": "ترس",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة بتحميك من الأذى، زي ما الله بيحفظك في أمان."
        }
      ]
    },
    "arb": {
      "preferred_label": "تُرْس",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَيءٌ يَحمِيكَ مِنَ الأَذَى، كَمَا يَحفَظُكَ اللهُ آمِنًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "shild",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we i stap blokem yu long trabol, olsem we God i stap lukaot gud long yu mo blokem yu."
        }
      ]
    },
    "hau": {
      "preferred_label": "Garkuwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da yake kāre ka daga lahani, kamar yadda Allah yake kiyaye ka lafiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "ढाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऐसी कोई वस्तु जो आपको हानि से बचाती है, जैसे परमेश्वर आपको सुरक्षित रखता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe na-echebe mmadụ pụọ nʼihe ọghọm, dịka otú Chineke si echekwa gị nʼudo."
        }
      ]
    },
    "nep": {
      "preferred_label": "ढाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "हानिबाट रक्षा गर्ने कुनै कुरा, जसरी परमेश्‍वरले तपाईंलाई सुरक्षित राख्‍नुहुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "escudo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo que protege contra o mal, como a forma em que Deus mantém você seguro."
        }
      ]
    },
    "rus": {
      "preferred_label": "Щит",
      "descriptions": [
        {
          "source": "acai",
          "description": "То, что защищает от вреда, подобно тому как Бог хранит вас в безопасности."
        }
      ]
    },
    "spa": {
      "preferred_label": "escudo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Algo que te protege del daño, como la manera en que Dios te mantiene a salvo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ngao",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu kinachokulinda na madhara, kama vile Mungu anavyokuweka salama."
        }
      ]
    },
    "tpi": {
      "preferred_label": "hap plang bilong pait",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting bilong banisim na haitim man long hevi o bagarap, olsem God i save lukautim gut manmeri bilong en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tấm khiên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vật bảo vệ bạn khỏi bị tổn hại, giống như cách Đức Chúa Trời gìn giữ bạn được an toàn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "盾牌",
      "descriptions": [
        {
          "source": "acai",
          "description": "保护人免受伤害的事物，就像上帝保守你的安全一样。"
        }
      ]
    },
    "zht": {
      "preferred_label": "盾牌",
      "descriptions": [
        {
          "source": "acai",
          "description": "保護人免受傷害的事物，正如上帝保守你的安全一樣。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
