      "preferred_label": "Vision",
      "descriptions": [
        {
          "source": "acai",
          "description": "A supernatural experience where a person sees a message from God or a future event."
        }
      ]
    },
    "spa": {
      "preferred_label": "visión",
      "descriptions": [
        {
          "source": "acai",
          "description": "Experiencia sobrenatural en la que una persona ve un mensaje de Dios o un acontecimiento futuro."
        }
      ]
    },
    "fra": {
      "preferred_label": "vision",
      "descriptions": [
        {
          "source": "acai",
          "description": "Expérience surnaturelle par laquelle une personne reçoit un message visuel de Dieu ou voit un événement futur."
        }
      ]
    },
    "ind": {
      "preferred_label": "penglihatan",
      "descriptions": [
        {
