          "description": "Pengalaman adikodrati ketika seseorang melihat pesan dari Allah atau peristiwa masa depan."
        }
      ]
    },
    "por": {
      "preferred_label": "visão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma experiência sobrenatural na qual uma pessoa vê uma mensagem de Deus ou um acontecimento futuro."
        }
      ]
    },
    "apd": {
      "preferred_label": "رؤيا",
      "descriptions": [
        {
          "source": "acai",
          "description": "اختبار فائق للطبيعة بيشوف فيهو الزول رسالة من الله أو حدث مستقبلي."
        }
      ]
    },
    "arb": {
      "preferred_label": "رُؤْيَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "اختبار فائق للطبيعة يرى فيه الشخص رسالة من الله أو حدثًا مستقبليًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "vison",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we i kam long paoa blong God we wan man i luk wan mesej we i kam long God no wan samting we bambae i hapen long fiuja."
        }
      ]
    },
    "hau": {
      "preferred_label": "Wahayi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gamuwa da abin banmamaki inda mutum yake ganin saƙo daga Allah ko kuma wani abu da zai faru a gaba."
        }
      ]
    },
    "hin": {
      "preferred_label": "दर्शन",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अलौकिक अनुभव जिसमें कोई व्यक्ति परमेश्वर की ओर से कोई संदेश या भविष्य की घटना देखता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọhụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ahụmịhe nke mmụọ ebe mmadụ na-ahụ ozi si nʼaka Chineke ma ọ bụ ihe ga-eme nʼọdịnihu."
        }
      ]
    },
    "nep": {
      "preferred_label": "दर्शन",
      "descriptions": [
        {
          "source": "acai",
          "description": "एउटा अलौकिक अनुभव जसमा कुनै व्यक्तिले परमेश्‍वरबाट आएको सन्देश वा भविष्यको घटना देख्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Видение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сверхъестественное переживание, в котором человек видит весть от Бога или будущее событие."
        }
      ]
    },
    "swh": {
      "preferred_label": "Maono",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uzoefu usio wa kawaida ambapo mtu huona ujumbe kutoka kwa Mungu au tukio la baadaye."
        }
      ]
    },
    "tpi": {
      "preferred_label": "samting olsem driman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ekspiriens bilong heven we wanpela man i lukim wanpela tok o samting bai kamap bihain, em God i soim em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Khải tượng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Trải nghiệm siêu nhiên trong đó một người nhìn thấy sứ điệp từ Đức Chúa Trời hoặc một sự kiện trong tương lai."
        }
      ]
    },
    "zhs": {
      "preferred_label": "异象",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种超自然的经历，人借此看到来自上帝的信息或未来的事件。"
        }
      ]
    },
    "zht": {
      "preferred_label": "異象",
      "descriptions": [
        {
          "source": "acai",
          "description": "人看見來自上帝的信息或未來事件的超自然經歷。"
        }
      ]
    }
  },
