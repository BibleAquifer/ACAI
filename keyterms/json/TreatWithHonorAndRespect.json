  "localizations": {
    "eng": {
      "preferred_label": "Treat With Honor and Respect",
      "descriptions": [
        {
          "source": "acai",
          "description": "To show kindness and value to someone by acting with care and respect."
        }
      ]
    },
    "spa": {
      "preferred_label": "honrar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mostrar bondad y estima hacia alguien actuando con cuidado y respeto."
        }
      ]
    },
    "fra": {
      "preferred_label": "honorer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Manifester de la bonté et de la valeur envers quelqu'un en agissant avec égards et respect."
        }
      ]
    },
    "ind": {
      "preferred_label": "menghormati",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menunjukkan kebaikan dan penghargaan kepada seseorang dengan bersikap penuh perhatian dan rasa hormat."
        }
      ]
    },
    "por": {
      "preferred_label": "tratar com honra e respeito",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mostrar bondade e valorizar alguém, agindo com cuidado e respeito."
        }
      ]
    },
    "apd": {
      "preferred_label": "إكرام واحترام",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار اللطف والتقدير للزول بالمعاملة باهتمام واحترام."
        }
      ]
    },
    "arb": {
      "preferred_label": "الإكرام والاحترام",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار اللطف والتقدير لشخص ما من خلال التعامل معه بعناية واحترام."
        }
      ]
    },
    "bis": {
      "preferred_label": "ona long",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong soemaot kaenfala fasin mo tinghae long wan man taem yu kea gud long hem mo ona long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Girmamawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna alheri da daraja ga wani ta hanyar aiki da kulawa da ban girma."
        }
      ]
    },
    "hin": {
      "preferred_label": "आदर और सम्मान करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "सावधानी और सम्मान के साथ व्यवहार करके किसी के प्रति दया और महत्व दिखाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịsọpụrụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosi mmadụ obiọma na ịkwanyere ya ùgwù site nʼime omume nlekọta na nkwanye ùgwù."
        }
      ]
    },
    "nep": {
      "preferred_label": "आदर गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेरचाह र आदरका साथ व्यवहार गरेर कसैप्रति दया र महत्त्व देखाउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Оказывать честь и уважение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявлять доброту и уважение к кому-либо, обращаясь с ним с заботой и почтением."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutendea kwa Heshima",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuonyesha wema na thamani kwa mtu kwa kutenda kwa uangalifu na heshima."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Givim biknem na aninit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong givim biknem na aninit long wanpela manmeri long rot bilong mekim gutpela pasin na lukautim em wantaim rispek."
        }
      ]
    },
    "vie": {
      "preferred_label": "tôn kính",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thể hiện lòng tốt và sự trân trọng đối với ai đó bằng hành động chăm sóc và kính trọng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "尊重与敬重",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过关怀和尊重的行为向某人表达善意与看重。"
        }
      ]
    },
    "zht": {
      "preferred_label": "尊榮與敬重",
      "descriptions": [
        {
          "source": "acai",
          "description": "藉由關懷與敬重的舉動，對某人表達善意並重視其價值。"
        }
      ]
    }
  },
