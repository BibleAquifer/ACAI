      "alternate_labels": [
        "Mighty Work"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "An act of great power that shows God's power and helps people believe."
        }
      ]
    },
    "spa": {
      "preferred_label": "milagro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Acto de gran poder que manifiesta el poder de Dios y ayuda a las personas a creer."
        }
      ]
    },
    "fra": {
      "preferred_label": "miracle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un acte de grande puissance qui démontre la puissance de Dieu et aide les gens à croire."
        }
      ]
    },
    "ind": {
      "preferred_label": "mukjizat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tindakan berkuasa besar yang menunjukkan kuasa Allah dan membantu orang-orang percaya."
        }
      ]
    },
    "por": {
      "preferred_label": "milagre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um ato de grande poder que demonstra o poder de Deus e ajuda as pessoas a crerem."
        }
      ]
    },
    "apd": {
      "preferred_label": "معجزة",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمل بقوة عظيمة بيظهر قدرة الله وبيساعد الناس يؤمنوا."
        }
      ]
    },
    "arb": {
      "preferred_label": "مُعْجِزَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "عَمَلٌ ذُو قُدْرَةٍ عَظِيمَةٍ يُظْهِرُ قُدْرَةَ ٱللهِ وَيُسَاعِدُ ٱلنَّاسَ عَلَى ٱلْإِيمَانِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "merikel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan aksen blong bigfala paoa we i soemaot paoa blong God mo i helpem ol man blong bilif."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mu’ujiza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aiki mai girman iko wanda ke nuna ikon Allah kuma yana taimaka wa mutane su ba da gaskiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "सामर्थ्य का काम",
      "descriptions": [
        {
          "source": "acai",
          "description": "महान सामर्थ्य का एक कार्य जो परमेश्वर की शक्ति को दर्शाता है और लोगों को विश्वास करने में सहायता करता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọrụ ebube",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọrụ nke ike dị ukwuu nke na-egosi ike Chineke ma na-enyere ndị mmadụ aka ikwere."
        }
      ]
    },
    "nep": {
      "preferred_label": "चमत्कार",
      "descriptions": [
        {
          "source": "acai",
          "description": "ठूलो सामर्थ्यको एक काम जसले परमेश्‍वरको शक्ति देखाउँछ र मानिसहरूलाई विश्वास गर्न मद्दत गर्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Чудо",
      "descriptions": [
        {
          "source": "acai",
          "description": "Деяние великой силы, являющее силу Божью и помогающее людям уверовать."
        }
      ]
    },
    "swh": {
      "preferred_label": "Muujiza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tendo la uwezo mkuu linaloonyesha nguvu za Mungu na kuwasaidia watu kuamini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mirakel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela strongpela wok i kamapim klia bikpela strong bilong God na i helpim ol manmeri long bilip."
        }
      ]
    },
    "vie": {
      "preferred_label": "phép lạ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một hành động quyền năng to lớn bày tỏ quyền năng của Đức Chúa Trời và giúp con người tin kính."
        }
      ]
    },
    "zhs": {
      "preferred_label": "神迹",
      "descriptions": [
        {
          "source": "acai",
          "description": "彰显上帝大能并帮助人相信的伟大能力作为。"
        }
      ]
    },
    "zht": {
      "preferred_label": "異能",
      "descriptions": [
        {
          "source": "acai",
          "description": "展現上帝權能並幫助人相信的大能作為。"
        }
      ]
    }
  },
