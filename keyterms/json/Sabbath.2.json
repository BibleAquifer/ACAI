  "localizations": {
    "eng": {
      "preferred_label": "Sabbath (Day of Week)",
      "alternate_labels": [
        "Saturday"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "The seventh day of the week set apart for rest and worship of God."
        }
      ]
    },
    "spa": {
      "preferred_label": "día de reposo (día de la semana)",
      "descriptions": [
        {
          "source": "acai",
          "description": "El séptimo día de la semana apartado para el descanso y la adoración a Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "sabbat (jour de la semaine)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le septième jour de la semaine mis à part pour le repos et le culte de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "sabat (hari dalam seminggu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hari ketujuh dalam seminggu yang dikhususkan untuk beristirahat dan menyembah Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "sábado (dia da semana)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O sétimo dia da semana separado para descanso e adoração a Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "السبت (يوم من الأسبوع)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اليوم السابع من الأسبوع المخصص للراحة وعبادة الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "ٱلسَّبْت (يَوْم مِنَ ٱلْأُسْبُوع)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱلْيَوْمُ ٱلسَّابِعُ مِنَ ٱلْأُسْبُوعِ، ٱلَّذِي فُرِزَ لِلرَّاحَةِ وَعِبَادَةِ اللهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sabat dei (Dei blong wik)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba seven dei blong wik we i stap spesel blong spel mo wosipim God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Asabbaci (Ranar Mako)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rana ta bakwai a mako wadda aka keɓe domin hutu da kuma bauta wa Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "सब्त (सप्ताह का दिन)",
      "descriptions": [
        {
          "source": "acai",
          "description": "सप्ताह का सातवाँ दिन जो विश्राम करने और परमेश्वर की आराधना के लिए अलग रखा गया है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụbọchị Izuike (Ụbọchị nʼIzu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụbọchị nke asaa nʼizu nke e wepụtara maka izu ike na ife Chineke ofufe."
        }
      ]
    },
    "nep": {
      "preferred_label": "शबाथ (हप्ताको दिन)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको विश्राम र आराधनाको निम्ति अलग गरिएको हप्ताको सातौँ दिन।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Суббота (день недели)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Седьмой день недели, отделенный для покоя и поклонения Богу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sabato (Siku ya Juma)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Siku ya saba ya juma iliyotengwa kwa ajili ya kupumzika na kumwabudu Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sabat (De bilong wik)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba 7 de bilong wik em God i makim bilong malolo na lotu long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sa-bát (Ngày trong tuần)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ngày thứ bảy trong tuần được biệt riêng ra để nghỉ ngơi và thờ phượng Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "安息日 (星期的一天)",
      "descriptions": [
        {
          "source": "acai",
          "description": "一周的第七天，分别出来用于休息和敬拜上帝。"
        }
      ]
    },
    "zht": {
      "preferred_label": "安息日（一週之日）",
      "descriptions": [
        {
          "source": "acai",
          "description": "一週中分別出來用以歇息並敬拜上帝的第七日。"
        }
      ]
    }
  },
