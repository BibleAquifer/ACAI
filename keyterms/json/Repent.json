  "localizations": {
    "eng": {
      "preferred_label": "Repent",
      "descriptions": [
        {
          "source": "acai",
          "description": "To change your mind and behavior away from sin and towards living in a right and kind way."
        }
      ]
    },
    "spa": {
      "preferred_label": "arrepentirse",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cambiar de actitud y de conducta, apartándose del pecado y volviéndose hacia una vida recta y bondadosa."
        }
      ]
    },
    "fra": {
      "preferred_label": "se repentir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Changer d'état d'esprit et de comportement en se détournant du péché pour mener une vie juste et bienveillante."
        }
      ]
    },
    "ind": {
      "preferred_label": "bertobat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mengubah pikiran dan perilaku dari dosa menuju kehidupan yang benar dan penuh kebaikan."
        }
      ]
    },
    "por": {
      "preferred_label": "arrepender-se",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mudar de mente e de comportamento, afastando-se do pecado e passando a viver de maneira correta e bondosa."
        }
      ]
    },
    "apd": {
      "preferred_label": "تاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "تغيير التفكير والسلوك بالابتعاد عن الخطيّة والعيش بطريقة صحيحة وطيبة."
        }
      ]
    },
    "arb": {
      "preferred_label": "تاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "تغيير المرء لفكره وسلوكه بعيدًا عن الخطيئة ونحو العيش بطريقة صالحة ولطيفة."
        }
      ]
    },
    "bis": {
      "preferred_label": "tanem tingting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong tanem tingting mo fasin blong yu we i gowe long sin, mo go long wan laef we i stret mo kaen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tuba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sauya tunani da ɗabi’a daga zunubi zuwa rayuwa ta hanyar da ta dace kuma mai kirki."
        }
      ]
    },
    "hin": {
      "preferred_label": "मन फिराना",
      "descriptions": [
        {
          "source": "acai",
          "description": "पाप से विमुख होकर अपने मन और व्यवहार को बदलना तथा सही और भलाई के मार्ग पर जीवन जीना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ichegharị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịgbanwe echiche na omume site nʼime mmehie gaa nʼibi ndụ nʼụzọ ziri ezi ma dị mma."
        }
      ]
    },
    "nep": {
      "preferred_label": "पश्‍चात्ताप गर्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफ्नो मन र आचरणलाई पापबाट हटाएर उचित र असल मार्गमा जिउन परिवर्तन गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Покаяться",
      "descriptions": [
        {
          "source": "acai",
          "description": "Изменить свое мышление и поведение, отвернувшись от греха и обратившись к праведной и доброй жизни."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutubu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kubadili nia na mwenendo wako kwa kuacha dhambi na kuelekea kwenye kuishi kwa njia iliyo sahihi na ya wema."
        }
      ]
    },
    "tpi": {
      "preferred_label": "tanim bel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tanim bel na givim baksait long sin na wokabaut stret na mekim gutpela pasin."
        }
      ]
    },
    "vie": {
      "preferred_label": "ăn năn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thay đổi tâm trí và hành vi, từ bỏ tội lỗi và hướng tới một lối sống ngay thẳng và nhân từ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "悔改",
      "descriptions": [
        {
          "source": "acai",
          "description": "改变自己的心意与行为，远离罪恶，走向正直与仁慈的生活。"
        }
      ]
    },
    "zht": {
      "preferred_label": "悔改",
      "descriptions": [
        {
          "source": "acai",
          "description": "改變心意與行為，離開罪惡，轉向行正道與良善。"
        }
      ]
    }
  },
