      "preferred_label": "भीतर लाना (ले जाना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी वस्तु या व्यक्ति को किसी स्थान या स्थिति में उठाकर या ले जाना।"
        }
      ]
    },
