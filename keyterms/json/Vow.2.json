{
  "id": "keyterm:Vow.2",
  "primary_id": "keyterm:Vow",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "004664001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Vow (Promise)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A serious promise made to God to do something special or important."
        }
      ]
    },
    "spa": {
      "preferred_label": "voto (promesa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Promesa solemne hecha a Dios de hacer algo especial o importante."
        }
      ]
    },
    "fra": {
      "preferred_label": "vœu (promesse)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une promesse solennelle faite à Dieu d'accomplir quelque chose de particulier ou d'important."
        }
      ]
    },
    "ind": {
      "preferred_label": "nazar (janji)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Janji sungguh-sungguh yang diucapkan kepada Allah untuk melakukan sesuatu yang khusus atau penting."
        }
      ]
    },
    "apd": {
      "preferred_label": "نذر (وعد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "وعد جاد بيتقطع مع الله لعمل حاجة خاصة أو مهمة."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَذْر (وَعْد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "وعد جاد يُقطع لله بعمل شيء خاص أو مهم."
        }
      ]
    },
    "bis": {
      "preferred_label": "promes (strong promes)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan strong promes we man i mekem long God blong mekem wan spesel no impoten samting."
        }
      ]
    },
    "hau": {
      "preferred_label": "Alkawari (Wa’adi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alkawari mai tsanani da aka yi wa Allah don yin wani abu na musamman ko mai muhimmanci."
        }
      ]
    },
    "hin": {
      "preferred_label": "मन्नत (प्रतिज्ञा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुछ विशेष या महत्वपूर्ण कार्य करने के लिए परमेश्वर से की गई एक गंभीर प्रतिज्ञा।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nkwa (Nkwa e kwere)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nkwa dị mkpa e kwere Chineke ime ihe pụrụ iche ma ọ bụ dị mkpa."
        }
      ]
    },
    "nep": {
      "preferred_label": "भाकल (प्रतिज्ञा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै विशेष वा महत्त्वपूर्ण काम गर्न परमेश्‍वरसँग गरिएको गम्भीर प्रतिज्ञा।"
        }
      ]
    },
    "por": {
      "preferred_label": "voto (promessa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma promessa solene feita a Deus de realizar algo especial ou importante."
        }
      ]
    },
    "rus": {
      "preferred_label": "Обет (обещание)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Торжественное обещание, данное Богу, совершить нечто особенное или важное."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nadhiri (Ahadi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ahadi nzito anayoweka mtu mbele za Mungu ya kufanya jambo maalum au muhimu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "promis (promis)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela strongpela promis man i mekim long God bilong mekim wanpela bikpela samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lời hứa nguyện (Lời hứa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lời hứa trang trọng với Đức Chúa Trời để làm một điều gì đó đặc biệt hoặc quan trọng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "愿 (诺言)",
      "descriptions": [
        {
          "source": "acai",
          "description": "向上帝所立的庄严承诺，保证去行某件特别或重要的事情。"
        }
      ]
    },
    "zht": {
      "preferred_label": "誓願 (承諾)",
      "descriptions": [
        {
          "source": "acai",
          "description": "向上帝許下要做某件特別或重要之事的嚴肅承諾。"
        }
      ]
    }
  },
