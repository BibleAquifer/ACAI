  ],
  "localizations": {
    "eng": {
      "preferred_label": "Crafty",
      "alternate_labels": [
        "Prudent",
        "Cunning"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Showing cleverness and skill in planning or doing things, often in a tricky way."
        }
      ]
    },
    "spa": {
      "preferred_label": "astuto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Que muestra ingenio y habilidad para planear o hacer cosas, a menudo de forma engañosa o taimada."
        }
      ]
    },
    "fra": {
      "preferred_label": "rusé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait de faire preuve d'habileté et d'ingéniosité pour planifier ou accomplir des choses, souvent de manière trompeuse ou sournoise."
        }
      ]
    },
    "ind": {
      "preferred_label": "cerdik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menunjukkan kepintaran dan keterampilan dalam merencanakan atau melakukan sesuatu, sering kali dengan cara yang licik."
        }
      ]
    },
    "apd": {
      "preferred_label": "مكّار",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار الشطارة والمهارة في التخطيط أو عمل الحاجات، وغالباً بطريقة فيها لؤم أو خباثة."
        }
      ]
    },
    "arb": {
      "preferred_label": "ماكِر",
      "descriptions": [
        {
          "source": "acai",
          "description": "إظهار الدهاء والمهارة في التخطيط أو فعل الأمور، وغالبًا بطريقة ماكرة أو مخادعة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Waes blong wokem trik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong soemaot waes mo skil blong planem no mekem ol samting, we plante taem i stap long fasin blong trik."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai Wayo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nuna wayo da dabara wajen tsarawa ko yin abubuwa, sau da yawa a cikin hanyar maƙarƙashiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "धूर्त",
      "descriptions": [
        {
          "source": "acai",
          "description": "योजना बनाने या काम करने में चतुराई और कौशल दिखाना, जो अक्सर चालबाज़ी भरे तरीके से हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye aghụghọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Igosipụta amamihe na nka nʼịhazi ma ọ bụ ime ihe, ọtụtụ mgbe nʼụzọ aghụghọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "धूर्त",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः छलपूर्ण वा चलाखीपूर्ण तरिकाले कुराहरू योजना वा काम गर्ने कुशलता र चतुरता देखाउने।"
        }
      ]
    },
    "por": {
      "preferred_label": "astuto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Demonstrar inteligência e habilidade no planejamento ou na execução de ações, muitas vezes de maneira ardilosa."
        }
      ]
    },
    "rus": {
      "preferred_label": "хитрый",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявление ума и мастерства в планировании или делах, часто хитрыми или лукавыми путями."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwerevu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuonyesha werevu na ustadi katika kupanga au kufanya mambo, mara nyingi kwa njia ya hila."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Smatpela Trikman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong i stap smat na gat save long plenim o mekim ol samting, planti taim long pasin trik o giaman."
        }
      ]
    },
    "vie": {
      "preferred_label": "Xảo quyệt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thể hiện sự khôn khéo và tài trí trong việc lập kế hoạch hoặc hành động, thường theo cách giảo quyệt."
        }
      ]
    },
    "zhs": {
      "preferred_label": "狡猾",
      "descriptions": [
        {
          "source": "acai",
          "description": "在计划或行事上表现出聪明和技巧，往往带有诡诈的方式。"
        }
      ]
    },
    "zht": {
      "preferred_label": "狡詐",
      "descriptions": [
        {
          "source": "acai",
          "description": "在策劃或行事上展現聰明和技巧，常帶有詭詐的意味。"
        }
      ]
    }
  },
  "referred_to_as": [
