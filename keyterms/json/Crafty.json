{
  "id": "keyterm:Crafty",
  "primary_id": "keyterm:Crafty",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "005662001001000",
    "005679001001000",
    "005677002001000",
