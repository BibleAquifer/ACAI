{
  "id": "keyterm:Proscribe.2",
  "primary_id": "keyterm:Proscribe.2",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "002542001005000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Set Apart for Destruction",
      "alternate_labels": [
        "Kill",
        "Exterminate",
        "Destroy",
        "Proscribe"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To completely destroy towns, people, or animals as a way of dedicating what is left to God's service."
        }
      ]
    },
    "spa": {
      "preferred_label": "destinar a la destrucción",
      "descriptions": [
        {
          "source": "acai",
          "description": "Destruir por completo ciudades, personas o animales como forma de consagrar al servicio de Dios lo que quede."
        }
      ]
    },
    "fra": {
      "preferred_label": "dévouer par interdit à la destruction",
      "descriptions": [
        {
          "source": "acai",
          "description": "Détruire complètement des villes, des personnes ou des animaux afin de consacrer ce qui reste au service de Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "menumpas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membinasakan sama sekali kota-kota, orang-orang, atau hewan sebagai cara mempersembahkan apa yang tersisa bagi pelayanan Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "destruir totalmente",
      "descriptions": [
        {
          "source": "acai",
          "description": "Destruir completamente cidades, pessoas ou animais como forma de dedicar o que resta ao serviço de Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "مخصص للدمار",
      "descriptions": [
        {
          "source": "acai",
          "description": "تدمير كامل للمدن أو الناس أو الحيوانات كطريقة لتكريس الباقي لخدمة الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "التحريم للهلاك",
      "descriptions": [
        {
          "source": "acai",
          "description": "تدمير المدن أو الأشخاص أو الحيوانات تدميرًا كاملًا كوسيلة لتكريس ما تبقى لخدمة الله."
        }
      ]
    },
    "bis": {
      "preferred_label": "makemaot blong spolemgud olgeta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong spolemgud ol taon, ol man, no ol anamol olsem wan wei blong givim wanem we i stap i go long wok blong God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Keɓewa don hallaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hallaka garuruwa, mutane, ko dabbobi ƙaƙaf a matsayin hanyar keɓe abin da ya rage domin hidimar Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "सत्यानाश के लिए अर्पण करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "बचे हुए को परमेश्वर की सेवा के लिए समर्पित करने के तरीके के रूप में नगरों, लोगों या पशुओं को पूरी तरह से नष्ट करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịwepụta iche maka mbibi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ibibi obodo, ndị mmadụ, maọbụ anụmanụ kpamkpam dịka ụzọ isi nyefee ihe fọdụrụ nʼozi Chineke."
        }
      ]
    },
    "nep": {
      "preferred_label": "विनाशको निम्ति अलग गरिएको",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाँकी रहेका कुराहरूलाई परमेश्‍वरको सेवामा समर्पण गर्ने तरिकाको रूपमा सहरहरू, मानिसहरू वा जनावरहरूलाई पूर्ण रूपमा नष्ट गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Предать заклятию на уничтожение",
      "descriptions": [
        {
          "source": "acai",
          "description": "Полностью уничтожать города, людей или животных, тем самым посвящая все оставшееся на служение Богу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutenga kwa Ajili ya Maangamizi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuangamiza kabisa miji, watu, au wanyama kama njia ya kuweka wakfu kile kilichobaki kwa ajili ya utumishi wa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Makim bilong bagarapim olgeta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long bagarapim olgeta ol taun, ol manmeri, o ol animal olsem wanpela rot bilong givim olgeta samting i stap yet i go long wok bilong God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tận diệt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tiêu diệt hoàn toàn các thành phố, con người hoặc loài vật như một cách biệt riêng những gì còn lại cho sự phục vụ Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "完全毁灭",
      "descriptions": [
        {
          "source": "acai",
          "description": "将城镇、人或牲畜彻底毁灭，以此将剩余之物奉献给上帝使用。"
        }
      ]
    },
    "zht": {
      "preferred_label": "滅絕淨盡",
      "descriptions": [
        {
          "source": "acai",
          "description": "徹底毀滅城鎮、人或牲畜，以此將所剩餘的奉獻給上帝使用。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
