  "localizations": {
    "eng": {
      "preferred_label": "Be Enslaved",
      "alternate_labels": [
        "Serve"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To work as a slave or servant for someone, or to be controlled by something."
        }
      ]
    },
    "spa": {
      "preferred_label": "ser esclavo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Trabajar como esclavo o siervo para alguien, o estar dominado por algo."
        }
      ]
    },
    "fra": {
      "preferred_label": "être asservi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Travailler comme esclave ou serviteur pour quelqu'un, ou être sous l'emprise de quelque chose."
        }
      ]
    },
    "ind": {
      "preferred_label": "diperhamba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bekerja sebagai budak atau hamba bagi seseorang, atau dikendalikan oleh sesuatu."
        }
      ]
    },
    "por": {
      "preferred_label": "ser escravizado",
      "alternate_labels": [
        "servir como escravo"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Trabalhar como escravo ou servo para alguém, ou ser controlado por algo."
        }
      ]
    },
    "apd": {
      "preferred_label": "يكون مستعبَد",
      "descriptions": [
        {
          "source": "acai",
          "description": "إنك تشتغل كعبد أو خادم لزول، أو تكون متحكّمة فيك حاجة."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُسْتَعْبَد",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَنْ يَعْمَلَ المَرْءُ عَبْدًا أَوْ خادِمًا لِشَخْصٍ ما، أَوْ أَنْ يَكونَ خاضِعًا لِسَيْطَرَةِ شَيْءٍ ما."
        }
      ]
    },
    "bis": {
      "preferred_label": "stap olsem slef",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem wok olsem wan slef o man blong wok blong wan man, o we wan samting i bos long yu."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zama bawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yin aiki a matsayin bawa ko mai hidima ga wani, ko kuma kasancewa a ƙarƙashin ikon wani abu."
        }
      ]
    },
    "hin": {
      "preferred_label": "दासत्व में होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी के लिए दास या सेवक के रूप में काम करना, या किसी चीज़ के नियंत्रण में होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịbụ ohu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịrụ ọrụ dị ka ohu ma ọ bụ onye na-ejere mmadụ ozi, ma ọ bụ ịbụ ihe na-achịkwa."
        }
      ]
    },
    "nep": {
      "preferred_label": "दास हुनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कसैको निम्ति दास वा सेवकको रूपमा काम गर्नु, वा कुनै कुराको नियन्त्रणमा हुनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Быть в рабстве",
      "descriptions": [
        {
          "source": "acai",
          "description": "Работать в качестве раба или слуги у кого-либо либо находиться под чьей-то властью."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuwa Mtumwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kufanya kazi kama mtumwa au mtumishi wa mtu fulani, au kutawaliwa na kitu fulani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "stap wokboi nating",
      "descriptions": [
        {
          "source": "acai",
          "description": "I stap olsem sleyf o wokboi nating bilong wanpela man, o wanpela samting i bosim man olgeta."
        }
      ]
    },
    "vie": {
      "preferred_label": "Làm nô lệ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm việc như một tôi tớ hoặc nô lệ cho ai đó, hoặc bị kiểm soát bởi điều gì đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "作奴仆",
      "descriptions": [
        {
          "source": "acai",
          "description": "做某人的奴隶或仆人，或受某物辖制。"
        }
      ]
    },
    "zht": {
      "preferred_label": "作奴僕",
      "descriptions": [
        {
          "source": "acai",
          "description": "作為奴隸或僕人為某人做工，或受某事物所控制。"
        }
      ]
    }
  },
