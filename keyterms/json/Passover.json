  "localizations": {
    "eng": {
      "preferred_label": "Passover",
      "alternate_labels": [
        "Passover Sacrifice"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "The special sacrifice made during the Passover festival to remember God's protection of the Israelites in Egypt."
        }
      ]
    },
    "spa": {
      "preferred_label": "Pascua",
      "descriptions": [
        {
          "source": "acai",
          "description": "El sacrificio especial realizado durante la fiesta de la Pascua para recordar la protección de Dios a los israelitas en Egipto."
        }
      ]
    },
    "fra": {
      "preferred_label": "sacrifice de la Pâque",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le sacrifice spécial accompli pendant la fête de la Pâque pour se souvenir de la protection apportée par Dieu aux Israélites en Égypte."
        }
      ]
    },
    "ind": {
      "preferred_label": "Paskah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Korban khusus yang dipersembahkan selama hari raya Paskah untuk mengingat perlindungan Allah atas bangsa Israel di Mesir."
        }
      ]
    },
    "por": {
      "preferred_label": "Páscoa",
      "descriptions": [
        {
          "source": "acai",
          "description": "O sacrifício especial feito durante a festa da Páscoa para lembrar a proteção de Deus aos israelitas no Egito."
        }
      ]
    },
    "apd": {
      "preferred_label": "الفصح",
      "descriptions": [
        {
          "source": "acai",
          "description": "الذبيحة الخاصة البتتقدم في عيد الفصح لتذكّر حماية الله لبني إسرائيل في مصر."
        }
      ]
    },
    "arb": {
      "preferred_label": "فِصْح",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱلذَّبِيحَةُ ٱلْخَاصَّةُ ٱلَّتِي تُقَدَّمُ فِي عِيدِ ٱلْفِصْحِ تَذْكَارًا لِحِمَايَةِ ٱللهِ لِبَنِي إِسْرَائِيلَ فِي مِصْرَ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Pasova",
      "descriptions": [
        {
          "source": "acai",
          "description": "Spesel sakrefaes we oli mekem long lafet blong Pasova blong tingbaot we God i protektem ol laen blong Isrel long Ijip."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙetarewa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hadayar musamman da ake yi a lokacin bikin Ƙetarewa don tunawa da kāriyarta da Allah ya yi wa Isra’ilawa a Masar."
        }
      ]
    },
    "hin": {
      "preferred_label": "फसह",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिस्र में इस्राएलियों की परमेश्वर द्वारा की गई रक्षा को स्मरण करने के लिए फसह के पर्व के दौरान दिया जाने वाला विशेष बलिदान।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ngabiga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Àjà pụrụ iche a chụrụ nʼoge mmemme Ngabiga iji cheta nchebe Chineke chebere ụmụ Izrel nʼIjipt."
        }
      ]
    },
    "nep": {
      "preferred_label": "निस्तार-चाडको बलिदान",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिश्रमा इस्राएलीहरूलाई परमेश्‍वरले गर्नुभएको सुरक्षाको सम्झनामा निस्तार-चाडको समयमा चढाइने विशेष बलिदान।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Пасха (жертва)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особая жертва, приносимая во время праздника Пасхи в память о Божьей защите израильтян в Египте."
        }
      ]
    },
    "swh": {
      "preferred_label": "Pasaka (dhabihu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dhabihu ya pekee iliyotolewa wakati wa sikukuu ya Pasaka ili kukumbuka ulinzi wa Mungu kwa Waisraeli huko Misri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kaikai bilong Pasova",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dispela ofa o kaikai ol i save mekim long Bikpela De Bilong Pasova bilong tingim gutpela lukaut bilong God long ol Israel long Isip."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ Vượt Qua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Của lễ đặc biệt được dâng trong lễ Vượt Qua để tưởng nhớ sự bảo vệ của Đức Chúa Trời dành cho dân Y-sơ-ra-ên tại Ai Cập."
        }
      ]
    },
    "zhs": {
      "preferred_label": "逾越节祭物",
      "descriptions": [
        {
          "source": "acai",
          "description": "在逾越节期间献上的特别祭物，以纪念上帝在埃及时对以色列人的保护。"
        }
      ]
    },
    "zht": {
      "preferred_label": "逾越節祭物",
      "descriptions": [
        {
          "source": "acai",
          "description": "在逾越節期間獻上的特別祭，以記念上帝在埃及對以色列人的保護。"
        }
      ]
    }
  },
