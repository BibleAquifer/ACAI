{
  "id": "keyterm:Unfaithful.2",
  "primary_id": "keyterm:Unfaithful",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "31.101",
    "88.278"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Unfaithful",
      "alternate_labels": [
        "Adulterous"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Not staying loyal to your true beliefs or promises, like being untrue in a relationship."
        }
      ]
    },
    "fra": {
      "preferred_label": "adultère",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ne pas rester fidèle à ses convictions véritables ou à ses promesses, comme le fait de tromper dans une relation."
        }
      ]
    },
    "ind": {
      "preferred_label": "tidak setia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak tetap setia pada keyakinan sejati atau janji-janji seseorang, seperti berkhianat dalam suatu hubungan."
        }
      ]
    },
    "por": {
      "preferred_label": "infiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não permanecer leal às suas verdadeiras crenças ou promessas, como ser desleal em um relacionamento."
        }
      ]
    },
    "apd": {
      "preferred_label": "خاين",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم الوفاء للعهود أو المعتقدات الحقيقية، زي الخيانة في علاقة."
        }
      ]
    },
    "arb": {
      "preferred_label": "غَيْرُ أَمِين",
      "descriptions": [
        {
          "source": "acai",
          "description": "عَدَمُ الْإِخْلَاصِ لِلْمُعْتَقَدَاتِ الْحَقِيقِيَّةِ أَوِ الْوُعُودِ، كَالْغَدْرِ وَالْخِيَانَةِ فِي الْعَلَاقَاتِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "no stap tru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong no stap tru long ol bilif no ol promes blong yu, olsem we man i no stap tru long wan rileasensip."
        }
      ]
    },
    "hau": {
      "preferred_label": "Marar aminci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin kasancewa mai aminci ga ainihin imanin da kake da shi ko alkawura, kamar rashin gaskiya a cikin dangantaka."
        }
      ]
    },
    "hin": {
      "preferred_label": "विश्वासघाती",
      "descriptions": [
        {
          "source": "acai",
          "description": "अपने वास्तविक विश्वासों या प्रतिज्ञाओं के प्रति निष्ठावान न रहना, जैसे किसी रिश्ते में अविश्वासी या बेवफा होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ekwesịghị ntụkwasị obi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịghara ikwesị ntụkwasị obi n'ezi nkwenkwe gị ma ọ bụ nkwa gị, dị ka ịbụ onye na-ekwesịghị ntụkwasị obi na mmekọrịta."
        }
      ]
    },
    "nep": {
      "preferred_label": "अविश्‍वासी",
      "descriptions": [
        {
          "source": "acai",
          "description": "सम्बन्धमा विश्‍वासघाती हुनुजस्तै, आफ्‍नो साँचो विश्‍वास वा प्रतिज्ञाहरूमा निष्ठावान् नरहने।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Неверный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Неверность своим истинным убеждениям или обещаниям, подобно неверности в отношениях."
        }
      ]
    },
    "spa": {
      "preferred_label": "infiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "No mantenerse leal a las verdaderas creencias o promesas, como ser desleal en una relación."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutokuwa Mwaminifu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutobaki mwaminifu kwa imani yako ya kweli au ahadi, kama vile kutokuwa mwaminifu katika uhusiano."
        }
      ]
    },
    "tpi": {
      "preferred_label": "No stap gut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong i no stap gut long trupela bilip o promits bilong yu, olsem sakim tok promis insait long wanpela relasensip."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bất trung",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không trung thành với niềm tin chân thật hoặc những lời hứa của mình, như việc bất trung trong một mối quan hệ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "不忠的",
      "descriptions": [
        {
          "source": "acai",
          "description": "背弃真实的信仰或誓言，如同在关系中不忠实。"
        }
      ]
    },
    "zht": {
      "preferred_label": "不忠",
      "descriptions": [
        {
          "source": "acai",
          "description": "不忠於自己真實的信仰或誓約，如同在關係中不忠誠一樣。"
        }
      ]
    }
  },
