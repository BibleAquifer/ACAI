  "localizations": {
    "eng": {
      "preferred_label": "Lamentation",
      "alternate_labels": [
        "Elegy"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "A sad song or poem that expresses deep sorrow or mourning."
        }
      ]
    },
    "spa": {
      "preferred_label": "lamento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Canción o poema triste que expresa profundo dolor o duelo."
        }
      ]
    },
    "fra": {
      "preferred_label": "complainte",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chant ou poème triste exprimant une profonde douleur ou le deuil."
        }
      ]
    },
    "ind": {
      "preferred_label": "ratapan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nyanyian atau syair sedih yang mengungkapkan kepedihan mendalam atau perkabungan."
        }
      ]
    },
    "por": {
      "preferred_label": "Lamento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um cântico ou poema triste que expressa profundo pesar ou luto."
        }
      ]
    },
    "apd": {
      "preferred_label": "مرثاة",
      "descriptions": [
        {
          "source": "acai",
          "description": "غنية أو قصيدة حزينة بتعبر عن حزن عميق أو حداد."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَرْثاة",
      "descriptions": [
        {
          "source": "acai",
          "description": "أُغْنِيَةٌ أوْ قَصِيدَةٌ حَزِينَةٌ تُعَبِّرُ عَنْ حُزْنٍ عَمِيقٍ أوْ نَوْحٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Singsing blong krae blong sore",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan singsing no powem blong krae we i soemaot bigfala sore no hevi long hat from ded no trabol."
        }
      ]
    },
    "hau": {
      "preferred_label": "Makoki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Waƙar baƙin ciki ko waka da ke nuna tsananin baƙin ciki ko makoki."
        }
      ]
    },
    "hin": {
      "preferred_label": "विलापगीत",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक उदास गीत या कविता जो गहरे दुःख या शोक को व्यक्त करती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Abụ Akwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abụ dị mwute ma ọ bụ abụ uri na-egosipụta oke iru uju ma ọ bụ iru uju maka ọnwụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "विलाप",
      "descriptions": [
        {
          "source": "acai",
          "description": "गहिरो शोक वा विलाप व्यक्त गर्ने दुःखद गीत वा कविता।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Плач",
      "descriptions": [
        {
          "source": "acai",
          "description": "Печальная песнь или стихотворение, выражающее глубокую скорбь или траур."
        }
      ]
    },
    "swh": {
      "preferred_label": "Maombolezo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wimbo au shairi la huzuni linaloeleza majonzi au maombolezo mazito."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Singsing sori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela singsing o song bilong sori we i autim bikpela bel hevi o krai bilong sori."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ai ca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bài hát hoặc bài thơ buồn bày tỏ nỗi đau xót sâu sắc hoặc sự tang chế."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哀歌",
      "descriptions": [
        {
          "source": "acai",
          "description": "表达深切悲伤或哀悼的悲伤诗歌。"
        }
      ]
    },
    "zht": {
      "preferred_label": "哀歌",
      "descriptions": [
        {
          "source": "acai",
          "description": "表達深切悲傷或哀悼的悲歌或詩篇。"
        }
      ]
    }
  },
