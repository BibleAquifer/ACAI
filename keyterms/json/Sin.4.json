  ],
  "localizations": {
    "eng": {
      "preferred_label": "Sin (Guilty)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Being guilty of doing wrong to God or others, either on purpose or by mistake."
        }
      ]
    },
    "spa": {
      "preferred_label": "pecado (culpable)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Estar culpable de hacer lo malo contra Dios o el prójimo, ya sea a propósito o por error."
        }
      ]
    },
    "fra": {
      "preferred_label": "péché (culpabilité)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait d'être coupable d'avoir mal agi envers Dieu ou autrui, délibérément ou par erreur."
        }
      ]
    },
    "ind": {
      "preferred_label": "dosa (bersalah)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bersalah karena melakukan kesalahan terhadap Allah atau sesama, baik sengaja maupun tidak sengaja."
        }
      ]
    },
    "apd": {
      "preferred_label": "خطيّة (مذنب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كون الزول مذنب بعمل غلط ضد الله أو التانيين، إن كان عن قصد أو عن غلط."
        }
      ]
    },
    "arb": {
      "preferred_label": "خَطِيَّة (مُذْنِب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَنْ يَكونَ المَرْءُ مُذْنِبًا بارْتِكابِ خَطَإٍ ضِدَّ اللهِ أَوِ الآخَرِينَ، سَواءٌ عَمْدًا أَوْ عَنْ طَريقِ الخَطَإِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sin (Gat Fol)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong gat fol from we i mekem rong agensim God o narafala man, nomata i minim blong mekem o i mekem mistek nomo."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zunubi (Mai Laifi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa da laifin yin kuskure ga Allah ko wasu, ko da gangan ko ba da gangan ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "पाप (दोषी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "जानबूझकर या अनजाने में परमेश्वर या दूसरों के प्रति गलत काम करने के कारण दोषी होना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mmehie (Onye Ikpe Mara)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ịbụ onye ikpe mara maka ime ihe ọjọọ megide Chineke maọbụ ndị ọzọ, ma ọ bụ site nʼama ụma maọbụ na mberede."
        }
      ]
    },
    "nep": {
      "preferred_label": "पाप (दोषी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वर वा अरू कसैको विरुद्धमा जानाजानी वा भुलवश गल्ती गरेर दोषी हुनु।"
        }
      ]
    },
    "por": {
      "preferred_label": "Pecado (culpado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Estar culpado de praticar o mal contra Deus ou o próximo, seja intencionalmente ou por engano."
        }
      ]
    },
    "rus": {
      "preferred_label": "Грех (виновный)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Виновность в совершении зла против Бога или ближних, совершенного намеренно или по ошибке."
        }
      ]
    },
    "swh": {
      "preferred_label": "Dhambi (Mwenye Hatia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa na hatia ya kumkosea Mungu au wengine, iwe kwa kukusudia au kwa kutokukusudia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sin (Gat Asua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "I stap olsem man i gat asua long mekim rong long God o long ol arapela manmeri, maski em i minim o em i mekim long rong tasol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tội (Có tội)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tình trạng có tội vì làm điều sai trái nghịch cùng Đức Chúa Trời hoặc người khác, dù là cố ý hay vô tình."
        }
      ]
    },
    "zhs": {
      "preferred_label": "罪（有罪）",
      "descriptions": [
        {
          "source": "acai",
          "description": "指无论是故意还是无意，因冒犯上帝或他人而有罪的状态。"
        }
      ]
    },
    "zht": {
      "preferred_label": "罪（有罪）",
      "descriptions": [
        {
          "source": "acai",
          "description": "無論是有意還是無意，因對上帝或他人行惡而處於有罪的狀態。"
        }
      ]
    }
  },
  "referred_to_as": [
