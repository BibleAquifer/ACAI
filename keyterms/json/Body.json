  "localizations": {
    "eng": {
      "preferred_label": "Body (Figurative)",
      "descriptions": [
        {
          "source": "acai",
          "description": "The human body seen as a temporary home for the spirit or soul."
        }
      ]
    },
    "spa": {
      "preferred_label": "cuerpo (figurado)",
      "descriptions": [
        {
          "source": "acai",
          "description": "El cuerpo humano considerado como morada temporal del espíritu o del alma."
        }
      ]
    },
    "fra": {
      "preferred_label": "corps (figuré)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le corps humain considéré comme la demeure temporaire de l'esprit ou de l'âme."
        }
      ]
    },
    "ind": {
      "preferred_label": "tubuh (kiasan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tubuh manusia yang dipandang sebagai tempat kediaman sementara bagi roh atau jiwa."
        }
      ]
    },
    "por": {
      "preferred_label": "corpo (figurativo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O corpo humano visto como uma morada temporária para o espírito ou a alma."
        }
      ]
    },
    "apd": {
      "preferred_label": "جسم (مجازي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "جسم الإنسان لما يُنظر ليه كبيت مؤقت للروح أو النفس."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَسَد (مجازي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "جسد الإنسان منظورا إليه كمسكن مؤقت للروح أو النفس."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bodi (fijurativ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bodi blong man we oli luk olsem wan hom blong speret no sol blong hem blong smoltaem nomo."
        }
      ]
    },
    "hau": {
      "preferred_label": "Jiki (na alama)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jikin mutum da ake ɗauka a matsayin masauki na ɗan lokaci domin ruhu ko rai."
        }
      ]
    },
    "hin": {
      "preferred_label": "शरीर (लाक्षणिक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मानव शरीर जिसे आत्मा या प्राण के अस्थायी घर के रूप में देखा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ahụ (Nke atụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ahụ mmadụ nke a na-ele anya dị ka ebe obibi nwa oge maka mmụọ ma ọ bụ mkpụrụ obi."
        }
      ]
    },
    "nep": {
      "preferred_label": "शरीर (लाक्षणिक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मानव शरीरलाई आत्मा वा प्राणको अस्थायी वासस्थानको रूपमा हेरिएको अवस्था।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Тело (образно)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человеческое тело, рассматриваемое как временное жилище для духа или души."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwili (Kistiari)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwili wa mwanadamu unavyotazamwa kama makao ya muda ya roho au nafsi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bodi (tok piksa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bodi bilong manmeri ol i lukim olsem haus bilong sotpela taim tasol bilong spirit o sol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thân thể (nghĩa bóng)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thân thể con người được xem như một nơi trú ngụ tạm thời cho tâm linh hoặc linh hồn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "身体（比喻）",
      "descriptions": [
        {
          "source": "acai",
          "description": "被视为灵或灵魂的暂时居所的人类身体。"
        }
      ]
    },
    "zht": {
      "preferred_label": "身體（比喻）",
      "descriptions": [
        {
          "source": "acai",
          "description": "人的身體被視為靈魂或心靈暫時的居所。"
        }
      ]
    }
  },
