  "localizations": {
    "eng": {
      "preferred_label": "Be Disgraced",
      "descriptions": [
        {
          "source": "acai",
          "description": "To be looked down on and made fun of because of shame or failure."
        }
      ]
    },
    "apd": {
      "preferred_label": "يتفضح",
      "descriptions": [
        {
          "source": "acai",
          "description": "إن الناس يحقروك ويضحكوا عليك بسبب العار أو الفشل."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَخْزَى",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَنْ يُحْتَقَرَ الشَّخْصُ وَيُسْخَرَ مِنْهُ بِسَبَبِ الْخِزْيِ أَوِ الْفَشَلِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "kasem bigfala sem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong kasem bigfala sem mo ol man oli daonem mo jikim yu from we yu mekem wan samting we i foldaon o i no stret."
        }
      ]
    },
    "fra": {
      "preferred_label": "être couvert de honte",
      "descriptions": [
        {
          "source": "acai",
          "description": "Être méprisé et tourné en dérision en raison d'une honte ou d'un échec."
        }
      ]
    },
    "hau": {
      "preferred_label": "Wulakantuwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zama abin rena da ba'a saboda kunya ko rashin nasara."
        }
      ]
    },
    "hin": {
      "preferred_label": "अपमानित होना",
      "descriptions": [
        {
          "source": "acai",
          "description": "लज्जा या असफलता के कारण नीची दृष्टि से देखा जाना और उपहास का पात्र बनना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Inwe ihere",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ka e leda anya ma mee ihe ọchị nʼihi ihere maọbụ ọdịda."
        }
      ]
    },
    "ind": {
      "preferred_label": "dipermalukan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dipandang rendah dan diolok-olok karena rasa malu atau kegagalan."
        }
      ]
    },
    "nep": {
      "preferred_label": "अपमानित हुनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "शर्म वा असफलताका कारण हेपिइनु र उपहास गरिनु।"
        }
      ]
    },
    "por": {
      "preferred_label": "ser desonrado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser desprezado e ridicularizado por causa de vergonha ou fracasso."
        }
      ]
    },
    "rus": {
      "preferred_label": "Быть посрамленным",
      "descriptions": [
        {
          "source": "acai",
          "description": "Подвергаться презрению и насмешкам из-за позора или неудачи."
        }
      ]
    },
    "spa": {
      "preferred_label": "ser deshonrado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser despreciado y burlado a causa de la vergüenza o el fracaso."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuaibika",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kudharauliwa na kufanyiwa mzaha kwa sababu ya aibu au kushindwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kisim sem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kisim sem na ol arapela i lukluk daun na tok bilas long yu bikos long sem o hevi bilong yu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bị sỉ nhục",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bị khinh miệt và chế nhạo vì sự hổ thẹn hoặc thất bại."
        }
      ]
    },
    "zhs": {
      "preferred_label": "受辱",
      "descriptions": [
        {
          "source": "acai",
          "description": "因羞耻或失败而被人看不起和嘲笑。"
        }
      ]
    },
    "zht": {
      "preferred_label": "蒙羞",
      "descriptions": [
        {
          "source": "acai",
          "description": "因羞辱或失敗而被人藐視和取笑。"
        }
      ]
    }
  },
