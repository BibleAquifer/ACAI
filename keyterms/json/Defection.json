  "localizations": {
    "eng": {
      "preferred_label": "Defection",
      "alternate_labels": [
        "Apostasy"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Turning away from God and the faith, choosing to reject Him."
        }
      ]
    },
    "spa": {
      "preferred_label": "apostasía",
      "descriptions": [
        {
          "source": "acai",
          "description": "Apartarse de Dios y de la fe, decidiendo rechazarlo."
        }
      ]
    },
    "fra": {
      "preferred_label": "défection",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fait de se détourner de Dieu et de la foi, en choisissant de le rejeter."
        }
      ]
    },
    "ind": {
      "preferred_label": "kemurtadan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Berpaling dari Allah dan iman, memilih untuk menolak-Nya."
        }
      ]
    },
    "por": {
      "preferred_label": "apostasia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Afastar-se de Deus e da fé, escolhendo rejeitá-lo."
        }
      ]
    },
    "apd": {
      "preferred_label": "ارتداد",
      "descriptions": [
        {
          "source": "acai",
          "description": "الابتعاد عن الله وعن الإيمان واختيار رفضه."
        }
      ]
    },
    "arb": {
      "preferred_label": "ارتداد",
      "descriptions": [
        {
          "source": "acai",
          "description": "الارتداد عن الله والإيمان، واختيار رفضه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin blong tanem baksaed long God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong gowe long God mo fet, mo jusum blong tanem baksaed long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ridda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Juyawa daga Allah da kuma bangaskiya, da zaɓan ƙin Shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "धर्मत्याग",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर और विश्वास से मुँह मोड़ना, तथा उसे अस्वीकार करने का चुनाव करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịdapụ nʼokwukwe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ichegharị ma ọ bụ ịhapụ Chineke na okwukwe, na ịhọrọ ịjụ Ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "धर्मत्याग",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरलाई इन्कार गर्न चुन्दै उहाँ र विश्‍वासबाट तर्किजानु वा विश्‍वासघात गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Отступничество",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отвержение Бога и веры, уход от Него."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uasi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kugeuka na kuacha kufuata Mungu na imani, na kuchagua kumkataa Yeye."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin bilong givim baksait long God",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong givim baksait long God na long bilip, na makim rot bilong sakim em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bội đạo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Xoay bỏ Đức Chúa Trời và đức tin, chọn khước từ Ngài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "背信",
      "descriptions": [
        {
          "source": "acai",
          "description": "背弃上帝和信仰，选择离弃祂。"
        }
      ]
    },
    "zht": {
      "preferred_label": "背道",
      "descriptions": [
        {
          "source": "acai",
          "description": "離棄上帝與信仰，選擇拒絕祂。"
        }
      ]
    }
  },
