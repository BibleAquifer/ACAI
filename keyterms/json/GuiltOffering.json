{
  "id": "keyterm:GuiltOffering",
  "primary_id": "keyterm:Offering",
  "type": "keyterm",
  "keyterm_type": "rituals",
  "ubsdbh": [
    "000754001003000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Guilt-Offering",
      "descriptions": [
        {
          "source": "acai",
          "description": "A sacrifice made to correct something that was wrongly taken or not properly given to God."
        }
      ]
    },
    "spa": {
      "preferred_label": "ofrenda por la culpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sacrificio realizado para corregir algo que se tomó indebidamente o que no se entregó debidamente a Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "sacrifice de culpabilité",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sacrifice offert pour réparer un tort concernant une chose indûment prise ou qui n’a pas été convenablement donnée à Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "korban penebus salah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kurban yang dipersembahkan untuk membetulkan sesuatu yang diambil secara salah atau tidak diserahkan sebagaimana mestinya kepada Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "oferta pela culpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um sacrifício realizado para reparar algo que foi tomado indevidamente ou não foi devidamente entregue a Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "ذبيحة إثم",
      "descriptions": [
        {
          "source": "acai",
          "description": "ذبيحة بتتقدم عشان تصحيح حاجة اتاخدت بالغلط أو ما اتقدّمت لله زي ما مفروض."
        }
      ]
    },
    "arb": {
      "preferred_label": "ذَبِيحَةُ إِثْمٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ذَبِيحَةٌ تُقَدَّمُ لِلتَّكْفِيرِ عَنْ شَيْءٍ أُخِذَ خَطَأً أَوْ لَمْ يُعْطَ لِلهِ كَمَا يَنْبَغِي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sakrefaes blong tekemaot sin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan sakrefaes we oli mekem blong stretem wan samting we oli bin tekem long fasin we i no stret no we oli no bin givim i stret long God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hadaya don laifi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hadayar da ake yi domin a rama ko a gyara abin da aka ɗauka ba tare da haƙƙi ba ko kuma ba a miƙa shi yadda ya kamata ga Allah ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "दोषबलि",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक बलिदान जो किसी ऐसी वस्तु के सुधार के लिए चढ़ाया जाता था जो गलत तरीके से ले ली गई थी या परमेश्वर को उचित रीति से नहीं दी गई थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Àjà ikpe ọmụma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Àjà a na-achụ iji dozie ihe e weghaara nʼụzọ na-ezighị ezi maọbụ nke a na-enyeghị Chineke nʼụzọ kwesịrị ekwesị."
        }
      ]
    },
    "nep": {
      "preferred_label": "दोषबलि",
      "descriptions": [
        {
          "source": "acai",
          "description": "गलत तरिकाले लिइएको वा परमेश्वरलाई उचित रूपमा नचढाइएको कुराको सुधार गर्न चढाइने बलि।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Жертва повинности",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жертва, приносимая для искупления того, что было неправедно отнято или не отдано должным образом Богу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sadaka ya hatia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dhabihu iliyotolewa ili kurekebisha kitu kilichochukuliwa isivyo haki au ambacho hakikutolewa ipasavyo kwa Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ofa bilong mekim i dai asua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ofa bilong stretim wanpela samting ol i bin stilim o ol i no bin givim stret long God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tế lễ chuộc lỗi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Của lễ dâng lên để chuộc lại hoặc bồi thường cho điều gì đó đã bị lấy sai trái hoặc không dâng đúng cách cho Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赎过祭",
      "descriptions": [
        {
          "source": "acai",
          "description": "为纠正不当侵占他人之物或未正当献归上帝之物而献上的祭。"
        }
      ]
    },
    "zht": {
      "preferred_label": "贖愆祭",
      "descriptions": [
        {
          "source": "acai",
          "description": "為補償不當奪取之物或未正確歸給上帝之物而獻上的祭。"
        }
      ]
    }
  },
