{
  "id": "keyterm:Sinful",
  "primary_id": "keyterm:Sin",
  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdbh": [
    "002214001002000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Sinful",
      "alternate_labels": [
        "Sinner"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Having a habit of doing wrong things and feeling guilty, needing to be made right."
        }
      ]
    },
    "spa": {
      "preferred_label": "pecador",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tener el hábito de hacer lo malo y sentirse culpable, con necesidad de ser restaurado."
        }
      ]
    },
    "fra": {
      "preferred_label": "pécheur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Qui a l'habitude de commettre de mauvaises actions et d'être coupable, ayant besoin d'être rétabli dans la droiture."
        }
      ]
    },
    "ind": {
      "preferred_label": "berdosa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memiliki kebiasaan melakukan hal-hal yang salah dan merasa bersalah, membutuhkan pembenaran."
        }
      ]
    },
    "apd": {
      "preferred_label": "خاطي",
      "descriptions": [
        {
          "source": "acai",
          "description": "الزول المتعود يعمل الغلط وحاسي بالذنب، ومحتاج يتصلح حالو."
        }
      ]
    },
    "arb": {
      "preferred_label": "خاطئ",
      "descriptions": [
        {
          "source": "acai",
          "description": "الاعتياد على فعل الشر والشعور بالذنب، والحاجة إلى التصحيح والتبرير."
        }
      ]
    },
    "bis": {
      "preferred_label": "man blong sin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gat fasin blong mekem ol samting we i rong mo harem i gat fol, mo i nidim blong mekem i stret bakegen."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai zunubi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa mai ɗabi’ar yin abubuwan da ba daidai ba tare da jin laifi, yana bukatar a gyara shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "पापी",
      "descriptions": [
        {
          "source": "acai",
          "description": "गलत काम करने का स्वभाव रखना और दोषी महसूस करना, जिसे सुधारे जाने की आवश्यकता हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị mmehie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe àgwà nke ime ihe ọjọọ na inwe mmetụta ikpe ọmụma, na-achọ ka e dozie ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "पापी",
      "descriptions": [
        {
          "source": "acai",
          "description": "खराब काम गर्ने बानी भएको र दोषी महसुस गर्ने, जसलाई सही बनाइनु आवश्यक छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "pecador",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ter o hábito de fazer coisas erradas e sentir culpa, precisando ser corrigido ou reconciliado."
        }
      ]
    },
    "rus": {
      "preferred_label": "Грешный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Имеющий привычку поступать дурно и чувствующий вину, нуждающийся в оправдании."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwenye Dhambi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa na tabia ya kufanya mambo maovu na kujisikia mwenye hatia, ukihitaji kurekebishwa au kufanywa mwenye haki."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pasin bilong mekim sin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong save mekim ol pasin nogut na pilim asua, na i nidim wanpela bilong stretim bek."
        }
      ]
    },
    "vie": {
      "preferred_label": "Có tội",
      "descriptions": [
        {
          "source": "acai",
          "description": "Có thói quen làm những điều sai trái và cảm thấy có tội, cần được phục hồi mối quan hệ đúng đắn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "有罪的",
      "descriptions": [
        {
          "source": "acai",
          "description": "习惯于做错事并感到罪咎，需要被纠正挽回。"
        }
      ]
    },
    "zht": {
      "preferred_label": "有罪的",
      "descriptions": [
        {
          "source": "acai",
          "description": "有作惡的習性並感到有罪，需要歸正。"
        }
      ]
    }
  },
