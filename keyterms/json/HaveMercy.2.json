  "type": "keyterm",
  "keyterm_type": "attributes",
  "ubsdgnt": [
    "88.80"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Show Mercy",
      "alternate_labels": [
        "Show Compassion"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "Being kind and caring toward others, especially when they need help or forgiveness."
        }
      ]
    },
    "spa": {
      "preferred_label": "tener compasión",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser bondadoso y compasivo con los demás, especialmente cuando necesitan ayuda o perdón."
        }
      ]
    },
    "fra": {
      "preferred_label": "faire miséricorde",
      "descriptions": [
        {
          "source": "acai",
          "description": "Se montrer bienveillant et attentionné envers les autres, en particulier lorsqu'ils ont besoin d'aide ou de pardon."
        }
      ]
    },
    "ind": {
      "preferred_label": "bermurah hati",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bersikap baik dan peduli terhadap orang lain, terutama saat mereka membutuhkan pertolongan atau pengampunan."
        }
      ]
    },
    "por": {
      "preferred_label": "mostrar misericórdia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser bondoso e atencioso com os outros, especialmente quando precisam de ajuda ou perdão."
        }
      ]
    },
    "apd": {
      "preferred_label": "يصنع رحمة",
      "descriptions": [
        {
          "source": "acai",
          "description": "التعامل بلطف واهتمام مع الآخرين، خصوصاً لمن يكونوا محتاجين مساعدة أو غفران."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِظْهَارُ الرَّأْفَةِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "اللُّطْفُ وَالعِنَايَةُ بِالآخَرِينَ، خُصُوصًا عِنْدَمَا يَكُونُونَ بِحَاجَةٍ إِلَى المُسَاعَدَةِ أَوِ الغُفْرَانِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "sore long man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Soemaot kaenfala fasin mo kea long ol narafala man, speseli taem oli nidim help o fogif."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yi jinƙai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasancewa mai alheri da kulawa ga wasu, musamman sa’ad da suke bukatar taimako ko gafara."
        }
      ]
    },
    "hin": {
      "preferred_label": "दया करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "दूसरों के प्रति कृपालु और परवाह करने वाला होना, विशेषकर जब उन्हें सहायता या क्षमा की आवश्यकता हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ime ebere",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inwe obiọma na nlekọta nʼebe ndị ọzọ nọ, karịsịa mgbe ha chọrọ enyemaka ma ọ bụ mgbaghara."
        }
      ]
    },
    "nep": {
      "preferred_label": "दया देखाउनु",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरूप्रति दयालु र हेरचाहपूर्ण हुनु, विशेष गरी जब तिनीहरूलाई सहायता वा क्षमाको खाँचो हुन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Являть милосердие",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проявление доброты и заботы к другим, особенно когда они нуждаются в помощи или прощении."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kuonyesha rehema",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuwa mwenye wema na kujali wengine, hasa wanapohitaji msaada au msamaha."
        }
      ]
    },
    "tpi": {
      "preferred_label": "marimari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim pasin marimari na sori long ol arapela, moa yet taim ol i nidim helpim o fogif."
        }
      ]
    },
    "vie": {
      "preferred_label": "thương xót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nhân từ và quan tâm đến người khác, đặc biệt là khi họ cần sự giúp đỡ hoặc tha thứ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "存怜悯",
      "descriptions": [
        {
          "source": "acai",
          "description": "善待并关怀他人，尤其在他们需要帮助或饶恕的时候。"
        }
      ]
    },
    "zht": {
      "preferred_label": "施憐憫",
      "descriptions": [
        {
          "source": "acai",
          "description": "恩待並關懷他人，特別是在他人需要幫助或赦免之時。"
        }
      ]
    }
  },
