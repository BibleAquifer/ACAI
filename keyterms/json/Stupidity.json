  "localizations": {
    "eng": {
      "preferred_label": "Stupidity (Folly)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Not having wisdom or good judgment, leading to unwise actions."
        }
      ]
    },
    "spa": {
      "preferred_label": "estupidez (necedad)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Falta de sabiduría o de buen juicio, que conduce a acciones insensatas."
        }
      ]
    },
    "fra": {
      "preferred_label": "stupidité (folie)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le fait de manquer de sagesse ou de bon jugement, conduisant à des actes imprudents."
        }
      ]
    },
    "ind": {
      "preferred_label": "kebodohan (kebodohan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tidak memiliki hikmat atau penilaian yang baik, yang menuntun pada tindakan-tindakan yang tidak bijaksana."
        }
      ]
    },
    "por": {
      "preferred_label": "estupidez (loucura)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Não ter sabedoria ou bom senso, o que leva a ações imprudentes."
        }
      ]
    },
    "apd": {
      "preferred_label": "غباء (حماقة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم وجود الحكمة أو التمييز السليم، والشيء ده بيقود لتصرفات ما حكيمة."
        }
      ]
    },
    "arb": {
      "preferred_label": "غباء (حماقة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عدم امتلاك الحكمة أو حسن التمييز، مما يؤدي إلى تصرفات غير حكيمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fasin we i krangke (Fasin we i no waes)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin ya we man i no gat waes no i no gat gudfala jajmen, we i mekem hem i mekem ol samting we i no waes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Wawanci (Rashin Hikima)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rashin hikima ko kyakkyawan tunani, wanda yake kaiwa ga ayyukan rashin hikima."
        }
      ]
    },
    "hin": {
      "preferred_label": "मूर्खता (अज्ञानता)",
      "descriptions": [
        {
          "source": "acai",
          "description": "बुद्धि या सही निर्णय की कमी होना, जिसके कारण मूर्खतापूर्ण कार्य होते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe nzuzu (Nzuzu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Enweghị amamihe ma ọ bụ ezi uche, nke na-eduga nʼomume na-adịghị mma."
        }
      ]
    },
    "nep": {
      "preferred_label": "मूर्खता (अविवेक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "बुद्धि वा उचित विवेक नहुनु, जसले गर्दा मूर्खतापूर्ण कामहरू हुन पुग्छन्।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Глупость (безрассудство)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отсутствие мудрости или здравого смысла, ведущее к неразумным поступкам."
        }
      ]
    },
    "swh": {
      "preferred_label": "Upumbavu (Ujinga)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutokuwa na hekima au uamuzi mzuri, unaoongoza kwenye matendo yasiyo ya busara."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasin longlong (Pasin kranki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong i no gat savetingting o gutpela tingting, na dispela i save mekim man i mekim ol kranki pasin."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sự ngu muội (Sự dại dột)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Không có sự khôn ngoan hoặc khả năng phán đoán tốt, dẫn đến những hành động dại dột."
        }
      ]
    },
    "zhs": {
      "preferred_label": "愚昧（愚蠢）",
      "descriptions": [
        {
          "source": "acai",
          "description": "缺乏智慧或良好判断力，导致不明智的行动。"
        }
      ]
    },
    "zht": {
      "preferred_label": "愚昧 (愚妄)",
      "descriptions": [
        {
          "source": "acai",
          "description": "缺乏智慧或良好的判斷力，導致不明智的行為。"
        }
      ]
    }
  },
