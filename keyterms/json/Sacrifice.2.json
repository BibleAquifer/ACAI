  ],
  "localizations": {
    "eng": {
      "preferred_label": "Sacrifice (Act)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Giving something valuable, often an animal, to God as a sign of worship or forgiveness."
        }
      ]
    },
    "spa": {
      "preferred_label": "sacrificar (acto)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Entregar algo valioso, a menudo un animal, a Dios como señal de adoración o perdón."
        }
      ]
    },
    "fra": {
      "preferred_label": "sacrifier (acte)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Donner à Dieu quelque chose de grande valeur, souvent un animal, en signe d'adoration ou pour le pardon."
        }
      ]
    },
    "ind": {
      "preferred_label": "mempersembahkan korban (tindakan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Memberikan sesuatu yang berharga, sering kali seekor binatang, kepada Allah sebagai tanda penyembahan atau pengampunan."
        }
      ]
    },
    "por": {
      "preferred_label": "sacrificar (ato)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Entregar algo valioso, geralmente um animal, a Deus como sinal de adoração ou perdão."
        }
      ]
    },
    "apd": {
      "preferred_label": "تضحية (فعل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تقديم حاجة قيمة، غالباً حيوان، لله كعلامة للعبادة أو لطلب المغفرة."
        }
      ]
    },
    "arb": {
      "preferred_label": "ذَبْح (فِعْل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تَقْدِيمُ شَيْءٍ ثَمِينٍ، غَالِبًا حَيَوَانٍ، لِلهِ كَعَلَامَةٍ عَلَى ٱلْعِبَادَةِ أَوِ ٱلْمَغْفِرَةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem sakrefaes (Wok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasin blong givim wan sas samting, plante taem wan anamol, i go long God olsem wan saen blong wosip o fogifnes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin Hadaya (Aiki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bada wani abu mai tamani, yawanci dabba, ga Allah a matsayin alamar bauta ko gafarar zunubi."
        }
      ]
    },
    "hin": {
      "preferred_label": "बलिदान (कार्य)",
      "descriptions": [
        {
          "source": "acai",
          "description": "आराधना या क्षमा के प्रतीक के रूप में परमेश्वर को कोई बहुमूल्य वस्तु, प्रायः कोई पशु अर्पित करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịchụ Aja (Omume)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inye Chineke ihe dị oké ọnụ ahịa, na-abụkarị anụmanụ, dị ka ihe ịrịba ama nke ofufe ma ọ bụ mgbaghara mmehie."
        }
      ]
    },
    "nep": {
      "preferred_label": "बलिदान (कार्य)",
      "descriptions": [
        {
          "source": "acai",
          "description": "आराधना वा क्षमाको सङ्केतको रूपमा परमेश्‍वरलाई कुनै बहुमूल्य थोक, प्रायजसो जनावर, चढाउने कार्य।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Жертвоприношение (действие)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Принесение чего-либо ценного, часто животного, Богу в знак поклонения или ради прощения."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutoa Dhabihu (Tendo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kutoa kitu cha thamani, mara nyingi mnyama, kwa Mungu kama ishara ya ibada au msamaha."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim ofa (Wok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong givim wanpela gutpela samting, planti taim em wanpela animal, long God olsem mak bilong lotu o bilong kisim lusim bilong ol sin."
        }
      ]
    },
    "vie": {
      "preferred_label": "Dâng tế lễ (Hành động)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hành động dâng điều có giá trị, thường là con thú, lên Đức Chúa Trời như một dấu hiệu của sự thờ phượng hoặc tha thứ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "献祭 (行为)",
      "descriptions": [
        {
          "source": "acai",
          "description": "将贵重之物（通常是动物）献给上帝，作为敬拜或得赦免的表征。"
        }
      ]
    },
    "zht": {
      "preferred_label": "獻祭（行為）",
      "descriptions": [
        {
          "source": "acai",
          "description": "將珍貴之物（通常是動物）獻給上帝，作為敬拜或求赦免的表徵。"
        }
      ]
    }
  },
