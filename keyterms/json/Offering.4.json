  "localizations": {
    "eng": {
      "preferred_label": "Offering (Voluntary)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A gift freely given to God during worship to show devotion and love."
        }
      ]
    },
    "spa": {
      "preferred_label": "ofrenda (voluntaria)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ofrenda que se da voluntariamente a Dios durante la adoración para mostrar devoción y amor."
        }
      ]
    },
    "fra": {
      "preferred_label": "offrande (volontaire)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un don offert librement à Dieu pendant le culte pour manifester son attachement et son amour."
        }
      ]
    },
    "ind": {
      "preferred_label": "persembahan (sukarela)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pemberian sukarela kepada Allah dalam ibadah untuk menunjukkan pengabdian dan kasih."
        }
      ]
    },
    "por": {
      "preferred_label": "oferta (voluntária)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma dádiva oferecida voluntariamente a Deus durante a adoração para demonstrar devoção e amor."
        }
      ]
    },
    "apd": {
      "preferred_label": "تقدمة (اختيارية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "هدية بتِتقدّم لله بحرية ورضا في وقت العبادة عشان تبيّن الإخلاص والمحبة."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَقْدِمَة (طَوْعِيَّة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عَطِيَّةٌ تُقَدَّمُ طَوْعًا لِلهِ أَثْنَاءَ ٱلْعِبَادَةِ إِظْهَارًا لِلتَّعَبُّدِ وَٱلْمَحَبَّةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Presen (Frihat)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan presen we man i givim wetem frihat long God long taem blong wosip blong soemaot lav mo ona long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hadaya (Ta Son Rai)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kyauta da aka ba wa Allah da son rai a lokacin bauta don nuna sadaukarwa da ƙauna."
        }
      ]
    },
    "hin": {
      "preferred_label": "भेंट (स्वेच्छाबलि)",
      "descriptions": [
        {
          "source": "acai",
          "description": "भक्ति और प्रेम प्रकट करने के लिए आराधना के दौरान परमेश्वर को स्वेच्छा से दिया जाने वाला उपहार।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onyinye (Nke afọ ofufo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyinye e sitere n'obi nye Chineke n'oge ofufe iji gosi nsọpụrụ na ịhụnanya."
        }
      ]
    },
    "nep": {
      "preferred_label": "भेटी (स्वेच्छाबलि)",
      "descriptions": [
        {
          "source": "acai",
          "description": "भक्ति र प्रेम देखाउन आराधनाको समयमा परमेश्‍वरलाई स्वेच्छाले दिइने उपहार।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Приношение (добровольное)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дар, добровольно приносимый Богу во время поклонения в знак преданности и любви."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sadaka (Ya Hiari)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zawadi inayotolewa kwa hiari kwa Mungu wakati wa ibada ili kuonyesha ibada na upendo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ofa (Givim Long Laik Bilong Yet)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela presen man i givim fri long God long taim bilong mekim lotu bilong soim pasin bilong givim bel olgeta na pasin laikim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lễ vật (Tự nguyện)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Của lễ tình nguyện dâng lên Đức Chúa Trời trong sự thờ phượng để bày tỏ lòng tận hiến và tình yêu thương."
        }
      ]
    },
    "zhs": {
      "preferred_label": "奉献（甘心）",
      "descriptions": [
        {
          "source": "acai",
          "description": "敬拜时自愿献给上帝以表达虔诚和爱心的礼物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "供物（自願）",
      "descriptions": [
        {
          "source": "acai",
          "description": "在敬拜中自願獻給上帝的禮物，用以表達敬虔與愛。"
        }
      ]
    }
  },
