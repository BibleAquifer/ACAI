  ],
  "localizations": {
    "eng": {
      "preferred_label": "Defile (Ceremonial)",
      "descriptions": [
        {
          "source": "acai",
          "description": "To make someone or something unclean or wrong in a way that goes against religious rules."
        }
      ]
    },
    "spa": {
      "preferred_label": "contaminar (ceremonial)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer que alguien o algo sea impuro o incorrecto de una manera que va en contra de las normas religiosas."
        }
      ]
    },
    "fra": {
      "preferred_label": "souiller (rituel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rendre quelqu'un ou quelque chose impur ou coupable d'une manière qui va à l'encontre des règles religieuses."
        }
      ]
    },
    "ind": {
      "preferred_label": "menajiskan (secara upacara)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menjadikan seseorang atau sesuatu najis atau salah dengan cara yang melanggar hukum-hukum keagamaan."
        }
      ]
    },
    "por": {
      "preferred_label": "contaminar (cerimonial)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tornar alguém ou algo impuro ou corrompido de uma maneira que vai contra preceitos religiosos."
        }
      ]
    },
    "apd": {
      "preferred_label": "ينجّس (طقسي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تنجيس زول أو شي بطريقة بتخالف الشرايع الدينية."
        }
      ]
    },
    "arb": {
      "preferred_label": "ينجس (طقسي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "جعل شخص أو شيء نجسًا أو مخالفًا بطريقة تخالف القواعد الدينية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem i doti (Long fes blong God)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem wan man no wan samting i doti no i rong long fasin we i agensem ol rul blong lafet mo kastom blong wosip."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙazantarwa (Ta Al'ada)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mai da wani ko wani abu marar tsarki ko marar kyau a hanyar da ta saɓa wa dokokin addini."
        }
      ]
    },
    "hin": {
      "preferred_label": "अशुद्ध करना (रीति-संबंधी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "धार्मिक नियमों के विरुद्ध जाकर किसी व्यक्ति या वस्तु को अशुद्ध या अनुचित बनाना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Imerụ (Nʼemume okpukpe)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka mmadụ ma ọ bụ ihe ghara ịdị ọcha ma ọ bụ bụrụ ihe na-adịghị mma nʼụzọ na-emegide iwu okpukpe."
        }
      ]
    },
    "nep": {
      "preferred_label": "अशुद्ध पार्नु (धार्मिक विधिअनुसार)",
      "descriptions": [
        {
          "source": "acai",
          "description": "धार्मिक नियमहरूविरुद्ध हुने गरी कसैलाई वा कुनै कुरालाई अशुद्ध वा गलत तुल्याउनु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Осквернять (ритуально)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Делать кого-либо или что-либо нечистым или порочным в нарушение религиозных правил."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutia Najisi (Kikuhani)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumfanya mtu au kitu kuwa najisi au kisicho sawa kwa njia inayokiuka sheria za kidini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim i kamap doti (Lo bilong lotu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long mekim wanpela manmeri o samting i kamap doti o no stret long ai bilong God long wanpela pasin i brukim ol lo bilong lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Làm ô uế (Nghi lễ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm cho ai đó hoặc điều gì đó bị ô uế hay sai trật theo cách vi phạm các luật lệ tôn giáo."
        }
      ]
    },
    "zhs": {
      "preferred_label": "玷污 (礼仪上)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以违背宗教规条的方式使某人或某物不洁净或有罪。"
        }
      ]
    },
    "zht": {
      "preferred_label": "玷污（禮儀上）",
      "descriptions": [
        {
          "source": "acai",
          "description": "使人或物不潔淨或有差錯，從而違反宗教規條。"
        }
      ]
    }
  },
