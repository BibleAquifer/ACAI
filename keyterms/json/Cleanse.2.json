  "localizations": {
    "eng": {
      "preferred_label": "To Cleanse",
      "alternate_labels": [
        "To Purify"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To make someone or something pure by removing guilt or uncleanness through a special ritual."
        }
      ]
    },
    "spa": {
      "preferred_label": "purificar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hacer pura a una persona o cosa quitando la culpa o la impureza mediante un ritual especial."
        }
      ]
    },
    "fra": {
      "preferred_label": "purifier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rendre une personne ou une chose pure en enlevant la culpabilité ou l'impureté au moyen d'un rituel spécial."
        }
      ]
    },
    "ind": {
      "preferred_label": "menyucikan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Menjadikan seseorang atau sesuatu murni dengan menghapus kesalahan atau kenajisan melalui suatu ritual khusus."
        }
      ]
    },
    "apd": {
      "preferred_label": "طهّر",
      "descriptions": [
        {
          "source": "acai",
          "description": "جعل زول أو حاجة طاهرة بإزالة الذنب أو النجاسة عن طريق طقس خاص."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُطهِّر",
      "descriptions": [
        {
          "source": "acai",
          "description": "جعل شخص أو شيء طاهرًا بإزالة الذنب أو النجاسة من خلال طقس خاص."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mekem i kam klin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem wan man no wan samting i klin tru long fasin blong tekemaot sin no doti long wan spesel kastom no laen blong wosip."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tsarkakewa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mayar da wani ko wani abu tsarkakakke ta wurin cire laifi ko rashin tsarki ta hanyar wata al’ada ta musamman."
        }
      ]
    },
    "hin": {
      "preferred_label": "पवित्र करना",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी विशेष विधि द्वारा दोष या अशुद्धता को दूर करके किसी व्यक्ति या वस्तु को शुद्ध करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ido ihe ọcha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ka mmadụ ma ọ bụ ihe dị ọcha site nʼiwepụ ikpe ọmụma ma ọ bụ adịghị ọcha site nʼememe pụrụ iche."
        }
      ]
    },
    "nep": {
      "preferred_label": "शुद्ध पार्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै विशेष विधि वा अनुष्ठानद्वारा दोष वा अशुद्धता हटाएर कसैलाई वा कुनै थोकलाई शुद्ध पार्नु।"
        }
      ]
    },
    "por": {
      "preferred_label": "purificar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tornar alguém ou algo puro ao remover a culpa ou impureza por meio de um ritual especial."
        }
      ]
    },
    "rus": {
      "preferred_label": "очищать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сделать кого-либо или что-либо чистым, удалив вину или нечистоту посредством особого ритуала."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutakasa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kumfanya mtu au kitu kuwa safi kwa kuondoa hatia au unajisi kupitia ibada maalum."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mekim i kamap klin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pasin bilong mekim wanpela man o samting i kamap klin long ai bilong God long rot bilong rausim asua o doti wantaim wanpela kain pasin bilong lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Làm cho tinh sạch",
      "descriptions": [
        {
          "source": "acai",
          "description": "Làm cho một người hoặc một vật trở nên thanh sạch bằng cách loại bỏ tội lỗi hoặc sự ô uế qua một nghi thức đặc biệt."
        }
      ]
    },
    "zhs": {
      "preferred_label": "洁净",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过特别的仪式除去罪咎或不洁，使人或物成为纯洁。"
        }
      ]
    },
    "zht": {
      "preferred_label": "潔淨",
      "descriptions": [
        {
          "source": "acai",
          "description": "透過特別的儀式除去罪咎或不潔，使人或物變得純潔。"
        }
      ]
    }
  },
