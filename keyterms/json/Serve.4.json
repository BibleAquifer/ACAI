  "localizations": {
    "eng": {
      "preferred_label": "Serve (Perform Rites)",
      "alternate_labels": [
        "Worship"
      ],
      "descriptions": [
        {
          "source": "acai",
          "description": "To perform religious ceremonies as a way of worshiping God."
        }
      ]
    },
    "spa": {
      "preferred_label": "servir (celebrar ritos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Llevar a cabo ceremonias religiosas como forma de adorar a Dios."
        }
      ]
    },
    "fra": {
      "preferred_label": "servir (accomplir des rites)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Accomplir des cérémonies religieuses pour rendre un culte à Dieu."
        }
      ]
    },
    "ind": {
      "preferred_label": "berbakti (menjalankan upacara keagamaan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Melakukan upacara keagamaan sebagai cara beribadah kepada Allah."
        }
      ]
    },
    "por": {
      "preferred_label": "servir (realizar ritos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Realizar cerimônias religiosas como forma de adorar a Deus."
        }
      ]
    },
    "apd": {
      "preferred_label": "يخدم (يقيم شعائر)",
      "descriptions": [
        {
          "source": "acai",
          "description": "إقامة طقوس دينية كطريقة لعبادة الله."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَعْبُد (يُؤَدّي طُقوسًا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مُمارَسَةُ طُقوسٍ دينِيَّةٍ كَطَريقَةٍ لِعِبادَةِ اللهِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "mekem wok (mekem seremoni)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Blong mekem ol seremoni blong skul olsem wan fasin blong wosipim God."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yin hidima (Bauta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gudanar da bukukuwan addini a matsayin hanyar bauta wa Allah."
        }
      ]
    },
    "hin": {
      "preferred_label": "उपासना करना (विधियाँ संपन्न करना)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर की आराधना के रूप में धार्मिक अनुष्ठान या विधियाँ संपन्न करना।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ife ofufe (Ime emume)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime emume okpukpe dị iche iche dị ka ụzọ isi fee Chineke ofufe."
        }
      ]
    },
    "nep": {
      "preferred_label": "सेवा गर्नु (विधि पूरा गर्नु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको आराधना गर्ने माध्यमको रूपमा धार्मिक विधिहरू पूरा गर्नु।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Служить (совершать обряды)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Совершать религиозные обряды как способ поклонения Богу."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kutumikia (Kufanya Ibada)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kufanya ibada au sherehe za kidini kama njia ya kumwabudu Mungu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "mekim wok lotu (mekim ol kastom pasin bilong lotu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mekim ol kain kain lotu na pasin bilong haus lotu olsem wanpela rot bilong lotuim God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Phụng sự (cử hành nghi thức)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thực hiện các nghi thức tôn giáo như một cách để thờ phượng Đức Chúa Trời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "事奉（履行礼仪）",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过举行宗教礼仪来敬拜上帝。"
        }
      ]
    },
    "zht": {
      "preferred_label": "事奉（行禮儀）",
      "descriptions": [
        {
          "source": "acai",
          "description": "執行宗教禮儀作為敬拜上帝的方式。"
        }
      ]
    }
  },
