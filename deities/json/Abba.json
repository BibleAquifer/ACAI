          "gloss": "LORD",
          "article": "deity:Abba",
          "description": "An Aramaic word meaning “father” used by Jesus as a name for God (Mark 14:36)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Abba (Éternel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mot araméen signifiant « père », utilisé par Jésus pour désigner Dieu (Marc 14:36)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Abba (Señor)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Palabra aramea que significa «padre», usada por Jesús como nombre para referirse a Dios (Marcos 14:36)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "阿爸 (耶和华)",
      "descriptions": [
        {
          "source": "acai",
          "description": "一个意为“父亲”的亚兰语词，耶稣用作对上帝的称呼（马可福音 14:36）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Abba (Ubangiji)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata kalmar Aramiyanci mai ma’ana “uba” wadda Yesu ya yi amfani da ita a matsayin sunan Allah (Markus 14:36)."
        }
      ]
    },
    "hin": {
      "preferred_label": "अब्बा (यहोवा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अरामी शब्द जिसका अर्थ \\\"पिता\\\" है, जिसे यीशु ने परमेश्वर के नाम के रूप में प्रयोग किया (मरकुस 14:36)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Abba (TUHAN)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kata bahasa Aram yang berarti \\\"bapa\\\" yang digunakan oleh Yesus sebagai sebutan bagi Allah (Markus 14:36)."
        }
      ]
    },
    "por": {
      "preferred_label": "Aba (SENHOR)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma palavra aramaica que significa “pai”, usada por Jesus como um nome para Deus (Marcos 14:36)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Авва (Господь)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Арамейское слово, означающее «отец», употреблявшееся Иисусом как обращение к Богу (Марка 14:36)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Abba (BWANA)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neno la Kiaramu lenye maana ya “baba” lililotumiwa na Yesu kama jina la Mungu (Marko 14:36)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Aba (Bikpela)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela tok bilong tokples Aram i makim “papa” we Jisas i bin yusim olsem nem bilong God (Mak 14:36)."
        }
      ]
    },
    "apd": {
      "preferred_label": "أبا (الرب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كلمة آرامية معناها «أب» استعملها يسوع كاسم لله (مرقس ١٤: ٣٦)."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَبَا (الرَّبّ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كلمة آرامية تعني «الآب» استخدمها يسوع كاسم لله (مرقس 14: 36)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Aba (Hae God)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tok long lanwis Aramik we i min se “papa” we Jisas i yusum olsem wan nem blong God (Mak 14:36)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Abba (Onyenwe anyị)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Okwu nʼasụsụ Aram nke pụtara “nna” nke Jisọs ji mee ihe dị ka aha maka Chineke (Mak 14:36)."
        }
      ]
    },
    "nep": {
      "preferred_label": "अब्बा (परमप्रभु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरका लागि येशूले नाउँको रूपमा प्रयोग गर्नुभएको “पिता” अर्थ लाग्ने एउटा अरामी शब्द (मर्कूस १४:३६)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-ba (CHÚA)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một từ tiếng A-ram có nghĩa là “cha” được Chúa Giê-xu dùng làm danh xưng để gọi Đức Chúa Trời (Mác 14:36)."
        }
      ]
    },
    "zht": {
      "preferred_label": "阿爸 (耶和華)",
      "descriptions": [
        {
          "source": "acai",
          "description": "一個意為「父親」的亞蘭文字詞，耶穌用作對上帝的稱呼（馬可福音 14:36）。"
        }
      ]
    }
  },
