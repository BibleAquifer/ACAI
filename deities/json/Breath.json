      "descriptions": [
        {
          "source": "acai",
          "gloss": "Holy Spirit",
          "article": "deity:Breath",
          "description": "The Spirit of God is sometimes referred to as the “Breath” in the Old Testament (Numbers 27:18)."
        }
      ]
    },
    "arb": {
      "preferred_label": "ٱلرّوح (ٱلرّوحِ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "يُشار أحيانًا إلى روح الله بـ«ٱلرّوحِ» في العهد القديم (العدد 27: 18)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "气息 (圣灵)",
      "descriptions": [
        {
          "source": "acai",
          "description": "在旧约中，上帝的灵有时被称为“气息”（民数记27:18）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Numfashi (Ruhu Mai Tsarki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Akan kira Ruhun Allah “Numfashi” a wasu lokuta a Tsohon Alkawari (Litafin Lissafi 27:18)."
        }
      ]
    },
    "hin": {
      "preferred_label": "साँस (पवित्र आत्मा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "पुराने नियम (गिनती 27:18) में परमेश्वर की आत्मा को कभी-कभी “साँस” कहा गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Nafas (Roh Kudus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roh Allah kadang-kadang disebut sebagai \\\"Nafas\\\" dalam Perjanjian Lama (Bilangan 27:18)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Aliento (Espíritu Santo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A veces se hace referencia al Espíritu de Dios como el «Aliento» en el Antiguo Testamento (Números 27:18)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Pumzi (Roho Mtakatifu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roho wa Mungu wakati mwingine anarejelewa kama \\\"Pumzi\\\" katika Agano la Kale (Hesabu 27:18)."
        }
      ]
    },
    "apd": {
      "preferred_label": "النفخة (الروح القدس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "روح الله بتتم الإشارة ليها أحياناً بـ \"النفخة\" في العهد القديم (العدد ٢٧: ١٨)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Win (Tabu Spirit)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Spirit blong God samtaem oli singaotem hem se “Win blong Laef” o “Spesel Win” long Ol Testeman (Namba 27:18)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Souffle (Saint-Esprit)",
      "descriptions": [
        {
          "source": "acai",
          "description": "L'Esprit de Dieu est parfois appelé le « Souffle » dans l'Ancien Testament (Nombres 27:18)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ume (Mmụọ Nsọ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A na-ezo aka na Mmụọ nke Chineke mgbe ụfọdụ dị ka “Ume” nʼime Agba Ochie (Ọnụ Ọgụgụ 27:18)."
        }
      ]
    },
    "nep": {
      "preferred_label": "सास (पवित्र आत्मा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "पुरानो नियम (गन्ती २७:१८) मा परमेश्‍वरको आत्मालाई कहिलेकाहीँ “सास” भनेर उल्लेख गरिएको छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "Sopro (Espírito Santo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O Espírito de Deus é às vezes chamado de “Sopro” ou “Fôlego” no Antigo Testamento (Números 27:18)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дыхание (Святой Дух)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дух Божий иногда упоминается в Ветхом Завете как «Дыхание» (Числа 27:18)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Win (Holi Spirit)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sampela taim long Olpela Testamen ol i save kolim Spirit bilong God olsem “Win bilong laif” o “Win” (Namba 27:18)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Hơi Thở (Đức Thánh Linh)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thần Linh của Đức Chúa Trời đôi khi được nhắc đến là “Hơi thở” trong Cựu Ước (Dân Số Ký 27:18)."
        }
      ]
    },
    "zht": {
      "preferred_label": "氣息（聖靈）",
      "descriptions": [
        {
          "source": "acai",
          "description": "在舊約中，神的靈有時被稱為「氣息」（民數記 27:18）。"
        }
      ]
    }
  },
