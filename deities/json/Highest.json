  "localizations": {
    "eng": {
      "preferred_label": "Highest (LORD)",
      "alternate_labels": [
        "LORD"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "LORD",
          "article": "deity:Highest",
          "description": "A title for God; one who is supreme. This is primarily a reference to status."
        }
      ]
    },
    "fra": {
      "preferred_label": "Très-Haut (Éternel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un titre pour Dieu ; celui qui est suprême. Il s'agit principalement d'une référence à son rang."
        }
      ]
    },
    "spa": {
      "preferred_label": "Altísimo (Señor)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Título para Dios; aquel que es supremo. Es primordialmente una referencia a su condición."
        }
      ]
    },
    "arb": {
      "preferred_label": "العلي (الرب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "لقب لله؛ هو الأسمى والمطلق العلو. يشير في المقام الأول إلى المكانة والرفعة."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mafi Ɗaukaka (Ubangiji)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani laƙabi ne na Allah; wanda ya fi kowa girma. Wannan yana nufin matsayi ne musamman."
        }
      ]
    },
    "ind": {
      "preferred_label": "Yang Mahatinggi (Tuhan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gelar bagi Allah; Pribadi yang mahatinggi. Ini terutama merujuk pada status."
        }
      ]
    },
    "swh": {
      "preferred_label": "Aliye Juu Sana (BWANA)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kikomo au cheo cha Mungu; yule aliye mkuu kabisa. Hili kimsingi ni rejeleo la hadhi au ukuu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Antap Tru (Bikpela)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela nem o taitel bilong God; em i man i antap tru winim olgeta. Em i makim posisin na namba bilong em."
        }
      ]
    },
    "apd": {
      "preferred_label": "العلي (الرب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "لقب لله؛ العالي الأسمى. الإشارة دي في الأساس للمكانة والرفعة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hae we i hae (Hae God)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taetel blong God; hem we i hae olgeta. Hemia i minim hae posisen blong hem."
        }
      ]
    },
    "hin": {
      "preferred_label": "परमप्रधान (यहोवा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर की एक पदवी; वह जो सर्वोच्च है। यह मुख्य रूप से पद या स्थिति का संदर्भ है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye Kachasị Ihe Niile Elu (Onyenwe anyị)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aha nsọpụrụ maka Chineke; onye kachasị ihe niile elu. Nke a na-ezo aka nʼọkwa dị elu karịa ihe niile."
        }
      ]
    },
    "nep": {
      "preferred_label": "सर्वोच्च (परमप्रभु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको एक उपाधि; जो सर्वोच्च हुनुहुन्छ। यो मुख्यतया हैसियतलाई बुझाउने पदवी हो।"
        }
      ]
    },
    "por": {
      "preferred_label": "Altíssimo (SENHOR)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um título para Deus; aquele que é supremo. Esta é principalmente uma referência a posição ou status."
        }
      ]
    },
    "rus": {
      "preferred_label": "Всевышний (Господь)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Титул Бога; Тот, Кто является наивысшим. Указывает главным образом на статус."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đấng Chí Cao (Chúa Hằng Hữu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một danh hiệu của Đức Chúa Trời; Đấng tối cao. Đây chủ yếu là sự quy chiếu về vị thế tối thượng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "至高者 (耶和华)",
      "descriptions": [
        {
          "source": "acai",
          "description": "神的称号；至高无上的那位。这主要是指其地位。"
        }
      ]
    },
    "zht": {
      "preferred_label": "至高者（耶和華）",
      "descriptions": [
        {
          "source": "acai",
          "description": "上帝的頭銜；至高無上的那一位。這主要是指地位而言。"
        }
      ]
    }
  },
