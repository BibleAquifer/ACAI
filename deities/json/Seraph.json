  "localizations": {
    "eng": {
      "preferred_label": "Seraph",
      "alternate_labels": [
        "Seraphim"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Seraph",
          "article": "deity:Seraph",
          "description": "Fiery, six-winged creatures suspended above the throne of God in Isaiah (6:2, 6)."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَرَافِيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "مخلوقات نارية ذات ستة أجنحة واقفة فوق عرش الله في سفر إشعياء (٦: ٢، ٦)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "撒拉弗",
      "descriptions": [
        {
          "source": "acai",
          "description": "以赛亚书（6:2, 6）中悬于神宝座之上有六个翅膀的火焰生物。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Seraf",
      "descriptions": [
        {
          "source": "acai",
          "description": "Halittu masu wuta, masu fikafikai shida da aka dakatar a bisa gadon sarautar Allah a littafin Ishaya (6:2, 6)."
        }
      ]
    },
    "hin": {
      "preferred_label": "साराप",
      "descriptions": [
        {
          "source": "acai",
          "description": "यशायाह (6:2, 6) में परमेश्वर के सिंहासन के ऊपर स्थित अग्नि-सदृश, छः पंखों वाले प्राणी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Serafim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Makhluk berapi dengan enam sayap yang melayang-layang di atas takhta Allah dalam Yesaya (6:2, 6)."
        }
      ]
    },
    "por": {
      "preferred_label": "Serafim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Criaturas de fogo, de seis asas, suspensas acima do trono de Deus em Isaías (6:2, 6)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Серафим",
      "descriptions": [
        {
          "source": "acai",
          "description": "Огненные шестикрылые существа, парящие над престолом Бога в Книге пророка Исаии (6:2, 6)."
        }
      ]
    },
    "spa": {
      "preferred_label": "serafín",
      "descriptions": [
        {
          "source": "acai",
          "description": "Criaturas ardientes de seis alas suspendidas sobre el trono de Dios en Isaías (6:2, 6)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Serafi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Viumbe vyenye mabawa sita vya moto vilivyokuwa vikielea juu ya kiti cha enzi cha Mungu katika Isaya (6:2, 6)."
        }
      ]
    },
    "apd": {
      "preferred_label": "ساروف",
      "descriptions": [
        {
          "source": "acai",
          "description": "مخلوقات نارية عندها ستة أجنحة واقفة فوق عرش الله في إشعياء (6: 2، 6)."
        }
      ]
    },
    "bis": {
      "preferred_label": "seraf",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol kriel we oli olsem faea mo oli gat sikis wing we oli stap stanap antap long jea blong king blong God long buk blong Aesea (6:2, 6)."
        }
      ]
    },
    "fra": {
      "preferred_label": "séraphin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Créatures brûlantes à six ailes suspendues au-dessus du trône de Dieu dans Ésaïe (6.2, 6)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Seraf",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe e kere eke nwere nku isii, nke na-enwu dị ka ọkụ ma na-efegharị nʼelu ocheeze Chineke nʼakwụkwọ Aịzaya (6:2, 6)."
        }
      ]
    },
    "nep": {
      "preferred_label": "सराफ",
      "descriptions": [
        {
          "source": "acai",
          "description": "यशैया (६:२, ६) मा परमेश्‍वरको सिंहासनमाथि रहेका छ-छवटा पखेटा भएका अग्निमय प्राणीहरू।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Serafim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol bikpela ensel i lait olsem paia na i gat 6-pela wing, em ol i sanap antap long sia king bilong God long buk Aisaia (6:2, 6)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-ra-phim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Các tạo vật rực lửa, có sáu cánh lơ lửng bên trên ngai của Đức Chúa Trời trong sách Ê-sai (6:2, 6)."
        }
      ]
    },
    "zht": {
      "preferred_label": "撒拉弗",
      "descriptions": [
        {
          "source": "acai",
          "description": "《以賽亞書》（6:2、6）中懸於神寶座之上的六翼有火的活物。"
        }
      ]
    }
  },
