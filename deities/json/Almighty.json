      "007212001001000"
    ],
    "tipnr": [
      "Almighty|LORD@Gen.1.1-Heb"
    ]
  },
  "type": "deity",
  "deity_type": "deity",
  "ubsdbh": [
    "007212001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Almighty (LORD)",
      "alternate_labels": [
        "El Shaddai",
        "LORD"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "LORD",
          "article": "deity:Almighty",
          "description": "An alternate name for the God of Israel meaning “All-sufficient One” or “the One every good and perfect gift comes from.”"
        }
      ]
    },
    "fra": {
      "preferred_label": "Tout-Puissant (Éternel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Autre nom du Dieu d'Israël signifiant « Celui qui se suffit à lui-même » ou « Celui de qui vient tout don bon et parfait »."
        }
      ]
    },
    "spa": {
      "preferred_label": "Todopoderoso (Señor)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nombre alternativo para el Dios de Israel que significa «el Todopoderoso» o «Aquel de quien proviene toda dádiva buena y perfecta»."
        }
      ]
    },
    "arb": {
      "preferred_label": "الْقَدِير (ٱلرَّبّ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اسمٌ بديل لإله إسرائيل معناه «الكافي لكلّ شيء» أو «الذي منه تأتي كلّ عطية صالحة وتامّة»."
        }
      ]
    },
    "zhs": {
      "preferred_label": "全能者 (耶和华)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列上帝的别称，意为“全足者”或“各样美好和完美恩赐的赐予者”。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Maɗaukaki (Ubangiji)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani sunan daban na Allah na Isra’ila mai ma’anar “Wanda Ya wadatar da duka” ko kuma “Wanda dukan kyauta mai kyau da cikakkiya take fitowa daga gare shi.”"
        }
      ]
    },
    "hin": {
      "preferred_label": "सर्वशक्तिमान (यहोवा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएल के परमेश्वर का एक वैकल्पिक नाम जिसका अर्थ है “सर्व-समर्थ” या “वह जिससे प्रत्येक उत्तम और सिद्ध दान आता है।”"
        }
      ]
    },
    "ind": {
      "preferred_label": "Mahakuasa (Tuhan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nama lain bagi Allah Israel yang berarti ”Maha Mencukupi” atau ”Pribadi asal segala pemberian yang baik dan sempurna”."
        }
      ]
    },
    "por": {
      "preferred_label": "Todo-poderoso (SENHOR)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um nome alternativo para o Deus de Israel que significa “Aquele que é todo-suficiente” ou “Aquele de quem vem todo dom bom e perfeito”."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwenyezi (BWANA)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jina jingine la Mungu wa Israeli lenye maana ya “Yule anayetosha kwa yote” au “Yule ambaye kila karama nzuri na kamilifu hutoka kwake.”"
        }
      ]
    },
    "apd": {
      "preferred_label": "القدير (الرب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اسم بديل لإله إسرائيل معناه \\\"الكافي كلو\\\" أو \\\"الواحد البتجي منو كل عطية كويسة وكاملة\\\"."
        }
      ]
    },
    "bis": {
      "preferred_label": "God we i gat olgeta paoa (Hae God)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan narafala nem blong God blong Isrel we i min se “God we i gat olgeta paoa mo evri samting” o “God ya we evri gudfala presen oli kamaot long hem”."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye Pụrụ Ime Ihe Niile (Onyenwe anyị)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aha ọzọ maka Chineke nke Izrel nke pụtara “Onye zuru ezu nʼonwe ya” maọbụ “Onye onyinye ọma niile na nke zuru oke si nʼaka ya na-abịa.”"
        }
      ]
    },
    "nep": {
      "preferred_label": "सर्वशक्तिमान् (परमप्रभु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलका परमेश्‍वरको अर्को नाउँ जसको अर्थ “सबै कुरामा पर्याप्त हुनुहुने” वा “हरेक असल र सिद्ध वरदान आउने एकमात्र स्रोत” भन्‍ने हुन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Всемогущий (Господь)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Другое имя Бога Израиля, означающее «Вседовольный» или «Тот, от Кого исходит всякий добрый и совершенный дар»."
        }
      ]
    },
    "tpi": {
      "preferred_label": "I Gat Olgeta Strong (Bikpela)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Narapela nem bilong God bilong Israel, as bilong en i olsem “Em i gat olgeta samting inap long helpim man” o “Man bilong givim olgeta gutpela presen stret.”"
        }
      ]
    },
    "vie": {
      "preferred_label": "Đấng Toàn Năng (CHÚA)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một danh xưng khác của Đức Chúa Trời của Y-sơ-ra-ên, có nghĩa là “Đấng Toàn Hảo Tự Hữu” hoặc “Đấng ban phát mọi ơn lành trọn vẹn”."
        }
      ]
    },
    "zht": {
      "preferred_label": "全能者 (耶和華)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列上帝的別名，意思是「全足者」或「一切美善與完全恩賜之源頭」。"
        }
      ]
    }
  },
