        }
      ]
    },
    "tpi": {
      "preferred_label": "Rimon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela god bilong ol Siria, em Naman i bin lotu long en, em man Elisa i bin oraitim sik lepra bilong en."
        }
      ]
    },
    "apd": {
      "preferred_label": "رمون",
      "descriptions": [
        {
          "source": "acai",
          "description": "إله للآراميين (السوريين)، كان بيعبده نعمان السرياني اللي شفاه أليشع من البرص."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rimon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan god blong ol man Siria, we Naman we Elisa i bin hilim hem long lepra i stap wosipim."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Rimọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chi nke ndị Siria, nke Neeman onye Elisha gwọrọ ekpenta fere."
        }
      ]
    },
    "nep": {
      "preferred_label": "रिम्मोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिरियालीहरूका एक देवता, जसलाई एलीशाद्वारा कुष्ठरोग निको पारिएका नामानले पूजा गर्थे।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Rim-môn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vị thần của người Sy-ri, được Na-a-man thờ phượng trước khi được Ê-li-sê chữa lành bệnh phong hủi."
        }
      ]
    },
    "zht": {
      "preferred_label": "臨門",
      "descriptions": [
        {
          "source": "acai",
          "description": "敘利亞人的神祇，由被以利沙治好大麻風的乃縵所敬拜。"
        }
      ]
    }
