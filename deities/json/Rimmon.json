        }
      ]
    },
    "por": {
      "preferred_label": "Rimom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um deus dos sírios, adorado por Naamã, a quem Eliseu curou da lepra."
        }
      ]
    },
    "rus": {
      "preferred_label": "Риммон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Бог сирийцев, которому поклонялся Нееман, исцеленный Елисеем от проказы."
        }
      ]
    },
    "spa": {
      "preferred_label": "Rimón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dios de los sirios, adorado por Naamán, a quien Eliseo sanó de lepra."
        }
      ]
    },
    "swh": {
      "preferred_label": "Rimoni",
      "descriptions": [
        {
          "source": "acai",
