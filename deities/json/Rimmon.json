          "description": "إله للآراميين (السوريين)، كان يعبده نعمان الذي شفاه أليشع من البرص."
        }
      ]
    },
    "zhs": {
      "preferred_label": "临门",
      "descriptions": [
        {
          "source": "acai",
          "description": "叙利亚人的一个神明，被以利沙治好大麻风的乃缦曾敬拜它。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Rimmon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dieu des Syriens, adoré par Naaman qu’Élisée guérit de la lèpre."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rimmon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani allahn mutanen Siriya, wanda Na’aman wanda Elisha ya warkar da shi daga kuturta ya bauta masa."
        }
      ]
    },
    "hin": {
      "preferred_label": "रिम्मोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरामियों (सीरियाइयों) का एक देवता, जिसकी उपासना नामान करता था जिसे एलीशा ने कोढ़ से चंगा किया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Rimon",
      "descriptions": [
        {
