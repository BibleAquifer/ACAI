  "localizations": {
    "eng": {
      "preferred_label": "God Most High (LORD)",
      "alternate_labels": [
        "most high God",
        "LORD"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "LORD",
          "article": "deity:GodMostHigh",
          "description": "Another name for God; Melchizedek was named as priest of “God Most High.”"
        }
      ]
    },
    "arb": {
      "preferred_label": "الله العلي (الرب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اسم آخر لله؛ ذُكر ملكي صادق بوصفه كاهنًا لـ «الله العلي»."
        }
      ]
    },
    "zhs": {
      "preferred_label": "至高神 (耶和华)",
      "descriptions": [
        {
          "source": "acai",
          "description": "神的另一个名字；麦基洗德被称为“至高神”的祭司。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Dieu Très-Haut (Éternel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Autre nom de Dieu ; Melchisédek est qualifié de sacrificateur du « Dieu Très-Haut »."
        }
      ]
    },
    "hau": {
      "preferred_label": "Allah Mafi Ɗaukaka (Ubangiji)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani suna na Allah; an ambaci Melkizedek a matsayin firist na “Allah Mafi Ɗaukaka.”"
        }
      ]
    },
    "ind": {
      "preferred_label": "Allah Yang Mahatinggi (Tuhan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nama lain untuk Allah; Melkisedek disebut sebagai imam \\\"Allah Yang Mahatinggi\\\"."
        }
      ]
    },
    "rus": {
      "preferred_label": "Бог Всевышний (Господь)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Другое имя Бога; Мелхиседек назван священником «Бога Всевышнего»."
        }
      ]
    },
    "spa": {
      "preferred_label": "Dios Altísimo (Señor)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otro nombre para Dios; Melquisedec fue designado como sacerdote del «Dios Altísimo»."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mungu Aliye Juu Sana (BWANA)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jina jingine la Mungu; Melkizedeki alitajwa kuwa kuhani wa “Mungu Aliye Juu Sana.”"
        }
      ]
    },
    "tpi": {
      "preferred_label": "God Antap Tru (Bikpela)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Narapela nem bilong God; Melkisedek i bin stap olsem pris bilong “God Antap Tru.”"
        }
      ]
    },
    "apd": {
      "preferred_label": "الله العلي (الرب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اسم تاني لله؛ اتذكر ملكي صادق ككاهن لـ «الله العلي»."
        }
      ]
    },
    "bis": {
      "preferred_label": "God ya we i hae we i hae (Hae God)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan narafala nem blong God; Melkisedek i bin pris blong “God ya we i hae we i hae”."
        }
      ]
    },
    "hin": {
      "preferred_label": "परमप्रधान परमेश्वर (यहोवा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर का एक अन्य नाम; मलिकिसिदक को “परमप्रधान परमेश्वर” का याजक कहा गया था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Chineke nke Kachasị Ihe Niile Elu (Onyenwe anyị)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aha ọzọ maka Chineke; a kpọrọ Melkizedek onye nchụaja nke “Chineke nke kachasị ihe niile elu.”"
        }
      ]
    },
    "nep": {
      "preferred_label": "सर्वोच्च परमेश्‍वर (परमप्रभु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्‍वरको अर्को नाम; मल्कीसेदेकलाई “सर्वोच्च परमेश्‍वर” का पूजाहारी भनिएको थियो।"
        }
      ]
    },
    "por": {
      "preferred_label": "Deus Altíssimo (SENHOR)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Outro nome para Deus; Melquisedeque foi chamado de sacerdote do “Deus Altíssimo”."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đức Chúa Trời Chí Cao (Chúa Hằng Hữu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một danh xưng khác của Đức Chúa Trời; Mên-chi-xê-đéc được gọi là thầy tế lễ của “Đức Chúa Trời Chí Cao”."
        }
      ]
    },
    "zht": {
      "preferred_label": "至高上帝（耶和華）",
      "descriptions": [
        {
          "source": "acai",
          "description": "上帝的另一個名稱；麥基洗德被稱為「至高上帝」的祭司。"
        }
      ]
    }
  },
