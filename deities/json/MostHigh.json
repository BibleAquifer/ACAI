  "localizations": {
    "eng": {
      "preferred_label": "Most High (LORD)",
      "alternate_labels": [
        "Highest",
        "LORD"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "LORD",
          "article": "deity:MostHigh",
          "description": "A name of God that establishes God's position as the highest or most exalted among all deities."
        }
      ]
    },
    "arb": {
      "preferred_label": "العلي (الرب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اسم لله يثبت مكانته بصفته الأعلى أو الأكثر رفعة بين جميع الآلهة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "至高者 (耶和华)",
      "descriptions": [
        {
          "source": "acai",
          "description": "上帝的一个称号，表明上帝在所有神明中至高、最尊崇的地位。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Mafi Ɗaukaka (Ubangiji)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani sunan Allah wanda ke tabbatar da matsayin Allah a matsayin mafi girma ko mafi ɗaukaka a cikin dukan alloli."
        }
      ]
    },
    "hin": {
      "preferred_label": "परमप्रधान (यहोवा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर का एक नाम जो सभी देवताओं के बीच परमेश्वर की स्थिति को सर्वोच्च या सबसे उन्नत स्थापित करता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Mahatinggi (Tuhan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suatu nama Allah yang menetapkan kedudukan Allah sebagai yang tertinggi atau paling diagungkan di antara segala ilah."
        }
      ]
    },
    "por": {
      "preferred_label": "Altíssimo (SENHOR)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um nome de Deus que estabelece a Sua posição como o mais alto ou mais exaltado entre todas as divindades."
        }
      ]
    },
    "rus": {
      "preferred_label": "Всевышний (Господь)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Имя Бога, утверждающее Его положение как наивысшего или самого превознесенного среди всех божеств."
        }
      ]
    },
    "spa": {
      "preferred_label": "Altísimo (Jehová)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un nombre de Dios que establece la posición de Dios como el más alto o más exaltado entre todas las deidades."
        }
      ]
    },
    "swh": {
      "preferred_label": "Aliye Juu Sana (BWANA)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jina la Mungu linalothibitisha nafasi ya Mungu kuwa aliye juu zaidi au aliyetukuka zaidi kati ya miungu yote."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Antap Tru (Bikpela)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela nem bilong God i soim olsem God i stap antap tru o bikpela tru winim olgeta arapela god."
        }
      ]
    },
    "apd": {
      "preferred_label": "العلي (الرب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اسم من أسماء الله يبيّن مكانة الله كالأعلى أو الأرفع بين كل الآلهة."
        }
      ]
    },
    "bis": {
      "preferred_label": "God we i Hae We i Hae (Hae God)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan nem blong God we i soemaot se hem i hae olgeta bitim olgeta narafala god."
        }
      ]
    },
    "fra": {
      "preferred_label": "Très-Haut (Éternel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nom de Dieu qui établit sa position suprême ou la plus élevée parmi toutes les divinités."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye kachasị ihe niile elu (Onyenwe anyị)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aha Chineke nke na-egosi ọnọdụ Chineke dịka Onye kachasị elu ma ọ bụ Onye e buliri elu karịa chi niile."
        }
      ]
    },
    "nep": {
      "preferred_label": "सर्वोच्च (परमप्रभु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "सबै देवताहरूमध्ये परमेश्‍वरको स्थानलाई सर्वोच्च वा सबैभन्दा उच्च भनेर स्थापित गर्ने परमेश्‍वरको एक नाउँ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Đấng Tối Cao (Đức Giê-hô-va)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một danh hiệu của Đức Chúa Trời xác lập vị trí của Ngài là Đấng tối cao hoặc được tôn cao nhất trong tất cả các thần."
        }
      ]
    },
    "zht": {
      "preferred_label": "至高者 (耶和華)",
      "descriptions": [
        {
          "source": "acai",
          "description": "上帝的一個稱號，確立了上帝在所有神祇中最高或最尊貴的地位。"
        }
      ]
    }
  },
