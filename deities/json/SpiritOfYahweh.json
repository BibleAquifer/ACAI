  "localizations": {
    "eng": {
      "preferred_label": "Spirit of Yahweh (Holy Spirit)",
      "alternate_labels": [
        "Holy Spirit"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Holy Spirit",
          "article": "deity:SpiritOfYahweh",
          "description": "The Holy Spirit as an agent of God that provides wisdom, counsel, and knowledge (Isaiah 11:2)."
        }
      ]
    },
    "arb": {
      "preferred_label": "روح الرب (الروح القدس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الروح القدس بوصفه عاملاً من عند الله يمنح الحكمة والمشورة والمعرفة (إشعياء ١١: ٢)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耶和华的灵 (圣灵)",
      "descriptions": [
        {
          "source": "acai",
          "description": "圣灵作为神的代表，赐予智慧、谋略和知识（以赛亚书 11:2）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ruhun Ubangiji (Ruhu Mai Tsarki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ruhu Mai Tsarki a matsayin mai aiki na Allah wanda ke ba da hikima, shawara, da ilimi (Ishaya 11:2)."
        }
      ]
    },
    "ind": {
      "preferred_label": "Roh TUHAN (Roh Kudus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roh Kudus sebagai perantara Allah yang memberikan hikmat, nasihat, dan pengetahuan (Yesaya 11:2)."
        }
      ]
    },
    "por": {
      "preferred_label": "Espírito do SENHOR (Espírito Santo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O Espírito Santo como um agente de Deus que concede sabedoria, conselho e conhecimento (Isaías 11:2)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Espíritu de Yahvé (Espíritu Santo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "El Espíritu Santo como un agente de Dios que proporciona sabiduría, consejo y conocimiento (Isaías 11:2)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Roho wa Yahwe (Roho Mtakatifu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roho Mtakatifu kama mtendaji wa Mungu anayetoa hekima, shauri, na maarifa (Isaya 11:2)."
        }
      ]
    },
    "apd": {
      "preferred_label": "روح الرب (الروح القدس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الروح القدس كوكيل لله بيدي حكمة ومشورة ومعرفة (إشعياء 11: 2)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Spirit blong Hae God (Tabu Spirit)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tabu Spirit olsem wan wokman blong God we i stap givim waes, gudfala toktok, mo save (Aesea 11:2)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Esprit de l’Éternel (Saint-Esprit)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le Saint-Esprit en tant qu’agent de Dieu qui donne la sagesse, le conseil et la connaissance (Ésaïe 11.2)."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहोवा की आत्मा (पवित्र आत्मा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "परमेश्वर के एक साधन के रूप में पवित्र आत्मा जो बुद्धि, युक्ति और ज्ञान प्रदान करती है (यशायाह 11:2)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mmụọ nke Onyenwe anyị (Mmụọ Nsọ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmụọ Nsọ dị ka onye na-anọchi anya Chineke na-enye amamihe, ndụmọdụ, na ihe ọmụma (Aịzaya 11:2)."
        }
      ]
    },
    "nep": {
      "preferred_label": "परमप्रभुको आत्मा (पवित्र आत्मा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "बुद्धि, समझ र ज्ञान प्रदान गर्ने परमेश्‍वरको प्रतिनिधिको रूपमा पवित्र आत्मा (यशैया ११:२)।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Дух Господень (Святой Дух)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Святой Дух как действенная сила Бога, дарующая мудрость, совет и знание (Исаия 11:2)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Spirit bilong Bikpela (Holi Spirit)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Holi Spirit olsem wanpela wokman bilong God em i save givim gutpela save, tingting, na save bilong mekim samting (Aisaia 11:2)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thần của Đức Giê-hô-va (Đức Thánh Linh)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đức Thánh Linh với tư cách là tác nhân của Đức Chúa Trời, Đấng ban sự khôn ngoan, mưu lược và tri thức (Ê-sai 11:2)."
        }
      ]
    },
    "zht": {
      "preferred_label": "耶和華的靈 (聖靈)",
      "descriptions": [
        {
          "source": "acai",
          "description": "作為神的使者，賜予智慧、謀略和知識的聖靈（以賽亞書 11:2）。"
        }
      ]
    }
  },
