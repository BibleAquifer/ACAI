  "localizations": {
    "eng": {
      "preferred_label": "Monitor",
      "alternate_labels": [
        "Iguana"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Monitor",
          "article": "fauna:Iguana",
          "description": "A large lizard found in various habitats, known for its long body and powerful legs."
        }
      ]
    },
    "apd": {
      "preferred_label": "الورل",
      "descriptions": [
        {
          "source": "acai",
          "description": "سحلية كبيرة بتعيش في بيئات مختلفة، معروفة بجسمها الطويل وكرعينها القويات."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَرَل",
      "descriptions": [
        {
          "source": "acai",
          "description": "سحلية ضخمة تعيش في بيئات متنوعة، تشتهر بجسمها الطويل وأرجلها القوية."
        }
      ]
    },
    "bis": {
      "preferred_label": "bigfala lised",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala lised we i laef long plante defren kaen ples, we i gat longfala bodi mo ol strongfala leg."
        }
      ]
    },
    "fra": {
      "preferred_label": "varan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grand lézard présent dans divers habitats, reconnaissable à son long corps et à ses pattes puissantes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Damo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban ƙadangare da ake samu a wurare daban-daban, wanda aka sani da dogon jiki da ƙaƙƙarfan ƙafafu."
        }
      ]
    },
    "hin": {
      "preferred_label": "गोह",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभिन्न पर्यावासों में पाई जाने वाली एक बड़ी छिपकली, जो अपने लंबे शरीर और शक्तिशाली पैरों के लिए जानी जाती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ngwere aghụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu ngwere a na-ahụ nʼebe dị iche iche, nke a maara maka ogologo ahụ ya na ụkwụ siri ike."
        }
      ]
    },
    "ind": {
      "preferred_label": "biawak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kadal besar yang ditemukan di berbagai habitat, dikenal dengan tubuhnya yang panjang dan kakinya yang kuat."
        }
      ]
    },
    "nep": {
      "preferred_label": "गोहोरो",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफ्नो लामो शरीर र शक्तिशाली खुट्टाहरूका लागि परिचित, विभिन्न बासस्थानहरूमा पाइने एक ठूलो छेपारो।"
        }
      ]
    },
    "por": {
      "preferred_label": "lagarto-monitor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grande lagarto encontrado em vários habitats, conhecido por seu corpo comprido e pernas poderosas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Варан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупная ящерица, обитающая в различных средах, известная своим длинным телом и мощными лапами."
        }
      ]
    },
    "spa": {
      "preferred_label": "varano",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lagarto grande que se encuentra en diversos hábitats, conocido por su cuerpo alargado y sus patas poderosas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kenge",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mjusi mkubwa anayepatikana katika makazi mbalimbali, anayejulikana kwa mwili mrefu na miguu yenye nguvu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bikpela palai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela palai i save stap long planti kain ples, em i gat longpela bodi na ol strongpela lek."
        }
      ]
    },
    "vie": {
      "preferred_label": "kỳ đà",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài thằn lằn lớn sống ở nhiều môi trường sống khác nhau, được biết đến với thân hình dài và các chi khỏe mạnh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "巨蜥",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种生活在多种栖息地的大型蜥蜴，以身体细长、四肢强健著称。"
        }
      ]
    },
    "zht": {
      "preferred_label": "巨蜥",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種棲息於多種生境的大型蜥蜴，以其長身軀和強健的四肢著稱。"
        }
      ]
    }
  },
