  "localizations": {
    "eng": {
      "preferred_label": "Leviathan",
      "alternate_labels": [
        "Giant Sea Monster",
        "Giant Crocodile"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Leviathan",
          "article": "fauna:GiantCroccodile",
          "description": "An uncertain giant sea creature or serpent, sometimes confused with a jackal."
        }
      ]
    },
    "apd": {
      "preferred_label": "لوياثان",
      "descriptions": [
        {
          "source": "acai",
          "description": "كائن بحري ضخم أو حية ما معروفة بالتحديد، وأحياناً بيلخبطوا بينها وبين ابن آوى."
        }
      ]
    },
    "arb": {
      "preferred_label": "لَوِيَاثَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "مخلوق بحري أو حية عملاقة غير محددة بدقة، يُخلط أحيانًا بينها وبين ابن آوى."
        }
      ]
    },
    "bis": {
      "preferred_label": "Leviatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala anamol blong solwota no snek we man i no sua gud long hem, we samtaem oli stap konfiusim wetem jakal."
        }
      ]
    },
    "fra": {
      "preferred_label": "Léviathan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Créature marine géante ou serpent mythique d’identification incertaine, parfois confondu avec un chacal."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dodon ruwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙaton halittar teku ko maciji wadda ba a tabbatar da ita ba, wani lokaci ana rikita ta da dila ko wata dabbar daji."
        }
      ]
    },
    "hin": {
      "preferred_label": "लिव्यातान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अनिश्चित विशाल समुद्री जीव या सर्प, जिसे कभी-कभी सियार समझ लिया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Leviatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anụ mmiri maọbụ agwọ buru ibu nke a na-amaghị nke ọma, nke a na-echegharị mgbe ụfọdụ dị ka nkịta ọhịa."
        }
      ]
    },
    "ind": {
      "preferred_label": "Lewiatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Makhluk laut raksasa atau ular naga yang tidak pasti, kadang-kadang disamakan dengan serigala."
        }
      ]
    },
    "nep": {
      "preferred_label": "लिव्यातन्",
      "descriptions": [
        {
          "source": "acai",
          "description": "समुद्रको एउटा अनिश्चित विशाल जीव वा सर्प, कहिलेकाहीँ स्यालसँग झुक्किने।"
        }
      ]
    },
    "por": {
      "preferred_label": "Leviatã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma criatura marinha gigante incerta ou serpente, por vezes confundida com um chacal."
        }
      ]
    },
    "rus": {
      "preferred_label": "Левиафан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Неопределенное гигантское морское существо или змей, иногда отождествляемое с шакалом."
        }
      ]
    },
    "spa": {
      "preferred_label": "Leviatán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Criatura o serpiente marina gigante e incierta, a veces confundida con un chacal."
        }
      ]
    },
    "swh": {
      "preferred_label": "Lewiathani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kiumbe mkubwa wa baharini au joka asiyejulikana vizuri, ambaye wakati mwingine huchanganywa na mbweha."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Leviatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela binatang o snek bilong solwara ol i no save gut long en, sampela taim ol i save paulim wantaim wel dok."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lê-vi-a-than",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một quái vật biển hoặc loài rắn khổng lồ chưa được xác định chắc chắn, đôi khi bị nhầm lẫn với chó rừng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "鳄鱼",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种不确定的巨型海生动物或巨蛇，有时与豺混淆。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鱷魚",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種不確定的巨型海獸或蛇怪，有時與豺混淆。"
        }
      ]
    }
  },
