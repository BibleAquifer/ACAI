  "localizations": {
    "eng": {
      "preferred_label": "Locust",
      "alternate_labels": [
        "Grasshopper",
        "Young Locust",
        "Katydid"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Locust",
          "article": "fauna:Locust",
          "description": "A six-legged insect that moves in swarms and eats plants, and is sometimes used for food."
        }
      ]
    },
    "apd": {
      "preferred_label": "جراد",
      "descriptions": [
        {
          "source": "acai",
          "description": "حشرة عندها ستة كرعين بتتحرك في أسراب وبتاكل النباتات، وأحياناً بتتاكل."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَرَاد",
      "descriptions": [
        {
          "source": "acai",
          "description": "حشرة ذات ستة أرجل تتحرك في أسراب وتأكل النباتات، وتُستخدم أحيانًا كطعام."
        }
      ]
    },
    "bis": {
      "preferred_label": "lokis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan insek we i gat sikis leg, we i stap flae long bigfala hip mo i kakae ol lif mo garen, mo sam taem ol man oli save kakae hem tu."
        }
      ]
    },
    "fra": {
      "preferred_label": "sauterelle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Insecte à six pattes qui se déplace en essaims et dévore les plantes, parfois consommé comme nourriture."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fāra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kwaro mai ƙafafu shida wanda yake yawo a cikin gungunsu kuma yana cin shuke-shuke, wani lokaci kuma ana cinsa a matsayin abinci."
        }
      ]
    },
    "hin": {
      "preferred_label": "टिड्डी",
      "descriptions": [
        {
          "source": "acai",
          "description": "छह पैरों वाला एक कीट जो झुंडों में चलता है और पौधों को खाता है, और कभी-कभी भोजन के रूप में उपयोग किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Igurube",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụmụ ahụhụ nwere ụkwụ isii na-agakọ nʼìgwè ma na-eri ahịhịa na ihe ọkụkụ, nke a na-erikwa mgbe ụfọdụ dị ka nri."
        }
      ]
    },
    "ind": {
      "preferred_label": "belalang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Serangga berkaki enam yang bergerak dalam kawanan dan memakan tanaman, dan kadang-kadang digunakan sebagai makanan."
        }
      ]
    },
    "nep": {
      "preferred_label": "सलह",
      "descriptions": [
        {
          "source": "acai",
          "description": "छवटा खुट्टा भएको कीरा, जो बथानमा हिँड्छ र वनस्पति खान्छ, अनि कहिलेकाहीँ खानाको रूपमा पनि प्रयोग गरिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "Gafanhoto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um inseto de seis patas que se desloca em enxames e se alimenta de plantas, sendo às vezes usado como alimento."
        }
      ]
    },
    "rus": {
      "preferred_label": "Саранча",
      "descriptions": [
        {
          "source": "acai",
          "description": "Шестиногое насекомое, перемещающееся стаями и поедающее растительность; иногда употребляется в пищу."
        }
      ]
    },
    "spa": {
      "preferred_label": "langosta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Insecto de seis patas que se desplaza en enjambres y come plantas, y que a veces se utiliza como alimento."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nzige",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mdudu mwenye miguu sita anayetembea katika makundi na kula mimea, na wakati mwingine hutumiwa kama chakula."
        }
      ]
    },
    "tpi": {
      "preferred_label": "grasopa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela binatang i gat 6-pela lek i save flai wantaim long bikpela lain na kaikai ol samting i gat lip, na sampela taim ol man i save kaikai ol."
        }
      ]
    },
    "vie": {
      "preferred_label": "châu chấu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài côn trùng sáu chân di chuyển theo đàn và ăn thực vật, đôi khi được dùng làm thực phẩm."
        }
      ]
    },
    "zhs": {
      "preferred_label": "蝗虫",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种六足昆虫，成群活动并吞食植物，有时也可作食物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "蝗蟲",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種成群活動並以植物為食的六足昆蟲，有時被用作食物。"
        }
      ]
    }
  },
