        }
      ]
    },
    "bis": {
      "preferred_label": "mot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol insekt we i save kakae mo spolem klos, we long Baebol hem i pija blong roten fasin mo spael."
        }
      ]
    },
    "fra": {
      "preferred_label": "teigne",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un petit insecte connu pour détruire les vêtements et symboliser le dépérissement et la ruine dans la Bible."
        }
      ]
    },
    "hau": {
      "preferred_label": "Asu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙaramin ƙwaro, da aka sani da ɓata tufafi kuma yake nuna alamar ruɓewa da halaka a cikin Littafi Mai Tsarki."
        }
      ]
    },
    "hin": {
      "preferred_label": "पतंगा (घुन)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक छोटा कीड़ा (पतंगा), जो कपड़ों को नुकसान पहुँचाने के लिए जाना जाता है और बाइबल में सड़न और विनाश का प्रतीक है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nla",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere anụ ahụhụ, nke a maara maka ibibi uwe na-anọchikwa anya ire ure na mbibi na Baịbụl."
        }
      ]
    },
    "ind": {
      "preferred_label": "ngengat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Serangga kecil yang dikenal merusak pakaian dan melambangkan pembusukan serta kehancuran di dalam Alkitab."
        }
      ]
    },
    "nep": {
      "preferred_label": "पुतली",
      "descriptions": [
        {
          "source": "acai",
          "description": "लुगाहरू बिगार्नका लागि परिचित र बाइबलमा सडन र विनाशको प्रतीक मानिएको एउटा सानो कीरा।"
        }
      ]
    },
    "por": {
      "preferred_label": "traça",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um pequeno inseto conhecido por danificar roupas e que simboliza a decadência e a ruína na Bíblia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Моль",
      "descriptions": [
        {
          "source": "acai",
          "description": "Мелкое насекомое, известное тем, что портит одежду, и символизирующее в Библии тление и разорение."
        }
      ]
    },
    "spa": {
      "preferred_label": "polilla",
      "descriptions": [
        {
          "source": "acai",
          "description": "Insecto pequeño, conocido por dañar la ropa y por simbolizar descomposición y ruina en la Biblia."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nondo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mdudu mdogo, anayejulikana kwa kuharibu nguo na kuashiria kuoza na maangamizi katika Biblia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "binatang bilong kaikai klos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik binatang i save bagarapim klos, na Baibel i yusim em olsem piksa bilong sting na bagarap."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bướm đêm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài côn trùng nhỏ, nổi tiếng vì cắn hại quần áo và là biểu tượng của sự mục nát và tàn phá trong Kinh Thánh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "蛀虫",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种小昆虫，以蛀蚀衣物著称，在圣经中象征腐坏与毁灭。"
        }
      ]
    },
    "zht": {
      "preferred_label": "蛀蟲",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種小型昆蟲，因毀壞衣物而為人所知，在聖經中象徵朽壞與毀滅。"
        }
      ]
    }
  },
