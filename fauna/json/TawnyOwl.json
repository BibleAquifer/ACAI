  "localizations": {
    "eng": {
      "preferred_label": "Tawny Owl",
      "alternate_labels": [
        "Owl"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Tawny Owl",
          "article": "fauna:TawnyOwl",
          "description": "A gray-brown owl with eyes that look like spectacles, often found in wooded areas."
        }
      ]
    },
    "apd": {
      "preferred_label": "بومة سمراء",
      "descriptions": [
        {
          "source": "acai",
          "description": "بومة لونها رمادي وبني، عيونها بتشبه النظارات، وغالباً بتكون في المناطق الشجرية."
        }
      ]
    },
    "arb": {
      "preferred_label": "البومة السمراء",
      "descriptions": [
        {
          "source": "acai",
          "description": "بومة ذات لون رمادي مائل إلى البني وعينين تبدوان كالنظارات، وغالبًا ما توجد في المناطق المشجرة."
        }
      ]
    },
    "bis": {
      "preferred_label": "hoknaet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kaen hoknaet we kala blong hem i gre-braon mo ae blong hem i olsem spektikel, we plante taem hem i stap long ol bus."
        }
      ]
    },
    "fra": {
      "preferred_label": "chat-huant",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une chouette gris-brun aux yeux semblables à des lunettes, que l’on trouve souvent dans les zones boisées."
        }
      ]
    },
    "hau": {
      "preferred_label": "Babbar mujiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata irin mujiya mai launin toka da ruwan kasa da idanu masu kama da tabarau, wadda galibi ake samunta a wurare masu itatuwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "भूरा उल्लू",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक भूरे-स्लेटी रंग का उल्लू जिसकी आँखें चश्मे जैसी दिखती हैं, और जो अक्सर जंगली या वन क्षेत्रों में पाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikwighịkwighị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu ụdị ikwighịkwighị na-acha ntụ-nchara nke nwere anya dị ka enyo anya, nke a na-ahụkarị nʼime oke ọhịa."
        }
      ]
    },
    "ind": {
      "preferred_label": "burung hantu cokelat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Burung hantu abu-abu kecokelatan dengan mata yang menyerupai kacamata, sering dijumpai di daerah berhutan."
        }
      ]
    },
    "nep": {
      "preferred_label": "खैरो लाटोकोसेरो",
      "descriptions": [
        {
          "source": "acai",
          "description": "चस्माजस्ता आँखा भएको खरानी-खैरो लाटोकोसेरो, जुन प्रायः वनजङ्गल भएको क्षेत्रमा पाइन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "coruja-do-mato",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma coruja marrom-acinzentada com olhos que parecem óculos, frequentemente encontrada em áreas arborizadas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Серая неясыть",
      "descriptions": [
        {
          "source": "acai",
          "description": "Серо-коричневая сова с глазами, похожими на очки, часто встречающаяся в лесистой местности."
        }
      ]
    },
    "spa": {
      "preferred_label": "cárabo común",
      "descriptions": [
        {
          "source": "acai",
          "description": "Búho de color pardo grisáceo con ojos que parecen anteojos, que suele encontrarse en zonas boscosas."
        }
      ]
    },
    "swh": {
      "preferred_label": "bundi kahawia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bundi mwenye rangi ya kijivu-kahawia na macho yanayofanana na miwani, anayepatikana mara nyingi katika maeneo yenye miti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pisin bilong nait",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain pisin bilong nait (aul) i gat kala gre-braun na ai bilong en i luk olsem em i werim gilas bilong ai, na planti taim em i save stap long ol bikbus."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cú vọ hung",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài cú có màu nâu xám với đôi mắt trông giống như đeo kính, thường được tìm thấy ở các khu vực nhiều cây cối."
        }
      ]
    },
    "zhs": {
      "preferred_label": "灰林鸮",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种灰褐色的猫头鹰，眼睛看起来像戴着眼镜，常见于林地。"
        }
      ]
    },
    "zht": {
      "preferred_label": "灰林鴞",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種灰褐色的貓頭鷹，眼睛似戴眼鏡，常見於林地。"
        }
      ]
    }
  },
