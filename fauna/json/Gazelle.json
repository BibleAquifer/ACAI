      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Gazelle",
          "article": "fauna:Gazelle",
          "description": "A small, graceful antelope with long legs, known for its speed and jumping ability."
        }
      ]
    },
    "apd": {
      "preferred_label": "غزال",
      "descriptions": [
        {
          "source": "acai",
          "description": "ظبي صغير ورشيق كرعينه طوال، معروف بسرعته وقدرته على النط."
        }
      ]
    },
    "arb": {
      "preferred_label": "ظبي",
      "descriptions": [
        {
          "source": "acai",
          "description": "نوع صغير ورشيق من الظباء بأرجل طويلة، يشتهر بسرعته وقدرته على القفز."
        }
      ]
    },
    "bis": {
      "preferred_label": "gasel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol mo naes kaen antelop we i gat longfala leg, we man i save hem from we i stap ron mo jamjam kwik."
        }
      ]
    },
    "fra": {
      "preferred_label": "gazelle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petite antilope gracieuse aux longues pattes, réputée pour sa rapidité et son aptitude au saut."
        }
      ]
    },
    "hau": {
      "preferred_label": "Barewa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙaramar dabbar daji mai kyan tsari da dogayen ƙafafu, wadda aka sani da sauri da kuma iya tsalle."
        }
      ]
    },
    "hin": {
      "preferred_label": "चिकारा",
      "descriptions": [
        {
          "source": "acai",
          "description": "लंबी टाँगों वाला एक छोटा, सुंदर मृग (चिकारा), जो अपनी गति और कूदने की क्षमता के लिए जाना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mgbada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere anụ nwere ụkwụ ogologo mara mma n'agbụrụ ele, nke a maara maka ọsọ na ikike ịwụli elu ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "kijang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Antelop anggun berukuran kecil dengan kaki panjang, terkenal karena kecepatan dan kemampuannya melompat."
        }
      ]
    },
    "nep": {
      "preferred_label": "हरिण",
      "descriptions": [
        {
          "source": "acai",
          "description": "लामा खुट्टा भएको, आफ्नो गति र उफ्रने क्षमताको लागि परिचित एक सानो, आकर्षक मृग प्रजातिको प्राणी।"
        }
      ]
    },
    "por": {
      "preferred_label": "gazela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um antílope pequeno e gracioso com pernas longas, conhecido por sua velocidade e capacidade de saltar."
        }
      ]
    },
    "rus": {
      "preferred_label": "Газель",
      "descriptions": [
        {
          "source": "acai",
          "description": "Небольшая изящная антилопа с длинными ногами, известная своей скоростью и прыгучестью."
        }
      ]
    },
    "spa": {
      "preferred_label": "gacela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Antílope pequeño y elegante de patas largas, conocido por su velocidad y capacidad para saltar."
        }
      ]
    },
    "swh": {
      "preferred_label": "Swala",
      "descriptions": [
        {
          "source": "acai",
          "description": "Swala mdogo na mwenye umbo zuri mwenye miguu mirefu, anayejulikana kwa kasi na uwezo wake wa kuruka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "gasel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik naispela kain dia i gat longpela lek, em ol i save long pasin bilong en long ran hariap na kalap."
        }
      ]
    },
    "vie": {
      "preferred_label": "Linh dương",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài linh dương nhỏ, duyên dáng với đôi chân dài, nổi tiếng về tốc độ và khả năng nhảy."
        }
      ]
    },
    "zhs": {
      "preferred_label": "羚羊",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种体态优美、长着长腿的小型羚羊，以其奔跑速度和跳跃能力著称。"
        }
      ]
    },
    "zht": {
      "preferred_label": "羚羊",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種體型小而優美、長腿的羚羊，以速度和跳躍能力著稱。"
        }
      ]
    }
  },
