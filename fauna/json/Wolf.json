        {
          "source": "acai",
          "description": "कुत्ते की प्रजाति का एक बड़ा, जंगली पशु जो अपने हिंसक स्वभाव और मवेशियों का शिकार करने के लिए जाना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nkịta ọhịa",
      "descriptions": [
        {
          "source": "acai",
