        }
      ]
    },
    "nep": {
      "preferred_label": "ब्वाँसो",
      "descriptions": [
        {
          "source": "acai",
          "description": "घरपालुवा जनावरको शिकार गर्ने र हिंस्रक प्रकृतिका लागि चिनिएको ठूलो, जङ्गली कुकुर जातिको जनावर।"
        }
      ]
    },
    "por": {
