  "localizations": {
    "eng": {
      "preferred_label": "Wild Donkey",
      "alternate_labels": [
        "Onager",
        "Wild Ass"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Wild Donkey",
          "article": "fauna:WildDonkey",
          "description": "A large animal that is unable to be tamed and is often found in deserts and grasslands."
        }
      ]
    },
    "apd": {
      "preferred_label": "حمار خلا",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان كبير ما بتدجن وغالباً بكون في الصحاري ومناطق الحشائش."
        }
      ]
    },
    "arb": {
      "preferred_label": "حمار وحشي",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان كبير لا يمكن ترويضه، وغالبًا ما يوجد في الصحاري والمروج."
        }
      ]
    },
    "bis": {
      "preferred_label": "wael dongki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala anamol we man i no save mekem i kam kwaet mo plante taem i stap long ol draeples mo ples we i gat gras."
        }
      ]
    },
    "fra": {
      "preferred_label": "âne sauvage",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un grand animal impossible à apprivoiser que l'on trouve souvent dans les déserts et les prairies."
        }
      ]
    },
    "hau": {
      "preferred_label": "Jakin jeji",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata babbar dabba wadda ba a iya horas da ita, galibi ana samunta a hamada da ciyayi."
        }
      ]
    },
    "hin": {
      "preferred_label": "जंगली गधा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक बड़ा पशु जिसे पालतू नहीं बनाया जा सकता और जो अक्सर रेगिस्तानों और घास के मैदानों में पाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịnyịnya ibu ọhịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu anụ a na-apụghị ịzụ nʼụlọ nke a na-ahụkarị nʼọzara na nʼahịhịa."
        }
      ]
    },
    "ind": {
      "preferred_label": "keledai hutan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hewan besar yang tidak dapat dijinakkan dan sering dijumpai di padang gurun serta padang rumput."
        }
      ]
    },
    "nep": {
      "preferred_label": "जङ्गली गधा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक ठूलो जनावर जसलाई तह लगाउन सकिँदैन र प्रायः मरुभूमि तथा घाँसे मैदानहरूमा पाइन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "jumento selvagem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um grande animal incapaz de ser domesticado, frequentemente encontrado em desertos e pastagens."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дикий осел",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупное неукротимое животное, часто встречающееся в пустынях и степях."
        }
      ]
    },
    "spa": {
      "preferred_label": "asno salvaje",
      "descriptions": [
        {
          "source": "acai",
          "description": "Animal grande incapaz de ser domesticado que suele encontrarse en desiertos y pastizales."
        }
      ]
    },
    "swh": {
      "preferred_label": "punda-mwitu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama mkubwa asiyeweza kufugwa na anayepatikana mara nyingi majangwani na katika nyasi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Wel donki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela animal i no inap long ol man i mekim kamap animal bilong haus, na planti taim em i save stap long ol ples drai nating na ples gras."
        }
      ]
    },
    "vie": {
      "preferred_label": "Lừa rừng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài động vật lớn không thể thuần hóa, thường được tìm thấy ở hoang mạc và đồng cỏ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "野驴",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种无法被驯服的大型动物，常见于沙漠和草地。"
        }
      ]
    },
    "zht": {
      "preferred_label": "野驢",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種無法被馴服的大型動物，常見於沙漠和草原。"
        }
      ]
    }
  },
