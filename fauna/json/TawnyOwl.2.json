        }
      ]
    },
    "apd": {
      "preferred_label": "بومة سمراء",
      "descriptions": [
        {
          "source": "acai",
          "description": "نوع من البوم لونو رمادي مبرقع بشبه لحاء الشجر، وصوتو هادي ومتردد."
        }
      ]
    },
    "arb": {
      "preferred_label": "بومة سمراء",
      "descriptions": [
        {
          "source": "acai",
          "description": "نوع من البوم رمادي أرقط يمتزج بلحاء الأشجار وله صيحة ناعمة مرتعشة."
        }
      ]
    },
    "bis": {
      "preferred_label": "aol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kaen aol we kala blong hem i gre mo i haed gud long sel blong tri mo singaot blong hem i sot mo i saf."
        }
      ]
    },
    "fra": {
      "preferred_label": "chouette hulotte",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une espèce de chouette au plumage gris tacheté qui se confond avec l’écorce des arbres et dont le cri est un doux trille."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mujiya mai launin toka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani nau'in mujiya mai launin toka-toka mai ɗigo da ke haɗewa da bawon itace kuma tana da kukan rawar murya mai taushi."
        }
      ]
    },
    "hin": {
      "preferred_label": "चितकबरा उल्लू",
      "descriptions": [
        {
          "source": "acai",
          "description": "चितकबरे भूरे रंग का एक प्रकार का उल्लू जो पेड़ों की छाल में घुलमिल जाता है और जिसकी आवाज़ धीमी व कंपकंपी भरी होती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ikwiikwii tọnị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụdị ikwiikwii nwere ụcha ntụ ntụ na-agwakọta nke na-eyi ka ogbugbo osisi ma na-eti mkpu dị nwayọọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "burung hantu kuning kecokelatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sejenis burung hantu abu-abu berbintik-bintik yang berkamuflase menyerupai kulit pohon dan memiliki suara kicauan bergetar yang lembut."
        }
      ]
    },
    "nep": {
      "preferred_label": "खैरो लाटोकोसेरो",
      "descriptions": [
        {
          "source": "acai",
          "description": "रुखको बोक्रासँग मिल्दोजुल्दो खैरो-छिरबिरे रङ्गको एक प्रकारको लाटोकोसेरो, जसको स्वर नरम र लहरीदार हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "coruja-do-mato",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um tipo de coruja cinzento-rajada que se camufla na casca de árvores e tem um chamado suave e trinado."
        }
      ]
    },
    "rus": {
      "preferred_label": "Серая неясыть",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вид сов с серо-пестрым оперением, сливающимся с корой деревьев, издающий мягкий вибрирующий крик."
        }
      ]
    },
    "spa": {
      "preferred_label": "cárabo común",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tipo de búho gris moteado que se camufla con la corteza de los árboles y tiene un canto suave y trinado."
        }
      ]
    },
    "swh": {
      "preferred_label": "bundi kahawia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aina ya bundi mwenye rangi ya kijivu ya madoadoa anayejifananisha na gome la mti na mwenye mlio laini unaotetemeka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "aul toni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain aul i gat makmak grei kala na i luk olsem hap kakaruk bilong diwai, na krai bilong em i no hevi tumas."
        }
      ]
    },
    "vie": {
      "preferred_label": "cú nâu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại cú có màu xám lốm đốm ngụy trang hòa vào vỏ cây và có tiếng kêu ngân rung nhẹ nhàng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "灰林鸮",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种具有斑驳灰色羽毛的猫头鹰，与树皮融为一体，叫声柔和并带有颤音。"
        }
      ]
    },
    "zht": {
      "preferred_label": "灰林鴞",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種具有斑駁灰色羽毛的貓頭鷹，能與樹皮融為一體，叫聲輕柔如顫音。"
        }
      ]
    }
  },
