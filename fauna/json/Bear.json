  "localizations": {
    "eng": {
      "preferred_label": "Bear",
      "alternate_labels": [
        "(Syrian Brown) Bear"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Bear",
          "article": "fauna:Bear",
          "description": "A large, furry mammal that can stand on its back legs, eats plants and small animals, and is dangerous when provoked."
        }
      ]
    },
    "apd": {
      "preferred_label": "دب",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان ثديي كبير عنده فرو بيقدر يقيف على كرعينه الورانية، بياكل نباتات وحيوانات صغيرة، وبيكون خطر لما يتهيج."
        }
      ]
    },
    "arb": {
      "preferred_label": "دب",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان ثديي كبير ذو فراء، يستطيع الوقوف على رجليه الخلفيتين، ويتغذى على النباتات والحيوانات الصغيرة، ويُعد خطيراً عند إثارته."
        }
      ]
    },
    "bis": {
      "preferred_label": "bea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala anamol we i gat fulap hea, we i save stanap long tu leg blong hem biaen, i kakae ol kras mo ol smosmol anamol, mo i denja taem man i kros wetem hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "ours",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grand mammifère au pelage épais pouvant se dresser sur ses pattes arrière, qui se nourrit de plantes et de petits animaux, et se révèle dangereux lorsqu'il est provoqué."
        }
      ]
    },
    "hau": {
      "preferred_label": "Beyar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata bab babbar dabba mai gashi mai shayarwa wadda za ta iya tsayawa a kan ƙafafunta na baya, tana cin tsire-tsire da ƙananan dabbobi, kuma tana da haɗari idan aka tsokane ta."
        }
      ]
    },
    "hin": {
      "preferred_label": "भालू",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक बड़ा, रोएँदार स्तनपायी जो अपने पिछले पैरों पर खड़ा हो सकता है, पौधों और छोटे जानवरों को खाता है, तथा छेड़े जाने पर खतरनाक होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Anụ ọhịa bịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu anụ ọhịa nwere ajị nke pụrụ iguzo nʼụkwụ azụ ya abụọ, na-eri ahịhịa na obere anụmanụ, ma dịkwa ize ndụ mgbe a kpasuru ya iwe."
        }
      ]
    },
    "ind": {
      "preferred_label": "beruang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mamalia besar berbulu lebat yang dapat berdiri di atas kedua kaki belakangnya, memakan tumbuhan dan hewan-hewan kecil, serta berbahaya jika diganggu."
        }
      ]
    },
    "nep": {
      "preferred_label": "भालु",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक ठूलो, भुत्ला भएको स्तनधारी जनावर जसले आफ्ना पछिल्ला खुट्टामा उभिन सक्छ, वनस्पति र साना जनावरहरू खान्छ, र जिस्क्याउँदा वा चलाउँदा खतरनाक हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "urso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um mamífero grande e peludo que consegue ficar em pé sobre as patas traseiras, alimenta-se de plantas e pequenos animais, e é perigoso quando provocado."
        }
      ]
    },
    "rus": {
      "preferred_label": "Медведь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупное млекопитающее, покрытое шерстью, способное вставать на задние лапы, питающееся растениями и мелкими животными и опасное при нападении или угрозе."
        }
      ]
    },
    "spa": {
      "preferred_label": "oso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mamífero grande y peludo que puede erguirse sobre sus patas traseras, come plantas y animales pequeños, y es peligroso cuando se le provoca."
        }
      ]
    },
    "swh": {
      "preferred_label": "Dubu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama mkubwa mwenye manyoya mengi anayeweza kusimama kwa miguu yake ya nyuma, hula mimea na wanyama wadogo, na ni hatari akichokozwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela animal i gat gras na i ken sanap long tupela lek bilong baksait, em i save kaikai ol gras samting na liklik animal, na em i save kros kwik na bagarapim man."
        }
      ]
    },
    "vie": {
      "preferred_label": "Gấu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài động vật có vú lớn, có lông rậm rạp, có thể đứng bằng hai chân sau, ăn thực vật cùng các loài động vật nhỏ, và rất nguy hiểm khi bị khiêu khích."
        }
      ]
    },
    "zhs": {
      "preferred_label": "熊",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种体型庞大、长有厚毛的哺乳动物，能用后腿站立，以植物和小动物为食，受到激惹时极为危险。"
        }
      ]
    },
    "zht": {
      "preferred_label": "熊",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種體型龐大、毛茸茸的哺乳動物，能用後腿站立，以植物和小動物為食，受到挑釁時極具危險性。"
        }
      ]
    }
  },
