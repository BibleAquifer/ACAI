  "localizations": {
    "eng": {
      "preferred_label": "Hyena",
      "alternate_labels": [
        "Wild Dog"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hyena",
          "article": "fauna:Hyena",
          "description": "A wild mammal with a big head and long front legs, known for its wailing sounds and habit of eating dead animals."
        }
      ]
    },
    "apd": {
      "preferred_label": "الضبع",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان ثديي بري عندو راس كبير وكرعين قداميات طوال، معروف بأصواته الشبه العويل وعادته في أكل الجيف والحيوانات الميتة."
        }
      ]
    },
    "arb": {
      "preferred_label": "ضَبُع",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان ثديي بري له رأس كبير وقائمتان أماميتان طويلتان، يشتهر بأصواته الشبيهة بالعويل وعادته في أكل الجيف."
        }
      ]
    },
    "bis": {
      "preferred_label": "haena",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan wael anamol we i gat bigfala hed mo longfala leg long fored, we man i save long krae blong hem mo fasin blong kakae ol bodi blong anamol we oli ded finis."
        }
      ]
    },
    "fra": {
      "preferred_label": "hyène",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un mammifère sauvage à la grosse tête et aux longues pattes avant, connu pour ses ricanements ou hurlements plaintifs et son habitude de manger des charognes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kura",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dabban daji mai babban kai da dogayen ƙafafun gaba, wadda aka sani da kukan kuka da ɗabi'ar cin matattun dabbobi."
        }
      ]
    },
    "hin": {
      "preferred_label": "लकड़बग्घा",
      "descriptions": [
        {
          "source": "acai",
          "description": "बड़े सिर और लंबे आगे के पैरों वाला एक जंगली स्तनधारी जानवर, जो अपनी रोने जैसी आवाज़ों और मरे हुए जानवरों को खाने की आदत के लिए जाना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nkịta ọhịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anụ ọhịa na-enye nwa ara nwere nnukwu isi na ogologo ụkwụ ihu, nke a maara maka ụda akwa ya na omume ya nke iri anụ nwụrụ anwụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "hiena",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mamalia liar berkepala besar dan berkaki depan panjang, dikenal karena suaranya yang melolong dan kebiasaannya memakan bangkai."
        }
      ]
    },
    "nep": {
      "preferred_label": "हुँडार",
      "descriptions": [
        {
          "source": "acai",
          "description": "ठूलो टाउको र लामा अघिल्ला खुट्टाहरू भएको एक जङ्गली स्तनधारी जनावर, जुन आफ्नो विलापयुक्त आवाज र मरेका जनावरहरू खाने बानीका लागि परिचित छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "hiena",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mamífero selvagem de cabeça grande e patas dianteiras compridas, conhecido por seus uivos e pelo hábito de comer carniça."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гиена",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дикое млекопитающее с большой головой и длинными передними лапами, известное своими завывающими звуками и привычкой питаться падалью."
        }
      ]
    },
    "spa": {
      "preferred_label": "hiena",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mamífero salvaje de cabeza grande y patas delanteras largas, conocido por sus aullidos y su costumbre de comer animales muertos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Fisi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama wa mwituni anayenyonyesha mwenye kichwa kikubwa na miguu mirefu ya mbele, anayejulikana kwa sauti zake za kuomboleza na tabia ya kula mizoga ya wanyama."
        }
      ]
    },
    "tpi": {
      "preferred_label": "haiina",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela wel animal i gat bikpela het na longpela lek bilong fran, em i gat nem long krai olsem man i krai sori na pasin bilong kaikai ol bodi bilong ol abus i dai pinis."
        }
      ]
    },
    "vie": {
      "preferred_label": "linh cẩu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài động vật có vú hoang dã có đầu to và hai chân trước dài, được biết đến với tiếng hú rên rỉ và tập tính ăn xác động vật chết."
        }
      ]
    },
    "zhs": {
      "preferred_label": "鬣狗",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种野生哺乳动物，头部大，前腿长，以哀号般的叫声和食腐肉的习性著称。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鬣狗",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種頭大且前腿長的野生哺乳動物，以哀號般的叫聲和食腐習性著稱。"
        }
      ]
    }
  },
