  "localizations": {
    "eng": {
      "preferred_label": "Rooster",
      "alternate_labels": [
        "Chicken",
        "Hen",
        "Cock"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rooster",
          "article": "fauna:Rooster",
          "description": "A male domestic chicken known for its early morning crowing, often mentioned in the Bible."
        }
      ]
    },
    "apd": {
      "preferred_label": "ديك",
      "descriptions": [
        {
          "source": "acai",
          "description": "ذكر الدجاج المستأنس، معروف بصلاته أو صياحه في الصباح الباكر، ومذكور كتير في الكتاب المقدس."
        }
      ]
    },
    "arb": {
      "preferred_label": "ديك",
      "descriptions": [
        {
          "source": "acai",
          "description": "ذكر الدجاج الأليف المعروف بصياحه في الصباح الباكر، ويُذكر كثيرًا في الكتاب المقدس."
        }
      ]
    },
    "bis": {
      "preferred_label": "man faol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man faol we oli save long hem from fasin blong hem blong singaot long eli moning, we Baebol i tokbaot plante taem."
        }
      ]
    },
    "fra": {
      "preferred_label": "coq",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mâle du poulet domestique connu pour son chant matinal, souvent mentionné dans la Bible."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zakara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kazan gida namiji da aka sani da yin cara da sanyin safiya, wanda aka sha ambata a cikin Littafi Mai Tsarki."
        }
      ]
    },
    "hin": {
      "preferred_label": "मुर्गा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक नर पालतू मुर्गा जो तड़के बाँग देने के लिए जाना जाता है, जिसका उल्लेख बाइबल में कई बार आया है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Oke ọkụkọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oke ọkụkọ a na-azụ nʼụlọ nke a maara maka ikwa akwa nʼisi ụtụtụ, nke a kpọtụrụ aha ugboro ugboro na Baịbụl."
        }
      ]
    },
    "ind": {
      "preferred_label": "ayam jantan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ayam peliharaan jantan yang dikenal dengan kokoknya di pagi hari, sering disebutkan dalam Alkitab."
        }
      ]
    },
    "nep": {
      "preferred_label": "भाले",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिहान सबेरै बास्ने कार्यका लागि परिचित घरपालुवा कुखुराको भाले, जसको बाइबलमा प्रायः उल्लेख गरिएको छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "galo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um frango doméstico macho conhecido por cantar no início da manhã, frequentemente mencionado na Bíblia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Петух",
      "descriptions": [
        {
          "source": "acai",
          "description": "Самец домашней курицы, известный своим пением на рассвете; часто упоминается в Библии."
        }
      ]
    },
    "spa": {
      "preferred_label": "gallo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Macho del pollo doméstico conocido por su canto matutino, mencionado con frecuencia en la Biblia."
        }
      ]
    },
    "swh": {
      "preferred_label": "Jogoo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuku dume wa kufugwa anayejulikana kwa kuwika kwake asubuhi na mapema, anayetajwa mara nyingi katika Biblia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kakaruk man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kakaruk man ol manmeri i save lukautim, em i gat nem long krai long bikmoningtaim, na Baibel i stori planti taim long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Gà trống",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gà trống nhà được biết đến với tiếng gáy sáng sớm, thường được nhắc đến trong Kinh Thánh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "公鸡",
      "descriptions": [
        {
          "source": "acai",
          "description": "以清晨鸣叫著称的雄性家鸡，在圣经中常被提及。"
        }
      ]
    },
    "zht": {
      "preferred_label": "公雞",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種以清晨啼叫聞名的雄性家雞，常在聖經中提及。"
        }
      ]
    }
  },
