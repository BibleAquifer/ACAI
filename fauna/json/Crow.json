  "localizations": {
    "eng": {
      "preferred_label": "Crow",
      "alternate_labels": [
        "Raven"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Crow",
          "article": "fauna:Crow",
          "description": "A large black bird with a thick beak, very smart, and it eats almost anything."
        }
      ]
    },
    "apd": {
      "preferred_label": "غراب",
      "descriptions": [
        {
          "source": "acai",
          "description": "طير كبير أسود بمنقار غليظ، ذكي بالحيل وياكل أي حاجة تقريباً."
        }
      ]
    },
    "arb": {
      "preferred_label": "غُراب",
      "descriptions": [
        {
          "source": "acai",
          "description": "طائر أسود كبير ذو منقار سميك، ذكي جدًّا، ويأكل كل شيء تقريبًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "reven",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala blak pijin we bik blong hem i tik, we i gat hed tumas, mo i stap kakae klosap evri samting."
        }
      ]
    },
    "fra": {
      "preferred_label": "corbeau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grand oiseau noir au bec épais, très intelligent, qui mange presque de tout."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hankaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban baƙin tsuntsu mai kauri da ƙaƙƙarfan baki, mai wayo sosai, wanda kuma yakan ci kusan kowane abu."
        }
      ]
    },
    "hin": {
      "preferred_label": "कौआ",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक बड़ा काला पक्षी जिसकी चोंच मोटी होती है, बहुत चतुर होता है, और लगभग कुछ भी खा लेता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ugolọma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu nnụnụ ojii nwere ọnụ siri ike, nke maara ihe nke ukwuu, ma na-erikarị ihe ọbụla."
        }
      ]
    },
    "ind": {
      "preferred_label": "gagak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Burung hitam besar dengan paruh tebal, sangat cerdas, dan memakan hampir apa saja."
        }
      ]
    },
    "nep": {
      "preferred_label": "काग",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाक्लो ठुँड भएको ठुलो कालो चरा, धेरै चलाख, र यसले प्रायः जे पनि खान्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "corvo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma ave preta de grande porte, com bico grosso, muito inteligente e que come quase tudo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ворон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупная черная птица с толстым клювом, очень смышленая и практически всеядная."
        }
      ]
    },
    "spa": {
      "preferred_label": "cuervo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ave grande de color negro con pico grueso, muy inteligente, que come casi cualquier cosa."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kunguru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndege mkubwa mweusi mwenye mdomo mnene, mwenye akili sana, na hula karibu kila kitu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kotkot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela blakpela pisin i gat bikpela bil (maut), em i gat bikpela save, na em i save kaikai klostu olgeta kain samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Quạ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài chim lớn màu đen có mỏ dày, rất thông minh và ăn hầu như mọi thứ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "乌鸦",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种体型较大、羽毛呈黑色、喙较粗的鸟类，非常聪明，且几乎什么都吃。"
        }
      ]
    },
    "zht": {
      "preferred_label": "烏鴉",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種體型較大的黑色鳥類，嘴喙粗厚，非常聰明，幾乎無所不吃。"
        }
      ]
    }
  },
