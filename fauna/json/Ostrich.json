  "localizations": {
    "eng": {
      "preferred_label": "Ostrich",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ostrich",
          "article": "fauna:Ostrich",
          "description": "A large flightless bird with long neck and legs, known for its black and white feathers in males."
        }
      ]
    },
    "apd": {
      "preferred_label": "نعامة",
      "descriptions": [
        {
          "source": "acai",
          "description": "طير كبير ما بيطير وعند ورقية ورجلين طوال، والذكور معروفة بريشها الأسود والأبيض."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَعَامَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "طائر كبير لا يطير، ذو عنق وساقين طويلتين، ويشتهر بريشه الأسود والأبيض عند الذكور."
        }
      ]
    },
    "bis": {
      "preferred_label": "ostrij",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala pijin we i no save flae, we nek mo lek blong hem i longfala, mo man blong hem i gat ol blak mo waet feda."
        }
      ]
    },
    "fra": {
      "preferred_label": "autruche",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un grand oiseau incapable de voler, au long cou et aux longues pattes, connu pour les plumes noires et blanches des mâles."
        }
      ]
    },
    "hau": {
      "preferred_label": "jimina",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban tsuntsu ne marar tashi mai dogon wuya da ƙafafu, wanda aka sani da baƙaƙe da fararen fuka-fukai ga maza."
        }
      ]
    },
    "hin": {
      "preferred_label": "शुतुर्मुर्ग",
      "descriptions": [
        {
          "source": "acai",
          "description": "लंबी गर्दन और पैरों वाला एक बड़ा उड़ने में असमर्थ पक्षी, जो नर पक्षी के काले और सफ़ेद पंखों के लिए जाना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "enyi nnụnụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnụnụ buru ibu nke na-adịghị efe efe nke nwere olu na ụkwụ toro ogologo, nke a maara maka nku ojii na nke ọcha n'ebe oké ya nọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "burung unta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Burung besar yang tidak dapat terbang dengan leher dan kaki panjang, terkenal karena bulu jantan yang berwarna hitam dan putih."
        }
      ]
    },
    "nep": {
      "preferred_label": "अस्ट्रिच",
      "descriptions": [
        {
          "source": "acai",
          "description": "लामो घाँटी र खुट्टा भएको उड्न नसक्ने ठूलो चरा, भालेको कालो र सेतो प्वाँखका लागि प्रख्यात।"
        }
      ]
    },
    "por": {
      "preferred_label": "avestruz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma ave grande que não voa, com pescoço e pernas longos, conhecida pelas penas pretas e brancas nos machos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Страус",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупная нелетающая птица с длинной шеей и ногами, известная черно-белым оперением у самцов."
        }
      ]
    },
    "spa": {
      "preferred_label": "avestruz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ave grande no voladora de cuello y patas largos, conocida por las plumas blancas y negras en los machos."
        }
      ]
    },
    "swh": {
      "preferred_label": "mbuni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndege mkubwa asiyeweza kuruka mwenye shingo na miguu mirefu, anayejulikana kwa manyoya meusi na meupe kwa dume."
        }
      ]
    },
    "tpi": {
      "preferred_label": "muruk bilong ples drai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela pisin i no inap flai, em i gat longpela nek na longpela lek, na gras bilong ol man i blakpela na waitpela."
        }
      ]
    },
    "vie": {
      "preferred_label": "đà điểu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài chim lớn không biết bay, có cổ và chân dài, nổi tiếng với bộ lông đen trắng ở con đực."
        }
      ]
    },
    "zhs": {
      "preferred_label": "鸵鸟",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种不能飞的大型鸟类，颈长腿长，雄鸟以黑白相间的羽毛著称。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鴕鳥",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種長頸、長腿的大型不會飛的鳥類，雄鳥以其黑白相間的羽毛著稱。"
        }
      ]
    }
  },
