      "descriptions": [
        {
          "source": "acai",
          "gloss": "Wild Ox",
          "article": "fauna:WildOx",
          "description": "A large, powerful animal with horns, symbolized in the Bible as strength and wildness."
        }
      ]
    },
    "apd": {
      "preferred_label": "تور خلا",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان كبير وقوي وعنده قرون، وبيرمز في الكتاب المقدس للقوة والوحشية."
        }
      ]
    },
    "arb": {
      "preferred_label": "رئم",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان ضخم وقوي ذو قرنين، يرمز في الكتاب المقدس إلى القوة والشراسة."
        }
      ]
    },
    "bis": {
      "preferred_label": "wael bul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala mo strong anamol we i gat kom, we long Baebol hem i pija blong paoa mo fasin blong wael."
        }
      ]
    },
    "fra": {
      "preferred_label": "buffle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un animal imposant et puissant doté de cornes, symbole biblique de force et d'indomptabilité."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ɓauna",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata babbar dabba mai ƙarfi da ƙahoni, wadda a cikin Littafi Mai Tsarki take alamta ƙarfi da zafin daji."
        }
      ]
    },
    "hin": {
      "preferred_label": "जंगली साँड़",
      "descriptions": [
        {
          "source": "acai",
          "description": "सींगों वाला एक बड़ा, शक्तिशाली पशु, जिसे बाइबल में शक्ति और जंगलीपन का प्रतीक माना गया है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ehi ọhịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu anụ dị ike nke nwere mpi, nke e ji mee ihe atụ nke ike na ịdị nʼọhịa na Baịbụl."
        }
      ]
    },
    "ind": {
      "preferred_label": "lembu hutan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hewan besar dan kuat bertanduk, dilambangkan dalam Alkitab sebagai kekuatan dan kebuasan."
        }
      ]
    },
    "nep": {
      "preferred_label": "जङ्गली गोरु",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिङ भएको ठूलो र शक्तिशाली जनावर, जसलाई बाइबलमा शक्ति र जङ्गलीपनको प्रतीक मानिएको छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "boi selvagem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um animal grande e poderoso com chifres, simbolizado na Bíblia como força e selvageria."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дикий бык",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупное, мощное рогатое животное, символизирующее в Библии силу и необузданность."
        }
      ]
    },
    "spa": {
      "preferred_label": "toro salvaje",
      "descriptions": [
        {
          "source": "acai",
          "description": "Animal grande y poderoso con cuernos, que en la Biblia simboliza la fuerza y la bravura."
        }
      ]
    },
    "swh": {
      "preferred_label": "nyati",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama mkubwa na mwenye nguvu mwenye pembe, anayeashiria nguvu na ukali katika Biblia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Wel bulmakau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela na strongpela animal i gat kom, em Baibel i makim olsem mak bilong strong na pasin bilong stap wel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bò rừng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài động vật lớn, dũng mãnh và có sừng, trong Kinh Thánh tượng trưng cho sức mạnh và sự hoang dã."
        }
      ]
    },
    "zhs": {
      "preferred_label": "野牛",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种带角的大型强壮动物，在圣经中象征着力量与狂野。"
        }
      ]
    },
    "zht": {
      "preferred_label": "野牛",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種有角的大型強力動物，在聖經中象徵力量和野性。"
        }
      ]
    }
  },
