  "localizations": {
    "eng": {
      "preferred_label": "Dog",
      "alternate_labels": [
        "Canine"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Dog",
          "article": "fauna:Dog",
          "description": "A small animal, often domesticated, that eats almost anything and was considered ceremonially unclean to eat."
        }
      ]
    },
    "apd": {
      "preferred_label": "كلب",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان صغير، في العادة بكون مدجن ومربى في البيوت، بياكل أي حاجة تقريباً وكان بيعتبر نجس وما بيتاكل في الشريعة."
        }
      ]
    },
    "arb": {
      "preferred_label": "كلب",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان صغير، غالبًا ما يُستأنس، يأكل كل شيء تقريبًا، وكان يُعدّ نجسًا طقسيًّا لأكله."
        }
      ]
    },
    "bis": {
      "preferred_label": "dog",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol anamol, plante taem man i stap lukaotem long vilej, we i stap kakae klosap evri samting mo long kastom blong ol laen blong Isrel i no klin blong kakae."
        }
      ]
    },
    "fra": {
      "preferred_label": "chien",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit animal, souvent domestiqué, qui mange presque de tout et était considéré comme rituellement impur à la consommation."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kare",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙaramar dabba, wadda aka fi kiwatawa a gida, mai cin kusan kowane abu, wadda kuma a al'adance aka ɗauke ta marar tsarki a ci."
        }
      ]
    },
    "hin": {
      "preferred_label": "कुत्ता",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक छोटा जानवर, जिसे अक्सर पालतू बनाया जाता है, जो लगभग कुछ भी खा लेता है और जिसे खाने के लिए विधिक रूप से अशुद्ध माना जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "nkịta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere anụmanụ a na-azụkarị n'ụlọ, nke na-eri ihe fọrọ nke nta ka ọ bụrụ ihe ọbụla ma bụrụkwa nke a na-ewere dị ka ihe na-adịghị ọcha n'emume iri nri."
        }
      ]
    },
    "ind": {
      "preferred_label": "anjing",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hewan kecil yang sering dijinakkan, memakan hampir apa saja, dan dianggap najis secara ritual untuk dimakan."
        }
      ]
    },
    "nep": {
      "preferred_label": "कुकुर",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः पालिने एक सानो जनावर, जसले प्रायः जे पनि खान्छ र खानको निम्ति व्यवस्थाअनुसार अशुद्ध मानिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "cão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um animal pequeno, frequentemente domesticado, que come quase tudo e era considerado cerimonialmente impuro para comer."
        }
      ]
    },
    "rus": {
      "preferred_label": "Собака",
      "descriptions": [
        {
          "source": "acai",
          "description": "Небольшое животное, часто домашнее, которое ест практически всё; считалось ритуально нечистым для употребления в пищу."
        }
      ]
    },
    "spa": {
      "preferred_label": "perro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Animal pequeño, a menudo domesticado, que come casi cualquier cosa y que se consideraba ceremonialmente impuro para el consumo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mbwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama mdogo, ambaye mara nyingi hufugwa, anayekula karibu kila kitu na alichukuliwa kuwa najisi kuliwa kiibada."
        }
      ]
    },
    "tpi": {
      "preferred_label": "dok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik animal ol man i save lukautim long ples, em i save kaikai klostu olgeta samting na ol i bin tingim olsem em i no klinpela long kaikai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Chó",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài động vật nhỏ, thường được thuần hóa, ăn hầu như mọi thứ và bị coi là ô uế theo nghi lễ khi ăn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "狗",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种常被驯养的小型动物，几乎什么都吃，在礼仪上被视为不可食用的不洁之物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "狗",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種常被馴養的小型動物，幾乎無所不吃，在禮儀上被視為不潔淨不可食用。"
        }
      ]
    }
  },
