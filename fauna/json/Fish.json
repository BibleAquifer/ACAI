    "apd": {
      "preferred_label": "سمك",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان بيعيش في الموية، ممكن يكون صغير أو كبير، وغالباً بيتاكل كطعام."
        }
      ]
    },
    "arb": {
      "preferred_label": "سمك",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان يعيش في الماء، قد يكون صغيرًا أو كبيرًا، وغالبًا ما يُتخذ طعامًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "fis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan anamol we i laef long wota, we i save smol no bigwan, mo we plante taem ol man oli kakae."
        }
      ]
    },
    "fra": {
      "preferred_label": "poisson",
      "descriptions": [
        {
          "source": "acai",
          "description": "Animal vivant dans l’eau, qui peut être de petite ou de grande taille, et qui sert souvent de nourriture."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kifi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata dabba ce da take rayuwa a ruwa, wadda za ta iya zama ƙarama ko babba, kuma ana yawan amfani da ita a matsayin abinci."
        }
      ]
    },
    "hin": {
      "preferred_label": "मछली",
      "descriptions": [
        {
          "source": "acai",
          "description": "पानी में रहने वाला एक प्राणी, जो छोटा या बड़ा हो सकता है, और अक्सर भोजन के रूप में उपयोग किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Azụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anụmanụ na-ebi na mmiri, nke nwere ike ịdị obere ma ọ bụ buru ibu, nke a na-ejikarị eme nri."
        }
      ]
    },
    "ind": {
      "preferred_label": "ikan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hewan yang hidup di air, yang dapat berukuran kecil atau besar, dan sering digunakan sebagai makanan."
        }
      ]
    },
    "nep": {
      "preferred_label": "माछा",
      "descriptions": [
        {
          "source": "acai",
          "description": "पानीमा बस्ने एउटा जीव, जुन सानो वा ठूलो हुन सक्छ, र प्रायः खानाको रूपमा प्रयोग गरिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "peixe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um animal que vive na água, que pode ser pequeno ou grande, e é frequentemente usado como alimento."
        }
      ]
    },
    "rus": {
      "preferred_label": "Рыба",
      "descriptions": [
        {
          "source": "acai",
          "description": "Живущее в воде животное, которое может быть маленьким или большим и часто употребляется в пищу."
        }
      ]
    },
    "spa": {
      "preferred_label": "pez",
      "descriptions": [
        {
          "source": "acai",
          "description": "Animal que vive en el agua, que puede ser pequeño o grande, y a menudo se utiliza como alimento."
        }
      ]
    },
    "swh": {
      "preferred_label": "Samaki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama anayeishi majini, ambaye anaweza kuwa mdogo au mkubwa, na mara nyingi hutumiwa kama chakula."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela animal i save stap long wara, em inap stap liklik o bikpela, na planti taim ol man i save kaikai olsem abus."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài động vật sống dưới nước, có thể nhỏ hoặc lớn, và thường được dùng làm thức ăn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "鱼",
      "descriptions": [
        {
          "source": "acai",
