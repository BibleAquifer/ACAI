  "localizations": {
    "eng": {
      "preferred_label": "Frog",
      "alternate_labels": [
        "(Plague Of) Frogs",
        "Frogs"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Frog",
          "article": "fauna:Frog",
          "description": "A frog is a small, tailless animal that jumps with its long back legs and starts life as a tadpole."
        }
      ]
    },
    "apd": {
      "preferred_label": "ضفدع",
      "descriptions": [
        {
          "source": "acai",
          "description": "الضفدع هو حيوان صغير ما عنده ضنب بينط برجلينه الورانية الطوال وبيدى حياته كيرقة موية (أبو ذنيبة)."
        }
      ]
    },
    "arb": {
      "preferred_label": "ضفدع",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان صغير عديم الذيل يقفز برجليه الخلفيتين الطويلتين، ويبدأ حياته كشرغوف (أبو ذنيبة)."
        }
      ]
    },
    "bis": {
      "preferred_label": "frog",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan frog hem i wan smol anamol we i no gat tel, we i jamjam wetem ol longfala leg blong hem bihaen, mo i statem laef olsem wan smol bebet long wota."
        }
      ]
    },
    "fra": {
      "preferred_label": "grenouille",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une grenouille est un petit animal sans queue qui saute grâce à ses longues pattes arrière et commence sa vie sous la forme d'un têtard."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwaɗo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kwadi wata ƙaramar dabba ce marar wutsiya wadda take tsalle da dogayen ƙafafunta na baya kuma take fara rayuwa a matsayin tsutsa a ruwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "मेंढक",
      "descriptions": [
        {
          "source": "acai",
          "description": "मेंढक एक छोटा, पूँछ-रहित प्राणी है जो अपने लंबे पिछले पैरों से छलांग लगाता है और एक टैडपोल के रूप में अपना जीवन शुरू करता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Awọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Awọ bụ obere anụmanụ na-enweghị ọdụ nke na-eji ụkwụ azụ ya dị ogologo awụli elu ma na-amalite ndụ dị ka nwa awọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "katak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Katak adalah hewan kecil tak berekor yang melompat dengan kaki belakangnya yang panjang dan memulai kehidupannya sebagai berudu."
        }
      ]
    },
    "nep": {
      "preferred_label": "भ्यागुतो",
      "descriptions": [
        {
          "source": "acai",
          "description": "भ्यागुतो एउटा सानो, पुच्छर नभएको जीव हो जसले आफ्ना लामा पछिल्ला खुट्टाले उफ्रन्छ र चेपागाँडाको रूपमा जीवन सुरु गर्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "rã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma rã é um animal pequeno e sem cauda que salta com suas longas pernas traseiras e começa a vida como um girino."
        }
      ]
    },
    "rus": {
      "preferred_label": "Лягушка",
      "descriptions": [
        {
          "source": "acai",
          "description": "Лягушка (или жаба) — небольшое бесхвостое животное, которое прыгает с помощью длинных задних лап и начинает жизнь в виде головастика."
        }
      ]
    },
    "spa": {
      "preferred_label": "rana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una rana es un animal pequeño y sin cola que salta con sus largas patas traseras y comienza su vida como renacuajo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Chura",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chura ni mnyama mdogo asiye na mkia anayeruka kwa miguu yake mirefu ya nyuma na huanza maisha kama kiluwiluwi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "rokrok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rokrok em i wanpela liklik animal i no gat tel na i save kalap long longpela lek bilong baksait bilong en, na laip bilong en i save kirap olsem liklik binatang bilong wara."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ếch",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ếch là loài động vật nhỏ không đuôi, nhảy bằng hai chân sau dài và bắt đầu vòng đời từ nòng nọc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "青蛙",
      "descriptions": [
        {
          "source": "acai",
          "description": "青蛙是一种小型无尾动物，用长长的后腿跳跃，生命始于蝌蚪阶段。"
        }
      ]
    },
    "zht": {
      "preferred_label": "青蛙",
      "descriptions": [
        {
          "source": "acai",
          "description": "青蛙是一種沒有尾巴的小型動物，用長長的後腿跳躍，生命的初期是蝌蚪。"
        }
      ]
    }
  },
