  "localizations": {
    "eng": {
      "preferred_label": "Dove",
      "alternate_labels": [
        "Pigeon"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Dove",
          "article": "fauna:Dove",
          "description": "A blue-gray bird with a pinkish neck, living in colonies, and often used for sacrifices in the Bible."
        }
      ]
    },
    "apd": {
      "preferred_label": "حمامة",
      "descriptions": [
        {
          "source": "acai",
          "description": "طير لونه رمادي مزرق ورقبته مائلة للوردي، بعيش في أسراب، وكان كتير بيستخدم في الدبايح والقرابين في الكتاب المقدس."
        }
      ]
    },
    "arb": {
      "preferred_label": "حمامة",
      "descriptions": [
        {
          "source": "acai",
          "description": "طائر أزرق رمادي ذو عنق ضارب إلى الوردي، يعيش في مستعمرات، وغالبًا ما كان يُستخدم للذبائح في الكتاب المقدس."
        }
      ]
    },
    "bis": {
      "preferred_label": "sotleg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan blu-gre pijin we nek blong hem i pinki smol, i stap laef long bigfala grup, mo plante taem oli stap yusum blong mekem sakrefaes long Baebol."
        }
      ]
    },
    "fra": {
      "preferred_label": "colombe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oiseau bleu-gris au cou rosâtre, vivant en colonies et souvent utilisé pour les sacrifices dans la Bible."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kurciya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tsuntsu mai ruwan toka-toka da wuyan da ke da ɗan jan launi, mai zama a garke, kuma da aka saba amfani da shi don hadayu a cikin Littafi Mai Tsarki."
        }
      ]
    },
    "hin": {
      "preferred_label": "कबूतर",
      "descriptions": [
        {
          "source": "acai",
          "description": "गुलाबी गर्दन वाला नीला-धूसर पक्षी, जो झुंडों में रहता है, और बाइबल में अक्सर बलियों के लिए उपयोग किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "nduru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnụnụ na-acha ntụ ntụ na anụnụ anụnụ nwere olu na-acha ọbara ọbara nwayọọ, na-ebi n'ìgwè, ma na-abụkarị nke e ji achụ àjà na Baịbụl."
        }
      ]
    },
    "ind": {
      "preferred_label": "merpati",
      "descriptions": [
        {
          "source": "acai",
          "description": "Burung berwarna abu-abu kebiruan dengan leher agak merah muda, hidup berkoloni, dan sering digunakan untuk korban persembahan di dalam Alkitab."
        }
      ]
    },
    "nep": {
      "preferred_label": "ढुकुर",
      "descriptions": [
        {
          "source": "acai",
          "description": "हल्का नीलो-खैरो रङको र घाँटीतिर गुलाबी हुने चरा, जो बगालमा बस्छ, र बाइबलमा प्रायः बलिको निम्ति प्रयोग गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "pomba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma ave cinza-azulada com pescoço rosado, que vive em colônias e era frequentemente usada em sacrifícios na Bíblia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Голубь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сизовато-серая птица с розоватой шеей, живущая колониями; в Библии часто использовалась для жертвоприношений."
        }
      ]
    },
    "spa": {
      "preferred_label": "paloma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ave de color gris azulado con cuello rosáceo, que vive en colonias y se utilizaba a menudo para sacrificios en la Biblia."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndege wa kijivu-samawati mwenye shingo yenye rangi ya waridi kiasi, anayeishi katika makundi, na mara nyingi alitumiwa kwa dhabihu katika Biblia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "balus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela blupela-greipela pisin i gat kain retpela nek, ol i save bung wantaim long stap, na planti taim ol i save yusim bilong mekim ol ofa long Baibel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bồ câu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài chim màu xám xanh với cổ hơi hồng, sống theo bầy và thường được dùng làm sinh tế trong Kinh Thánh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "鸽子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种羽毛呈蓝灰色、颈部带粉红色、群居的鸟类，在圣经中常被用作祭物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鴿子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種藍灰色的鳥，頸部帶粉紅色，群居，在聖經中常用於獻祭。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
