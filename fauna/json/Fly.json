  "localizations": {
    "eng": {
      "preferred_label": "Fly",
      "alternate_labels": [
        "Swarm of Insects"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Fly",
          "article": "fauna:Fly",
          "description": "An insect with large eyes and one pair of wings, often seen around garbage and decaying food."
        }
      ]
    },
    "apd": {
      "preferred_label": "ضبان",
      "descriptions": [
        {
          "source": "acai",
          "description": "حشرة عندها عيون كبار وزوج واحد من الجناحات، وغالباً بتتشاف حولين الزبالة والأكل العَفِن."
        }
      ]
    },
    "arb": {
      "preferred_label": "ذباب",
      "descriptions": [
        {
          "source": "acai",
          "description": "حشرة ذات عينين كبيرتين وزوج واحد من الأجنحة، وغالبًا ما تُرى حول القمامة والأطعمة الفاسدة."
        }
      ]
    },
    "bis": {
      "preferred_label": "flae",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bebet we i gat ol bigfala ae mo wan pea wing, we plante taem yu luk raon long doti mo ol kakae we i rot finis."
        }
      ]
    },
    "fra": {
      "preferred_label": "mouche",
      "descriptions": [
        {
          "source": "acai",
          "description": "Insecte doté de grands yeux et d'une paire d'ailes, souvent observé autour des ordures et des aliments en décomposition."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙuda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kwaro mai manyan idanu da fikafikai biyu, wanda ake yawan gani a wajen shara da ruɓaɓɓen abinci."
        }
      ]
    },
    "hin": {
      "preferred_label": "मक्खी",
      "descriptions": [
        {
          "source": "acai",
          "description": "बड़ी आँखों और एक जोड़ी पंखों वाला एक कीट, जो अक्सर कचरे और सड़ते हुए भोजन के आसपास देखा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ijiji",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ahụhụ nwere anya buru ibu na otu ụzọ nku, nke a na-ahụkarị n'akụkụ mkpofu na nri na-ere ure."
        }
      ]
    },
    "ind": {
      "preferred_label": "lalat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Serangga dengan mata besar dan sepasang sayap, sering terlihat di sekitar sampah dan makanan yang membusuk."
        }
      ]
    },
    "nep": {
      "preferred_label": "झिँगा",
      "descriptions": [
        {
          "source": "acai",
          "description": "ठूला आँखा र एक जोडी पखेटा भएको कीरा, जुन प्रायः फोहोर र सडेगलेको खानेकुरा वरपर देखिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "mosca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um inseto com olhos grandes e um par de asas, frequentemente visto ao redor de lixo e alimentos em decomposição."
        }
      ]
    },
    "rus": {
      "preferred_label": "Муха",
      "descriptions": [
        {
          "source": "acai",
          "description": "Насекомое с большими глазами и одной парой крыльев, часто встречающееся возле мусора и гниющей пищи."
        }
      ]
    },
    "spa": {
      "preferred_label": "mosca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Insecto con ojos grandes y un par de alas, que suele verse alrededor de la basura y los alimentos en descomposición."
        }
      ]
    },
    "swh": {
      "preferred_label": "Inzi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mdudu mwenye macho makubwa na mabawa mawili, anayeonekana mara nyingi karibu na takataka na vyakula vinavyooza."
        }
      ]
    },
    "tpi": {
      "preferred_label": "lang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela binatang i gat bikpela ai na tupela wing, planti taim ol i save lukim em klostu long pipia na long ol kaikai i sting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ruồi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài côn trùng có mắt lớn và một đôi cánh, thường xuất hiện quanh rác thải và thức ăn ôi thiu."
        }
      ]
    },
    "zhs": {
      "preferred_label": "苍蝇",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种长有大眼睛和一对翅膀的昆虫，常见于垃圾和腐烂食物周围。"
        }
      ]
    },
    "zht": {
      "preferred_label": "蒼蠅",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種有大眼睛和一對翅膀的昆蟲，常見於垃圾和腐爛的食物周圍。"
        }
      ]
    }
  },
