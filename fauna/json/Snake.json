  "localizations": {
    "eng": {
      "preferred_label": "Snake",
      "alternate_labels": [
        "Serpent",
        "Reptile"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Snake",
          "article": "fauna:Snake",
          "description": "A long, legless reptile that moves by wriggling or slithering and is often linked with danger and deception."
        }
      ]
    },
    "apd": {
      "preferred_label": "دبيب",
      "descriptions": [
        {
          "source": "acai",
          "description": "زاحف طويل ما عندو كرعين، بتحرك بالزحف، وغالباً برتبط بالخطر والخداع."
        }
      ]
    },
    "arb": {
      "preferred_label": "حية",
      "descriptions": [
        {
          "source": "acai",
          "description": "زاحف طويل عديم الأرجل يتحرك بالتملص أو الزحف، وغالبًا ما يرتبط بالخطر والخداع."
        }
      ]
    },
    "bis": {
      "preferred_label": "snek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan longfala reptael we i no gat leg we i stap muv long fasin blong krabokoko mo plante taem i joen wetem denja mo fasin blong trikim man."
        }
      ]
    },
    "fra": {
      "preferred_label": "serpent",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long reptile dépourvu de pattes qui se déplace en ondulant ou en rampant, souvent associé au danger et à la tromperie."
        }
      ]
    },
    "hau": {
      "preferred_label": "Maciji",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dogo, marar ƙafafu mai rarrafe wanda yake tafiya ta wajen yatsina ko laɓe kuma sau da yawa yana da alaƙa da haɗari da yaudara."
        }
      ]
    },
    "hin": {
      "preferred_label": "साँप",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक लंबा, बिना पैरों वाला सरीसृप जो रेंगकर या फिसलकर चलता है और अक्सर खतरे व धोखे से जुड़ा होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Agwọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ogologo anụ na-akpụ akpụ nke na-enweghị ụkwụ nke na-eji mmegharị ahụ ma ọ bụ ịkpụ akpụ aga ije, a na-ejikọkarịkwa ya na ihe ize ndụ na aghụghọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "ular",
      "descriptions": [
        {
          "source": "acai",
          "description": "Reptil panjang tanpa kaki yang bergerak dengan melata atau meliuk-liuk dan sering dikaitkan dengan bahaya serta tipu daya."
        }
      ]
    },
    "nep": {
      "preferred_label": "सर्प",
      "descriptions": [
        {
          "source": "acai",
          "description": "खुट्टा नभएको लामो घस्रने जनावर (सरीसृप), जो घस्रेर वा लतपत्तिएर हिँड्छ र प्रायः खतरा तथा छलसँग सम्बन्धित हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "serpente",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um réptil longo e sem pernas que se move rastejando ou ondulando e é frequentemente associado ao perigo e ao engano."
        }
      ]
    },
    "rus": {
      "preferred_label": "Змея",
      "descriptions": [
        {
          "source": "acai",
          "description": "Длинное безногое пресмыкающееся, передвигающееся извиваясь или ползком и часто ассоциирующееся с опасностью и обманом."
        }
      ]
    },
    "spa": {
      "preferred_label": "serpiente",
      "descriptions": [
        {
          "source": "acai",
          "description": "Reptil largo y sin patas que se desplaza serpenteando o arrastrándose, y que a menudo se asocia con el peligro y el engaño."
        }
      ]
    },
    "swh": {
      "preferred_label": "nyoka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama mtambaazi mrefu asiye na miguu anayetembea kwa kujipinda au kutambaa na mara nyingi huhusishwa na hatari na udanganyifu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "snek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela longpela abus i no gat lek, i save krungut na go i go long graun, na Baibel i save tok em i samting bilong givim bagarap na giamanim man."
        }
      ]
    },
    "vie": {
      "preferred_label": "rắn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài bò sát dài, không chân, di chuyển bằng cách uốn lượn hoặc trườn bò, và thường liên hệ với sự nguy hiểm và lừa dối."
        }
      ]
    },
    "zhs": {
      "preferred_label": "蛇",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种长条状、无足的爬行动物，靠蠕动或滑行移动，常与危险和欺骗联系在一起。"
        }
      ]
    },
    "zht": {
      "preferred_label": "蛇",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種細長無足的爬行動物，靠蠕動或滑行移動，常與危險和欺騙相聯繫。"
        }
      ]
    }
  },
