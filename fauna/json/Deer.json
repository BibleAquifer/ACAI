  "localizations": {
    "eng": {
      "preferred_label": "Deer",
      "alternate_labels": [
        "Fallow Deer"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Deer",
          "article": "fauna:Deer",
          "description": "A wild animal with antlers that are shed yearly and has reddish fur with white spots in summer."
        }
      ]
    },
    "apd": {
      "preferred_label": "غزال",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان بري عنده قرون بتتساقط سنوياً، وفروه لونه محمر ببقع بيضا في الصيف."
        }
      ]
    },
    "arb": {
      "preferred_label": "أيَّل",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان بري ذو قرون متفرعة تسقط سنويًّا، وله فراء ضارب إلى الحمرة مع بقع بيضاء في الصيف."
        }
      ]
    },
    "bis": {
      "preferred_label": "dia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan wael anamol we i gat ol kom we oli stap foldaon evri yia mo i gat gras we i red wetem ol waet spot long taem blong san."
        }
      ]
    },
    "fra": {
      "preferred_label": "cerf",
      "descriptions": [
        {
          "source": "acai",
          "description": "Animal sauvage portant des bois qui tombent chaque année, au pelage rougeâtre tacheté de blanc en été."
        }
      ]
    },
    "hau": {
      "preferred_label": "Barewa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata dabbar daji mai ƙahoni masu rassa da ake zubarwa a kowace shekara, kuma tana da ja-jan gashi mai ɗigon fari a lokacin rani."
        }
      ]
    },
    "hin": {
      "preferred_label": "हिरन",
      "descriptions": [
        {
          "source": "acai",
          "description": "सींगों वाला एक जंगली जानवर जिसके सींग हर साल झड़ जाते हैं और गर्मियों में सफेद धब्बों वाला लाल रंग का रोआँ होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ele",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anụ ọhịa nwere mpi na-apụ apụ kwa afọ, nweekwa aji na-acha ọbara ọbara nke nwere ntụpọ ọcha n'oge ọkọchị."
        }
      ]
    },
    "ind": {
      "preferred_label": "rusa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hewan liar bertanduk yang gugur setiap tahun dan memiliki bulu kemerahan dengan bintik-bintik putih di musim panas."
        }
      ]
    },
    "nep": {
      "preferred_label": "हरिण",
      "descriptions": [
        {
          "source": "acai",
          "description": "हरेक वर्ष झर्ने सिङहरू भएको र ग्रीष्म ऋतुमा सेतो थोप्लाहरू भएको रातो रङको भुत्ला हुने एउटा जङ्गली जनावर।"
        }
      ]
    },
    "por": {
      "preferred_label": "veado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um animal selvagem com chifres que caem todos os anos e que possui pelos avermelhados com manchas brancas no verão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Олень",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дикое животное с рогами, которые сбрасываются ежегодно, и рыжеватой шерстью с белыми пятнами летом."
        }
      ]
    },
    "spa": {
      "preferred_label": "ciervo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Animal salvaje con cornamenta que muda cada año y pelaje rojizo con manchas blancas en verano."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kulungu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama wa porini mwenye pembe zenye matawi ambazo hung'oka kila mwaka na ana manyoya mekundu yenye madoa meupe wakati wa kiangazi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "dia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela wel abus i gat ol kom (hons) we i save lus long olgeta yia, na em i gat retpela gras wantaim waitpela liklik makmak long taim bilong san."
        }
      ]
    },
    "vie": {
      "preferred_label": "Hươu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài động vật hoang dã có gạc rụng hàng năm và có lông màu hơi đỏ với các đốm trắng vào mùa hè."
        }
      ]
    },
    "zhs": {
      "preferred_label": "鹿",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种长有每年脱落的鹿角、夏季毛色偏红并带有白斑的野生动物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鹿",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種野生動物，長有每年脫落的鹿角，夏季毛色偏紅並帶有白色斑點。"
        }
      ]
    }
  },
