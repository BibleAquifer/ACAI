    "eng": {
      "preferred_label": "Elephant",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Elephant",
          "article": "fauna:Elephant",
          "description": "A large land animal with a long trunk and big ears, found in Africa and Asia."
        }
      ]
    },
    "apd": {
      "preferred_label": "فيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان بري كبير وعنده خرطوم طويل وأضنين كبار، موجود في أفريقيا وآسيا."
        }
      ]
    },
    "arb": {
      "preferred_label": "فيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان بري ضخم ذو خرطوم طويل وأذنين كبيرتين، يوجد في إفريقيا وآسيا."
        }
      ]
    },
    "bis": {
      "preferred_label": "elefen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala anamol blong graon we i gat longfala nus mo bigbigfala sora, we i stap long Afrika mo Esia."
        }
      ]
    },
    "fra": {
      "preferred_label": "éléphant",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grand animal terrestre doté d’une longue trompe et de grandes oreilles, que l’on trouve en Afrique et en Asie."
        }
      ]
    },
    "hau": {
      "preferred_label": "Giwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata babbar dabbar tudu mai dogon hanci (hancin giwa) da manyan kunnuwa, da ake samu a Afirka da Asiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "हाथी",
      "descriptions": [
        {
          "source": "acai",
          "description": "लंबी सूँड और बड़े कानों वाला एक विशाल थलचर जानवर, जो अफ्रीका और एशिया में पाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "enyi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu anụ ala nwere ogologo imi na nnukwu ntị, nke a na-ahụ n'Afrịka na Eshia."
        }
      ]
    },
    "ind": {
      "preferred_label": "gajah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hewan darat besar dengan belalai panjang dan telinga besar, ditemukan di Afrika dan Asia."
        }
      ]
    },
    "nep": {
      "preferred_label": "हात्ती",
      "descriptions": [
        {
          "source": "acai",
          "description": "अफ्रिका र एसियामा पाइने लामो सुँड र ठुला कान भएको एउटा ठुलो स्थलचर जनावर।"
        }
      ]
    },
    "por": {
      "preferred_label": "elefante",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um grande animal terrestre com tromba comprida e orelhas grandes, encontrado na África e na Ásia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Слон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупное сухопутное животное с длинным хоботом и большими ушами, обитающее в Африке и Азии."
        }
      ]
    },
    "spa": {
      "preferred_label": "elefante",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gran animal terrestre con una larga trompa y grandes orejas, originario de África y Asia."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tembo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama mkubwa wa nchi kavu mwenye mkonga mrefu na masikio makubwa, anayepatikana Afrika na Asia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "elefan",
      "descriptions": [
        {
          "source": "acai",
