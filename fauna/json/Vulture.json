  "localizations": {
    "eng": {
      "preferred_label": "Vulture",
      "alternate_labels": [
        "Eagle",
        "Bird of Prey",
        "Lammergeier",
        "Buzzard"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Vulture",
          "article": "fauna:Vulture",
          "description": "A large bird of prey with keen eyesight, often linked to death and ceremonially unclean to eat in the Bible."
        }
      ]
    },
    "apd": {
      "preferred_label": "نسر",
      "descriptions": [
        {
          "source": "acai",
          "description": "طائر جارح كبير نظره حاد، غالباً برتبط بالموت، وبحسب شريعة الكتاب المقدس أكله نجس طقسياً."
        }
      ]
    },
    "arb": {
      "preferred_label": "نسر",
      "descriptions": [
        {
          "source": "acai",
          "description": "طائر جارح كبير حاد البصر، غالبًا ما يرتبط بالموت، ويُعد نجسًا طقسيًا ولا يؤكل في الكتاب المقدس."
        }
      ]
    },
    "bis": {
      "preferred_label": "valja",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala pijin blong bus we ae blong hem i sap tumas, we plante taem i joen wetem ded mo i tabu blong kakae folem kastom long Baebol."
        }
      ]
    },
    "fra": {
      "preferred_label": "vautour",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un grand oiseau de proie doté d’une vue perçante, souvent associé à la mort et considéré comme rituellement impur dans la Bible."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ungulu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban tsuntsu mai farautar nama mai kaifin gani, wanda galibi ake danganta shi da mutuwa kuma a cikin Littafi Mai Tsarki ya zama marar tsarki ga ci."
        }
      ]
    },
    "hin": {
      "preferred_label": "गिद्ध",
      "descriptions": [
        {
          "source": "acai",
          "description": "तीक्ष्ण दृष्टि वाला एक बड़ा शिकारी पक्षी, जो अक्सर मृत्यु से जुड़ा होता है और बाइबल में जिसका खाना विधिवत रूप से अशुद्ध माना गया है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Udele",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu nnụnụ na-eri anụ nke nwere anya na-ahụ ụzọ nke ọma, nke a na-ejikọkarị na ọnwụ ma bụrụkwa ihe na-adịghị ọcha nʼemume iri na Baịbụl."
        }
      ]
    },
    "ind": {
      "preferred_label": "burung nasar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Burung pemangsa besar dengan penglihatan tajam, sering dikaitkan dengan kematian dan secara upacara najis untuk dimakan dalam Alkitab."
        }
      ]
    },
    "nep": {
      "preferred_label": "गिद्ध",
      "descriptions": [
        {
          "source": "acai",
          "description": "गहिरो दृष्टि भएको एउटा ठूलो शिकारी चरा, जुन प्रायः मृत्युसँग जोडिएको हुन्छ र बाइबलमा खानका लागि धार्मिक रूपमा अशुद्ध मानिएको छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "abutre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma grande ave de rapina com visão aguçada, frequentemente associada à morte e cerimonialmente impura para consumo na Bíblia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гриф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупная хищная птица с острым зрением, часто ассоциирующаяся со смертью и считавшаяся в Библии церемониально нечистой для употребления в пищу."
        }
      ]
    },
    "spa": {
      "preferred_label": "buitre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gran ave rapaz con vista aguda, a menudo vinculada a la muerte y considerada ceremonialmente impura para comer en la Biblia."
        }
      ]
    },
    "swh": {
      "preferred_label": "tai mzoga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndege mkubwa mwindaji mwenye uwezo mkubwa wa kuona, mara nyingi huhusishwa na kifo na ni najisi kuliwa kulingana na sheria za kidini katika Biblia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tarangau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela pisin bilong kaikai abus i gat klia ai bilong lukluk, planti taim ol man i tingting long dai bilong man na em i tambu long ol i kaikai long Baibel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kên kên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài chim săn mồi lớn có thị lực tinh tường, thường liên quan đến sự chết và bị coi là ô uế theo nghi lễ trong Kinh Thánh không được ăn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "兀鹫",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种视力敏锐的大型猛禽，常与死亡联系在一起，在圣经中礼仪上属于不可食用的不洁之物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "禿鷹",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種視力敏銳的大型猛禽，常與死亡關聯，在聖經中禮儀上是不潔淨不可食用的。"
        }
      ]
    }
  },
