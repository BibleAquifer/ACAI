  "localizations": {
    "eng": {
      "preferred_label": "Bird",
      "alternate_labels": [
        "Fowl"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Bird",
          "article": "fauna:Bird",
          "description": "A small flying animal with feathers and wings. Some birds were offered as sacrifices to God in worship."
        }
      ]
    },
    "apd": {
      "preferred_label": "طير",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان صغير بيطير عنده ريش وجنحات. في طيور معينة كان بيتقدم منها ذبائح وضحايا لله في العبادة."
        }
      ]
    },
    "arb": {
      "preferred_label": "طائر",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان طائر صغير ذو ريش وأجنحة. كانت بعض الطيور تُقدَّم ذبائح لله في العبادة."
        }
      ]
    },
    "bis": {
      "preferred_label": "pijin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol anamol we i flae wetem ol feda mo win. Sam pijin oli bin givim olsem sakrefaes long God long wosip."
        }
      ]
    },
    "fra": {
      "preferred_label": "oiseau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit animal volant pourvu de plumes et d'ailes. Certains oiseaux étaient offerts en sacrifice à Dieu lors du culte."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tsuntsu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙaramar halitta mai tashi sama mai fuka-fukai da fiffike. An miƙa wasu tsuntsaye a matsayin hadayu ga Allah a wurin ibada."
        }
      ]
    },
    "hin": {
      "preferred_label": "पक्षी",
      "descriptions": [
        {
          "source": "acai",
          "description": "पंखों और डैनों वाला एक छोटा उड़ने वाला प्राणी। आराधना में कुछ पक्षी परमेश्वर को बलि के रूप में चढ़ाए जाते थे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nnụnụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere anụ ufe nwere nku na ábụ́bà. A na-eji ụfọdụ nnụnụ achụrụ Chineke àjà nʼofufe."
        }
      ]
    },
    "ind": {
      "preferred_label": "burung",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hewan terbang berukuran kecil yang memiliki bulu dan sayap. Beberapa burung dipersembahkan sebagai kurban bagi Allah dalam ibadah."
        }
      ]
    },
    "nep": {
      "preferred_label": "पक्षी",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्वाँख र पखेटा भएको सानो उड्ने प्राणी। आराधना गर्दा केही पक्षीहरू परमेश्वरलाई बलिको रूपमा चढाइन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "ave",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um pequeno animal voador com penas e asas. Algumas aves eram oferecidas como sacrifícios a Deus no culto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Птица",
      "descriptions": [
        {
          "source": "acai",
          "description": "Небольшое летающее животное, покрытое перьями и имеющее крылья. Некоторые птицы приносились в жертву Богу при поклонении."
        }
      ]
    },
    "spa": {
      "preferred_label": "ave",
      "descriptions": [
        {
          "source": "acai",
          "description": "Animal volador de pequeño tamaño con plumas y alas. Algunas aves se presentaban como ofrenda de sacrificio a Dios en el culto."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ndege",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama mdogo anayeruka mwenye manyoya na mabawa. Baadhi ya ndege walitolewa kama dhabihu kwa Mungu katika ibada."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pisin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik animal i gat feda na wing na i save flai. Bipo ol i save givim sampela pisin olsem ofa bilong lotuim God."
        }
      ]
    },
    "vie": {
      "preferred_label": "Chim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài động vật biết bay nhỏ có lông vũ và cánh. Một số loài chim đã được dâng làm tế lễ cho Đức Chúa Trời trong sự thờ phượng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "鸟",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种长有羽毛和翅膀的小型飞行动物。在敬拜中，某些鸟类曾被献给上帝作为祭物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鳥",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種長有羽毛和翅膀的小型飛行動物。在敬拜中，有些鳥類被獻給上帝作為祭物。"
        }
      ]
    }
  },
