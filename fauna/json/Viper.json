  "localizations": {
    "eng": {
      "preferred_label": "Viper",
      "alternate_labels": [
        "Cobra",
        "Carpet Viper"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Viper",
          "article": "fauna:Viper",
          "description": "An extremely poisonous snake often linked to danger, found in deserts and grasslands."
        }
      ]
    },
    "apd": {
      "preferred_label": "أفعى",
      "descriptions": [
        {
          "source": "acai",
          "description": "دبيب سام جداً، غالباً برتبط بالخطر، وبيكون في الصحاري ومناطق الحشائش."
        }
      ]
    },
    "arb": {
      "preferred_label": "أفعى",
      "descriptions": [
        {
          "source": "acai",
          "description": "حية شديدة السمية غالبًا ما ترتبط بالخطر، وتوجد في الصحاري والمروج."
        }
      ]
    },
    "bis": {
      "preferred_label": "posen snek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan snek we i gat posen tumas mo plante taem i denja, we i stap long ol draeples mo ol ples we i gat gras."
        }
      ]
    },
    "fra": {
      "preferred_label": "vipère",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un serpent extrêmement venimeux souvent associé au danger, présent dans les déserts et les prairies."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kububuwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mugun maciji mai dafi sosai wanda galibi ake danganta shi da hatsari, ana samunsa a hamada da kuma ciyayi."
        }
      ]
    },
    "hin": {
      "preferred_label": "नाग",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अत्यधिक विषैला साँप जो अक्सर खतरे से जुड़ा होता है, और रेगिस्तानों तथा घास के मैदानों में पाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ajụala",
      "descriptions": [
        {
          "source": "acai",
          "description": "Agwọ nwere ezigbo nsị nke a na-ejikọkarị na ihe egwu, nke a na-ahụkarị nʼọzara na ahịhịa."
        }
      ]
    },
    "ind": {
      "preferred_label": "ular beludak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ular yang sangat berbisa yang sering dikaitkan dengan bahaya, dijumpai di padang gurun dan padang rumput."
        }
      ]
    },
    "nep": {
      "preferred_label": "विषालु सर्प",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अत्यधिक विषालु सर्प जुन प्रायः खतरासँग सम्बन्धित छ र मरुभूमि तथा घाँसे मैदानहरूमा पाइन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "víbora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma serpente extremamente venenosa, frequentemente associada ao perigo, encontrada em desertos e pastagens."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гадюка",
      "descriptions": [
        {
          "source": "acai",
          "description": "Чрезвычайно ядовитая змея, часто ассоциирующаяся с опасностью, обитающая в пустынях и степях."
        }
      ]
    },
    "spa": {
      "preferred_label": "víbora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Serpiente sumamente venenosa a menudo vinculada al peligro, que habita en desiertos y pastizales."
        }
      ]
    },
    "swh": {
      "preferred_label": "nyoka mwenye sumu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nyoka mwenye sumu kali sana ambaye mara nyingi huhusishwa na hatari, anayepatikana majangwani na katika nyasi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Snek nogut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain snek i gat poisun nogut tru na planti taim ol man i save tingting long bagarap bilong en, em i save stap long ol ples drai nating na ol ples gras."
        }
      ]
    },
    "vie": {
      "preferred_label": "Rắn độc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài rắn cực độc thường liên hệ với sự nguy hiểm, sống ở hoang mạc và đồng cỏ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "毒蛇",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种常与危险联系在一起的剧毒蛇，见于沙漠和草地。"
        }
      ]
    },
    "zht": {
      "preferred_label": "毒蛇",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種極毒的蛇，常與危險關聯，生活在沙漠和草原中。"
        }
      ]
    }
  },
