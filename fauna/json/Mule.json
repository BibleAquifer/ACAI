  "localizations": {
    "eng": {
      "preferred_label": "Mule",
      "alternate_labels": [
        "Ass",
        "Donkey"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Mule",
          "article": "fauna:Mule",
          "description": "A hybrid animal, born from a donkey and a horse, often used in biblical times for carrying loads and riding."
        }
      ]
    },
    "apd": {
      "preferred_label": "بغل",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان مهجن، بتولد من حمار وحصان، وكان كتير بستعملوهو في أزمنة الكتاب المقدس لنقل الأحمال وللركوب."
        }
      ]
    },
    "arb": {
      "preferred_label": "بغل",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان هجين يولد من تزاوج الحمار والحصان، وكان يُستخدم كثيرًا في الأزمنة الكتابية لحمل الأثقال والركوب."
        }
      ]
    },
    "bis": {
      "preferred_label": "hafkas dongki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hafkas anamol we mama blong hem i hos mo papa i dongki (o naravei), we long taem blong Baebol ol man oli stap yusum blong karem ol hevi kago mo blong raed long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "mulet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un animal hybride, né du croisement d'un âne et d'une jument, souvent utilisé aux temps bibliques comme bête de somme et pour la monte."
        }
      ]
    },
    "hau": {
      "preferred_label": "Alfadari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dabbar da aka haifa daga jakai da doki, wadda a lokutan Littafi Mai Tsarki aka saba amfani da ita wajen ɗaukar kaya da hawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "खच्चर",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक संकर (दोगला) जानवर, जो गधे और घोड़ी के संयोग से पैदा होता है, और बाइबल के समय में अक्सर बोझ ढोने तथा सवारी करने के लिए उपयोग किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịnyịnya muul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anụ ngwakọ, nke amụrụ site n'ịnyịnya ibu na ịnyịnya nkịtị, nke a na-ejikarị ebu ibu na ịgba n'oge Baịbụl."
        }
      ]
    },
    "ind": {
      "preferred_label": "bagal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hewan bastar hasil persilangan keledai dan kuda, sering digunakan pada zaman Alkitab untuk mengangkut beban dan ditunggangi."
        }
      ]
    },
    "nep": {
      "preferred_label": "खच्चर",
      "descriptions": [
        {
          "source": "acai",
          "description": "गधा र घोडाको संसर्गबाट जन्मिएको एक वर्णशङ्कर जनावर, जुन बाइबलीय समयमा भारी बोक्न र चढ्नका लागि प्रायः प्रयोग गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "mula",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um animal híbrido, nascido do cruzamento entre um jumento e uma égua (ou cavalo e jumenta), frequentemente usado nos tempos bíblicos para transporte de carga e montaria."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мул",
      "descriptions": [
        {
          "source": "acai",
          "description": "Гибридное животное, происходящее от осла и кобылицы, часто использовавшееся в библейские времена для верховой езды и перевозки грузов."
        }
      ]
    },
    "spa": {
      "preferred_label": "mula",
      "descriptions": [
        {
          "source": "acai",
          "description": "Animal híbrido, cruce de asno y yegua (o caballo y burra), usado con frecuencia en los tiempos bíblicos como animal de carga y de monta."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nyumbu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama chotara, anayezaliwa kutokana na punda na farasi, mara nyingi alitumiwa nyakati za Biblia kubeba mizigo na kupandwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "hapkas bilong hos na donki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela abus i hapkas bilong donki na hos, bipo long taim bilong Baibel ol man i save yusim em bilong karim kago na bilong raun antap long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "La",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài động vật lai, sinh ra từ lừa và ngựa, thường được dùng trong thời Kinh Thánh để chở hàng và cưỡi."
        }
      ]
    },
    "zhs": {
      "preferred_label": "骡子",
      "descriptions": [
        {
          "source": "acai",
          "description": "由公驴和母马杂交所生的一种动物，在圣经时代常用于驮运和骑乘。"
        }
      ]
    },
    "zht": {
      "preferred_label": "騾子",
      "descriptions": [
        {
          "source": "acai",
          "description": "驢和馬交配所生的雜交動物，在聖經時代常用於馱負重物和騎乘。"
        }
      ]
    }
  },
