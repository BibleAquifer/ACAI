  "localizations": {
    "eng": {
      "preferred_label": "Dragon",
      "alternate_labels": [
        "Sea Monster"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Dragon",
          "article": "fauna:Dragon",
          "description": "A monstrous reptile creature often described as a giant winged serpent or sea monster."
        }
      ]
    },
    "apd": {
      "preferred_label": "تنين",
      "descriptions": [
        {
          "source": "acai",
          "description": "كائن زاحف وخرافي وضخم، غالباً بوصفوه بأنه تعبان مجنح كبير أو وحش بحري."
        }
      ]
    },
    "arb": {
      "preferred_label": "تِنّين",
      "descriptions": [
        {
          "source": "acai",
          "description": "مخلوق زاحف هائل غالبًا ما يُوصف بأنه حيّة مجنحة عملاقة أو وحش بحري."
        }
      ]
    },
    "bis": {
      "preferred_label": "dregon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan anamol olsem reptael we i kabanis, we plante taem oli tokbaot olsem wan bigfala snek we i gat wing no wan bigfala monster blong solwota."
        }
      ]
    },
    "fra": {
      "preferred_label": "dragon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Créature reptilienne monstrueuse souvent décrite comme un serpent ailé géant ou un monstre marin."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dodanniya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙatuwar dabbar rarrafe mai ban tsoro da aka saba siffantawa a matsayin ƙaton maciji mai fiffike ko dodon ruwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "अजगर",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक विशालकाय सरीसृप जीव जिसे अक्सर पंखों वाले विशाल सर्प या समुद्री जीव के रूप में वर्णित किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "dragọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu anụ na-akpụ akpụ dị egwu nke a na-akọwakarị dị ka agwọ ukwu nwere nku maọbụ anụ mmiri dị egwu."
        }
      ]
    },
    "ind": {
      "preferred_label": "naga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Makhluk reptil raksasa yang sering digambarkan sebagai ular bersayap raksasa atau monster laut."
        }
      ]
    },
    "nep": {
      "preferred_label": "अजिङ्गर",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः पखेटा भएको विशाल सर्प वा समुद्री राक्षसको रूपमा वर्णन गरिएको एक भयानक घस्रने जन्तु।"
        }
      ]
    },
    "por": {
      "preferred_label": "dragão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma criatura reptiliana monstruosa frequentemente descrita como uma serpente alada gigante ou monstro marinho."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дракон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Чудовищное пресмыкающееся существо, часто описываемое как гигантский крылатый змей или морское чудовище."
        }
      ]
    },
    "spa": {
      "preferred_label": "dragón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Monstruosa criatura reptiliana a menudo descrita como una serpiente alada gigante o un monstruo marino."
        }
      ]
    },
    "swh": {
      "preferred_label": "Joka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kiumbe mkubwa sana wa jamii ya reptilia anayeelezewa mara nyingi kama nyoka mkubwa mwenye mabawa au mnyama mkubwa wa baharini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "dregon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela animal bilong stori nating olsem traipela snek i gat wing o traipela snek masalai bilong solwara."
        }
      ]
    },
    "vie": {
      "preferred_label": "Rồng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một sinh vật bò sát khổng lồ thường được mô tả là loài rắn có cánh khổng lồ hoặc quái vật biển."
        }
      ]
    },
    "zhs": {
      "preferred_label": "龙",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种巨大的爬行类怪兽，常被描述为长有翅膀的巨蛇或海怪。"
        }
      ]
    },
    "zht": {
      "preferred_label": "龍",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種巨大的爬行類怪獸，常被描述為巨大的有翼巨蛇或海怪。"
        }
      ]
    }
  },
