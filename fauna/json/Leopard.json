      "descriptions": [
        {
          "source": "acai",
          "gloss": "Leopard",
          "article": "fauna:Leopard",
          "description": "A big cat with yellowish fur and black spots, known for its strength and being dangerous."
        }
      ]
    },
    "apd": {
      "preferred_label": "نمر",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان مفترس كبير من فصيلة السنوريات شعره مصفر وفيهو نقط سوداء، معروف بقوته وخطورته."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَمِر",
      "descriptions": [
        {
          "source": "acai",
          "description": "حيوان مفترس كبير من الفصيلة السنورية ذو فراء مصفر وبقع سوداء، معروف بقوته وخطورته."
        }
      ]
    },
    "bis": {
      "preferred_label": "leped",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala puskat we fua blong hem i yelo mo i gat ol blak spot long hem, we i wael, i gat paoa mo i denja tumas."
        }
      ]
    },
    "fra": {
      "preferred_label": "léopard",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grand félin au pelage jaunâtre tacheté de noir, réputé pour sa force et sa dangerosité."
        }
      ]
    },
    "hau": {
      "preferred_label": "Damisa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata babbar dabbar daji mai kama da kyanwa mai launin rawaya da baƙaƙen ɗigo-ɗigo, wadda aka sani da ƙarfinta da kuma haɗari."
        }
      ]
    },
    "hin": {
      "preferred_label": "चीता",
      "descriptions": [
        {
          "source": "acai",
          "description": "पीले रंग के रोएँ और काले धब्बों वाली एक बड़ी बिल्ली प्रजाति का जन्तु, जो अपनी ताकत और खतरनाक होने के लिए जाना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Agụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu anụ ọhịa nọ nʼezinụlọ nwamba nwere ajị na-acha odo odo na ntụpọ ojii, nke a maara maka ike ya na ịbụ anụ dị ize ndụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "macan tutul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kucing besar dengan bulu kekuningan dan bintik-bintik hitam, dikenal karena kekuatannya dan berbahaya."
        }
      ]
    },
    "nep": {
      "preferred_label": "चितुवा",
      "descriptions": [
        {
          "source": "acai",
          "description": "पहेँलो रङको भुत्ला र कालो थोप्लाहरू भएको एउटा ठूलो बिरालो प्रजातिको जनावर, जो आफ्नो बल र खतरनाक स्वभावका निम्ति चिनिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "Leopardo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um grande felino de pelagem amarelada com manchas pretas, conhecido por sua força e por ser perigoso."
        }
      ]
    },
    "rus": {
      "preferred_label": "Барс",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупный представитель кошачьих с желтоватой шерстью и черными пятнами, известный своей силой и опасностью."
        }
      ]
    },
    "spa": {
      "preferred_label": "leopardo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Felino grande de pelaje amarillento y manchas negras, conocido por su fuerza y por ser peligroso."
        }
      ]
    },
    "swh": {
      "preferred_label": "Chui",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mnyama mkubwa wa jamii ya paka mwenye manyoya ya manjano na madoa meusi, anayejulikana kwa nguvu na hatari yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "lepat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela wel pusi i gat yelopela gras na ol blakpela makmak, ol i save long strong bilong en na em i save mekim man i pret."
        }
      ]
    },
    "vie": {
      "preferred_label": "báo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài mèo lớn có bộ lông màu vàng nhạt với các đốm đen, nổi tiếng về sức mạnh và sự hung dữ nguy hiểm."
        }
      ]
    },
    "zhs": {
      "preferred_label": "豹",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种大型猫科动物，毛皮呈黄褐色并带有黑斑，以其力量和危险性著称。"
        }
      ]
    },
    "zht": {
      "preferred_label": "豹",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種大型貓科動物，具有黃色帶黑斑的皮毛，以其力量和危險性聞名。"
        }
      ]
    }
  },
