  "localizations": {
    "eng": {
      "preferred_label": "Thread",
      "alternate_labels": [
        "Cord"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Thread",
          "article": "realia:Thread",
          "description": "A thin strand made of cotton, wool, flax, or metal, used for sewing, measuring, and tying."
        }
      ]
    },
    "apd": {
      "preferred_label": "خيط",
      "descriptions": [
        {
          "source": "acai",
          "description": "سلك رفيع مصنوع من القطن أو الصوف أو الكتان أو المعدن، بيستعملوه في الخياطة والقياس والربط."
        }
      ]
    },
    "arb": {
      "preferred_label": "خَيْط",
      "descriptions": [
        {
          "source": "acai",
          "description": "خَيْطٌ رَفِيعٌ مَصْنُوعٌ مِنَ ٱلْقُطْنِ أَوِ ٱلصُّوفِ أَوِ ٱلْكَتَّانِ أَوِ ٱلْمَعْدِنِ، يُسْتَخْدَمُ لِلْخِيَاطَةِ وَٱلْقِيَاسِ وَٱلرَّبْطِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "tred",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol rop o string we oli mekem wetem koten, wul, flaks, o aean, we oli yusum blong somap samting, mesarem samting, mo fasem samting."
        }
      ]
    },
    "fra": {
      "preferred_label": "fil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un brin fin fait de coton, de laine, de lin ou de métal, utilisé pour coudre, mesurer et attacher."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zare",
      "descriptions": [
        {
          "source": "acai",
          "description": "Siririn zare da aka yi da auduga, ulu, lallausan lalli, ko ƙarfe, wanda ake amfani da shi wajen ɗinki, awo, da ɗaurewa."
        }
      ]
    },
    "hin": {
      "preferred_label": "सूत",
      "descriptions": [
        {
          "source": "acai",
          "description": "कपास, ऊन, सन या धातु से बना एक पतला रेशा या तार, जिसका उपयोग सिलाई, नापने और बाँधने के लिए किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Eriri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu mkpụrụ eriri dị gịrịgịrị nke e ji owu, ajị anụ, flax, maọbụ igwe mee, nke a na-eji anya akwa, atụ ihe, maọbụ eke ihe."
        }
      ]
    },
    "ind": {
      "preferred_label": "benang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seutas untaian tipis yang terbuat dari kapas, wol, lenan, atau logam, yang digunakan untuk menjahit, mengukur, dan mengikat."
        }
      ]
    },
    "nep": {
      "preferred_label": "धागो",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिलाउन, नाप्‍न र बाँध्‍न प्रयोग गरिने कपास, ऊन, सनपाट वा धातुबाट बनेको पातलो त्यान्द्रो वा धागो ।"
        }
      ]
    },
    "por": {
      "preferred_label": "fio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fio fino feito de algodão, lã, linho ou metal, usado para costurar, medir e amarrar."
        }
      ]
    },
    "rus": {
      "preferred_label": "Нить",
      "descriptions": [
        {
          "source": "acai",
          "description": "Тонкая нить из хлопка, шерсти, льна или металла, используемая для шитья, измерения и связывания."
        }
      ]
    },
    "spa": {
      "preferred_label": "hilo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hebra delgada hecha de algodón, lana, lino o metal, usada para coser, medir y atar."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uzi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uzi mwembamba uliotengenezwa kwa pamba, sufu, kitani, au chuma, unaotumika kushona, kupimia, na kufungia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "tret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik hap tret ol i wokim long koten, gras bilong sipsip, flegs, o kopa/ain, ol i save yusim bilong samap, makim sais, o pasim samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sợi chỉ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một sợi mảnh làm bằng bông, len, lanh hoặc kim loại, dùng để may vá, đo đạc và buộc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "线",
      "descriptions": [
        {
          "source": "acai",
          "description": "由棉、羊毛、亚麻或金属制成的细缕，用于缝纫、测量和捆绑。"
        }
      ]
    },
    "zht": {
      "preferred_label": "線",
      "descriptions": [
        {
          "source": "acai",
          "description": "由棉、羊毛、亞麻或金屬製成的細縷，用於縫紉、量度及捆綁。"
        }
      ]
    }
  },
