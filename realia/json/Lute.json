  "localizations": {
    "eng": {
      "preferred_label": "Lute",
      "alternate_labels": [
        "Lyre",
        "Small Lyre",
        "Exile"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Lute",
          "article": "realia:Lute",
          "description": "A wooden musical instrument with strings stretched over a sound box, often used to play music for singing."
        }
      ]
    },
    "apd": {
      "preferred_label": "عود",
      "descriptions": [
        {
          "source": "acai",
          "description": "آلة موسيقية خشبية فيها أوتار مشدودة فوق صندوق صوت، وغالباً بتستعمل لعزف الموسيقى للمصاحبة مع الغنا."
        }
      ]
    },
    "arb": {
      "preferred_label": "عود",
      "descriptions": [
        {
          "source": "acai",
          "description": "آلة موسيقية خشبية ذات أوتار مشدودة على صندوق صوتي، تُستخدم غالبًا للعزف لمصاحبة الغناء."
        }
      ]
    },
    "bis": {
      "preferred_label": "gita",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan instramen blong miusik we oli wokem long wud mo i gat ol waea o string we oli pulum i taet antap long hem, we plante taem oli stap plei long hem blong singsing."
        }
      ]
    },
    "fra": {
      "preferred_label": "luth",
      "descriptions": [
        {
          "source": "acai",
          "description": "Instrument de musique en bois muni de cordes tendues sur une caisse de résonance, souvent utilisé pour accompagner le chant."
        }
      ]
    },
    "hau": {
      "preferred_label": "Molo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kayan kida na itace mai tsarin igiyoyi da aka shimfiɗa a kan akwatin sauti, wanda galibi ake amfani da shi don yin waƙoƙi."
        }
      ]
    },
    "hin": {
      "preferred_label": "वीणा",
      "descriptions": [
        {
          "source": "acai",
          "description": "लकड़ी का बना एक तंतुवाद्य (तार वाला वाद्ययंत्र) जिसके अनुनादक (साउंड बॉक्स) पर तार खिंचे होते हैं, जिसका उपयोग अक्सर गायन के साथ संगीत बजाने के लिए किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụbọ akwara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ngwá egwú e ji osisi mee nke nwere akwara gbatịrị n'elu igbe ụda, nke a na-ejikarị akpọ egwú maka ịbụ abụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "kecapi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alat musik dari kayu dengan senar-senar yang direntangkan di atas kotak bunyi, sering kali digunakan untuk memainkan musik guna mengiringi nyanyian."
        }
      ]
    },
    "nep": {
      "preferred_label": "वीणा",
      "descriptions": [
        {
          "source": "acai",
          "description": "गायनका लागि सङ्गीत बजाउन प्रायः प्रयोग गरिने, साउन्ड बक्समाथि तारहरू टाँगिएको काठको एक बाजा।"
        }
      ]
    },
    "por": {
      "preferred_label": "alaúde",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um instrumento musical de madeira com cordas estendidas sobre uma caixa de ressonância, frequentemente usado para acompanhar o canto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Лютня",
      "descriptions": [
        {
          "source": "acai",
          "description": "Деревянный струнный музыкальный инструмент со струнами, натянутыми над резонансным корпусом, часто использовавшийся для аккомпанемента пению."
        }
      ]
    },
    "spa": {
      "preferred_label": "laúd",
      "descriptions": [
        {
          "source": "acai",
          "description": "Instrumento musical de madera con cuerdas tensadas sobre una caja de resonancia, a menudo utilizado para acompañar el canto."
        }
      ]
    },
    "swh": {
      "preferred_label": "Zeze",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ala ya muziki ya mbao yenye nyuzi zilizovutwa juu ya kisanduku cha sauti, ambayo mara nyingi hutumiwa kucheza muziki wa kuimbia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "gita",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain instramen diwai bilong mekim musik i gat string long en, planti taim ol i paitim bilong mekim musik bilong singsing."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đàn luýt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại nhạc cụ bằng gỗ có dây căng trên hộp cộng hưởng, thường được dùng để đệm nhạc cho bài hát."
        }
      ]
    },
    "zhs": {
      "preferred_label": "琵琶",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种在共鸣箱上张弦的木制乐器，常用于为歌唱伴奏。"
        }
      ]
    },
    "zht": {
      "preferred_label": "琴",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種木製弦樂器，琴弦拉緊固定在共鳴箱上，常在歌唱時伴奏。"
        }
      ]
    }
  },
