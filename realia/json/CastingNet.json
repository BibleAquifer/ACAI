  "localizations": {
    "eng": {
      "preferred_label": "Casting Net",
      "alternate_labels": [
        "Net",
        "Fishnet"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Casting Net",
          "article": "realia:CastingNet",
          "description": "A circular net with weights and a draw rope used for catching fish by throwing it from a boat or shore."
        }
      ]
    },
    "apd": {
      "preferred_label": "شبكة طرح",
      "descriptions": [
        {
          "source": "acai",
          "description": "شبكة دائرية فيها أثقال وحبل جر تُستعمل لصيد السمك برميها من المركب أو من الشاطئ."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَبَكَةُ طَرْحٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَبَكَةٌ دَائِرِيَّةٌ ذَاتُ أَثْقَالٍ وَحَبْلِ سَحْبٍ تُسْتَخْدَمُ لِصَيْدِ السَّمَكِ بِإِلْقَائِهَا مِنْ قَارِبٍ أَوْ مِنَ الشَّاطِئِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "net blong sakem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan raon net we i gat ol heve wetem wan rop blong pulum, we oli stap yusum blong kasem fis taem oli sakem aot long wan bot no long so."
        }
      ]
    },
    "fra": {
      "preferred_label": "épervier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filet circulaire muni de plombs et d'un cordon de tirage, utilisé pour capturer du poisson en le lançant depuis un bateau ou la rive."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ragar kamun kifi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Raga mai kewayen dauri da ke ɗauke da ƙarafunan nauyi da igiyar janyewa da ake amfani da ita wajen kama kifi ta wurin jefawa daga jirgin ruwa ko bakin ruwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "फेंकने का जाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "नाव या किनारे से फेंककर मछलियाँ पकड़ने के लिए काम में लाया जाने वाला भारयुक्त और खींचने वाली डोरी वाला एक गोलाकार जाल।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ụgbụ a na-atụba atụba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụgbụ dị okirikiri nwere ihe dị arọ na eriri a na-adọkpụ, nke a na-eji amata azụ site nʼịtụba ya site nʼụgbọ ma ọ bụ nʼikpere mmiri."
        }
      ]
    },
    "ind": {
      "preferred_label": "jala",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jaring bundar dengan pemberat dan tali penarik yang digunakan untuk menangkap ikan dengan cara melemparkannya dari perahu atau tepi pantai."
        }
      ]
    },
    "nep": {
      "preferred_label": "माछी-जाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "डुङ्गा वा किनारबाट फ्याँकेर माछा समात्‍न प्रयोग गरिने, गह्रुङ्गो तौल र तान्‍ने डोरी भएको गोलो आकारको जाल।"
        }
      ]
    },
    "por": {
      "preferred_label": "rede de arremesso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma rede circular com pesos e uma corda de puxar usada para pescar lançando-a de um barco ou da margem."
        }
      ]
    },
    "rus": {
      "preferred_label": "закидная сеть",
      "descriptions": [
        {
          "source": "acai",
          "description": "Круглая сеть с грузилами и вытяжным шнуром, используемая для ловли рыбы путем забрасывания с лодки или берега."
        }
      ]
    },
    "spa": {
      "preferred_label": "red de arrojar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Red circular con plomos y una cuerda corrediza que se usa para pescar arrojándola desde una barca o desde la orilla."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wavu wa Kurusha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wavu wa duara wenye vyuma vya uzito na kamba ya kuvutia unaotumiwa kuvulia samaki kwa kurushwa kutoka kwenye mashua au ukingoni mwa maji."
        }
      ]
    },
    "tpi": {
      "preferred_label": "umben bilong tromoi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela raunpela umben i gat ol hevi ain na rop bilong pulim, ol i save tromoi long bot o long nambis bilong kisim pis."
        }
      ]
    },
    "vie": {
      "preferred_label": "chài",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại lưới hình tròn có gắn chì và dây rút dùng để bắt cá bằng cách quăng từ thuyền hoặc bờ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "抛网",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种带铅坠和拉绳的圆形网，从船上或岸边抛撒出去捕鱼。"
        }
      ]
    },
    "zht": {
      "preferred_label": "撒網",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種邊緣帶有重物及拉繩的圓形漁網，藉由從船上或岸邊拋擲來捕魚。"
        }
      ]
    }
  },
