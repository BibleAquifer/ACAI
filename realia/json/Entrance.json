    "apd": {
      "preferred_label": "مدخل",
      "descriptions": [
        {
          "source": "acai",
          "description": "المنطقة أو الجزء من المبنى الذي يُدخل منه، بما في ذلك المساحة التي أمام الباب."
        }
      ]
    },
    "arb": {
      "preferred_label": "مدخل",
      "descriptions": [
