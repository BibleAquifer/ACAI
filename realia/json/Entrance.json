        }
      ]
    },
    "bis": {
      "preferred_label": "get",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ples o haf blong wan bilding we yu stap go insaed long hem, wetem spes long foret blong wan doa."
        }
      ]
    },
    "fra": {
      "preferred_label": "entrée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zone ou partie d’un bâtiment par où l’on entre, y compris l’espace situé devant une porte."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hanyar shiga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wurin ko sashin gini inda ake shiga, ciki har da sararin da ke gaban ƙofa."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रवेशद्वार",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी भवन का वह क्षेत्र या भाग जहाँ से भीतर प्रवेश किया जाता है, जिसमें द्वार के सामने का स्थान भी शामिल है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ọnụ ụzọ mbata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpaghara ma ọ bụ akụkụ nke ụlọ ebe a na-esi aba nʼime, gụnyere ohere dị nʼihu ọnụ ụzọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "pintu masuk",
