  "localizations": {
    "eng": {
      "preferred_label": "Ephah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ephah",
          "article": "realia:Ephah",
          "description": "A unit of dry measure used in the Bible, about 20 to 40 liters."
        }
      ]
    },
    "apd": {
      "preferred_label": "إيفة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة قياس جافة استُخدمت في الكتاب المقدس، تعادل حوالي 20 إلى 40 لتراً."
        }
      ]
    },
    "arb": {
      "preferred_label": "إيفة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة قياس للكيل مستخدمة في الكتاب المقدس، تعادل نحو 20 إلى 40 لترًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "efa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan mak blong makem ol samting we i drae we oli yusum long Baebol, we i samwe long 20 kasem 40 lita."
        }
      ]
    },
    "fra": {
      "preferred_label": "épha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Unité de mesure de capacité pour les matières sèches utilisée dans la Bible, valant environ 20 à 40 litres."
        }
      ]
    },
    "hau": {
      "preferred_label": "Efa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gwangwanin auna busassun abubuwa da aka yi amfani da shi a cikin Littafi Mai Tsarki, wajen lita 20 zuwa 40."
        }
      ]
    },
    "hin": {
      "preferred_label": "एपा",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाइबल में प्रयुक्त सूखे पदार्थों का एक माप, जो लगभग 20 से 40 लीटर के बराबर होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "efa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe ọtụtụ a na-eji atụ ihe akọrọ nʼime Baịbụl, nke ruru ihe dị ka lita 20 ruo 40."
        }
      ]
    },
    "ind": {
      "preferred_label": "efa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Satuan ukuran kering yang digunakan di dalam Alkitab, sekitar 20 hingga 40 liter."
        }
      ]
    },
    "nep": {
      "preferred_label": "एपा",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाइबलमा प्रयोग गरिएको ठोस वस्तु नाप्ने एक एकाइ, लगभग २० देखि ४० लिटर।"
        }
      ]
    },
    "por": {
      "preferred_label": "efa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Unidade de medida de secos usada na Bíblia, equivalente a cerca de 20 a 40 litros."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ефа",
      "descriptions": [
        {
          "source": "acai",
          "description": "Единица измерения объема сыпучих веществ, использовавшаяся в Библии, составлявшая от 20 до 40 литров."
        }
      ]
    },
    "spa": {
      "preferred_label": "efa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Unidad de medida para áridos utilizada en la Biblia, de unos 20 a 40 litros."
        }
      ]
    },
    "swh": {
      "preferred_label": "Efa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kipimo cha ujazo wa vitu vikavu kilichotumiwa katika Biblia, takriban lita 20 hadi 40."
        }
      ]
    },
    "tpi": {
      "preferred_label": "efa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela mak bilong skelim ol draipela samting ol i save yusim long Baibel, inap olsem 20 i go inap 40 lita."
        }
      ]
    },
    "vie": {
      "preferred_label": "ê-pha",
      "descriptions": [
        {
          "source": "acai",
