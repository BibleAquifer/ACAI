  "localizations": {
    "eng": {
      "preferred_label": "Small Shield",
      "alternate_labels": [
        "Shield",
        "Buckler",
        "Shield Round"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Small Shield",
          "article": "realia:SmallShield",
          "description": "A round, flat object made of wood or metal used in battle to protect a warrior from enemy weapons."
        }
      ]
    },
    "apd": {
      "preferred_label": "ترس صغير",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة مدورة ومسطحة مصنوعة من الخشب أو المعدن بتستعمل في المعركة عشان تحمي المحارب من أسلحة العدو."
        }
      ]
    },
    "arb": {
      "preferred_label": "مِجَنّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "أداة مسطحة مستديرة مصنوعة من الخشب أو المعدن، تُستخدم في المعركة لحماية المحارب من أسلحة العدو."
        }
      ]
    },
    "bis": {
      "preferred_label": "smol sil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan raon mo flet samting we oli wokem long wud o aean we man i yusum long faet blong protektem hem agensim ol tul blong faet blong enemi."
        }
      ]
    },
    "fra": {
      "preferred_label": "petit bouclier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Objet rond et plat, en bois ou en métal, utilisé au combat pour protéger un guerrier des armes ennemies."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙaramar garkuwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu mai faɗi kuma mai kewayen da aka yi da itace ko ƙarfe da ake amfani da shi a yaƙi don kāre mayaƙi daga makaman maƙiyi."
        }
      ]
    },
    "hin": {
      "preferred_label": "छोटी ढाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "युद्ध में योद्धा को शत्रु के हथियारों से बचाने के लिए इस्तेमाल की जाने वाली लकड़ी या धातु की एक गोल, चपटी वस्तु।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ọta nta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe dị gburugburu, dị larịị e ji osisi maọbụ igwe mee, nke a na-eji n'agha echebe onye agha pụọ n'ihe agha ndị iro."
        }
      ]
    },
    "ind": {
      "preferred_label": "perisai kecil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Benda bundar dan pipih yang terbuat dari kayu atau logam yang digunakan dalam pertempuran untuk melindungi seorang pejuang dari senjata musuh."
        }
      ]
    },
    "nep": {
      "preferred_label": "सानो ढाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "शत्रुका हतियारहरूबाट योद्धालाई जोगाउन युद्धमा प्रयोग गरिने काठ वा धातुबाट बनेको गोलो, थेप्चो साधन।"
        }
      ]
    },
    "por": {
      "preferred_label": "escudo pequeno",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um objeto redondo e plano feito de madeira ou metal usado em batalha para proteger um guerreiro das armas inimigas."
        }
      ]
    },
    "rus": {
      "preferred_label": "малый щит",
      "descriptions": [
        {
          "source": "acai",
          "description": "Круглый плоский предмет из дерева или металла, используемый в бою для защиты воина от оружия противника."
        }
      ]
    },
    "spa": {
      "preferred_label": "escudo pequeño",
      "descriptions": [
        {
          "source": "acai",
          "description": "Objeto redondo y plano hecho de madera o metal utilizado en la batalla para proteger a un guerrero de las armas enemigas."
        }
      ]
    },
    "swh": {
      "preferred_label": "kigao",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kifaa cha mviringo na bapa kilichotengenezwa kwa mbao au chuma kilichotumiwa vitani kumlinda shujaa dhidi ya silaha za adui."
        }
      ]
    },
    "tpi": {
      "preferred_label": "liklik hap plang bilong pait",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela raunpela samting ol i wokim long plang o kapa bilong helpim soldia long pait bai ol spia na bainat bilong ol birua i no ken bagarapim em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Khiên nhỏ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vật hình tròn, phẳng bằng gỗ hoặc kim loại dùng trong trận chiến để bảo vệ chiến binh khỏi vũ khí của kẻ thù."
        }
      ]
    },
    "zhs": {
      "preferred_label": "小盾牌",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种由木头或金属制成的扁平圆状器具，在战斗中用于保护战士免受敌人武器伤害。"
        }
      ]
    },
    "zht": {
      "preferred_label": "小盾牌",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種用木頭或金屬製成的扁平圓形物體，用於戰鬥中保護戰士免受敵方武器傷害。"
        }
      ]
    }
  },
