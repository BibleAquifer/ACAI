    "apd": {
      "preferred_label": "قارورة مسحة",
      "descriptions": [
        {
          "source": "acai",
          "description": "إناء صغير، غالباً بكون مصنوع من قرن كبش، بيستعمل لحفظ الزيت."
        }
      ]
    },
    "arb": {
      "preferred_label": "قِنِّينَةُ دُهْن",
      "descriptions": [
        {
          "source": "acai",
          "description": "وِعاءٌ صَغِيرٌ، غالِبًا ما يُصنَعُ مِن قَرنِ كَبشٍ، يُستَخدَمُ لِحِفظِ الزَّيتِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Smol botel oel blong makemaot man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol botel, we plante taem oli wokem long kom blong sipsip, we oli yusum blong putum oel long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "fiole à onction",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit récipient, souvent fabriqué à partir d'une corne de bélier, utilisé pour conserver l'huile."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwalabar man shafawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani ƙaramin mazubi, wanda galibi ake yinsa da ƙahon rago, ana amfani da shi wajen ajiye mai."
        }
      ]
    },
    "hin": {
      "preferred_label": "अभिषेक की कुप्पी",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक छोटा पात्र, जो प्रायः मेढ़े के सींग से बनाया जाता था, जिसका उपयोग तेल रखने के लिए किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Karama mmanụ otite",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere arịa, nke a na-ejikarị mpi ebule mee, nke a na-eji echekwa mmanụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "Buli-buli minyak urapan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wadah kecil, sering kali dibuat dari tanduk domba jantan, yang digunakan untuk menyimpan minyak."
        }
      ]
    },
    "nep": {
      "preferred_label": "अभिषेकको ढुङ्ग्रो",
      "descriptions": [
        {
          "source": "acai",
          "description": "तेल राख्‍न प्रयोग गरिने सानो भाँडो, जुन प्रायः भेडाको सिङबाट बनाइन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "vaso de azeite",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um pequeno recipiente, muitas vezes feito de chifre de carneiro, usado para guardar óleo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сосуд с елеем",
      "descriptions": [
        {
          "source": "acai",
          "description": "Небольшой сосуд, часто изготавливаемый из бараньего рога, использовавшийся для хранения елея."
        }
      ]
    },
    "spa": {
      "preferred_label": "frasco de unción",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recipiente pequeño, a menudo hecho de un cuerno de carnero, utilizado para guardar aceite."
        }
      ]
    },
    "swh": {
      "preferred_label": "Chupa ya mafuta ya upako",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chombo kidogo, mara nyingi kilichotengenezwa kwa pembe ya kondoo dume, kilichotumiwa kuhifadhia mafuta."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Liklik jak wel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik botol o jak, ol i save wokim planti taim long kom bilong sipsip man, bilong putim wel."
        }
      ]
    },
    "vie": {
      "preferred_label": "lọ đựng dầu xức",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một bình nhỏ, thường làm bằng sừng cừu đực, dùng để đựng dầu."
        }
      ]
    },
    "zhs": {
      "preferred_label": "膏油瓶",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种通常由公羊角制成的小容器，用于盛放膏油。"
        }
      ]
    },
    "zht": {
      "preferred_label": "膏油瓶",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種常用公羊角製成、用來盛裝油的小容器。"
        }
      ]
    }
