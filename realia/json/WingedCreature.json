  "localizations": {
    "eng": {
      "preferred_label": "Winged Creature",
      "alternate_labels": [
        "Cherub",
        "Cherubim",
        "Cherub",
        "Winged Creature"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Winged Creature",
          "article": "realia:WingedCreature",
          "description": "A heavenly being with wings, often associated with carrying God’s throne and symbolizing His majesty and presence."
        }
      ]
    },
    "apd": {
      "preferred_label": "كائن مجنح",
      "descriptions": [
        {
          "source": "acai",
          "description": "كائن سماوي عندو أجنحة، وغالباً برتبط بحمل عرش الله وبيرمز لهيبتو وحضورو."
        }
      ]
    },
    "arb": {
      "preferred_label": "كائِنٌ مُجَنَّح",
      "descriptions": [
        {
          "source": "acai",
          "description": "كائن سماوي ذو أجنحة، غالبًا ما يرتبط بحمل عرش الله ويرمز إلى جلاله وحضوره."
        }
      ]
    },
    "bis": {
      "preferred_label": "krijer we i gat wing",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we i gat laef blong heven we i gat wing, we plante taem i joen wetem fasin blong karem jea blong king blong God mo i soemaot hae posisen mo paoa blong Hem wetem presens blong Hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "créature ailée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Être céleste ailé, souvent associé au transport du trône de Dieu et symbolisant sa majesté et sa présence."
        }
      ]
    },
    "hau": {
      "preferred_label": "halitta mai fiffike",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata halitta ta samaniya mai fikafikai, sau da yawa tana da alaƙa da ɗaukar kursiyin Allah da kuma nuna girma da kuma kasancewarsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "करूब",
      "descriptions": [
        {
          "source": "acai",
          "description": "पंखों वाला एक स्वर्गीय प्राणी, जो प्रायः परमेश्वर के सिंहासन को ले जाने से जुड़ा है और उनके प्रताप व उपस्थिति का प्रतीक है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe e kere eke nwere nku",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe e kere eke nke eluigwe nke nwere nku, nke na-ejikarị ebu ocheeze Chineke ma na-egosipụtakwa ebube na ọnụnọ Ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "makhluk bersayap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Makhluk surgawi bersayap, sering dikaitkan dengan penopang takhta Allah dan melambangkan keagungan serta hadirat-Nya."
        }
      ]
    },
    "nep": {
      "preferred_label": "पखेटा भएको प्राणी",
      "descriptions": [
        {
          "source": "acai",
          "description": "पखेटा भएको एक स्वर्गीय प्राणी, जो प्रायः परमेश्‍वरको सिंहासन बोक्ने कार्यसँग जोडिएको हुन्छ र उहाँको महिमा तथा उपस्थितिको प्रतीक हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "criatura alada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um ser celestial com asas, frequentemente associado a sustentar o trono de Deus e a simbolizar Sua majestade e presença."
        }
      ]
    },
    "rus": {
      "preferred_label": "Крылатое существо",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крылатое небесное существо, часто ассоциирующееся с несением Божьего престола и символизирующее Его величие и присутствие."
        }
      ]
    },
    "spa": {
      "preferred_label": "criatura alada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ser celestial con alas, frecuentemente asociado con portar el trono de Dios y que simboliza su majestad y presencia."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kiumbe mwenye mabawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kiumbe wa mbinguni mwenye mabawa, mara nyingi akihusishwa na kubeba kiti cha enzi cha Mungu na kuashiria utukufu na uwepo Wake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ensel i gat wing",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting bilong heven i gat wing, em i save karim sia king bilong God na makim biknem na prezens bilong Em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sinh vật có cánh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một hữu thể trên trời có cánh, thường gắn liền với việc nâng đỡ ngai Đức Chúa Trời và tượng trưng cho sự uy nghiêm cùng sự hiện diện của Ngài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "有翼活物",
      "descriptions": [
        {
          "source": "acai",
          "description": "有翅膀的天界活物，常与托举上帝的宝座相关，象征着祂的威严与同在。"
        }
      ]
    },
    "zht": {
      "preferred_label": "有翅膀的活物",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種有翅膀的天使或屬天活物，常與托住或承載上帝的寶座相關，象徵祂的威嚴與臨在。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
