  "localizations": {
    "eng": {
      "preferred_label": "Earring",
      "alternate_labels": [
        "Nose Ring",
        "Ring",
        "Pendant",
        "Earrings"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Earring",
          "article": "realia:Earring",
          "description": "A ring often made of silver or gold, worn in the ear or nose for decoration."
        }
      ]
    },
    "apd": {
      "preferred_label": "حلق",
      "descriptions": [
        {
          "source": "acai",
          "description": "حلقة غالباً مصنوعة من الفضة أو الذهب، بتتلبس في الأضان أو المناخير للزينة."
        }
      ]
    },
    "arb": {
      "preferred_label": "قرط",
      "descriptions": [
        {
          "source": "acai",
          "description": "حلقة تُصنع غالباً من الفضة أو الذهب، تُلبس في الأذن أو الأنف للزينة."
        }
      ]
    },
    "bis": {
      "preferred_label": "iaring",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ring we plante taem oli wokem long silva no gol, we man i stap werem long sora no long nus blong flas."
        }
      ]
    },
    "fra": {
      "preferred_label": "boucle d’oreille",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anneau souvent fait d’argent ou d’or, porté à l’oreille ou au nez en guise de parure."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ɗan kunne",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zobe da aka saba yi da azurfa ko zinariya, da ake sawa a kunne ko hanci a matsayin ado."
        }
      ]
    },
    "hin": {
      "preferred_label": "बाली",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः सोने या चाँदी से बनी एक बाली या छल्ला, जिसे सुंदरता के लिए कान या नाक में पहना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọlantị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mgbaaka a na-ejikarị ọlaọcha ma ọ bụ ọlaedo eme, nke a na-eyi na ntị ma ọ bụ nʼimi maka ịchọ mma."
        }
      ]
    },
    "ind": {
      "preferred_label": "anting-anting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cincin perhiasan yang sering kali terbuat dari perak atau emas, yang dikenakan pada telinga atau hidung untuk hiasan."
        }
      ]
    },
    "nep": {
      "preferred_label": "कुण्डल",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः सुन वा चाँदीबाट बनेको कुण्डल, जुन गहनाको रूपमा कान वा नाकमा लगाइन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "brinco",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma argola frequentemente feita de prata ou ouro, usada na orelha ou no nariz como adorno."
        }
      ]
    },
    "rus": {
      "preferred_label": "Серьга",
      "descriptions": [
        {
          "source": "acai",
          "description": "Кольцо, часто из серебра или золота, носимое в ухе или в носу в качестве украшения."
        }
      ]
    },
    "spa": {
      "preferred_label": "arete",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aro, a menudo de oro o plata, que se lleva en la oreja o en la nariz como adorno."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kipuli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pete mara nyingi iliyotengenezwa kwa fedha au dhahabu, inayovaliwa sikioni au puani kwa ajili ya mapambo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bilas bilong yau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ring ol i save wokim planti taim long silva o gol, na ol i save hangamapim long yau o long nus bilong bilas."
        }
      ]
    },
    "vie": {
      "preferred_label": "Khuyên tai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chiếc khoen thường làm bằng bạc hoặc vàng, được đeo ở tai hoặc mũi để làm đồ trang sức."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耳环",
      "descriptions": [
        {
          "source": "acai",
          "description": "常由金或银制成的环状饰物，戴在耳朵或鼻子上作为装饰。"
        }
      ]
    },
    "zht": {
      "preferred_label": "耳環",
      "descriptions": [
        {
          "source": "acai",
          "description": "通常由金或銀製成，戴在耳朵或鼻子上的環狀飾物。"
        }
      ]
    }
  },
