      "descriptions": [
        {
          "source": "acai",
          "gloss": "Skin-Bottle",
          "article": "realia:Skin-bottle",
          "description": "A container made of goatskin used for storing liquids like water, wine, or milk."
        }
      ]
    },
    "apd": {
      "preferred_label": "قربة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وعاء مصنوع من جلد الماعز بيستعمل لحفظ السوائل زي الموية، الخمرة، أو اللبن."
        }
      ]
    },
    "arb": {
      "preferred_label": "قربة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وعاء مصنوع من جلد الماعز يُستخدم لحفظ السوائل كالماء أو الخمر أو اللبن."
        }
      ]
    },
    "bis": {
      "preferred_label": "botel we oli wokem long skin blong nani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan botel we oli wokem long skin blong nani blong putum ol likwid olsem wota, waen, o melek long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "outre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Récipient fait de peau de chèvre, utilisé pour conserver des liquides comme l'eau, le vin ou le lait."
        }
      ]
    },
    "hau": {
      "preferred_label": "Salka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abin ajiye abu da aka yi da fatar akuya da ake amfani da shi wajen zuba abubuwa masu ruwa-ruwa kamar ruwa, ruwan inabi, ko madara."
        }
      ]
    },
    "hin": {
      "preferred_label": "कुप्पा",
      "descriptions": [
        {
          "source": "acai",
          "description": "बकरी की खाल से बना एक पात्र जो पानी, दाखमधु या दूध जैसे तरल पदार्थों को रखने के काम आता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "karama akpụkpọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe e ji akpụkpọ ewu mee e ji adọba mmiri, mmanya, maọbụ mmiri ara ehi."
        }
      ]
    },
    "ind": {
      "preferred_label": "kirbat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wadah yang terbuat dari kulit kambing yang digunakan untuk menyimpan cairan seperti air, anggur, atau susu."
        }
      ]
    },
    "nep": {
      "preferred_label": "मशक",
      "descriptions": [
        {
          "source": "acai",
          "description": "पानी, दाखमद्य वा दूधजस्ता तरल पदार्थहरू भण्डार गर्नका लागि बाख्राको छालाबाट बनाइएको भाँडो।"
        }
      ]
    },
    "por": {
      "preferred_label": "odre",
