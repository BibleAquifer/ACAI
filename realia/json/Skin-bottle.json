      ]
    },
    "rus": {
      "preferred_label": "мех",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сосуд из козьей шкуры, используемый для хранения жидкостей, таких как вода, вино или молоко."
        }
      ]
    },
    "spa": {
      "preferred_label": "odre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recipiente hecho de piel de cabra utilizado para almacenar líquidos como agua, vino o leche."
        }
      ]
    },
    "swh": {
      "preferred_label": "kiriba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chombo kilichotengenezwa kwa ngozi ya mbuzi kilichotumiwa kuhifadhia majimaji kama vile maji, divai, au maziwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "skin meme",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting ol i wokim long skin meme bilong putim ol liklik samting olsem wara, wain, o supsup bilong susu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bầu da",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bình đựng bằng da dê dùng để chứa chất lỏng như nước, rượu hoặc sữa."
        }
      ]
    },
    "zhs": {
      "preferred_label": "皮袋",
