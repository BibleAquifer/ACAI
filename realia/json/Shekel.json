  "localizations": {
    "eng": {
      "preferred_label": "Shekel",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shekel",
          "article": "realia:Shekel",
          "description": "An ancient weight unit, about 11.5 grams, used for payment."
        }
      ]
    },
    "apd": {
      "preferred_label": "شاقل",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة وزن قديمة، وزنه حوالي 11.5 جرام، وكانوا بيستعملوه في الدفع."
        }
      ]
    },
    "arb": {
      "preferred_label": "شاقِل",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة وزن قديمة تبلغ نحو 11.5 غراماً، كانت تُستخدم في الدفع."
        }
      ]
    },
    "bis": {
      "preferred_label": "sekel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan olfala skel blong weitim samting, klosap 11.5 gram, we oli stap yusum tu blong pem samting."
        }
      ]
    },
    "fra": {
      "preferred_label": "sicle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ancienne unité de poids, d'environ 11,5 grammes, utilisée pour le paiement."
        }
      ]
    },
    "hau": {
      "preferred_label": "shekel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tsohon ma’aunin nauyi, kimanin gram 11.5, da ake amfani da shi wajen biyan kuɗi."
        }
      ]
    },
    "hin": {
      "preferred_label": "शेकेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्राचीन काल की तौल की एक इकाई, लगभग 11.5 ग्राम, जिसका उपयोग भुगतान के लिए किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shekel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu ihe e ji atụ ihe nʼoge ochie, nke dị ihe dị ka gram 11.5, nke a na-eji akwụ ụgwọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "syikal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Satuan berat kuno, sekitar 11,5 gram, yang digunakan untuk pembayaran."
        }
      ]
    },
    "nep": {
      "preferred_label": "शेकेल",
      "descriptions": [
        {
