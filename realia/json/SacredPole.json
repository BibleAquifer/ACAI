  "localizations": {
    "eng": {
      "preferred_label": "Sacred Pole",
      "alternate_labels": [
        "Asherah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Sacred Pole",
          "article": "realia:SacredPole",
          "description": "A wooden pole representing the goddess Asherah, set up near altars in places of sacrifice."
        }
      ]
    },
    "apd": {
      "preferred_label": "سارية مقدسة",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمود خشب بيمثل الإلهة عشيرة، كان بيتختى جنب المذابح في أماكن تقديم الذبائح."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَارِيَة مُقَدَّسَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "سارية خشبية ترمز إلى الإلهة عشيرة، تُقام بجانب المذابح في أماكن تقديم الذبائح."
        }
      ]
    },
    "bis": {
      "preferred_label": "pos blong Asera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pos kenu no wud we i saenem woman god ya Asera, we oli stanemap klosap long ol olta long ol ples blong sakrefaes."
        }
      ]
    },
    "fra": {
      "preferred_label": "poteau sacré",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pieu de bois représentant la déesse Ashéra, dressé près des autels dans les lieux de sacrifice."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ginshiƙin Ashera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ginshiƙin itace mai wakiltar allahiya Ashera, wanda ake kafawa kusa da bagadai a wuraren yin hadaya."
        }
      ]
    },
    "hin": {
      "preferred_label": "अशेरा का खंभा",
      "descriptions": [
        {
          "source": "acai",
          "description": "अशेरा देवी का प्रतिनिधित्व करने वाला लकड़ी का एक खंभा, जिसे बलिदान के स्थानों पर वेदियों के पास स्थापित किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "osisi Ashera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ogidi osisi na-anọchi anya chi nwanyị bụ Ashera, nke a na-eguzobe nʼakụkụ ebe ịchụ aja nʼebe dị iche iche a na-achụrụ aja."
        }
      ]
    },
    "ind": {
      "preferred_label": "tiang berhala",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tiang kayu yang melambangkan dewi Asyera, yang didirikan di dekat mezbah di tempat-tempat pengorbanan."
        }
      ]
    },
    "nep": {
      "preferred_label": "अशेराको खम्बा",
      "descriptions": [
        {
          "source": "acai",
          "description": "अशेरा देवीको प्रतिनिधित्व गर्ने काठको खम्बा, जुन बलि चढाइने ठाउँहरूमा वेदीहरूको नजिक खडा गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "poste sagrado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um poste de madeira que representava a deusa Aserá, erguido perto de altares em locais de sacrifício."
        }
      ]
    },
    "rus": {
      "preferred_label": "Священный столб Ашеры",
      "descriptions": [
        {
          "source": "acai",
          "description": "Деревянный столб, символизирующий богиню Ашеру (Астарту), который устанавливался возле жертвенников в местах жертвоприношений."
        }
      ]
    },
    "spa": {
      "preferred_label": "poste sagrado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Poste de madera que representaba a la diosa Asera, erigido cerca de los altares en los lugares de sacrificio."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nguzo ya Ashera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nguzo ya mti inayomwakilisha mungu mke Ashera, iliyosimamishwa karibu na madhabahu mahali pa kutolea dhabihu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pos diwai bilong Asera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pos diwai i makim god meri Asera, ol i save sanapim klostu long ol alta long ol ples bilong ofa."
        }
      ]
    },
    "vie": {
      "preferred_label": "Trụ thờ A-sê-ra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cây cột gỗ tượng trưng cho nữ thần A-sê-ra, được dựng lên gần bàn thờ tại các nơi dâng tế lễ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚舍拉木偶",
      "descriptions": [
        {
          "source": "acai",
          "description": "代表女神亚舍拉的木柱，竖立在献祭之地的祭坛旁。"
        }
      ]
    },
    "zht": {
      "preferred_label": "木偶",
      "descriptions": [
        {
          "source": "acai",
          "description": "代表亞舍拉女神的木柱，豎立在祭壇附近的獻祭之處。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
