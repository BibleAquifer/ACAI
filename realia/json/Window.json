  "localizations": {
    "eng": {
      "preferred_label": "Window",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Window",
          "article": "realia:Window",
          "description": "An opening in a wall that lets light and air into a room and allows people to see in or out."
        }
      ]
    },
    "apd": {
      "preferred_label": "شباك",
      "descriptions": [
        {
          "source": "acai",
          "description": "فتحة في الحيطة بتدخل النور والهوا للأوضة وبتخلي الناس يشوفوا لبرة أو لجوة."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَافِذَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "فَتْحَةٌ فِي ٱلْجِدَارِ تَسْمَحُ بِدُخُولِ ٱلنُّورِ وَٱلْهَوَاءِ إِلَى ٱلْغُرْفَةِ، وَتُمَكِّنُ ٱلنَّاسَ مِنَ ٱلنَّظَرِ إِلَى ٱلدَّاخِلِ أَوِ ٱلْخَارِجِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "windo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan open ples long wol we i letem laet mo win i kam insaed long wan rum, mo i mekem we man i save lukluk i go insaed o aotsaed."
        }
      ]
    },
    "fra": {
      "preferred_label": "fenêtre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ouverture dans un mur laissant entrer la lumière et l'air dans une pièce et permettant de voir à l'intérieur ou vers l'extérieur."
        }
      ]
    },
    "hau": {
      "preferred_label": "Taga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙafa ko kafa a jikin bango da ke barin haske da iska su shiga ɗaki, tana kuma ba mutane damar leƙawa ko gani."
        }
      ]
    },
    "hin": {
      "preferred_label": "खिड़की",
      "descriptions": [
        {
          "source": "acai",
          "description": "दीवार में एक झरोखा जिससे कमरे में प्रकाश और हवा आती है तथा लोग भीतर या बाहर देख सकते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Windo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oghere dị na mgbidi nke na-ekwe ka ìhè na ikuku banye nʼọnụ ụlọ ma na-enye ohere ka ndị mmadụ hụ ihe dị nʼime ma ọ bụ nʼèzí."
        }
      ]
    },
    "ind": {
      "preferred_label": "jendela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bukaan pada dinding yang memungkinkan cahaya dan udara masuk ke dalam ruangan serta memungkinkan orang melihat ke dalam atau ke luar."
        }
      ]
    },
    "nep": {
      "preferred_label": "झ्याल",
      "descriptions": [
        {
          "source": "acai",
          "description": "कोठाभित्र उज्यालो र हावा छिर्न दिने तथा मानिसहरूलाई भित्र वा बाहिर हेर्न दिने भित्ताको खुला भाग।"
        }
      ]
    },
    "por": {
      "preferred_label": "janela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma abertura em uma parede que permite a entrada de luz e ar em um cômodo e permite que as pessoas vejam para dentro ou para fora."
        }
      ]
    },
    "rus": {
      "preferred_label": "Окно",
      "descriptions": [
        {
          "source": "acai",
          "description": "Проем в стене, пропускающий свет и воздух в помещение и позволяющий смотреть внутрь или наружу."
        }
      ]
    },
    "spa": {
      "preferred_label": "ventana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abertura en una pared que permite la entrada de luz y aire a una habitación y permite a las personas mirar hacia adentro o hacia afuera."
        }
      ]
    },
    "swh": {
      "preferred_label": "Dirisha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tundu ukutani linaloingiza mwanga na hewa ndani ya chumba na kuwawezesha watu kutazama ndani au nje."
        }
      ]
    },
    "tpi": {
      "preferred_label": "windo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela op long banis em i larim lait na win i kam insait long rum na i larim ol manmeri i ken lukluk i go ausait o i kam insait."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cửa sổ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một khoảng trống trên tường cho phép ánh sáng và không khí lọt vào phòng, đồng thời giúp người ta có thể nhìn vào trong hoặc nhìn ra ngoài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "窗户",
      "descriptions": [
        {
          "source": "acai",
          "description": "墙上的开孔，用于让光线和空气进入房间，并方便人向内或向外看。"
        }
      ]
    },
    "zht": {
      "preferred_label": "窗戶",
      "descriptions": [
        {
          "source": "acai",
          "description": "牆壁上的開口，使光線和空氣進入室內，並讓人可以看進去或向外看。"
        }
      ]
    }
  },
