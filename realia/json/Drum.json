  "localizations": {
    "eng": {
      "preferred_label": "Drum",
      "alternate_labels": [
        "Hand Drum"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Drum",
          "article": "realia:Drum",
          "description": "A musical instrument with a skin stretched over a frame, which is hit with hands or a mallet to make sound."
        }
      ]
    },
    "apd": {
      "preferred_label": "دف",
      "descriptions": [
        {
          "source": "acai",
          "description": "آلة موسيقية مشدود عليها جلد على إطار، بتتدق بالإيدين أو بعصاية عشان تطلع صوت (طبلة أو دف)."
        }
      ]
    },
    "arb": {
      "preferred_label": "دف",
      "descriptions": [
        {
          "source": "acai",
          "description": "آلة موسيقية تتكون من جلد مشدود على إطار، يُقرع باليدين أو بمضرب لإصدار الصوت."
        }
      ]
    },
    "bis": {
      "preferred_label": "dram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan instramen blong miusik we i gat skin blong anamol we oli taetem antap long wan frem, we man i save kilim long han no long stik blong mekem saon."
        }
      ]
    },
    "fra": {
      "preferred_label": "tambourin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Instrument de musique formé d’une peau tendue sur un cadre, que l’on frappe avec les mains ou une mailloche pour produire un son."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ganga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kayan kiɗi mai fata shimfiɗe a jikin ƙira, wanda ake bugawa da hannu ko da maƙera don fitar da sauti."
        }
      ]
    },
    "hin": {
      "preferred_label": "डफ",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक वाद्य यंत्र जिसमें किसी ढाँचे पर चमड़ा मढ़ा होता है, जिसे ध्वनि उत्पन्न करने के लिए हाथों या किसी डंडे से बजाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịgba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ngwá egwu nwere akpụkpọ anụ a gbatịrị nʼelu ihe a rụrụ arụ, nke a na-eji aka ma ọ bụ osisi etu aka na-eti ka o mee ụda."
        }
      ]
    },
    "ind": {
      "preferred_label": "rebana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alat musik dengan membran kulit yang direntangkan pada sebuah bingkai, yang dipukul dengan tangan atau pemukul untuk menghasilkan suara."
        }
      ]
    },
    "nep": {
      "preferred_label": "खैँजडी",
      "descriptions": [
        {
          "source": "acai",
          "description": "काठ वा धातुको घेरामा छाला कसेर बनाइएको बाजा, जसलाई हातले वा गजोले हानेर बजाइन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "tamborim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um instrumento musical com uma pele esticada sobre uma armação, que é tocado com as mãos ou com uma baqueta para produzir som."
        }
      ]
    },
    "rus": {
      "preferred_label": "Тимпан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Музыкальный инструмент с натянутой на каркас кожей, по которой ударяют руками или колотушкой для извлечения звука."
        }
      ]
    },
    "spa": {
      "preferred_label": "tambor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Instrumento musical con una piel tensada sobre un marco, que se golpea con las manos o con un mazo para producir sonido."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ala ya muziki yenye ngozi iliyotandazwa juu ya fremu, ambayo hupigwa kwa mikono au kijiti ili kutoa sauti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kundu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain instramen bilong musik we skin bilong abus i pas tait long banis bilong en, na ol i save paitim long han o long stik bilong mekim krai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Trống",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nhạc cụ có màng da căng trên khung, được gõ bằng tay hoặc dùi để tạo ra âm thanh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "鼓",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种框架上绷有皮膜的乐器，用手或槌敲击发声。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鼓",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種將皮蒙在框架上製成的樂器，用手或槌敲擊發聲。"
        }
      ]
    }
  },
