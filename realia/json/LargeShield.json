  "localizations": {
    "eng": {
      "preferred_label": "Large Shield",
      "alternate_labels": [
        "Shield",
        "Shield Large"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Large Shield",
          "article": "realia:LargeShield",
          "description": "A tall, oblong shield used to protect the entire body in battle; made from wood, metal, leather, or reeds."
        }
      ]
    },
    "apd": {
      "preferred_label": "ترس كبير",
      "descriptions": [
        {
          "source": "acai",
          "description": "ترس طويل ومستطيل بيستعمل لحماية الجسم كلو في الحرب، مصنوع من خشب أو معدن أو جلد أو قصب."
        }
      ]
    },
    "arb": {
      "preferred_label": "تُرْس كَبِير",
      "descriptions": [
        {
          "source": "acai",
          "description": "تُرس طويل مستطيل الشكل يُستخدم لحماية الجسم بأكمله في المعركة، ويُصنع من الخشب أو المعدن أو الجلد أو القصب."
        }
      ]
    },
    "bis": {
      "preferred_label": "bigfala sil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan longfala sil we oli wokem long wud, aean, leta, no nalenal blong kavremap ful bodi long taem blong faet."
        }
      ]
    },
    "fra": {
      "preferred_label": "grand bouclier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un grand bouclier oblong utilisé pour protéger tout le corps au combat ; fait de bois, de métal, de cuir ou de roseaux."
        }
      ]
    },
    "hau": {
      "preferred_label": "Babban garkuwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Doguwar garkuwa mai siffar kwana huɗu wadda ake amfani da ita don kāre dukan jiki a wurin yaƙi; an yi ta da itace, ƙarfe, fata, ko ciyawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "बड़ी ढाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "युद्ध में पूरे शरीर की रक्षा के लिए उपयोग की जाने वाली एक लंबी, आयताकार ढाल; जो लकड़ी, धातु, चमड़े या नरकट से बनाई जाती थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọta ukwu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọta toro ogologo ma dịkwa gburugburu e ji echebe ahụ dum nʼagha; nke e ji osisi, ọla, akpụkpọ anụ, ma ọ bụ amị mee."
        }
      ]
    },
    "ind": {
      "preferred_label": "perisai besar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Perisai tinggi berbentuk lonjong yang digunakan untuk melindungi seluruh tubuh dalam pertempuran; terbuat dari kayu, logam, kulit, atau alang-alang."
        }
      ]
    },
    "nep": {
      "preferred_label": "ठुलो ढाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "लडाइँमा पूरै शरीरलाई जोगाउन प्रयोग गरिने काठ, धातु, छाला वा निगालोबाट बनाइएको लाम्चो ठुलो ढाल।"
        }
      ]
    },
    "por": {
      "preferred_label": "escudo grande",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um escudo alto e oblongo usado para proteger o corpo inteiro em batalha; feito de madeira, metal, couro ou juncos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Большой щит",
      "descriptions": [
        {
          "source": "acai",
          "description": "Большой продолговатый щит, используемый в бою для защиты всего тела; изготавливался из дерева, металла, кожи или тростника."
        }
      ]
    },
    "spa": {
      "preferred_label": "escudo grande",
      "descriptions": [
        {
          "source": "acai",
          "description": "Escudo alto y alargado utilizado para proteger todo el cuerpo en la batalla; hecho de madera, metal, cuero o juncos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ngao kubwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ngao ndefu ya umbo la duaradufu au mstatili iliyotumiwa kulinda mwili mzima vitani; iliyotengenezwa kwa mbao, chuma, ngozi, au matete."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bikpela hap plang bilong pait",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela longpela hap plang bilong pait ol i yusim bilong karamapim olgeta bodi long pait; ol i wokim long diwai, ain o bras, skin bilong animal, o pitpit."
        }
      ]
    },
    "vie": {
      "preferred_label": "khiên lớn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một tấm khiên cao, hình chữ nhật dùng để bảo vệ toàn bộ cơ thể trong trận chiến; làm bằng gỗ, kim loại, da, hoặc sậy."
        }
      ]
    },
    "zhs": {
      "preferred_label": "大盾牌",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种在战斗中用来保护全身的长方形高盾牌；由木头、金属、皮革或芦苇制成。"
        }
      ]
    },
    "zht": {
      "preferred_label": "擋牌",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種高且呈長方形的盾牌，用於作戰時保護全身；由木頭、金屬、皮革或蘆葦製成。"
        }
      ]
    }
  },
