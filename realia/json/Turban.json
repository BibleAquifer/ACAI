  "localizations": {
    "eng": {
      "preferred_label": "Turban",
      "alternate_labels": [
        "Headdress"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Turban",
          "article": "realia:Turban",
          "description": "A headpiece made by winding a long piece of cloth many times around the head, worn by priests and kings."
        }
      ]
    },
    "apd": {
      "preferred_label": "عمامة",
      "descriptions": [
        {
          "source": "acai",
          "description": "غطاء للرأس معمول من قطعة قماش طويلة ملفوفة كذا مرة حولين الرأس، بيلبسوه الكهنة والملوك."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِمَامَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "غِطَاءٌ لِلرَّأْسِ يُصْنَعُ بِلَفِّ قِطْعَةِ قُمَاشٍ طَوِيلَةٍ عِدَّةَ مَرَّاتٍ حَوْلَ الرَّأْسِ، يَرْتَدِيهِ الكَهَنَةُ وَالمُلُوكُ."
        }
      ]
    },
    "bis": {
      "preferred_label": "spesel hat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kaliko we man i fasem i goraon plante taem long hed blong hem olsem wan hat, we ol pris mo ol king oli stap werem."
        }
      ]
    },
    "fra": {
      "preferred_label": "tiare",
      "descriptions": [
        {
          "source": "acai",
          "description": "Coiffure confectionnée en enroulant une longue bande d'étoffe plusieurs fois autour de la tête, portée par les prêtres et les rois."
        }
      ]
    },
    "hau": {
      "preferred_label": "rawani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abin rufe kai da aka yi ta hanyar naɗa dogon ƙyalle sau da yawa a kai, wanda firistoci da sarakuna ke sawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "पगड़ी",
      "descriptions": [
        {
          "source": "acai",
          "description": "कपड़े के एक लंबे टुकड़े को सिर के चारों ओर कई बार लपेटकर बनाई जाने वाली पगड़ी, जिसे याजक और राजा पहनते थे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Akwa a na-atụhị nʼisi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe mkpuchi isi e ji akwa ogologo a tụhịrị ọtụtụ ugboro nʼisi mee, nke ndị nchụaja na ndị eze na-eyi."
        }
      ]
    },
    "ind": {
      "preferred_label": "serban",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tutup kepala yang dibuat dengan melilitkan sehelai kain panjang berkali-kali di sekeliling kepala, dikenakan oleh para imam dan raja-raja."
        }
      ]
    },
    "nep": {
      "preferred_label": "फेटा",
      "descriptions": [
        {
          "source": "acai",
          "description": "टाउको वरिपरि लामो कपडा धेरै पटक बेरेर बनाइने शिरपोश, जुन पुजारीहरू र राजाहरूले लगाउँथे।"
        }
      ]
    },
    "por": {
      "preferred_label": "turbante",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cobertura para a cabeça feita enrolando-se muitas vezes um longo pedaço de tecido ao redor da cabeça, usada por sacerdotes e reis."
        }
      ]
    },
    "rus": {
      "preferred_label": "Кидар",
      "descriptions": [
        {
          "source": "acai",
          "description": "Головной убор, изготовленный путем многократного оборачивания длинного полотна ткани вокруг головы, который носили священники и цари."
        }
      ]
    },
    "spa": {
      "preferred_label": "turbante",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tocado hecho enrollando una pieza larga de tela muchas veces alrededor de la cabeza, usado por sacerdotes y reyes."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kilemba",
      "descriptions": [
        {
          "source": "acai",
          "description": "vazi la kichwani linalotengenezwa kwa kuzungusha kitambaa kirefu mara nyingi kichwani, lililovaliwa na makuhani na wafalme."
        }
      ]
    },
    "tpi": {
      "preferred_label": "laplap bilong het",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bilas bilong het ol i wokim long rot bilong raunim longpela hap laplap planti taim long het, na ol pris na ol king i save putim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Khăn đội đầu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một đồ đội đầu làm bằng cách quấn một dải vải dài nhiều vòng quanh đầu, được các thầy tế lễ và vua chúa đội."
        }
      ]
    },
    "zhs": {
      "preferred_label": "礼冠",
      "descriptions": [
        {
          "source": "acai",
          "description": "用长条布匹在头上缠绕数圈制成的头饰，由祭司和君王佩戴。"
        }
      ]
    },
    "zht": {
      "preferred_label": "冠冕",
      "descriptions": [
        {
          "source": "acai",
          "description": "將長條布料在頭上纏繞多次而成的頭飾，由祭司和君王佩戴。"
        }
      ]
    }
  },
