  "localizations": {
    "eng": {
      "preferred_label": "Arrow",
      "alternate_labels": [
        "Sons of the Quiver > Arrows",
        "Flashing Arrows",
        "Dart"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Arrow",
          "article": "realia:Arrow",
          "description": "A slender, pointed weapon made of wood or iron, shot from a bow for hunting or warfare."
        }
      ]
    },
    "apd": {
      "preferred_label": "سهم",
      "descriptions": [
        {
          "source": "acai",
          "description": "سلاح نحيف ومسنن مصنوع من خشب أو حديد، بيضربوه بالقوس للصيد أو الحرب."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَهْم",
      "descriptions": [
        {
          "source": "acai",
          "description": "سِلَاحٌ رَفِيعٌ وَمُدَبَّبٌ مَصْنُوعٌ مِنَ ٱلْخَشَبِ أَوِ ٱلْحَدِيدِ، يُرْمَى بِٱلْقَوْسِ لِلصَّيْدِ أَوِ ٱلْحَرْبِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "ara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tret, sap tul we oli wokem long wud o aean, we oli stap sutum long wan bonara blong hanting o faet."
        }
      ]
    },
    "fra": {
      "preferred_label": "flèche",
      "descriptions": [
        {
          "source": "acai",
          "description": "Arme effilée et pointue en bois ou en fer, lancée avec un arc pour la chasse ou la guerre."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kibiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Siririn makami mai tsini da aka yi da itace ko ƙarfe, wanda ake harbawa da baka don farauta ko yaƙi."
        }
      ]
    },
    "hin": {
      "preferred_label": "तीर",
      "descriptions": [
        {
          "source": "acai",
          "description": "लकड़ी या लोहे से बना एक पतला, नुकीला अस्त्र, जिसे शिकार या युद्ध के लिए धनुष से चलाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Àkụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ngwá agha dị gịrịgịrị nke nwere ọnụ dị nkọ e ji osisi ma ọ bụ ígwè mee, nke a na-agbapụ nʼụta maka ịchụ nta ma ọ bụ maka agha."
        }
      ]
    },
    "ind": {
      "preferred_label": "anak panah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Senjata runcing dan ramping yang terbuat dari kayu atau besi, dilepaskan dari busur untuk berburu atau berperang."
        }
      ]
    },
    "nep": {
      "preferred_label": "काँड",
      "descriptions": [
        {
          "source": "acai",
          "description": "काठ वा फलामबाट बनेको मसिनो, तीखो हतियार, जुन शिकार वा युद्धको लागि धनुषबाट प्रहार गरिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "flecha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma arma fina e pontiaguda feita de madeira ou ferro, disparada com um arco para caça ou guerra."
        }
      ]
    },
    "rus": {
      "preferred_label": "стрела",
      "descriptions": [
        {
          "source": "acai",
          "description": "Тонкое заострённое метательное оружие из дерева или железа, выпускаемое из лука для охоты или войны."
        }
      ]
    },
    "spa": {
      "preferred_label": "flecha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Arma delgada y puntiaguda hecha de madera o hierro, que se dispara con un arco para la caza o la guerra."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mshale",
      "descriptions": [
        {
          "source": "acai",
          "description": "Silaha ndefu na yenye ncha kali iliyotengenezwa kwa mbao au chuma, inayorushwa kwa upinde kwa ajili ya kuwinda au vita."
        }
      ]
    },
    "tpi": {
      "preferred_label": "supsup bilong banara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela sap samting ol i save wokim long diwai o ain, em ol i save sutim long banara bilong painim abus o pait."
        }
      ]
    },
    "vie": {
      "preferred_label": "Mũi tên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vũ khí thon dài, có đầu nhọn làm bằng gỗ hoặc sắt, được bắn ra từ cung để săn bắn hoặc chiến đấu."
        }
      ]
    },
    "zhs": {
      "preferred_label": "箭",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种细长尖锐的武器，由木头或铁制成，用弓发射以用于打猎或作战。"
        }
      ]
    },
    "zht": {
      "preferred_label": "箭",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種用木頭或鐵製成的細長尖銳武器，用弓發射，用於打獵或作戰。"
        }
      ]
    }
  },
