      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Whip",
          "article": "realia:Whip",
          "description": "A tool made of leather strips attached to a handle, used for hitting people or animals."
        }
      ]
    },
    "apd": {
      "preferred_label": "سوط",
      "descriptions": [
        {
          "source": "acai",
          "description": "أداة معمولة من سيور جلد مربوطة في يدة، بتُستعمل لضرب الناس أو الحيوانات."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَوْط",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَدَاةٌ مَصْنُوعَةٌ مِنْ سُيُورٍ جِلْدِيَّةٍ مَرْبُوطَةٍ بِمِقْبَضٍ، تُسْتَخْدَمُ لِضَرْبِ ٱلنَّاسِ أَوِ ٱلْحَيَوَانَاتِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "wip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tul we oli wokem long sam rop letan we i fas long wan handel, we oli yusum blong wipim ol man o anamol."
        }
      ]
    },
    "fra": {
      "preferred_label": "fouet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Instrument constitué de lanières de cuir attachées à un manche, utilisé pour frapper des personnes ou des animaux."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bulala",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kayan aikin da aka yi da igiyoyin fata a jikin ƙota, wanda ake amfani da shi wajen dukan mutane ko dabbobi."
        }
      ]
    },
    "hin": {
      "preferred_label": "कोड़ा",
      "descriptions": [
        {
          "source": "acai",
          "description": "चमड़े की पट्टियों से बना एक साधन जो हत्थे से जुड़ा होता है, जिसका उपयोग लोगों या पशुओं को मारने के लिए किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụtarị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ngwa e ji eriri akpụkpọ anụ e kegidere nʼọdụ osisi mee, nke a na-eji eti mmadụ ma ọ bụ anụmanụ ihe."
        }
      ]
    },
    "ind": {
      "preferred_label": "cambuk",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alat yang terbuat dari lajur-lajur kulit yang diikatkan pada sebuah pegangan, digunakan untuk memukul orang atau binatang."
        }
      ]
    },
    "nep": {
      "preferred_label": "कोर्रा",
      "descriptions": [
        {
          "source": "acai",
          "description": "मानिस वा जनावरलाई हिर्काउन प्रयोग गरिने, बिँडमा छालाका फित्ताहरू बाँधिएको साधन।"
        }
      ]
    },
    "por": {
      "preferred_label": "chicote",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um instrumento feito de tiras de couro presas a um cabo, usado para bater em pessoas ou animais."
        }
      ]
    },
    "rus": {
      "preferred_label": "Бич",
      "descriptions": [
        {
          "source": "acai",
          "description": "Орудие из кожаных ремней или веревок, прикрепленных к рукояти, используемое для ударов по людям или животным."
        }
      ]
    },
    "spa": {
      "preferred_label": "látigo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Instrumento hecho de tiras de cuero unidas a un mango, utilizado para golpear a personas o animales."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mjeledi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kifaa kilichotengenezwa kwa mikanda ya ngozi iliyounganishwa kwenye mpini, kinachotumiwa kuwapiga watu au wanyama."
        }
      ]
    },
    "tpi": {
      "preferred_label": "wip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela tul ol i wokim long ol rop let i pas long wanpela han bilong en, em ol i yusim bilong paitim ol manmeri o ol animal."
        }
      ]
    },
    "vie": {
      "preferred_label": "Roi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một dụng cụ làm bằng các dải da gắn vào cán cầm, dùng để đánh người hoặc súc vật."
        }
      ]
    },
    "zhs": {
      "preferred_label": "鞭子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种由连接在手柄上的皮条制成的工具，用于抽打人或动物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鞭子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種由皮條連在手柄上製成的工具，用於擊打人或動物。"
        }
      ]
    }
