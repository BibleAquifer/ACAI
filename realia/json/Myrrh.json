    "hau": {
      "preferred_label": "Mur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Maci mai ƙamshi kuma mai tsada da ake amfani da shi don yin turare da mai shafawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "गन्धरस",
      "descriptions": [
        {
          "source": "acai",
          "description": "इत्र और मरहम के लिए उपयोग किया जाने वाला एक सुगन्धित और बहुमूल्य राल (गोंद)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Máá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eso osisi na-esi isi ụtọ ma dị oke ọnụ ahịa, nke a na-eji eme mmanụ na-esi isi ụtọ na mmanụ otite."
        }
      ]
    },
    "ind": {
      "preferred_label": "mur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Damar harum dan mahal harganya yang digunakan untuk minyak wangi dan salep."
        }
      ]
    },
    "nep": {
      "preferred_label": "मूर्र",
      "descriptions": [
        {
          "source": "acai",
          "description": "सुगन्धित द्रव्य र मलमको निम्ति प्रयोग गरिने सुगन्धित र महँगो खोटो।"
        }
      ]
    },
    "por": {
      "preferred_label": "Mirra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma resina aromática e de alto valor usada para perfume e unguento."
        }
      ]
    },
    "rus": {
      "preferred_label": "Смирна",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ароматная и дорогостоящая смола, использовавшаяся для благовоний и умащения."
        }
      ]
    },
    "spa": {
      "preferred_label": "mirra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Resina aromática y costosa utilizada como perfume y ungüento."
        }
      ]
    },
    "swh": {
      "preferred_label": "Manemane",
      "descriptions": [
        {
          "source": "acai",
          "description": "Utomvu wenye harufu nzuri na wa thamani kubwa uliotumiwa kwa ajili ya manukato na marhamu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mura",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela sanda o wel bilong diwai i dia tumas na i gat gutpela smel, ol i save yusim bilong wokim smelwel na marasin bilong welim skin."
        }
      ]
    },
    "vie": {
      "preferred_label": "Nhựa thơm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại nhựa thơm đắt tiền dùng làm hương liệu và thuốc xức."
