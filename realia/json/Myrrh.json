        }
      ]
    },
    "bis": {
      "preferred_label": "mir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan doti blong wud (rezin) we i gat swit smel mo praes blong hem i antap, we oli yusum olsem senta mo pomad."
        }
      ]
    },
    "fra": {
      "preferred_label": "myrrhe",
      "descriptions": [
