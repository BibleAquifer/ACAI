  "localizations": {
    "eng": {
      "preferred_label": "Ephod",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ephod",
          "article": "realia:Ephod",
          "description": "A special embroidered garment made of linen, worn by the high priest from the shoulders to the waist, holding the Urim and Thummim."
        }
      ]
    },
    "apd": {
      "preferred_label": "أفود",
      "descriptions": [
        {
          "source": "acai",
          "description": "ثوب خاص مطرّز مصنوع من الكتان، كان يرتديه رئيس الكهنة من الكتفين إلى الخصر، ويحمل الأوريم والتميم."
        }
      ]
    },
    "arb": {
      "preferred_label": "إفود",
      "descriptions": [
        {
          "source": "acai",
          "description": "رداء خاص مطرّز مصنوع من الكتان يرتديه رئيس الكهنة من الكتفين إلى الخصر، ويحمل الأوريم والتميم."
        }
      ]
    },
    "bis": {
      "preferred_label": "efod",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan spesel klos we oli somap pija long hem we oli wokem long linen, we hae pris i werem stat long solda i go daon long wes blong hem, we i holem Urim mo Tumim."
        }
      ]
    },
    "fra": {
      "preferred_label": "éphod",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vêtement particulier en lin brodé, porté par le grand prêtre des épaules jusqu’à la taille, et contenant l’urim et le thummim."
        }
      ]
    },
    "hau": {
      "preferred_label": "Efod",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tufafi na musamman da aka yi da lilin mai ado, wanda babban firist yake sawa daga kafaɗa har zuwa kugu, yana ɗauke da Urim da Tummim."
        }
      ]
    },
    "hin": {
      "preferred_label": "एपोद",
      "descriptions": [
        {
          "source": "acai",
          "description": "सन के कपड़े का बना एक विशेष कढ़ाईदार वस्त्र, जिसे महायाजक कंधों से लेकर कमर तक पहनता था, जिसमें ऊरीम और तुम्मीम रखे जाते थे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "efọọd",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uwe pụrụ iche a kpara akpa nke e ji ezi akwa linin mee, nke nnukwu onye nchụàjà na-eyi site nʼubu ruo nʼúkwù, nke na-ejide Yurim na Tumim."
        }
      ]
    },
    "ind": {
      "preferred_label": "efod",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pakaian bersulam khusus yang terbuat dari lenan, dikenakan oleh imam besar dari bahu hingga pinggang, yang memegang Urim dan Tumim."
        }
      ]
    },
    "nep": {
      "preferred_label": "एपोद",
      "descriptions": [
        {
          "source": "acai",
          "description": "सुती कपडाबाट बनाइएको एक विशेष बुट्टादार वस्त्र, जो प्रधान पूजाहारीले काँधदेखि कम्मरसम्म लगाउँथे र जसमा ऊरीम र थुम्मीम राखिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "éfode",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vestimenta especial bordada de linho, usada pelo sumo sacerdote dos ombros até a cintura, que continha o Urim e o Tumim."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ефод",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особое вышитое льняное облачение первосвященника, закрывавшее тело от плеч до пояса, на котором крепились урим и туммим."
        }
      ]
    },
    "spa": {
      "preferred_label": "efod",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vestidura especial bordada y hecha de lino, usada por el sumo sacerdote desde los hombros hasta la cintura, que sostenía el Urim y el Tumim."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kisibau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vazi maalum la kitani lililotariziwa, lililovaliwa na kuhani mkuu kuanzia mabegani hadi kiunoni, likishikilia Urimu na Thumimsi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "efod",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela spesel klos ol i bilasim na wokim long linin, hetpris i save werim stat long sol i go daun long bel, na em i save holim Urim na Tumim."
        }
      ]
    },
    "vie": {
      "preferred_label": "ê-phót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại y phục thêu đặc biệt làm bằng vải gai mịn, được thầy tế lễ thượng phẩm mặc từ vai đến thắt lưng, nơi gắn U-rim và Thu-mim."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以弗得",
      "descriptions": [
        {
          "source": "acai",
          "description": "大祭司从肩膀穿到腰部的一种特制细麻刺绣圣衣，上面装有乌陵和土明。"
        }
      ]
    },
    "zht": {
      "preferred_label": "以弗得",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種用細麻精工繡製的特別聖衣，由大祭司穿著，從肩膀垂至腰間，其上佩帶烏陵和土明。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
