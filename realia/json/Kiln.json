        }
      ]
    },
    "spa": {
      "preferred_label": "horno",
      "descriptions": [
        {
          "source": "acai",
          "description": "Estructura hecha de ladrillos o arcilla que se utiliza para cocer cerámica o fundir minerales."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tanuru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Muundo uliotengenezwa kwa matofali au udongo wa mfinyanzi unaotumika kuokea vyombo vya udongo au kuyeyushia mawe ya madini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bikpela stov bilong paia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela stov o oven ol i wokim long brik o graun malumalu bilong kukim ol plet graun o meltim ol kapa na ain."
        }
      ]
    },
    "vie": {
      "preferred_label": "lò nung",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cấu trúc làm bằng gạch hoặc đất sét dùng để nung gốm sứ hoặc nấu chảy quặng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "窑",
      "descriptions": [
        {
          "source": "acai",
