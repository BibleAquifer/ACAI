    "apd": {
      "preferred_label": "فرن",
      "descriptions": [
        {
          "source": "acai",
          "description": "بناية معمولة من طوب أو طين بتستعمل عشان حرق الفخار أو صهر المعادن."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَتُون",
      "descriptions": [
        {
          "source": "acai",
          "description": "بِنَاءٌ مَصْنُوعٌ مِنَ ٱلْآجُرِّ أَوِ ٱلطِّينِ يُسْتَخْدَمُ لِحَرْقِ ٱلْخَزَفِ أَوْ صَهْرِ ٱلْمَعَادِنِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "bigfala oven blong faea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala oven we oli wokem long brikis no klei blong bonem ol katen kenu no ol doti samting blong klei, no blong meltem ol aean mo kopa."
        }
      ]
    },
    "fra": {
      "preferred_label": "four",
      "descriptions": [
        {
          "source": "acai",
