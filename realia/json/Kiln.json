        }
      ]
    },
    "hin": {
      "preferred_label": "भट्ठी",
      "descriptions": [
        {
          "source": "acai",
          "description": "ईंटों या मिट्टी की बनी एक संरचना जिसका उपयोग मिट्टी के बर्तन पकाने या धातुओं को पिघलाने के लिए किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ite ọkụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe e ji brik ma ọ bụ ụrọ rụọ nke a na-eji akpụ ma ọ bụ agbaze ite na ígwè."
        }
      ]
    },
    "ind": {
      "preferred_label": "dapur peleburan",
      "descriptions": [
        {
          "source": "acai",
