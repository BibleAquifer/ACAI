  "localizations": {
    "eng": {
      "preferred_label": "Cloak",
      "alternate_labels": [
        "Coat",
        "Robe",
        "Mantle",
        "Long Robe",
        "A Robe Reaching to the Feet"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Cloak",
          "article": "realia:Cloak",
          "description": "A long, loose outer garment that reached to the feet and was held in place by a sash or fasteners."
        }
      ]
    },
    "apd": {
      "preferred_label": "رداء",
      "descriptions": [
        {
          "source": "acai",
          "description": "ثوب خارجي واسع وطويل بيصل للرجلين وبيتثبت بحزام أو مشابك."
        }
      ]
    },
    "arb": {
      "preferred_label": "رِدَاء",
      "descriptions": [
        {
          "source": "acai",
          "description": "ثَوْبٌ خَارِجِيٌّ طَوِيلٌ وَفَضْفَاضٌ يَصِلُ إِلَى الْقَدَمَيْنِ، وَيُثَبَّتُ بِحِزَامٍ أَوْ مَشَابِكَ."
        }
      ]
    },
    "bis": {
      "preferred_label": "longfala klos blong werem antap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan longfala mo lusele klos we man i werem antap long ol narafala klos we i godaon kasem leg blong hem mo oli stap fasem wetem let no fasena."
        }
      ]
    },
    "fra": {
      "preferred_label": "manteau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vêtement de dessus long et ample qui descendait jusqu’aux pieds et était maintenu par une ceinture ou des attaches."
        }
      ]
    },
    "hau": {
      "preferred_label": "Babban riga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dogo kuma babban mayafi ko riga ta waje mai kaiwa har ƙafa da ake ɗaurewa da ɗamara ko maɓalli."
        }
      ]
    },
    "hin": {
      "preferred_label": "चोगा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक लंबा, ढीला बाहरी वस्त्र जो पैरों तक पहुँचता था और एक पटके या बन्धनों द्वारा अपनी जगह पर टिका रहता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "uwe elu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uwe mwụda toro ogologo nke ruru nʼala ụkwụ, nke a na-eji eriri úkwù ma ọ bụ ihe mkpọchi ejide."
        }
      ]
    },
    "ind": {
      "preferred_label": "jubah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pakaian luar yang panjang dan longgar yang menjulur sampai ke kaki dan ditahan pada tempatnya dengan ikat pinggang atau pengait."
        }
      ]
    },
    "nep": {
      "preferred_label": "खास्टो",
      "descriptions": [
        {
          "source": "acai",
          "description": "गोडासम्‍मै पुग्‍ने र पटुका वा बन्धनले अड्याइने खुकुलो बाहिरी लुगा।"
        }
      ]
    },
    "por": {
      "preferred_label": "capa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma vestimenta externa longa e solta que chegava até os pés e era presa por uma faixa ou fechos."
        }
      ]
    },
    "rus": {
      "preferred_label": "плащ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Длинная свободная верхняя одежда, доходившая до пят и закреплявшаяся поясом или застежками."
        }
      ]
    },
    "spa": {
      "preferred_label": "manto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prenda de vestir exterior, larga y holgada, que llegaba hasta los pies y se sostenía con una faja o broches."
        }
      ]
    },
    "swh": {
      "preferred_label": "Joho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vazi refu na pana la nje linalofika miguuni na linaloshikiliwa kwa mshipi au vifungo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "longpela klos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela longpela na lus klos bilong antap i save go daun inap long lek na ol i pasim long let o samting bilong pasim."
        }
      ]
    },
    "vie": {
      "preferred_label": "áo choàng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chiếc áo khoác ngoài dài, rộng, phủ đến chân và được giữ cố định bằng dây đai hoặc khuy cài."
        }
      ]
    },
    "zhs": {
      "preferred_label": "外衣",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种长而宽松的外袍，长及脚部，用腰带或搭扣固定。"
        }
      ]
    },
    "zht": {
      "preferred_label": "外衣",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種長及腳踝的寬鬆外衣，通常用腰帶或扣件固定。"
        }
      ]
    }
  },
