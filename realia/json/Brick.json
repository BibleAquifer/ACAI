  "localizations": {
    "eng": {
      "preferred_label": "Brick",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Brick",
          "article": "realia:Brick",
          "description": "A block made of clay, either dried in the sun or baked, used as a building material."
        }
      ]
    },
    "apd": {
      "preferred_label": "طوب",
      "descriptions": [
        {
          "source": "acai",
          "description": "قالب مصنوع من الطين، إما منشف في الشمس أو محروق في النار، بيستعملوه في البناء."
        }
      ]
    },
    "arb": {
      "preferred_label": "لِبْنَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "قَالَبٌ مَصْنُوعٌ مِنَ ٱلطِّينِ، إِمَّا مُجَفَّفٌ فِي ٱلشَّمْسِ أَوْ مَشْوِيٌّ، يُسْتَخْدَمُ مَادَّةً لِلْبِنَاءِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "brikis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan blok we oli wokem wetem graon kle, we i save drae long san no oli bonem long faea, we oli yusum blong wokem ol haos."
        }
      ]
    },
    "fra": {
      "preferred_label": "brique",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bloc d'argile, séché au soleil ou cuit au four, utilisé comme matériau de construction."
        }
      ]
    },
    "hau": {
      "preferred_label": "tubali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani tubali da aka yi da yumɓu, ko an shanya a rana ko an gasa, wanda ake amfani da shi azaman kayan gini."
        }
      ]
    },
    "hin": {
      "preferred_label": "ईंट",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिट्टी से बना एक चौकोर टुकड़ा, जिसे धूप में सुखाया जाता है या आग में पकाया जाता है, और निर्माण सामग्री के रूप में उपयोग किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Brik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpempe ụrọ a kpụrụ akpụ, nke a mịrị nʼanwụ ma ọ bụ kpọọ nʼọkụ, nke a na-eji dị ka ngwá ọrụ e ji ewu ụlọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "batu bata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Balok yang terbuat dari tanah liat, baik yang dikeringkan di bawah sinar matahari maupun dibakar, yang digunakan sebagai bahan bangunan."
        }
      ]
    },
    "nep": {
      "preferred_label": "इँटा",
      "descriptions": [
        {
          "source": "acai",
          "description": "घाममा सुकाएर वा भट्टामा पोलेर बनाइएको माटोको डल्लो वा खण्ड, जुन निर्माण सामग्रीको रूपमा प्रयोग गरिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "tijolo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um bloco feito de argila, seco ao sol ou cozido ao fogo, usado como material de construção."
        }
      ]
    },
    "rus": {
      "preferred_label": "Кирпич",
      "descriptions": [
        {
          "source": "acai",
          "description": "Брусок из глины, высушенный на солнце или обожженный в печи, используемый как строительный материал."
        }
      ]
    },
    "spa": {
      "preferred_label": "ladrillo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bloque hecho de arcilla, secado al sol o cocido, utilizado como material de construcción."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tofali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kipande kigumu cha udongo wa mfinyanzi, ama kilichokaushwa kwa jua au kilichochomwa moto, kinachotumiwa kama kifaa cha ujenzi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "brik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela blok ol i wokim long graun malumalu, ol i draim long san o kukim long paia, bilong wokim ol haus na ol arapela samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Gạch",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một khối làm bằng đất sét nung hoặc phơi khô dưới ánh nắng mặt trời, dùng làm vật liệu xây dựng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "砖",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种由黏土制成、经日晒或烘烤干燥后用作建筑材料的块状物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "磚",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種由黏土製成、經日曬或烘烤而成的塊狀物，用作建築材料。"
        }
      ]
    }
  },
