        }
      ]
    },
    "arb": {
      "preferred_label": "كُرّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَحْدَةُ قِيَاسٍ عِبْرَانِيَّةٌ لِلْمَوَادِّ ٱلْجَافَّةِ وَٱلسَّائِلَةِ، نَحْوُ ٢٢٠ لِتْرًا."
        }
      ]
