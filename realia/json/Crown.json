  "localizations": {
    "eng": {
      "preferred_label": "Crown",
      "alternate_labels": [
        "Diadem",
        "Garland",
        "Diadem Crown",
        "Wreath"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Crown",
          "article": "realia:Crown",
          "description": "A headdress made of precious metals and jewels, worn by kings, queens, and officials as a symbol of authority and status."
        }
      ]
    },
    "apd": {
      "preferred_label": "تاج",
      "descriptions": [
        {
          "source": "acai",
          "description": "غطا للرأس مصنوع من معادن وجواهر نفيسة، بيلبسوه الملوك والملكات والمسؤولين كرمز للسلطة والمكانة."
        }
      ]
    },
    "arb": {
      "preferred_label": "تاج",
      "descriptions": [
        {
          "source": "acai",
          "description": "غطاء للرأس مصنوع من معادن ثمينة وجواهر، يرتديه الملوك والملكات والمسؤولون كرمز للسلطة والمكانة."
        }
      ]
    },
    "bis": {
      "preferred_label": "hat blong king",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan spesel hat we oli wokem long gol mo ston we i dia tumas, we ol king, kwin, mo ol haeman oli stap werem olsem saen blong hae nem mo pawa."
        }
      ]
    },
    "fra": {
      "preferred_label": "couronne",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une coiffure faite de métaux précieux et de joyaux, portée par les rois, les reines et les dignitaires comme symbole d'autorité et de rang."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rawani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kambun da ake yi da karafa masu daraja da duwatsu masu daraja, wanda sarakuna, sarauniyoyi, da masu mulki suke sawa a matsayin alamar iko da matsayi."
        }
      ]
    },
    "hin": {
      "preferred_label": "राजमुकुट",
      "descriptions": [
        {
          "source": "acai",
          "description": "बहुमूल्य धातुओं और रत्नों से बना सिर का एक आभूषण, जिसे राजाओं, रानियों और अधिकारियों द्वारा अधिकार और पद के प्रतीक के रूप में पहना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Okpueze",
      "descriptions": [
        {
          "source": "acai",
          "description": "Okpu e ji ọla dị oké ọnụ ahịa na nkume dị oké ọnụ ahịa mee, nke ndị eze, ndị eze nwanyị, na ndị isi na-ekpu dị ka ihe nnọchianya nke ikike na ọkwá."
        }
      ]
    },
    "ind": {
      "preferred_label": "mahkota",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hiasan kepala yang terbuat dari logam berharga dan permata, dikenakan oleh raja, ratu, dan pejabat sebagai lambang kekuasaan dan kedudukan."
        }
      ]
    },
    "nep": {
      "preferred_label": "मुकुट",
      "descriptions": [
        {
          "source": "acai",
          "description": "बहुमूल्य धातु र रत्नहरूले बनेको शिरपेच, जुन राजा, रानी र अधिकारीहरूले अधिकार र पदको प्रतीकको रूपमा पहिरिन्थे।"
        }
      ]
    },
    "por": {
      "preferred_label": "coroa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um adorno para a cabeça feito de metais preciosos e joias, usado por reis, rainhas e autoridades como símbolo de autoridade e status."
        }
      ]
    },
    "rus": {
      "preferred_label": "корона",
      "descriptions": [
        {
          "source": "acai",
          "description": "Головной убор из драгоценных металлов и камней, который носят цари, царицы и сановники как символ власти и статуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "corona (real)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tocado hecho de metales preciosos y joyas, usado por reyes, reinas y dignatarios como símbolo de autoridad y posición social."
        }
      ]
    },
    "swh": {
      "preferred_label": "taji",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pambo la kuvaa kichwani lililotengenezwa kwa metali za thamani na vito, linalovaliwa na wafalme, malkia, na viongozi kama ishara ya mamlaka na hadhi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "hat bilong king",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bilas bilong het ol i wokim long gutpela gol na dia ston samting, em ol king, kwin, na ol bikman i save putim olsem mak bilong namba na biknem."
        }
      ]
    },
    "vie": {
      "preferred_label": "vương miện",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vật đội đầu làm bằng kim loại quý và đá quý, do các vua, hoàng hậu và quan chức đội như biểu tượng của thẩm quyền và địa vị."
        }
      ]
    },
    "zhs": {
      "preferred_label": "王冠",
      "descriptions": [
        {
          "source": "acai",
          "description": "由贵金属和宝石制成的头冠，由君王、王后及官员佩戴，作为权力和地位的象征。"
        }
      ]
    },
    "zht": {
      "preferred_label": "王冠",
      "descriptions": [
        {
          "source": "acai",
          "description": "由貴金屬和寶石製成的頭飾，由國王、王后及官員佩戴，作為權柄和地位的象徵。"
        }
      ]
    }
  },
