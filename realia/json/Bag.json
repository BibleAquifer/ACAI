      "descriptions": [
        {
          "source": "acai",
          "gloss": "Bag",
          "article": "realia:Bag",
          "description": "A container made of leather or cloth used to carry money, food, or other possessions."
        }
      ]
    },
    "apd": {
      "preferred_label": "كيس",
      "descriptions": [
        {
          "source": "acai",
          "description": "وعاء مصنوع من الجلد أو القماش، بيستعملوه لحمل القروش أو الأكل أو الحاجات التانية."
        }
      ]
    },
    "arb": {
      "preferred_label": "كِيس",
      "descriptions": [
        {
          "source": "acai",
          "description": "وِعَاءٌ مَصْنُوعٌ مِنَ ٱلْجِلْدِ أَوِ ٱلْقُمَاشِ يُسْتَخْدَمُ لِحَمْلِ ٱلْمَالِ أَوِ ٱلطَّعَامِ أَوْ غَيْرِهَا مِنَ ٱلْمُقْتَنَيَاتِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bag",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we oli wokem long leta no kaliko blong karem mane, kakae, no ol narafala samting."
        }
      ]
    },
    "fra": {
      "preferred_label": "sac",
      "descriptions": [
        {
          "source": "acai",
          "description": "Récipient en cuir ou en tissu utilisé pour transporter de l'argent, de la nourriture ou d'autres biens."
        }
      ]
    },
    "hau": {
      "preferred_label": "Jaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani akwatin kaya da aka yi da fata ko tsumma, wanda ake amfani da shi don ɗaukar kuɗi, abinci, ko wasu kayayyaki."
        }
      ]
    },
    "hin": {
      "preferred_label": "थैली",
      "descriptions": [
        {
          "source": "acai",
          "description": "चमड़े या कपड़े से बना एक पात्र जिसका उपयोग धन, भोजन या अन्य सामान ले जाने के लिए किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Akpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe e ji akpụkpọ anụ maọbụ ákwà mee nke a na-eji ebu ego, nri, maọbụ ihe onwunwe ndị ọzọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "kantong",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wadah yang terbuat dari kulit atau kain yang digunakan untuk membawa uang, makanan, atau barang bawaan lainnya."
        }
      ]
    },
    "nep": {
      "preferred_label": "थैली",
      "descriptions": [
        {
          "source": "acai",
          "description": "रुपियाँ-पैसा, खानेकुरा वा अन्य सरसामानहरू बोक्न प्रयोग गरिने छाला वा कपडाको थैलो वा झोला।"
        }
      ]
    },
    "por": {
      "preferred_label": "bolsa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um recipiente feito de couro ou tecido usado para carregar dinheiro, comida ou outros pertences."
        }
      ]
    },
    "rus": {
      "preferred_label": "сумка",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вместилище из кожи или ткани, используемое для ношения денег, пищи или других вещей."
        }
      ]
    },
    "spa": {
      "preferred_label": "bolsa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recipiente de cuero o tela que se usa para llevar dinero, comida u otras pertenencias."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mfuko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chombo kilichotengenezwa kwa ngozi au kitambaa kinachotumiwa kubeba fedha, chakula, au vitu vingine."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting ol i wokim long let o laplap bilong karim mani, kaikai, o ol arapela samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Túi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đồ đựng bằng da hoặc vải dùng để mang theo tiền bạc, thức ăn, hoặc đồ dùng cá nhân."
        }
      ]
    },
    "zhs": {
      "preferred_label": "袋子",
      "descriptions": [
        {
          "source": "acai",
          "description": "由皮革或布制成、用于盛装金钱、食物或其他财物的容器。"
        }
      ]
    },
    "zht": {
      "preferred_label": "袋子",
      "descriptions": [
        {
          "source": "acai",
          "description": "用皮革或布製成的容器，用來裝錢、食物或其他財物。"
        }
      ]
    }
  },
