      "preferred_label": "Reed",
      "alternate_labels": [
        "Measuring Reed",
        "Measuring Stick"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Reed",
          "article": "realia:Reed",
          "description": "A long plant stem used as a measuring stick, equal to about 3.1 meters."
        }
      ]
    },
    "apd": {
      "preferred_label": "قصبة قياس",
      "descriptions": [
        {
          "source": "acai",
          "description": "عود نبات طويل بيستعمل كعصاية قياس، طوله حوالي 3.1 متر."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَصَبَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "سَاقُ نَبَاتٍ طَوِيلَةٌ تُسْتَخْدَمُ كَعَصَا قِيَاسٍ، تُعَادِلُ نَحْوَ ٣٫١ أَمْتَارٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "longfala rula",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan longfala stik blong plan we oli yusum olsem wan rula blong makem samting, we longfala blong hem i klosap tri meta."
        }
      ]
    },
    "fra": {
      "preferred_label": "canne",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tige de plante longue servant de règle de mesure, équivalant à environ 3,1 mètres."
        }
      ]
    },
    "hau": {
      "preferred_label": "Karan awo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dogon karan shuka da ake amfani da shi azaman sandar awo, wanda tsawonsa ya kai kusan mita 3.1."
        }
      ]
    },
    "hin": {
      "preferred_label": "मापने का बाँस",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक पौधे का लम्बा तना जो नापने की छड़ी के रूप में उपयोग किया जाता था, जिसकी लम्बाई लगभग 3.1 मीटर होती थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Osisi e ji atụ ihe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ogologo ahịhịa ma ọ bụ mkpara e ji atụ ihe, nke hà ihe dị ka mita 3.1."
        }
      ]
    },
    "ind": {
      "preferred_label": "tongkat pengukur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Batang tanaman panjang yang digunakan sebagai tongkat pengukur, setara dengan sekitar 3,1 meter."
        }
      ]
    },
    "nep": {
      "preferred_label": "नाप्ने नर्कट",
      "descriptions": [
        {
          "source": "acai",
          "description": "नाप्ने लट्ठीको रूपमा प्रयोग गरिने बोटको लामो डाँठ, जुन करिब ३.१ मिटर बराबर हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "vara de medir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um caule longo de planta usado como vara de medir, equivalente a cerca de 3,1 metros."
        }
      ]
    },
    "rus": {
      "preferred_label": "Трость",
      "descriptions": [
        {
          "source": "acai",
          "description": "Длинный стебель растения, используемый в качестве мерного шеста, длиной около 3,1 метра."
        }
      ]
    },
    "spa": {
      "preferred_label": "caña de medir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tallo largo de planta utilizado como vara de medir, equivalente a unos 3,1 metros."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ufito wa kupimia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ufito mrefu wa mmea uliotumiwa kama kijiti cha kupimia, wenye urefu wa takriban mita 3.1."
        }
      ]
    },
    "tpi": {
      "preferred_label": "meta kanda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela longpela stik bilong planim o kanda ol i yusim olsem meta bilong metaim samting, longpela bilong en inap 3.1 mita."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây sậy đo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thân cây dài được dùng làm cây đo, tương đương khoảng 3,1 mét."
        }
      ]
    },
    "zhs": {
      "preferred_label": "量竿",
      "descriptions": [
        {
          "source": "acai",
          "description": "用作量尺的长植物茎，约等于3.1米。"
        }
      ]
    },
    "zht": {
      "preferred_label": "量度的竿",
      "descriptions": [
        {
          "source": "acai",
          "description": "用作量尺的長植物莖，約等於3.1公尺。"
        }
      ]
    }
