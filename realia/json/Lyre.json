  "localizations": {
    "eng": {
      "preferred_label": "Lyre",
      "alternate_labels": [
        "Harp",
        "Guitar",
        "To Play a Lyre",
        "To Play a Harp",
        "Harpist",
        "Exile"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Lyre",
          "article": "realia:Lyre",
          "description": "A small wooden instrument with strings, often plucked while held in the hands, like a harp."
        }
      ]
    },
    "apd": {
      "preferred_label": "كنارة",
      "descriptions": [
        {
          "source": "acai",
          "description": "آلة وترية خشبية صغيرة، بتنعزف باليدين، بتشبه القيثارة."
        }
      ]
    },
    "arb": {
      "preferred_label": "عود",
      "descriptions": [
        {
          "source": "acai",
          "description": "آلة موسيقية خشبية صغيرة ذات أوتار، تُعزف غالبًا بالنقر عليها باليدين، شبيهة بالقيثارة."
        }
      ]
    },
    "bis": {
      "preferred_label": "mandolin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol instroment blong wud we i gat waea (string), we plante taem man i stap holem long han blong plae long hem olsem wan hap."
        }
      ]
    },
    "fra": {
      "preferred_label": "lyre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit instrument en bois muni de cordes, que l'on pinçait souvent en le tenant à la main, semblable à une harpe."
        }
      ]
    },
    "hau": {
      "preferred_label": "Molo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani ƙaramin kayan kida na katako mai igiyoyi, wanda galibi ake bugawa ko tsinkawa yayin da aka riƙe shi a hannu, kamar garaya ko molo."
        }
      ]
    },
    "hin": {
      "preferred_label": "सारंगी",
      "descriptions": [
        {
          "source": "acai",
          "description": "तारों वाला लकड़ी का एक छोटा बाजा, जिसे प्रायः हाथ में पकड़कर वीणा (हार्प) की तरह बजाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Une",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere ngwá egwu e ji osisi mee nke nwere akwara, nke a na-akpọkarị site nʼiji aka kụọ ya, dị ka haapu."
        }
      ]
    },
    "ind": {
      "preferred_label": "kecapi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alat musik dawai kayu kecil yang biasanya dipetik sambil dipegang dengan tangan, serupa dengan harpa."
        }
      ]
    },
    "nep": {
      "preferred_label": "सारङ्गी",
      "descriptions": [
        {
          "source": "acai",
          "description": "वीणाजस्तै हातमा लिएर तार रेटेर वा औँलाले छोएर बजाइने काठको सानो तारबाजा।"
        }
      ]
    },
    "por": {
      "preferred_label": "lira",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um pequeno instrumento de madeira com cordas, frequentemente tocado com os dedos enquanto segurado nas mãos, semelhante a uma harpa."
        }
      ]
    },
    "rus": {
      "preferred_label": "Лира",
      "descriptions": [
        {
          "source": "acai",
          "description": "Небольшой деревянный струнный инструмент, похожий на арфу, на котором часто играли пальцами или плектром, держа в руках."
        }
      ]
    },
    "spa": {
      "preferred_label": "lira",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pequeño instrumento musical de cuerda de madera, a menudo tocado con los dedos mientras se sostiene en las manos, semejante a un arpa."
        }
      ]
    },
    "swh": {
      "preferred_label": "Zeze",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ala ndogo ya mbao yenye nyuzi, mara nyingi ikipigwa kwa vidole huku imeshikiliwa mikononi, kama kinubi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "gita",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik gita diwai i gat string, planti taim ol i save holim long han na paitim string bilong en, olsem wanpela hap."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đàn lia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nhạc cụ nhỏ bằng gỗ có dây, thường được gảy khi cầm trên tay, giống như đàn hạc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "瑟",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种小型木制弦乐器，常拿在手中弹奏，类似竖琴。"
        }
      ]
    },
    "zht": {
      "preferred_label": "琴",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種小型木製弦樂器，常抱在手中彈奏，類似豎琴。"
        }
      ]
    }
  },
