          "description": "شرايط طويلة من الكتان مخيطة مع بعض عشان تعمل قطع أكبر بتستعمل كأغطية أو ستاير."
        }
      ]
    },
    "arb": {
      "preferred_label": "شقق كتان",
      "descriptions": [
        {
          "source": "acai",
          "description": "شقق طويلة من الكتان تُخاط معًا لتكوين قطع أكبر تُستخدم كأغطية."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol pis kaliko linen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol longfala pis kaliko linen we oli somap tugeta blong mekem ol bigfala pis blong kavremap samting."
        }
      ]
    },
    "fra": {
      "preferred_label": "bandes de lin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Longues bandes de lin cousues ensemble pour former des pièces plus grandes utilisées comme tentures ou couvertures."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zannuwan lilin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dogayen zannuwan lilin da aka ɗinka wuri ɗaya domin su zama manyan mayafai da ake amfani da su a matsayin sutura ko rufi."
        }
      ]
    },
    "hin": {
      "preferred_label": "सनी की पट्टियाँ",
      "descriptions": [
        {
          "source": "acai",
          "description": "सन की लंबी पट्टियाँ जिन्हें आपस में सिलकर आवरण के रूप में प्रयुक्त होने वाले बड़े टुकड़े बनाए जाते थे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ibe akwa linen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ogologo ibe akwa linen a dụkọtara ọnụ iji mepụta nnukwu iberibe e ji ekpuchi ihe."
        }
      ]
    },
    "ind": {
      "preferred_label": "carikan lenan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Carikan-carikan lenan panjang yang dijahit menjadi satu untuk membentuk bagian-bagian yang lebih besar yang digunakan sebagai penutup."
        }
      ]
    },
    "nep": {
      "preferred_label": "सुती कपडाका पर्दाहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "ढाक्ने साधनको रूपमा ठूला टुक्राहरू बनाउन आपसमा सिलाइएका सनका लामा पट्टीहरू वा पर्दाहरू।"
        }
      ]
    },
    "por": {
      "preferred_label": "cortinas de linho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tiras longas de linho costuradas para formar peças maiores usadas como coberturas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Покрывала из виссона",
      "descriptions": [
        {
          "source": "acai",
          "description": "Длинные полосы льняной ткани, сшитые вместе для создания больших полотнищ, используемых в качестве покрывал."
        }
      ]
    },
    "spa": {
      "preferred_label": "tiras de lino",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tiras largas de lino cosidas para formar piezas más grandes que se usaban como cubiertas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mapazia ya kitani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vipande virefu vya kitambaa cha kitani vilivyoshonwa pamoja ili kufanya vipande vikubwa vinavyotumika kama vifuniko."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ol hap laplap linen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol longpela hap laplap linen ol i samapim wantaim bilong mekim bikpela laplap bilong karamapim samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Dải màn vải gai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những dải vải gai dài được may lại với nhau để tạo thành các tấm lớn hơn dùng làm màn che."
        }
      ]
    },
    "zhs": {
      "preferred_label": "细麻幔幅",
      "descriptions": [
        {
          "source": "acai",
          "description": "缝合在一起形成用于遮盖的大块布的长条细麻布幅。"
        }
      ]
    },
    "zht": {
      "preferred_label": "幔子",
      "descriptions": [
        {
          "source": "acai",
          "description": "縫合在一起形成較大遮蓋物的一條條細麻布幅。"
        }
      ]
    }
  },
