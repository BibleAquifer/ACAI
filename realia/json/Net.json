      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Net",
          "article": "realia:Net",
          "description": "A tool made of interconnected ropes or strings, used for catching fish, birds, or other animals."
        }
      ]
    },
    "apd": {
      "preferred_label": "شبكة",
      "descriptions": [
        {
          "source": "acai",
          "description": "أداة مصنوعة من حبال أو خيوط مشبكة مع بعض، بتُستعمل لصيد السمك أو الطيور أو حيوانات تانية."
        }
      ]
    },
    "arb": {
      "preferred_label": "شبكة",
      "descriptions": [
        {
          "source": "acai",
          "description": "أداة مصنوعة من حبال أو خيوط متشابكة، تُستخدم لصيد الأسماك أو الطيور أو غيرها من الحيوانات."
        }
      ]
    },
    "bis": {
      "preferred_label": "net",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tul we oli wokem long ol rop no tred we oli tantanem wetem olgeta, we oli yusum blong kasem fis, pijin, no ol narafala anamol."
        }
      ]
    },
    "fra": {
      "preferred_label": "filet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Outil fait de cordes ou de fils entrecroisés, utilisé pour capturer des poissons, des oiseaux ou d'autres animaux."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tarko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kayan aiki da aka yi da igiyoyi masu sarƙaƙiya, ana amfani da shi wajen kamo kifi, tsuntsaye, ko wasu dabbobi."
        }
      ]
    },
    "hin": {
      "preferred_label": "जाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "आपस में जुड़ी हुई रस्सियों या डोरी से बना एक उपकरण, जिसका उपयोग मछलियाँ, पक्षी या अन्य जानवरों को पकड़ने के लिए किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụgbụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ngwá ọrụ e ji eriri ndị a kpara akpa mee, nke a na-eji ejide azụ̀, nnụnụ, ma ọ bụ anụmanụ ndị ọzọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "jaring",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alat yang terbuat dari jalinan tali atau benang, digunakan untuk menangkap ikan, burung, atau hewan lainnya."
        }
      ]
    },
    "nep": {
      "preferred_label": "जाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "माछा, चरा वा अन्य जनावरहरू समात्न प्रयोग गरिने डोरी वा धागोहरू आपसमा गाँसेर बनाइएको एक प्रकारको साधन।"
        }
      ]
    },
    "por": {
      "preferred_label": "rede",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um instrumento feito de cordas ou fios entrelaçados, usado para capturar peixes, aves ou outros animais."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сеть",
      "descriptions": [
        {
          "source": "acai",
          "description": "Приспособление из переплетенных веревок или нитей, используемое для ловли рыбы, птиц или других животных."
        }
      ]
    },
    "spa": {
      "preferred_label": "red",
      "descriptions": [
        {
          "source": "acai",
          "description": "Herramienta hecha de cuerdas o hilos entrelazados, que se usa para atrapar peces, aves u otros animales."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wavu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kifaa kilichotengenezwa kwa kamba au nyuzi zilizofungamana, kinachotumika kukamata samaki, ndege, au wanyama wengine."
        }
      ]
    },
    "tpi": {
      "preferred_label": "umben",
      "descriptions": [
        {
          "source": "acai",
          "description": "Samting ol i wokim long ol rop i paspas bilong kisim ol pis, pisin, o arapela animal."
        }
      ]
    },
    "vie": {
      "preferred_label": "lưới",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dụng cụ được đan bằng dây thừng hoặc sợi chỉ, dùng để đánh bắt cá, chim hoặc các loài động vật khác."
        }
      ]
    },
    "zhs": {
      "preferred_label": "网",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种由绳线相互编织而成的工具，用于捕鱼、捕鸟或其他动物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "網",
      "descriptions": [
        {
          "source": "acai",
          "description": "由互相交織的繩或線製成的工具，用於捕撈魚類、鳥類或其他動物。"
        }
      ]
    }
  },
