      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Incense",
          "article": "realia:Incense",
          "description": "A substance, usually a resin, burned for a pleasant smell."
        }
      ]
    },
    "apd": {
      "preferred_label": "بخور",
      "descriptions": [
        {
          "source": "acai",
          "description": "مادة، غالباً صمغ شجر، بتتحرق عشان تدي ريحة طيبة."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَخُور",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَادَّةٌ، عِبَارَةٌ عَنْ صَمْغٍ رَاتِينْجِيٍّ غَالِبًا، تُحْرَقُ لِإِطْلَاقِ رَائِحَةٍ طَيِّبَةٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "insens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting, we plante taem i mekem wetem doti blong wud (resin), we oli bonem blong i givim gudfala smel."
        }
      ]
    },
    "fra": {
      "preferred_label": "encens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une substance, généralement une résine, que l’on brûle pour son odeur agréable."
        }
      ]
    },
    "hau": {
      "preferred_label": "Turare",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu, yawanci kankara ko dankon itace, wanda ake konawa don ya ba da kamshi mai dadi."
        }
      ]
    },
    "hin": {
      "preferred_label": "धूप",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक पदार्थ, आमतौर पर एक राल (गोंद), जिसे सुगंध के लिए जलाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ihe nsure ọkụ na-esi isi ụtọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe, na-abụkarị chịngọm osisi, a na-esure nʼọkụ maka ísì ụtọ ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "ukupan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zat, biasanya berupa damar/getah, yang dibakar untuk menghasilkan bau yang harum."
        }
      ]
    },
    "nep": {
      "preferred_label": "धूप",
      "descriptions": [
        {
          "source": "acai",
          "description": "मीठो बास्नाको निम्ति बालिने पदार्थ, सामान्यतया खोटो वा लोबान।"
        }
      ]
    },
    "por": {
      "preferred_label": "incenso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma substância, geralmente uma resina, queimada para produzir um aroma agradável."
        }
      ]
    },
    "rus": {
      "preferred_label": "Благовония",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вещество (обычно смола), сжигаемое для получения приятного запаха; фимиам."
        }
      ]
    },
    "spa": {
      "preferred_label": "incienso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sustancia, generalmente una resina, que se quema para producir un aroma agradable."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uvumba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu, kwa kawaida utomvu wa mti, kinachochomwa ili kutoa harufu nzuri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "paura bilong kamapim smok i gat gutpela smel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kain samting, olsem paura o gris bilong diwai, ol i save kukim bilong kamapim smok i gat gutpela smel."
        }
      ]
    },
    "vie": {
      "preferred_label": "hương",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chất, thường là nhựa cây, được đốt để tạo mùi thơm dễ chịu."
        }
      ]
    },
    "zhs": {
      "preferred_label": "香",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种通常为树脂的物质，焚烧时会产生香气。"
        }
      ]
    },
    "zht": {
      "preferred_label": "香",
      "descriptions": [
        {
          "source": "acai",
          "description": "燃燒時會散發宜人香氣的物質，通常為樹脂。"
        }
      ]
    }
  },
