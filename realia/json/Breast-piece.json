  "localizations": {
    "eng": {
      "preferred_label": "Breast-Piece",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Breast-Piece",
          "article": "realia:Breast-piece",
          "description": "A square pouch decorated with 12 precious stones and worn by the high priest on his chest, containing the Urim and Thummim."
        }
      ]
    },
    "apd": {
      "preferred_label": "صدرة القضاء",
      "descriptions": [
        {
          "source": "acai",
          "description": "كيس مربع مزين بـ ١٢ حجر كريم، رئيس الكهنة كان بلبسو فوق صدرهو، وفيهو الأوريم والتميم."
        }
      ]
    },
    "arb": {
      "preferred_label": "صُدْرَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "كيس مربع مزين باثني عشر حجرًا كريمًا يرتديه رئيس الكهنة على صدره، ويحتوي على الأوريم والتميم."
        }
      ]
    },
    "bis": {
      "preferred_label": "spesel paos blong jes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan skwea paos we oli flasem wetem 12 spesel ston we hae pris i stap hangem long jes blong hem, we Yurim mo Tumim i stap insaed long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "pectoral",
      "descriptions": [
        {
          "source": "acai",
          "description": "Poche carrée ornée de 12 pierres précieuses et portée sur la poitrine par le grand prêtre, contenant l’Ourim et le Thoummim."
        }
      ]
    },
    "hau": {
      "preferred_label": "ƙyallen ƙirji",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aljihu mai kusurwoyi huɗu da aka ƙawata da duwatsu masu daraja 12 wanda babban firist yake ɗaurawa a ƙirjinsa, yana ɗauke da Urim da Tummim."
        }
      ]
    },
    "hin": {
      "preferred_label": "न्याय की चपरास",
      "descriptions": [
        {
          "source": "acai",
          "description": "१२ बहुमूल्य रत्नों से सुसज्जित एक चौकोर थैली, जिसे महायाजक अपनी छाती पर पहनता था और जिसमें ऊरीम और तुम्मीम रखे होते थे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe mgbochi obi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere akpa nwere akụkụ anọ hà nhata nke a chọrọ mma site nʼiji mkpụrụ nkume dị oké ọnụ ahịa iri na abụọ chọọ ya mma, nke onye isi nchụaja na-eyi nʼobi ya, nke nwekwara Yurim na Tumim nʼime ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "tutup dada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kantung persegi yang dihiasi dengan 12 batu permata dan dikenakan oleh imam besar di dadanya, berisi Urim dan Tumim."
        }
      ]
    },
    "nep": {
      "preferred_label": "छाती-पाता",
      "descriptions": [
        {
          "source": "acai",
          "description": "१२ वटा बहुमूल्य पत्थरहरूले सजाइएको र ऊरीम र तुम्मीम राखिएको, प्रधान पुजारीले आफ्नो छातीमा लगाउने चारपाटे थैली ।"
        }
      ]
    },
    "por": {
      "preferred_label": "peitoral",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma bolsa quadrada decorada com 12 pedras preciosas e usada pelo sumo sacerdote sobre o peito, contendo o Urim e o Tumim."
        }
      ]
    },
    "rus": {
      "preferred_label": "наперсник",
      "descriptions": [
        {
          "source": "acai",
          "description": "Четырехугольная сумка, украшенная 12 драгоценными камнями, которую первосвященник носил на груди и в которой находились урим и туммим."
        }
      ]
    },
    "spa": {
      "preferred_label": "pectoral",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bolsa cuadrada adornada con doce piedras preciosas que llevaba el sumo sacerdote sobre el pecho, la cual contenía el Urim y el Tumim."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kifuko cha kifuani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kifuko cha mraba kilichopambwa kwa vito 12 vya thamani na kuvaliwa na kuhani mkuu kifuani mwake, kikiwa na Urimu na Thumimu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "laplap bilong bros",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik hap laplap ol i bilasim long 12-pela ston i dia tumas na hetpris i save pasim long bros bilong en, na Urim wantaim Tumim i stap insait long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "bảng đeo ngực",
      "descriptions": [
        {
          "source": "acai",
          "description": "Túi hình vuông gắn 12 viên đá quý do thầy tế lễ thượng phẩm đeo trên ngực, bên trong đựng U-rim và Thu-mim."
        }
      ]
    },
    "zhs": {
      "preferred_label": "胸牌",
      "descriptions": [
        {
          "source": "acai",
          "description": "由大祭司佩戴在胸前的方形袋子，饰有十二块宝石，内装乌陵和土明。"
        }
      ]
    },
    "zht": {
      "preferred_label": "胸牌",
      "descriptions": [
        {
          "source": "acai",
          "description": "大祭司佩戴在胸前的一個正方形袋子，飾有十二顆寶石，內盛烏陵和土明。"
        }
      ]
    }
  },
