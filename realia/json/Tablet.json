  "localizations": {
    "eng": {
      "preferred_label": "Tablet",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Tablet",
          "article": "realia:Tablet",
          "description": "A small, flat surface made of wood, metal, stone, or wax used for writing with a stylus."
        }
      ]
    },
    "apd": {
      "preferred_label": "لوح",
      "descriptions": [
        {
          "source": "acai",
          "description": "لوح صغير ومسطح مصنوع من خشب أو معدن أو حجر أو شمع، بيُستعمل للكتابة بقلم حفر أو أداة كتابة."
        }
      ]
    },
    "arb": {
      "preferred_label": "لوح",
      "descriptions": [
        {
          "source": "acai",
          "description": "لوح مسطح صغير مصنوع من الخشب أو المعدن أو الحجر أو الشمع، يُستخدم للكتابة بقلم حفر."
        }
      ]
    },
    "bis": {
      "preferred_label": "flat ston blong raet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol samting we i flat, we oli mekem long wud, aean, ston, no waks, we oli yusum blong raet long hem wetem wan staelas."
        }
      ]
    },
    "fra": {
      "preferred_label": "tablette",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petite surface plate faite de bois, de métal, de pierre ou de cire, utilisée pour écrire avec un stylet."
        }
      ]
    },
    "hau": {
      "preferred_label": "Allo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙaramin abu mai shimfiɗe da aka yi da itace, ƙarfe, dutse, ko kakin zuma wanda ake amfani da shi don rubutu da abin rubutu."
        }
      ]
    },
    "hin": {
      "preferred_label": "तख्ती",
      "descriptions": [
        {
          "source": "acai",
          "description": "लकड़ी, धातु, पत्थर या मोम से बनी एक छोटी, समतल सतह जिसका उपयोग शलाका (स्टाइलस) से लिखने के लिए किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "mbadamba nkume",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mbadamba ihe dị larịị nke e ji osisi, ọla, nkume, ma ọ bụ nta mepụta e ji ede ihe site nʼiji ngwá ọrụ e ji ede ihe."
        }
      ]
    },
    "ind": {
      "preferred_label": "loh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Permukaan kecil dan rata yang terbuat dari kayu, logam, batu, atau lilin yang digunakan untuk menulis dengan stilus."
        }
      ]
    },
    "nep": {
      "preferred_label": "शिला-पाटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "लेख्ने सुइरोद्वारा लेख्नका लागि प्रयोग गरिने काठ, धातु, ढुङ्गा वा मैनबाट बनेको सानो, समतल पाटी।"
        }
      ]
    },
    "por": {
      "preferred_label": "tábua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma superfície pequena e plana feita de madeira, metal, pedra ou cera, usada para escrever com um estilete."
        }
      ]
    },
    "rus": {
      "preferred_label": "Скрижаль",
      "descriptions": [
        {
          "source": "acai",
          "description": "Небольшая плоская пластина из дерева, металла, камня или воска, использовавшаяся для письма резцом (стилосом)."
        }
      ]
    },
    "spa": {
      "preferred_label": "tabla",
      "descriptions": [
        {
          "source": "acai",
          "description": "Superficie pequeña y plana de madera, metal, piedra o cera utilizada para escribir con un estilo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kibao",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bamba bapa na dogo lililotengenezwa kwa mbao, chuma, mawe, au nta lililotumiwa kuandikia kwa kijiti maalumu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "hap ston bilong rait",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela fletpela samting ol i wokim long diwai, kopa, ston, o waks bilong raitim tok long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "bảng đá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một bề mặt nhỏ, phẳng làm bằng gỗ, kim loại, đá hoặc sáp dùng để viết bằng que khắc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "石版",
      "descriptions": [
        {
          "source": "acai",
          "description": "用木头、金属、石头或蜡制成的小而平整的表面，用于用铁笔书写。"
        }
      ]
    },
    "zht": {
      "preferred_label": "板",
      "descriptions": [
        {
          "source": "acai",
          "description": "用木、金屬、石或蠟製成的小型扁平表面，用於以鐵筆刻寫。"
        }
      ]
    }
  },
