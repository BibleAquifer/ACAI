  "localizations": {
    "eng": {
      "preferred_label": "Rams Horn",
      "alternate_labels": [
        "Trumpet",
        "Horn",
        "Horn? Trumpet?"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rams Horn",
          "article": "realia:RamsHorn",
          "description": "A musical wind instrument made from a ram’s horn, used for signals and celebrations."
        }
      ]
    },
    "apd": {
      "preferred_label": "بوق قرن الكبش",
      "descriptions": [
        {
          "source": "acai",
          "description": "آلة نفخ موسيقية مصنوعة من قرن كبش، كانت بتستعمل للإشارات والاحتفالات."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَرْنُ كَبْشٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "آلَةٌ مُوسِيقِيَّةٌ نَفْخِيَّةٌ تُصْنَعُ مِنْ قَرْنِ ٱلْكَبْشِ، تُسْتَخْدَمُ لِلْإِشَارَاتِ وَٱلِاحْتِفَالَاتِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "pupu we oli wokem long hon blong sipsip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan instramen blong miusik we oli blu long hem, we oli wokem long hon blong sipsip, we oli yusum blong givim saen mo long ol lafet."
        }
      ]
    },
    "fra": {
      "preferred_label": "corne de bélier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Instrument de musique à vent fabriqué à partir d'une corne de bélier, servant pour les signaux et les célébrations."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙahon rago",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kayan bushe-bushe da aka yi da ƙahon rago, wanda ake amfani da shi don bayar da alama da kuma a bukukuwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "मेढ़े का सींग",
      "descriptions": [
        {
          "source": "acai",
          "description": "मेढ़े के सींग से बना एक फूँककर बजाने वाला वाद्ययंत्र, जिसका उपयोग संकेतों और उत्सवों के लिए किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Opi mpi ebule",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ngwa egwu a na-afụ afụ nke e ji mpi ebule mee, nke a na-eji enye mgbaàmà ma ọ bụ mee ememme."
        }
      ]
    },
    "ind": {
      "preferred_label": "sangkakala tanduk domba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alat musik tiup yang terbuat dari tanduk domba jantan, digunakan untuk tanda semboyan dan perayaan."
        }
      ]
    },
    "nep": {
      "preferred_label": "भेडाको सिङको तुरही",
      "descriptions": [
        {
          "source": "acai",
          "description": "साङ्केतिक सूचना र उत्सवहरूका लागि प्रयोग गरिने, भेडाको सिङबाट बनाइएको फुकेर बजाइने बाजा।"
        }
      ]
    },
    "por": {
      "preferred_label": "chifre de carneiro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um instrumento musical de sopro feito de chifre de carneiro, usado para sinais e celebrações."
        }
      ]
    },
    "rus": {
      "preferred_label": "Бараний рог",
      "descriptions": [
        {
          "source": "acai",
          "description": "Музыкальный духовой инструмент, сделанный из бараньего рога, использовавшийся для подачи сигналов и во время празднеств."
        }
      ]
    },
    "spa": {
      "preferred_label": "cuerno de carnero",
      "descriptions": [
        {
          "source": "acai",
          "description": "Instrumento musical de viento hecho con un cuerno de carnero, utilizado para señales y celebraciones."
        }
      ]
    },
    "swh": {
      "preferred_label": "Baragumu ya pembe ya kondoo dume",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ala ya muziki ya kupuliza iliyotengenezwa kwa pembe ya kondoo dume, iliyotumiwa kutoa ishara na katika sherehe."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kom bilong sipsip man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain biugel ol i wokim long kom bilong sipsip man, ol i save winim bilong givim sain na long ol taim bilong amamas."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kèn sừng cừu đực",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại nhạc cụ hơi làm từ sừng cừu đực, dùng để phát tín hiệu và trong các dịp lễ kỷ niệm."
        }
      ]
    },
    "zhs": {
      "preferred_label": "羊角号",
      "descriptions": [
        {
          "source": "acai",
          "description": "用公羊角制成的吹奏管乐器，用于发信号和庆祝。"
        }
      ]
    },
    "zht": {
      "preferred_label": "羊角",
      "descriptions": [
        {
          "source": "acai",
          "description": "用公羊角製成的管樂器，用於發送信號和慶祝。"
        }
      ]
    }
  },
