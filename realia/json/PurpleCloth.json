  "localizations": {
    "eng": {
      "preferred_label": "Purple Cloth",
      "alternate_labels": [
        "Reddish-Purple",
        "Crimson Yarn",
        "Scarlet Cloth"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Purple Cloth",
          "article": "realia:PurpleCloth",
          "description": "A cloth dyed with murex shellfish dye, often linked to wealth and royalty."
        }
      ]
    },
    "apd": {
      "preferred_label": "قماش أرجواني",
      "descriptions": [
        {
          "source": "acai",
          "description": "قماش مصبوغ بصبغة الحلزون الأرجواني، وغالباً مرتبط بالغنى والملوك."
        }
      ]
    },
    "arb": {
      "preferred_label": "أُرْجُوان",
      "descriptions": [
        {
          "source": "acai",
          "description": "قماش مصبوغ بصباغ من حلزون الموريكس، وغالبًا ما يرتبط بالثروة والملوكية."
        }
      ]
    },
    "bis": {
      "preferred_label": "pepol kaliko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kaliko we oli givim kala pepol long hem wetem doti blong wan kaen sel long solwota, we plante taem i saen blong rij mo ol king."
        }
      ]
    },
    "fra": {
      "preferred_label": "étoffe de pourpre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Étoffe teinte avec la teinture issue du murex, souvent associée à la richesse et à la royauté."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tufafin shunayya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tufafi da aka rina da rinin ƙififiye mai suna murex, sau da yawa ana danganta shi da arziki da sarauta."
        }
      ]
    },
    "hin": {
      "preferred_label": "बैंगनी वस्त्र",
      "descriptions": [
        {
          "source": "acai",
          "description": "म्यूरेक्स घोंघे के रंग से रँगा हुआ एक कपड़ा, जो अक्सर धन और राजसी ठाठ-बाट से जुड़ा होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Akwa odo odo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Akwa e ji ihe na-acha odo odo e si nʼazụ azụ murex tee, nke a na-ejikọtakarị ya na akụ̀ na ụba nakwa ndị eze."
        }
      ]
    },
    "ind": {
      "preferred_label": "kain ungu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kain yang diwarnai dengan pewarna siput murex, sering kali dikaitkan dengan kekayaan dan bangsawan."
        }
      ]
    },
    "nep": {
      "preferred_label": "बैजनी कपडा",
      "descriptions": [
        {
          "source": "acai",
          "description": "म्युरेक्स शङ्खकिराबाट निकालिएको रङद्वारा रङ्ग्याइएको कपडा, जुन प्रायः धन र राजकीय मान-प्रतिष्ठासँग सम्बन्धित हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "tecido de púrpura",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um tecido tingido com corante do molusco múrice, frequentemente associado à riqueza e à realeza."
        }
      ]
    },
    "rus": {
      "preferred_label": "Пурпурная ткань",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ткань, окрашенная красителем из моллюсков багрянок (мурекса), часто ассоциировавшаяся с богатством и царской властью."
        }
      ]
    },
    "spa": {
      "preferred_label": "tela de púrpura",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tela teñida con el tinte del caracol múrice, a menudo asociada con la riqueza y la realeza."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nguo ya zambarau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nguo iliyotiwa rangi inayotokana na kombe wa murex, mara nyingi ikihusishwa na utajiri na ufalme au enzi ya kifalme."
        }
      ]
    },
    "tpi": {
      "preferred_label": "retpela laplap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela laplap ol i daiim long dai bilong kain sel bilong solwara ol i kolim mureks, na planti taim ol i save bungim wantaim ol maniman na ol king."
        }
      ]
    },
    "vie": {
      "preferred_label": "Vải màu tím tía",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại vải được nhuộm bằng thuốc nhuộm từ ốc gai biển (murex), thường gắn liền với sự giàu có và vương quyền."
        }
      ]
    },
    "zhs": {
      "preferred_label": "紫色布",
      "descriptions": [
        {
          "source": "acai",
          "description": "用骨螺染料染色的布料，常与财富和王权相关联。"
        }
      ]
    },
    "zht": {
      "preferred_label": "紫色布",
      "descriptions": [
        {
          "source": "acai",
          "description": "用骨螺染料染成的布料，常與財富和王室聯繫在一起。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
