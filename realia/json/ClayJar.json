  "localizations": {
    "eng": {
      "preferred_label": "Clay Jar",
      "alternate_labels": [
        "Jar",
        "Pitcher",
        "Jug",
        "Vessel",
        "Water Jar"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Clay Jar",
          "article": "realia:ClayJar",
          "description": "A container made of clay, used for storing or carrying liquids like water, wine, or oil."
        }
      ]
    },
    "apd": {
      "preferred_label": "جَرّة فخار",
      "descriptions": [
        {
          "source": "acai",
          "description": "إناء مصنوع من الطين (الفخار)، بيُستعمل لحفظ أو نقل السوائل زي الموية أو الخمر أو الزيت."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَرَّةُ خَزَفٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "وِعَاءٌ مَصْنُوعٌ مِنَ الْفَخَّارِ (الطِّينِ)، يُسْتَخْدَمُ لِحِفْظِ السَّوَائِلِ مِثْلِ الْمَاءِ أَوِ الْخَمْرِ أَوِ الزَّيْتِ أَوْ لِنَقْلِهَا."
        }
      ]
    },
    "bis": {
      "preferred_label": "graonpot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan sospen no botel we oli wokem long graon (kle), we oli stap yusum blong putum no karem ol likwid olsem wota, waen, no oel."
        }
      ]
    },
    "fra": {
      "preferred_label": "cruche en terre cuite",
      "descriptions": [
        {
          "source": "acai",
          "description": "Récipient en terre cuite utilisé pour conserver ou transporter des liquides comme de l’eau, du vin ou de l’huile."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tulu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tulu da aka yi da laka ko ƙasa, ana amfani da shi don adana ko ɗaukar ruwa, ruwan inabi, ko mai."
        }
      ]
    },
    "hin": {
      "preferred_label": "मिट्टी का घड़ा",
      "descriptions": [
        {
          "source": "acai",
          "description": "पानी, दाखमधु या तेल जैसे तरल पदार्थों को रखने या ले जाने के लिए मिट्टी से बना एक बर्तन।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ite ájá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ite e ji ájá ụrọ mee, nke a na-eji echekwa ma ọ bụ ebu mmiri, mmanya, ma ọ bụ mmanụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "buyung tanah liat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wadah yang terbuat dari tanah liat, digunakan untuk menyimpan atau membawa cairan seperti air, anggur, atau minyak."
        }
      ]
    },
    "nep": {
      "preferred_label": "माटोको गाग्रो",
      "descriptions": [
        {
          "source": "acai",
          "description": "पानी, मद्य वा तेलजस्ता तरल पदार्थ राख्न वा बोक्न प्रयोग गरिने माटोको भाँडो।"
        }
      ]
    },
    "por": {
      "preferred_label": "jarro de barro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um recipiente feito de barro, usado para armazenar ou transportar líquidos como água, vinho ou azeite."
        }
      ]
    },
    "rus": {
      "preferred_label": "глиняный кувшин",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сосуд из глины, используемый для хранения или переноски жидкостей, таких как вода, вино или масло."
        }
      ]
    },
    "spa": {
      "preferred_label": "cántaro de barro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recipiente de arcilla usado para almacenar o transportar líquidos como agua, vino o aceite."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mtungi wa Udongo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chombo kilichotengenezwa kwa udongo wa mfinyanzi, kinachotumiwa kuhifadhia au kubebea vimiminika kama vile maji, divai, au mafuta."
        }
      ]
    },
    "tpi": {
      "preferred_label": "sospen graun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela sospen ol i wokim long graun malumalu bilong putim o karim ol likwit olsem wara, wain, o wel."
        }
      ]
    },
    "vie": {
      "preferred_label": "bình đất",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vật chứa làm bằng đất sét, dùng để đựng hoặc chuyên chở các chất lỏng như nước, rượu vang hoặc dầu."
        }
      ]
    },
    "zhs": {
      "preferred_label": "陶罐",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种用黏土制成的容器，用于储存或盛装水、酒或油等液体。"
        }
      ]
    },
    "zht": {
      "preferred_label": "陶罐",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種陶製容器，用於儲存或盛裝水、酒或油等液體。"
        }
      ]
    }
  },
