  "localizations": {
    "eng": {
      "preferred_label": "Staff",
      "alternate_labels": [
        "Stick",
        "Rod",
        "Scepter",
        "Club"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Staff",
          "article": "realia:Staff",
          "description": "A wooden stick used for walking, herding, or as a symbol of authority."
        }
      ]
    },
    "apd": {
      "preferred_label": "عكاز",
      "descriptions": [
        {
          "source": "acai",
          "description": "عكاز من خشب بيستعملوهو للمشي، أو لرعي الغنم، أو كرمز للسلطة."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَصَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "عصا خشبية تُستخدَم للمشي أو الرعي أو كرمز للسلطة."
        }
      ]
    },
    "bis": {
      "preferred_label": "stik blong wokbaot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan wud o stik we oli yusum blong wokbaot, blong lukaot long ol sipsip, no olsem wan saen blong hae nem mo paoa."
        }
      ]
    },
    "fra": {
      "preferred_label": "bâton",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bâton de bois utilisé pour marcher, garder les troupeaux ou comme symbole d'autorité."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sanda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sandar itace da ake amfani da ita wajen tafiya, ko kiwo, ko kuma a matsayin alamar iko."
        }
      ]
    },
    "hin": {
      "preferred_label": "लाठी",
      "descriptions": [
        {
          "source": "acai",
          "description": "चलने, चरवाही करने या अधिकार के प्रतीक के रूप में उपयोग की जाने वाली एक लकड़ी की छड़ी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mkpanaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkpanaka osisi a na-ejide nʼaka mgbe a na-eje ije, mgbe a na-azụ anụ, maọbụ dịka ihe ịrịba ama nke ikike maọbụ ọchịchị."
        }
      ]
    },
    "ind": {
      "preferred_label": "tongkat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Batang kayu yang digunakan untuk berjalan, menggembala, atau sebagai lambang kekuasaan."
        }
      ]
    },
    "nep": {
      "preferred_label": "लट्ठी",
      "descriptions": [
        {
          "source": "acai",
          "description": "हिँड्न, भेडाबाख्रा चराउन वा अधिकारको प्रतीकको रूपमा प्रयोग गरिने काठको लट्ठी।"
        }
      ]
    },
    "por": {
      "preferred_label": "cajado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma vara de madeira usada para caminhar, pastorear ou como símbolo de autoridade."
        }
      ]
    },
    "rus": {
      "preferred_label": "Посох",
      "descriptions": [
        {
          "source": "acai",
          "description": "Деревянная палка, используемая для ходьбы, выпаса скота или как символ власти."
        }
      ]
    },
    "spa": {
      "preferred_label": "vara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vara de madera utilizada para caminar, pastorear o como símbolo de autoridad."
        }
      ]
    },
    "swh": {
      "preferred_label": "Fimbo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fimbo ya mti inayotumiwa kwa ajili ya kutembea, kuchungia mifugo, au kama ishara ya mamlaka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "stik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela stik diwai bilong wokabaut, o bilong lukautim ol sipsip, o olsem mak bilong namba na biknem."
        }
      ]
    },
    "vie": {
      "preferred_label": "Gậy",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cây gậy bằng gỗ dùng để đi đường, chăn bầy hoặc làm biểu tượng của thẩm quyền."
        }
      ]
    },
    "zhs": {
      "preferred_label": "杖",
      "descriptions": [
        {
          "source": "acai",
          "description": "用于行走、放牧或用作权柄象征的木杖。"
        }
      ]
    },
    "zht": {
      "preferred_label": "杖",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種木製長棒，用於行走、放牧或作為權柄的象徵。"
        }
      ]
    }
  },
