  "localizations": {
    "eng": {
      "preferred_label": "Homer",
      "alternate_labels": [
        "Lethech"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Homer",
          "article": "realia:Homer",
          "description": "A unit of dry measurement in the Bible, equal to about 220 liters or 6 bushels."
        }
      ]
    },
    "apd": {
      "preferred_label": "حومر",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة لقياس الحبوب والمواد الجافة في الكتاب المقدس، بتعادل حوالي 220 لتر."
        }
      ]
    },
    "arb": {
      "preferred_label": "حُومَر",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَحدَةُ قِياسٍ لِلْمَوادِّ الجافَّةِ في الكِتابِ المُقدَّسِ، تُعادِلُ نَحوَ 220 لِترًا (أَو نَحوَ 6 كَيْلاتٍ)."
        }
      ]
    },
    "bis": {
      "preferred_label": "homa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan mak blong skelem ol drae samting long Baebol, we i klosap sem mak long 220 lita."
        }
      ]
    },
    "fra": {
      "preferred_label": "homer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une unité de mesure de capacité pour les matières sèches dans la Bible, équivalant à environ 220 litres ou 6 boisseaux."
        }
      ]
    },
    "hau": {
      "preferred_label": "Homer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ma’aunin hatsi a cikin Littafi Mai Tsarki, wanda ya kusan kai lita 220 ko buroshil 6."
        }
      ]
    },
    "hin": {
      "preferred_label": "होमेर",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाइबल में प्रयुक्त सूखे पदार्थों की माप की एक इकाई, जो लगभग 220 लीटर या 6 बुशेल के बराबर होती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Homa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe ọtụtụ ihe kpọrọ nkụ a na-eji na Baịbụl, nke ruru ihe dịka lita 220 maọbụ bushel 6."
        }
      ]
    },
    "ind": {
      "preferred_label": "homer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Satuan ukuran kering di dalam Alkitab, setara dengan sekitar 220 liter atau 6 gantang."
        }
      ]
    },
    "nep": {
      "preferred_label": "होमेर",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाइबलमा ठोस वस्तु नाप्ने एक एकाइ, जुन करिब २२० लिटर वा ६ बुसेल बराबर हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "ômer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma unidade de medida de capacidade para secos na Bíblia, equivalente a cerca de 220 litros ou 6 alqueires."
        }
      ]
    },
    "rus": {
      "preferred_label": "хомер",
      "descriptions": [
        {
          "source": "acai",
          "description": "Мера объема сыпучих тел в Библии, равная примерно 220 литрам или 6 бушелям."
        }
      ]
    },
    "spa": {
      "preferred_label": "homer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Unidad de medida para áridos en la Biblia, equivalente a unos 220 litros o 6 fanegas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Homeri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kipimo cha vitu vikavu katika Biblia, kinacholingana takriban na lita 220 au pishi 60 (busheli 6)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "homa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela mak bilong skelim ol drai samting long Baibel, inap olsem 220 lita."
        }
      ]
    },
    "vie": {
      "preferred_label": "hô-me",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một đơn vị đo lường đồ khô trong Kinh Thánh, bằng khoảng 220 lít hoặc 6 giạ (bushel)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "贺梅珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "圣经中的一种干料容量单位，约等于220升或6蒲式耳。"
        }
      ]
    },
    "zht": {
      "preferred_label": "賀梅珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "聖經中的一種乾量計量單位，約等於220公升或6蒲式耳。"
        }
      ]
    }
  },
