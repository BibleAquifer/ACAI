  "localizations": {
    "eng": {
      "preferred_label": "Robe",
      "alternate_labels": [
        "Mantle",
        "Cloak"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Robe",
          "article": "realia:Robe",
          "description": "A long garment reaching the ankles, usually made of wool, worn over a tunic."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبة",
      "descriptions": [
        {
          "source": "acai",
          "description": "توب طويل بيوصل للكعبين، غالباً مصنوع من الصوف، وبتلبس فوق القميص الداخلي."
        }
      ]
    },
    "arb": {
      "preferred_label": "جُبَّة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ثَوْبٌ طَوِيلٌ يَصِلُ إِلَى ٱلْكَعْبَيْنِ، يُصْنَعُ عَادَةً مِنَ ٱلصُّوفِ، وَيُلْبَسُ فَوْقَ ٱلْقَمِيصِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "longfala klos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan longfala klos we i kasem leg klosap long hil blong fut, we plante taem oli wokem long ul blong sipsip, we oli werem antap long wan nara klos."
        }
      ]
    },
    "fra": {
      "preferred_label": "robe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long vêtement descendant jusqu'aux chevilles, généralement en laine, porté par-dessus une tunique."
        }
      ]
    },
    "hau": {
      "preferred_label": "Doguwar riga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Doguwar riga mai kaiwa har ƙafafu, wadda yawanci aka yi ta da ulu, ana sakawa a saman taguwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "बागा",
      "descriptions": [
        {
          "source": "acai",
          "description": "टखनों तक पहुँचने वाला एक लम्बा वस्त्र, जो प्रायः ऊन का बना होता था और कुरते के ऊपर पहना जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Uwe mwụda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ogologo uwe na-eru n'ụkwụ, nke a na-ejikarị ajị anụ mee, nke a na-eyi n'elu uwe ime ma ọ bụ uwe elu."
        }
      ]
    },
    "ind": {
      "preferred_label": "jubah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pakaian panjang sampai ke mata kaki, biasanya terbuat dari wol, dikenakan di luar tunik."
        }
      ]
    },
    "nep": {
      "preferred_label": "अलखा",
      "descriptions": [
        {
          "source": "acai",
          "description": "भित्री वस्त्र (ट्युनिक) माथि लगाइने, गोलीगाँठोसम्म पुग्ने लामो वस्त्र, जुन प्रायः ऊनबाट बनेको हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "manto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma vestimenta comprida que chegava até os tornozelos, geralmente feita de lã, usada sobre a túnica."
        }
      ]
    },
    "rus": {
      "preferred_label": "Верхняя одежда",
      "descriptions": [
        {
          "source": "acai",
          "description": "Длинная одежда до щиколоток, обычно из шерсти, которую носили поверх хитона (туники)."
        }
      ]
    },
    "spa": {
      "preferred_label": "manto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prenda larga que llega hasta los tobillos, generalmente de lana, que se llevaba sobre una túnica."
        }
      ]
    },
    "swh": {
      "preferred_label": "Joho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vazi refu linalofika vifundoni, kwa kawaida lililotengenezwa kwa sufu, linalovaliwa juu ya joho la ndani au kanzu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "longpela klos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela longpela klos i save go daun inap long skru bilong lek, planti taim ol i wokim long gras bilong sipsip na pasim antap long narapela klos."
        }
      ]
    },
    "vie": {
      "preferred_label": "Áo choàng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại áo dài phủ đến mắt cá chân, thường làm bằng len, được mặc bên ngoài áo lót (áo trong)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "外袍",
      "descriptions": [
        {
          "source": "acai",
          "description": "长达脚踝的长袍，通常用羊毛制成，穿在里衣外面。"
        }
      ]
    },
    "zht": {
      "preferred_label": "外袍",
      "descriptions": [
        {
          "source": "acai",
          "description": "長達腳踝的長袍，通常由羊毛製成，穿在內袍之外。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
