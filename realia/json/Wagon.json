  "localizations": {
    "eng": {
      "preferred_label": "Wagon",
      "alternate_labels": [
        "Wheel",
        "Cart",
        "Chariot",
        "Carriage"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Wagon",
          "article": "realia:Wagon",
          "description": "A vehicle with two or four wheels, used for carrying goods or people, pulled by animals."
        }
      ]
    },
    "apd": {
      "preferred_label": "عجلة جر",
      "descriptions": [
        {
          "source": "acai",
          "description": "مركبة ليها عجلتين أو أربعة عجلات، بتُستخدم لنقل البضايع أو الناس، وبتجرها الحيوانات."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَجَلَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَرْكَبَةٌ ذَاتُ عَجَلَتَيْنِ أَوْ أَرْبَعِ عَجَلَاتٍ، تُسْتَخْدَمُ لِنَقْلِ البَضَائِعِ أَوِ النَّاسِ، وَتَجُرُّهَا الحَيَوَانَاتُ."
        }
      ]
    },
    "bis": {
      "preferred_label": "kat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan trak we i gat tu no fo wil, we ol anamol oli stap pulum, blong karem ol samting no ol man."
        }
      ]
    },
    "fra": {
      "preferred_label": "char",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un véhicule à deux ou quatre roues, utilisé pour transporter des marchandises ou des personnes, tiré par des animaux."
        }
      ]
    },
    "hau": {
      "preferred_label": "keken shanu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abin hawa mai ƙafafu biyu ko huɗu, da ake amfani da shi wajen ɗaukar kaya ko mutane, wanda dabbobi ke jawo shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "गाड़ी",
      "descriptions": [
        {
          "source": "acai",
          "description": "सामान या लोगों को ले जाने के लिए दो या चार पहियों वाला एक वाहन, जिसे जानवरों द्वारा खींचा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụgbọala dọkpụ dọkpụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụgbọ nwere ụkwụ abụọ ma ọ bụ anọ, nke a na-eji ebu ngwongwo ma ọ bụ mmadụ, nke ụmụ anụmanụ na-adọkpụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "kereta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kendaraan dengan dua atau empat roda, digunakan untuk mengangkut barang atau orang, ditarik oleh hewan."
        }
      ]
    },
    "nep": {
      "preferred_label": "गाडा",
      "descriptions": [
        {
          "source": "acai",
          "description": "सामान वा मानिसहरू ओसार्न प्रयोग गरिने, जनावरहरूले तान्‍ने, दुई वा चार पाङ्ग्रा भएको सवारी साधन।"
        }
      ]
    },
    "por": {
      "preferred_label": "carroça",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um veículo com duas ou quatro rodas, usado para transportar mercadorias ou pessoas, puxado por animais."
        }
      ]
    },
    "rus": {
      "preferred_label": "Повозка",
      "descriptions": [
        {
          "source": "acai",
          "description": "Двух- или четырехколесное транспортное средство, приводимое в движение животными и использовавшееся для перевозки грузов или людей."
        }
      ]
    },
    "spa": {
      "preferred_label": "carro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vehículo de dos o cuatro ruedas, utilizado para transportar personas o mercancías, tirado por animales."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gari la kukokotwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chombo cha magurudumu mawili au manne kinachotumiwa kubeba mizigo au watu, kikiwa kimekokotwa na wanyama."
        }
      ]
    },
    "tpi": {
      "preferred_label": "karis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela wilkar i gat tupela o fopela wil, bilong karim ol kago o manmeri, na ol animal i save pulim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Xe kéo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại xe có hai hoặc bốn bánh, do súc vật kéo, dùng để chở hàng hóa hoặc người."
        }
      ]
    },
    "zhs": {
      "preferred_label": "车辆",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种有两个或四个轮子、由牲畜拉动、用于运载货物或人员的车辆。"
        }
      ]
    },
    "zht": {
      "preferred_label": "車輛",
      "descriptions": [
        {
          "source": "acai",
          "description": "由牲畜牽引、有兩個或四個輪子用於載運貨物或人的車輛。"
        }
      ]
    }
  },
