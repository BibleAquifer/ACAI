      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Denarius",
          "article": "realia:Denarius",
          "description": "A Roman silver coin, often equal to a day’s wage for a common worker."
        }
      ]
    },
    "apd": {
      "preferred_label": "دينار",
      "descriptions": [
        {
          "source": "acai",
          "description": "عملة فضية رومانية، غالباً كانت بتعادل أجرة يوم لعامل عادي."
        }
      ]
    },
    "arb": {
      "preferred_label": "دينار",
      "descriptions": [
        {
          "source": "acai",
          "description": "عملة فضية رومانية، كانت غالبًا ما تعادل أجر يوم لعامل عادي."
        }
      ]
    },
    "bis": {
      "preferred_label": "denarias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan silva mane blong Rom, we plante taem pei blong wan dei blong wan man we i mekem wok i semmak long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "denier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pièce de monnaie romaine en argent, valant souvent le salaire journalier d'un simple ouvrier."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dinari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tsabar kudin azurfa ta Romawa, sau da yawa tana daidai da ladan aikin yini guda na ma'aikaci talaka."
        }
      ]
    },
    "hin": {
      "preferred_label": "दीनार",
      "descriptions": [
        {
          "source": "acai",
          "description": "रोमी चाँदी का एक सिक्का, जो प्रायः एक सामान्य मजदूर की एक दिन की मजदूरी के बराबर होता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "dinarịọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkpụrụ ego ọlaọcha nke ndị Rom, nke na-abụkarị ụgwọ ọrụ otu ụbọchị maka onye ọrụ nkịtị."
        }
      ]
    },
    "ind": {
      "preferred_label": "dinar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mata uang perak Romawi, sering kali setara dengan upah sehari bagi seorang pekerja biasa."
        }
      ]
    },
    "nep": {
      "preferred_label": "दिनार",
      "descriptions": [
        {
          "source": "acai",
          "description": "रोमी चाँदीको सिक्का, जुन प्रायः एक सामान्य कामदारको एक दिनको ज्याला बराबर हुन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "denário",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma moeda romana de prata, frequentemente equivalente ao salário de um dia de trabalho de um trabalhador comum."
        }
      ]
    },
    "rus": {
      "preferred_label": "Динарий",
      "descriptions": [
        {
          "source": "acai",
          "description": "Римская серебряная монета, часто равная дневной плате простого работника."
        }
      ]
    },
    "spa": {
      "preferred_label": "denario",
      "descriptions": [
        {
          "source": "acai",
          "description": "Moneda de plata romana, que a menudo equivalía al salario de un día de un trabajador común."
        }
      ]
    },
    "swh": {
      "preferred_label": "Dinari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarafu ya fedha ya Kiroma, mara nyingi iliyolingana na ujira wa siku moja wa kibarua wa kawaida."
        }
      ]
    },
    "tpi": {
      "preferred_label": "denarius",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela silva koin mani bilong Rom, planti taim em i pe bilong wanpela de wok bilong wanpela wokman."
        }
      ]
    },
    "vie": {
      "preferred_label": "đồng đê-na-ri-ơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một đồng tiền bạc La Mã, thường tương đương với tiền công một ngày của một người lao động phổ thông."
        }
      ]
    },
    "zhs": {
      "preferred_label": "得拿利",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种罗马银币，通常相当于一个普通工人一天的工资。"
        }
      ]
    },
    "zht": {
      "preferred_label": "得拿利",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種羅馬銀幣，通常相當於普通工人一天的工資。"
        }
      ]
    }
  },
