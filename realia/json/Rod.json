  "localizations": {
    "eng": {
      "preferred_label": "Rod",
      "alternate_labels": [
        "Stick",
        "Scepter",
        "Staff",
        "Sceptre",
        "Rulers Staff",
        "Club",
        "Rule",
        "Governing"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rod",
          "article": "realia:Rod",
          "description": "A stick usually made of wood or metal, often held by rulers or shepherds to symbolize authority and used for walking or various tasks."
        }
      ]
    },
    "apd": {
      "preferred_label": "عصاية",
      "descriptions": [
        {
          "source": "acai",
          "description": "عصاية مصنوعة عادةً من الخشب أو الحديد، كان بيمسكوها الحكام أو الرعاة كرمز للسلطة وبتستعمل للمشي أو مهمات تانية."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَضِيب",
      "descriptions": [
        {
          "source": "acai",
          "description": "عَصًا تُصْنَعُ عَادَةً مِنَ ٱلْخَشَبِ أَوْ ٱلْمَعْدِنِ، يَحْمِلُهَا ٱلْحُكَّامُ أَوْ ٱلرُّعَاةُ غَالِبًا رَمْزًا لِلسُّلْطَةِ، وَتُسْتَخْدَمُ لِلْمَشْيِ أَوْ لِمَهَامَّ مُتَنَوِّعَةٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "stik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan stik we plante taem oli wokem long wud no aean, we ol rula no ol man blong lukaot sipsip oli stap holem olsem saen blong paoa mo oli yusum blong wokbaot no mekem sam narafala wok."
        }
      ]
    },
    "fra": {
      "preferred_label": "verge",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bâton généralement en bois ou en métal, souvent tenu par des souverains ou des bergers pour symboliser l'autorité et utilisé pour la marche ou diverses tâches."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sanda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sanda da yawanci aka yi da itace ko ƙarfe, wadda sarakuna ko makiyaya suke riƙewa a matsayin alamar iko kuma ake amfani da ita don tafiya ko ayyuka dabam-dabam."
        }
      ]
    },
    "hin": {
      "preferred_label": "छड़ी",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः लकड़ी या धातु की बनी एक छड़ी, जिसे शासक या चरवाहे अधिकार के प्रतीक के रूप में रखते थे और जिसका उपयोग चलने या विभिन्न कार्यों के लिए किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mkpara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkpara a na-ejikarị osisi ma ọ bụ igwe mee, nke ndị na-achị achị ma ọ bụ ndị ọzụzụ atụrụ na-ejikarị egosi ikike, ma na-ejikwa ya aga ije ma ọ bụ rụọ ọrụ dị iche iche."
        }
      ]
    },
    "ind": {
      "preferred_label": "tongkat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tongkat yang biasanya terbuat dari kayu atau logam, sering dipegang oleh penguasa atau gembala untuk melambangkan otoritas dan digunakan untuk berjalan atau berbagai tugas."
        }
      ]
    },
    "nep": {
      "preferred_label": "छडी",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः काठ वा धातुबाट बनेको लट्ठी, जुन अधिकारको प्रतीकको रूपमा शासकहरू वा गोठालाहरूले लिने गर्थे र हिँड्न वा विभिन्न कामका लागि प्रयोग गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "cetro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma vara geralmente feita de madeira ou metal, muitas vezes segurada por governantes ou pastores para simbolizar autoridade e usada para caminhar ou para várias tarefas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Жезл",
      "descriptions": [
        {
          "source": "acai",
          "description": "Палка, обычно сделанная из дерева или металла, которую часто держали правители или пастухи как символ власти и использовали для ходьбы или различных задач."
        }
      ]
    },
    "spa": {
      "preferred_label": "vara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vara hecha generalmente de madera o metal, a menudo sostenida por gobernantes o pastores para simbolizar autoridad y usada para caminar o para diversas tareas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Fimbo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fimbo ambayo kwa kawaida hutengenezwa kwa mti au chuma, mara nyingi hushikwa na watawala au wachungaji kuashiria mamlaka na hutumiwa kwa kutembelea au shughuli mbalimbali."
        }
      ]
    },
    "tpi": {
      "preferred_label": "stik bilong king",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela stik ol i wokim long diwai o aian, planti taim ol hetman o wasman bilong sipsip i save holim olsem mak bilong namba na biknem, na ol i save yusim tu bilong wokabaut o mekim ol kain kain wok."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây gậy",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cây gậy thường làm bằng gỗ hoặc kim loại, thường được các bậc cầm quyền hoặc người chăn chiên cầm để biểu trưng cho thẩm quyền và dùng để chống đi hoặc làm các công việc khác nhau."
        }
      ]
    },
    "zhs": {
      "preferred_label": "杖",
      "descriptions": [
        {
          "source": "acai",
          "description": "通常由木头或金属制成的棍杖，常由统治者或牧人手持以象征权柄，也用于行走或各种用途。"
        }
      ]
    },
    "zht": {
      "preferred_label": "杖",
      "descriptions": [
        {
          "source": "acai",
          "description": "通常由木頭或金屬製成的棍棒，常由統治者或牧羊人手持以象徵權柄，並用於行走或各種工作。"
        }
      ]
    }
  },
