  "localizations": {
    "eng": {
      "preferred_label": "Threshing Floor",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Threshing Floor",
          "article": "realia:ThreshingFloor",
          "description": "A level, circular area where people threshed grain, often located near fields and exposed to the breeze."
        }
      ]
    },
    "apd": {
      "preferred_label": "ميداس",
      "descriptions": [
        {
          "source": "acai",
          "description": "مكان مستوي ومدور الناس بيدرسوا فيه القمح أو الحبوب، وغالباً بيكون قريب من المزارع ومكشوف للهواء."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَيْدَر",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَوْضِعٌ مُسْتَوٍ وَمُسْتَدِيرٌ يُدْرَسُ فِيهِ ٱلْحَبُّ، غَالِبًا مَا يَكُونُ قَرِيبًا مِنَ ٱلْحُقُولِ وَمُعَرَّضًا لِلنَّسِيمِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "ples blong klinim wit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan flat ples we i raon we ol man oli stap klinim wit o gredjid long hem, we plante taem i stap klosap long garen mo long ples we win i blu long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "aire de battage",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une surface nivelée et circulaire où l'on battait le grain, souvent située près des champs et exposée au vent."
        }
      ]
    },
    "hau": {
      "preferred_label": "Masussuka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fili mai faɗi kuma lebur inda mutane suke sussuka hatsi, sau da yawa a kusa da gonaki kuma inda iska take kaɗawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "खलिहान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक समतल, गोल क्षेत्र जहाँ लोग अनाज की मड़ाई या गहाई करते थे, जो प्रायः खेतों के पास और खुली हवादार जगह पर स्थित होता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebe ịzọcha ọka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ebe dị larịị ma dị okirikiri ebe ndị mmadụ na-azọcha mkpụrụ ọka, nke na-adịkarị nso nʼubi ma na-anọkwa nʼebe ikuku na-efe."
        }
      ]
    },
    "ind": {
      "preferred_label": "tempat pengirikan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suatu area datar dan melingkar tempat orang mengirik biji-bijian, sering kali terletak di dekat ladang dan terbuka terhadap hembusan angin."
        }
      ]
    },
    "nep": {
      "preferred_label": "खला",
      "descriptions": [
        {
          "source": "acai",
          "description": "अन्न दाइँ गरिने समथर, गोलाकार ठाउँ, जो प्रायः खेतबारी नजिक र हावा चल्ने ठाउँमा हुन्थ्यो ।"
        }
      ]
    },
    "por": {
      "preferred_label": "eira",
      "descriptions": [
        {
          "source": "acai",
          "description": "Área plana e circular onde se debulhavam cereais, frequentemente situada perto de campos e exposta ao vento."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гумно",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ровная круглая площадка, где молотили зерно, часто располагавшаяся возле полей и продуваемая ветром."
        }
      ]
    },
    "spa": {
      "preferred_label": "era",
      "descriptions": [
        {
          "source": "acai",
          "description": "Área circular y nivelada donde la gente trillaba el grano, a menudo situada cerca de los campos y expuesta a la brisa."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sakafu ya kupuria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eneo tambarare, la mviringo ambapo watu walipura nafaka, mara nyingi likiwa karibu na mashamba na wazi kupata upepo mwanana."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ples bilong brukim wit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela stretpela, raunpela graun we ol manmeri i save brukim skin bilong wit na ol narapela kain kaikai, em i save stap klostu long gaden we win i save blow."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sân đập lúa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một khoảng đất bằng phẳng, hình tròn, nơi người ta đập lúa, thường nằm gần đồng ruộng và đón gió."
        }
      ]
    },
    "zhs": {
      "preferred_label": "禾场",
      "descriptions": [
        {
          "source": "acai",
          "description": "人们用来打谷的一块平坦圆形场地，通常位于田地附近且通风良好。"
        }
      ]
    },
    "zht": {
      "preferred_label": "禾場",
      "descriptions": [
        {
          "source": "acai",
          "description": "人們打穀的平坦圓形場地，通常位於田地附近且通風良好。"
        }
      ]
    }
  },
