  "localizations": {
    "eng": {
      "preferred_label": "Door",
      "alternate_labels": [
        "Gate"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Door",
          "article": "realia:Door",
          "description": "A wooden entry on the outside of a house or building, often referred to as a gate."
        }
      ]
    },
    "apd": {
      "preferred_label": "باب",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدخل خشب في الجزء الخارجي من بيت أو مبنى، وغالباً بيتقال عليه بوابة."
        }
      ]
    },
    "arb": {
      "preferred_label": "باب",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدخل خشبي خارج منزل أو مبنى، وغالبًا ما يُشار إليه بالبوابة."
        }
      ]
    },
    "bis": {
      "preferred_label": "doa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan eni samting we oli wokem long wud long aotsaed blong haos o bilding blong gotru long hem, we plante taem oli kolem get tu."
        }
      ]
    },
    "fra": {
      "preferred_label": "porte",
      "descriptions": [
        {
          "source": "acai",
          "description": "Entrée en bois à l'extérieur d'une maison ou d'un bâtiment, souvent désignée comme une porte."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙofa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mashigar katako a wajen gida ko gini, wadda sau da yawa ake kira kofa."
        }
      ]
    },
    "hin": {
      "preferred_label": "द्वार",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी घर या भवन के बाहर लकड़ी का एक प्रवेश-मार्ग, जिसे प्रायः फाटक भी कहा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ọnụ ụzọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụzọ e ji osisi mee nʼèzí ụlọ ma ọ bụ ihe owuwu, nke a na-akpọkarị ọnụ ụzọ ama."
        }
      ]
    },
    "ind": {
      "preferred_label": "pintu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jalan masuk berbahan kayu di bagian luar rumah atau bangunan, sering kali disebut sebagai gerbang atau pintu."
        }
      ]
    },
    "nep": {
      "preferred_label": "ढोका",
      "descriptions": [
        {
          "source": "acai",
          "description": "घर वा भवनको बाहिरी भागमा हुने काठको प्रवेशद्वार, जसलाई प्रायः फाटक पनि भनिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "porta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma entrada de madeira na parte externa de uma casa ou edifício, frequentemente chamada de portão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дверь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Деревянный проем или створка для входа снаружи дома или здания, часто называемая также воротами."
        }
      ]
    },
    "spa": {
      "preferred_label": "puerta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Entrada de madera en el exterior de una casa o edificio, a menudo llamada portón o puerta."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mlango",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kifaa cha kuingilia kilichotengenezwa kwa mbao kwenye sehemu ya nje ya nyumba au jengo, mara nyingi kikijulikana pia kama lango."
        }
      ]
    },
    "tpi": {
      "preferred_label": "dua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela dua ol i wokim long diwai bilong kam insait o go ausait long haus o bikpela haus, planti taim ol i kolim tu olsem get."
        }
      ]
    },
    "vie": {
      "preferred_label": "cửa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lối vào bằng gỗ ở bên ngoài một ngôi nhà hoặc công trình kiến trúc, thường được gọi là cổng hoặc cửa."
        }
      ]
    },
    "zhs": {
      "preferred_label": "门",
      "descriptions": [
        {
          "source": "acai",
          "description": "房屋或建筑物外侧的木制入口，通常也被称为门。"
        }
      ]
    },
    "zht": {
      "preferred_label": "門",
      "descriptions": [
        {
          "source": "acai",
          "description": "房屋或建築物外側的木製入口，通常也稱為門或閘門。"
        }
      ]
    }
  },
