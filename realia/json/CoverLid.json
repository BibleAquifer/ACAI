  "localizations": {
    "eng": {
      "preferred_label": "Cover Lid",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Cover Lid",
          "article": "realia:CoverLid",
          "description": "A flat, gold object with two winged figures on top, used to cover the Covenant Box and associated with atonement rituals."
        }
      ]
    },
    "apd": {
      "preferred_label": "غطا الكفارة",
      "descriptions": [
        {
          "source": "acai",
          "description": "غطا مسطح من دهب خالص فوقيهو تمثالين لكائنات مجنحة (كاروبيم)، بيستعملوهو لغطا تابوت العهد ومربوط بطقوس الكفارة."
        }
      ]
    },
    "arb": {
      "preferred_label": "غِطاءُ ٱلتَّكْفِيرِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "غطاء ذهبي مستوٍ يعلوه تمثالان مجنحان، يُستخدم لتغطية تابوت العهد ويرتبط بطقوس الكفارة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Lid blong Bokis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan flat gol aelan we i gat tu pija blong anjel we i gat wing antap long hem, we oli yusum blong kavremap Bokis blong Kontrak mo i joen wetem ol kastom blong tekemaot sin."
        }
      ]
    },
    "fra": {
      "preferred_label": "propitiatoire",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un objet plat en or surmonté de deux figures ailées, utilisé pour recouvrir l’arche de l’alliance et associé aux rituels d’expiation."
        }
      ]
    },
    "hau": {
      "preferred_label": "Murfin kafara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani fafe mai laushi da aka yi da zinariya wanda yake da siffofi biyu masu fuka-fuki a sama, ana amfani da shi wajen rufe Akwatin Alkawari kuma yana da alaƙa da ibadodin kafara."
        }
      ]
    },
    "hin": {
      "preferred_label": "प्रायश्चित का ढकना",
      "descriptions": [
        {
          "source": "acai",
          "description": "सोने की एक चपटी वस्तु जिसके ऊपर दो पंखदार आकृतियाँ थीं, जो वाचा के संदूक को ढकने के काम आती थी और प्रायश्चित के अनुष्ठानों से जुड़ी थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe mkpuchi mmehie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe dị larịị e ji ọlaedo mee nke nwere ihe oyiyi abụọ nwere nku nʼelu ya, nke e ji ekpuchi Igbe Ọgbụgba Ndụ ma na-ejikọ ya na emume mkpuchi mmehie."
        }
      ]
    },
    "ind": {
      "preferred_label": "tutup pendamaian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Benda emas datar dengan dua sosok bersayap di atasnya, digunakan untuk menutupi Peti Perjanjian dan terkait dengan ritual pendamaian."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रायश्चित्तको ढकनी",
      "descriptions": [
        {
          "source": "acai",
          "description": "माथि दुई पखेटा भएका प्राणीहरू भएको सुनको समतल वस्तु, जुन करारको सन्दुक ढाक्न प्रयोग गरिन्थ्यो र प्रायश्चित्तका विधिहरूसँग सम्बन्धित थियो।"
        }
      ]
    },
    "por": {
      "preferred_label": "propiciatório",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um objeto plano de ouro com duas figuras aladas em cima, usado para cobrir a Arca da Aliança e associado a rituais de expiação."
        }
      ]
    },
    "rus": {
      "preferred_label": "Крышка ковчега",
      "descriptions": [
        {
          "source": "acai",
          "description": "Плоское золотое изделие с двумя крылатыми фигурами наверху, служившее крышкой Ковчега завета и связанное с обрядами искупления."
        }
      ]
    },
    "spa": {
      "preferred_label": "propiciatorio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Objeto plano de oro con dos figuras aladas encima, utilizado para cubrir el Arca del Pacto y asociado con los rituales de expiación."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kifuniko cha upatanisho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu bapa cha dhahabu chenye sanamu mbili zenye mabawa juu yake, kilichotumiwa kufunika Sanduku la Agano na kuhusishwa na taratibu za upatanisho."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ai bilong Bokis Kontrak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela flet gol samting wantaim piksa bilong tupela ensel i gat wing antap long en, bilong karamapim Bokis Kontrak na ol i save yusim long ol wok bilong lusim sin."
        }
      ]
    },
    "vie": {
      "preferred_label": "nắp thi ân",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vật thể phẳng bằng vàng có hai hình tượng có cánh ở trên, dùng để đậy Hòm Giao Ước và gắn liền với các nghi thức chuộc tội."
        }
      ]
    },
    "zhs": {
      "preferred_label": "施恩座",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种上方带有两个带翼受造物形象的扁平纯金物件，用来遮盖约柜，并与赎罪礼仪相关。"
        }
      ]
    },
    "zht": {
      "preferred_label": "施恩座",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種頂部有兩個帶翼塑像的扁平金製物件，用來遮蓋約櫃，並與贖罪儀式相關。"
        }
      ]
    }
  },
