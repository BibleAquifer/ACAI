      "preferred_label": "Bath",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Bath",
          "article": "realia:Bath",
          "description": "A unit of liquid measure in ancient times, roughly equal to 20 to 40 liters."
        }
      ]
    },
    "apd": {
      "preferred_label": "بث",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة لقياس السوايل في الزمان القديم، بتعادل حوالي من 20 لـ 40 لتر."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَثّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَحْدَةُ قِيَاسٍ لِلسَّوَائِلِ فِي ٱلْعُصُورِ ٱلْقَدِيمَةِ، تُعَادِلُ تَقْرِيبًا مِنْ 20 إِلَى 40 لِتْرًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan mak blong skelem likwid long taem bifo, we i samwe long 20 kasem 40 lita."
        }
      ]
    },
    "fra": {
      "preferred_label": "bath",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une unité de mesure des liquides dans l'Antiquité, équivalant environ à 20 à 40 litres."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ma'aunin abubuwa masu ruwa a zamanin dā, wanda ya kai kusan lita 20 zuwa 40."
        }
      ]
    },
    "hin": {
      "preferred_label": "बत",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्राचीन काल में तरल पदार्थ मापने की एक इकाई, जो लगभग 20 से 40 लीटर के बराबर होती थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Baf",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe ọtụtụ mmiri nʼoge ochie, nke ha ihe dị ka lita 20 ruo 40."
        }
      ]
    },
    "ind": {
      "preferred_label": "bat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Satuan ukuran cairan pada zaman kuno, kira-kira setara dengan 20 hingga 40 liter."
        }
      ]
    },
    "nep": {
      "preferred_label": "बाथ",
      "descriptions": [
        {
          "source": "acai",
          "description": "पुरातन समयको तरल पदार्थ नाप्‍ने एक एकाइ, जुन लगभग २० देखि ४० लिटर बराबर हुन्थ्यो।"
