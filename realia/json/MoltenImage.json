  "localizations": {
    "eng": {
      "preferred_label": "Molten Image",
      "alternate_labels": [
        "Male Calf",
        "Female Calf",
        "Heifer"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Molten Image",
          "article": "realia:MoltenImage",
          "description": "An idol made by pouring melted metal into a mold, often used in the Bible in forbidden worship."
        }
      ]
    },
    "apd": {
      "preferred_label": "تمثال مسبوك",
      "descriptions": [
        {
          "source": "acai",
          "description": "صنم معمول بصب المعدن المذاب في قالب، وكان بيستعمل كتيرين في الكتاب المقدس في العبادة الممنوعة."
        }
      ]
    },
    "arb": {
      "preferred_label": "تمثال مسبوك",
      "descriptions": [
        {
          "source": "acai",
          "description": "صنم يُصنع بصبّ المعدن المنصهر في قالب، وكان يُستخدم غالبًا في الكتاب المقدس في العبادة المحرمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "aedol we oli kafsaedem long mol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan aedol we oli wokem taem oli kafsaedem kopa, gol no silva we i ronaot i go long wan mol, we oli yusum plante taem long Baebol long wosip we i tabu."
        }
      ]
    },
    "fra": {
      "preferred_label": "image en fonte",
      "descriptions": [
        {
          "source": "acai",
          "description": "Idole fabriquée en versant du métal fondu dans un moule, souvent utilisée dans la Bible dans le cadre de cultes interdits."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zubin gunki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gunkin da aka yi ta hanyar zuba narkakken ƙarfe a cikin siffar zubi, wanda sau da yawa a cikin Littafi Mai Tsarki ake amfani da shi wajen bautar gumaka da aka haramta."
        }
      ]
    },
    "hin": {
      "preferred_label": "ढाली हुई मूर्ति",
      "descriptions": [
        {
          "source": "acai",
          "description": "पिघली हुई धातु को साँचे में ढालकर बनाई गई एक मूर्ति, जिसका उपयोग अक्सर बाइबिल में वर्जित उपासना में किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe a kpụrụ akpụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Arụsị e mere site nʼịwụnye ọla agbazere agbaze nʼime ihe e ji akpụ ya, nke a na-ejikarị eme ofufe a machibidoro iwu na Baịbụl."
        }
      ]
    },
    "ind": {
      "preferred_label": "patung tuangan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Berhala yang dibuat dengan menuangkan logam cair ke dalam cetakan, sering kali digunakan dalam Alkitab untuk penyembahan terlarang."
        }
      ]
    },
    "nep": {
      "preferred_label": "ढलौटे मूर्ति",
      "descriptions": [
        {
          "source": "acai",
          "description": "पग्लिएको धातुलाई साँचोमा खन्याएर बनाइएको मूर्ति, जुन बाइबलमा प्रायः निषेधित आराधनाहरूमा प्रयोग गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "Imagem de metal fundido",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um ídolo feito ao derramar metal fundido em um molde, frequentemente usado na Bíblia em cultos proibidos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Литой истукан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Идол, изготовленный путем заливки расплавленного металла в форму; в Библии часто использовался в запретном поклонении."
        }
      ]
    },
    "spa": {
      "preferred_label": "imagen de metal fundido",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ídolo hecho al verter metal fundido en un molde, a menudo utilizado en la Biblia en cultos prohibidos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sanamu ya kusubu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sanamu iliyotengenezwa kwa kumimina chuma kilichoyeyushwa kwenye kalibu, mara nyingi ikitumiwa katika Biblia kwa ibada iliyokatazwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Piksa kapa ol i bin kukim na wokim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela giaman god ol i wokim long kapsaitim hatpela kapa o gol samting i go insait long hul o mol, na Baibel i tok i tambu long lotuim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tượng đúc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một hình tượng được làm bằng cách đổ kim loại nấu chảy vào khuôn, thường được dùng trong sự thờ phượng bị cấm đoán trong Kinh Thánh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "铸造的偶像",
      "descriptions": [
        {
          "source": "acai",
          "description": "将融化的金属倒入模具铸成的偶像，在圣经中常用于被禁止的崇拜中。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鑄成的像",
      "descriptions": [
        {
          "source": "acai",
          "description": "將熔化的金屬倒入模具製成的偶像，在聖經中常用於被禁止的敬拜。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
