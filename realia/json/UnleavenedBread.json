  "localizations": {
    "eng": {
      "preferred_label": "Unleavened Bread",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Unleavened Bread",
          "article": "realia:UnleavenedBread",
          "description": "Thin, cracker-like bread made without yeast. It was ordered by God to be used in certain Hebrew feasts. "
        }
      ]
    },
    "apd": {
      "preferred_label": "فطير",
      "descriptions": [
        {
          "source": "acai",
          "description": "عيش رقيق زي البسكويت معمول بدون خميرة. الله أمر إنه يُستخدم في أعياد عبرية معينة."
        }
      ]
    },
    "arb": {
      "preferred_label": "فَطِير",
      "descriptions": [
        {
          "source": "acai",
          "description": "خُبْزٌ رَقِيقٌ يُشْبِهُ الرُّقَاقَ يُصْنَعُ بِدُونِ خَمِيرَةٍ. أَمَرَ اللهُ بِاسْتِخْدَامِهِ فِي أَعْيَادٍ عِبْرَانِيَّةٍ مُعَيَّنَةٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "bred we i no gat is long hem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tin bred we oli wokem we i no gat is long hem. God i komandem se ol man Isrel oli mas kakae bred ya long sam lafet blong olgeta."
        }
      ]
    },
    "fra": {
      "preferred_label": "pain sans levain",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pain fin sans levain semblable à une galette. Dieu a ordonné de l'utiliser lors de certaines fêtes hébraïques."
        }
      ]
    },
    "hau": {
      "preferred_label": "burodi marar yisti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Siririn burodi mai kama da biskit wanda aka yi ba tare da yisti ba. Allah ya ba da umarnin a yi amfani da shi a wasu bukukuwan Ibraniyawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "अख़मीरी रोटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिना ख़मीर (यीस्ट) के बनाई जाने वाली पतली, पापड़ जैसी रोटी। परमेश्वर ने कुछ इब्रानी पर्वों में इसके उपयोग की आज्ञा दी थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Achịcha na-ekoghị eko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Achịcha dị gịrịgịrị, nke na-akpọ nkụ e mepụtara nʼejighị ihe na-eko achịcha. Chineke nyere iwu ka a na-eji ya eme ihe nʼememme ndị Hibru ụfọdụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "roti tidak beragi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roti tipis menyerupai biskuit yang dibuat tanpa ragi. Roti ini diperintahkan oleh Allah untuk digunakan dalam perayaan-perayaan Ibrani tertentu."
        }
      ]
    },
    "nep": {
      "preferred_label": "अखमिरी रोटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "खमीर नहाली बनाइने पातलो, कुरुमकुरुम हुने रोटी। परमेश्‍वरले निश्चित हिब्रू चाडहरूमा यसको प्रयोग गर्न आज्ञा दिनुभएको थियो।"
        }
      ]
    },
    "por": {
      "preferred_label": "pão sem fermento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pão fino, semelhante a uma bolacha, feito sem fermento. Foi ordenado por Deus para ser usado em certas festas hebraicas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Пресный хлеб",
      "descriptions": [
        {
          "source": "acai",
          "description": "Тонкий, похожий на крекер хлеб, приготовленный без закваски (дрожжей). По повелению Бога использовался во время определенных еврейских праздников."
        }
      ]
    },
    "spa": {
      "preferred_label": "pan sin levadura",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pan delgado y crujiente hecho sin levadura. Dios ordenó usarlo en ciertas festividades hebreas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mkate usiotiwa chachu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkate mwembamba usiochachwa uliotengenezwa bila hamira. Uliamriwa na Mungu kutumika katika sikukuu fulani za Kiebrania."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bret i no gat yis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bred i slek na i no gat yis. God i bin tokim ol long mekim wok long en long sampela bikpela de bilong ol Hibru."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bánh không men",
      "descriptions": [
        {
          "source": "acai",
          "description": "Loại bánh mỏng và giòn làm không dùng men. Đức Chúa Trời truyền lệnh dùng bánh này trong một số ngày lễ của người Hê-bơ-rơ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "无酵饼",
      "descriptions": [
        {
          "source": "acai",
          "description": "不加酵母制作的薄脆饼。上帝吩咐在特定的希伯来节期中食用。"
        }
      ]
    },
    "zht": {
      "preferred_label": "無酵餅",
      "descriptions": [
        {
          "source": "acai",
          "description": "不加酵母製成的薄脆餅狀餅食。上帝吩咐在希伯來人的某些節期中使用。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
