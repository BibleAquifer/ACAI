          "gloss": "Embroidered Cloth",
          "article": "realia:EmbroideredCloth",
          "description": "Cloth with beautiful patterns sewn into it by hand, often considered valuable."
        }
      ]
    },
    "apd": {
      "preferred_label": "قماش مطرز",
      "descriptions": [
        {
          "source": "acai",
          "description": "قماش مطرّز باليد بنقوش جميلة، وغالباً ما كان يعتبر ثميناً."
        }
      ]
    },
    "arb": {
      "preferred_label": "قماش مطرّز",
      "descriptions": [
        {
          "source": "acai",
          "description": "قماش حِيكت فيه نقوش جميلة يدويًا، وغالبًا ما كان ذا قيمة عالية."
        }
      ]
    },
    "bis": {
      "preferred_label": "kaliko we i gat pija long hem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kaliko we man i somap ol naesfala pija long hem long han, we plante taem ol man oli luk se i gat bigfala praes blong hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "étoffe brodée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Étoffe ornée à la main de beaux motifs cousus, souvent considérée comme précieuse."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tufafi mai ado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tufafin da aka yi wa ado da zane-zane masu kyau da hannu, wanda galibi ake ɗaukarsa mai daraja."
        }
      ]
    },
    "hin": {
      "preferred_label": "कढ़ाईदार कपड़ा",
      "descriptions": [
        {
          "source": "acai",
          "description": "हाथ से सुंदर नमूनों की कढ़ाई किया हुआ कपड़ा, जिसे अक्सर मूल्यवान माना जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "akwa a kpara ihe ịchọ mma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Akwa e ji aka kpaa oyiyi ma ọ bụ ihe ịchọ mma mara mma nʼime ya, nke a na-ewerekarị dị ka ihe dị oke ọnụ ahịa."
        }
      ]
    },
    "ind": {
      "preferred_label": "kain sulaman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kain dengan pola-pola indah yang disulam dengan tangan, sering kali dianggap berharga."
        }
      ]
    },
    "nep": {
      "preferred_label": "बुट्टादार कपडा",
      "descriptions": [
        {
          "source": "acai",
          "description": "हातले सुन्दर बुट्टा भरिएको कपडा, जसलाई प्रायः बहुमूल्य मानिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "tecido bordado",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tecido com belos padrões bordados à mão, frequentemente considerado valioso."
        }
      ]
    },
    "rus": {
      "preferred_label": "Узорчатая ткань",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ткань с красивыми узорами, вышитыми вручную, часто считавшаяся ценной."
        }
      ]
    },
    "spa": {
      "preferred_label": "tela bordada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tela con hermosos patrones cosidos a mano, a menudo considerada valiosa."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kitambaa kilichotariziwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitambaa chenye mifumo mizuri iliyoshonwa kwa mkono, mara nyingi huonwa kuwa chenye thamani kubwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "laplap i gat bilas ol i samapim long en",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela laplap ol i samapim naispela bilas long en long han, na em i samting i gat bikpela pe o bikpela nem."
        }
      ]
    },
    "vie": {
      "preferred_label": "vải thêu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vải có thêu các hoa văn đẹp mắt bằng tay, thường được coi là có giá trị."
        }
      ]
    },
    "zhs": {
      "preferred_label": "绣花布",
      "descriptions": [
        {
          "source": "acai",
          "description": "用手工绣有精美图案的布料，通常被视为贵重物品。"
        }
      ]
    },
    "zht": {
      "preferred_label": "繡花布",
      "descriptions": [
        {
          "source": "acai",
          "description": "用手工刺繡精美圖案的布料，常被視為貴重之物。"
        }
      ]
    }
  },
