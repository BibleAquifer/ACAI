  "localizations": {
    "eng": {
      "preferred_label": "Graven Image",
      "alternate_labels": [
        "Stone Image"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Graven Image",
          "article": "realia:GravenImage",
          "description": "A carved representation of a person, animal, or thing, often made from wood or stone. In the Bible it was used in unauthorized or idolatrous worship."
        }
      ]
    },
    "apd": {
      "preferred_label": "تمثال منحوت",
      "descriptions": [
        {
          "source": "acai",
          "description": "تمثال منحوت بيمثل زول أو حيوان أو حاجة، في الغالب مصنوع من الخشب أو الحجر. استُعمل في الكتاب المقدس في العبادة غير المشروعة أو عبادة الأوثان."
        }
      ]
    },
    "arb": {
      "preferred_label": "تِمْثالٌ مَنْحُوتٌ",
      "descriptions": [
        {
          "source": "acai",
          "description": "تَمْثِيلٌ مَنْحُوتٌ لِإِنْسانٍ أَوْ حَيَوانٍ أَوْ شَيْءٍ، غالِبًا ما يُصْنَعُ مِنَ الخَشَبِ أَوِ الحَجَرِ. وكانَ يُسْتَخْدَمُ في الكِتابِ المُقَدَّسِ في العِبادَةِ غَيْرِ المَشْرُوعَةِ أَوِ الوَثَنِيَّةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "aedol we oli katem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kaving blong pija blong man, anamol, no narafala samting, we plante taem oli wokem long wud no long ston. Long Baebol oli bin yusum blong wosipim giaman god."
        }
      ]
    },
    "fra": {
      "preferred_label": "image taillée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Représentation sculptée d'une personne, d'un animal ou d'une chose, souvent faite de bois ou de pierre. Dans la Bible, elle était utilisée dans le cadre d'un culte non autorisé ou idolâtre."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sassaƙaƙƙen gunki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sassaƙaƙƙiyar sura ta mutum, dabba, ko wani abu, sau da yawa da aka yi da itace ko dutse. A cikin Littafi Mai Tsarki an yi amfani da ita wajen bautar gumaka ko bautar da ba a ba da izini ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "खुदी हुई मूर्ति",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी व्यक्ति, पशु या वस्तु की तराशी गई आकृति, जो अक्सर लकड़ी या पत्थर से बनाई जाती थी। बाइबल में इसका उपयोग अनाधिकृत या मूर्तिपूजा के लिए किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "oyiyi a pịrị apị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oyiyi a pịrị apị nke na-anọchi anya mmadụ, anụmanụ, ma ọ bụ ihe, nke a na-ejikarị osisi ma ọ bụ nkume mee. Nʼime Baịbụl, a na-eji ya eme ofufe na-ekwesịghị ekwesị ma ọ bụ nke ikpere arụsị."
        }
      ]
    },
    "ind": {
      "preferred_label": "patung pahatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ukiran yang menggambarkan manusia, binatang, atau benda, yang sering kali terbuat dari kayu atau batu. Di dalam Alkitab benda ini digunakan dalam ibadah terlarang atau penyembahan berhala."
        }
      ]
    },
    "nep": {
      "preferred_label": "खोपिएको मूर्ति",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै व्यक्ति, जनावर वा वस्तुको खोपिएको आकृति, जुन प्रायः काठ वा ढुङ्गाबाट बनाइएको हुन्थ्यो। बाइबलमा यसलाई अनाधिकृत वा मूर्तिपूजाको रूपमा प्रयोग गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "imagem esculpida",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma representação esculpida de uma pessoa, animal ou objeto, frequentemente feita de madeira ou pedra. Na Bíblia, era usada no culto não autorizado ou idólatra."
        }
      ]
    },
    "rus": {
      "preferred_label": "изваяние",
      "descriptions": [
        {
          "source": "acai",
          "description": "Высеченное или резное изображение человека, животного или предмета, часто сделанное из дерева или камня. В Библии использовалось в неугодном Богу или идолопоклонническом поклонении."
        }
      ]
    },
    "spa": {
      "preferred_label": "imagen tallada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Representación tallada de una persona, animal o cosa, a menudo hecha de madera o piedra. En la Biblia se utilizaba en el culto no autorizado o idólatra."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kinyago cha kuchonga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kielelezo cha kuchongwa cha mtu, mnyama, au kitu, mara nyingi kikitengenezwa kwa mti au jiwe. Katika Biblia kilitumiwa katika ibada isiyoidhinishwa au ya sanamu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "piksa bilong giaman god",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela piksa ol i katim long diwai o ston bilong makim wanpela man, animal, o samting. Long Baibel ol i bin yusim dispela long pasin lotu nogut o lotuim ol giaman god."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tượng chạm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một hình tượng chạm khắc một người, con vật hoặc đồ vật, thường làm từ gỗ hoặc đá. Trong Kinh Thánh, nó được dùng trong sự thờ phượng trái phép hoặc thờ thần tượng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "雕刻的偶像",
      "descriptions": [
        {
          "source": "acai",
          "description": "雕刻成的人、动物或事物的形象，通常用木头或石头制成。在圣经中，用于未经许可的崇拜或偶像崇拜。"
        }
      ]
    },
    "zht": {
      "preferred_label": "雕刻的偶像",
      "descriptions": [
        {
          "source": "acai",
          "description": "雕刻的人、動物或物體的像，通常由木頭或石頭製成。在聖經中，它被用於未經認可或拜偶像的敬拜中。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
  "non_biblical": false,
