          "gloss": "Doorpost",
          "article": "realia:Doorpost",
          "description": "The upright part of a door frame marking the entrance to a building, sometimes including the horizontal elements."
        }
      ]
    },
    "apd": {
      "preferred_label": "قائمة الباب",
      "descriptions": [
        {
          "source": "acai",
          "description": "الجزء القائم من إطار الباب البيحدد مدخل المبنى، وساعات بيشمل الأجزاء الأفقية كمان."
        }
      ]
    },
    "arb": {
      "preferred_label": "قائمة الباب",
      "descriptions": [
        {
          "source": "acai",
          "description": "الجزء العمودي من إطار الباب الذي يحدد مدخل المبنى، ويشمل أحياناً العناصر الأفقية."
        }
      ]
    },
    "bis": {
      "preferred_label": "pos blong doa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan long tufala pos blong doa we i stanap blong holem frem blong doa long wan bilding, mo samtaem i save kavremap ol narafala haf tu we i stap antap long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "poteau de porte",
      "descriptions": [
        {
          "source": "acai",
          "description": "Partie verticale du chambranle d'une porte marquant l'entrée d'un bâtiment, incluant parfois les éléments horizontaux."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dogarin ƙofa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tsaye ɓangaren ƙirar ƙofa mai nuna hanyar shiga gini, wani lokaci har da sassan da suke a kwance."
        }
      ]
    },
    "hin": {
      "preferred_label": "चौखट की बाजू",
      "descriptions": [
        {
          "source": "acai",
          "description": "किसी भवन के प्रवेश द्वार को चिह्नित करने वाले दरवाज़े के चौखट का खड़ा भाग, जिसमें कभी-कभी क्षैतिज तत्व भी शामिल होते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ibo ọnụ ụzọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Akụkụ kwụ ọtọ nke ọnụ ụzọ nke na-egosi ebe a na-esi abata nʼụlọ, nke na-agụnyekwa akụkụ ndị kwụ chịm mgbe ụfọdụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "tiang pintu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bagian tegak dari kusen pintu yang menandai jalan masuk ke sebuah bangunan, kadang-kadang mencakup bagian mendatarnya."
        }
      ]
    },
    "nep": {
      "preferred_label": "ढोकाको चौकोस",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुनै भवनको प्रवेशद्वारलाई जनाउने ढोकाको चौकोसको ठाडो भाग, जसमा कहिलेकाहीँ तेर्सो भागहरू पनि समावेश हुन्छन्।"
        }
      ]
    },
    "por": {
      "preferred_label": "batente",
      "descriptions": [
        {
          "source": "acai",
          "description": "A parte vertical da moldura de uma porta que marca a entrada de uma construção, às vezes incluindo os elementos horizontais."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дверной косяк",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вертикальная часть дверной коробки, обозначающая вход в здание, иногда включающая и горизонтальные элементы."
        }
      ]
    },
    "spa": {
      "preferred_label": "poste de la puerta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Parte vertical del marco de una puerta que señala la entrada a un edificio, que a veces incluye los elementos horizontales."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwimo wa mlango",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sehemu iliyo wima ya fremu ya mlango inayoashiria maingilio ya jengo, nyakati nyingine ikijumuisha sehemu za mlalo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pos bilong dua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pos i sanap long sait bilong dua bilong makim rot bilong go insait long wanpela haus o banis, na sampela taim em i makim tu ol plang i slip antap long dua."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cột cửa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bộ phận thẳng đứng của khung cửa đánh dấu lối vào một tòa nhà, đôi khi bao gồm cả các thanh ngang."
        }
      ]
    },
    "zhs": {
      "preferred_label": "门框",
      "descriptions": [
        {
          "source": "acai",
          "description": "构成建筑物入口门框的立柱部分，有时也包括横向构件。"
        }
      ]
    },
    "zht": {
      "preferred_label": "門框",
      "descriptions": [
        {
          "source": "acai",
          "description": "標示建築物入口之門框的立柱部分，有時也包括橫向構件。"
        }
      ]
    }
  },
