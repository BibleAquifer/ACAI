  "localizations": {
    "eng": {
      "preferred_label": "Sacred Pillar",
      "alternate_labels": [
        "Pillar Memorial Stone"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Sacred Pillar",
          "article": "realia:SacredPillar",
          "description": "A single stone column, sometimes inscribed, used in worship of false gods and often located on high places."
        }
      ]
    },
    "apd": {
      "preferred_label": "نصب مقدس",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمود من حجر واحد، ساعات بكون منقوش عليه، كان بيستعمل في عبادة الآلهة الباطلة وغالباً بكون موجود في الأماكن العالية."
        }
      ]
    },
    "arb": {
      "preferred_label": "نُصُب مُقَدَّس",
      "descriptions": [
        {
          "source": "acai",
          "description": "عمود حجري منفرد، قد يكون منقوشًا أحيانًا، كان يُستخدم في عبادة آلهة باطلة وغالبًا ما يُقام على المرتفعات."
        }
      ]
    },
    "bis": {
      "preferred_label": "longlongfala ston blong wosip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan longfala ston we i stanap hem wan, we maet oli raetem samting long hem, we oli yusum blong wosipim ol giaman god mo plante taem i stap long ol hil."
        }
      ]
    },
    "fra": {
      "preferred_label": "stèle sacrée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Colonne de pierre unique, parfois gravée, utilisée dans le culte de faux dieux et souvent érigée sur les hauts lieux."
        }
      ]
    },
    "hau": {
      "preferred_label": "Keɓaɓɓen dutse",
      "descriptions": [
        {
          "source": "acai",
          "description": "Guda ɗaya na ginshiƙin dutse, wani lokaci mai rubutu a jiki, da ake amfani da shi wajen bautar allolin ƙarya kuma sau da yawa yakan kasance a kan manyan wurare."
        }
      ]
    },
    "hin": {
      "preferred_label": "पवित्र खंभा",
      "descriptions": [
        {
          "source": "acai",
          "description": "पत्थर का एक अकेला खंभा, जिस पर कभी-कभी कुछ उकेरा या लिखा होता था, जिसका उपयोग झूठे देवताओं की पूजा में किया जाता था और जो अक्सर ऊँचे स्थानों पर स्थापित होता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ogidi nkume nsọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu ogidi nkume, nke a na-apịkwa apị mgbe ụfọdụ, nke a na-eji efe chi ụgha ma na-adịkarị nʼebe dị elu."
        }
      ]
    },
    "ind": {
      "preferred_label": "tugu berhala",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tugu batu tunggal, terkadang berukir, yang digunakan dalam penyembahan ilah-ilah palsu dan sering ditempatkan di bukit-bukit pengorbanan."
        }
      ]
    },
    "nep": {
      "preferred_label": "पवित्र खामो",
      "descriptions": [
        {
          "source": "acai",
          "description": "एउटै ढुङ्गाको खम्बा, कहिलेकाहीँ केही कुँदिएको, जुन झूटा देवताहरूको पूजाआजामा प्रयोग गरिन्थ्यो र प्रायः डाँडाहरूमा राखिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "coluna sagrada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma coluna única de pedra, às vezes com inscrições, usada na adoração de falsos deuses e frequentemente situada em lugares altos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Священный столб",
      "descriptions": [
        {
          "source": "acai",
          "description": "Одиночный каменный столб (иногда с надписями), использовавшийся при поклонении ложным богам и часто устанавливаемый на высотах."
        }
      ]
    },
    "spa": {
      "preferred_label": "columna sagrada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Columna de una sola piedra, a veces con inscripciones, utilizada en el culto a dioses falsos y situada con frecuencia en los lugares altos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nguzo ya ibada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nguzo moja ya mawe, nyakati nyingine yenye maandishi, iliyotumiwa katika kuabudu miungu ya uongo na mara nyingi iliwekwa mahali pa juu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pos ston bilong lotu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pos ston, sampela taim ol i raitim tok long en, ol i save yusim bilong lotuim ol giaman god na planti taim em i stap long ol ples antap."
        }
      ]
    },
    "vie": {
      "preferred_label": "Trụ thờ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cột đá đơn lẻ, đôi khi có khắc chữ, dùng trong việc thờ cúng các thần giả và thường đặt ở các nơi cao."
        }
      ]
    },
    "zhs": {
      "preferred_label": "神柱",
      "descriptions": [
        {
          "source": "acai",
          "description": "一根单独的石柱，有时带有铭文，用于敬拜假神，常位于丘坛上。"
        }
      ]
    },
    "zht": {
      "preferred_label": "柱像",
      "descriptions": [
        {
          "source": "acai",
          "description": "用於敬拜假神、單獨豎立的石柱，有時刻有銘文，通常設於丘壇上。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
