        }
      ]
    },
    "arb": {
      "preferred_label": "شِيد",
      "descriptions": [
        {
          "source": "acai",
          "description": "خَلِيطٌ مِنَ ٱلْكِلْسِ وَٱلْمَاءِ يُطْلَى بِهِ ٱلْجُدْرَانُ لِتَغْطِيَةِ ٱلْأَسْطُحِ ٱلْخَشِنَةِ وَجَعْلِهَا بَيْضَاءَ."
        }
      ]
    },
