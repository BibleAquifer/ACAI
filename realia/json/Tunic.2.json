  "localizations": {
    "eng": {
      "preferred_label": "Tunic",
      "alternate_labels": [
        "Robe With Sleeves",
        "Clothes",
        "Shirt"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Tunic",
          "article": "realia:Tunic.2",
          "description": "A long robe with sleeves often worn by young men and women as a basic garment. The exact meaning of this Hebrew phrase is uncertain."
        }
      ]
    },
    "apd": {
      "preferred_label": "قميص ملون",
      "descriptions": [
        {
          "source": "acai",
          "description": "توب طويل بي أكمام كانو بيلبسوه الشباب والشابات كلبس أساسي. المعنى الدقيق للعبارة العبرية دي ما متأكدين منو تمام."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَمِيص مُلَوَّن",
      "descriptions": [
        {
          "source": "acai",
          "description": "ثَوْبٌ طَوِيلٌ ذُو كُمَّيْنِ كَانَ يَرْتَدِيهِ ٱلشُّبَّانُ وَٱلشَّابَّاتُ غَالِبًا كَرِدَاءٍ أَسَاسِيٍّ. ٱلْمَعْنَى ٱلدَّقِيقُ لِهَذِهِ ٱلْعِبَارَةِ ٱلْعِبْرِيَّةِ غَيْرُ مُؤَكَّدٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "longfala kot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan longfala klos we i gat han blong hem we ol yangfala man mo woman oli stap werem olsem besik klos blong olgeta. Trufala mining blong Hibru tok ya i no klia gud."
        }
      ]
    },
    "fra": {
      "preferred_label": "tunique",
      "descriptions": [
        {
          "source": "acai",
          "description": "Longue tunique à manches souvent portée par les jeunes gens et jeunes filles comme vêtement de base. Le sens exact de cette expression hébraïque est incertain."
        }
      ]
    },
    "hau": {
      "preferred_label": "Doguwar riga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Doguwar riga mai hannuwa da samari da ’yan mata suke yawan sawa a matsayin tufafin yau da kullum. Ba a cika tabbatar da ainihin ma’anar wannan kalmar Ibrananci ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "अंगरखा (कुर्ती)",
      "descriptions": [
        {
          "source": "acai",
          "description": "आस्तीन वाला एक लंबा वस्त्र जो प्रायः युवक और युवतियों द्वारा एक बुनियादी पोशाक के रूप में पहना जाता था। इस इब्रानी वाक्यांश का सटीक अर्थ अनिश्चित है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Uwe mwụda nwere aka ogologo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uwe mwụda ogologo nwere aka uwe nke ụmụ okorobịa na ụmụ agbọghọ na-eyikarị dị ka isi uwe ha. Ihe nkọwa nke ahịrịokwu Hibru a abụghị nke e ji n'aka nke ọma."
        }
      ]
    },
    "ind": {
      "preferred_label": "jubah panjang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jubah panjang berlengan yang sering dikenakan oleh pemuda dan pemudi sebagai pakaian dasar. Arti pasti dari frasa Ibrani ini tidak pasti."
        }
      ]
    },
    "nep": {
      "preferred_label": "सुन्दर वस्त्र",
      "descriptions": [
        {
          "source": "acai",
          "description": "युवक र युवतीहरूले आधारभूत पोशाकको रूपमा लगाउने लामो बाहुला भएको लबेदा वा पोशाक। यस हिब्रू अभिव्यक्तिको ठ्याक्कै अर्थ अनिश्चित छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "túnica longa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma túnica longa com mangas, frequentemente usada por jovens como vestimenta básica. O significado exato dessa expressão hebraica é incerto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Разноцветная одежда",
      "descriptions": [
        {
          "source": "acai",
          "description": "Длинная одежда с рукавами, которую часто носили юноши и девушки в качестве основной одежды. Точное значение этого древнееврейского выражения не вполне ясно."
        }
      ]
    },
    "spa": {
      "preferred_label": "túnica",
      "descriptions": [
        {
          "source": "acai",
          "description": "Manto largo con mangas que a menudo usaban hombres y mujeres jóvenes como prenda básica. El significado exacto de esta expresión hebrea es incierto."
        }
      ]
    },
    "swh": {
      "preferred_label": "Joho lililopambwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Joho refu lenye mikono ambalo mara nyingi lilivaliwa na vijana wa kiume na wa kike kama vazi la msingi. Maana halisi ya fungu hili la maneno ya Kiebrania haina uhakika."
        }
      ]
    },
    "tpi": {
      "preferred_label": "longpela saket",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela longpela naispela klos o saket i gat longpela han em ol yangpela man na meri i save putim olsem bikpela klos. Mining tru bilong dispela tok Hibru i no klia tumas."
        }
      ]
    },
    "vie": {
      "preferred_label": "Áo dài",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chiếc áo dài có tay thường được các nam nữ thanh niên mặc như một trang phục cơ bản. Ý nghĩa chính xác của cụm từ tiếng Hê-bơ-rơ này chưa chắc chắn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "长衣",
      "descriptions": [
        {
          "source": "acai",
          "description": "年轻男女常穿作为基本衣物的长袖袍子。此希伯来短语的确切含义尚不确定。"
        }
      ]
    },
    "zht": {
      "preferred_label": "彩衣",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種有袖的長袍，常由年輕男女作為基本服裝穿著。此希伯來片語的確切含義尚不確定。"
        }
      ]
    }
  },
