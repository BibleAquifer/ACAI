          "description": "A piece of white linen fabric used to enclose the tabernacle courtyard."
        }
      ]
    },
    "apd": {
      "preferred_label": "ستائر الدار",
      "descriptions": [
        {
          "source": "acai",
          "description": "قطعة قماش من الكتان الأبيض كانت تُستعمل لتطويق دار خيمة الاجتماع."
        }
      ]
    },
    "arb": {
      "preferred_label": "سِتَارَةُ ٱلدَّارِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "قِطْعَةٌ مِنْ قُمَاشِ ٱلْكَتَّانِ ٱلْأَبْيَضِ كَانَتْ تُسْتَخْدَمُ لِإِحَاطَةِ دَارِ خَيْمَةِ ٱلِٱجْتِمَاعِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kaliko blong fenis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pis waet kaliko linen we oli yusum blong fenisim yad blong Haos Tapolen."
        }
      ]
    },
    "fra": {
      "preferred_label": "toile du parvis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bande de toile de fin lin blanc servant à clore le parvis du tabernacle."
        }
      ]
    },
    "hau": {
      "preferred_label": "Labule mai kewaye",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yankin yadin lili fari da ake amfani da shi wajen kewaye filin tabanakul."
        }
      ]
    },
    "hin": {
      "preferred_label": "आँगन का परदा",
      "descriptions": [
        {
          "source": "acai",
          "description": "सफेद सनी के कपड़े का एक पर्दा जिसका उपयोग मिलापवाले तम्बू के आँगन को घेरने के लिए किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ákwà mgbochi ogige",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpempe ákwà ọcha e ji kpaa ogige ụlọ nzute ahụ gburugburu."
        }
      ]
    },
    "ind": {
      "preferred_label": "layar pelataran",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sehelai kain lenan putih yang digunakan untuk memagari pelataran Kemah Suci."
        }
      ]
    },
    "nep": {
      "preferred_label": "चोकको पर्दा",
      "descriptions": [
        {
          "source": "acai",
          "description": "पवित्र वासस्थानको चोकलाई घेर्न प्रयोग गरिने सेतो सुती कपडाको पर्दा।"
        }
      ]
    },
    "por": {
      "preferred_label": "cortina do pátio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pedaço de tecido de linho branco usado para cercar o pátio do tabernáculo."
        }
      ]
    },
    "rus": {
      "preferred_label": "завеса двора",
      "descriptions": [
        {
          "source": "acai",
          "description": "Полотно из белого виссона (льняной ткани), служившее ограждением для двора скинии."
        }
      ]
    },
    "spa": {
      "preferred_label": "cortina del atrio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pieza de tela de lino blanco utilizada para cercar el atrio del tabernáculo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Pazia la ua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitambaa cha kitani cheupe kilichotumiwa kuzungushia ua wa hema la kukutania."
        }
      ]
    },
    "tpi": {
      "preferred_label": "laplap bilong banis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hap waitpela laplap linen ol i bin yusim bilong banisim fran bilong haus sel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Màn bao quanh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một tấm màn bằng vải gai mịn màu trắng dùng để bao quanh hành lang của Đền Tạm."
        }
      ]
    },
    "zhs": {
      "preferred_label": "院子的帷幔",
      "descriptions": [
        {
          "source": "acai",
          "description": "用来围住圣幕院子的一块细麻布。"
        }
      ]
    },
    "zht": {
      "preferred_label": "院子的帷子",
      "descriptions": [
        {
          "source": "acai",
          "description": "用來圍繞帳幕院子的一塊白細麻織物。"
        }
      ]
    }
  },
