      "descriptions": [
        {
          "source": "acai",
          "gloss": "Veil",
          "article": "realia:Veil",
          "description": "A thin piece of cloth worn over the face or head for modesty or protection."
        }
      ]
    },
    "apd": {
      "preferred_label": "برقع",
      "descriptions": [
        {
          "source": "acai",
          "description": "قطعة قماش خفيفة بتتعمل فوق الوش أو الرأس للحشمة أو الحماية."
        }
      ]
    },
    "arb": {
      "preferred_label": "بُرْقُع",
      "descriptions": [
        {
          "source": "acai",
          "description": "قِطْعَةٌ رَقِيقَةٌ مِنْ قُمَاشٍ تُوضَعُ عَلَى الوَجْهِ أَوِ الرَّأْسِ لِلْحِشْمَةِ أَوِ الحِمَايَةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "kaliko blong blokem fes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tin kaliko we woman no man i karem blong kavremap fes no hed blong hem blong blokem fes no blong mekem i klin mo stret."
        }
      ]
    },
    "fra": {
      "preferred_label": "voile",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une fine pièce de tissu portée sur le visage ou la tête par modestie ou pour se protéger."
        }
      ]
    },
    "hau": {
      "preferred_label": "lulluɓi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Siririn ƙyalle da ake sawa a fuska ko a kai don ladabi ko kariya."
        }
      ]
    },
    "hin": {
      "preferred_label": "घूँघट",
      "descriptions": [
        {
          "source": "acai",
          "description": "शालीनता या सुरक्षा के लिए चेहरे या सिर पर डाला जाने वाला एक पतला कपड़ा।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Akwa mkpudo ihu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Akwa dị gịrịgịrị a na-ekpuchi nʼihu ma ọ bụ nʼisi maka ịdị umeala nʼobi ma ọ bụ nchebe."
        }
      ]
    },
    "ind": {
      "preferred_label": "kerudung",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sehelai kain tipis yang dikenakan menutupi wajah atau kepala demi kesopanan atau perlindungan."
        }
      ]
    },
    "nep": {
      "preferred_label": "घुम्टो",
      "descriptions": [
        {
          "source": "acai",
          "description": "विनम्रता वा सुरक्षाका निम्ति अनुहार वा टाउकोमा ओढिने पातलो कपडा।"
        }
      ]
    },
    "por": {
      "preferred_label": "véu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um pedaço fino de tecido usado sobre o rosto ou a cabeça para recato ou proteção."
        }
      ]
    },
    "rus": {
      "preferred_label": "Покрывало",
      "descriptions": [
        {
          "source": "acai",
          "description": "Тонкое полотно ткани, надеваемое на лицо или голову из скромности или для защиты."
        }
      ]
    },
    "spa": {
      "preferred_label": "velo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pieza delgada de tela que se usa sobre el rostro o la cabeza por modestia o protección."
        }
      ]
    },
    "swh": {
      "preferred_label": "Utaji",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitambaa chembamba kinachovaliwa juu ya uso au kichwa kwa ajili ya heshima au ulinzi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "laplap bilong karamapim pes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik hap laplap ol i putim antap long pes o het bilong pasim tok o lukautim pes."
        }
      ]
    },
    "vie": {
      "preferred_label": "Khăn che mặt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một mảnh vải mỏng che trên mặt hoặc đầu để thể hiện sự khiêm nhường hoặc để che chở, bảo vệ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "面纱",
      "descriptions": [
        {
          "source": "acai",
          "description": "戴在脸上或头上以示端庄或用于遮护的薄布。"
        }
      ]
    },
    "zht": {
      "preferred_label": "帕子",
      "descriptions": [
        {
          "source": "acai",
          "description": "為了端莊或防護而蒙在臉上或頭上的薄布。"
        }
      ]
    }
