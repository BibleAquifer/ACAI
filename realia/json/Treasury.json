          "gloss": "Treasury",
          "article": "realia:Treasury",
          "description": "A large box or a room used for storing offerings or valuable items in the Temple."
        }
      ]
    },
    "apd": {
      "preferred_label": "خزينة",
      "descriptions": [
        {
          "source": "acai",
          "description": "صندوق كبير أو أوضة بتتحفظ فيها التبرعات أو الحاجات الثمينة في الهيكل."
        }
      ]
    },
    "arb": {
      "preferred_label": "خِزَانَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "صُنْدُوقٌ كَبِيرٌ أَوْ غُرْفَةٌ تُسْتَخْدَمُ لِحِفْظِ ٱلتَّقْدِمَاتِ أَوِ ٱلْمُقْتَنَيَاتِ ٱلثَّمِينَةِ فِي ٱلْهَيْكَلِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "bokis blong kleksen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala bokis no wan rum we oli yusum blong storem ol ofring no ol sas samting insaed long Haos Tempol."
        }
      ]
    },
    "fra": {
      "preferred_label": "trésor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grand coffre ou salle servant à entreposer les offrandes ou les objets de valeur dans le Temple."
        }
      ]
    },
    "hau": {
      "preferred_label": "Wurin ajiye taska",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban akwati ko ɗaki da ake amfani da shi don ajiye sadakoki ko abubuwa masu daraja a Haikali."
        }
      ]
    },
    "hin": {
      "preferred_label": "भण्डार",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक बड़ा संदूक या कक्ष जिसका उपयोग मंदिर में भेंट या मूल्यवान वस्तुओं को रखने के लिए किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebe a na-adọba akụ̀",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu igbe ma ọ bụ ọnụ ụlọ a na-eji adọba onyinye ma ọ bụ ihe ndị dị oké ọnụ ahịa n'ime Ụlọnsọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "perbendaharaan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah peti besar atau ruangan yang digunakan untuk menyimpan persembahan atau barang-barang berharga di Bait Allah."
        }
      ]
    },
    "nep": {
      "preferred_label": "ढुकुटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मन्दिरमा भेटीहरू वा बहुमूल्य वस्तुहरू भण्डारण गर्न प्रयोग गरिने ठूलो बाकस वा कोठा।"
        }
      ]
    },
    "por": {
      "preferred_label": "tesouro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma grande caixa ou uma sala usada para guardar ofertas ou itens valiosos no Templo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сокровищница",
      "descriptions": [
        {
          "source": "acai",
          "description": "Большой ящик или помещение в Храме, использовавшееся для хранения пожертвований или ценных предметов."
        }
      ]
    },
    "spa": {
      "preferred_label": "tesoro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gran cofre o sala utilizada para guardar ofrendas o artículos de valor en el templo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hazina",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sanduku kubwa au chumba kinachotumiwa kuhifadhia sadaka au vitu vya thamani Hekaluni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "rum mani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela bokis o rum bilong putim ol ofa o mani na gutpela samting insait long Tempel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kho bạc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cái rương lớn hoặc một căn phòng dùng để chứa của dâng hoặc các vật có giá trị trong Đền Thờ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "库房",
      "descriptions": [
        {
          "source": "acai",
