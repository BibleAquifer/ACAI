      "descriptions": [
        {
          "source": "acai",
          "description": "عود خشب قصير فوقو تقالة، بيستعملوهو عشان يغزلوا الألياف لخيوط."
        }
      ]
    },
    "arb": {
      "preferred_label": "مِغْزَل",
      "descriptions": [
        {
          "source": "acai",
          "description": "عود خشبي قصير يعلوه ثقل، يُستخدَم لغزل الألياف وتحويلها إلى خيوط."
        }
      ]
    },
    "bis": {
      "preferred_label": "stik blong spenem tred",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan sotfala stik we i gat wan hevi samting antap long hem, we oli stap tanem blong mekem ol rop no faeba i kam tred."
        }
      ]
    },
    "fra": {
      "preferred_label": "fuseau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Court bâton de bois muni d'un poids au sommet, utilisé pour filer les fibres en fil."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mazari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gajeren itacen karkatar da zare mai nauyi a kai da ake amfani da shi wajen karkatar zaren auduga ko ulu."
        }
      ]
    },
    "hin": {
      "preferred_label": "तकली",
      "descriptions": [
        {
          "source": "acai",
          "description": "ऊपरी सिरे पर भार (फिरकी) लगी लकड़ी की एक छोटी छड़ी, जिसका उपयोग रेशों को कातकर सूत या धागा बनाने के लिए किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Osisi ntụ ogho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere mkpanaka osisi nwere ihe dị arọ nʼisi ya nke a na-eji atụ ogho maọbụ eriri eme ya ka ọ bụrụ udọ akwa."
        }
      ]
    },
    "ind": {
      "preferred_label": "pemintal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Batang kayu pendek dengan pemberat di bagian atasnya yang digunakan untuk memintal serat menjadi benang."
        }
      ]
    },
    "nep": {
      "preferred_label": "तकली",
      "descriptions": [
        {
          "source": "acai",
          "description": "रेशाबाट धागो कात्न प्रयोग गरिने, माथिल्लो भागमा तौल भएको काठको सानो लट्ठी।"
        }
      ]
    },
    "por": {
      "preferred_label": "fuso",
