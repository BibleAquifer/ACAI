        }
      ]
    },
    "rus": {
      "preferred_label": "Веретено",
      "descriptions": [
        {
          "source": "acai",
          "description": "Короткая деревянная палочка с грузиком наверху, используемая для прядения волокон в нить."
        }
      ]
    },
    "spa": {
      "preferred_label": "huso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vara corta de madera con un contrapeso en la parte superior que se utiliza para hilar fibras y convertirlas en hilo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uziwa",
      "descriptions": [
        {
          "source": "acai",
