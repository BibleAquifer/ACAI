        }
      ]
    },
    "tpi": {
      "preferred_label": "stik bilong tanim tret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela sotpela stik diwai i gat hevi samting antap bilong en, ol i save mekim wok long en bilong tanim ol tret o string."
        }
      ]
    },
    "vie": {
      "preferred_label": "Con thoi se sợi",
      "descriptions": [
        {
          "source": "acai",
