        }
      ]
    },
    "arb": {
      "preferred_label": "قرعة",
      "descriptions": [
        {
          "source": "acai",
          "description": "أداة ذات علامات خاصة، مثل حصاة أو كسرة فخار، تُستخدم لاتخاذ القرارات عن طريق القرعة."
        }
      ]
    },
    "bis": {
      "preferred_label": "spesel ston blong mekem laki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan samting we i gat spesel mak long hem, olsem wan smol ston o pis graonpot, we oli yusum blong faenemaot samting o mekem desisen tru long janis."
        }
      ]
    },
    "fra": {
      "preferred_label": "sort",
      "descriptions": [
        {
          "source": "acai",
          "description": "Objet spécialement marqué, comme un caillou ou un tesson de poterie, utilisé pour prendre des décisions par tirage au sort."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙuri’a",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu da aka yi wa alama ta musamman, kamar tsakuwa ko ɓangaren tukunyar ƙasa, da ake amfani da shi wajen yanke shawara ta hanyar rabo."
        }
      ]
    },
    "hin": {
      "preferred_label": "चिट्ठी",
      "descriptions": [
        {
          "source": "acai",
          "description": "संयोग या भाग्य द्वारा निर्णय लेने के लिए प्रयुक्त एक विशेष रूप से चिह्नित वस्तु, जैसे कि कंकड़ या ठीकर।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe a kara akara pụrụ iche, dị ka obere nkume ma ọ bụ iberibe ite, nke a na-eji eme mkpebi site n'ike chi."
        }
      ]
    },
    "ind": {
      "preferred_label": "undi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Benda bertanda khusus, seperti kerikil atau pecahan tembikar, yang digunakan untuk mengambil keputusan melalui undian."
        }
      ]
    },
    "nep": {
      "preferred_label": "चिट्ठा",
      "descriptions": [
        {
          "source": "acai",
          "description": "संयोग वा भाग्यद्वारा निर्णय गर्न प्रयोग गरिने ढुङ्गाको टुक्रा वा माटाको भाँडाको टुक्रा जस्तो विशेष चिह्न लगाइएको वस्तु।"
        }
      ]
    },
    "por": {
      "preferred_label": "sorte",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um objeto com marcações especiais, como uma pedra ou caco de cerâmica, usado para tomar decisões por sorteio."
        }
      ]
    },
    "rus": {
      "preferred_label": "Жребий",
      "descriptions": [
        {
          "source": "acai",
          "description": "Особым образом помеченный предмет (например, камешек или глиняный черепок), использовавшийся для принятия решений путем случайного выбора."
        }
      ]
    },
    "spa": {
      "preferred_label": "suerte",
      "descriptions": [
        {
          "source": "acai",
          "description": "Objeto con una marca especial, como un guijarro o un pedazo de cerámica, utilizado para tomar decisiones por sorteo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kura",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu chenye alama maalum, kama vile kokoto au kigae, kinachotumiwa kufanya maamuzi kwa nasibu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "sat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting olsem ston o hap sospen graun ol i bin makim bilong mekim disisen long rot bilong pilai sat."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thăm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vật được đánh dấu đặc biệt, như viên sỏi hoặc mảnh gốm, dùng để đưa ra quyết định bằng cách ngẫu nhiên."
        }
      ]
    },
    "zhs": {
      "preferred_label": "签",
