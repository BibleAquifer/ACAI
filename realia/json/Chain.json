          "gloss": "Chain",
          "article": "realia:Chain",
          "description": "A series of connected metal links used to tie things together or restrain prisoners."
        }
      ]
    },
    "apd": {
      "preferred_label": "سلسلة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حلقات حديد مربوطة مع بعض بتُستعمل لربط الحاجات أو تقييد المساجين."
        }
      ]
    },
    "arb": {
      "preferred_label": "سِلْسِلَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "سِلْسِلَةٌ مِنْ حَلَقَاتٍ مَعْدِنِيَّةٍ مُتَرَابِطَةٍ تُسْتَخْدَمُ لِرَبْطِ الْأَشْيَاءِ مَعًا أَوْ لِتَقْيِيدِ السُّجَنَاءِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "jen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan laen blong ol aean link we oli joen wanwan blong fasem ol samting tugeta no blong fasem ol prisina."
        }
      ]
    },
    "fra": {
      "preferred_label": "chaîne",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suite de maillons métalliques reliés entre eux, servant à attacher des objets ou à entraver des prisonniers."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sarƙa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarƙar da aka jona ƙofofin ƙarfe da juna, ana amfani da ita don ɗaure abubuwa ko ɗaure fursunoni."
        }
      ]
    },
    "hin": {
      "preferred_label": "जंजीर",
      "descriptions": [
        {
          "source": "acai",
          "description": "चीजों को आपस में बाँधने या कैदियों को जकड़ने के लिए इस्तेमाल की जाने वाली आपस में जुड़ी धातु की कड़ियों की एक लड़ी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "agbụ igwe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eriri igwe nwere ọtụtụ mkpụrụ e jikọtara ọnụ nke a na-eji eke ihe ma ọ bụ eji ejide ndị mkpọrọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "rantai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rangkaian mata rantai logam yang terhubung, digunakan untuk mengikat barang-barang atau mengekang tawanan."
        }
      ]
    },
    "nep": {
      "preferred_label": "साङ्लो",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुराहरू बाँध्‍न वा कैदीहरूलाई नियन्त्रणमा राख्‍न प्रयोग गरिने धातुका एकापसमा जोडिएका कडीहरूको शृङ्खला।"
        }
      ]
    },
    "por": {
      "preferred_label": "corrente",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma série de elos de metal conectados usada para amarrar coisas ou prender prisioneiros."
        }
      ]
    },
    "rus": {
      "preferred_label": "цепь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ряд соединенных металлических звеньев, используемый для связывания предметов или сковывания узников."
        }
      ]
    },
    "spa": {
      "preferred_label": "cadena",
      "descriptions": [
        {
          "source": "acai",
          "description": "Serie de eslabones de metal conectados entre sí que se usa para atar cosas o sujetar a prisioneros."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mnyororo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfululizo wa pete za chuma zilizounganishwa zinazotumiwa kufungia vitu pamoja au kuwafunga wafungwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "sen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Planti liklik hap ain ol i pasim wantaim bilong pasim ol samting o kalabusim ol man."
        }
      ]
    },
    "vie": {
      "preferred_label": "dây xích",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chuỗi các mắt xích kim loại nối với nhau dùng để buộc đồ vật hoặc trói tù nhân."
        }
      ]
    },
    "zhs": {
      "preferred_label": "锁链",
      "descriptions": [
        {
          "source": "acai",
          "description": "一串相连的金属环，用于将物品拴在一起或约束囚犯。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鐵鍊",
      "descriptions": [
        {
          "source": "acai",
          "description": "由一系列金屬環相扣而成的鏈條，用於拴繫物品或拘禁囚犯。"
        }
      ]
    }
  },
