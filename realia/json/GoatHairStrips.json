  "localizations": {
    "eng": {
      "preferred_label": "Goat Hair Strips",
      "alternate_labels": [
        "Cover",
        "Cloth"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Goat Hair Strips",
          "article": "realia:GoatHairStrips",
          "description": "Long strips of cloth made from goat’s hair, used to make tent coverings or room dividers."
        }
      ]
    },
    "apd": {
      "preferred_label": "ستائر شعر معيز",
      "descriptions": [
        {
          "source": "acai",
          "description": "أشرطة طويلة من قماش مصنوع من شعر المعيز، مستعملة لعمل غطاء للخيمة أو فواصل للغرف."
        }
      ]
    },
    "arb": {
      "preferred_label": "شُقَق مِنْ شَعْرِ مِعْزَى",
      "descriptions": [
        {
          "source": "acai",
          "description": "شُقَقٌ طَويلَةٌ مِنْ نَسِيجِ شَعْرِ المِعْزَى، كانَتْ تُسْتَخْدَمُ لِصُنْعِ أَغْطِيَةِ الخِيامِ أَوِ القَواطِعِ بَيْنَ الحُجُراتِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "kaliko blong hea blong nani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol longfala kaliko we oli wokem long hea blong nani, we oli yusum blong kavremap haos tapolen no blong seraotem rum."
        }
      ]
    },
    "fra": {
      "preferred_label": "bandes de poil de chèvre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Longues bandes d'étoffe faites de poil de chèvre, utilisées pour fabriquer des couvertures de tente ou des cloisons."
        }
      ]
    },
    "hau": {
      "preferred_label": "Labulen gashin akuya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dogayen mayafai ko labulaye da aka yi da gashin akuya, waɗanda aka yi amfani da su don rufe tanti ko raba ɗakuna."
        }
      ]
    },
    "hin": {
      "preferred_label": "बकरी के बाल के पर्दे",
      "descriptions": [
        {
          "source": "acai",
          "description": "बकरी के बालों से बनी कपड़े की लंबी पट्टियाँ, जिनका उपयोग तंबू के आवरण या पर्दों के रूप में किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "akwa ajị ewu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkpụrụ akwa toro ogologo nke e ji ajị ewu kpaa, nke e ji kpuchie elu ụlọikwuu ma ọ bụ kee ụlọ nʼime."
        }
      ]
    },
    "ind": {
      "preferred_label": "carik tenda bulu kambing",
      "descriptions": [
        {
          "source": "acai",
          "description": "Carik-carik kain panjang yang terbuat dari bulu kambing, yang digunakan untuk membuat tudung tenda atau pemisah ruangan."
        }
      ]
    },
    "nep": {
      "preferred_label": "बाख्राका भुत्लाका पर्दाहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाख्राको भुत्लाबाट बनाइएको कपडाको लामो टुक्रा, जुन पाल ढाक्न वा कोठा छुट्ट्याउने पर्दाको रूपमा प्रयोग गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "cortinas de pelo de cabra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Longas faixas de tecido feitas de pelo de cabra, usadas para fazer coberturas de tendas ou divisórias de ambientes."
        }
      ]
    },
    "rus": {
      "preferred_label": "покрывала из козьей шерсти",
      "descriptions": [
        {
          "source": "acai",
          "description": "Длинные полотнища из козьей шерсти, использовавшиеся для изготовления шатровых покрывал или занавесей."
        }
      ]
    },
    "spa": {
      "preferred_label": "tiras de pelo de cabra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tiras largas de tela hechas de pelo de cabra, utilizadas para hacer cubiertas de tiendas o separadores de ambientes."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mapazia ya singa za mbuzi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vipande virefu vya kitambaa vilivyotengenezwa kwa singa za mbuzi, vilivyotumika kufanya vifuniko vya hema au mapazia ya kutenganisha vyumba."
        }
      ]
    },
    "tpi": {
      "preferred_label": "hap laplap gras bilong meme",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol longpela hap laplap ol i wokim long gras bilong meme, ol i save yusim bilong karamapim haus sel o mekim olsem banis laplap bilong rum."
        }
      ]
    },
    "vie": {
      "preferred_label": "Tấm màn lông dê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Các dải vải dài dệt bằng lông dê, dùng để làm bạt che lều hoặc màn ngăn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "山羊毛幔子",
      "descriptions": [
        {
          "source": "acai",
          "description": "用山羊毛制成的长布条，用于制作帐幕罩棚或隔帘。"
        }
      ]
    },
    "zht": {
      "preferred_label": "山羊毛幔子",
      "descriptions": [
        {
          "source": "acai",
          "description": "用山羊毛製成的長條布匹，用來製作帳幕的罩棚或隔屏。"
        }
      ]
    }
  },
