  "localizations": {
    "eng": {
      "preferred_label": "Leather",
      "alternate_labels": [
        "Hide",
        "Tanner",
        "Maker of Leather",
        "Of Leather"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Leather",
          "article": "realia:Leather",
          "description": "Animal skin prepared and preserved to be durable and flexible by removing the hair and preventing decay."
        }
      ]
    },
    "apd": {
      "preferred_label": "جلد",
      "descriptions": [
        {
          "source": "acai",
          "description": "جلد بتاع حيوان مجهز ومحفوظ عشان يكون متين ولين، عن طريق إزالة الشعر وحمايتو من العفن."
        }
      ]
    },
    "arb": {
      "preferred_label": "جِلْد",
      "descriptions": [
        {
          "source": "acai",
          "description": "جلد حيوان مُعَدّ ومُعالَج ليكون متيناً ومرناً عن طريق إزالة الشعر ومنع التلف والتعفن."
        }
      ]
    },
    "bis": {
      "preferred_label": "leta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Skin blong anamol we oli mekem i rere mo mekem i stap gud we i no save roten mo i save benben, taem oli tekemaot ol hea blong hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "cuir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Peau d'animal préparée et traitée pour être durable et souple en enlevant les poils et en empêchant la décomposition."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fatar dabba da aka gyara kuma aka adana ta yadda za ta daɗe tana da taushi ta hanyar cire gashi da hana ruɓewa."
        }
      ]
    },
    "hin": {
      "preferred_label": "चमड़ा",
      "descriptions": [
        {
          "source": "acai",
          "description": "पशु की खाल जिसे बाल हटाकर और सड़ने से बचाकर टिकाऊ और लचीला बनाया गया हो।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Akpụkpọ anụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Akpụkpọ anụ a haziri ma kpuchie ka ọ dịgide ma na-ehulata site nʼiwepụ ajị na igbochi ya ire ure."
        }
      ]
    },
    "ind": {
      "preferred_label": "kulit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kulit binatang yang disiapkan dan diawetkan agar tahan lama dan lentur dengan membuang bulunya serta mencegah pembusukan."
        }
      ]
    },
    "nep": {
      "preferred_label": "छाला",
      "descriptions": [
        {
          "source": "acai",
          "description": "रौँ हटाएर र कुहिनबाट बचाएर बलियो र लचिलो बनाउन तयार पारिएको र प्रशोधित जनावरको छाला।"
        }
      ]
    },
    "por": {
      "preferred_label": "couro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pele de animal preparada e conservada para ser durável e flexível, mediante a remoção dos pelos e a prevenção da decomposição."
        }
      ]
    },
    "rus": {
      "preferred_label": "Кожа",
      "descriptions": [
        {
          "source": "acai",
          "description": "Кожа животного, обработанная и сохраненная для прочности и гибкости путем удаления шерсти и предотвращения гниения."
        }
      ]
    },
    "spa": {
      "preferred_label": "cuero",
      "descriptions": [
        {
          "source": "acai",
          "description": "Piel de animal preparada y preservada para ser duradera y flexible quitándole el pelo y evitando su descomposición."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ngozi iliyotengenezwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ngozi ya mnyama iliyotayarishwa na kuhifadhiwa ili idumu na kunyumbulika kwa kuondoa manyoya na kuzuia kuoza."
        }
      ]
    },
    "tpi": {
      "preferred_label": "skin bilong animal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Skin bilong animal ol i stretim na mekim drai bai i stap strong na malumalu long rot bilong rausim ol gras na pasim em long sting."
        }
      ]
    },
    "vie": {
      "preferred_label": "da thuộc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Da động vật được sơ chế và bảo quản để bền và dẻo dai bằng cách làm sạch lông và ngăn ngừa phân hủy."
        }
      ]
    },
    "zhs": {
      "preferred_label": "皮革",
      "descriptions": [
        {
          "source": "acai",
          "description": "通过脱毛和防腐处理以使其耐用且柔韧的动物皮。"
        }
      ]
    },
    "zht": {
      "preferred_label": "皮革",
      "descriptions": [
        {
          "source": "acai",
          "description": "經過加工與防腐處理的動物皮，透過除毛和防止腐爛使其耐用且具柔韌性。"
        }
      ]
    }
  },
