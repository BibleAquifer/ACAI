  "localizations": {
    "eng": {
      "preferred_label": "Curtain",
      "alternate_labels": [
        "Drape",
        "Veil"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Curtain",
          "article": "realia:Curtain",
          "description": "A large, vertical cloth used to cover an opening, often separating sacred spaces."
        }
      ]
    },
    "apd": {
      "preferred_label": "ستار",
      "descriptions": [
        {
          "source": "acai",
          "description": "قماش كبير معلق بشكل رأسي بيستعمل لتغطية فتحة، وغالباً بيفصل بين الأماكن المقدسة."
        }
      ]
    },
    "arb": {
      "preferred_label": "حِجاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "قماش كبير مُعلَّق يُستخدم لتغطية فتحة، وغالبًا ما يفصل بين الأماكن المقدسة."
        }
      ]
    },
    "bis": {
      "preferred_label": "kaliko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala kaliko we i hang blong blokem wan spes o doa, we plante taem i blong seraotem ol spes we oli tabu."
        }
      ]
    },
    "fra": {
      "preferred_label": "voile",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une grande pièce de tissu verticale servant à couvrir une ouverture, séparant souvent des espaces sacrés."
        }
      ]
    },
    "hau": {
      "preferred_label": "Labule",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban yadi a tsaye da ake amfani da shi don rufe wata kofa ko mashiga, sau da yawa yakan raba wurare masu tsarki."
        }
      ]
    },
    "hin": {
      "preferred_label": "परदा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक बड़ा, लंबवत कपड़ा जो किसी द्वार या खुले भाग को ढकने के लिए उपयोग किया जाता था, और अक्सर पवित्र स्थानों को अलग करता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "akwa mgbochi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu akwa a kwụnyere nʼelu nke e ji ekpuchi ọnụ ụzọ ma ọ bụ oghere, nke na-ekewakarị ebe nsọ dị iche iche."
        }
      ]
    },
    "ind": {
      "preferred_label": "tabir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kain vertikal berukuran besar yang digunakan untuk menutupi sebuah bukaan, sering kali memisahkan ruang-ruang kudus."
        }
      ]
    },
    "nep": {
      "preferred_label": "पर्दा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एउटा ठूलो, ठाडो कपडा जुन कुनै खुला भागलाई ढाक्न प्रयोग गरिन्छ, प्रायः पवित्र स्थानहरूलाई अलग गर्न।"
        }
      ]
    },
    "por": {
      "preferred_label": "cortina",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um tecido grande e vertical usado para cobrir uma abertura, frequentemente separando espaços sagrados."
        }
      ]
    },
    "rus": {
      "preferred_label": "Завеса",
      "descriptions": [
        {
          "source": "acai",
          "description": "Большое вертикальное полотно ткани, используемое для закрытия проема и часто отделяющее священные пространства."
        }
      ]
    },
    "spa": {
      "preferred_label": "cortina",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tela grande y vertical usada para cubrir una abertura, que a menudo separaba espacios sagrados."
        }
      ]
    },
    "swh": {
      "preferred_label": "Pazia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitambaa kikubwa, kilichoning’inizwa wima kinachotumika kufunika uwazi, mara nyingi kikitenganisha sehemu takatifu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bikpela laplap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela laplap ol i hangamapim bilong pasim dua o bilong katim na brukim ol rum, planti taim bilong mekim narapela hap i stap tambu."
        }
      ]
    },
    "vie": {
      "preferred_label": "bức màn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một tấm vải lớn, treo thẳng đứng dùng để che một lối đi, thường ngăn cách các không gian thánh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "幔子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种大而垂直悬挂的布，用来遮盖开口，常用于隔开圣所空间。"
        }
      ]
    },
    "zht": {
      "preferred_label": "幔子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一塊用於遮蓋開口處的大型垂直布料，常用於隔開神聖空間。"
        }
      ]
    }
  },
