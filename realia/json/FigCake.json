  "localizations": {
    "eng": {
      "preferred_label": "Fig Cake",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Fig Cake",
          "article": "realia:FigCake",
          "description": "A cake made from pressed dried figs, used as food and sometimes as medicine."
        }
      ]
    },
    "apd": {
      "preferred_label": "قرص تين",
      "descriptions": [
        {
          "source": "acai",
          "description": "قرص معمول من تين مجفف ومكبوس، بيستعملوه كأكل وساعات كعلاج."
        }
      ]
    },
    "arb": {
      "preferred_label": "قُرص تين",
      "descriptions": [
        {
          "source": "acai",
          "description": "قرص مصنوع من التين المجفف المضغوط، يُستخدم طعامًا وأحيانًا دواءً."
        }
      ]
    },
    "bis": {
      "preferred_label": "kek blong fig",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kek we oli wokem long ol frut blong figtri we oli preselumaot mo oli sandraem olgeta, we oli kakae mo samtaem oli yusum olsem meresin."
        }
      ]
    },
    "fra": {
      "preferred_label": "gâteau de figues",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gâteau fait de figues séchées et pressées, utilisé comme nourriture et parfois comme remède."
        }
      ]
    },
    "hau": {
      "preferred_label": "kauɗar ɓaure",
      "descriptions": [
        {
          "source": "acai",
          "description": "Waina ko masa da aka yi da busassun 'ya'yan ɓaure da aka matse, ana amfani da ita a matsayin abinci, a wasu lokuta kuma a matsayin magani."
        }
      ]
    },
    "hin": {
      "preferred_label": "अंजीर की टिकिया",
      "descriptions": [
        {
          "source": "acai",
          "description": "दबाए हुए सूखे अंजीरों से बनाई गई एक टिकिया, जो भोजन और कभी-कभी औषधि के रूप में उपयोग की जाती थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Achịcha fiig",
      "descriptions": [
        {
          "source": "acai",
          "description": "Achịcha e ji mkpụrụ fiig a mịkpọrọ amịkpọ mee ka ọ dị larịị, nke a na-eji eme nri ma na-ejikwa ya eme ọgwụ mgbe ụfọdụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "kue ara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kue yang terbuat dari buah ara kering yang dipadatkan, digunakan sebagai makanan dan terkadang sebagai obat."
        }
      ]
    },
    "nep": {
      "preferred_label": "नेभाराको डल्लो",
      "descriptions": [
        {
          "source": "acai",
          "description": "सुकाएर थिचिएको नेभाराबाट बनाइएको डल्लो वा केक, जो भोजनको रूपमा र कहिलेकाहीँ औषधिको रूपमा प्रयोग गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "bolo de figo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bolo feito de figos secos prensados, usado como alimento e às vezes como remédio."
        }
      ]
    },
    "rus": {
      "preferred_label": "лепешка из смокв",
      "descriptions": [
        {
          "source": "acai",
          "description": "Лепёшка из спрессованного сушёного инжира (смокв), использовавшаяся в пищу и иногда как лекарственное средство."
        }
      ]
    },
    "spa": {
      "preferred_label": "torta de higos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Torta hecha de higos secos prensados, utilizada como alimento y a veces como medicina."
        }
      ]
    },
    "swh": {
      "preferred_label": "mkate wa tini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Keki au andazi lililotengenezwa kwa tini zilizokaushwa na kushindiliwa, likitumiwa kama chakula na wakati mwingine kama dawa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "mekpas pikinini fik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kek ol i bin wokim long ol draipela pikinini fik ol i bin presim wantaim, ol i save kaikai na sampela taim ol i mekim olsem marasin."
        }
      ]
    },
    "vie": {
      "preferred_label": "bánh trái vả",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại bánh làm từ trái vả phơi khô ép lại, dùng làm thực phẩm và đôi khi làm thuốc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "无花果饼",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种由压制无花果干制成的饼，用作食物，有时也用作药物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "無花果餅",
      "descriptions": [
        {
          "source": "acai",
          "description": "由壓製的無花果乾製成的餅，用作食物，有時也用作藥物。"
        }
      ]
    }
  },
