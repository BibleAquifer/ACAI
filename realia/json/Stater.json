        {
          "source": "acai",
          "gloss": "Stater",
          "article": "realia:Stater",
          "description": "A silver coin used in ancient times, worth two didrachma or about four denarii."
        }
      ]
    },
    "apd": {
      "preferred_label": "إستار",
      "descriptions": [
        {
          "source": "acai",
          "description": "عملة فضية كانت بتستعمل زمان، قيمتها درهمين مزدوجين أو قريب أربعة دينارات."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِسْتَار",
      "descriptions": [
        {
          "source": "acai",
          "description": "عملة فضية كانت تُستخدَم في العصور القديمة، قيمتها درهمان مضاعفان (ديدراخما) أو نحو أربعة دنانير."
        }
      ]
    },
    "bis": {
      "preferred_label": "stata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan silva mane we oli bin yusum long bifo, we veliu blong hem i sem mak long tu didrakma no fo denarius."
        }
      ]
    },
    "fra": {
      "preferred_label": "statère",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pièce d'argent utilisée dans l'Antiquité, valant deux didrachmes ou environ quatre deniers."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sitater",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tsabar kuɗin azurfa da aka yi amfani da ita a dā, wadda darajarta ta kai didrachma biyu ko kusan dinari huɗu."
        }
      ]
    },
    "hin": {
      "preferred_label": "स्तेतेर",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्राचीन काल में प्रयुक्त एक चाँदी का सिक्का, जिसका मूल्य दो दिद्रखम या लगभग चार दीनार के बराबर होता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Steta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkpụrụ ego ọlaọcha a na-eji nʼoge ochie, nke ruru didrakma abụọ maọbụ ihe dịka dinarịọs anọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "stater",
      "descriptions": [
        {
          "source": "acai",
          "description": "Koin perak yang digunakan pada zaman kuno, bernilai dua didrakhma atau sekitar empat dinar."
        }
      ]
    },
    "nep": {
      "preferred_label": "स्टाटर",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्राचीन समयमा प्रयोग गरिने चाँदीको सिक्का, जसको मान दुई दिद्राखम वा करिब चार देनार बराबर हुन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "estáter",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma moeda de prata usada nos tempos antigos, equivalente a dois didracmas ou cerca de quatro denários."
        }
      ]
    },
    "rus": {
      "preferred_label": "Статир",
      "descriptions": [
        {
          "source": "acai",
          "description": "Серебряная монета, использовавшаяся в древности, равная двум дидрахмам или около четырех динариев."
        }
      ]
    },
    "spa": {
      "preferred_label": "estáter",
      "descriptions": [
        {
          "source": "acai",
          "description": "Moneda de plata utilizada en la antigüedad, con un valor de dos didracmas o alrededor de cuatro denarios."
        }
      ]
    },
    "swh": {
      "preferred_label": "Stateri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarafu ya fedha iliyotumiwa nyakati za kale, yenye thamani ya didrakma mbili au takriban dinari nne."
        }
      ]
    },
    "tpi": {
      "preferred_label": "stater",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela silva mani bilong bipo tru, pe bilong en i olsem tupela didrakma o foapela dinarius."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đồng sta-te",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đồng tiền bạc dùng thời cổ đại, có giá trị bằng hai đi-đơ-rách-ma hoặc khoảng bốn đơ-ni-ê."
        }
      ]
    },
    "zhs": {
      "preferred_label": "斯塔特",
      "descriptions": [
        {
          "source": "acai",
          "description": "古代使用的一种银币，值二德拉克马或约四得拿利。"
        }
      ]
    },
    "zht": {
      "preferred_label": "斯塔特",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種古代銀幣，價值等於兩枚雙德拉克馬或約四第納爾。"
        }
      ]
    }
  },
