  "localizations": {
    "eng": {
      "preferred_label": "Seal",
      "alternate_labels": [
        "Mark",
        "Ring",
        "To Seal",
        "To Put a Seal On",
        "To Make Secure",
        "Signet",
        "Inscription",
        "Wearing a Gold Ring",
        "Signet Ring"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Seal",
          "article": "realia:Seal",
          "description": "A ring or object used to make a mark that shows ownership or approval, usually by pressing into wax."
        }
      ]
    },
    "apd": {
      "preferred_label": "ختم",
      "descriptions": [
        {
          "source": "acai",
          "description": "خاتم ولا حاجة بيستعملوها عشان يختموا بيها علامة بتبيّن الملكية ولا الموافقة، في العادة بضغطها على الشمع."
        }
      ]
    },
    "arb": {
      "preferred_label": "خاتَم",
      "descriptions": [
        {
          "source": "acai",
          "description": "خاتم أو أداة تُستخدم لترك علامة تدل على الملكية أو المصادقة، عادة بالضغط على الشمع."
        }
      ]
    },
    "bis": {
      "preferred_label": "sil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ring no wan samting we oli yusum blong putum mak we i soemaot se samting i blong hu no i agri long hem, plante taem oli presisinem i go long waks."
        }
      ]
    },
    "fra": {
      "preferred_label": "sceau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anneau ou objet utilisé pour apposer une marque prouvant la propriété ou l'authenticité, généralement par empreinte dans la cire ou l'argile."
        }
      ]
    },
    "hau": {
      "preferred_label": "hatimi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zobe ko wani abu da ake amfani da shi wajen buga alamar mallaka ko amincewa, yawanci ta hanyar danna shi a kan kakin zuma."
        }
      ]
    },
    "hin": {
      "preferred_label": "मुहर",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अँगूठी या वस्तु जिसका उपयोग स्वामित्व या अनुमोदन दर्शाने वाले निशान को बनाने के लिए किया जाता है, जो प्रायः मोम पर दबाकर लगाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mgbaaka akara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mgbaaka ma ọ bụ ihe e ji aka akara nke na-egosi inwe ihe ma ọ bụ nkwado, nke a na-apakarịkarị na wax."
        }
      ]
    },
    "ind": {
      "preferred_label": "meterai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cincin atau benda yang digunakan untuk membuat cap yang menunjukkan kepemilikan atau pengesahan, biasanya dengan ditekankan ke dalam lilin."
        }
      ]
    },
    "nep": {
      "preferred_label": "छाप",
      "descriptions": [
        {
          "source": "acai",
          "description": "स्वामित्व वा स्वीकृति जनाउन चिह्न लगाउन प्रयोग गरिने औँठी वा कुनै वस्तु, जुन सामान्यतया मैनमा थिचेर लगाइन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "selo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um anel ou objeto usado para fazer uma marca que indica posse ou aprovação, geralmente por pressão em cera."
        }
      ]
    },
    "rus": {
      "preferred_label": "печать",
      "descriptions": [
        {
          "source": "acai",
          "description": "Кольцо или предмет, используемый для нанесения оттиска, удостоверяющего право собственности или подлинность, обычно путем вдавливания в воск."
        }
      ]
    },
    "spa": {
      "preferred_label": "sello",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anillo u objeto utilizado para hacer una marca que indica propiedad o aprobación, generalmente presionándolo sobre cera."
        }
      ]
    },
    "swh": {
      "preferred_label": "Muhuri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pete au kitu kinachotumiwa kuweka alama inayoonyesha umiliki au kibali, kwa kawaida kwa kukandamiza kwenye nta."
        }
      ]
    },
    "tpi": {
      "preferred_label": "samting bilong putim mak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ring o samting bilong putim mak bilong soim olsem samting em bilong wanpela man o em i oraitim, planti taim ol i save presim i go long waks."
        }
      ]
    },
    "vie": {
      "preferred_label": "con dấu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chiếc nhẫn hoặc vật dụng dùng để đóng dấu nhằm biểu thị quyền sở hữu hoặc sự phê chuẩn, thường bằng cách ấn vào sáp."
        }
      ]
    },
    "zhs": {
      "preferred_label": "印",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种用于压入蜡等材料中留下印记以表明所有权或认可的印章或戒指。"
        }
      ]
    },
    "zht": {
      "preferred_label": "印",
      "descriptions": [
        {
          "source": "acai",
          "description": "用來留下代表所有權或認可之印記的戒指或物品，通常蓋在蠟上。"
        }
      ]
    }
  },
