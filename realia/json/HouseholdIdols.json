  "localizations": {
    "eng": {
      "preferred_label": "Household Idols",
      "alternate_labels": [
        "Teraphim"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Household Idols",
          "article": "realia:HouseholdIdols",
          "description": "Small, portable figures or carved images used for worship or magic in a home."
        }
      ]
    },
    "apd": {
      "preferred_label": "أصنام البيت",
      "descriptions": [
        {
          "source": "acai",
          "description": "تماثيل صغيرة أو صور منحوتة بيقدر الزول يشيلها معاه، بتستعمل للعبادة أو السحر في البيت (ترافيم)."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَرَافِيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "تَماثيلُ صَغيرَةٌ مَحمولَةٌ أو صُوَرٌ مَنحوتَةٌ تُستَخدَمُ لِلعِبادَةِ أوِ السِّحرِ في المَنزِلِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol aedol blong haos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol smosmol aedol o pija we oli katem long wud o ston we oli save karem i go olbaot, we man i yusum blong mekem wosip o majik long haos blong hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "idoles domestiques",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petites figurines ou images sculptées portatives utilisées pour le culte ou la magie dans une maison."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gumakan gida",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙananan siffofi ko sassaƙaƙƙun gumaka da ake iya ɗauka, waɗanda ake amfani da su don bauta ko sihiri a cikin gida."
        }
      ]
    },
    "hin": {
      "preferred_label": "गृहदेवता",
      "descriptions": [
        {
          "source": "acai",
          "description": "घर में पूजा-अर्चना या टोने-टोटके के लिए इस्तेमाल की जाने वाली छोटी, सुवाह्य मूर्तियाँ या तराशी हुई छवियाँ।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Arụsị ezinaụlọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere oyiyi maọbụ ihe a kpụrụ akpụ a na-ebugharị ebugharị nke a na-eji efe ofufe maọbụ eme anwansi nʼezinaụlọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "terafim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Patung kecil yang mudah dibawa atau gambar pahatan yang digunakan untuk pemujaan atau sihir di rumah."
        }
      ]
    },
    "nep": {
      "preferred_label": "घर-देवताहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "घरभित्र पूजाआजा वा तन्त्रमन्त्रका निम्ति प्रयोग गरिने साना, सजिलै बोक्न सकिने मूर्तिहरू वा कुँदिएका आकृतिहरू।"
        }
      ]
    },
    "por": {
      "preferred_label": "ídolos domésticos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pequenas figuras ou imagens esculpidas e portáteis usadas para adoração ou magia em uma casa."
        }
      ]
    },
    "rus": {
      "preferred_label": "домашние идолы",
      "descriptions": [
        {
          "source": "acai",
          "description": "Небольшие переносные фигурки или резные изображения, использовавшиеся для домашнего поклонения или магии (терафимы)."
        }
      ]
    },
    "spa": {
      "preferred_label": "ídolos domésticos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Figuras pequeñas y portátiles o imágenes talladas utilizadas para el culto o la magia en el hogar."
        }
      ]
    },
    "swh": {
      "preferred_label": "Miungu ya Nyumbani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sanamu ndogo zinazoweza kubebeka au vinyago vilivyochongwa vilivyotumiwa kwa ajili ya ibada au uchawi nyumbani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ol giaman god bilong haus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol liklik piksa o samting ol i sapim long diwai o ston bilong lotu o posin insait long wanpela famili o haus."
        }
      ]
    },
    "vie": {
      "preferred_label": "tượng thần gia đình",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những bức tượng nhỏ, dễ mang theo hoặc tượng chạm khắc dùng để thờ phượng hoặc làm trò ma thuật trong gia đình."
        }
      ]
    },
    "zhs": {
      "preferred_label": "家庭神像",
      "descriptions": [
        {
          "source": "acai",
          "description": "用于家庭崇拜或巫术的小型便携式雕像或雕刻偶像。"
        }
      ]
    },
    "zht": {
      "preferred_label": "家中的神像",
      "descriptions": [
        {
          "source": "acai",
          "description": "用於家中敬拜或法術的小型便攜式雕像或雕刻偶像。"
        }
      ]
    }
  },
