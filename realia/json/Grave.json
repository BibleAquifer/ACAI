  "localizations": {
    "eng": {
      "preferred_label": "Grave",
      "alternate_labels": [
        "Tomb",
        "Burial"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Grave",
          "article": "realia:Grave",
          "description": "A place for burying the dead, often a natural cave or carved from rock."
        }
      ]
    },
    "apd": {
      "preferred_label": "قبر",
      "descriptions": [
        {
          "source": "acai",
          "description": "مكان لدفن الموتى، بكون في الغالب كهف طبيعي أو منحوت في الصخر."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَبْر",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَكانٌ لِدَفْنِ المَوْتى، غالِبًا ما يَكُونُ كَهْفًا طَبِيعِيًّا أَوْ مَنْحُوتًا في الصَّخْرِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "beregraon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ples blong berem dedman, we plante taem i wan hol long ston no kev."
        }
      ]
    },
    "fra": {
      "preferred_label": "tombeau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lieu servant à enterrer les morts, souvent une grotte naturelle ou taillée dans le roc."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kabari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wurin binne matattu, sau da yawa kogo ne ko kuma wanda aka sassaƙa a cikin dutse."
        }
      ]
    },
    "hin": {
      "preferred_label": "कब्र",
      "descriptions": [
        {
          "source": "acai",
          "description": "मृतकों को दफनाने का स्थान, जो अक्सर एक प्राकृतिक गुफा होती थी या चट्टान में तराशी जाती थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ili",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ebe a na-eli ndị nwụrụ anwụ, nke na-abụkarị ọgba nkume ma ọ bụ nke a pịrị nʼime nkume."
        }
      ]
    },
    "ind": {
      "preferred_label": "kubur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tempat untuk menguburkan orang mati, sering kali berupa gua alami atau digali di bukit batu."
        }
      ]
    },
    "nep": {
      "preferred_label": "चिहान",
      "descriptions": [
        {
          "source": "acai",
          "description": "मृतकहरूलाई गाड्ने ठाउँ, जुन प्रायः प्राकृतिक गुफा वा चट्टान खोपेर बनाइएको हुन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "túmulo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um lugar para sepultar os mortos, frequentemente uma caverna natural ou escavada na rocha."
        }
      ]
    },
    "rus": {
      "preferred_label": "могила",
      "descriptions": [
        {
          "source": "acai",
          "description": "Место для погребения умерших, часто естественная пещера или вырубленная в скале гробница."
        }
      ]
    },
    "spa": {
      "preferred_label": "sepulcro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lugar para enterrar a los muertos, a menudo una cueva natural o excavado en la roca."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kaburi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahali pa kuzikia wafu, mara nyingi pango la asili au lililochongwa kwenye mwamba."
        }
      ]
    },
    "tpi": {
      "preferred_label": "matmat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples bilong planim ol man i dai pinis, planti taim em wanpela hul bilong ston o keiv ol i bin katim long ston."
        }
      ]
    },
    "vie": {
      "preferred_label": "Mộ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nơi chôn cất người chết, thường là hang đá tự nhiên hoặc được đục trong đá."
        }
      ]
    },
    "zhs": {
      "preferred_label": "坟墓",
      "descriptions": [
        {
          "source": "acai",
          "description": "埋葬死者的地方，通常是天然洞穴或从磐石中凿出来的。"
        }
      ]
    },
    "zht": {
      "preferred_label": "墳墓",
      "descriptions": [
        {
          "source": "acai",
          "description": "埋葬死者的地方，通常是天然洞穴或在岩石中鑿成的。"
        }
      ]
    }
  },
