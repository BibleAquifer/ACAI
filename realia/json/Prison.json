      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Prison",
          "article": "realia:Prison",
          "description": "A place, often underground, where people are kept as punishment for a crime."
        }
      ]
    },
    "apd": {
      "preferred_label": "سجن",
      "descriptions": [
        {
          "source": "acai",
          "description": "مكان، غالباً بكون تحت الأرض، بحبسوا فيه الناس عقاب ليهم على جريمة."
        }
      ]
    },
    "arb": {
      "preferred_label": "سِجْن",
      "descriptions": [
        {
          "source": "acai",
          "description": "مكان، غالبًا ما يكون تحت الأرض، يُحبس فيه الناس عقابًا على جريمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "kalabus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ples, we plante taem i stap ananit long graon, we oli stap lokemap ol man long hem olsem panis from wan krangke fasin we oli mekem."
        }
      ]
    },
    "fra": {
      "preferred_label": "prison",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lieu, souvent souterrain, où des personnes sont enfermées pour punir un crime."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kurkuku",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wuri, sau da yawa a ƙarƙashin ƙasa, inda ake ajiye mutane a matsayin horo domin laifi."
        }
      ]
    },
    "hin": {
      "preferred_label": "बन्दीगृह",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक स्थान, जो अक्सर भूमिगत होता है, जहाँ लोगों को अपराध के दण्ड के रूप में रखा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụlọ mkpọrọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ebe, nke na-adịkarị nʼokpuru ala, a na-edebe ndị mmadụ dị ka ahụhụ maka mpụ ha mere."
        }
      ]
    },
    "ind": {
      "preferred_label": "penjara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tempat, sering kali di bawah tanah, tempat orang dikurung sebagai hukuman atas suatu kejahatan."
        }
      ]
    },
    "nep": {
      "preferred_label": "झ्यालखाना",
      "descriptions": [
        {
          "source": "acai",
          "description": "अपराधको सजाय स्वरूप मानिसहरूलाई थुनेर राखिने प्रायः भूमिगत ठाउँ।"
        }
      ]
    },
    "por": {
      "preferred_label": "prisão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um lugar, muitas vezes subterrâneo, onde as pessoas são mantidas como punição por um crime."
        }
      ]
    },
    "rus": {
      "preferred_label": "Темница",
      "descriptions": [
        {
          "source": "acai",
          "description": "Место, часто подземное, где людей содержат в качестве наказания за преступление или под стражей."
        }
      ]
    },
    "spa": {
      "preferred_label": "prisión",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lugar, a menudo subterráneo, donde se mantiene a las personas como castigo por un delito."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gereza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahali, mara nyingi chini ya ardhi, ambapo watu huwekwa kama adhabu kwa ajili ya kosa la jinai."
        }
      ]
    },
    "tpi": {
      "preferred_label": "haus kalabus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples, planti taim i stap aninit long graun, we ol i save putim ol manmeri olsem panismen bilong rong ol i bin mekim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Nhà tù",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nơi, thường ở dưới lòng đất, nơi người ta bị giam giữ như một hình phạt vì phạm tội."
        }
      ]
    },
    "zhs": {
      "preferred_label": "监牢",
      "descriptions": [
        {
          "source": "acai",
          "description": "关押被惩罚罪犯的场所，通常在地下。"
        }
      ]
    },
    "zht": {
      "preferred_label": "監牢",
      "descriptions": [
        {
          "source": "acai",
          "description": "關押犯罪者以示懲罰的場所，通常設在地下。"
        }
      ]
    }
  },
