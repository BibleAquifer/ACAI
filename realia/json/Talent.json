  "localizations": {
    "eng": {
      "preferred_label": "Talent",
      "alternate_labels": [
        "Weighing a Talent"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Talent",
          "article": "realia:Talent",
          "description": "A unit of weight about 30 kilograms, used for measuring heavy items or as a monetary value in ancient times."
        }
      ]
    },
    "apd": {
      "preferred_label": "وزنة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة وزن وزنها حوالي 30 كيلوجرام، كانت بتُستعمل لوزن الحاجات الثقيلة أو كقيمة نقدية في الزمان القديم."
        }
      ]
    },
    "arb": {
      "preferred_label": "وزنة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة وزن تبلغ نحو 30 كيلوغرامًا، كانت تُستخدم لوزن الأشياء الثقيلة أو كقيمة نقدية في العصور القديمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "talan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan skeil blong hevi we i samting olsem 30 kilogram, we bifo oli yusum blong skelem ol hevi samting no olsem valiu blong mane."
        }
      ]
    },
    "fra": {
      "preferred_label": "talent",
      "descriptions": [
        {
          "source": "acai",
          "description": "Unité de poids d'environ 30 kilogrammes, utilisée dans l'Antiquité pour peser des objets lourds ou comme unité monétaire."
        }
      ]
    },
    "hau": {
      "preferred_label": "Talenti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ma'aunin nauyi mai kusan kilogiram 30, wanda ake amfani da shi don auna abubuwa masu nauyi ko a matsayin ƙimar kuɗi a zamanin dā."
        }
      ]
    },
    "hin": {
      "preferred_label": "तोड़ा",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्राचीन काल में भारी वस्तुओं को तौलने या मुद्रा के मूल्य के रूप में उपयोग की जाने वाली लगभग 30 किलोग्राम वजन की एक इकाई।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "talenti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe atụ ịdị arọ dị ihe dị ka kilogram 30, nke e ji atụ ihe ndị dị arọ ma ọ bụ mee ego nʼoge ochie."
        }
      ]
    },
    "ind": {
      "preferred_label": "talenta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Satuan berat sekitar 30 kilogram, digunakan untuk menimbang barang-barang berat atau sebagai nilai mata uang pada zaman kuno."
        }
      ]
    },
    "nep": {
      "preferred_label": "तोडा",
      "descriptions": [
        {
          "source": "acai",
          "description": "करिब ३० किलोग्रामको तौलको एकाइ, जुन प्राचीन समयमा गह्रौँ वस्तुहरू जोख्न वा मुद्राको मानको रूपमा प्रयोग गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "talento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma unidade de peso de cerca de 30 quilogramas, usada para pesar itens pesados ou como valor monetário nos tempos antigos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Талант",
      "descriptions": [
        {
          "source": "acai",
          "description": "Единица веса (около 30 килограммов), использовавшаяся в древности для взвешивания тяжелых предметов или в качестве денежно-счетной единицы."
        }
      ]
    },
    "spa": {
      "preferred_label": "talento",
      "descriptions": [
        {
          "source": "acai",
          "description": "Unidad de peso de unos 30 kilogramos, utilizada para pesar objetos pesados o como valor monetario en la antigüedad."
        }
      ]
    },
    "swh": {
      "preferred_label": "Talanta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kipimo cha uzito chenye takriban kilo 30, kilichotumiwa kupimia vitu vizito au kama thamani ya kifedha katika nyakati za kale."
        }
      ]
    },
    "tpi": {
      "preferred_label": "telen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hevi mak inap olsem 30 kilogram, ol i save yusim bilong skelim ol hevipela samting o olsem bikpela mak bilong mani long bipo."
        }
      ]
    },
    "vie": {
      "preferred_label": "ta-lâng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một đơn vị trọng lượng khoảng 30 kilôgam, thời cổ đại dùng để đo các vật nặng hoặc dùng làm đơn vị tiền tệ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "他连得",
      "descriptions": [
        {
          "source": "acai",
          "description": "古代一种重量单位，约合30公斤，用于称量重物或作为货币价值单位。"
        }
      ]
    },
    "zht": {
      "preferred_label": "他連得",
      "descriptions": [
        {
          "source": "acai",
          "description": "古代用於稱量重物或作為貨幣價值的重量單位，約三十公斤。"
        }
      ]
    }
  },
