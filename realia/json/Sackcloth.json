  "localizations": {
    "eng": {
      "preferred_label": "Sackcloth",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Sackcloth",
          "article": "realia:Sackcloth",
          "description": "A coarse, rough material usually made from goat or camel hair, worn as a sign of mourning or repentance."
        }
      ]
    },
    "apd": {
      "preferred_label": "مسح",
      "descriptions": [
        {
          "source": "acai",
          "description": "قماش خشن بيتعمل في العادة من شعر الماعز أو وبر الجمال، وكانوا بيلبسوه كعلامة للحزن أو التوبة."
        }
      ]
    },
    "arb": {
      "preferred_label": "مِسْح",
      "descriptions": [
        {
          "source": "acai",
          "description": "قماش خشن يُصنع عادة من شعر الماعز أو الإبل، ويُلبس علامةً على الحداد أو التوبة."
        }
      ]
    },
    "bis": {
      "preferred_label": "rabis klos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan raf kaliko we oli mekem long hea blong nani no kamel, we man i werem olsem saen blong harem nogud no tanem tingting."
        }
      ]
    },
    "fra": {
      "preferred_label": "sac",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tissu grossier et rugueux, généralement fait de poils de chèvre ou de chameau, porté en signe de deuil ou de repentance."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tufafin makoki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani yadi mai kauri da ƙaiƙayi wanda aka saba yi daga gashin akuya ko raƙumi, da ake sawa a matsayin alamar makoki ko tuba."
        }
      ]
    },
    "hin": {
      "preferred_label": "टाट",
      "descriptions": [
        {
          "source": "acai",
          "description": "बकरे या ऊँट के बालों से बना एक मोटा, खुरदुरा कपड़ा, जिसे शोक या पश्चाताप के प्रतीक के रूप में पहना जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "akwa mkpe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Akwa siri ike nke na-akpụ akpụ nke a na-ejikarị ajị ewu maọbụ ajị kamel kpaa, nke a na-eyi dịka ihe ịrịba ama nke iru uju maọbụ nchegharị."
        }
      ]
    },
    "ind": {
      "preferred_label": "kain kabung",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kain kasar yang biasanya terbuat dari bulu kambing atau unta, dikenakan sebagai tanda perkabungan atau pertobatan."
        }
      ]
    },
    "nep": {
      "preferred_label": "भाङ्ग्रा",
      "descriptions": [
        {
          "source": "acai",
          "description": "सामान्यतया बाख्रा वा ऊँटको रौंबाट बनाइने खस्रो, मोटो कपडा, जुन शोक वा पश्चात्तापको प्रतीकको रूपमा लगाइन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "pano de saco",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um material áspero e grosseiro, geralmente feito de pelo de cabra ou camelo, usado como sinal de luto ou arrependimento."
        }
      ]
    },
    "rus": {
      "preferred_label": "Вретище",
      "descriptions": [
        {
          "source": "acai",
          "description": "Грубая, жесткая ткань, обычно изготавливаемая из козьей или верблюжьей шерсти, которую носили в знак скорби или покаяния."
        }
      ]
    },
    "spa": {
      "preferred_label": "cilicio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Material tosco y áspero, generalmente hecho de pelo de cabra o de camello, que se vestía como señal de duelo o arrepentimiento."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gunia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nguo ngumu na chafu, kwa kawaida iliyotengenezwa kwa manyoya ya mbuzi au ngamia, iliyovaliwa kama ishara ya maombolezo au toba."
        }
      ]
    },
    "tpi": {
      "preferred_label": "klos bilong sori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela strongpela na hevi laplap ol i save wokim long gras bilong mekmek o kamel, ol i save pasim olsem mak bilong bel hevi o sori long sin."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bao gai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại vải thô ráp thường làm từ lông dê hoặc lạc đà, được mặc như một dấu hiệu tang chế hoặc ăn năn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "麻布",
      "descriptions": [
        {
          "source": "acai",
          "description": "通常由山羊毛或骆驼毛制成的粗糙织物，穿在身上作为哀悼或忏悔的标志。"
        }
      ]
    },
    "zht": {
      "preferred_label": "麻布",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種粗糙的布料，通常由山羊毛或駱駝毛製成，穿戴作為哀悼或悔改的標誌。"
        }
      ]
    }
  },
