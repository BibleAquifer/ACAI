  "localizations": {
    "eng": {
      "preferred_label": "Sandal",
      "alternate_labels": [
        "Shoe"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Sandal",
          "article": "realia:Sandal",
          "description": "A type of footwear made of a leather or wooden sole, secured to the foot with thongs or straps."
        }
      ]
    },
    "apd": {
      "preferred_label": "نعل",
      "descriptions": [
        {
          "source": "acai",
          "description": "نوع من الأحذية متكون من نعل جلد أو خشب، ومربوط في الرجل بسيور أو أربطة."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَعْل",
      "descriptions": [
        {
          "source": "acai",
          "description": "نَوْعٌ مِنَ ٱلْأَحْذِيَةِ يَتَكَوَّنُ مِنْ نَعْلٍ جِلْدِيٍّ أَوْ خَشَبِيٍّ، يُثَبَّتُ فِي ٱلْقَدَمِ بِسُيُورٍ أَوْ أَرْبِطَةٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "sandel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kaen su we wol blong hem i blong leda o wud, we oli fasem long leg wetem ol smosmol rop o strap."
        }
      ]
    },
    "fra": {
      "preferred_label": "sandale",
      "descriptions": [
        {
          "source": "acai",
          "description": "Type de chaussure constituée d'une semelle en cuir ou en bois, fixée au pied par des lanières ou des courroies."
        }
      ]
    },
    "hau": {
      "preferred_label": "Takalmi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani nau’in takalmi da aka yi da tafin fata ko na itace, wanda ake ɗaurewa a ƙafa da igiyoyi ko marori."
        }
      ]
    },
    "hin": {
      "preferred_label": "जूती",
      "descriptions": [
        {
          "source": "acai",
          "description": "चमड़े या लकड़ी के तले से बना एक प्रकार का जूता, जिसे फीतों या पट्टियों से पाँव में बाँधा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "akpụkpọụkwụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụdị ihe e ji eyi nʼụkwụ nke e ji akpụkpọ anụ ma ọ bụ osisi mee ala ya, nke e jikwa eriri kechie nʼụkwụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "kasut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sejenis alas kaki yang dibuat dari sol kulit atau kayu, yang diikatkan pada kaki dengan tali atau sabuk."
        }
      ]
    },
    "nep": {
      "preferred_label": "जुत्ता",
      "descriptions": [
        {
          "source": "acai",
          "description": "छाला वा काठको पैतला भएको र फित्ता वा डोरीले खुट्टामा बाँधिने एक प्रकारको जुत्ता।"
        }
      ]
    },
    "por": {
      "preferred_label": "sandália",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um tipo de calçado composto de uma sola de couro ou madeira, presa ao pé com correias ou tiras."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сандалия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вид обуви, состоящий из кожаной или деревянной подошвы, прикрепляемой к ноге ремнями или завязками."
        }
      ]
    },
    "spa": {
      "preferred_label": "sandalia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tipo de calzado compuesto por una suela de cuero o madera, sujeta al pie mediante correas o tiras."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kiatu cha kamba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aina ya kiatu kilichotengenezwa kwa soli ya ngozi au ya mbao, inayofungwa mguuni kwa mikanda au kamba."
        }
      ]
    },
    "tpi": {
      "preferred_label": "su",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain su ol i wokim long let o plang diwai, na pasim long lek wantaim ol rop let o liklik strap."
        }
      ]
    },
    "vie": {
      "preferred_label": "Dép",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại giày dép có đế bằng da hoặc gỗ, được giữ chặt vào chân bằng các quai hoặc dây buộc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "凉鞋",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种鞋类，由皮革或木质鞋底制成，用皮条或带子固定在脚上。"
        }
      ]
    },
    "zht": {
      "preferred_label": "草鞋",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種由皮革或木質鞋底製成的鞋類，用皮帶或飾帶固定在腳上。"
        }
      ]
    }
  },
