  "localizations": {
    "eng": {
      "preferred_label": "Basket",
      "alternate_labels": [
        "Large Basket",
        "Cage"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Basket",
          "article": "realia:Basket",
          "description": "A large container made of woven material like grass or reeds, used for carrying or storing various items such as food."
        }
      ]
    },
    "apd": {
      "preferred_label": "قفة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وعاء كبير مصنوع من مواد منسوجة زي القش أو البوص، بيستعمل لحمل أو تخزين حاجات مختلفة زي الأكل."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَلَّة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وِعَاءٌ كَبِيرٌ مَصْنُوعٌ مِنْ مَوَادَّ مَنْسُوجَةٍ كَٱلْعُشْبِ أَوِ ٱلْقَصَبِ، يُسْتَخْدَمُ لِحَمْلِ أَوْ تَخْزِينِ أَشْيَاءَ مُخْتَلِفَةٍ كَٱلطَّعَامِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Basket",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala samting we oli wivim long gras no rop, we oli yusum blong karem no storem ol samting olsem kakae."
        }
      ]
    },
    "fra": {
      "preferred_label": "panier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un grand récipient fait de matière tressée comme des herbes ou des roseaux, utilisé pour transporter ou stocker divers éléments tels que de la nourriture."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwando",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban akwatin kaya da aka yi da saƙar abubuwa kamar ciyawa ko kuringa, wanda ake amfani da shi don ɗauka ko adana kayayyaki daban-daban kamar abinci."
        }
      ]
    },
    "hin": {
      "preferred_label": "टोकरी",
      "descriptions": [
        {
          "source": "acai",
          "description": "घास या सरकंडों जैसी बुनी हुई सामग्री से बना एक बड़ा पात्र, जिसका उपयोग भोजन जैसी विभिन्न वस्तुओं को ले जाने या रखने के लिए किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nkata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu arịa e ji ihe a kpara akpa dị ka ahịhịa maọbụ amị mee, nke a na-eji ebu maọbụ echekwa ihe dị iche iche dị ka nri."
        }
      ]
    },
    "ind": {
      "preferred_label": "bakul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wadah besar yang terbuat dari anyaman rumput atau buluh, digunakan untuk membawa atau menyimpan berbagai benda seperti makanan."
        }
      ]
    },
    "nep": {
      "preferred_label": "टोकरी",
      "descriptions": [
        {
          "source": "acai",
          "description": "खानेकुराजस्ता विभिन्‍न वस्तुहरू बोक्न वा भण्डारण गर्न प्रयोग गरिने घाँस वा निगालो आदिबाट बुनेको ठूलो भाँडो।"
        }
      ]
    },
    "por": {
      "preferred_label": "cesto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um recipiente grande feito de material trançado, como palha ou juncos, usado para carregar ou armazenar diversos itens, como alimentos."
        }
      ]
    },
    "rus": {
      "preferred_label": "корзина",
      "descriptions": [
        {
          "source": "acai",
          "description": "Большая емкость из плетеного материала, такого как трава или тростник, используемая для переноски или хранения различных предметов, например пищи."
        }
      ]
    },
    "spa": {
      "preferred_label": "cesta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recipiente grande fabricado de material tejido, como hierba o juncos, utilizado para transportar o almacenar diversos artículos, como comida."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kikapu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chombo kikubwa kilichotengenezwa kwa kusuka nyenzo kama vile nyasi au mafunjo, kinachotumiwa kubeba au kuhifadhi vitu mbalimbali kama vile chakula."
        }
      ]
    },
    "tpi": {
      "preferred_label": "basket",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bikpela samting ol i wokim long kanda, gras o wara-saksak bilong karim o putim ol kain kain samting olsem kaikai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Giỏ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đồ đựng lớn làm bằng vật liệu đan như cỏ hoặc lau sậy, dùng để mang hoặc chứa nhiều thứ như thực phẩm."
        }
      ]
    },
    "zhs": {
      "preferred_label": "篮子",
      "descriptions": [
        {
          "source": "acai",
          "description": "由草或芦苇等编织材料制成的大容器，用于携带或储存食物等各种物品。"
        }
      ]
    },
    "zht": {
      "preferred_label": "籃子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種用草或蘆葦等編織材料製成的大型容器，用於攜帶或存放食物等各種物品。"
        }
      ]
    }
  },
