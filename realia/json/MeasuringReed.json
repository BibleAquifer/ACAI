      "descriptions": [
        {
          "source": "acai",
          "gloss": "Measuring Reed",
          "article": "realia:MeasuringReed",
          "description": "A long stick or reed used for measuring lengths, usually around 3.1 meters."
        }
      ]
    },
    "apd": {
      "preferred_label": "قصبة قياس",
      "descriptions": [
        {
          "source": "acai",
          "description": "بوصة أو قصبة طويلة بتستخدم لقياس الأطوال، في الغالب طولها حوالي ٣.١ متر."
        }
      ]
    },
    "arb": {
      "preferred_label": "قصبة القياس",
      "descriptions": [
        {
          "source": "acai",
          "description": "عصا طويلة أو قصبة تُستخدم لقياس الأطوال، يبلغ طولها عادة نحو 3.1 أمتار."
        }
      ]
    },
    "bis": {
      "preferred_label": "longfala rula blong makem graon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan longfala stik no rid we oli stap yusum blong makem longfala blong ol samting, we plante taem i samting olsem 3.1 mita."
        }
      ]
    },
    "fra": {
      "preferred_label": "roseau à mesurer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Long bâton ou roseau utilisé pour mesurer des longueurs, généralement d'environ 3,1 mètres."
        }
      ]
    },
    "hau": {
      "preferred_label": "Karan awo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani dogon sanda ko ƙara da ake amfani da shi wajen auna tsawo, yawanci kusan mita 3.1."
        }
      ]
    },
    "hin": {
      "preferred_label": "नापने का सरकंडा",
      "descriptions": [
        {
          "source": "acai",
          "description": "लंबाई मापने के लिए उपयोग की जाने वाली एक लंबी छड़ी या सरकंडा, जो प्रायः लगभग 3.1 मीटर की होती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Achara e ji atụ ihe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ogologo osisi ma ọ bụ achara e ji atụ ogologo ihe, nke na-adịkarị ihe dị ka mita 3.1."
        }
      ]
    },
    "ind": {
      "preferred_label": "buluh pengukur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tongkat atau buluh panjang yang digunakan untuk mengukur panjang, biasanya sekitar 3,1 meter."
        }
      ]
    },
    "nep": {
      "preferred_label": "नाप्ने निगालो",
      "descriptions": [
        {
          "source": "acai",
          "description": "लम्बाइ नाप्न प्रयोग गरिने लामो लट्ठी वा निगालो, जुन प्रायः ३.१ मिटर जति लामो हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "caniço de medir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma vara longa ou cana usada para medir comprimentos, geralmente com cerca de 3,1 metros."
        }
      ]
    },
    "rus": {
      "preferred_label": "Трость измерения",
      "descriptions": [
        {
          "source": "acai",
          "description": "Длинная палка или тростник, использовавшиеся для измерения длины, обычно около 3,1 метра."
        }
      ]
    },
    "spa": {
      "preferred_label": "caña de medir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vara larga o caña utilizada para medir longitudes, generalmente de unos 3,1 metros."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwanzi wa kupimia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kijiti kirefu au mwanzi unaotumiwa kupimia urefu, kwa kawaida wenye takriban mita 3.1."
        }
      ]
    },
    "tpi": {
      "preferred_label": "stik mambu bilong metaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela longpela stik o mambu bilong metaim longpela bilong ol samting, longpela bilong en samting olsem 3.1 mita."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây sậy đo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cây gậy dài hoặc cây sậy dùng để đo chiều dài, thường dài khoảng 3,1 mét."
        }
      ]
    },
    "zhs": {
      "preferred_label": "量苇",
      "descriptions": [
        {
          "source": "acai",
          "description": "一根用于测量长度的长棍或芦苇，通常长约3.1米。"
        }
      ]
    },
    "zht": {
      "preferred_label": "量度的葦子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種用來測量長度的長棍或蘆葦，通常約長3.1公尺。"
        }
      ]
    }
  },
