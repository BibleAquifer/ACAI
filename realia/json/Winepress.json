      "descriptions": [
        {
          "source": "acai",
          "gloss": "Winepress",
          "article": "realia:Winepress",
          "description": "A basin or container where harvested grapes are trampled or squeezed to extract juice for making wine."
        }
      ]
    },
    "apd": {
      "preferred_label": "معصرة عنب",
      "descriptions": [
        {
          "source": "acai",
          "description": "حوض أو معصرة بيدوسوا فيها العنب المحصود أو يعصروه عشان يطلعوا العصير لعمل الخمرة."
        }
      ]
    },
    "arb": {
      "preferred_label": "مِعْصَرَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حوض أو إناء يُداس فيه العنب المحصود أو يُعصر لاستخراج عصيره لصنع الخمر."
        }
      ]
    },
    "bis": {
      "preferred_label": "ples blong mekem waen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hol o ples we oli putum frut blong grep long hem blong purumbut long hem o skwisim blong mekem wota blong hem i kamaot blong mekem waen."
        }
      ]
    },
    "fra": {
      "preferred_label": "pressoir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bassin ou cuve où les raisins vendangés sont foulés ou pressés pour extraire le jus destiné à la vinification."
        }
      ]
    },
    "hau": {
      "preferred_label": "wurin matsin inabi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban kwano ko rami inda ake tattaka ko matse 'ya'yan inabin da aka girbe don fitar da ruwansu domin yin ruwan inabi."
        }
      ]
    },
    "hin": {
      "preferred_label": "रसकुण्ड",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक कुण्ड या पात्र जहाँ दाखमधु (दाखरस) बनाने के लिए रस निकालने हेतु तोड़े गए अंगूरों को रौंदा या निचोड़ा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebe ịzọcha mmanya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ebe maọbụ ihe e ji azọcha maọbụ afanyekọta mkpụrụ vaịnị e wepụtara nʼubi iji wepụta mmiri ya maka ime mmanya."
        }
      ]
    },
    "ind": {
      "preferred_label": "tempat pemerasan anggur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wadah atau bak tempat buah anggur hasil panen diinjak-injak atau diperas untuk menghasilkan air anggur guna pembuatan minuman anggur."
        }
      ]
    },
    "nep": {
      "preferred_label": "दाखको कोल",
      "descriptions": [
        {
          "source": "acai",
          "description": "दाखमद्य बनाउन रस निकाल्‍नको लागि भित्र्याइएको दाखलाई कुल्‍चने वा निचोर्ने कुण्ड वा भाँडो।"
        }
      ]
    },
    "por": {
      "preferred_label": "lagar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um tanque ou recipiente onde uvas colhidas são pisadas ou espremidas para extrair o suco para a fabricação de vinho."
        }
      ]
    },
    "rus": {
      "preferred_label": "Точило",
      "descriptions": [
        {
          "source": "acai",
          "description": "Резервуар или емкость, где собранный виноград топчут или отжимают для получения сока при изготовлении вина."
        }
      ]
    },
    "spa": {
      "preferred_label": "lagar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Recipiente o cavidad donde se pisan o exprimen las uvas recolectadas para extraer el jugo con el fin de elaborar vino."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shinikizo la divai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bwawa au chombo ambamo zabibu zilizovunwa hukanyagwa au kukamuliwa ili kutoa maji ya kutengenezea divai."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tang bilong krungutim pikinini wain",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hul o tang ol i save krungutim o memeim ol pikinini wain insait long en bilong kisim wara bilong mekim wain."
        }
      ]
    },
    "vie": {
      "preferred_label": "Hầm ép nho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một bồn chứa hoặc đồ đựng nơi nho thu hoạch được giẫm đạp hoặc ép để lấy nước làm rượu nho."
        }
      ]
    },
    "zhs": {
      "preferred_label": "榨酒池",
      "descriptions": [
        {
          "source": "acai",
          "description": "用来踩踏或压榨收获的葡萄以提取汁液酿酒的池子或容器。"
        }
      ]
    },
    "zht": {
      "preferred_label": "壓酒池",
      "descriptions": [
        {
          "source": "acai",
          "description": "一個用來踩踏或壓榨收穫之葡萄以榨取汁液釀酒的水槽或容器。"
        }
      ]
    }
  },
