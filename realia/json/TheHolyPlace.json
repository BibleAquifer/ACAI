        }
      ]
    },
    "bis": {
      "preferred_label": "Rum we i Tabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rum insaed long Haos Tapolen mo Haos blong God long Jerusalem we oli stap mekem ol tabu kastom wosip long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "le lieu saint",
      "descriptions": [
        {
