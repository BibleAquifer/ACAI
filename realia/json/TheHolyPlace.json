        }
      ]
    },
    "hin": {
      "preferred_label": "पवित्र स्थान",
      "descriptions": [
        {
          "source": "acai",
          "description": "निवास-स्थान (तम्बू) और यरूशलेम के मन्दिर का भीतरी कक्ष जहाँ पवित्र अनुष्ठान किए जाते थे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebe Nsọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọnụụlọ dị nʼime nke Ụlọ Nzute na Ụlọnsọ Ukwu Jerusalem ebe a na-anọ arụ emume dị nsọ dị iche iche."
        }
      ]
    },
    "ind": {
      "preferred_label": "Tempat Kudus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ruang dalam dari Kemah Suci dan Bait Allah di Yerusalem tempat ritual-ritual kudus dilakukan."
        }
      ]
    },
    "nep": {
      "preferred_label": "पवित्रस्थान",
      "descriptions": [
        {
          "source": "acai",
          "description": "पवित्र वासस्थान र यरूशलेमको मन्दिरको भित्री कोठा जहाँ पवित्र विधिहरू सम्पन्न गरिन्थे।"
        }
      ]
    },
    "por": {
