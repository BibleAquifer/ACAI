          "description": "A small, pointed object driven into the ground or wall to hang things or secure tents."
        }
      ]
    },
    "apd": {
      "preferred_label": "وتد",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة صغيرة ومروّسة بيدقوها في الواطة أو الحيطة عشان يعلّقوا فيها الحاجات أو يثبتوا بيها الخيام."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَتَد",
      "descriptions": [
        {
          "source": "acai",
          "description": "أداة صغيرة مدببة تُدقّ في الأرض أو الحائط لتعليق الأشياء أو تثبيت الخيام."
        }
      ]
    },
    "bis": {
      "preferred_label": "Stik blong taetem rop",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol samting we i sap we oli kilim i go long graon o wol blong hangem ol samting o fasem ol haos tapolen."
        }
      ]
    },
    "fra": {
      "preferred_label": "pieu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit objet pointu enfoncé dans le sol ou dans un mur pour suspendre des objets ou fixer des tentes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Turke",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani ƙaramin abu mai tsini da ake kafawa a ƙasa ko a bango domin rataye kaya ko kafa tantuna."
        }
      ]
    },
    "hin": {
      "preferred_label": "खूंटा",
      "descriptions": [
        {
          "source": "acai",
          "description": "वस्तुओं को टांगने या तंबू को स्थिर करने के लिए ज़मीन या दीवार में ठोकी जाने वाली एक छोटी, नुकीली वस्तु।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ǹtu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere ihe dị nkọ a na-akpọgide nʼala ma ọ bụ nʼaja iji kwụgide ihe ma ọ bụ mee ka ụlọikwu kwụsie ike."
        }
      ]
    },
    "ind": {
      "preferred_label": "patok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Benda kecil dan runcing yang ditancapkan ke tanah atau dinding untuk menggantungkan barang atau menahan tenda."
        }
      ]
    },
    "nep": {
      "preferred_label": "किला",
      "descriptions": [
        {
          "source": "acai",
          "description": "चीजहरू झुन्ड्याउन वा पालहरूलाई बाँधेर अड्याउन भुइँ वा पर्खालमा ठोकिने सानो, तीखो वस्तु।"
        }
      ]
    },
    "por": {
      "preferred_label": "estaca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um objeto pontiagudo pequeno fincado no chão ou na parede para pendurar coisas ou fixar tendas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Кол",
      "descriptions": [
        {
          "source": "acai",
          "description": "Небольшой заостренный предмет, вбиваемый в землю или стену для подвешивания вещей или закрепления шатров."
        }
      ]
    },
    "spa": {
      "preferred_label": "estaca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Objeto pequeño y puntiagudo que se clava en el suelo o en una pared para colgar cosas o asegurar tiendas de campaña."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kigingi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu kidogo chenye ncha kinachopigiliwa ardhini au ukutani ili kutundikia vitu au kukazia mahema."
        }
      ]
    },
    "tpi": {
      "preferred_label": "nil bilong haus sel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik samting i sap ol i paitim i go insait long graun o banis bilong hangamapim ol samting o pasim ol haus sel."
        }
      ]
    },
    "vie": {
      "preferred_label": "cọc lều",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vật nhỏ, có đầu nhọn được đóng vào đất hoặc tường để treo đồ vật hoặc cố định lều."
        }
      ]
    },
    "zhs": {
      "preferred_label": "橛子",
      "descriptions": [
