  "localizations": {
    "eng": {
      "preferred_label": "Courtyard",
      "alternate_labels": [
        "Dwelling",
        "Palace",
        "Mansion",
        "Courtyard House",
        "Courtyard Temple"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Courtyard",
          "article": "realia:Courtyard",
          "description": "An open area surrounded by buildings, often found in temples, palaces, or houses."
        }
      ]
    },
    "apd": {
      "preferred_label": "حوش",
      "descriptions": [
        {
          "source": "acai",
          "description": "مساحة مكشوفة ومحوطة بمباني، وبتكون عادة في الهياكل، أو القصور، أو البيوت (حوش/فناء)."
        }
      ]
    },
    "arb": {
      "preferred_label": "دار",
      "descriptions": [
        {
          "source": "acai",
          "description": "مساحة مكشوفة تحيط بها الأبنية، وتوجد غالبًا في الهياكل أو القصور أو البيوت."
        }
      ]
    },
    "bis": {
      "preferred_label": "yad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan open ples we ol bilding o fenis i raonem hem, we i stap plante taem long ol haos tempol, ol palas, o ol haos."
        }
      ]
    },
    "fra": {
      "preferred_label": "parvis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un espace ouvert entouré de bâtiments, que l’on trouve souvent dans les temples, les palais ou les maisons."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fili",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filin da gine-gine suka kewaye, wanda galibi ake samu a haikali, fada, ko gidaje."
        }
      ]
    },
    "hin": {
      "preferred_label": "आँगन",
      "descriptions": [
        {
          "source": "acai",
          "description": "भवनों से घिरा एक खुला क्षेत्र, जो प्रायः मंदिरों, महलों या घरों में पाया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ogige",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpaghara mepere emepe nke ụlọ gbara gburugburu, nke a na-ahụkarị nʼụlọ nsọ, nʼobí eze, ma ọ bụ nʼụlọ ndị mmadụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "pelataran",
      "descriptions": [
        {
          "source": "acai",
          "description": "Area terbuka yang dikelilingi oleh bangunan, sering kali terdapat di bait suci, istana, atau rumah."
        }
      ]
    },
    "nep": {
      "preferred_label": "चोक",
      "descriptions": [
        {
          "source": "acai",
          "description": "भवनहरूले घेरिएको खुला ठाउँ, जुन प्रायः मन्दिर, दरबार वा घरहरूमा पाइन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "pátio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma área aberta cercada por edifícios, frequentemente encontrada em templos, palácios ou casas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Двор",
      "descriptions": [
        {
          "source": "acai",
          "description": "Открытая площадка, окруженная строениями, часто при храмах, дворцах или домах."
        }
      ]
    },
    "spa": {
      "preferred_label": "atrio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Área abierta rodeada de edificios, a menudo presente en templos, palacios o casas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eneo la wazi lililozungukwa na majengo, mara nyingi hupatikana kwenye hekalu, majumba ya kifalme, au nyumba."
        }
      ]
    },
    "tpi": {
      "preferred_label": "banis bilong haus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples klia ol haus i raunim, ol i save lukim long ol tempel, haus king o haus manmeri."
        }
      ]
    },
    "vie": {
      "preferred_label": "sân",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một khoảng sân trống được bao quanh bởi các công trình xây dựng, thường thấy trong đền thờ, cung điện, hoặc nhà ở."
        }
      ]
    },
    "zhs": {
      "preferred_label": "院子",
      "descriptions": [
        {
          "source": "acai",
          "description": "被建筑物环绕的开阔区域，常见于圣殿、宫殿或房屋中。"
        }
      ]
    },
    "zht": {
      "preferred_label": "院子",
      "descriptions": [
        {
          "source": "acai",
          "description": "被建築物環繞的露天區域，常見於聖殿、宮殿或房屋中。"
        }
      ]
    }
  },
