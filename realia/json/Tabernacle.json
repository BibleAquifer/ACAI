  "localizations": {
    "eng": {
      "preferred_label": "Tabernacle",
      "alternate_labels": [
        "Sanctuary",
        "Tent",
        "Tabernacle Tent",
        "Tabernacle Entrance"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Tabernacle",
          "article": "realia:Tabernacle",
          "description": "A large, movable tent structure used by the Jews as a place of worship before the Temple was built."
        }
      ]
    },
    "apd": {
      "preferred_label": "خيمة الاجتماع",
      "descriptions": [
        {
          "source": "acai",
          "description": "خيمة كبيرة ومتحركة كان بيستعملوها اليهود كمكان للعبادة قبل ما ينبني الهيكل."
        }
      ]
    },
    "arb": {
      "preferred_label": "خيمة الاجتماع / المسكن",
      "descriptions": [
        {
          "source": "acai",
          "description": "بنية خيمة كبيرة قابلة للنقل، استخدمها بنو إسرائيل كمكان للعبادة قبل بناء الهيكل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Haos Tapolen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala haos tapolen we oli save muvumutetem, we ol man Jiu oli bin stap yusum olsem ples blong wosip bifo oli bildim Haos Tapu."
        }
      ]
    },
    "fra": {
      "preferred_label": "tabernacle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une grande structure de tente mobile utilisée par les Juifs comme lieu de culte avant la construction du Temple."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tabanakul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban tantin da ake iya ɗauka wanda Yahudawa suka yi amfani da shi a matsayin wurin sujada kafin a gina Haikali."
        }
      ]
    },
    "hin": {
      "preferred_label": "निवास-स्थान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक बड़ा, सचल तंबू-रूपी ढाँचा जिसका उपयोग यहूदी लोग मंदिर बनने से पहले आराधना के स्थान के रूप में करते थे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ụlọ nzute",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu ụlọ ikwu a na-ebugharị ebugharị nke ndị Juu na-eji dị ka ebe ofufe tupu e wuo Ụlọnsọ Ukwu ahụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "Kemah Suci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Struktur tenda besar yang dapat dipindahkan, digunakan oleh orang Yahudi sebagai tempat ibadah sebelum Bait Suci dibangun."
        }
      ]
    },
    "nep": {
      "preferred_label": "पवित्र वासस्थान",
      "descriptions": [
        {
          "source": "acai",
          "description": "मन्दिर निर्माण हुनुभन्दा अघि यहूदीहरूले आराधना गर्ने ठाउँको रूपमा प्रयोग गरेको एक ठूलो, सार्न सकिने पालको संरचना।"
        }
      ]
    },
    "por": {
      "preferred_label": "tabernáculo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma estrutura móvel em forma de grande tenda, usada pelos judeus como local de adoração antes da construção do Templo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Скиния",
      "descriptions": [
        {
          "source": "acai",
          "description": "Большое переносное шатровое сооружение, служившее иудеям местом поклонения Богу до постройки Храма."
        }
      ]
    },
    "spa": {
      "preferred_label": "tabernáculo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gran estructura de tienda móvil utilizada por los judíos como lugar de culto antes de la construcción del templo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Maskani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Muundo mkubwa wa hema linalohamishika uliotumiwa na Wayahudi kama mahali pa ibada kabla ya Hekalu kujengwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "haus sel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela haus sel ol Juda i save karim raun na yusim bilong lotu bipo long ol i wokim Tempel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đền Tạm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một công trình dạng lều lớn, có thể di chuyển được, người Do Thái dùng làm nơi thờ phượng trước khi Đền Thờ được xây dựng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "圣幕",
      "descriptions": [
        {
          "source": "acai",
          "description": "在建造圣殿之前，犹太人作为敬拜场所使用的一种大型可移动帐幕建筑。"
        }
      ]
    },
    "zht": {
      "preferred_label": "帳幕",
      "descriptions": [
        {
          "source": "acai",
          "description": "聖殿建成之前，猶太人用作敬拜場所的大型可移動帳篷結構。"
        }
      ]
    }
  },
