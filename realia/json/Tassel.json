  "localizations": {
    "eng": {
      "preferred_label": "Tassel",
      "alternate_labels": [
        "Fringe",
        "Lock",
        "Edge",
        "Hem"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Tassel",
          "article": "realia:Tassel",
          "description": "A bunch of threads or fibers attached to the edges of garments, often worn on the corners of Jewish clothing."
        }
      ]
    },
    "apd": {
      "preferred_label": "هدّاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "مجموعة خيوط أو ألياف مربوطة في أطراف الهدوم، وكان بيلبسوها في الغالب في أركان هدوم اليهود."
        }
      ]
    },
    "arb": {
      "preferred_label": "هُدْب",
      "descriptions": [
        {
          "source": "acai",
          "description": "حزمة من الخيوط أو الألياف تُثبت على أطراف الثياب، وكانت تُوضع غالبًا على زوايا ملابس اليهود."
        }
      ]
    },
    "bis": {
      "preferred_label": "tasel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bandel tret no rop we oli somap long ol en blong klos, mo ol man Jiu oli stap werem long ol kona blong klos blong olgeta."
        }
      ]
    },
    "fra": {
      "preferred_label": "frange",
      "descriptions": [
        {
          "source": "acai",
          "description": "Touffe de fils ou de fibres fixée aux bords des vêtements, souvent portée aux coins des vêtements juifs."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tuntu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙunshin zaruruwa da aka maƙala a gefen tufafi, galibi ana sawa a kusurwoyin tufafin Yahudawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "झालर",
      "descriptions": [
        {
          "source": "acai",
          "description": "वस्त्रों के छोर पर लगे धागों या रेशों का एक गुच्छा, जिसे अक्सर यहूदी वस्त्रों के कोनों पर लगाया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "eriri akwa a tụrụ atụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ukwu eriri akwa ma ọ bụ ihe a kpara akpa a kụnyere nʼọnụ uwe, nke a na-adụkarị nʼakụkụ uwe ndị Juu."
        }
      ]
    },
    "ind": {
      "preferred_label": "jumbai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seikat benang atau serat yang dipasang pada ujung pakaian, sering kali dikenakan pada sudut-sudut pakaian orang Yahudi."
        }
      ]
    },
    "nep": {
      "preferred_label": "झुम्का",
      "descriptions": [
        {
          "source": "acai",
          "description": "पोशाकको किनारहरूमा गाँसिने धागो वा रेसाहरूको गुच्छा, जुन प्रायः यहूदी पोशाकका कुनाहरूमा लगाइन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "franja",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um conjunto de fios ou fibras preso às bordas das vestimentas, frequentemente usado nas extremidades das roupas judaicas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Кисть",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пучок нитей или волокон, прикрепляемый к краям одежды; обычно носился на углах иудейских одеяний."
        }
      ]
    },
    "spa": {
      "preferred_label": "borla",
      "descriptions": [
        {
          "source": "acai",
          "description": "Manojo de hilos o fibras fijado a los bordes de las vestiduras, que solía llevarse en las esquinas de la ropa judía."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kishada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kifungu cha nyuzi zilizounganishwa kwenye pindo za mavazi, mara nyingi kilichovaliwa kwenye pembe za mavazi ya Kiyahudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "bilas bilong arere bilong klos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bilas ol i wokim long string o tred bilong pasim long arere bilong laplap o klos bilong ol Juda."
        }
      ]
    },
    "vie": {
      "preferred_label": "tua áo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chùm sợi hoặc chỉ được đính vào viền áo, thường mang ở các góc vạt áo của người Do Thái."
        }
      ]
    },
    "zhs": {
      "preferred_label": "穗子",
      "descriptions": [
        {
          "source": "acai",
          "description": "附在衣服边缘的一束线或纤维，常佩戴在犹太人衣服的四角上。"
        }
      ]
    },
    "zht": {
      "preferred_label": "繸子",
      "descriptions": [
        {
          "source": "acai",
          "description": "附於衣服邊緣的一束線或纖維，常綴於猶太人衣服的四角。"
        }
      ]
    }
  },
