        }
      ]
    },
    "bis": {
      "preferred_label": "mina",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan yuniti blong skelem hevi we i samwe long 0.6 kilogram mo i semkaen long 50 sekel, we oli yusum blong pem samting."
        }
      ]
    },
    "fra": {
      "preferred_label": "mine",
