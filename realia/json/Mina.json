        {
          "source": "acai",
          "gloss": "Mina",
          "article": "realia:Mina",
          "description": "A unit of weight about 0.6 kilograms and equal to 50 shekels, used for payment."
        }
      ]
    },
    "apd": {
      "preferred_label": "منا",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة وزنية وزنها حولي 0.6 كيلوجرام وتساوي 50 شاقل، بتستعمل للدفع."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَنّ",
      "descriptions": [
        {
          "source": "acai",
