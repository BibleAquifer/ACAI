  "localizations": {
    "eng": {
      "preferred_label": "Cake",
      "alternate_labels": [
        "Bread"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Cake",
          "article": "realia:Cake",
          "description": "A type of high-quality bread made from fine flour and sometimes used in religious sacrifices."
        }
      ]
    },
    "apd": {
      "preferred_label": "قرص",
      "descriptions": [
        {
          "source": "acai",
          "description": "نوع من العيش الفاخر المصنوع من دقيق ناعم، وكان أحياناً بيستعمل في الذبائح الدينية."
        }
      ]
    },
    "arb": {
      "preferred_label": "قُرْص",
      "descriptions": [
        {
          "source": "acai",
          "description": "نَوْعٌ مِنَ ٱلْخُبْزِ ٱلْفَاخِرِ ٱلْمَصْنُوعِ مِنَ ٱلدَّقِيقِ ٱلنَّقِيِّ، وَيُسْتَخْدَمُ أَحْيَانًا فِي ٱلذَّبَائِحِ ٱلدِّينِيَّةِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "kek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kaen gudfala bred we oli wokem long flaoa we i beswan mo samtaem oli stap yusum long ol sakrefaes long God."
        }
      ]
    },
    "fra": {
      "preferred_label": "gâteau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Type de pain de qualité supérieure fait de fleur de farine et parfois utilisé dans des sacrifices religieux."
        }
      ]
    },
    "hau": {
      "preferred_label": "waina",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani irin burodi mai daraja da aka yi da gari mai laushi, kuma a wasu lokuta ana amfani da shi a hadayun addini."
        }
      ]
    },
    "hin": {
      "preferred_label": "फुलका",
      "descriptions": [
        {
          "source": "acai",
          "description": "उत्तम मैदे से बनी एक प्रकार की रोटी, जिसका उपयोग कभी-कभी धार्मिक बलिदानों में किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Achịcha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụdị achịcha dị mma nke ukwuu nke e ji ụtụ ọka a kwọrọ nke ọma mee ma na-ejikarị ya eme ihe nʼàjà okpukpe."
        }
      ]
    },
    "ind": {
      "preferred_label": "kue",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sejenis roti berkualitas tinggi yang dibuat dari tepung halus dan terkadang digunakan dalam kurban keagamaan."
        }
      ]
    },
    "nep": {
      "preferred_label": "रोटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मसिनो पीठोबाट बनाइएको उच्च गुणस्तरको एक प्रकारको रोटी, जुन कहिलेकाहीँ धार्मिक बलिदानहरूमा प्रयोग गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "bolo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um tipo de pão de alta qualidade feito de farinha fina e às vezes usado em sacrifícios religiosos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Лепёшка",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вид хлеба высокого качества из тонкой муки, иногда используемый в религиозных жертвоприношениях."
        }
      ]
    },
    "spa": {
      "preferred_label": "torta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tipo de pan de alta calidad elaborado con harina fina y que a veces se utilizaba en sacrificios religiosos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Andazi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aina ya mkate au andazi la ubora wa juu lililotengenezwa kwa unga laini na ambalo nyakati nyingine lilitumiwa katika dhabihu za kidini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain gutpela bret ol i wokim long gutpela plaua tru na sampela taim ol i save ofaim long ol mekim ofa bilong lotu."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bánh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại bánh làm bằng bột mịn có chất lượng tốt, đôi khi được dùng trong các tế lễ tôn giáo."
        }
      ]
    },
    "zhs": {
      "preferred_label": "饼",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种由精细面粉制成的高品质饼，有时用于宗教祭祀。"
        }
      ]
    },
    "zht": {
      "preferred_label": "餅",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種用細麵粉製成的高品質餅，有時用於宗教祭祀。"
        }
      ]
    }
  },
