        }
      ]
    },
    "arb": {
      "preferred_label": "مِنْشَفَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "قِطْعَةٌ مِنَ ٱلْقُمَاشِ تُسْتَخْدَمُ لِلتَّنْشِيفِ، وَغَالِبًا مَا تَكُونُ مَصْنُوعَةً مِنَ ٱلْكَتَّانِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "tawel",
