  "localizations": {
    "eng": {
      "preferred_label": "Rope",
      "alternate_labels": [
        "Cord",
        "String",
        "Bands"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rope",
          "article": "realia:Rope",
          "description": "A thick cord made by twisting or braiding several strands of material like palm fibers, linen, or reeds, used for tying and securing things."
        }
      ]
    },
    "apd": {
      "preferred_label": "حبل",
      "descriptions": [
        {
          "source": "acai",
          "description": "حبل تخين معمول من لوي أو ضفر كذا طاقة من مواد زي ليف النخل أو الكتان أو القصب، بيستعمل لربط الحاجات وتثبيتها."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَبْل",
      "descriptions": [
        {
          "source": "acai",
          "description": "حبل سميك مصنوع من فتل أو جدل عدة طاقات من مواد مثل ألياف النخيل أو الكتان أو القصب، يُستخدم للربط وتثبيت الأشياء."
        }
      ]
    },
    "bis": {
      "preferred_label": "rop",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tikfala rop we oli wokem taem oli tantanem no plekem plante smol rop tugeta olsem rop blong pamtri, linen, no rigit, we oli yusum blong fasem mo holem ol samting."
        }
      ]
    },
    "fra": {
      "preferred_label": "corde",
      "descriptions": [
        {
          "source": "acai",
          "description": "Corde épaisse fabriquée en tordant ou en tressant plusieurs brins de matériaux tels que des fibres de palmier, du lin ou des roseaux, utilisée pour attacher et fixer des choses."
        }
      ]
    },
    "hau": {
      "preferred_label": "Igiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kauri-kaurin zare da ake yi ta wajen murɗa ko saƙa zarurruka da dama na abubuwa kamar zarurrukan dabino, lalloli, ko ciyawa, wanda ake amfani da shi wajen ɗaurewa da tsare abubuwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "रस्सी",
      "descriptions": [
        {
          "source": "acai",
          "description": "ताड़ के रेशों, सन या नरकट जैसी सामग्रियों के कई लड़ों को आपस में बटकर या गूँथकर बनाई गई एक मोटी डोरी, जिसका उपयोग चीजों को बाँधने और सुरक्षित करने के लिए किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ụdọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụdọ dị arọ ma siri ike nke e jiri ihe dịka akwara nkwụ, linen, maọbụ efe tụọ ma kpaa, nke a na-eji ekechi ma na-eke ihe."
        }
      ]
    },
    "ind": {
      "preferred_label": "tali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tali tebal yang dibuat dengan memuntal atau mengepang beberapa serat bahan seperti serat kurma, linen, atau gelagah, yang digunakan untuk mengikat dan mengamankan barang."
        }
      ]
    },
    "nep": {
      "preferred_label": "डोरी",
      "descriptions": [
        {
          "source": "acai",
          "description": "खजुरको रेसा, सुती वा नर्कटजस्ता सामग्रीका धेरै लट्ठालाई बटारेर वा बाटेर बनाइएको बाक्लो डोरी, जुन वस्तुहरू बाँध्न र सुरक्षित राख्न प्रयोग गरिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "corda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma corda grossa feita pela torção ou entrelaçamento de vários fios de materiais como fibras de palmeira, linho ou juncos, usada para amarrar e prender coisas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Веревка",
      "descriptions": [
        {
          "source": "acai",
          "description": "Толстая веревка, скрученная или сплетенная из нескольких прядей волокон (пальмовых, льняных или тростниковых), используемая для связывания и закрепления предметов."
        }
      ]
    },
    "spa": {
      "preferred_label": "cuerda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cuerda gruesa hecha retorciendo o trenzando varias hebras de material como fibras de palmera, lino o juncos, utilizada para atar y asegurar cosas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kamba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ukanda mnene uliotengenezwa kwa kusokota au kusuka nyuzi kadhaa za vitu kama vile kamba za mitende, kitani, au matete, unaotumiwa kufunga na kukaza vitu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "baklain",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bikpela rop ol i wokim long pasim o bilas wantaim planti tret bilong samting olsem pam, linen, o wara rop, ol i yusim bilong pasim na taitim ol samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Dây thừng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một sợi dây dày được làm bằng cách vặn hoặc bện nhiều sợi vật liệu như sợi cọ, lanh hoặc sậy, dùng để buộc và giữ chặt đồ vật."
        }
      ]
    },
    "zhs": {
      "preferred_label": "绳索",
      "descriptions": [
        {
          "source": "acai",
          "description": "由棕榈纤维、亚麻或芦苇等多种材料的若干股搓捻或编织而成的粗绳，用于捆绑和固定物品。"
        }
      ]
    },
    "zht": {
      "preferred_label": "繩子",
      "descriptions": [
        {
          "source": "acai",
          "description": "用棕櫚纖維、亞麻或蘆葦等幾股材料扭絞或編織而成的粗繩，用於捆綁和固定物品。"
        }
      ]
    }
  },
