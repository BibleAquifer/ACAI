  "localizations": {
    "eng": {
      "preferred_label": "Belt",
      "alternate_labels": [
        "Girdle",
        "Waistband"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Belt",
          "article": "realia:Belt",
          "description": "A strip of linen or leather worn around the waist to hold a robe in place and sometimes used to carry money or other items."
        }
      ]
    },
    "apd": {
      "preferred_label": "حزام",
      "descriptions": [
        {
          "source": "acai",
          "description": "سير من كتان أو جلد بيلبسوهو حولين الوسط عشان يمسك التوب أو الجلابية، وأحياناً بيشيلوا فيهو قروش أو حاجات تانية."
        }
      ]
    },
    "arb": {
      "preferred_label": "مِنْطَقَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "شريطٌ من الكَتّان أو الجلد يُلَفُّ حول الخَصر لشدّ الثوب وتثبيته، وكان يُستخدَم أحيانًا لحمل المال أو أمتعة أخرى."
        }
      ]
    },
    "bis": {
      "preferred_label": "belt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pis letaklos o kaliko we man i fasem raon long wes blong holem klos blong hem, mo samtaem oli yusum blong karem mane o ol narafala samting."
        }
      ]
    },
    "fra": {
      "preferred_label": "ceinture",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bande de lin ou de cuir portée autour de la taille pour maintenir un vêtement en place et parfois utilisée pour porter de l'argent ou d'autres objets."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ɗamara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faffadan ɗan yanki na lilin ko fata da ake ɗaurawa a ƙugu don riƙe riga, a wasu lokutan kuma ana amfani da shi don ɗaukar kuɗi ko wasu abubuwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "कमरबन्द",
      "descriptions": [
        {
          "source": "acai",
          "description": "सन (लिनन) या चमड़े की एक पट्टी जिसे कमर के चारों ओर चोगे को व्यवस्थित रखने के लिए बाँधा जाता था और कभी-कभी पैसे या अन्य वस्तुएँ रखने के लिए इस्तेमाल किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe okike úkwù",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eriri linin ma ọ bụ akpụkpọ anụ a na-eke nʼúkwù iji jide uwe mwụda nʼọnọdụ ya, mgbe ụfọdụ a na-ejikwa ya ebu ego ma ọ bụ ihe ndị ọzọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "ikat pinggang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Carik kain lenan atau kulit yang dikenakan di pinggang untuk mengikat jubah di tempatnya dan kadang-kadang digunakan untuk membawa uang atau barang lainnya."
        }
      ]
    },
    "nep": {
      "preferred_label": "पेटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "लुगालाई कसिलो पार्न र कहिलेकाहीँ पैसा वा अन्य वस्तुहरू बोक्न कम्मर वरिपरि बाँधिने सनपाट वा छालाको फित्ता वा पटुका।"
        }
      ]
    },
    "por": {
      "preferred_label": "cinto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma tira de linho ou couro usada ao redor da cintura para prender uma túnica e, às vezes, usada para carregar dinheiro ou outros objetos."
        }
      ]
    },
    "rus": {
      "preferred_label": "пояс",
      "descriptions": [
        {
          "source": "acai",
          "description": "Полоса ткани или кожи, надеваемая на талию для поддержания одежды, а иногда для ношения денег или других предметов."
        }
      ]
    },
    "spa": {
      "preferred_label": "cinturón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tira de lino o cuero que se lleva alrededor de la cintura para sujetar la vestidura y que a veces se utiliza para llevar dinero u otros objetos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mkanda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Utepe wa kitani au ngozi unaovaliwa kiunoni ili kushikilia joho mahali pake na wakati mwingine hutumika kubeba fedha au vitu vingine."
        }
      ]
    },
    "tpi": {
      "preferred_label": "let",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik hap laplap o let ol i save pasim long bel bilong holim klos o long karim mani na ol arapela samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "dây thắt lưng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một dải vải lanh hoặc da đeo quanh thắt lưng để giữ áo choàng và đôi khi dùng để mang theo tiền hoặc các vật dụng khác."
        }
      ]
    },
    "zhs": {
      "preferred_label": "腰带",
      "descriptions": [
        {
          "source": "acai",
          "description": "一条系在腰间的亚麻或皮革带子，用于固定袍子，有时也用于携带金钱或其他物品。"
        }
      ]
    },
    "zht": {
      "preferred_label": "腰帶",
      "descriptions": [
        {
          "source": "acai",
          "description": "一條繫在腰間的細長亞麻布或皮革帶子，用來固定長袍，有時也用於攜帶金錢或其他物品。"
        }
      ]
    }
  },
