  "localizations": {
    "eng": {
      "preferred_label": "Lampstand",
      "alternate_labels": [
        "Calyx",
        "Branch",
        "Arm"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Lampstand",
          "article": "realia:Lampstand",
          "description": "A decorative stand with branches designed to hold oil lamps, used in the Hebrew tabernacle."
        }
      ]
    },
    "apd": {
      "preferred_label": "منارة",
      "descriptions": [
        {
          "source": "acai",
          "description": "قاعدة للزينة فيها فروع معمولة عشان تشيل سرج زيت، كانت بتستعمل في خيمة الاجتماع العبرية."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَنَارَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حامل مزخرف ذو شُعب صُمم لحمل سرج الزيت، كان يُستخدم في خيمة الاجتماع العبرية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ples blong Putum Laet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan naesfala stamba we i gat ol han blong holem ol laet we oli laet long oel, we oli yusum insaed long tapolen haos blong ol man Hibru."
        }
      ]
    },
    "fra": {
      "preferred_label": "chandelier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Support décoratif à branches conçu pour porter des lampes à huile, utilisé dans le tabernacle hébreu."
        }
      ]
    },
    "hau": {
      "preferred_label": "Wurin ajiye fitila (Tabanakul)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kyakkyawan wurin ajiye fitila mai rassa da aka ƙera don ɗaukar fitilun mai, wanda aka yi amfani da shi a cikin tabanakul na Ibraniyawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "दीवट",
      "descriptions": [
        {
          "source": "acai",
          "description": "इब्रानी मिलापवाले तम्बू में इस्तेमाल होने वाला एक शाखाओं वाला अलंकृत स्टैंड, जिसे तेल के दीपक रखने के लिए बनाया गया था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ihe ịdọkwasị oriọna",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe ịdọkwasị oriọna a chọrọ mma nke nwere alaka dị iche iche a haziri ka ọ na-ebu oriọna mmanụ, nke a na-eji nʼime ụlọ nzute ndị Hibru."
        }
      ]
    },
    "ind": {
      "preferred_label": "kandil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kandil dekoratif bercabang yang dirancang untuk menopang lampu minyak, digunakan di Kemah Suci orang Ibrani."
        }
      ]
    },
    "nep": {
      "preferred_label": "सामदान",
      "descriptions": [
        {
          "source": "acai",
          "description": "हिब्रू वासस्थानमा प्रयोग गरिने, तेलका बत्तीहरू राख्‍नका निम्ति हाँगाहरू भएको एक सजाइएको सामदान वा स्ट्यान्ड।"
        }
      ]
    },
    "por": {
      "preferred_label": "candelabro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um suporte decorativo com braços projetado para sustentar lâmpadas a óleo, usado no tabernáculo hebreu."
        }
      ]
    },
    "rus": {
      "preferred_label": "Светильник",
      "descriptions": [
        {
          "source": "acai",
          "description": "Декоративная подставка с ветвями, предназначенная для масляных ламп и использовавшаяся в еврейской скинии."
        }
      ]
    },
    "spa": {
      "preferred_label": "candelabro del tabernáculo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Soporte decorativo con brazos diseñado para sostener lámparas de aceite, utilizado en el tabernáculo hebreo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kinara cha taa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kinara chenye mapambo na matawi kilichoundwa kushikilia taa za mafuta, kilichotumiwa katika hema ya kukutania ya Waebrania."
        }
      ]
    },
    "tpi": {
      "preferred_label": "stik lam bilong haus sel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela naispela stik bilong holim lam i gat ol han, ol i wokim bilong holim ol lam wel, em ol i save yusim insait long haus sel bilong ol Hibru."
        }
      ]
    },
    "vie": {
      "preferred_label": "chân đèn bảy nhánh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chân đèn trang trí có các nhánh dùng để đỡ các đèn dầu, được dùng trong đền tạm của người Hê-bơ-rơ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "金灯台",
      "descriptions": [
        {
          "source": "acai",
          "description": "希伯来会幕中使用的带分枝的装饰性支架，用于放置油灯。"
        }
      ]
    },
    "zht": {
      "preferred_label": "金燈臺",
      "descriptions": [
        {
          "source": "acai",
          "description": "希伯來會幕中使用的裝飾性分枝台架，設計用來承放油燈。"
        }
      ]
    }
  },
