      "descriptions": [
        {
          "source": "acai",
          "gloss": "Wheel",
          "article": "realia:Wheel",
          "description": "A circular object with a central hub, spokes, and a rim, designed to rotate around an axle."
        }
      ]
    },
    "apd": {
      "preferred_label": "عجلة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاجة دائرية فيها صرة في النص، وسلوك، وطارة، ومصنوعة عشان تلف حولين محور."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَكَرَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "جِسْمٌ مُسْتَدِيرٌ ذُو مِحْوَرٍ مَرْكَزِيٍّ وَأَسْلَاكٍ أَوْ عِيدَانٍ وَإِطَارٍ، مُصَمَّمٌ لِلدَّوَرَانِ حَوْلَ مِحْوَرٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "wil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan raon samting we i gat haf long senta, ol spesel wud o aean (spok), mo wan rim, we oli mekem blong i tanem raon long wan aksel."
        }
      ]
    },
    "fra": {
      "preferred_label": "roue",
      "descriptions": [
        {
          "source": "acai",
          "description": "Objet circulaire constitué d'un moyeu central, de rayons et d'une jante, conçu pour tourner autour d'un essieu."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙafar keke",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani abu mai siffar da’ira mai cibiya da kuma kewayen da aka ƙera don yă dinga juyawa a kan gatari."
        }
      ]
    },
    "hin": {
      "preferred_label": "पहिया",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक धुरी के चारों ओर घूमने के लिए डिज़ाइन की गई गोल वस्तु, जिसमें बीच की नाभि, तीलियाँ और पहिया-घेरा (रिम) होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụkwụ ụgbọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe dị okirikiri nwere ihe etiti, mkpọ, na okirikiri dị nʼèzí, nke a haziri ka ọ na-agbagharị nʼelu okporo ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "roda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Benda bulat dengan poros pusat, jeruji, dan pelek, yang dirancang untuk berputar mengelilingi poros."
        }
      ]
    },
    "nep": {
      "preferred_label": "पाङ्ग्रा",
      "descriptions": [
        {
          "source": "acai",
          "description": "धुराको वरिपरि घुम्नका निम्ति बनाइएको बीचमा नाभी, दाँती वा आराहरू, र घेरा भएको गोलो वस्तु।"
        }
      ]
    },
    "por": {
      "preferred_label": "roda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um objeto circular com um cubo central, raios e um aro, projetado para girar em torno de um eixo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Колесо",
      "descriptions": [
        {
          "source": "acai",
          "description": "Круглый предмет со ступицей, спицами и ободом, предназначенный для вращения вокруг оси."
        }
      ]
    },
    "spa": {
      "preferred_label": "rueda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Objeto circular con un eje central, rayos y una llanta, diseñado para girar alrededor de un eje."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gurudumu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kitu cha mviringo chenye kitovu cha katikati, tindi, na duara ya nje, kilichoundwa ili kuzunguka kwenye ekseli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "wil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela raunpela samting i gat hap namel, ol spouk, na arere bilong en, em ol i wokim bilong tantanim long wanpela aksil."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bánh xe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vật hình tròn có trục ở giữa, các nan hoa và vành xe, được thiết kế để quay quanh một trục."
        }
      ]
    },
    "zhs": {
      "preferred_label": "轮子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种由轮毂、轮辐和轮辋组成的圆形物体，设计为围绕轮轴旋转。"
        }
      ]
    },
    "zht": {
      "preferred_label": "輪子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種由輪轂、輻條和輪圈組成的圓形物件，設計圍繞軸心旋轉。"
        }
      ]
    }
  },
