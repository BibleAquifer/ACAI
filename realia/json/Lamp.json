    },
    "hin": {
      "preferred_label": "दीपक",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिट्टी का एक छोटा बर्तन जिसमें तेल और बत्ती भरी होती है और जिसका उपयोग प्रकाश के स्रोत के रूप में किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Oriọna",
      "descriptions": [
        {
