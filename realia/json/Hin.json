  "localizations": {
    "eng": {
      "preferred_label": "Hin",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hin",
          "article": "realia:Hin",
          "description": "A unit of liquid measurement in the Bible, roughly equal to 6 liters or 6 quarts."
        }
      ]
    },
    "apd": {
      "preferred_label": "هين",
      "descriptions": [
        {
          "source": "acai",
          "description": "وحدة لقياس السوايل في الكتاب المقدس، بتعادل حوالي 6 لتر تقريباً."
        }
      ]
    },
    "arb": {
      "preferred_label": "هِين",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَحدَةُ قِياسٍ لِلسَّوائِلِ في الكِتابِ المُقدَّسِ، تُعادِلُ نَحوَ 6 لِتراتٍ."
        }
      ]
    },
    "bis": {
      "preferred_label": "hin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan mak blong skelem ol samting we oli olsem wota o likwid long Baebol, we i klosap sem mak long 6 lita."
        }
      ]
    },
    "fra": {
      "preferred_label": "hin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une unité de mesure de capacité pour les liquides dans la Bible, valant environ 6 litres ou 6 quarts."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ma’aunin ruwa a cikin Littafi Mai Tsarki, wanda ya kusan kai lita 6 ko kwat 6."
        }
      ]
    },
    "hin": {
      "preferred_label": "हीन",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाइबल में प्रयुक्त तरल पदार्थों की माप की एक इकाई, जो लगभग 6 लीटर या 6 क्वार्ट के बराबर होती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ihe ọtụtụ ihe mmiri a na-eji na Baịbụl, nke ruru ihe dịka lita 6 maọbụ kwọtị 6."
        }
      ]
    },
    "ind": {
      "preferred_label": "hin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Satuan ukuran cairan di dalam Alkitab, kira-kira setara dengan 6 liter atau 6 quart."
        }
      ]
    },
    "nep": {
      "preferred_label": "हीन",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाइबलमा तरल पदार्थ नाप्ने एक एकाइ, जुन लगभग ६ लिटर वा ६ क्वार्ट बराबर हुन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "him",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma unidade de medida de capacidade para líquidos na Bíblia, equivalente a cerca de 6 litros ou 6 quartos."
        }
      ]
    },
    "rus": {
      "preferred_label": "гин",
      "descriptions": [
        {
          "source": "acai",
          "description": "Мера объема жидких тел в Библии, примерно равная 6 литрам или 6 квартам."
        }
      ]
    },
    "spa": {
      "preferred_label": "hin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Unidad de medida de líquidos en la Biblia, aproximadamente equivalente a 6 litros o 6 cuartos de galón."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kipimo cha ujazo wa viowevu katika Biblia, kinacholingana takriban na lita 6 au robo galoni 6."
        }
      ]
    },
    "tpi": {
      "preferred_label": "hin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela mak bilong skelim ol likwit long Baibel, inap olsem 6 lita samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "hin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một đơn vị đo thể tích chất lỏng trong Kinh Thánh, tương đương khoảng 6 lít hoặc 6 quart."
        }
      ]
    },
    "zhs": {
      "preferred_label": "欣",
      "descriptions": [
        {
          "source": "acai",
          "description": "圣经中的一种液体容量单位，约等于6升或6夸脱。"
        }
      ]
    },
    "zht": {
      "preferred_label": "欣",
      "descriptions": [
        {
          "source": "acai",
          "description": "聖經中的一種容量計量單位，約等於6公升或6夸脫。"
        }
      ]
    }
  },
