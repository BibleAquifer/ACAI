  "localizations": {
    "eng": {
      "preferred_label": "Loop",
      "alternate_labels": [
        "Hook",
        "Clasp",
        "Loop and Hook"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Loop",
          "article": "realia:Loop",
          "description": "A piece of thread, cord, or metal used to join pieces of cloth together, often with a hook or other fastener."
        }
      ]
    },
    "apd": {
      "preferred_label": "عروة",
      "descriptions": [
        {
          "source": "acai",
          "description": "قطعة من خيط أو حبل أو معدن بتستعمل لربط قطع القماش مع بعض، وغالباً بتكون مع عروة أو مشبك."
        }
      ]
    },
    "arb": {
      "preferred_label": "عروة",
      "descriptions": [
        {
          "source": "acai",
          "description": "قطعة من خيط أو حبل أو معدن تُستخدم لوصل قطع القماش معًا، غالبًا بواسطة مشبك أو أداة تثبيت أخرى."
        }
      ]
    },
    "bis": {
      "preferred_label": "hol blong rop",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pis tred, rop, o kopa/ketel we oli yusum blong joenem ol pis kaliko tugeta, plante taem wetem wan huk o narafala samting blong fasem."
        }
      ]
    },
    "fra": {
      "preferred_label": "lacet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Morceau de fil, de cordon ou de métal utilisé pour assembler des pièces d'étoffe, souvent avec un crochet ou une autre attache."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rami",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zare, igiya, ko ƙarfe da ake amfani da shi wajen haɗa sassan tsumma ko labule, galibi tare da ƙugiya ko wani maɗauri."
        }
      ]
    },
    "hin": {
      "preferred_label": "फंदा",
      "descriptions": [
        {
          "source": "acai",
          "description": "धागे, डोरी या धातु का एक फंदा जिसका उपयोग कपड़े के टुकड़ों को जोड़ने के लिए किया जाता है, अक्सर किसी कुंडी या अन्य बंधक के साथ।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Anya nko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Iberibe eri, eriri, ma ọ bụ ígwè e ji ejikọta iberibe akwa ọnụ, nke na-enwekarị nko ma ọ bụ ihe nkedo ọzọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "sosok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sepotong benang, tali, atau logam yang digunakan untuk menyambungkan potongan-potongan kain, sering kali dengan pengait atau pengencang lainnya."
        }
      ]
    },
    "nep": {
      "preferred_label": "सुर्काउनी",
      "descriptions": [
        {
          "source": "acai",
          "description": "अङ्कुसे वा अन्य बाँध्ने साधनको साथ कपडाका टुक्राहरू जोड्न प्रयोग गरिने धागो, डोरी वा धातुको टुक्रा।"
        }
      ]
    },
    "por": {
      "preferred_label": "laço",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um pedaço de fio, cordão ou metal usado para unir pedaços de tecido, geralmente com um colchete ou outro fixador."
        }
      ]
    },
    "rus": {
      "preferred_label": "Петля",
      "descriptions": [
        {
          "source": "acai",
          "description": "Изделие из нити, шнура или металла, служащее для соединения кусков ткани, часто с помощью крючка или другой застежки."
        }
      ]
    },
    "spa": {
      "preferred_label": "ojal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pieza de hilo, cordón o metal utilizada para unir trozos de tela, a menudo con un gancho u otro sujetador."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kitanzi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kipande cha uzi, kamba, au metali kinachotumiwa kuunganisha vipande vya nguo pamoja, mara nyingi kikiwa na kulabu au kifunga kingine."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ring laplap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hap tret, rop, o ain ol i wokim bilong bungim tupela hap laplap wantaim, planti taim wantaim huka o narapela samting bilong pasim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Vòng khuy",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một đoạn chỉ, dây hoặc kim loại dùng để nối các mảnh vải lại với nhau, thường đi kèm với móc hoặc khóa cài khác."
        }
      ]
    },
    "zhs": {
      "preferred_label": "扣环",
      "descriptions": [
        {
          "source": "acai",
          "description": "一段用于将布块连接在一起的线、绳或金属环，通常与钩子或其他扣件配合使用。"
        }
      ]
    },
    "zht": {
      "preferred_label": "鈕扣",
      "descriptions": [
        {
          "source": "acai",
          "description": "一段線、繩或金屬扣環，常配合鉤子或其他扣件將布料連接在一起。"
        }
      ]
    }
  },
