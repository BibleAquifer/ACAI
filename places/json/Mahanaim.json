          "article": "place:Mahanaim",
          "gloss": "Mahanaim",
          "description": "A Levitical town in the territory of Gad, assigned to the clan of Merari; capital of the kingdom of Isboseth, son of Saul."
        }
      ]
    },
    "fra": {
      "preferred_label": "Mahanaïm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville lévitique située dans le territoire de Gad, attribuée au clan de Merari ; capitale du royaume d’Isch-Boscheth, fils de Saül."
        }
      ]
    },
    "spa": {
      "preferred_label": "Mahanaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad levítica en el territorio de Gad, asignada al clan de Merari; capital del reino de Isboset, hijo de Saúl."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَحَنَايِمَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في أرض جاد، خُصصت لعشيرة مراري؛ وعاصمة مملكة إيشبوشث بن شاول."
        }
      ]
    },
    "zhs": {
      "preferred_label": "玛哈念",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦得境内的一座利未人城镇，分给了米拉利的宗族；也是扫罗之子伊施波设王国的首都。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Mahanayim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani birnin Lawiyawa a yankin Gad, wanda aka ware wa dangin Merari; babban birnin mulkin Ishboshet, ɗan Shawulu."
        }
      ]
    },
    "hin": {
      "preferred_label": "महनैम",
      "descriptions": [
        {
          "source": "acai",
          "description": "गाद के क्षेत्र में एक लेवियाई नगर, जो मरारी के कुल को सौंपा गया था; शाऊल के पुत्र ईशबोशेत के राज्य की राजधानी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Mahanaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota Lewi di wilayah Gad, yang ditetapkan bagi puak Merari; ibu kota kerajaan Isyboset, anak Saul."
        }
      ]
    },
    "por": {
      "preferred_label": "Maanaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade levítica no território de Gade, designada ao clã de Merari; capital do reino de Isbosete, filho de Saul."
        }
      ]
    },
    "rus": {
      "preferred_label": "Маханаим",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитский город в уделе Гада, выделенный роду Мерари; столица царства Иевосфея, сына Саула."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mahanaimu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa Walawi katika eneo la Gadi, uliogawiwa ukoo wa Merari; mji mkuu wa ufalme wa Ishboshethi, mwana wa Sauli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mahanaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun bilong ol Livai long hap graun bilong Gat, em ol i bin givim long famili bilong Merari; na em i kapitol taun bilong kantri bilong Isboset, pikinini man bilong Sol."
        }
      ]
    },
    "apd": {
      "preferred_label": "محنايم",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في أرض جاد، اتخصصت لعشيرة مراري؛ وعاصمة مملكة إيشبوشث بن شاول."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mahanaem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon blong ol Livaet long teritori blong Gad, we i go long laen blong Merari; i kapitol blong kingdom blong Isboset, pikinini boe blong Sol."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mahanaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo ndị Livaị dị nʼókèala Gad, nke e nyere ndị ezinụlọ Merari; isi obodo alaeze Ishboshet, nwa Sọl."
        }
      ]
    },
    "nep": {
      "preferred_label": "महनोम",
      "descriptions": [
        {
          "source": "acai",
          "description": "गादको इलाकामा पर्ने एक लेवी सहर, जुन मरारीको कुललाई दिइएको थियो; साऊलका छोरा ईशबोशेतको राज्यको राजधानी।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-ha-na-im",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn của người Lê-vi trong lãnh thổ Gát, được chia cho thị tộc Mê-ra-ri; kinh đô của vương quốc Ích-bô-sết, con trai Sau-lơ."
        }
      ]
    },
    "zht": {
      "preferred_label": "瑪哈念",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦得領地內的一座利未人城鎮，分給米拉利的子孫；曾為掃羅之子伊施波設王國的首都。"
        }
      ]
    }
  },
