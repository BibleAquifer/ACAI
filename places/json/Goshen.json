        }
      ]
    },
    "hau": {
      "preferred_label": "Goshen (na Masar)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani yanki a gabashin yankin kogin Masar inda Isra’ilawa suka zauna tun daga lokacin da suka sauka a ƙasar har zuwa lokacin fitarsu."
        }
      ]
    },
    "hin": {
      "preferred_label": "गोशेन (मिस्र का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिस्र के पूर्वी डेल्टा का एक क्षेत्र जहाँ इस्राएली मिस्र में बसने के समय से लेकर निष्क्रमण तक रहे थे।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gosyen (Mesir)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah daerah di delta timur Mesir tempat orang Israel tinggal sejak mereka menetap di negeri itu sampai peristiwa keluaran."
        }
      ]
    },
    "por": {
      "preferred_label": "Gósen (do Egito)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma região no delta oriental do Egito onde os israelitas viveram desde a época em que se estabeleceram no país até o êxodo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гесем (в Египте)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Область в восточной части дельты Египта, где израильтяне жили со времени своего поселения в стране и до исхода."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gosheni (ya Misri)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eneo katika delta ya mashariki ya Misri ambapo Waisraeli waliishi tangu walipohamia nchini humo hadi wakati wa kutoka Misri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gosen (bilong Isip)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hap graun long hap sankamap bilong delta bilong Isip we ol Israel i bin stap long en stat long taim ol i go sindaun long dispela kantri i go inap long taim bilong kuskus/eksodas."
        }
      ]
    },
    "apd": {
      "preferred_label": "جوشين (حق مصر)",
      "descriptions": [
        {
          "source": "acai",
          "description": "منطقة في شرق دلتا مصر عاش فيها بنو إسرائيل من زمن استقرارهم في البلد لحد وقت الخروج."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gosen (blong Ijip)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan rijen long saed i go long is blong delta blong Ijip we ol man Isrel oli bin laef long hem stat long taem we oli kam stap long kantri ya gogo kasem taem we oli aot long Ijip."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Goshen (nke Ijipt)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpaghara dị nʼakụkụ ọwụwa anyanwụ nke delta Ijipt ebe ndị Izrel biri site na mgbe ha biri nʼala ahụ ruo nʼọpụpụ ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "गोशेन (मिश्रको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "पूर्वी मिश्री डेल्टाको एउटा क्षेत्र जहाँ इस्राएलीहरू त्यस देशमा बसोबास गरेदेखि प्रस्थानको समयसम्म बसेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Gô-sen (thuộc Ai Cập)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vùng ở đồng bằng phía đông Ai Cập, nơi người Y-sơ-ra-ên sinh sống từ khi họ đến định cư tại đất nước này cho đến cuộc Xuất hành."
        }
      ]
    },
    "zht": {
      "preferred_label": "歌珊（埃及）",
      "descriptions": [
        {
          "source": "acai",
          "description": "埃及尼羅河三角洲東部的一個地區，以色列人從定居埃及直到出埃及时期一直居住在那裡。"
        }
      ]
    }
