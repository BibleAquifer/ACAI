  "localizations": {
    "eng": {
      "preferred_label": "Gibeath-haaraloth",
      "alternate_labels": [
        "Gilgal",
        "Hill of the Foreskins"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Gibeath-haaraloth",
          "gloss": "Gibeath-Haaraloth",
          "description": "A hill near Jericho where Joshua circumcised the Israelites; literally \"hill of the foreskins.\""
        }
      ]
    },
    "fra": {
      "preferred_label": "colline d'Araloth",
      "descriptions": [
        {
          "source": "acai",
          "description": "Colline près de Jéricho où Josué circoncit les Israélites ; littéralement « colline des prépuces »."
        }
      ]
    },
    "spa": {
      "preferred_label": "Guibeat-aralot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Colina cerca de Jericó donde Josué circuncidó a los israelitas; literalmente «colina de los prepucios»."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَلُّ الْقُلَفِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "تَلٌّ بالقرب من أريحا حيث ختن يشوع بني إسرائيل؛ ومعناه الحرفي «تل القلف»."
        }
      ]
    },
    "zhs": {
      "preferred_label": "割礼山",
      "descriptions": [
        {
          "source": "acai",
          "description": "靠近耶利哥的一座小山，约书亚曾在此给以色列人行割礼；字面意思是“包皮山”。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Gibeyat-Ha'aralot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani tudu kusa da Yeriko inda Yoshuwa ya yi wa Isra'ilawa kaciya; a zahiri yana nufin \\\"tudun ƙulle-ƙullen kaciya.\\\""
        }
      ]
    },
    "ind": {
      "preferred_label": "Bukit Kulit Khatan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah bukit dekat Yerikho tempat Yosua menyunat orang Israel; secara harfiah \\\"bukit kulit khatan.\\\""
        }
      ]
    },
    "por": {
      "preferred_label": "Gibeate-Aralote",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma colina perto de Jericó onde Josué circuncidou os israelitas; literalmente \\\"colina dos prepúcios\\\"."
        }
      ]
    },
    "rus": {
      "preferred_label": "Холм обрезания",
      "descriptions": [
        {
          "source": "acai",
          "description": "Холм около Иерихона, где Иисус Навин совершил обрезание израильтян; буквально «холм крайней плоти»."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gibeath-Haaralothi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kilima karibu na Yeriko ambapo Yoshua aliwatahiri Waisraeli; kihalisi \\\"kilima cha govi.\\\""
        }
      ]
    },
    "tpi": {
      "preferred_label": "Maunten Bilong Katim Skin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik maunten klostu long Jeriko we Josua i katim skin bilong ol Israel; mining bilong nem em \\\"maunten bilong ol skin bilong kok.\\\""
        }
      ]
    },
    "apd": {
      "preferred_label": "جبعة هعَارَلُوت",
      "descriptions": [
        {
          "source": "acai",
          "description": "تلة قريبة من أريحا ختن فيها يشوع بني إسرائيل؛ معناها الحرفي \\\"تلة القلفات\\\"."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gibeat Haharalot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hil klosap long Jeriko we Josua i mekem sakomsaes long ol man Isrel; stret mining blong hem i se “Hil blong ol forskin”."
        }
      ]
    },
    "hin": {
      "preferred_label": "गिबाथ-हारालोत",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरीहो के निकट एक टीला जहाँ यहोशू ने इस्राएलियों का खतना कराया; शाब्दिक अर्थ \\\"खलड़ियों का टीला\\\"।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gibịat Haaralot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ugwu nta dị nso na Jeriko ebe Joshua biri ndị Izrel ugwu; nʼụzọ nkịtị \\\"ugwu nke akpụkpọ ibi ugwu.\\\""
        }
      ]
    },
    "nep": {
      "preferred_label": "गिबियथ-हाअरालोथ",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरीहो नजिकको एउटा डाँडा जहाँ यहोशूले इस्राएलीहरूको खतना गरेका थिए; शाब्दिक अर्थ \"खतना नगरिएका छालाहरूको डाँडा\"।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ghi-bê-át A-ra-lốt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ngọn đồi gần Giê-ri-cô, nơi Giô-suê làm phép cắt bì cho dân Y-sơ-ra-ên; nghĩa đen là \\\"đồi bao quy đầu.\\\""
        }
      ]
    },
    "zht": {
      "preferred_label": "除皮山",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶利哥附近的一座山丘，約書亞曾在那裡為以色列人行割禮；字面意思是「包皮山」。"
        }
      ]
    }
  },
