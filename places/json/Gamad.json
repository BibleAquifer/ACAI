        }
      ]
    },
    "hin": {
      "preferred_label": "गम्मद",
      "descriptions": [
        {
          "source": "acai",
          "description": "सीदोन के पूर्व-उत्तरपूर्व में स्थित एक नगर; संभवतः इसकी पहचान अल-अमर्ना पत्रों के कुमिदी से की जाती है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gamad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di sebelah timur-timur laut Sidon; kemungkinan diidentifikasi dengan Kumidi dalam surat-surat El-Amarna."
        }
      ]
    },
    "por": {
      "preferred_label": "Gamade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade a leste-nordeste de Sidom; possivelmente identificada com Kumidi das cartas de Amarna."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гаммад",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город к востоку-северо-востоку от Сидона; возможно, отождествляется с Кумиди из писем Эль-Амарны."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gamadi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko mashariki-kaskazini-mashariki ya Sidoni; huenda ndio Kumidi inayotajwa kwenye barua za El-Amarna."
        }
      ]
    },
    "apd": {
      "preferred_label": "جماد",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة شرق-شمال-شرق صيدون؛ ممكن تكون هي كوميدي المذكورة في رسايل تل العمارنة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gamad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long is-not-is blong Saedon; maet i sem mak wetem Kumidi long ol leta blong El-Amarna."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gamad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nʼakụkụ ọwụwa anyanwụ-ugwu nke Saịdọn; nke a pụrụ ịbụ Kumidi nke a kpọtụrụ aha nʼakwụkwọ ozi El-Amarna."
        }
      ]
    },
    "nep": {
      "preferred_label": "गमाद",
      "descriptions": [
        {
          "source": "acai",
          "description": "सीदोनको पूर्व-उत्तरपूर्वमा पर्ने एउटा सहर; सम्भवतः तेल एल-अमर्ना पत्रहरूमा उल्लिखित कुमिदी भनी पहिचान गरिएको।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gamat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun i stap long hap is-not-is bilong Saidon; ating em i wankain olsem taun Kumidi long ol pas bilong El-Amarna."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ga-mát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn ở phía đông đông bắc của Si-đôn; có thể được xác định với Kumidi trong các thư tín El-Amarna."
        }
      ]
    },
    "zht": {
      "preferred_label": "迦瑪",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於西頓東北偏東的一座城鎮；可能與阿瑪爾奈文書中的庫米迪（Kumidi）為同一地點。"
        }
      ]
    }
