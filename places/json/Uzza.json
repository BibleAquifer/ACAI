      "descriptions": [
        {
          "source": "acai",
          "article": "place:Uzza",
          "gloss": "Uzza",
          "description": "A garden, which was part of palace compound of King Manasseh, where Manasseh and his son Amon were buried."
        }
      ]
    },
    "arb": {
      "preferred_label": "عُزَّا",
      "descriptions": [
        {
          "source": "acai",
          "description": "بستان كان جزءًا من مجمع قصر الملك منسى، حيث دُفن منسى وابنه آمون."
        }
      ]
    },
    "zhs": {
      "preferred_label": "乌撒",
      "descriptions": [
        {
          "source": "acai",
          "description": "一座花园，属于玛拿西王王宫建筑群的一部分，玛拿西及其子亚们安葬于此。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Uzza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un jardin qui faisait partie du complexe palatial du roi Manassé, où Manassé et son fils Amon furent enterrés."
        }
      ]
    },
    "hau": {
      "preferred_label": "Uzza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani lambu, wanda yake cikin harabar fadar Sarki Manasse, inda aka binne Manasse da ɗansa Amon."
        }
      ]
    },
    "hin": {
      "preferred_label": "उज्जा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक बारी (बगीचा), जो राजा मनश्शे के राजमहल परिसर का हिस्सा थी, जहाँ मनश्शे और उसके पुत्र आमोन को दफनाया गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Uza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah taman, yang merupakan bagian dari kompleks istana Raja Manasye, tempat Manasye dan putranya Amon dimakamkan."
        }
      ]
    },
    "por": {
      "preferred_label": "Uzá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um jardim que fazia parte do complexo do palácio do rei Manassés, onde Manassés e seu filho Amom foram sepultados."
        }
      ]
    },
    "rus": {
      "preferred_label": "Узза",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сад, бывший частью дворцового комплекса царя Манассии, где были погребены Манассия и его сын Аммон."
        }
      ]
    },
    "spa": {
      "preferred_label": "Uza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un jardín que formaba parte del complejo palaciego del rey Manasés, donde fueron sepultados Manasés y su hijo Amón."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bustani iliyokuwa sehemu ya jumba la kifalme la Mfalme Manase, ambapo Manase na mwanawe Amoni walizikwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Usa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela gaden insait long banis bilong haus bilong King Manase, ples ol i bin planim Manase wantaim pikinini man bilong em Amon."
        }
      ]
    },
    "apd": {
      "preferred_label": "عُزّا",
      "descriptions": [
        {
          "source": "acai",
          "description": "بستان كان جزءاً من مجمع قصر الملك منسى، ودُفن فيه منسى وابنه آمون."
        }
      ]
    },
    "bis": {
      "preferred_label": "Usaha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan garen we i pat blong haos blong King Manase, we oli berem Manase wetem pikinini blong hem Amon long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu ogige, nke bụ akụkụ nke ogige ụlọeze Eze Manase, ebe e liri Manase na Amọn nwa ya nwoke."
        }
      ]
    },
    "nep": {
      "preferred_label": "उज्जा",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा मनश्शेको दरबार परिसरको भाग रहेको एउटा बगैँचा, जहाँ मनश्शे र तिनका छोरा आमोनलाई गाडिएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "U-xa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một khu vườn thuộc quần thể cung điện của Vua Ma-na-se, nơi Ma-na-se và con trai ông là A-môn được chôn cất."
        }
      ]
    },
    "zht": {
      "preferred_label": "烏撒園",
      "descriptions": [
        {
          "source": "acai",
          "description": "一座園子，屬於瑪拿西王的王宮院落的一部分，瑪拿西及其子亞們均葬於此。"
        }
      ]
    }
  },
