      "descriptions": [
        {
          "source": "acai",
          "article": "place:Beth-shan",
          "gloss": "Beth-Shan",
          "description": "A border town in the territory of West Manasseh, near Zarethan, where Saul's body was hung after he was killed."
        }
      ]
    },
    "zhs": {
      "preferred_label": "伯·善",
      "descriptions": [
        {
          "source": "acai",
          "description": "西玛拿西境内靠近撒拉他拿的一座边境城镇，扫罗被杀后其尸体曾被悬挂于此。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Beth-Schan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville frontière dans le territoire de Manassé occidental, près de Tsarthan, où le corps de Saül fut pendu après sa mort."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bet-Shan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a kan iyakar yankin Yammacin Manasse, kusa da Zaretan, inda aka rataye gawar Shawulu bayan an kashe shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "बेतशान",
      "descriptions": [
        {
          "source": "acai",
          "description": "पश्चिमी मनश्शे के क्षेत्र में सारतान के निकट स्थित एक सीमावर्ती नगर, जहाँ शाऊल की मृत्यु के बाद उसके शव को टाँग दिया गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Bet-Sean",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota perbatasan di wilayah Manasye Barat, dekat Sartan, tempat mayat Saul digantung setelah ia terbunuh."
        }
      ]
    },
    "por": {
      "preferred_label": "Bete-Seã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade fronteiriça no território de Manassés Ocidental, perto de Zereda, onde o corpo de Saul foi pendurado após ele ser morto."
        }
      ]
    },
    "spa": {
      "preferred_label": "Bet-seán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad fronteriza en el territorio de Manasés Occidental, cerca de Zaretán, donde colgaron el cuerpo de Saúl después de su muerte."
        }
      ]
    },
    "swh": {
      "preferred_label": "Beth-shani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa mipakani katika eneo la Manase ya Magharibi, karibu na Sarethani, ambapo mwili wa Sauli ulitundikwa baada ya kuuawa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Betsan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long arere bilong hap graun bilong Wes Manase, klostu long Saretan, we ol i bin hangamapim bodi bilong Sol bihain long ol i kilim em i dai."
        }
      ]
    },
    "apd": {
      "preferred_label": "بيت شان",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة حدودية في أرض منسى الغربية، قريبة من صردان، علقوا فيها جثة شاول بعد ما اتقتل."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَيْت شَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة حدودية في أرض غرب منسى، بالقرب من صرتان، حيث عُلِّقت جثة شاول بعد مقتله."
        }
      ]
    },
    "bis": {
      "preferred_label": "Betsan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long boda long graon blong Wes Manase, klosap long Saretan, we oli hangem bodi blong Sol afta we oli kilim hem i ded."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Bet-Shan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nʼókè dị nʼókèala Ọdịda Anyanwụ Manase, dị nso na Zaretan, ebe a kwụnyere ozu Sọl mgbe e gbusịrị ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "बेथ-शान",
      "descriptions": [
        {
          "source": "acai",
          "description": "पश्‍चिमी मनश्शेको इलाकामा जारेतान नजिकैको सिमानामा पर्ने एउटा सहर, जहाँ शाऊल मारिएपछि उनको शव झुन्ड्याइएको थियो।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Беф-Сан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пограничный город в уделе Западного Манассии, возле Цартана, где было повешено тело Саула после его гибели."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bết-sê-an",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn biên giới thuộc lãnh thổ Tây Ma-na-se, gần Xa-rơ-than, nơi thi thể của Sau-lơ bị treo lên sau khi ông tử trận."
        }
      ]
    },
    "zht": {
      "preferred_label": "伯‧善",
      "descriptions": [
        {
          "source": "acai",
          "description": "西瑪拿西境內靠近撒拉但的一座邊境城鎮，掃羅被殺後其屍身曾被懸掛於此。"
        }
      ]
    }
