      "descriptions": [
        {
          "source": "acai",
          "article": "place:Ivvah",
          "gloss": "Ivvah",
          "description": "A town, also known as Avvah; its inhabitants were relocated to Samaria by the king of Samaria."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِوَّا",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة تُعرف أيضًا باسم عَوَّا؛ نقل ملك آشور سكانها إلى السامرة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以瓦",
      "descriptions": [
        {
          "source": "acai",
          "description": "一座城镇，又名亚瓦；其居民被亚述王迁至撒玛利亚。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Ivva",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville, également connue sous le nom d’Avva ; ses habitants furent déportés en Samarie par le roi d’Assyrie."
        }
      ]
    },
    "hau": {
      "preferred_label": "Iffa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari ne, wanda kuma aka sani da Afa; sarkin Samariya ya ƙaura da mazaunansa zuwa Samariya."
        }
      ]
    },
    "hin": {
      "preferred_label": "इव्वा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक नगर, जिसे अव्वा के नाम से भी जाना जाता है; इसके निवासियों को अश्शूर/सामरिया के राजा द्वारा सामरिया में बसाया गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Iwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota, yang juga dikenal sebagai Awa; penduduknya dipindahkan ke Samaria oleh raja Samaria."
        }
      ]
    },
    "por": {
      "preferred_label": "Iva",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade, também conhecida como Ava; seus habitantes foram transferidos para Samaria pelo rei da Assíria."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ивва",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город, также известный как Авва; его жители были переселены в Самарию царем ассирийским."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ivá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad, también conocida como Ava; sus habitantes fueron reubicados en Samaria por el rey de Asiria."
        }
      ]
    },
    "swh": {
      "preferred_label": "Iva",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji, unaojulikana pia kama Ava; wakazi wake walihamishiwa Samaria na mfalme wa Ashuru (kwa mujibu wa 2 Wafalme 17)."
        }
      ]
    },
    "apd": {
      "preferred_label": "عوة",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة، معروفة برضو باسم عوا؛ رحّل ملك آشور أهلها للسامرة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Iva",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon, we oli kolem tu Ava; king blong Asiria i muvum ol man blong hem i go stap long Sameria."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Iva",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo a makwaara dị ka Ava; eze Sameria bugharịrị ndị bi na ya gaa Sameria."
        }
      ]
    },
    "nep": {
      "preferred_label": "इव्वा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एउटा सहर, जसलाई अव्वा पनि भनिन्छ; यसका बासिन्दाहरूलाई सामरियाका राजाले सामरियामा बसाइँ सरेका थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Iva",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun, nem bilong en tu Ava; king bilong Asiria i bin kisim ol manmeri bilong en na putim ol i go sindaun long Samaria."
        }
      ]
    },
    "vie": {
      "preferred_label": "Y-va",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn, còn gọi là A-va; dân cư tại đây bị vua Sa-ma-ri di dời đến Sa-ma-ri."
        }
      ]
    },
    "zht": {
      "preferred_label": "以瓦",
      "descriptions": [
        {
          "source": "acai",
          "description": "一座城鎮，又名亞瓦；其居民被亞述王遷徙安置到撒馬利亞。"
        }
      ]
    }
  },
