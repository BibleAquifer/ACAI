  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Arabah",
      "alternate_labels": [
        "Arabah Valley",
        "Jordan Valley",
        "Jordan plain",
        "wilderness",
        "Arbathite",
        "plain",
        "desert",
        "valley of the Dead Sea",
        "eastern Jordan plain"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Arabah",
          "gloss": "Arabah",
          "description": "The deep depression through which the Jordan River flows, which runs from the south of the Sea of Galilee via the Dead Sea into the Gulf of Aqabah."
        }
      ]
    },
    "arb": {
      "preferred_label": "ٱلْعَرَبَةُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "المنخفض العميق الذي يتدفق فيه نهر الأردن، ويمتد من جنوب بحيرة طبريا عبر البحر الميت إلى خليج العقبة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚拉巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "约旦河流经的深凹地陷地带，从加利利海以南经死海延伸至阿卡巴湾。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Arabah",
      "descriptions": [
        {
          "source": "acai",
          "description": "La profonde dépression dans laquelle coule le Jourdain, s'étendant du sud de la mer de Galilée jusqu'au golfe d'Aqaba en passant par la mer Morte."
        }
      ]
    },
    "hau": {
      "preferred_label": "Araba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kwari mai zurfi wanda Kogin Urdun yake ratsawa ta cikinsa, wanda ya tashi daga kudancin Tekun Galili ta Tekun Gishiri zuwa Kogin Aqaba."
        }
      ]
    },
    "hin": {
      "preferred_label": "अराबा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक गहरा गर्त जिससे होकर यरदन नदी बहती है, जो गलील की झील के दक्षिण से मृत सागर होते हुए अकाबा की खाड़ी तक जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Araba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lembah rekahan yang dalam tempat Sungai Yordan mengalir, yang membentang dari sebelah selatan Danau Galilea melalui Laut Mati hingga ke Teluk Aqaba."
        }
      ]
    },
    "por": {
      "preferred_label": "Arabá",
      "descriptions": [
        {
          "source": "acai",
          "description": "A depressão profunda pela qual corre o rio Jordão, estendendo-se do sul do mar da Galileia, passando pelo mar Morto, até o golfo de Ácaba."
        }
      ]
    },
    "spa": {
      "preferred_label": "Arabá",
      "descriptions": [
        {
          "source": "acai",
          "description": "La profunda depresión por la que fluye el río Jordán, que se extiende desde el sur del mar de Galilea a través del mar Muerto hasta el golfo de Áqaba."
        }
      ]
    },
    "swh": {
      "preferred_label": "Araba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bonde lenye kina kirefu ambamo Mto Yordani unapita, linaloanzia kusini mwa Bahari ya Galilaya kupitia Bahari ya Chumvi hadi Ghuba ya Akaba."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Araba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dispela daunbilo ples we Wara Jordan i ran long en, em i stat long hap saut bilong Raunwara Galili i go pasim Detsi na i go inap long Gulf bilong Akaba."
        }
      ]
    },
    "apd": {
      "preferred_label": "العربة",
      "descriptions": [
        {
          "source": "acai",
          "description": "المنخفض العميق اللي بيمشي فيه نهر الأردن، وبيمتد من جنوب بحيرة طبريا عبر البحر الميت لغاية خليج العقبة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Araba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bigfala vale we wota blong Jodan i ron tru long hem, i stat long saot blong Bigfala Leik Galili i go tru long Ded Si gogo kasem Galf blong Akaba."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Araba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndagwurugwu miri emi nke Osimiri Jọdan na-erugharị na ya, nke si nʼebe ndịda Oké Osimiri Galili gafere Oké Osimiri Nwụrụ Anwụ banye nʼỌwara Aqaba."
        }
      ]
    },
    "nep": {
      "preferred_label": "अराबा",
      "descriptions": [
        {
          "source": "acai",
          "description": "गहिरो खाल्डो जहाँबाट यर्दन नदी बग्दछ, जो गालीलको समुद्रको दक्षिणदेखि मृत सागर हुँदै अकाबाको खाडीसम्म फैलिएको छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Арава",
      "descriptions": [
        {
          "source": "acai",
          "description": "Глубокая впадина, по которой протекает река Иордан, тянущаяся от южной части Галилейского моря через Мертвое море к заливу Акаба."
        }
      ]
    },
    "vie": {
      "preferred_label": "A-ra-ba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vùng trũng sâu nơi sông Giô-đanh chảy qua, trải dài từ phía nam Biển Ga-li-lê qua Biển Chết đến Vịnh Aqaba."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞拉巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "約旦河所流經的深陷地塹，從加利利海以南經死海延伸至阿卡巴灣。"
        }
      ]
    }
  },
