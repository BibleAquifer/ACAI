        }
      ]
    },
    "bis": {
      "preferred_label": "Maelitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon we i gat pot blong sip long Karia, long wes kos blong Esia Maena; Pol i mit wetem ol elda blong Efesas long ples ya."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Melitọs",
      "descriptions": [
        {
