        }
      ]
    },
    "swh": {
      "preferred_label": "Mileto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa bandari wa Karia, katika pwani ya magharibi ya Asia Ndogo; Paulo alikutana na wazee wa Efeso hapa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Miletus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun i gat pasis bilong sip long Karia, long nambis long hap wes bilong Esia Maina; Pol i bin bung wantaim ol hetman bilong Efesus long dispela hap."
        }
      ]
    },
    "apd": {
