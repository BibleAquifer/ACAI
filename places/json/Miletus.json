          "description": "Otu obodo ọdụ ụgbọ mmiri dị na Karia, nʼụsọ oké osimiri ọdịda anyanwụ nke Eshia Maịnọ; Pọl zutere ndị okenye Efesọs nʼebe a."
        }
      ]
    },
    "nep": {
      "preferred_label": "मिलेटस",
      "descriptions": [
        {
