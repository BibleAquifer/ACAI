          "article": "place:Ephrath",
          "gloss": "Ephrath",
          "description": "A town in the territory of Judah where Jacob buried Rachel, his wife; also known as Ephrathah and Bethlehem."
        }
      ]
    },
    "fra": {
      "preferred_label": "Éphrath",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville du territoire de Juda où Jacob enterra Rachel, sa femme ; également connue sous le nom d'Éphrata et de Bethléhem."
        }
      ]
    },
    "spa": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo en el territorio de Judá donde Jacob sepultó a Raquel, su esposa; también conocido como Efrata y Belén."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَفْرَاتَةَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في أرض يهوذا حيث دفن يعقوب زوجته راحيل؛ وتُعرف أيضًا بأفراتة وبيت لحم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以法他",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大境内的一座城镇，雅各在此埋葬了他的妻子拉结；也称为以法他和伯利恒。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Efrat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a yankin Yahuda inda Yaƙub ya binne Rahila matarsa; wanda kuma aka sani da Efrata da Betlehem."
        }
      ]
    },
    "hin": {
      "preferred_label": "एप्राता",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा के क्षेत्र का एक नगर जहाँ याकूब ने अपनी पत्नी राहेल को दफनाया था; इसे एप्राता और बैतलहम भी कहा जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di wilayah Yehuda tempat Yakub menguburkan Rahel, istrinya; dikenal juga sebagai Efrata dan Betlehem."
        }
      ]
    },
    "por": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade no território de Judá onde Jacó sepultou Raquel, sua esposa; também conhecida como Efrata e Belém."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ефрафа",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в уделе Иуды, где Иаков похоронил свою жену Рахиль; также известен как Ефрафа и Вифлеем."
        }
      ]
    },
    "swh": {
      "preferred_label": "Efrathi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji katika eneo la Yuda ambapo Yakobo alimzika Raheli, mkewe; unajulikana pia kama Efratha na Bethlehemu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long graun bilong Juda em Jekop i bin planim meri bilong en Resel long en; narapela nem bilong en em Efrata na Betlehem."
        }
      ]
    },
    "apd": {
      "preferred_label": "أفرات",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في أرض يهوذا دفن فيها يعقوب مرته راحيل؛ ومعروفة كمان باسم أفراتة وبيت لحم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Efrat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long graon blong Juda we Jekob i berem Rejel, woman blong hem; oli save long hem tu olsem Efrata mo Betlehem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Efrat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo nʼoke ala Juda ebe Jekọb liri Rechel, bụ nwunye ya; nke a na-akpọkwa Efrata na Betlehem."
        }
      ]
    },
    "nep": {
      "preferred_label": "एप्रात",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदाको इलाकामा रहेको एक सहर जहाँ याकूबले आफ्नी पत्नी राहेललाई गाडेका थिए; यसलाई एप्राता र बेथलेहेम पनि भनिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ép-ra-ta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn thuộc địa phận Giu-đa nơi Gia-cốp chôn cất Ra-chên, vợ mình; còn được gọi là Ép-ra-ta và Bết-lê-hem."
        }
      ]
    },
    "zht": {
      "preferred_label": "以法他",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大境內的一座城鎮，雅各在此埋葬了他的妻子拉結；又名以法他（Ephrathah）和伯利恆。"
        }
      ]
    }
  },
