  "localizations": {
    "eng": {
      "preferred_label": "Gibeah (of Phinehas)",
      "alternate_labels": [
        "Gibeon",
        "Gibeathite",
        "Geba",
        "Gibeonite",
        "Gibeah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Gibeah.3",
          "gloss": "Gibeah (of Phinehas)",
          "description": "A hill or town in the hill country of Ephraim were Eleazar, son of Aaron, was buried."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبعة (حقت فينحاس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تلة أو مدينة في بلاد التلال حقت أفرايم اتدفن فيها ألعازار بن هارون."
        }
      ]
    },
    "arb": {
      "preferred_label": "جِبْعَة (فينحاس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "تل أو مدينة في جبل أفرايم حيث دُفن أَلِعازار بن هارون."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gibea (blong Finehas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hil o wan taon long ples blong hil long Efrem we oli berem Eleasar, pikinini blong Eron, long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "Guibea (de Phinées)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Colline ou ville de la région montagneuse d'Éphraïm où Éléazar, fils d'Aaron, fut enterré."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gibeya (ta Finehas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani tudu ko gari ne a ƙasar kan tudu ta Efraim inda aka binne Eleyazar ɗan Haruna."
        }
      ]
    },
    "hin": {
      "preferred_label": "गिबा (पीनहास का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एप्रैम के पहाड़ी देश में स्थित एक पहाड़ी या नगर जहाँ हारून के पुत्र एलीआजर को दफनाया गया था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gibea (nke Finehaz)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ugwu nta ma ọ bụ obodo dị nʼobodo ugwu Ifrem ebe e liri Elieza, nwa Erọn."
        }
      ]
    },
    "ind": {
      "preferred_label": "Gibea (Pinehas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah bukit atau kota di pegunungan Efraim tempat Eleazar, anak Harun, dikuburkan."
        }
      ]
    },
    "nep": {
      "preferred_label": "गिबा (पीनहासको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एफ्राइमको पहाडी इलाकामा रहेको एउटा डाँडा वा सहर जहाँ हारूनका छोरा एलाजारलाई गाडिएको थियो।"
        }
      ]
    },
    "por": {
      "preferred_label": "Gibeá (de Fineias)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma colina ou cidade na região montanhosa de Efraim onde Eleazar, filho de Arão, foi sepultado."
        }
      ]
    },
    "rus": {
      "preferred_label": "Холм Финееса",
      "descriptions": [
        {
          "source": "acai",
          "description": "Холм или город в нагорной части Ефрема, где был похоронен Елеазар, сын Аарона."
        }
      ]
    },
    "spa": {
      "preferred_label": "Guibeá (de Finés)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una colina o ciudad en la región montañosa de Efraín donde Eleazar, hijo de Aarón, fue sepultado."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gibea (ya Finehasi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kilima au mji katika nchi ya vilima ya Efraimu ambapo Eleazari, mwana wa Haruni, alizikwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gibea (bilong Finias)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela maunten o taun long ples maunten bilong Efraim em ol i bin planim Eleasar, pikinini bilong Aron, long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ghi-bê-a (của Phi-nê-a)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ngọn đồi hoặc thành phố trong vùng đồi núi Ép-ra-im, nơi Ê-lê-a-sa, con của A-rôn, được an táng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "基比亚 (非尼哈)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法莲山区的一座山丘或城镇，亚伦的儿子以利亚撒葬于此地。"
        }
      ]
    },
    "zht": {
      "preferred_label": "基比亞（非尼哈）",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於以法蓮山地的一座小山或城鎮，亞倫的兒子以利亞撒葬於該處。"
        }
      ]
    }
  },
