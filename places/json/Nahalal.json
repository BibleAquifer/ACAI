          "description": "مدينة لاوية في أرض زبولون، خُصصت لعشيرة مَراري؛ تُعرف أيضاً باسم نَهْلُول."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拿哈拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "位于西布伦领地内的利未人城镇，分给了米拉利家族；也称拿哈略。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Nahalal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville lévitique située sur le territoire de Zabulon, attribuée au clan de Merari ; également connue sous le nom de Nahalol."
        }
      ]
    },
    "hau": {
      "preferred_label": "Nahalal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani garin Lawiyawa a yankin Zebulun, wanda aka ba wa dangin Merari; wanda kuma aka sani da Nahalol."
        }
      ]
    },
    "hin": {
      "preferred_label": "नहलाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "जबूलून के क्षेत्र का एक लेविय नगर, जो मरारी के कुल को सौंपा गया था; जिसे नहलोल भी कहा जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Nahalal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota orang Lewi di wilayah Zebulon, yang diberikan kepada kaum Merari; juga dikenal sebagai Nahalol."
        }
      ]
    },
    "por": {
      "preferred_label": "Naalal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade levítica no território de Zebulom, designada ao clã de Merari; também conhecida como Naalol."
        }
      ]
    },
    "rus": {
      "preferred_label": "Нагалал",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитский город в уделе Завулона, выделенный роду Мерари; также известный как Наглол."
        }
      ]
    },
    "spa": {
      "preferred_label": "Nahalal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad levítica en el territorio de Zabulón, asignada al clan de Merari; también conocida como Nahalol."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nahalali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa Walawi katika eneo la Zabuloni, uliotengwa kwa ukoo wa Merari; pia unajulikana kama Nahaloli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Nahalal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun bilong ol Livai long hap graun bilong Sebulun, ol i bin givim long famili bilong Merari; narapela nem bilong en em Nahalol."
        }
      ]
    },
    "apd": {
      "preferred_label": "نَهْلال",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في أرض زبولون، اتخصصت لعشيرة مَراري؛ ومعروفة كمان باسم نَهْلول."
        }
      ]
    },
    "bis": {
      "preferred_label": "Nahalal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon blong ol Livaet long teritori blong Sebulun, we oli givim long laen blong Merari; we oli singaotem tu se Nahalol."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nahalal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo ndị Livaị nʼókèala Zebụlọn, nke e kenyere ezinụlọ Merari; nke a makwaara dị ka Nahalol."
        }
      ]
    },
    "nep": {
      "preferred_label": "नहलल",
      "descriptions": [
        {
          "source": "acai",
          "description": "जबूलूनको इलाकामा पर्ने एक लेवी सहर, जुन मरारीको कुललाई दिइएको थियो; नहलोल भनी पनि चिनिने।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Na-ha-la",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành của người Lê-vi trong lãnh thổ của Sa-bu-luân, được phân chia cho thị tộc Mê-ra-ri; cũng được gọi là Na-ha-lô."
        }
      ]
    },
    "zht": {
      "preferred_label": "拿哈拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "西布倫境內的一座利未人城鎮，分給米拉利家族；又名拿哈拉。"
        }
      ]
    }
