  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "En-gedi",
      "alternate_labels": [
        "Hazazon-tamar",
        "Wilderness of En Gedi",
        "Hazezon-Tamar",
        "Desert of En Gedi"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Engedi",
          "gloss": "En-Gedi",
          "description": "An oasis in the wilderness of the territory of Judah, on the western shore of the Dead Sea; also known as Hazezon-Tamar."
        }
      ]
    },
    "zhs": {
      "preferred_label": "隐·基底",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大领地旷野中的一处绿洲，位于死海西岸；又称哈洗逊·他玛。"
        }
      ]
    },
    "fra": {
      "preferred_label": "En-Guédi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une oasis dans le désert du territoire de Juda, sur la rive occidentale de la mer Morte ; également connue sous le nom de Hatsatson-Thamar."
        }
      ]
    },
    "hau": {
      "preferred_label": "En Gedi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani yanki mai ni'ima da ruwa a cikin jejin yankin Yahuda, a gaɓar yamma ta Tekun Gishiri; wanda aka kuma sani da Hazazon-tamar."
        }
      ]
    },
    "hin": {
      "preferred_label": "एनगदी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मृत सागर के पश्चिमी तट पर, यहूदा के क्षेत्र के जंगल में स्थित एक मरुद्यान; जिसे हसासोन्तामार भी कहा जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "En-Gedi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah oasis di padang gurun wilayah Yehuda, di pantai barat Laut Asin; juga dikenal sebagai Hazezon-Tamar."
        }
      ]
    },
    "por": {
      "preferred_label": "En-Gedi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um oásis no deserto do território de Judá, na margem ocidental do Mar Morto; também conhecido como Hazazom-Tamar."
        }
      ]
    },
    "spa": {
      "preferred_label": "En-gadi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oasis en el desierto del territorio de Judá, en la orilla occidental del mar Muerto; también conocido como Hazezón-tamar."
        }
      ]
    },
    "swh": {
      "preferred_label": "En-Gedi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oasisi katika nyika ya eneo la Yuda, kwenye pwani ya magharibi ya Bahari ya Chumvi; pia inajulikana kama Hasason-tamari."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Engedi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples i gat wara na diwai long ples drai nating bilong graun bilong Juda, long nambis long hap wes bilong Detsi; narapela nem bilong en em Hasesontamar."
        }
      ]
    },
    "apd": {
      "preferred_label": "عين جدي",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحة في خلا أراضي يهوذا، على الشاطي الغربي للبحر الميت؛ ومعروفة كمان باسم حصون تامار."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَيْنِ جَدْيٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحَةٌ فِي بَرِّيَّةِ أَرْضِ يَهُوذَا، عَلَى ٱلشَّاطِئِ ٱلْغَرْبِيِّ لِلْبَحْرِ ٱلْمَيِّتِ؛ تُعْرَفُ أَيْضًا بِحَصُونَ تَامَارَ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Enkedi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ples wetem wota mo tri long draeples blong teritri blong Juda, long wes saed blong solwota blong Ded Si; we nem blong hem tu Hasason-tamar."
        }
      ]
    },
    "ibo": {
      "preferred_label": "En-Gedi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ebe ahịhịa ndụ na mmiri dị nʼọzara nke ókèala Juda, nʼụsọ ọdịda anyanwụ nke Osimiri Nnu (Osimiri Nwụrụ Anwụ); nke a makwaara dịka Hazazon-Tama."
        }
      ]
    },
    "nep": {
      "preferred_label": "एन-गदी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मृत सागरको पश्चिमी किनारमा, यहूदाको इलाकाको मरुभूमिमा रहेको एउटा मरुद्यान; जसलाई हत्सेसोन-तामार पनि भनिन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Ен-Геди",
      "descriptions": [
        {
          "source": "acai",
          "description": "Оазис в пустыне удела Иуды на западном побережье Мертвого моря; также известен как Хацацон-Фамар."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ên-ghê-đi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ốc đảo trong hoang mạc thuộc lãnh thổ Giu-đa, trên bờ phía tây của Biển Chết; còn được gọi là Hát-xát-xôn-tha-ma."
        }
      ]
    },
    "zht": {
      "preferred_label": "隱‧基底",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於死海西岸猶大領地曠野中的一片綠洲；又名哈洗遜‧他瑪。"
        }
      ]
    }
  },
