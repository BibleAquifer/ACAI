      "descriptions": [
        {
          "source": "acai",
          "article": "place:Thessalonica",
          "gloss": "Thessalonica",
          "description": "A seaport city in Macedonia between Berea and Apollonia; 1 and 2 Thessalonians were addressed to the church there."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَسَالونِيكِي",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَدينَةٌ مَرْفَئِيَّةٌ فِي مَكِدونِيَّةَ بَيْنَ بِيرِيَّةَ وَأَبولونِيَّةَ؛ وُجِّهَتْ رِسالَتا تَسالونيكي الأولى والثّانِيَةُ إِلى الكَنيسَةِ هُناكَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "帖撒罗尼迦",
      "descriptions": [
        {
          "source": "acai",
          "description": "马其顿境内位于庇哩亚和亚波罗尼亚之间的一座海港城市；《帖撒罗尼迦前书》和《帖撒罗尼迦后书》就是写给当地教会的。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Thessalonique",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville portuaire de Macédoine située entre Bérée et Apollonie ; les première et deuxième épîtres aux Thessaloniciens étaient adressées à l’Église qui s’y trouvait."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tessalonika",
      "descriptions": [
        {
          "source": "acai",
          "description": "Birnin tashar jiragen ruwa a Makidoniya tsakanin Bereya da Afolloniya; an aika da 1 da 2 Tessalonikawa zuwa ga ikkilisiyar da take can."
        }
      ]
    },
    "hin": {
      "preferred_label": "थिस्सलुनीके",
      "descriptions": [
        {
          "source": "acai",
          "description": "मकिदुनिया का एक बंदरगाह नगर जो बिरीया और अपुल्लोनिया के बीच स्थित था; 1 और 2 थिस्सलुनीकियों की पत्रियाँ वहाँ की कलीसिया को संबोधित थीं।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Tesalonika",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota pelabuhan di Makedonia antara Berea dan Apolonia; surat 1 dan 2 Tesalonika ditujukan kepada jemaat di sana."
        }
      ]
    },
    "por": {
      "preferred_label": "Tessalônica",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade portuária na Macedônia entre Bereia e Apolônia; 1 e 2 Tessalonicenses foram dirigidas à igreja local."
        }
      ]
    },
    "rus": {
      "preferred_label": "Фессалоника",
      "descriptions": [
        {
          "source": "acai",
          "description": "Портовый город в Македонии между Верией и Аполлонией; церкви в этом городе были адресованы 1-е и 2-е послания к Фессалоникийцам."
        }
      ]
    },
    "spa": {
      "preferred_label": "Tesalónica",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad portuaria en Macedonia entre Berea y Apolonia; 1 y 2 Tesalonicenses fueron dirigidas a la iglesia de allí."
        }
      ]
    },
    "swh": {
      "preferred_label": "Thesalonike",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa bandari huko Makedonia kati ya Beroya na Apolonia; waraka wa 1 na 2 wa Wathesalonike uliandikiwa kanisa la huko."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tesalonaika",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun i gat pasis long Masedonia namel long Beria na Apolonia; Pol i bin raitim 1 na 2 Tesalonaika i go long sios i stap long dispela taun."
        }
      ]
    },
    "apd": {
      "preferred_label": "تسالونيكي",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة ساحلية في مكدونية بين بيرية وأبولونية؛ كُتبت رسالتا تسالونيكي الأولى والتانية للكنيسة هناك."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tesalonaeka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Masedonia we i stap long solwota, bitwin Berea mo Apolonia; Fas mo Seken Tesalonaeka tufala i leta we Pol i raetem i go long jos long ples ya."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Tesalonaịka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo ọdụ ụgbọ mmiri dị na Masedonia n'agbata Beria na Apolonia; e degaara nzukọ dị n'ebe ahụ akwụkwọ 1 na 2 Tesalonika."
        }
      ]
    },
    "nep": {
      "preferred_label": "थेसलोनिका",
      "descriptions": [
        {
          "source": "acai",
          "description": "म्यासेडोनियाको बेरिया र अपोल्लोनियाको बीचमा रहेको एउटा बन्दरगाह सहर; १ र २ थेसलोनिकीहरू त्यहाँको मण्डलीलाई सम्बोधन गरी लेखिएका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Tê-sa-lô-ni-ca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành phố cảng ở Ma-xê-đoan nằm giữa Bê-rê và A-bô-lô-ni; thư 1 và 2 Tê-sa-lô-ni-ca được gửi cho Hội Thánh tại nơi này."
        }
      ]
    },
    "zht": {
      "preferred_label": "帖撒羅尼迦",
      "descriptions": [
        {
          "source": "acai",
          "description": "馬其頓的一個海港城市，位於庇哩亞和亞波羅尼亞之間；《帖撒羅尼迦前書》與《帖撒羅尼迦後書》是寫給那裡的教會。"
        }
      ]
    }
  },
