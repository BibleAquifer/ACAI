  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Damascus",
      "alternate_labels": [
        "Syria-damascus",
        "Wilderness of Damascus",
        "Desert of Damascus"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Damascus",
          "gloss": "Damascus",
          "description": "A town in Syria; capital of one of the Aramaean kingdoms. Paul was converted on the road to Damascus (Acts 9:1–9)."
        }
      ]
    },
    "arb": {
      "preferred_label": "دِمَشْقَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في سوريا؛ عاصمة إحدى الممالك الآرامية. تجدد فيها بولس في طريقه إلى دمشق (أعمال الرسل 9: 1–9)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "大马士革",
      "descriptions": [
        {
          "source": "acai",
          "description": "叙利亚的一座城镇；亚兰诸王国之一的首都。保罗在去大马士革的路上归信（使徒行传 9:1–9）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Damas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville de Syrie ; capitale de l'un des royaumes araméens. Paul s'y est converti sur le chemin de Damas (Actes 9:1–9)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Damaskus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani birni a Siriya; babban birnin ɗaya daga cikin mulkokin Arameyawa. An tuba Bulus a kan hanyar zuwa Damaskus (Ayyukan Manzanni 9:1–9)."
        }
      ]
    },
    "hin": {
      "preferred_label": "दमिश्क",
      "descriptions": [
        {
          "source": "acai",
          "description": "सीरिया का एक नगर; अरामी राज्यों में से एक की राजधानी। दमिश्क के मार्ग पर पौलुस का मनफिराव हुआ था (प्रेरितों के काम 9:1–9)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Damsyik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di Siria; ibu kota salah satu kerajaan Aram. Paulus bertobat di jalan menuju Damsyik (Kisah Para Rasul 9:1–9)."
        }
      ]
    },
    "por": {
      "preferred_label": "Damasco",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade na Síria; capital de um dos reinos arameus. Paulo foi convertido no caminho de Damasco (Atos 9:1–9)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дамаск",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в Сирии; столица одного из арамейских царств. Павел обратился по дороге в Дамаск (Деян. 9:1–9)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Damasco",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad en Siria; capital de uno de los reinos arameos. Pablo se convirtió en el camino a Damasco (Hechos 9:1–9)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Dameski",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko Shamu; mji mkuu wa mojawapo ya falme za Waaramu. Paulo aliongoka akiwa njiani kuelekea Dameski (Mdo 9:1–9)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Damaskus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Siria; em i nambawan taun bilong wanpela bilong ol kingdom bilong ol Aram. Pol i bin tanim bel long rot i go long Damaskus (Aposel 9:1–9)."
        }
      ]
    },
    "apd": {
      "preferred_label": "دمشق",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في سوريا؛ عاصمة واحدة من الممالك الآرامية. بولس اهتدى في الطريق لدمشق (أعمال الرسل 9: 1–9)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Damaskes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Siria; kapitel blong wan long ol kingdom blong Aram. Pol i jenisim laef blong hem long rod i go long Damaskes (Ol Wok 9:1–9)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Damaskọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na Siria; isi obodo nke otu nʼime alaeze ndị Aram. A gbanwere Pọl nʼụzọ na-aga Damaskọs (Ọrụ 9:1–9)."
        }
      ]
    },
    "nep": {
      "preferred_label": "दमस्कस",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिरियाको एक सहर; अरामी राज्यहरूमध्ये एउटाको राजधानी। पावलको दमस्कस जाने बाटोमा मनपरिवर्तन भएको थियो (प्रेरित ९:१–९)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Đa-mách",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành phố ở Sy-ri; thủ đô của một trong những vương quốc A-ram. Phao-lô đã được hoán cải trên đường đến Đa-mách (Công vụ 9:1–9)."
        }
      ]
    },
    "zht": {
      "preferred_label": "大馬士革",
      "descriptions": [
        {
          "source": "acai",
          "description": "敘利亞的一座城鎮；亞蘭王國之一的首都。保羅在前往大馬士革的路上悔改信主（徒 9:1–9）。"
        }
      ]
    }
  },
