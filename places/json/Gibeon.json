  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Gibeon",
      "alternate_labels": [
        "Wilderness of Gibeon",
        "Gibeonites",
        "Geba",
        "Bamah",
        "Gibbar",
        "Gibeonite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Gibeon",
          "gloss": "Gibeon",
          "description": "A town in the territory of Benjamin; one of the four Hivite cities that made a covenant with Joshua (Joshua 9:17–18)."
        }
      ]
    },
    "arb": {
      "preferred_label": "جِبْعُونُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في أرض بنيامين؛ إحدى مدن الحويين الأربع التي قطعت عهدًا مع يشوع (يشوع 9: 17–18)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "基遍",
      "descriptions": [
        {
          "source": "acai",
          "description": "便雅悯境内的一座城镇；是与约书亚立约的四个希未人城镇之一（约书亚记 9:17–18）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Gabaon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville située dans le territoire de Benjamin ; l'une des quatre villes hivites qui conclurent une alliance avec Josué (Josué 9.17–18)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gibeyon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a yankin Benyamin; ɗaya daga cikin biranen Hiwayawa huɗu da suka yi yarjejeniya da Yoshuwa (Yoshuwa 9:17–18)."
        }
      ]
    },
    "hin": {
      "preferred_label": "गिबोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिन्यामीन के क्षेत्र का एक नगर; उन चार हिव्वी नगरों में से एक जिन्होंने यहोशू के साथ वाचा बाँधी थी (यहोशू 9:17–18)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gibeon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di wilayah Benyamin; salah satu dari empat kota orang Hewi yang membuat perjanjian dengan Yosua (Yosua 9:17–18)."
        }
      ]
    },
    "por": {
      "preferred_label": "Gibeom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade no território de Benjamim; uma das quatro cidades heveias que fizeram uma aliança com Josué (Josué 9:17–18)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гаваон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в уделе Вениамина; один из четырех евейских городов, заключивших союз с Иисусом Навином (Иис. Н. 9:17–18)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Gabaón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Poblado en el territorio de Benjamín; una de las cuatro ciudades heveas que hicieron un pacto con Josué (Josué 9:17-18)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gibeoni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji katika eneo la Benyamini; mmoja wa miji minne ya Wahivi iliyofanya agano na Yoshua (Yoshua 9:17–18)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gibeon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long graun bilong Benjamin; em wanpela bilong 4-pela taun bilong ol Hivi i bin mekim kontrak wantaim Josua (Josua 9:17–18)."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبعون",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في أرض بنيامين؛ واحدة من المدن الأربعة بتاعة الحويين العملوا عهد مع يشوع (يشوع 9: 17-18)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gibeon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long teritori blong Benjamin; wan long fo taon blong ol man Hif we oli mekem wan promis wetem Josua (Josua 9:17–18)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gibiọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na mpaghara Benjamin; otu nʼime obodo anọ nke ndị Haiv nke meere Joshua ọgbụgba ndụ (Joshua 9:17–18)."
        }
      ]
    },
    "nep": {
      "preferred_label": "गिबोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिन्यामीनको इलाकामा रहेको एउटा सहर; यहोशूसँग करार बाँध्ने चारवटा हिब्बी सहरहरूमध्ये एक (यहोशू ९:१७–१८)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ga-ba-ôn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn trong lãnh thổ Bên-gia-min; một trong bốn thành phố của người Hê-vít đã lập giao ước với Giô-suê (Giô-suê 9:17–18)."
        }
      ]
    },
    "zht": {
      "preferred_label": "基遍",
      "descriptions": [
        {
          "source": "acai",
          "description": "便雅憫境內的一座城鎮；與約書亞立約的四座希未人城鎮之一（約書亞記 9:17–18）。"
        }
      ]
    }
  },
