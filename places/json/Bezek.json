        }
      ]
    },
    "tpi": {
      "preferred_label": "Besek (bilong Manase)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long graun bilong lain Manase, em ples we ol Israel i bin kilim 10,000 man bilong Kenan na Peres (Hetman 1:4)."
        }
      ]
    },
    "apd": {
      "preferred_label": "بابق (تبع منسى)",
