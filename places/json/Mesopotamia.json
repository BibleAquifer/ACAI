      "preferred_label": "مَا بَيْنَ ٱلنَّهْرَيْنِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "منطقة تقع بين نهري دجلة والفرات؛ وكانت جنة عدن تقع هناك."
        }
      ]
    },
    "zhs": {
      "preferred_label": "美索不达米亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "底格里斯河和幼发拉底河之间的地区；伊甸园曾位于此地。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Mésopotamie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Région située entre le Tigre et l’Euphrate ; le jardin d’Éden s’y trouvait."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mesofotamiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani yanki a tsakanin Kogunan Tigris da Yuferites; a nan Lambun Adnin yake."
        }
      ]
    },
    "hin": {
      "preferred_label": "मेसोपोटामिया",
      "descriptions": [
        {
          "source": "acai",
          "description": "दजला और फरात नदियों के बीच का एक क्षेत्र; अदन की वाटिका यहीं स्थित थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Mesopotamia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah wilayah di antara Sungai Tigris dan Efrat; Taman Eden terletak di sini."
        }
      ]
    },
    "por": {
      "preferred_label": "Mesopotâmia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma região entre os rios Tigre e Eufrates; o Jardim do Éden ficava localizado aqui."
        }
      ]
    },
    "rus": {
      "preferred_label": "Месопотамия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Область между реками Тигр и Евфрат; здесь находился Эдемский сад."
        }
      ]
    },
    "spa": {
      "preferred_label": "Mesopotamia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Región entre los ríos Tigris y Éufrates; el jardín del Edén estaba ubicado aquí."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mesopotamia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eneo lililoko kati ya Mito ya Tigri na Frati; Bustani ya Edeni ilikuwa hapa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mesopotemia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hap graun namel long wara Taigris na wara Yufretis; gaden Iden i bin stap long dispela hap."
        }
      ]
    },
    "apd": {
      "preferred_label": "بلاد ما بين النهرين",
      "descriptions": [
        {
          "source": "acai",
          "description": "منطقة بين نهري الدجلة والفرات؛ وجنة عدن كانت موجودة هناك."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mesopotemia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan rijen long medel blong ol reva ya Taegris mo Yufretes; garen blong Iden i bin stap long ples ya."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mesopotamịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpaghara dị nʼetiti osimiri Taigris na Yufretis; ogige Iden dị nʼebe a."
        }
      ]
    },
    "nep": {
      "preferred_label": "मेसोपोटामिया",
      "descriptions": [
        {
          "source": "acai",
          "description": "दजला (टाइग्रिस) र युफ्रेटिस नदीहरूको बीचको एउटा क्षेत्र; अदनको बगैँचा यहीँ अवस्थित थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Mê-sô-pô-ta-mi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vùng đất nằm giữa sông Ti-gơ-rơ và sông Ơ-phơ-rát; vườn Ê-đen nằm ở nơi này."
        }
      ]
    },
    "zht": {
      "preferred_label": "美索不達米亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於底格里斯河與幼發拉底河之間的地區；伊甸園座落於此。"
        }
      ]
    }
  },
