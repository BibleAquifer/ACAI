          "article": "place:Abel-mizraim",
          "gloss": "Abel-Mizraim",
          "description": "A location east of the Jordan River where Jacob's children mourned their father (Genesis  50:10-11)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Abel-Mitsraïm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lieu situé à l’est du Jourdain où les enfants de Jacob pleurèrent leur père (Genèse 50.10-11)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Abel-mizraim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un lugar al este del río Jordán donde los hijos de Jacob hicieron duelo por su padre (Génesis 50:10-11)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Abel-Mizrayim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani wuri gabashin Kogin Urdun inda 'ya'yan Yaƙub suka yi makokin mahaifinsu (Farawa 50:10-11)."
        }
      ]
    },
    "hin": {
      "preferred_label": "आबेलमिस्रैम",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरदन नदी के पूर्व में स्थित एक स्थान, जहाँ याकूब के पुत्रों ने अपने पिता के लिए विलाप किया था (उत्पत्ति 50:10-11)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Abel-Mizraim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah lokasi di sebelah timur Sungai Yordan tempat anak-anak Yakub meratapi ayah mereka (Kejadian 50:10-11)."
        }
      ]
    },
    "por": {
      "preferred_label": "Abel-Mizraim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um lugar a leste do rio Jordão onde os filhos de Jacó prantearam seu pai (Gênesis 50:10-11)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Abel Misraim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples long hap sankamap bilong Wara Jordan we ol pikinini bilong Jekop i bin sori na krai bilong papa bilong ol (Stat 50:10-11)."
        }
      ]
    },
    "apd": {
      "preferred_label": "آبيل مصرايم",
      "descriptions": [
        {
          "source": "acai",
          "description": "مكان شرق نهر الأردن وين أولاد يعقوب بكوا على أبوهم (تكوين 50: 10-11)."
        }
      ]
    },
    "arb": {
      "preferred_label": "آبَل مِصْرَايِمَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "موقع شرقي نهر الأردن ناح فيه بنو يعقوب على أبيهم (تكوين ٥٠: ١٠-١١)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Abelmisraem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ples long is saed blong Jodan Reva we ol pikinini blong Jekob oli bin krae sore from papa blong olgeta long hem (Jenesis 50:10-11)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebel-Mizraim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu ebe dị nʼọwụwa anyanwụ Osimiri Jọdan ebe ụmụ Jekọb ruru ụjụ nna ha (Jenesis 50:10-11)."
        }
      ]
    },
    "nep": {
      "preferred_label": "हाबिल-मिश्रइम",
      "descriptions": [
        {
          "source": "acai",
          "description": "यर्दन नदीको पूर्वपट्टि रहेको एक ठाउँ जहाँ याकूबका छोराछोरीहरूले आफ्ना बुबाको निम्ति शोक गरेका थिए (उत्पत्ति ५०:१०-११)।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Авел-Мицраим",
      "descriptions": [
        {
          "source": "acai",
          "description": "Местность к востоку от реки Иордан, где дети Иакова оплакивали своего отца (Бытие 50:10-11)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Abel-mizraimu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahali mashariki mwa Mto Yordani ambapo watoto wa Yakobo walimwombolezea baba yao (Mwanzo 50:10-11)."
        }
      ]
    },
    "vie": {
      "preferred_label": "A-bên Mích-ra-im",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một địa điểm ở phía đông sông Giô-đan, nơi các con của Gia-cốp than khóc cha mình (Sáng Thế Ký 50:10-11)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚伯·麦西",
      "descriptions": [
        {
          "source": "acai",
          "description": "约旦河东岸的一个地点，雅各的众子在此为他们的父亲哀悼（创世记 50:10-11）。"
        }
      ]
    },
    "zht": {
      "preferred_label": "亞伯‧麥西",
      "descriptions": [
        {
          "source": "acai",
          "description": "約旦河東的一處地方，雅各的兒女曾在那裡為他們的父親哀哭（創世記 50:10-11）。"
        }
      ]
    }
  },
