        }
      ]
    },
    "fra": {
      "preferred_label": "Jahats",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville lévitique située sur le territoire de Ruben, attribuée au clan de Merari ; plus tard occupée par Moab."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yahaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani garin Firistoci a yankin Ruben, wanda aka ba dangin Merari; daga baya Mowabawa suka mamaye shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहस",
      "descriptions": [
        {
          "source": "acai",
          "description": "रूबेन के क्षेत्र का एक लेविय नगर, जिसे मरारी के कुल को सौंपा गया था; बाद में इस पर मोआब का अधिकार हो गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yahas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota orang Lewi di wilayah suku Ruben, yang ditetapkan bagi kaum Merari; kemudian diduduki oleh Moab."
        }
      ]
    },
    "por": {
      "preferred_label": "Jaza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade levítica no território de Rúben, designada ao clã de Merari; mais tarde ocupada por Moabe."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иааца",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитский город на территории Рувима, выделенный роду Мерари; позже занятый Моавом."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jahas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Poblado levítico en el territorio de Rubén, asignado al clan de Merari; más tarde ocupado por Moab."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yahazi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa Walawi katika eneo la Reubeni, uliogawiwa kwa ukoo wa Merari; baadaye ulikaliwa na Moabu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jahas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun bilong ol Livai long hap graun bilong Ruben, ol i givim long lain bilong Merari; bihain ol Moap i kisim."
        }
      ]
    },
    "apd": {
      "preferred_label": "يهاص",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في أرض رأوبين، اتخصصت لعشيرة مراري؛ وبعدين احتلوها الموآبيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jahaj",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon blong ol Livaet long graon blong Ruben, we oli bin givim long laen blong Merari; biaen ol man Moab oli bin tekem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jahaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo ndị Livaị dị n'ókèala Ruben, nke e kenyere ezinụlọ Merari; nke Moab mechara weghara."
        }
      ]
    },
    "nep": {
      "preferred_label": "यहसा",
      "descriptions": [
        {
          "source": "acai",
          "description": "रूबेनको इलाकामा अवस्थित एक लेवी सहर, जुन मरारीको कुललाई दिइएको थियो; पछि मोआबद्वारा कब्जा गरिएको।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Gia-hát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn của người Lê-vi trong lãnh thổ của Ru-bên, được phân bổ cho thị tộc Mê-ra-ri; về sau bị Mô-áp chiếm đóng."
        }
      ]
    },
    "zht": {
      "preferred_label": "雅雜",
      "descriptions": [
        {
          "source": "acai",
          "description": "流便境內的一座利未城鎮，分配給米拉利家族；後來被摩押佔領。"
        }
      ]
    }
