  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Shechem",
      "alternate_labels": [
        "Moreh",
        "Sichem",
        "Sychem",
        "Shechemites"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Shechem",
          "gloss": "Shechem",
          "description": "A Levitical town of refuge in the hill country of the territory of Ephraim; assigned to the clan of Kohath. God appeared to Abram at Shechem and Abram built an altar."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَكِيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة ملجأ لاوية في جبل أرض أفرايم؛ خُصصت لعشيرة قهات. ظهر الله لأبرام في شكيم وبنى أبرام مذبحًا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "示剑",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法莲领地山地的一座利未人逃城；分给了哥辖宗族。上帝曾在示剑向亚伯兰显现，亚伯兰在那里筑了一座坛。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Sichem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville lévitique de refuge dans la région montagneuse du territoire d'Éphraïm ; attribuée au clan de Kehath. Dieu apparut à Abram à Sichem et Abram y bâtit un autel."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shekem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani birnin mafaka na Lawiyawa a ƙasar tuddai ta yankin Efraim; an ba wa dangin Kohatawa shi. Allah ya bayyana ga Abram a Shekem, Abram kuma ya gina bagadi."
        }
      ]
    },
    "hin": {
      "preferred_label": "शेकेम",
      "descriptions": [
        {
          "source": "acai",
          "description": "एप्रैम के क्षेत्र के पहाड़ी देश में लेवियों का एक शरणनगर; जो कहात के कुल को सौंपा गया था। परमेश्वर शेकेम में अब्राम को दिखाई दिए और अब्राम ने वहाँ एक वेदी बनाई।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Sikhem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota perlindungan orang Lewi di pegunungan wilayah suku Efraim; ditentukan bagi kaum Kehat. Allah menampakkan diri kepada Abram di Sikhem dan Abram mendirikan sebuah mezbah."
        }
      ]
    },
    "por": {
      "preferred_label": "Siquém",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade levítica de refúgio na região montanhosa do território de Efraim; designada ao clã de Coate. Deus apareceu a Abrão em Siquém, e Abrão construiu um altar."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сихем",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитский город-убежище в нагорной части удела Ефрема; был выделен роду Каафа. Бог явился Авраму в Сихеме, и Аврам построил жертвенник."
        }
      ]
    },
    "spa": {
      "preferred_label": "Siquén",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad levítica de refugio en la región montañosa del territorio de Efraín; asignada al clan de Coat. Dios se le apareció a Abram en Siquén y Abram edificó un altar."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shekemu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa makimbilio wa Walawi katika nchi ya milima ya eneo la Efraimu; uliotengwa kwa ajili ya ukoo wa Kohathi. Mungu alimtokea Abramu huko Shekemu na Abramu akajenga madhabahu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sekem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun bilong ol Livai bilong hait long en, i stap long ples maunten long teritori bilong Efraim; em i hap graun bilong lain famili bilong Kohat. God i bin kamap long Abram long Sekem na Abram i bin wokim wanpela alta."
        }
      ]
    },
    "apd": {
      "preferred_label": "شكيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة ملجأ للاويين في منطقة الجبال في أرض أفرايم؛ اتخصصت لعشيرة قهات. الله ظهر لأبرام في شكيم، وأبرام بنى هناك مدبح."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sekem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon blong ol Livaet blong haed long hem long hil kantri long teritori blong Efrem; we oli givim long laen blong Kohat. God i bin kamaot long Abram long Sekem mo Abram i bin wokem wan olta long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shekem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo mgbaba nke ndị Livayị nʼugwu nke ókèala Ifrem; nke e kenyere ezinụlọ Kohat. Chineke pụtara nʼihu Ebram na Shekem ma Ebram wuru ebe ịchụàjà nʼebe ahụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "शकेम",
      "descriptions": [
        {
          "source": "acai",
          "description": "एफ्राइमको इलाकाको पहाडी देशमा रहेको शरण दिइने लेवी सहर; कहातका कुललाई तोकिएको। परमेश्‍वर शकेममा अब्रामकहाँ देखा पर्नुभयो र अब्रामले एउटा वेदी बनाए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Si-chem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn lánh nạn thuộc người Lê-vi trong vùng đồi núi thuộc lãnh thổ Ép-ra-im; được chia cho thị tộc Kê-hát. Đức Chúa Trời đã hiện ra với Áp-ram tại Si-chem và Áp-ram đã lập một bàn thờ."
        }
      ]
    },
    "zht": {
      "preferred_label": "示劍",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法蓮領地山地中的一座利未逃城；分給了哥轄家族。上帝曾在示劍向亞伯蘭顯現，亞伯蘭在那裡築了一座壇。"
        }
      ]
    }
  },
