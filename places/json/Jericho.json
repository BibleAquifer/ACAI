  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Jericho (Old Testament)",
      "alternate_labels": [
        "Jericho"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Jericho.1",
          "gloss": "Jericho (Old Testament)",
          "description": "A town northwest of the Dead Sea in the territory of Benjamin; first town conquered by Israel after they entered Canaan."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَرِيحَا (العهد القديم)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة تقع شمال غرب البحر الميت في أرض بنيامين؛ وهي أول بلدة فتحها بنو إسرائيل بعد دخولهم كنعان."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耶利哥（旧约）",
      "descriptions": [
        {
          "source": "acai",
          "description": "死海西北部位于便雅悯境内的一座城镇；是以色列人进入迦南后攻占的第一座城镇。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jéricho (Ancien Testament)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville située au nord-ouest de la mer Morte, sur le territoire de Benjamin ; première ville conquise par Israël après son entrée en Canaan."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yeriko (Tsohon Alkawari)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a arewa maso yammacin Bahar Matattu a yankin Benyamin; garin farko da Isra'ilawa suka ci bayan sun shiga Kan'ana."
        }
      ]
    },
    "hin": {
      "preferred_label": "यरीहो (पुराना नियम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मृत सागर के पश्चिमोत्तर में बिन्यामीन के क्षेत्र का एक नगर; कनान में प्रवेश करने के बाद इस्राएलियों द्वारा जीता गया पहला नगर।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yerikho (Perjanjian Lama)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di sebelah barat laut Laut Mati di wilayah Benyamin; kota pertama yang ditaklukkan oleh Israel setelah mereka memasuki Kanaan."
        }
      ]
    },
    "por": {
      "preferred_label": "Jericó (Antigo Testamento)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade a noroeste do mar Morto, no território de Benjamim; primeira cidade conquistada por Israel depois de entrarem em Canaã."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иерихон (Ветхий Завет)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город к северо-западу от Мертвого моря в уделе Вениамина; первый город, завоеванный Израилем после входа в Ханаан."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jericó (Antiguo Testamento)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad al noroeste del mar Muerto en el territorio de Benjamín; la primera ciudad conquistada por Israel después de entrar en Canaán."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yeriko (Agano la Kale)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko kaskazini-magharibi mwa Bahari ya Chumvi katika eneo la Benyamini; mji wa kwanza kutekwa na Israeli baada ya kuingia Kanaani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jeriko (Olpela Testamen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long hap not-wes bilong Solwara Dait long graun bilong Benjamin; em i namba wan taun ol Israel i bin daunim taim ol i go insait long Kenan."
        }
      ]
    },
    "apd": {
      "preferred_label": "أريحا (العهد القديم)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة شمال غرب البحر الميت في أرض بنيامين؛ أول مدينة فتحوها بني إسرائيل بعد ما دخلوا كنعان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jeriko (Olfala Testeman)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long notwes blong Ded Si long graon blong Benjamin; fas taon we Isrel i tekem afta we oli go insaed long Kenan."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jeriko (Ọgbụgba Ndụ Ochie)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nʼakụkụ ugwu ọdịda anyanwụ nke Oké Osimiri Nwụrụ Anwụ nʼókèala Benjamin; obodo mbụ ndị Izrel meriri mgbe ha banyere na Kenan."
        }
      ]
    },
    "nep": {
      "preferred_label": "यरीहो (पुरानो नियम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मरेको समुद्रको उत्तर-पश्‍चिममा बेन्यामीनको इलाकामा रहेको एउटा सहर; इस्राएलीहरू कनानमा प्रवेश गरेपछि उनीहरूले जितेको पहिलो सहर।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giê-ri-cô (Cựu Ước)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn nằm ở phía tây bắc Biển Chết thuộc lãnh thổ Bê-nhia-min; là thành đầu tiên người Y-sơ-ra-ên đánh chiếm sau khi tiến vào Ca-na-an."
        }
      ]
    },
    "zht": {
      "preferred_label": "耶利哥（舊約）",
      "descriptions": [
        {
          "source": "acai",
          "description": "死海西北方位於便雅憫境內的一座城鎮；是以色列人進入迦南後攻佔的第一座城。"
        }
      ]
    }
  },
