          "source": "acai",
          "article": "place:Iye-abarim",
          "gloss": "Iye-Abarim",
          "description": "A location east of Moab, along the route of the exodus; also known as Iim."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَيِّي عَبَارِيمَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "موقع شرقي موآب، على طريق الخروج؛ يُعرف أيضًا باسم عيّيم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以耶·亚巴琳",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩押以东的一个地点，位于出埃及的路线上；又名以因。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Ijjé-Abarim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lieu situé à l’est de Moab, sur l’itinéraire de l’Exode ; également appelé Ijjim."
        }
      ]
    },
    "hau": {
      "preferred_label": "Iye Abarim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani wuri ne a gabashin Mowab, a kan hanyar fitowa daga Masar; wanda kuma aka sani da Iyim."
        }
      ]
    },
    "ind": {
      "preferred_label": "Iye-Abarim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah lokasi di sebelah timur Moab, di sepanjang rute keluaran; juga dikenal sebagai Iyim."
        }
      ]
    },
    "por": {
      "preferred_label": "Ijé-Abarim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um local a leste de Moabe, ao longo da rota do êxodo; também conhecido como Iim."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ийм-Аварим",
      "descriptions": [
        {
          "source": "acai",
          "description": "Местность к востоку от Моава на пути исхода; также известна как Иим."
        }
      ]
    },
    "spa": {
      "preferred_label": "Iyé-abarim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lugar al este de Moab, a lo largo de la ruta del éxodo; también conocido como Iim."
        }
      ]
    },
    "swh": {
      "preferred_label": "Iye-Abarimu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahali mashariki mwa Moabu, kando ya njia ya kutoka Misri; panajulikana pia kama Iyimu."
        }
      ]
    },
    "apd": {
      "preferred_label": "عيي عباريم",
      "descriptions": [
        {
          "source": "acai",
          "description": "مكان شرق موآب، في طريق الخروج؛ ومعروف كمان باسم عيّيم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Abarim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ples long is long graon blong Moab, long rod blong eksodas; we nem blong hem tu Iim."
        }
      ]
    },
    "hin": {
      "preferred_label": "इये-अबारीम",
      "descriptions": [
        {
          "source": "acai",
          "description": "मोआब के पूर्व में मिस्र-प्रस्थान के मार्ग पर स्थित एक स्थान; इसे इय्यीम भी कहा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Iye Abarim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ebe dị nʼọwụwa anyanwụ Moab, nʼakụkụ ụzọ ọpụpụ ahụ; nke a makwaara dị ka Iim."
        }
      ]
    },
    "nep": {
      "preferred_label": "इये-अबारीम",
      "descriptions": [
        {
          "source": "acai",
          "description": "मोआबको पूर्वमा प्रस्थानको मार्गमा पर्ने एउटा स्थान; यसलाई ईम पनि भनिन्छ।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Iye-Abarim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples long hap sankamap bilong Moap, long rot bilong ol Isrel i lusim Isip; ol i kolim tu long Iim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Y-giê A-ba-rim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một địa điểm ở phía đông Mô-áp, trên lộ trình Xuất hành; còn được gọi là Y-im."
        }
      ]
    },
    "zht": {
      "preferred_label": "以耶‧亞巴琳",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於摩押東邊的地點，處於出埃及路線上；又稱以因。"
        }
      ]
    }
  },
