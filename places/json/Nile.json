      "descriptions": [
        {
          "source": "acai",
          "article": "place:Nile",
          "gloss": "Nile River",
          "description": "A large body of flowing water located in Egypt; very important to transportation, irrigation, and life in Egypt."
        }
      ]
    },
    "arb": {
      "preferred_label": "نهر النيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "مجرى مائي كبير يقع في مصر، وكان ذا أهمية بالغة للنقل والري والحياة في مصر."
        }
      ]
    },
    "zhs": {
      "preferred_label": "尼罗河",
      "descriptions": [
        {
          "source": "acai",
          "description": "位于埃及的一条大河；对埃及的交通、灌溉和生活都至关重要。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kogin Nilu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban kogin da yake gudana a ƙasar Masar; mai matuƙar muhimmanci ga harkokin sufuri, ban-ruwa, da rayuwa a Masar."
        }
      ]
    },
    "ind": {
      "preferred_label": "Sungai Nil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suatu perairan mengalir yang besar yang terletak di Mesir; sangat penting bagi transportasi, irigasi, dan kehidupan di Mesir."
        }
      ]
    },
    "por": {
      "preferred_label": "Rio Nilo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um grande corpo de água corrente localizado no Egito; muito importante para o transporte, a irrigação e a vida no Egito."
        }
      ]
    },
    "rus": {
      "preferred_label": "Нил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупный водный поток, расположенный в Египте; имел важнейшее значение для транспорта, орошения и жизни в Египте."
        }
      ]
    },
    "spa": {
      "preferred_label": "río Nilo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gran masa de agua corriente situada en Egipto; muy importante para el transporte, el regadío y la vida en Egipto."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mto Naili",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbo kubwa la maji yanayotiririka lililoko Misri; muhimu sana kwa usafiri, umwagiliaji maji, na maisha nchini Misri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Wara Nail",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela wara i stap long Isip; em i bikpela samting tru long ol bot i ken ran, long givim wara long ol gaden, na long laip bilong ol manmeri long Isip."
        }
      ]
    },
    "apd": {
      "preferred_label": "نهر النيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "مجرى مائي كبير جاري في مصر؛ مهم شديد للمواصلات والري والحياة في مصر."
        }
      ]
    },
    "bis": {
      "preferred_label": "Nael Reva",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala reva we i stap long Isip; hem i impoten tumas blong mekem rod blong gogo wetem bot, givim wota long garen, mo long laef long Isip."
        }
      ]
    },
    "fra": {
      "preferred_label": "Nil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un grand cours d’eau situé en Égypte ; très important pour le transport, l’irrigation et la vie en Égypte."
        }
      ]
    },
    "hin": {
      "preferred_label": "नील नदी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिस्र में बहने वाला जल का एक विशाल स्रोत; मिस्र में यातायात, सिंचाई और जीवन के लिए अत्यंत महत्वपूर्ण।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Osimiri Naịl",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu osimiri na-eru eruru nke dị nʼIjipt; ọ dị oke mkpa maka njem, ịgba mmiri nʼubi, na ndụ nʼIjipt."
        }
      ]
    },
    "nep": {
      "preferred_label": "नील नदी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिश्रमा अवस्थित बगिरहेको पानीको ठूलो मुहान वा नदी; यो मिश्रमा यातायात, सिँचाइ र जीवनका निम्ति अत्यन्तै महत्त्वपूर्ण थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sông Nin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nguồn nước chảy lớn nằm ở Ai Cập; rất quan trọng đối với giao thông, thủy lợi và sự sống ở Ai Cập."
        }
      ]
    },
    "zht": {
      "preferred_label": "尼羅河",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於埃及的大型流動水體；對埃及的交通、灌溉與生活極為重要。"
        }
      ]
    }
  },
