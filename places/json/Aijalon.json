  "localizations": {
    "eng": {
      "preferred_label": "Aijalon (of Dan)",
      "alternate_labels": [
        "Ajalon",
        "Aijalon"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Aijalon.1",
          "gloss": "Aijalon (of Dan)",
          "description": "A Levitical town in the territory of Dan, assigned to the clan of Kohath. It was later held by the tribe of Benjamin (1 Chronicles 8:13)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Ajalon (de Dan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville lévitique située sur le territoire de Dan, attribuée au clan de Kehath. Elle appartint plus tard à la tribu de Benjamin (1 Chroniques 8:13)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ayalón (de Dan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad levítica en el territorio de Dan, asignada al clan de Coat. Más tarde estuvo en posesión de la tribu de Benjamín (1 Crónicas 8:13)."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَيَّلُونَ (في دَانَ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في أرض دان، خُصِّصت لعشيرة قَهات. واستحوذ عليها سبط بنيامين لاحقاً (أخبار الأيام الأول 8: 13)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚雅仑 (但)",
      "descriptions": [
        {
          "source": "acai",
          "description": "但领地内分给哥辖家族的一座利未人城镇，后来由便雅悯支派据有（代上8:13）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Aiyalon (na Dan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani garin Lawiyawa a yankin Dan, wanda aka ba wa dangin Kohat. Daga baya ƙabilar Benyamin ta mallake shi (1 Labarbaru 8:13)."
        }
      ]
    },
    "hin": {
      "preferred_label": "अय्यालोन (दान का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दान के क्षेत्र में स्थित एक लेवीय नगर, जिसे कहात के कुल को सौंपा गया था। बाद में यह बिन्यामीन के गोत्र के अधिकार में था (1 इतिहास 8:13)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ayalon (Dan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota orang Lewi di daerah suku Dan, yang diberikan kepada kaum Kehat. Kota ini kemudian dikuasai oleh suku Benyamin (1 Tawarikh 8:13)."
        }
      ]
    },
    "por": {
      "preferred_label": "Aijalom (de Dã)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade levítica no território de Dã, designada ao clã de Coate. Mais tarde foi ocupada pela tribo de Benjamim (1 Crônicas 8:13)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аиалон (Дан)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитский город на территории колена Дана, отведенный роду Каафа. Позже принадлежал колену Вениамина (1 Пар. 8:13)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Aiyaloni (ya Dani)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa Walawi katika eneo la Dani, uliogawiwa ukoo wa Kohathi. Baadaye ulishikiliwa na kabila la Benyamini (1 Mambo ya Nyakati 8:13)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Aijalon (bilong Dan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun bilong ol Livai long graun bilong Dan, em ol i bin givim long famili bilong Kohat. Bihain lain Benjamin i bin holim dispela taun (1 Stori 8:13)."
        }
      ]
    },
    "apd": {
      "preferred_label": "أيلون (حقت دان)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة للاويين في أراضي دان، اتخصصت لعشيرة قَهات. بعدين مسكوها سبط بنيامين (أخبار الأيام الأول 8: 13)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Aealon (blong Dan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon blong ol Livaet long graon blong laen blong Dan, we oli givim long laen blong Kohat. Biaen laen blong Benjamin oli holem taon ya (1 Kronikel 8:13)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aijalon (nke Dan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo ndị Livayị dị nʼókèala Dan, nke e kenyere ezinụlọ Kohat. Ndị ebo Benjamin mechara nweta ya (1 Ihe E Mere 8:13)."
        }
      ]
    },
    "nep": {
      "preferred_label": "अय्यालोन (दानको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दानको इलाकामा रहेको लेवीहरूको एउटा सहर, जो कहातको कुललाई दिइएको थियो। पछि यो बेन्यामीन कुलको अधीनमा थियो (१ इतिहास ८:१३)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-gia-lôn (của Đan)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn của người Lê-vi thuộc lãnh thổ Đan, được chỉ định cho thị tộc Kê-hát. Về sau thị trấn này do bộ tộc Bên-gia-min nắm giữ (1 Sử Ký 8:13)."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞雅崙 (但)",
      "descriptions": [
        {
          "source": "acai",
          "description": "但境內的一座利未城鎮，分給哥轄家族。後來歸便雅憫支派所有（歷代志上 8:13）。"
        }
      ]
    }
  },
