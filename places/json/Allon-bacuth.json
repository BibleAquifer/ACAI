          "source": "acai",
          "article": "place:Allon-bacuth",
          "gloss": "Allon-bachuth",
          "description": "An oak tree near Bethel where Deborah, Rebekah's nurse, was buried (Genesis 35:8)."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَلُّونَ بَاكُوتَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة بلوط بالقرب من بيت إيل حيث دُفنت دبورة مرضعة رفقة (تكوين 35: 8)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚伦·巴古",
      "descriptions": [
        {
          "source": "acai",
          "description": "伯特利附近的一棵橡树，利百加的奶妈底波拉安葬于此（创世记 35:8）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Allon-Bacuth",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chêne près de Béthel où fut enterrée Débora, la nourrice de Rebecca (Genèse 35.8)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Allon Bakut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani itacen oak kusa da Betel inda aka binne Debora, ungozomar Rebeka (Farawa 35:8)."
        }
      ]
    },
    "hin": {
      "preferred_label": "अल्लोनबक्कूत",
      "descriptions": [
        {
          "source": "acai",
          "description": "बेतेल के पास का एक बांज वृक्ष जहाँ रिबका की दाई दबोरा को दफनाया गया था (उत्पत्ति 35:8)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Pohon Besar Penangisan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah pohon besar dekat Betel tempat Debora, inang pengasuh Ribka, dimakamkan (Kejadian 35:8)."
        }
      ]
    },
    "por": {
      "preferred_label": "Alom-Bacute",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um carvalho perto de Betel onde Débora, a ama de Rebeca, foi sepultada (Gênesis 35:8)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Alón-bacut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una encina cerca de Betel donde fue sepultada Débora, la nodriza de Rebeca (Génesis 35:8)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Alon-bakuthi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mti wa mwaloni karibu na Betheli ambapo Debora, mlezi wa Rebeka, alizikwa (Mwanzo 35:8)."
        }
      ]
    },
    "apd": {
      "preferred_label": "ألون باكوث",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة بلوط قريبة من بيت إيل دفنوا تحتها دبورة، مرضعة رفقة (تكوين 35: 8)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Alonbakut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan oktri klosap long Betel we oli berem Debora long hem, woman ya we i bin lukaot long Rebeka (Jenesis 35:8)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Alon-bakut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu osisi ook dị nso na Betel ebe e liri Debọra, nwanyị lekọtara Ribeka (Jenesis 35:8)."
        }
      ]
    },
    "nep": {
      "preferred_label": "अल्लोन-बकुत",
      "descriptions": [
        {
          "source": "acai",
          "description": "बेथेलनेरको एउटा फलाँटको रुख जहाँ रिबेकाकी धाई दबोरालाई गाडिएको थियो (उत्पत्ति ३५:८)।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Аллон-Бахут",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дуб близ Вефиля, под которым была погребена Девора, кормилица Ревекки (Бытие 35:8)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Alon-bakut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela diwai ok klostu long Betel em ol i bin planim Debora, wokmeri bilong Rebeka, aninit long en (Stat 35:8)."
        }
      ]
    },
    "vie": {
      "preferred_label": "A-long-ba-cúc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cây sồi gần Bê-tên, nơi chôn cất Đê-bô-ra, vú nuôi của Rê-bê-ca (Sáng Thế Ký 35:8)."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞倫‧巴古",
      "descriptions": [
        {
          "source": "acai",
          "description": "伯特利附近的一棵橡樹，利百加的奶母底波拉葬於此處（創世記 35:8）。"
        }
      ]
    }
  },
