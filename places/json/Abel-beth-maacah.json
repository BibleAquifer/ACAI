      "descriptions": [
        {
          "source": "acai",
          "article": "place:Abel-beth-maacah",
          "gloss": "Abel-Beth-Maacah",
          "description": "A town in the territory of Naphtali in northern Israel. Joab, commander of David's army, besieged this town (2 Samuel 20:14–22)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚伯·伯·玛迦",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列北部拿弗他利境内的一座城邑。大卫军队的统帅约押曾围攻此城（撒母耳记下20:14–22）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Abel-Beth-Maaca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville située sur le territoire de Nephthali, dans le nord d’Israël. Joab, chef de l’armée de David, assiégea cette ville (2 Samuel 20.14–22)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Abel-Bet-Ma’aka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari ne a yankin Naftali a arewacin Isra’ila. Yowab, kwamandan rundunar Dawuda, ya kewaye wannan gari (2 Sama’ila 20:14–22)."
        }
      ]
    },
    "hin": {
      "preferred_label": "आबेल्वेत्माका",
      "descriptions": [
        {
          "source": "acai",
          "description": "उत्तरी इस्राएल में नप्ताली के क्षेत्र में स्थित एक नगर। दाऊद की सेना के प्रधान योआब ने इस नगर की घेराबंदी की थी (2 शमूएल 20:14–22)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Abel-Bet-Maakha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di wilayah Naftali di Israel utara. Yoab, panglima tentara Daud, mengepung kota ini (2 Samuel 20:14–22)."
        }
      ]
    },
    "por": {
      "preferred_label": "Abel-Bete-Maaca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade no território de Naftali, no norte de Israel. Joabe, comandante do exército de Davi, sitiou essa cidade (2 Samuel 20:14–22)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Авел-Беф-Мааха",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в уделе Неффалима в северном Израиле. Иоав, военачальник Давида, осаждал этот город (2 Царств 20:14–22)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Abel-bet-maaca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad en el territorio de Neftalí, en el norte de Israel. Joab, comandante del ejército de David, sitió esta ciudad (2 Samuel 20:14-22)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Abel-Beth-Maaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji katika eneo la Naftali kaskazini mwa Israeli. Yoabu, jemadari wa jeshi la Daudi, aliuzingira mji huu (2 Samweli 20:14–22)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Abel Betmaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long hap graun bilong Naptali long not bilong Israel. Joap, nambawan ofisa bilong ol soldia bilong Devit, i bin banisim dispela taun (2 Samuel 20:14–22)."
        }
      ]
    },
    "apd": {
      "preferred_label": "آبيل بيت معكة",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في أرض نفتالي في شمال إسرائيل. يوآب، قائد جيش داود، حاصر المدينة دي (٢ صموئيل ٢٠: ١٤-٢٢)."
        }
      ]
    },
    "arb": {
      "preferred_label": "آبَل بَيْت مَعْكَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في أرض نَفْتَالِي في شمال إسرائيل. حاصر يوآب، قائد جيش داود، هذه البلدة (صموئيل الثاني 20: 14-22)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Abelbetmahaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long teritori blong Naftali long not blong Isrel. Joab, komanda blong ami blong Deved, i bin mekem faet agensim taon ya (2 Samuel 20:14–22)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebel-Bet-Maaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo dị n'ókèala Naftalị n'ebe ugwu Izrel. Joab, onyeisi ndị agha Devid, gbara obodo a gburugburu (2 Samuel 20:14–22)."
        }
      ]
    },
    "nep": {
      "preferred_label": "हाबिल-बेथ-माका",
      "descriptions": [
        {
          "source": "acai",
          "description": "उत्तरी इस्राएलको नप्‍ताली इलाकाको एउटा सहर। दाऊदका सेनापति योआबले यस सहरलाई घेरा हालेका थिए (२ शमूएल २०:१४–२२)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-bên Bết-ma-ca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn thuộc lãnh thổ Nép-ta-li ở miền bắc Y-sơ-ra-ên. Giô-áp, tướng chỉ huy quân đội Đa-vít, đã vây hãm thị trấn này (2 Sa-mu-ên 20:14–22)."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞伯‧伯‧瑪迦",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於以色列北部拿弗他利境內的一座城鎮。大衛軍隊的元帥約押曾圍攻這座城鎮（撒母耳記下 20:14–22）。"
        }
      ]
    }
  },
