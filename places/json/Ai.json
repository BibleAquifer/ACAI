  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Ai (of Ephraim)",
      "alternate_labels": [
        "Hai",
        "Aiath",
        "Aija",
        "Ketiv. Qere",
        "city",
        "Ai"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Ai.1",
          "gloss": "Ai (of Ephraim)",
          "description": "A town near Bethel in the territory of Ephraim; probably to be identified with Aiath. After an initial defeat, the Canaanite town was eventually conquered by the Israelites (Joshua 7–8)."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَاي (في أَفْرَايِمَ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة بالقرب من بيت إيل في أرض أفرايم؛ يُرجَّح أنها هي نفسها عَيّاث. وبعد هزيمة أولى، فتحها بنو إسرائيل في النهاية (يشوع 7–8)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "艾城 (以法莲)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法莲领地内靠近伯特利的一座城镇；可能等同于亚叶。在最初的失败后，这座迦南城镇最终被以色列人攻占（书7-8）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Aï (d'Éphraïm)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville près de Béthel sur le territoire d'Éphraïm ; probablement à identifier avec Ajjath. Après une première défaite, la ville cananéenne fut finalement conquise par les Israélites (Josué 7–8)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ai (na Efraim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari kusa da Betel a yankin Efraim; wataƙila shi ne Ayiyat. Bayan an ci su da yaƙi da farko, a ƙarshe Isra’ilawa suka ci wannan garin Kan’anawa da yaƙi (Joshuwa 7–8)."
        }
      ]
    },
    "hin": {
      "preferred_label": "आई (एप्रैम का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एप्रैम के क्षेत्र में बेतेल के निकट एक नगर; संभवतः इसकी पहचान अय्यात से की जाती है। प्रारंभिक पराजय के बाद, इस कनानी नगर को अंततः इस्राएलियों द्वारा जीत लिया गया था (यहोशू 7–8)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ai (Efraim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota dekat Betel di daerah suku Efraim; mungkin dapat diidentifikasikan dengan Ayat. Setelah kekalahan awal, kota Kanaan ini akhirnya ditaklukkan oleh orang Israel (Yosua 7–8)."
        }
      ]
    },
    "por": {
      "preferred_label": "Ai (de Efraim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade perto de Betel no território de Efraim; provavelmente identificada com Aiate. Após uma derrota inicial, a cidade cananeia foi finalmente conquistada pelos israelitas (Josué 7–8)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гай (Ефрем)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город около Вефиля на территории колена Ефрема; вероятно, отождествляется с Аиафом. После первоначального поражения этот ханаанский город был в итоге завоеван израильтянами (Иис. Нав. 7–8)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hai (de Efraín)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad cerca de Betel en el territorio de Efraín; probablemente identificada con Ajad. Tras una derrota inicial, la ciudad cananea fue finalmente conquistada por los israelitas (Josué 7-8)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ai (ya Efraimu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji karibu na Betheli katika eneo la Efraimu; huenda ndio Ayathi. Baada ya kushindwa kwa mara ya kwanza, mji huo wa Wakanaani hatimaye ulitekwa na Waisraeli (Yoshua 7–8)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ai (bilong Efraim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun klostu long Betel long graun bilong Efraim; ating em i wankain olsem Aiat. Bihain long ol Israel i bin lus pait pastaim, ol i bin winim dispela taun bilong ol Kenan (Josua 7–8)."
        }
      ]
    },
    "apd": {
      "preferred_label": "عاي (حقت أفرايم)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة قريبة من بيت إيل في أراضي أفرايم؛ غالباً هي ذاتها عياث. بعد هزيمة أولية، الإسرائيليين فتحوا المدينة الكنعانية في النهاية (يشوع 7–8)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Eae (blong Efrem)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon klosap long Betel long graon blong laen blong Efrem; ating i sem mak wetem Eae (Aeat). Afta we ol man Isrel oli lus long fas faet blong olgeta, oli bin winim taon ya blong ol man Kenan biaen (Josua 7–8)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ai (nke Efrayim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nso na Betel nʼókèala Efrayim; eleghị anya a ga-amata ya dị ka Ayịat. Mgbe mbụ e merisịrị ha, ndị Izrel mechara merie obodo ndị Kenan a (Joshụa 7–8)."
        }
      ]
    },
    "nep": {
      "preferred_label": "ऐ (एफ्राइमको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एफ्राइमको इलाकामा बेथेल नजिकैको एउटा सहर; सायद यसको पहिचान अय्‍यातसँग हुनसक्छ। सुरुको पराजयपछि, इस्राएलीहरूले अन्ततः यस कनानी सहरलाई जितेका थिए (यहोशू ७–८)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-hi (của Ép-ra-im)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn gần Bê-tên thuộc lãnh thổ Ép-ra-im; có lẽ chính là Ai-gia (Aiath). Sau thất bại ban đầu, thị trấn Ca-na-an này cuối cùng đã bị người Y-sơ-ra-ên chinh phục (Giô-suê 7–8)."
        }
      ]
    },
    "zht": {
      "preferred_label": "艾 (以法蓮)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法蓮境內靠近伯特利的一座城鎮；可能即是亞葉。這座迦南城鎮在以色列人初次受挫後，最終被他們攻陷（約書亞記 7–8）。"
        }
      ]
    }
  },
