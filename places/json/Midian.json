  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Midian",
      "alternate_labels": [
        "Midianite woman",
        "Midianites",
        "Madian",
        "Midianite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Midian",
          "gloss": "Midian",
          "description": "Son of Keturah, wife of Abraham; regarded as ancestor of an ethnic group with the same name, and the region they occupied."
        }
      ]
    },
    "arb": {
      "preferred_label": "مِدْيَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن قطورة زوجة إبراهيم، ويُعد سلف الجماعة العرقية المسماة باسمه، والمنطقة التي سكنوها."
        }
      ]
    },
    "zhs": {
      "preferred_label": "米甸",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚伯拉罕之妻基土拉的儿子；被视为同名族群及其所占领区域的始祖。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Madian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Ketura, épouse d’Abraham ; considéré comme l’ancêtre d’un groupe ethnique portant le même nom, ainsi que de la région qu’ils occupaient."
        }
      ]
    },
    "hau": {
      "preferred_label": "Midiyan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Ketura, matar Ibrahim; wanda ake ɗauka a matsayin kakan ƙabilar da ke da suna iri ɗaya, da kuma yankin da suka zauna."
        }
      ]
    },
    "hin": {
      "preferred_label": "मिद्यान",
      "descriptions": [
        {
          "source": "acai",
          "description": "इब्राहीम की पत्नी कतूरा का पुत्र; उसी नाम के एक मानवजातीय समूह और उनके द्वारा बसे हुए क्षेत्र का पूर्वज माना गया।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Midian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari Ketura, istri Abraham; dianggap sebagai leluhur dari suatu kelompok etnis dengan nama yang sama, dan wilayah yang mereka diami."
        }
      ]
    },
    "por": {
      "preferred_label": "Midiã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Quetura, esposa de Abraão; considerado o ancestral de um grupo étnico de mesmo nome e da região que ocupavam."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мадиам",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Хеттуры, жены Авраама; считался предком одноименного народа и области, которую они занимали."
        }
      ]
    },
    "spa": {
      "preferred_label": "Madián",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Cetura, esposa de Abraham; considerado antepasado de un grupo étnico con el mismo nombre y de la región que ocupaban."
        }
      ]
    },
    "swh": {
      "preferred_label": "Midiani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Ketura, mke wa Ibrahimu; anayechukuliwa kama babu wa kundi la kikabila lenye jina hilohilo, na eneo walilokalia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Midian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Ketura, em meri bilong Abraham; ol i save tingim em olsem tumbuna bilong wanpela lain manmeri i gat wankain nem, na hap graun ol i bin sindaun long en."
        }
      ]
    },
    "apd": {
      "preferred_label": "مديان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد قطورة، مرت إبراهيم؛ بيعتبروه جد جماعة عرقية بنفس الاسم، والمنطقة السكنوا فيها."
        }
      ]
    },
    "bis": {
      "preferred_label": "Midian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Ketura, woman blong Ebraham; we hem i olsem stamba blong wan laen we i karem sem nem, mo eria we oli stap long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Midia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke Ketura, nwunye Ebraham; nke a na-ewere dị ka nna nna nke otu agbụrụ nwere otu aha ahụ, nakwa mpaghara ebe ha biri."
        }
      ]
    },
    "nep": {
      "preferred_label": "मिद्यान",
      "descriptions": [
        {
          "source": "acai",
          "description": "अब्राहमकी पत्नी कतूराका छोरा; सोही नामको जाति र तिनीहरू बसोबास गरेको क्षेत्रका पूर्वज मानिएका।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-đi-an",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Kê-tu-ra, vợ của Áp-ra-ham; được xem là tổ phụ của một sắc tộc cùng tên và vùng đất mà họ chiếm đóng."
        }
      ]
    },
    "zht": {
      "preferred_label": "米甸",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞伯拉罕之妻基土拉的兒子；被視為同名族群及其所居地區的祖先。"
        }
      ]
    }
  },
