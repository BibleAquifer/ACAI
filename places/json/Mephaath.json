        }
      ]
    },
    "nep": {
      "preferred_label": "मेपात",
      "descriptions": [
        {
          "source": "acai",
          "description": "रूबेनको इलाकामा पर्ने एउटा लेवी सहर, जुन मरारीको कुललाई दिइएको थियो; पछि मोआबले यसलाई कब्जा गर्‍यो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Mê-phát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn của người Lê-vi thuộc lãnh thổ Ru-bên, được phân bổ cho thị tộc Mê-ra-ri; về sau bị Mô-áp chiếm đóng."
        }
      ]
    },
    "zht": {
      "preferred_label": "米法押",
