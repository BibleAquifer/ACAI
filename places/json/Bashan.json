  "localizations": {
    "eng": {
      "preferred_label": "Bashan",
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Bashan",
          "gloss": "Bashan",
          "description": "A region northeast of the Jordan River which was ruled by King Og and later assigned to half of the tribe of Manasseh."
        }
      ]
    },
    "fra": {
      "preferred_label": "Basan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une région au nord-est du Jourdain qui était gouvernée par le roi Og, puis attribuée à la demi-tribu de Manassé."
        }
      ]
    },
    "spa": {
      "preferred_label": "Basán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Región al noreste del río Jordán gobernada por el rey Og y asignada posteriormente a la media tribu de Manasés."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَاشَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "منطقة تقع شمال شرقي نهر الأردن حكمها الملك عوج وخُصصت لاحقًا لنصف سبط منسى."
        }
      ]
    },
    "zhs": {
      "preferred_label": "巴珊",
      "descriptions": [
        {
          "source": "acai",
          "description": "约旦河东北面的一个地区，曾由噩王统治，后来分配给玛拿西半个支派。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Bashan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani yanki a arewa maso gabashin Kogin Urdun wanda Sarki Og ya mallaka, kuma daga baya aka ba wa rabin kabilar Manasse."
        }
      ]
    },
    "hin": {
      "preferred_label": "बाशान",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरदन नदी के उत्तर-पूर्व का एक क्षेत्र जिस पर राजा ओग का शासन था और बाद में मनश्शे के आधे गोत्र को सौंपा गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Basan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah wilayah di sebelah timur laut Sungai Yordan yang diperintah oleh Raja Og dan kemudian dibagikan kepada setengah suku Manasye."
        }
      ]
    },
    "por": {
      "preferred_label": "Basã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma região a nordeste do rio Jordão governada pelo rei Ogue e posteriormente designada a meia tribo de Manassés."
        }
      ]
    },
    "rus": {
      "preferred_label": "Васан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Область к северо-востоку от реки Иордан, которой правил царь Ог и которая позже была выделена половине колена Манассии."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bashani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eneo lililoko kaskazini-mashariki mwa Mto Yordani lililotawaliwa na Mfalme Ogu na baadaye kupewa nusu ya kabila la Manase."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Basan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela rijen long hap not-isten bilong Wara Jordan em King Ok i bin bosim na bihain ol i givim long hap lain bilong Manase."
        }
      ]
    },
    "apd": {
      "preferred_label": "باشان",
      "descriptions": [
        {
          "source": "acai",
          "description": "منطقة شمال شرق نهر الأردن، كان بيحكمها الملك عوج وبعدين اتخصصت لنص سبط منسّى."
        }
      ]
    },
    "bis": {
      "preferred_label": "Basan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan rijen long not-is saed long Riva blong Jodan we King Og i bin rula long hem mo biaen oli givim long haf blong traeb blong Manase."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Bashan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpaghara dị nʼebe ugwu ọwụwa anyanwụ nke Osimiri Jọdan nke Eze Ọg chịrị ma e mesịa nye ya ọkara ebo Manase."
        }
      ]
    },
    "nep": {
      "preferred_label": "बाशान",
      "descriptions": [
        {
          "source": "acai",
          "description": "यर्दन नदीको उत्तर-पूर्वमा अवस्थित एक क्षेत्र जसमा राजा ओगले शासन गरेका थिए र पछि मनश्शेको आधा कुललाई दिइएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ba-san",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vùng đất ở phía đông bắc Sông Giô-đanh từng do Vua Óc cai trị và sau đó được chia cho nửa chi phái Ma-na-se."
        }
      ]
    },
    "zht": {
      "preferred_label": "巴珊",
      "descriptions": [
        {
          "source": "acai",
          "description": "約旦河東北部的一個地區，曾由巴珊王噩統治，後來分配給瑪拿西半個支派。"
        }
      ]
    }
  },
