        }
      ]
    },
    "por": {
      "preferred_label": "Arubote",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade em Sarom onde viveu Ben-Hesede, um dos doze governadores de Salomão (1 Reis 4:10)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Арюбоф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в Шароне, где жил Бен-Хесед, один из двенадцати приставников Соломона (3 Царств 4:10)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Arubothi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko Sharoni ambako Ben-Hesedi, mmoja wa maofisa kumi na wawili wa Sulemani, aliishi (1 Wafalme 4:10)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Arubot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Saron we Benhesed, wanpela bilong ol 12-pela gavana bilong Solomon, i bin i stap long en (1 King 4:10)."
        }
      ]
    },
    "apd": {
      "preferred_label": "أرُبّوت",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في شارون كان ساكن فيها بن حاسد، واحد من ولاة سليمان الاتناشر (١ ملوك ٤: ١٠)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Arubot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Saron we Ben-Hesed, wan long ol twelef gavman blong Solomon, i laef long hem (1 King 4:10)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Arubot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na Sharon ebe Ben-Hesed, otu nʼime ndị ọchịchị iri na abụọ nke Solomọn, biri (1 Ndị Eze 4:10)."
        }
      ]
    },
    "nep": {
      "preferred_label": "अरूब्बोत",
      "descriptions": [
        {
