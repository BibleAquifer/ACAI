  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Mount Sinai",
      "alternate_labels": [
        "Horeb",
        "Sina",
        "Sinai",
        "Mount Horeb"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:MountSinai",
          "gloss": "Mount Sinai",
          "description": "A mountain and surrounding desert on the Sinai Peninsula in Egypt where YHWH entered into a covenant with Israel; also known as Mount Horeb."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَبَلُ سيناءَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "جبل والصحراء المحيطة به في شبه جزيرة سيناء في مصر حيث قطع الرب عهدًا مع إسرائيل؛ ويُعرف أيضًا باسم جبل حوريب."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西奈山",
      "descriptions": [
        {
          "source": "acai",
          "description": "埃及西奈半岛上的一座山及周围的旷野，耶和华在此与以色列立约；亦称何烈山。"
        }
      ]
    },
    "fra": {
      "preferred_label": "mont Sinaï",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une montagne et le désert environnant dans la péninsule du Sinaï en Égypte, où YHWH a conclu une alliance avec Israël ; également connue sous le nom de mont Horeb."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dutsen Sinai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani dutse da kuma hamadar da ke kewaye da shi a Tsibirin Sinai a Masar inda Yahweh ya ƙulla alkawari da Isra’ila; ana kuma kiran sa Dutsen Horeb."
        }
      ]
    },
    "hin": {
      "preferred_label": "सीनै पर्वत",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिस्र में सीनै प्रायद्वीप पर एक पर्वत और उसके आसपास का मरुभूमि क्षेत्र जहाँ यहोवा ने इस्राएल के साथ एक वाचा बाँधी थी; इसे होरेब पर्वत के नाम से भी जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gunung Sinai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah gunung dan padang gurun di sekitarnya di Semenanjung Sinai di Mesir, tempat YHWH mengikat perjanjian dengan Israel; juga dikenal sebagai Gunung Horeb."
        }
      ]
    },
    "por": {
      "preferred_label": "Monte Sinai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma montanha e deserto ao redor na península do Sinai, no Egito, onde o SENHOR fez uma aliança com Israel; também conhecida como Monte Horebe."
        }
      ]
    },
    "spa": {
      "preferred_label": "monte Sinaí",
      "descriptions": [
        {
          "source": "acai",
          "description": "Monte y desierto circundante en la península del Sinaí en Egipto, donde Yahvé hizo un pacto con Israel; también conocido como monte Horeb."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mlima Sinai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mlima na jangwa linalouzunguka katika Rasi ya Sinai huko Misri ambapo BWANA aliingia katika agano na Israeli; pia unajulikana kama Mlima Horebu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Maunten Sainai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela maunten wantaim ples drai i raunim em long haptok Sainai long Isip we Bikpela i bin mekim kontrak wantaim ol Israel; narapela nem bilong en em Maunten Horep."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبل سيناء",
      "descriptions": [
        {
          "source": "acai",
          "description": "جبل والصحراء المحيطة بيه في شبه جزيرة سيناء في مصر، قطع فيه الرب عهد مع إسرائيل؛ وكمان معروف بجبل حوريب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hil ya Sinae",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hil mo draeples we i raonem hem long Penensula blong Sinae long Ijip we Hae God i mekem wan kavenan wetem Isrel; we oli save nem blong hem tu olsem Hil blong Horeb."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ugwu Saịnaị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ugwu na ọzara gbara ya gburugburu dị na Mmụwanye Ala Saịnaị nʼIjipt ebe YHWH na Izrel gbara ọgbụgba ndụ; nke a makwaara dị ka Ugwu Horeb."
        }
      ]
    },
    "nep": {
      "preferred_label": "सीनै पर्वत",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिश्रको सीनै प्रायद्वीपमा अवस्थित एउटा पर्वत र त्यस वरपरको मरुभूमि जहाँ परमप्रभुले इस्राएलसँग करार बाँध्नुभएको थियो; जसलाई होरेब पर्वत भनेर पनि चिनिन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "гора Синай",
      "descriptions": [
        {
          "source": "acai",
          "description": "Гора и окружающая её пустыня на Синайском полуострове в Египте, где Господь заключил завет с Израилем; также известна как гора Хорив."
        }
      ]
    },
    "vie": {
      "preferred_label": "Núi Si-nai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ngọn núi và vùng hoang mạc xung quanh trên Bán đảo Si-nai ở Ai Cập, nơi Đức Giê-hô-va đã lập giao ước với Y-sơ-ra-ên; còn được gọi là Núi Hô-rếp."
        }
      ]
    },
    "zht": {
      "preferred_label": "西奈山",
      "descriptions": [
        {
          "source": "acai",
          "description": "埃及西奈半島上的一座山及周圍的沙漠，耶和華在此與以色列人立約；亦稱何烈山。"
        }
      ]
    }
  },
