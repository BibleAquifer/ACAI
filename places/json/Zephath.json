        }
      ]
    },
    "apd": {
      "preferred_label": "صَفَاةْ",
      "descriptions": [
        {
          "source": "acai",
          "description": "حِلّة في كنعان استولوا عليها ودمروها يهوذا وشمعون؛ واتسمت بعد داك حُرْمَة."
        }
      ]
    },
    "arb": {
      "preferred_label": "صَفَاةَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في كنعان استولى عليها يهوذا وشمعون ودمراها، وسُميت حُرمَة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jefat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Kenan we Juda mo Simeon tufala i tekem mo spolem; biaen oli putum nem blong hem se Homa."
        }
      ]
    },
    "fra": {
      "preferred_label": "Tsephath",
