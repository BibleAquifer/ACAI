      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Chebar",
          "gloss": "Kebar",
          "description": "A river in Babylonia where Ezekiel received one of his visions while in exile (Ezekiel 1:1)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Kebar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un fleuve de Babylonie près duquel Ézéchiel reçut l'une de ses visions pendant l'exil (Ézéchiel 1:1)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Quebar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Río de Babilonia donde Ezequiel recibió una de sus visiones mientras estaba en el exilio (Ezequiel 1:1)."
        }
      ]
    },
    "arb": {
      "preferred_label": "خابور",
      "descriptions": [
        {
          "source": "acai",
          "description": "نَهْرٌ في بابِلَ رَأى عِنْدَهُ حَزْقِيالُ إِحْدى رُؤاهُ وهُوَ في السَّبْيِ (حزقيال 1: 1)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "迦巴鲁",
      "descriptions": [
        {
          "source": "acai",
          "description": "巴比伦的一条河；以西结被掳期间在此得见异象（以西结书 1:1）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kebar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kogi ne a ƙasar Babila inda Ezekiel ya sami ɗaya daga cikin wahayoyinsa sa’ad da yake zaman bauta (Ezekiel 1:1)."
        }
      ]
    },
    "hin": {
      "preferred_label": "कबार",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाबेलोनिया की एक नदी जहाँ यहेजकेल ने निर्वासन के दौरान अपने दर्शनों में से एक दर्शन पाया था (यहेजकेल 1:1)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kebar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah sungai di Babilonia tempat Yehezkiel menerima salah satu penglihatannya saat berada di pembuangan (Yehezkiel 1:1)."
        }
      ]
    },
    "por": {
      "preferred_label": "Quebar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um rio na Babilônia onde Ezequiel recebeu uma de suas visões enquanto estava no exílio (Ezequiel 1:1)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ховар",
      "descriptions": [
        {
          "source": "acai",
          "description": "Река в Вавилонии, у которой Иезекииль получил одно из своих видений во время изгнания (Иез. 1:1)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kebari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mto huko Babeli ambapo Ezekieli alipokea mojawapo ya maono yake akiwa uhamishoni (Ezekieli 1:1)."
        }
      ]
    },
    "apd": {
      "preferred_label": "خابور",
      "descriptions": [
        {
          "source": "acai",
          "description": "نهر في بابل حزقيال شاف فيهو واحدة من رؤاهو وهو في السبي (حزقيال 1: 1)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kebara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan reva long Babilonia we Esikel i luk wan vison long hem taem hem i stap wok slef (Esikel 1:1)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Keba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Osimiri dị na Babilọn ebe Izikiel nwetara otu n'ime ọhụ ya mgbe ọ nọ n'ala ọzọ (Izikiel 1:1)."
        }
      ]
    },
    "nep": {
      "preferred_label": "कबार",
      "descriptions": [
        {
          "source": "acai",
          "description": "बेबिलोनियाको एक नदी जहाँ इजकिएलले निर्वासनमा हुँदा आफ्ना दर्शनहरूमध्ये एउटा दर्शन पाएका थिए (इजकिएल १:१)।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kebar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela wara long Babilon we Esekiel i bin lukim wanpela bilong ol visen bilong en taim em i stap kalabus (Esekiel 1:1)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kê-ba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con sông ở Ba-by-lôn nơi Ê-xê-chi-ên nhận được một trong các khải tượng của ông khi đang sống lưu đày (Ê-xê-chi-ên 1:1)."
        }
      ]
    },
    "zht": {
      "preferred_label": "迦巴魯河",
      "descriptions": [
        {
          "source": "acai",
          "description": "巴比倫尼亞的一條河，以西結在被擄期間曾在此處見到他的一個異象（以西結書 1:1）。"
        }
      ]
    }
  },
