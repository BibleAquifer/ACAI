  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Most Holy Place (of the Temple)",
      "alternate_labels": [
        "Most Holy Place",
        "Holiest of All",
        "Most Holy Sanctuary",
        "Most Holy",
        "Holiest",
        "Holy of Holies"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:MostHolyPlace.2",
          "gloss": "Most Holy Place (of the Temple)",
          "description": "The innermost room at the back of the main temple building; location of the ark of the covenant; regarded as the holiest place."
        }
      ]
    },
    "arb": {
      "preferred_label": "قدس الأقداس (في الهيكل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الحجرة الداخلية في مؤخرة مبنى الهيكل الرئيسي؛ موضع تابوت العهد؛ واعتُبرت أقدس مكان."
        }
      ]
    },
    "zhs": {
      "preferred_label": "至圣所 (圣殿)",
      "descriptions": [
        {
          "source": "acai",
          "description": "圣殿主体建筑最深处的内室；约柜安放之处；被视为最圣洁之所。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Wuri Mafi Tsarki (na haikali)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗakin can ciki a ƙuryar babban ginin haikali; wurin da akwatin alkawari yake; wanda ake ɗauka a matsayin wuri mafi tsarki."
        }
      ]
    },
    "hin": {
      "preferred_label": "परमपवित्र स्थान (मन्दिर का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मुख्य मन्दिर भवन के पिछले भाग का सबसे भीतरी कमरा; वाचा के सन्दूक का स्थान; सबसे पवित्र स्थान माना जाता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Tempat Maha Kudus (Bait Suci)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ruang paling dalam di bagian belakang bangunan utama Bait Suci; tempat tabut perjanjian berada; dianggap sebagai tempat yang paling kudus."
        }
      ]
    },
    "por": {
      "preferred_label": "Lugar Santíssimo (do Templo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O compartimento mais interior nos fundos do edifício principal do templo; local da arca da aliança; considerado o lugar mais sagrado."
        }
      ]
    },
    "rus": {
      "preferred_label": "Святое Святых (в храме)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Самое внутреннее помещение в глубине главного здания храма; местонахождение ковчега завета; считалось святейшим местом."
        }
      ]
    },
    "spa": {
      "preferred_label": "Lugar Santísimo (del templo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "La habitación más interior en la parte posterior del edificio principal del templo; lugar del arca del pacto; considerada el lugar más sagrado."
        }
      ]
    },
    "swh": {
      "preferred_label": "Patakatifu pa Patakatifu (pa Hekalu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chumba cha ndani kabisa upande wa nyuma wa jengo kuu la hekalu; mahali lilipokuwa sanduku la agano; palichukuliwa kuwa mahali patakatifu zaidi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rum Tambu Tru (bilong haus bilong Bikpela)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rum insait tru long baksait bilong bikpela haus bilong God; ples bilong bokis kontrak; ol i tingim dispela olsem ples i holi tru."
        }
      ]
    },
    "apd": {
      "preferred_label": "قدس الأقداس (حق بيت الله)",
      "descriptions": [
        {
          "source": "acai",
          "description": "الأوضة الجوانية خالص في قعر مبنى بيت الله الرئيسي، المحل الكان فيه تابوت العهد، وكانت أقدس محل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rum we i Tabu we i Tabu (blong Tempol)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rum ya we i stap insaed olgeta long biaen long mein haos blong tempol; ples we bokis blong kontrak i stap long hem; oli luk hem se hem i ples we i tabu olgeta."
        }
      ]
    },
    "fra": {
      "preferred_label": "lieu très saint (du temple)",
      "descriptions": [
        {
          "source": "acai",
          "description": "La pièce la plus intérieure à l'arrière du bâtiment principal du temple ; emplacement de l'arche de l'alliance ; considérée comme le lieu le plus saint."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebe Kachasị Nsọ (nke ụlọnsọ ukwu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ime ụlọ nke dị nʼazụ ụlọnsọ ukwu ahụ; ebe igbe ọgbụgba ndụ dị; e lere ya anya dị ka ebe kachasị nsọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "महा-पवित्रस्थान (मन्दिरको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मुख्य मन्दिर भवनको पछाडिपट्टिको सबैभन्दा भित्री कोठा; करारको सन्दुक राखिएको ठाउँ; सबैभन्दा पवित्र स्थान मानिएको।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Nơi Chí Thánh (của Đền Thờ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Căn phòng trong cùng ở phía sau tòa nhà đền thờ chính; nơi đặt hòm giao ước; được coi là nơi thánh nhất."
        }
      ]
    },
    "zht": {
      "preferred_label": "至聖所（聖殿）",
      "descriptions": [
        {
          "source": "acai",
          "description": "聖殿主體建築後方最裡層的房間；約櫃放置之處；被視為最神聖的地方。"
        }
      ]
    }
  },
