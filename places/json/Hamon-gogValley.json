  "localizations": {
    "eng": {
      "preferred_label": "Valley of Hamon-gog",
      "alternate_labels": [
        "Valley of the Travelers",
        "Hamon-gog",
        "Hordes of Gog Valley",
        "Travelers’ Valley",
        "The valley of Hamon-gog",
        "Valley of Gog’s Hordes"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:ValleyOfHamon-gog",
          "gloss": "Valley of Hamon-gog",
          "description": "A valley where the armies of Gog will be buried, according to a prophecy of Ezekiel (Ezekiel 39:11)."
        }
      ]
    },
    "fra": {
      "preferred_label": "vallée de Hamon-Gog",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une vallée où les armées de Gog seront enterrées, selon une prophétie d'Ézéchiel (Ézéchiel 39:11)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Valle de Hamón Gog",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un valle donde serán sepultados los ejércitos de Gog, según una profecía de Ezequiel (Ezequiel 39:11)."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَادِي جُمْهُورِ جُوجٍ",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَادٍ يُدْفَنُ فِيهِ جَيْشُ جُوجٍ، بِحَسَبِ نُبُوءَةِ حَزْقِيَالَ (حَزْقِيَال 39: 11)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈们‧歌革谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "根据以西结的预言（以西结书 39:11），埋葬歌革军队的一处山谷。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwarin Haman Gog",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kwari inda za a binne sojojin Gog, bisa ga annabcin Ezekiel (Ezekiyel 39:11)."
        }
      ]
    },
    "ind": {
      "preferred_label": "Lembah Khalayak Ramai Gog",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah lembah tempat pasukan Gog akan dikuburkan, menurut nubuat Yehezkiel (Yehezkiel 39:11)."
        }
      ]
    },
    "por": {
      "preferred_label": "Vale de Hamom-Gogue",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um vale onde o exército de Gogue será sepultado, segundo uma profecia de Ezequiel (Ezequiel 39:11)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bonde la Hamon-Gogu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bonde ambapo majeshi ya Gogu yatazikwa, kulingana na unabii wa Ezekieli (Ezekieli 39:11)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples Daun Bilong Ol Ami Bilong Gok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples daun we ol bai planim ol ami bilong Gok, olsem profesi bilong Esekiel i tok (Esekiel 39:11)."
        }
      ]
    },
    "apd": {
      "preferred_label": "وادي جمهور جوج",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادي ح يدفنوا فيه جيوش جوج، بحسب نبوة حزقيال (حزقيال ٣٩: ١١)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Krik blong Hamongogo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan krik we bambae oli berem ol ami blong Gogo long hem, folem profet tok blong Esikiel (Esikiel 39:11)."
        }
      ]
    },
    "hin": {
      "preferred_label": "गोग की भीड़ की तराई",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहेजकेल की एक भविष्यवाणी (यहेजकेल 39:11) के अनुसार एक तराई जहाँ गोग की सेनाओं को दफनाया जाएगा।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndagwurugwu Hamọn Gọg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndagwurugwu ebe a ga-eli usuu ndị agha Gọg, dị ka amụma Izikiel siri dị (Izikiel 39:11)."
        }
      ]
    },
    "nep": {
      "preferred_label": "हामोन-गोगको बेसी",
      "descriptions": [
        {
          "source": "acai",
          "description": "इजकिएलको अगमवाणी (इजकिएल ३९:११) अनुसार गोगका सेनाहरूलाई गाडिने एउटा बेसी।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Долина полчища Гогова",
      "descriptions": [
        {
          "source": "acai",
          "description": "Долина, где будут похоронены полчища Гога, согласно пророчеству Иезекииля (Иезекииль 39:11)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thung Lũng Ha-môn Gót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thung lũng nơi các đạo quân của Gót sẽ được chôn cất, theo lời tiên tri của Ê-xê-chi-ên (Ê-xê-chi-ên 39:11)."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈們‧歌革谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "根據以西結的預言（以西結書 39:11），歌革的軍隊將被埋葬的一處山谷。"
        }
      ]
    }
  },
