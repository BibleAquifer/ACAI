      "descriptions": [
        {
          "source": "acai",
          "article": "place:Bethlehem.1",
          "gloss": "Bethlehem (of Judah)",
          "description": "A town in the territory of Judah, southwest of Jerusalem, where Jesus was born; ancestral town of King David."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَيْتُ لَحْمٍ (يَهُوذَا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بَلْدَةٌ فِي أَرْضِ يَهُوذَا، جَنُوبَ غَرْبِيِّ أُورُشَلِيمَ، وُلِدَ فِيهَا يَسُوعُ، وَهِيَ مَسْقَطُ رَأْسِ ٱلْمَلِكِ دَاوُدَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "伯利恒（犹大）",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大境内的一座城镇，位于耶路撒冷西南，耶稣降生于此；也是大卫王的故乡。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Bethléhem (de Juda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville située sur le territoire de Juda, au sud-ouest de Jérusalem, où Jésus est né ; ville ancestrale du roi David."
        }
      ]
    },
    "hau": {
      "preferred_label": "Betlehem (na Yahuda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a yankin Yahuda, a kudu maso yammacin Urushalima, inda aka haifi Yesu; garin kakannin Sarki Dawuda."
        }
      ]
    },
    "hin": {
      "preferred_label": "बैतलहम (यहूदा का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेम के दक्षिण-पश्चिम में यहूदा के क्षेत्र का एक नगर, जहाँ यीशु का जन्म हुआ था; राजा दाऊद का पैतृक नगर।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Betlehem (Yehuda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di wilayah Yehuda, barat daya Yerusalem, tempat Yesus dilahirkan; kota asal Raja Daud."
        }
      ]
    },
    "por": {
      "preferred_label": "Belém (de Judá)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade no território de Judá, a sudoeste de Jerusalém, onde Jesus nasceu; cidade ancestral do rei Davi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Вифлеем (Иудейский)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в уделе Иуды, к юго-западу от Иерусалима, где родился Иисус; родной город царя Давида."
        }
      ]
    },
    "spa": {
      "preferred_label": "Belén (de Judá)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo en el territorio de Judá, al suroeste de Jerusalén, donde nació Jesús; pueblo ancestral del rey David."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bethlehemu (ya Yuda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji katika eneo la Yuda, kusini-magharibi mwa Yerusalemu, ambapo Yesu alizaliwa; mji wa asili wa Mfalme Daudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Betlehem (bilong Juda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long graun bilong Juda, long sauthwes bilong Jerusalem, em ples Jisas i bin bon long en; em taun bilong ol tumbuna bilong King Devit."
        }
      ]
    },
    "apd": {
      "preferred_label": "بيت لحم (تبع يهوذا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في أرض يهوذا، جنوب غرب أورشليم، اتولد فيها عيسى؛ وهي بلدة الملك داود الأصلية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Betlehem (blong Juda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long teritri blong Juda, long saotwes blong Jerusalem, we Jisas i bon long hem; taon blong ol laen blong King Deved."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Betlehem (nke Juda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nʼókèala Juda, nʼakụkụ ndịda ọdịda anyanwụ nke Jerusalem, ebe a mụrụ Jisọs; obodo nna nna Eze Devid."
        }
      ]
    },
    "nep": {
      "preferred_label": "बेथलेहेम (यहूदाको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेमको दक्षिण-पश्चिममा यहूदाको इलाकामा पर्ने एउटा सहर, जहाँ येशूको जन्म भएको थियो; राजा दाऊदको पुर्ख्यौली सहर।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Bết-lê-hem (Giu-đa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn thuộc lãnh thổ Giu-đa, phía tây nam Giê-ru-sa-lem, nơi Chúa Giê-xu giáng sinh; quê hương tổ phụ của Vua Đa-vít."
        }
      ]
    },
    "zht": {
      "preferred_label": "伯利恆（猶大）",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大境內、耶路撒冷西南方的一座城鎮，耶穌在此誕生；也是大衛王的祖籍故鄉。"
        }
      ]
    }
  },
