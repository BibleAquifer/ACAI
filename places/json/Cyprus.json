      "descriptions": [
        {
          "source": "acai",
          "article": "place:Cyprus",
          "gloss": "Cyprus",
          "description": "An island off the south coast of Asia Minor; Paul and Barnabas ministered here during Paul's first missionary journey (Acts 13:4–12)."
        }
      ]
    },
    "arb": {
      "preferred_label": "قبرص",
      "descriptions": [
        {
          "source": "acai",
          "description": "جزيرة قبالة الساحل الجنوبي لآسيا الصغرى؛ خدم فيها بولس وبرنابا خلال رحلة بولس التبشيرية الأولى (أعمال 13: 4–12)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "塞浦路斯",
      "descriptions": [
        {
          "source": "acai",
          "description": "小亚细亚南部沿海的一座岛屿；保罗和巴拿巴在保罗第一次传教旅程中曾在此事奉（使徒行传13:4-12）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Saifurus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani tsibiri a gabar tekun Asiya Ƙarama ta kudu; Bulus da Barnaba sun yi hidima a nan a lokacin balaguron wa’azi na fari na Bulus (Ayyukan Manzanni 13:4–12)."
        }
      ]
    },
    "hin": {
      "preferred_label": "साइप्रस",
      "descriptions": [
        {
          "source": "acai",
          "description": "एशिया माइनर के दक्षिणी तट से दूर एक द्वीप; पौलुस और बरनबास ने पौलुस की पहली प्रचार-यात्रा के दौरान यहाँ सेवा की (प्रेरितों 13:4–12)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Siprus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah pulau di lepas pantai selatan Asia Kecil; Paulus dan Barnabas melayani di sini selama perjalanan misi pertama Paulus (Kisah Para Rasul 13:4–12)."
        }
      ]
    },
    "por": {
      "preferred_label": "Chipre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma ilha perto da costa sul da Ásia Menor; Paulo e Barnabé ministraram aqui durante a primeira viagem missionária de Paulo (Atos 13:4–12)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Кипр",
      "descriptions": [
        {
          "source": "acai",
          "description": "Остров у южного побережья Малой Азии; Павел и Варнава несли здесь служение во время первого миссионерского путешествия Павла (Деяния 13:4–12)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Chipre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Isla frente a la costa sur de Asia Menor; Pablo y Bernabé ministraron allí durante el primer viaje misionero de Pablo (Hechos 13:4–12)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kipro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kisiwa karibu na pwani ya kusini ya Asia Ndogo; Paulo na Barnaba walifanya huduma hapa wakati wa safari ya kwanza ya kimisionari ya Paulo (Matendo 13:4–12)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Saiprus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ailan i stap ausait long saut nambis bilong Esia Maina; Pol na Barnabas i bin autim gutnius long dispela ples long namba wan raun bilong Pol bilong mekim misin wok (Aposel 13:4–12)."
        }
      ]
    },
    "apd": {
      "preferred_label": "قبرص",
      "descriptions": [
        {
          "source": "acai",
          "description": "جزيرة قبالة الساحل الجنوبي لآسيا الصغرى؛ خدم فيها بولس وبرنابا أثناء رحلة بولس التبشيرية الأولى (أعمال 13: 4–12)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Saepras",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan aelan long saot kous blong Esia Maena; Pol mo Banabas tufala i mekem wok blong God long ples ya long faswan misinari trip blong Pol (Ol Wok 13:4–12)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Chypre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une île au large de la côte sud de l'Asie Mineure ; Paul et Barnabas y ont exercé leur ministère durant le premier voyage missionnaire de Paul (Actes 13:4-12)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Saiprọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Àgwèetiti dị nʼụsọ oké osimiri ndịda nke Eshia Maịnọ; Pọl na Banabas jewara ozi nʼebe a nʼoge njem ozi ala ọzọ nke mbụ nke Pọl (Ọrụ Ndị Ozi 13:4–12)."
        }
      ]
    },
    "nep": {
      "preferred_label": "साइप्रस",
      "descriptions": [
        {
          "source": "acai",
          "description": "एसिया माइनरको दक्षिणी तट नजिकैको एउटा टापु; पावलको पहिलो मिसनरी यात्राको क्रममा पावल र बर्णाबासले यहाँ सेवा गरेका थिए (प्रेरित १३:४–१२)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Síp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một hòn đảo ngoài khơi bờ biển phía nam Tiểu Á; Phao-lô và Ba-na-ba đã thi hành chức vụ tại đây trong chuyến hành trình truyền giáo thứ nhất của Phao-lô (Công Vụ 13:4–12)."
        }
      ]
    },
    "zht": {
      "preferred_label": "塞浦路斯",
      "descriptions": [
        {
          "source": "acai",
          "description": "小亞細亞南岸外海的一座島嶼；保羅和巴拿巴在保羅第一次宣教旅程中曾在此傳道（使徒行傳13:4–12）。"
        }
      ]
    }
  },
