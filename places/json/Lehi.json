      "descriptions": [
        {
          "source": "acai",
          "article": "place:Lehi",
          "gloss": "Lehi",
          "description": "A location near Judah's border with Philistia where Samson killed many Philistines with a donkey jawbone."
        }
      ]
    },
    "arb": {
      "preferred_label": "لَحْي",
      "descriptions": [
        {
          "source": "acai",
          "description": "موقع بالقرب من حدود يهوذا مع بلاد الفلسطينيين حيث قتل شمشون عدداً كبيراً من الفلسطينيين بفك حمار."
        }
      ]
    },
    "zhs": {
      "preferred_label": "利希",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大与非利士交界附近的一处地点，参孙曾在此用驴腮骨击杀了许多非利士人。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Léchi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un lieu situé près de la frontière de Juda avec la Philistie, où Samson tua de nombreux Philistins avec une mâchoire d'âne."
        }
      ]
    },
    "hau": {
      "preferred_label": "Lehi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani wuri kusa da iyakar Yahuda da Filistiya inda Samson ya kashe Filistiyawa da yawa da kashin muƙamuƙin jaki."
        }
      ]
    },
    "hin": {
      "preferred_label": "लही",
      "descriptions": [
        {
          "source": "acai",
          "description": "पलिश्तियों के साथ यहूदा की सीमा के निकट एक स्थान जहाँ शिमशोन ने गदहे के जबड़े की हड्डी से अनेक पलिश्तियों को मार डाला था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Lehi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah lokasi dekat perbatasan Yehuda dengan Filistia tempat Simson membunuh banyak orang Filistin dengan tulang rahang keledai."
        }
      ]
    },
    "por": {
      "preferred_label": "Leí",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um local próximo à fronteira de Judá com a Filístia onde Sansão matou muitos filisteus com uma queixada de jumento."
        }
      ]
    },
    "rus": {
      "preferred_label": "Лехи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Местность у границы Иудеи с Филистией, где Самсон убил множество филистимлян ослиной челюстью."
        }
      ]
    },
    "spa": {
      "preferred_label": "Lehi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lugar cerca de la frontera de Judá con Filistea donde Sansón mató a muchos filisteos con la quijada de un asno."
        }
      ]
    },
    "swh": {
      "preferred_label": "Lehi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahali karibu na mpaka wa Yuda na Ufilisti ambapo Samsoni aliua Wafilisti wengi kwa mfupa wa taya ya punda."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lehi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hap klostu long mak bilong Juda wantaim Filistia em Samson i bin kilim planti Filistia long bun bilong wasket bilong donki."
        }
      ]
    },
    "apd": {
      "preferred_label": "لحي",
      "descriptions": [
        {
          "source": "acai",
          "description": "موقع قريب من حدود يهوذا مع فلسطين حيث شمشون قتل فلسطينيين كتار بفك حمار."
        }
      ]
    },
    "bis": {
      "preferred_label": "Lehi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ples klosap long boda blong Juda wetem Filistia we Samson i kilim plante man Filistia wetem wan bun blong jo blong dongki."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Lehi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ebe dị nso nʼókè Juda na Filistia ebe Samsin ji ọkpụkpụ agba ịnyịnya ibu gbuo ọtụtụ ndị Filistia."
        }
      ]
    },
    "nep": {
      "preferred_label": "लही",
      "descriptions": [
        {
          "source": "acai",
          "description": "पलिश्तीहरूसँगको यहूदाको सिमाना नजिकैको एउटा स्थान जहाँ शिमशोनले गधाको बङ्गराले धेरै पलिश्तीहरूलाई मारेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Lê-hi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một địa điểm gần biên giới Giu-đa với Phi-li-tin, nơi Sam-sôn đã giết nhiều người Phi-li-tin bằng một cái hàm lừa."
        }
      ]
    },
    "zht": {
      "preferred_label": "利希",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大與非利士交界附近的一個地方，參孫曾在此用驢腮骨擊殺了許多非利士人。"
        }
      ]
    }
