          "source": "acai",
          "article": "place:Mizpah.1",
          "gloss": "Mizpah (of Gilead)",
          "description": "A town in Gilead where Jacob and Laban built a monument after their reconciliation; residence of Jephthah."
        }
      ]
    },
    "apd": {
      "preferred_label": "المصفاة (في جلعاد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في جلعاد بنوا فيها يعقوب ولابان نصب بعد ما اتصالحوا؛ ومكان سكن يفتاح."
        }
      ]
    },
    "arb": {
      "preferred_label": "المصفاة (جلعاد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في جلعاد أقام فيها يعقوب ولابان رجمة بعد صلحهما؛ ومقر سكنى يفتاح."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mispa (blong Gilead)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Gilead we Jekob mo Laban tufala i bin bildimap wan ston olsem mak blong promes afta we tufala i mekem pis bakegen; ples we Jefta i bin stap long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "Mitspa (de Galaad)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville de Galaad où Jacob et Laban dressèrent un monument après leur réconciliation ; résidence de Jephthé."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mizfa (na Gileyad)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a Gileyad inda Yaƙub da Laban suka gina abin tunawa bayan sulharsu; wurin zama na Yefta."
        }
      ]
    },
    "hin": {
      "preferred_label": "मिस्पा (गिलाद का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "गिलाद का एक नगर जहाँ याकूब और लाबान ने मेल-मिलाप के बाद एक स्मारक बनाया था; यिप्तह का निवास स्थान।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mizpa (nke Gilead)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na Gilead ebe Jekọb na Leban wuru ihe ncheta mgbe ha mechara udo; ebe obibi Jefta."
        }
      ]
    },
    "ind": {
      "preferred_label": "Mizpa (di Gilead)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di Gilead tempat Yakub dan Laban mendirikan tugu setelah perdamaian mereka; tempat tinggal Yefta."
        }
      ]
    },
    "nep": {
      "preferred_label": "मिस्पा (गिलादको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "गिलादको एउटा सहर जहाँ याकूब र लाबानले आपसमा मिलाप गरेपछि एउटा स्मारक बनाएका थिए; यिप्‍ताको वासस्थान।"
        }
      ]
    },
    "por": {
      "preferred_label": "Mispá (de Gileade)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade em Gileade onde Jacó e Labão ergueram um monumento após a sua reconciliação; residência de Jefté."
        }
      ]
    },
    "rus": {
      "preferred_label": "Массифа (в Галааде)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в Галааде, где Иаков и Лаван воздвигли памятник после своего примирения; место жительства Иеффая."
        }
      ]
    },
    "spa": {
      "preferred_label": "Mizpa (de Galaad)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un pueblo en Galaad donde Jacob y Labán construyeron un monumento después de su reconciliación; residencia de Jefté."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mispa (wa Gileadi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji katika Gileadi ambapo Yakobo na Labani walijenga mnara baada ya kupatana; makao ya Yefta."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mispa (bilong Gileat)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Gileat we Jekop na Laban i bin sanapim wanpela mak bilong strongim promis bihain long tupela i stretim tok; na em ples bilong Jepta."
        }
      ]
    },
    "vie": {
      "preferred_label": "Mích-pa (thuộc Ga-la-át)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn ở Ga-la-át nơi Gia-cốp và La-ban dựng bia đá sau khi hòa giải; nơi cư trú của Giếp-thê."
        }
      ]
    },
    "zhs": {
      "preferred_label": "米斯巴（基列）",
      "descriptions": [
        {
          "source": "acai",
          "description": "基列的一座城镇，雅各和拉班在此和解后立石堆为记；耶弗他的居住地。"
        }
      ]
    },
    "zht": {
      "preferred_label": "米斯巴（基列）",
      "descriptions": [
        {
          "source": "acai",
          "description": "基列境內的一座城鎮，雅各與拉班和好後在此立石為記；也是耶弗他的居所。"
        }
      ]
    }
