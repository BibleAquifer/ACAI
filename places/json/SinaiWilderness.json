  "localizations": {
    "eng": {
      "preferred_label": "Wilderness of Sinai",
      "alternate_labels": [
        "Desert of Sinai",
        "Sinai",
        "Sinai desert",
        "Sinai Wilderness"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:WildernessOfSinai",
          "gloss": "Wilderness of Sinai",
          "description": "A desert region in the Sinai Peninsula, near Mount Sinai, through which the Israelites traveled during the exodus."
        }
      ]
    },
    "fra": {
      "preferred_label": "désert de Sinaï",
      "descriptions": [
        {
          "source": "acai",
          "description": "Région désertique de la péninsule du Sinaï, près du mont Sinaï, à travers laquelle les Israélites ont voyagé pendant l’Exode."
        }
      ]
    },
    "spa": {
      "preferred_label": "desierto de Sinaí",
      "descriptions": [
        {
          "source": "acai",
          "description": "Región desértica en la península del Sinaí, cerca del monte Sinaí, por la que viajaron los israelitas durante el éxodo."
        }
      ]
    },
    "arb": {
      "preferred_label": "برِّيّةُ سيناءَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "منطقة صحراوية في شبه جزيرة سيناء، بالقرب من جبل سيناء، ارتحل عبرها بنو إسرائيل أثناء الخروج."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西奈的旷野",
      "descriptions": [
        {
          "source": "acai",
          "description": "西奈半岛上靠近西奈山的一片旷野地区，以色列人在出埃及时曾穿行于此。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hamadar Sinai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani yankin hamada a Tsibirin Sinai, kusa da Dutsen Sinai, inda Isra’ilawa suka bi a lokacin fitowarsu daga Masar."
        }
      ]
    },
    "ind": {
      "preferred_label": "Padang Gurun Sinai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah wilayah padang gurun di Semenanjung Sinai, dekat Gunung Sinai, yang dilalui orang Israel selama masa keluaran."
        }
      ]
    },
    "por": {
      "preferred_label": "Deserto do Sinai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma região desértica na península do Sinai, perto do monte Sinai, pela qual os israelitas viajaram durante o êxodo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Синайская пустыня",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пустынная область на Синайском полуострове около горы Синай, по которой израильтяне странствовали во время исхода."
        }
      ]
    },
    "swh": {
      "preferred_label": "Jangwa la Sinai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eneo la jangwa katika Rasi ya Sinai, karibu na Mlima Sinai, ambapo Waisraeli walipita wakati wa kutoka Misri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples drai bilong Sainai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hap graun i no gat man (ples drai) long haptok Sainai, klostu long Maunten Sainai, we ol Israel i bin wokabaut long taim bilong eksodas."
        }
      ]
    },
    "apd": {
      "preferred_label": "برية سيناء",
      "descriptions": [
        {
          "source": "acai",
          "description": "منطقة صحراوية في شبه جزيرة سيناء، قريبة من جبل سيناء، مروا بيها بنو إسرائيل في وقت الخروج."
        }
      ]
    },
    "bis": {
      "preferred_label": "Draeples ya Sinae",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan eria blong draeples long Penensula blong Sinae, klosap long hil ya Sinae, we ol man Isrel oli bin pas tru long hem long taem we oli aot long Ijip."
        }
      ]
    },
    "hin": {
      "preferred_label": "सीनै का जंगल",
      "descriptions": [
        {
          "source": "acai",
          "description": "सीनै प्रायद्वीप में सीनै पर्वत के निकट का एक मरुस्थलीय क्षेत्र, जिससे होकर इस्राएलियों ने मिस्र से प्रस्थान के दौरान यात्रा की थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọzara Saịnaị",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpaghara ọzara dị na Mmụwanye Ala Saịnaị, nso Ugwu Saịnaị, nke ụmụ Izrel gafere nʼoge ọpụpụ ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "सीनैको उजाड-स्थान",
      "descriptions": [
        {
          "source": "acai",
          "description": "सीनै प्रायद्वीपमा, सीनै पर्वत नजिकैको एउटा मरुभूमि क्षेत्र, जहाँबाट इस्राएलीहरूले प्रस्थानको समयमा यात्रा गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hoang mạc Si-nai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vùng hoang mạc trên Bán đảo Si-nai, gần Núi Si-nai, nơi người Y-sơ-ra-ên đi qua trong cuộc xuất hành."
        }
      ]
    },
    "zht": {
      "preferred_label": "西奈的曠野",
      "descriptions": [
        {
          "source": "acai",
          "description": "西奈半島上西奈山附近的一處沙漠地區，以色列人在出埃及期間曾途經此地。"
        }
      ]
    }
  },
