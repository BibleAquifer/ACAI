    "hin": {
      "preferred_label": "लुस्त्रा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एशिया माइनर के लुकाउनिया का एक नगर, जो दिरबे के उत्तर-पश्चिम में स्थित था; पौलुस की भेंट वहाँ तीमुथियुस से हुई थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Listra",
      "descriptions": [
        {
          "source": "acai",
