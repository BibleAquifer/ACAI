        }
      ]
    },
    "por": {
      "preferred_label": "Listra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade na Licaônia, na Ásia Menor, a noroeste de Derbe; Paulo conheceu Timóteo ali."
        }
      ]
    },
    "rus": {
      "preferred_label": "Листра",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в Ликаонии в Малой Азии, к северо-западу от Дервии; там Павел встретил Тимофея."
        }
      ]
    },
    "swh": {
      "preferred_label": "Listra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko Likaonia huko Asia Ndogo, kaskazini-magharibi mwa Derbe; Paulo alikutana na Timotheo huko."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Listra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Likonia insait long Esia Maina, long hap notwes bilong Derbe; Pol i bin bungim Timoti long dispela taun."
        }
      ]
    },
    "apd": {
      "preferred_label": "لسترة",
