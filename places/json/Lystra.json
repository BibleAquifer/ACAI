        }
      ]
    },
    "bis": {
      "preferred_label": "Listra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Likaonia long Esia Maena, notwes long Debe; Pol i mitim Timoti long ples ya."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Listra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na Laikonia nʼime Asia Minor, nʼebe ugwu ọdịda anyanwụ nke Debi; Pọl zutere Timoti nʼebe ahụ."
        }
      ]
    },
    "nep": {
