        {
          "source": "acai",
          "article": "place:HorseGate",
          "gloss": "Horse Gate",
          "description": "A gate in Jerusalem, near the palace, where Queen Athaliah was killed (2 Chronicles23:15)."
        }
      ]
    },
    "arb": {
      "preferred_label": "باب الخيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "باب في أورشليم بالقرب من القصر، حيث قُتلت الملكة عثليا (أخبار الأيام الثاني 23: 15)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "马门",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷靠近王宫的一座城门，亚他利雅王后在此被杀（历代志下 23:15）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "porte des chevaux",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une porte de Jérusalem, près du palais, où la reine Athalie fut mise à mort (2 Chroniques 23.15)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙofar Doki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙofa a Urushalima kusa da fada, inda aka kashe Sarauniya Ataliya (2 Labarbaru 23:15)."
        }
      ]
    },
    "ind": {
      "preferred_label": "Pintu Gerbang Kuda",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah pintu gerbang di Yerusalem, dekat istana, tempat Ratu Atalya dibunuh (2 Tawarikh 23:15)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Конские ворота",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ворота в Иерусалиме возле царского дворца, где была убита царица Гофолия (2 Паралипоменон 23:15)."
        }
      ]
    },
    "spa": {
      "preferred_label": "puerta de los Caballos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Puerta de Jerusalén, cerca del palacio, donde la reina Atalía fue asesinada (2 Crónicas 23:15)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Lango la Farasi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lango katika Yerusalemu, karibu na jumba la mfalme, ambapo Malkia Athalia aliuawa (2 Mambo ya Nyakati 23:15)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Dua Bilong Ol Hos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela dua bilong banis long Jerusalem, klostu long haus king, em ol i bin kilim Kwin Atalia long en (2 Stori 23:15)."
        }
      ]
    },
    "apd": {
      "preferred_label": "باب الخيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "باب في أورشليم، قريب من القصر، وين ما قتلو الملكة عثليا (أخبار الأيام التاني 23: 15)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Doa blong Hos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan doa long Jerusalem, klosap long palis, we oli kilim Kwin Atalaea i ded long hem (2 Kronikel 23:15)."
        }
      ]
    },
    "hin": {
      "preferred_label": "घोड़ाफाटक",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेम में राजभवन के पास का एक फाटक, जहाँ रानी अतल्याह को मार डाला गया था (2 इतिहास 23:15)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọnụ Ụzọ Ama Ịnyịnya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọnụ ụzọ ama dị na Jerusalem, nso nʼobí eze, ebe e gburu Eze Nwanyị Atalaya (2 Ihe E Mere 23:15)."
        }
      ]
    },
    "nep": {
      "preferred_label": "घोडा ढोका",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेममा दरबारको नजिकै रहेको एउटा ढोका, जहाँ रानी अतल्याह मारिएकी थिइन् (२ इतिहास २३:१५)।"
        }
      ]
    },
    "por": {
      "preferred_label": "Porta dos Cavalos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma porta em Jerusalém, perto do palácio, onde a rainha Atalia foi morta (2 Crônicas 23:15)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cửa Ngựa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cổng ở Giê-ru-sa-lem, gần hoàng cung, nơi Hoàng thái hậu A-tha-li-a bị giết (2 Sử Ký 23:15)."
        }
      ]
    },
    "zht": {
      "preferred_label": "馬門",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷王宮附近的一座城門，亞他利雅王后在此被殺（歷代志下 23:15）。"
        }
      ]
    }
  },
