      "descriptions": [
        {
          "source": "acai",
          "article": "place:ValleyOfTravelers",
          "gloss": "Valley of the Travelers",
          "description": "A valley where the armies of Gog will be buried, according to a prophecy of Ezekiel (Ezekiel 39:11)."
        }
      ]
    },
    "fra": {
      "preferred_label": "vallée des voyageurs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une vallée où les armées de Gog seront enterrées, selon une prophétie d'Ézéchiel (Ézéchiel 39.11)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Valle de los Viajeros",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un valle donde los ejércitos de Gog serán sepultados, según una profecía de Ezequiel (Ezequiel 39:11)."
        }
      ]
    },
    "arb": {
      "preferred_label": "وادي العابرين",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادٍ ستُدفن فيه جيوش جوج، بحسب نبوة حزقيال (حزقيال 39: 11)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "旅客谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "根据以西结的一则预言（以西结书39:11），歌革军队将被埋葬的一处山谷。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwarin Matafiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kwari inda za a binne sojojin Gog, bisa ga annabcin Ezekiel (Ezekiel 39:11)."
        }
      ]
    },
    "ind": {
      "preferred_label": "Lembah Penyeberangan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah lembah tempat tentara Gog akan dikuburkan, menurut nubuat Yehezkiel (Yehezkiel 39:11)."
        }
      ]
    },
    "por": {
      "preferred_label": "Vale dos Viajantes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um vale onde os exércitos de Gogue serão sepultados, de acordo com uma profecia de Ezequiel (Ezequiel 39:11)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bonde la Wasafiri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bonde ambalo majeshi ya Gogu yatazikwa, kulingana na unabii wa Ezekieli (Ezekieli 39:11)."
        }
      ]
    },
    "apd": {
      "preferred_label": "وادي العابرين",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادي حيدفنوا فيه جيوش جوج، حسب نبوة حزقيال (حزقيال ٣٩: ١١)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Krik blong Ol Man blong Wokbaot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan vali we bambae oli berem ol ami blong Gog long hem, folem profesi blong Esikel (Esikel 39:11)."
        }
      ]
    },
    "hin": {
      "preferred_label": "आने जानेवालों की तराई",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक तराई जहाँ यहेजकेल की भविष्यवाणी के अनुसार गोग की सेनाओं को दफनाया जाएगा (यहेजकेल 39:11)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndagwurugwu Ndị Ije",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndagwurugwu ebe a ga-eli usuu ndị agha Gọg, dị ka amụma Izikiel si dị (Izikiel 39:11)."
        }
      ]
    },
    "nep": {
      "preferred_label": "यात्रीहरूको बेँसी",
      "descriptions": [
        {
          "source": "acai",
          "description": "इजकिएलको अगमवाणी (इजकिएल ३९:११) अनुसार गोगका सेनाहरूलाई गाडिने एउटा बेँसी।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Долина прохожих",
      "descriptions": [
        {
          "source": "acai",
          "description": "Долина, где, согласно пророчеству Иезекииля (Иез. 39:11), будут похоронены полчища Гога."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples Daun Bilong Ol Pasindia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples daun we ol ami bilong Gok bai planim ol, olsem wanpela profesi bilong Esekiel i tok (Esekiel 39:11)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thung Lũng Du Khách",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thung lũng nơi các đạo quân của Gót sẽ được chôn cất, theo lời tiên tri của Ê-xê-chi-ên (Ê-xê-chi-ên 39:11)."
        }
      ]
    },
    "zht": {
      "preferred_label": "人所經過的谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "照以西結的預言，歌革的軍隊將要埋葬的山谷（以西結書 39:11）。"
        }
      ]
    }
  },
