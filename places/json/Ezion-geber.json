          "article": "place:Ezion-geber",
          "gloss": "Ezion-Geber",
          "description": "A seaport town on the Gulf of Aqaba, near Elath, where the Israelites camped on their journey from Egypt to Canaan."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以旬·迦别",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚喀巴湾的一座港口城镇，靠近以拉他，以色列人从埃及前往迦南途中曾在此安营。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Étsjon-Guéber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville portuaire située sur le golfe d'Aqaba, près d'Élath, où les Israélites ont campé lors de leur voyage d'Égypte vers Canaan."
        }
      ]
    },
    "hau": {
      "preferred_label": "Eziyon Geber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Garin tashar jiragen ruwa a Tekun Akaba, kusa da Elat, inda Isra’ilawa suka yi sansani a tafiyarsu daga Masar zuwa Kan’ana."
        }
      ]
    },
    "hin": {
      "preferred_label": "एस्योनगेबेर",
      "descriptions": [
        {
          "source": "acai",
          "description": "अकाबा की खाड़ी पर एलत के निकट स्थित एक बंदरगाह नगर, जहाँ इस्राएलियों ने मिस्र से कनान की अपनी यात्रा के दौरान डेरा डाला था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ezion-Geber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota pelabuhan di Teluk Aqaba, dekat Elat, tempat orang Israel berkemah dalam perjalanan mereka dari Mesir ke Kanaan."
        }
      ]
    },
    "por": {
      "preferred_label": "Eziom-Geber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade portuária no golfo de Ácaba, perto de Elate, onde os israelitas acamparam em sua jornada do Egito para Canaã."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ezión-guéber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad portuaria en el golfo de Áqaba, cerca de Elat, donde acamparon los israelitas en su viaje de Egipto a Canaán."
        }
      ]
    },
    "swh": {
      "preferred_label": "Esion-geberi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa bandari kwenye Ghuba ya Akaba, karibu na Elathi, ambapo Waisraeli walipiga kambi katika safari yao kutoka Misri kwenda Kanaani."
        }
      ]
    },
    "apd": {
      "preferred_label": "عصيون جابر",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة ساحلية على خليج العقبة، قريبة من إيلات، خيّموا فيها بني إسرائيل في رحلتهم من مصر لكنعان."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِصْيُون جَابِر",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة وميناء بحري على خليج العقبة بالقرب من أيلة، حيث خيّم بنو إسرائيل في رحلتهم من مصر إلى كنعان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ejionkeba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hafples kuskus/poti taon klosap long Elat long Golf blong Akaba, we ol man Isrel oli bin kam mekem ten blong olgeta long taem we oli aot long Ijip i go long Kenan."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Eziọn Geba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo ọdụ ụgbọ mmiri dị n'Ọwara Mmiri Akaba, nso Elat, ebe ụmụ Izrel mara ụlọikwuu n'ije ha si n'Ijipt na-aga Kenan."
        }
      ]
    },
    "nep": {
      "preferred_label": "एस्योन-गेबेर",
      "descriptions": [
        {
          "source": "acai",
          "description": "अकाबाको खाडीमा एलातनजिकै रहेको एउटा बन्दरगाह सहर, जहाँ इस्राएलीहरू मिश्रबाट कनानतर्फको यात्रामा छाउनी हालेका थिए।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Ецион-Гавер",
      "descriptions": [
        {
          "source": "acai",
          "description": "Портовый город в заливе Акаба, близ Елафа, где израильтяне останавливались станом во время странствования из Египта в Ханаан."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Esiongeber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun i gat pasis bilong sip long Galf bilong Akaba, klostu long Elat, we ol Isrel i bin slip na wokim kem long taim bilong raun bilong ol lusim Isip i go long Kanan."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-xi-ôn Ghê-be",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn cảng trên Vịnh Aqaba, gần Ê-lát, nơi dân Y-sơ-ra-ên đóng trại trong hành trình từ Ai Cập đến Ca-na-an."
        }
      ]
    },
    "zht": {
      "preferred_label": "以旬‧迦別",
      "descriptions": [
        {
          "source": "acai",
          "description": "阿卡巴灣沿岸、以拉他附近的一座海港城鎮，以色列人從埃及前往迦南途中曾在此安營。"
        }
      ]
    }
