  "localizations": {
    "eng": {
      "preferred_label": "Rome",
      "alternate_labels": [
        "Roman",
        "[ ]",
        "Romans",
        "Roman colony"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Rome",
          "gloss": "Rome",
          "description": "The capital city of the Roman Empire and an early center of Christianity. The letter to the Romans was addressed to the church there."
        }
      ]
    },
    "arb": {
      "preferred_label": "رُومِيَةَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "عاصمة الإمبراطورية الرومانية ومركز مبكر للمسيحية. كُتبت الرسالة إلى أهل رومية إلى الكنيسة هناك."
        }
      ]
    },
    "zhs": {
      "preferred_label": "罗马",
      "descriptions": [
        {
          "source": "acai",
          "description": "罗马帝国的首都，也是早期的基督教中心。《罗马书》即是写给那里的教会的。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Rome",
      "descriptions": [
        {
          "source": "acai",
          "description": "La capitale de l'Empire romain et un des premiers centres du christianisme. L'épître aux Romains était adressée à l'Église qui s'y trouvait."
        }
      ]
    },
    "hau": {
      "preferred_label": "Roma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban birnin Daular Roma kuma wata cibiyar Kiranci ta farko. An aike da wasiƙar zuwa ga Romawa ga ikilisiya da ke can."
        }
      ]
    },
    "hin": {
      "preferred_label": "रोम",
      "descriptions": [
        {
          "source": "acai",
          "description": "रोमी साम्राज्य की राजधानी और मसीहियत का एक प्रारंभिक केंद्र। रोमियों की पत्री वहाँ की कलीसिया को संबोधित की गई थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Roma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ibu kota Kekaisaran Romawi dan pusat awal kekristenan. Surat kepada jemaat di Roma ditujukan kepada gereja di sana."
        }
      ]
    },
    "por": {
      "preferred_label": "Roma",
      "descriptions": [
        {
          "source": "acai",
          "description": "A capital do Império Romano e um dos primeiros centros do cristianismo. A carta aos Romanos foi endereçada à igreja ali situada."
        }
      ]
    },
    "rus": {
      "preferred_label": "Рим",
      "descriptions": [
        {
          "source": "acai",
          "description": "Столица Римской империи и ранний центр христианства. Послание к Римлянам было адресовано местной церкви."
        }
      ]
    },
    "spa": {
      "preferred_label": "Roma",
      "descriptions": [
        {
          "source": "acai",
          "description": "La ciudad capital del Imperio romano y un centro temprano del cristianismo. La carta a los Romanos estaba dirigida a la iglesia de allí."
        }
      ]
    },
    "swh": {
      "preferred_label": "Rumi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji mkuu wa Dola ya Roma na kitovu cha mapema cha Ukristo. Waraka kwa Warumi uliandikiwa kanisa la huko."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Biktaun bilong Embaia bilong Rom na wanpela bikpela as ples bilong ol Kristen bilong bipo. Pas i go long ol Rom em i bin go long sios i stap long dispela taun."
        }
      ]
    },
    "apd": {
      "preferred_label": "روما",
      "descriptions": [
        {
          "source": "acai",
          "description": "العاصمة حقت الإمبراطورية الرومانية ومركز مبكر للمسيحية. الرسالة لأهل رومية كانت موجهة للكنيسة الفي هناك."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kapitol taon blong Rom Empaea mo wan erli senta blong Kristianiti. Leta we i go long ol man Rom i go long jos we i stap long ples ya."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Rom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Isi obodo nke Alaeze Ukwu Rom na ebe mbụ nke Iso Ụzọ Kraịst. E degaara nzukọ Kraịst dị nʼebe ahụ akwụkwọ ozi e degaara ndị Rom."
        }
      ]
    },
    "nep": {
      "preferred_label": "रोम",
      "descriptions": [
        {
          "source": "acai",
          "description": "रोमी साम्राज्यको राजधानी सहर र प्रारम्भिक इसाई धर्मको एक केन्द्र। रोमीहरूलाई लेखिएको पत्र त्यहाँको मण्डलीलाई सम्बोधन गरिएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "La Mã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thủ đô của Đế quốc La Mã và là một trung tâm ban đầu của Cơ Đốc giáo. Bức thư gửi cho người La Mã được gửi đến hội thánh tại nơi này."
        }
      ]
    },
    "zht": {
      "preferred_label": "羅馬",
      "descriptions": [
        {
          "source": "acai",
          "description": "羅馬帝國的首都，也是早期基督教的中心。《羅馬書》即是寫給當地的教會。"
        }
      ]
    }
  },
