          "description": "طريق يمر عبر عبر الأردن على طول حدود الصحراء، ويربط دمشق بخليج العقبة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "王道",
      "descriptions": [
        {
          "source": "acai",
          "description": "一条穿过约旦河东岸沿沙漠边界的道路，连接大马士革与阿卡巴湾。"
        }
      ]
    },
    "fra": {
      "preferred_label": "route royale",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une route traversant la Transjordanie le long de la frontière du désert, reliant Damas au golfe d'Aqaba."
        }
      ]
    },
    "hau": {
      "preferred_label": "Babbar Hanyar Sarki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hanya ce da ta bi ta hayin Urdun a gefen hamada, tana haɗa Damaskus da Mashigin Ruwa na Akaba."
        }
      ]
    },
    "ind": {
      "preferred_label": "Jalan Besar Raja",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah jalan yang melintasi Transyordan di sepanjang perbatasan padang gurun, menghubungkan Damaskus dengan Teluk Aqaba."
        }
      ]
    },
    "por": {
      "preferred_label": "Estrada Real",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma estrada que passava por Transjordânia ao longo da fronteira com o deserto, ligando Damasco ao golfo de Ácaba."
        }
      ]
    },
    "spa": {
      "preferred_label": "Camino Real",
      "descriptions": [
        {
          "source": "acai",
          "description": "Camino que atravesaba Transjordania a lo largo de la frontera del desierto, y que conectaba Damasco con el golfo de Áqaba."
        }
      ]
    },
    "swh": {
      "preferred_label": "Njia Kuu ya Mfalme",
      "descriptions": [
        {
          "source": "acai",
          "description": "Barabara inayopita ng'ambo ya Yordani kando ya mpaka wa jangwa, ikiunganisha Dameski na Ghuba ya Akaba."
        }
      ]
    },
    "apd": {
      "preferred_label": "درب الملك",
      "descriptions": [
        {
          "source": "acai",
          "description": "درب بيمر عبر شرق الأردن على طول حدود الصحرا، وبيربط دمشق بخليج العقبة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bigrod",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan rod we i stap goraon long Transjordan klosap long desot, we i joenem Damaskes wetem Galf blong Akaba."
        }
      ]
    },
    "hin": {
      "preferred_label": "राजमार्ग",
      "descriptions": [
        {
          "source": "acai",
          "description": "रेगिस्तान की सीमा के साथ-साथ ट्रांसजॉर्डन से होकर जाने वाला एक मार्ग, जो दमिश्क को अकाबा की खाड़ी से जोड़ता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Okporoụzọ Eze",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụzọ na-agafe Transjọdan nʼakụkụ oke ọzara ahụ, na-ejikọ Damaskọs na Ọwara Mmiri Akaba."
        }
      ]
    },
    "nep": {
      "preferred_label": "शाही राजमार्ग",
      "descriptions": [
        {
          "source": "acai",
          "description": "मरुभूमिको सिमाना हुँदै ट्रान्सजोर्डन भएर जाने एउटा सडक, जसले दमस्कसलाई अकाबाको खाडीसँग जोड्थ्यो।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Царская дорога",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дорога, проходившая через Заиорданье вдоль границы пустыни и соединявшая Дамаск с заливом Акаба."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Bikrot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela rot i go brukim Transjodan klostu long arere bilong ples drai nating, na i bungim Damaskus wantaim Golp bilong Akaba."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đường Cái của Vua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con đường đi qua vùng Ngoại Giô-đanh dọc theo ranh giới sa mạc, nối Damascus với Vịnh Aqaba."
        }
      ]
    },
    "zht": {
      "preferred_label": "王道",
      "descriptions": [
        {
          "source": "acai",
          "description": "一條穿過約旦河東岸、沿著沙漠邊界延伸的道路，連接大馬士革與阿卡巴灣。"
        }
      ]
    }
