      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Hazazon-tamar.1",
          "gloss": "Hazazon-Tamar",
          "description": "An oasis in the wilderness of the territory of Judah, on the western shore of the Dead Sea; also known as En-Gedi."
        }
      ]
    },
    "fra": {
      "preferred_label": "Hatsatson-Thamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une oasis dans le désert du territoire de Juda, sur la rive occidentale de la mer Morte ; aussi connue sous le nom d'En-Guédi."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hazezón-tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un oasis en el desierto del territorio de Judá, en la orilla occidental del mar Muerto; también conocido como En-gadi."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hazazon Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata korama a cikin hamadar yankin Yahuda, a bakin Tekun Gishiri ta yamma; wadda kuma aka sani da En Gedi."
        }
      ]
    },
    "hin": {
      "preferred_label": "हसासोन्तामार",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा के क्षेत्र के जंगल में, मृत सागर के पश्चिमी तट पर एक मरुद्यान; जिसे एनगदी भी कहा जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hazezon-Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah oase di padang gurun wilayah Yehuda, di pantai barat Laut Asin; juga dikenal sebagai En-Gedi."
        }
      ]
    },
    "por": {
      "preferred_label": "Hazazom-Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um oásis no deserto do território de Judá, na margem ocidental do Mar Morto; também conhecido como En-Gedi."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hasason-Tamari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oasisi katika nyika ya eneo la Yuda, kwenye pwani ya magharibi ya Bahari ya Chumvi; pia panajulikana kama Engedi."
        }
      ]
    },
    "apd": {
      "preferred_label": "حصون تامار",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحة في برية أراضي يهوذا، على الشاطئ الغربي للبحر الميت؛ معروفة كمان باسم عين جدي."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَصُّون تَامَارَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحة في برية أرض يهوذا على الشاطئ الغربي للبحر الميت؛ وتُعرف أيضًا باسم عين جدي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hajajontama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ples we i gat wota mo tri long draeples long graon blong Juda, long wes saed blong Solwota we i Ded; we narafala nem blong hem Enkedi."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hazezọn Tama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oasis dị nʼọzara nke ókèala Juda, nʼụsọ ọdịda anyanwụ nke Osimiri Nwụrụ Anwụ; nke a makwaara dị ka En-Gedi."
        }
      ]
    },
    "nep": {
      "preferred_label": "हासेसोन-तामार",
      "descriptions": [
        {
          "source": "acai",
          "description": "मृत सागरको पश्चिमी किनारमा, यहूदाको इलाकाको मरुभूमिमा रहेको एउटा मरूद्यान; एन-गदी भनेर पनि चिनिन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Хацацон-Фамар",
      "descriptions": [
        {
          "source": "acai",
          "description": "Оазис в пустыне на территории Иуды, на западном берегу Мертвого моря; также известный как Ен-Геди."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hasason Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela oesis long ples drai nating bilong graun bilong Juda, long nambis bilong Detsi long hap wes; ol i kolim tu olsem Engedi."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-xa-xôn Tha-ma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ốc đảo trong hoang mạc thuộc lãnh thổ Giu-đa, trên bờ phía tây của Biển Chết; còn được gọi là Ên-ghê-đi."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈洗逊·他玛",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大领地旷野中的一处绿洲，位于死海西岸；又名隐·基底。"
        }
      ]
    },
    "zht": {
      "preferred_label": "哈洗遜‧他瑪",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大地曠野中的綠洲，位於死海西岸；也稱為隱‧基底。"
        }
      ]
    }
  },
