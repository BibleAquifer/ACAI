          "description": "यरदन की तराई में, एप्रैम के क्षेत्र का एक नगर; इसे सरेदा और सरेरा के नाम से भी जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Sartan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di Lembah Yordan, di wilayah Efraim; dikenal juga sebagai Zereda dan Zerera."
        }
      ]
    },
    "por": {
      "preferred_label": "Zaretã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade no vale do Jordão, no território de Efraim; também conhecida como Zereda e Zererá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Цартан",
      "descriptions": [
        {
