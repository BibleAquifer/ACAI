      "descriptions": [
        {
          "source": "acai",
          "article": "place:Teman",
          "gloss": "Teman",
          "description": "The territory of the most prominent tribe of Edom (ABD); sometimes used to refer to the entire territory of Edom."
        }
      ]
    },
    "arb": {
      "preferred_label": "تِيمَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "أرض القبيلة الأبرز في أدوم؛ وتُستخدم أحيانًا للإشارة إلى كامل أرض أدوم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "提幔",
      "descriptions": [
        {
          "source": "acai",
          "description": "以东最显赫支派的领地；有时用来指整个以东领地。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Théman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le territoire de la tribu la plus importante d'Édom ; parfois utilisé pour désigner l'ensemble du territoire d'Édom."
        }
      ]
    },
    "hau": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yankin kabilar Edom mafi shahara; a wasu lokuta ana amfani da shi don nuni ga dukan yankin Edom."
        }
      ]
    },
    "hin": {
      "preferred_label": "तेमान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एदोम के सबसे प्रमुख गोत्र का क्षेत्र; कभी-कभी इसका उपयोग एदोम के पूरे क्षेत्र के लिए भी किया जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wilayah suku Edom yang paling terkemuka; terkadang digunakan untuk merujuk pada seluruh wilayah Edom."
        }
      ]
    },
    "por": {
      "preferred_label": "Temã",
      "descriptions": [
        {
          "source": "acai",
          "description": "O território da tribo mais proeminente de Edom; às vezes usado para se referir a todo o território de Edom."
        }
      ]
    },
    "rus": {
      "preferred_label": "Феман",
      "descriptions": [
        {
          "source": "acai",
          "description": "Территория самого видного племени Едома; иногда используется для обозначения всей территории Едома."
        }
      ]
    },
    "spa": {
      "preferred_label": "Temán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Territorio de la tribu más prominente de Edom; a veces utilizado para referirse a todo el territorio de Edom."
        }
      ]
    },
    "swh": {
      "preferred_label": "Temani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eneo la kabila maarufu zaidi la Edomu; wakati mwingine hutumika kurejelea eneo lote la Edomu."
        }
      ]
    },
    "apd": {
      "preferred_label": "تيمان",
      "descriptions": [
        {
          "source": "acai",
          "description": "أرض أبرز قبائل أدوم؛ وكانت تستخدم أحياناً للإشارة لكل أرض أدوم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Teritori blong stamba laen blong Edom; samtaem oli yusum nem ya blong minim ful teritori blong Edom."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ókèala nke ebo kacha bụrụ onyeisi nʼEdọm; mgbe ụfọdụ a na-eji ya eme ihe na-ezo aka nʼókèala Edọm dum."
        }
      ]
    },
    "nep": {
      "preferred_label": "तेमान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एदोमको सबैभन्दा प्रमुख कुलको इलाका; कहिलेकाहीँ एदोमको सम्पूर्ण इलाकालाई जनाउन प्रयोग गरिन्छ।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Graun bilong nambawan bikpela lain bilong Idom; sampela taim ol i save yusim dispela nem bilong makim olgeta hap graun bilong Idom."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thê-man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lãnh thổ của bộ tộc nổi bật nhất xứ Ê-đôm (ABD); đôi khi được dùng để chỉ toàn bộ lãnh thổ Ê-đôm."
        }
      ]
    },
    "zht": {
      "preferred_label": "提幔",
      "descriptions": [
        {
          "source": "acai",
          "description": "以東最顯著支派的領地（ABD）；有時用來指整個以東領地。"
        }
      ]
    }
  },
