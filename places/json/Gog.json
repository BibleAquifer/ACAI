        }
      ]
    },
    "bis": {
      "preferred_label": "Gog",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan nem we i haed blong makem wan enemi we Mesaea bambae i winim hem (Revelesen 20:8)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Gog",
