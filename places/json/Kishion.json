          "source": "acai",
          "article": "place:Kishion",
          "gloss": "Kishion",
          "description": "A Levitical town in the territory of Issachar, assigned to the clan of Gershon; possibly to be identified with Kedesh."
        }
      ]
    },
    "arb": {
      "preferred_label": "قِشْيُونُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "بَلْدَةٌ لَاوِيَّةٌ فِي أَرْضِ يَسَّاكَرَ، خُصِّصَتْ لِعَشِيرَةِ جَرْشُونَ؛ وَيُحْتَمَلُ أَنَّهَا قَادَشُ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "基善",
      "descriptions": [
        {
          "source": "acai",
          "description": "位于以萨迦境内的利未人城镇，分给革顺家族；可能即基低斯。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Kischjon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville lévitique dans le territoire d'Issacar, attribuée au clan de Guerschon ; peut-être à identifier avec Kédesch."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kishiyon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani garin Lawiyawa a yankin Issakar, wanda aka ba wa dangin Gershon; mai yiwuwa shi ne Kedesh."
        }
      ]
    },
    "hin": {
      "preferred_label": "किश्योन",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्साकार के क्षेत्र में एक लेवीय नगर, जो गेर्शोन के कुल को सौंपा गया था; संभवतः इसकी पहचान केदेश से की जाती है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kisyon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota orang Lewi di wilayah Isakhar, yang diberikan kepada kaum Gerson; kemungkinan diidentifikasikan dengan Kedesh."
        }
      ]
    },
    "por": {
      "preferred_label": "Quisiom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade levítica no território de Issacar, designada ao clã de Gérson; possivelmente identificada com Quedes."
        }
      ]
    },
    "rus": {
      "preferred_label": "Кишион",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитский город в уделе Иссахара, выделенный роду Гирсона; возможно, отождествляется с Кедесом."
        }
      ]
    },
    "spa": {
      "preferred_label": "Quisón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad levítica en el territorio de Isacar, asignada al clan de Gersón; posiblemente se identifica con Cedes."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kishioni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa Walawi katika eneo la Isakari, uliotengewa ukoo wa Gershoni; yawezekana ndio Kedeshi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kision",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun bilong ol Livai long graun bilong Isakar, em ol i bin givim long famili bilong Gerson; ating em wankain taun olsem Kedes."
        }
      ]
    },
    "apd": {
      "preferred_label": "قشيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في أرض يساكر اتخصصت لعشيرة جرشون؛ ويمكن تكون هي قادش."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kision",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon blong ol Livae long teritori blong Isakar, we oli givim long laen blong Gerson; ating hem i sem mak olsem Kedes."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kishiọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo ndị Livaị dị n'ókèala Isaka, nke e kenyere ezinụlọ Gershọn; ma eleghị anya a na-amata ya dị ka Kedesh."
        }
      ]
    },
    "nep": {
      "preferred_label": "किश्योन",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्साखारको इलाकामा पर्ने एउटा लेवी सहर, जो गेर्शोनको कुललाई दिइएको थियो; सम्भवतः केदेशको रूपमा चिनिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ki-si-ôn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn của người Lê-vi trong lãnh thổ Y-sa-ca, được chỉ định cho thị tộc Ghẹt-sôn; có thể cùng một địa điểm với Kê-đe."
        }
      ]
    },
    "zht": {
      "preferred_label": "基善",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於以薩迦地業境內的一座利未城鎮，分給革順家族；可能等同於基低斯。"
        }
      ]
    }
