      "descriptions": [
        {
          "source": "acai",
          "article": "place:ValleyOfHinnom",
          "gloss": "Valley of Hinnom",
          "description": "A valley west and south of Jerusalem; known for the idol worship that took place there."
        }
      ]
    },
    "apd": {
      "preferred_label": "وادي هنوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادي غرب وجنوب أورشليم؛ معروف بعبادة الأصنام اللي كانت بتحصل هناك."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَادِي هِنُّومَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادٍ غرب وجنوب أورشليم؛ عُرِف بعبادة الأوثان التي كانت تُمارَس فيه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Krik ya Hinom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan krik o vali long wes mo saot blong Jerusalem; i gat nem from we ol man oli mekem wosip long ol giaman god long ples ya."
        }
      ]
    },
    "fra": {
      "preferred_label": "vallée de Hinnom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une vallée à l'ouest et au sud de Jérusalem ; connue pour le culte des idoles qui y était pratiqué."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwarin Hinnom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kwari a yamma da kudancin Urushalima; sananne saboda bautar gumaka da aka yi a wurin."
        }
      ]
    },
    "hin": {
      "preferred_label": "हिन्नोम की तराई",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेम के पश्चिम और दक्षिण में स्थित एक तराई; वहाँ होने वाली मूर्तिपूजा के लिए जानी जाती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndagwurugwu Hinom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndagwurugwu dị nʼebe ọdịda anyanwụ na ndịda Jeruselem; nke a ma ama maka ikpere arụsị mere nʼebe ahụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "Lembah Hinom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah lembah di sebelah barat dan selatan Yerusalem; dikenal karena penyembahan berhala yang dilakukan di sana."
        }
      ]
    },
    "nep": {
      "preferred_label": "हिन्‍नोमको बेँसी",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेमको पश्चिम र दक्षिणतिरको एउटा बेँसी; त्यहाँ हुने गरेको मूर्तिपूजाका लागि चिनिने।"
        }
      ]
    },
    "por": {
      "preferred_label": "Vale de Hinom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um vale a oeste e ao sul de Jerusalém; conhecido pelo culto a ídolos que ali ocorria."
        }
      ]
    },
    "rus": {
      "preferred_label": "долина Еннома",
      "descriptions": [
        {
          "source": "acai",
          "description": "Долина к западу и югу от Иерусалима; известна происходившим там идолослужением."
        }
      ]
    },
    "spa": {
      "preferred_label": "valle de Hinom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un valle al oeste y sur de Jerusalén; conocido por el culto a los ídolos que se practicaba allí."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bonde la Hinomu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bonde lililoko magharibi na kusini mwa Yerusalemu; linalojulikana kwa ibada ya sanamu iliyofanyika huko."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples Daun bilong Hinom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples daun long hap wes na saut bilong Jerusalem; em i biknem long pasin bilong lotuim ol giaman god i bin kamap long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thung lũng Hi-nôm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thung lũng ở phía tây và nam Giê-ru-sa-lem; nổi tiếng vì việc thờ lạy thần tượng từng diễn ra ở đó."
        }
      ]
    },
    "zhs": {
      "preferred_label": "欣嫩谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷以西和以南的一座山谷；以发生在那里的偶像崇拜而闻名。"
        }
      ]
    },
    "zht": {
      "preferred_label": "欣嫩谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於耶路撒冷西邊和南邊的一個山谷；因曾在那裡進行偶像崇拜而聞名。"
        }
      ]
    }
  },
