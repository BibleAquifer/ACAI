        }
      ]
    },
    "nep": {
      "preferred_label": "नासरत",
      "descriptions": [
        {
          "source": "acai",
          "description": "दक्षिण-मध्य गालीलको एक सहर, जहाँ येशू बालक छँदा बस्नुभएको थियो (मत्ती २:२३)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Na-xa-rét",
