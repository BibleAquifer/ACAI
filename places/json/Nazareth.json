        {
          "source": "acai",
          "description": "Một thị trấn ở nam miền trung Ga-li-lê, nơi Chúa Giê-xu đã sống thời thơ ấu (Ma-thi-ơ 2:23)."
        }
      ]
    },
    "zht": {
      "preferred_label": "拿撒勒",
