      "descriptions": [
        {
          "source": "acai",
          "article": "place:Elam",
          "gloss": "Elam",
          "description": "A nation located between Mesopotamia and Persia; regarded as founded by a person with the same name."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِيلَام",
      "descriptions": [
        {
          "source": "acai",
          "description": "أُمّة تقع بين بلاد ما بين النهرين وبلاد فارس؛ وتُعتبر مؤسسة على يد شخص يحمل الاسم نفسه."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以拦",
      "descriptions": [
        {
          "source": "acai",
          "description": "位于美索不达米亚和波斯之间的一个国家；被认为是由同名人物所建。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Élam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une nation située entre la Mésopotamie et la Perse ; considérée comme fondée par un personnage du même nom."
        }
      ]
    },
    "hau": {
      "preferred_label": "Elam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙasa da ke tsakanin Mesofotamiya da Farisa; ana ɗauka wani mutum mai suna iri ɗaya ne ya kafa ta."
        }
      ]
    },
    "hin": {
      "preferred_label": "एलाम",
      "descriptions": [
        {
          "source": "acai",
          "description": "मेसोपोटामिया और फारस के बीच स्थित एक राष्ट्र; माना जाता है कि इसकी स्थापना इसी नाम के एक व्यक्ति द्वारा की गई थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Elam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suatu bangsa yang terletak di antara Mesopotamia dan Persia; dianggap didirikan oleh seseorang dengan nama yang sama."
        }
      ]
    },
    "por": {
      "preferred_label": "Elão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma nação localizada entre a Mesopotâmia e a Pérsia; considerada como fundada por uma pessoa com o mesmo nome."
        }
      ]
    },
    "rus": {
      "preferred_label": "Елам",
      "descriptions": [
        {
          "source": "acai",
          "description": "Страна, расположенная между Месопотамией и Персией; считается основанной человеком с тем же именем."
        }
      ]
    },
    "spa": {
      "preferred_label": "Elam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nación ubicada entre Mesopotamia y Persia; considerada fundada por una persona con el mismo nombre."
        }
      ]
    },
    "swh": {
      "preferred_label": "Elamu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taifa lililokuwa kati ya Mesopotamia na Uajemi; lilionwa kuwa lilinzishwa na mtu mwenye jina hilohilo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Elam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kantri i stap namel long Mesopotemia na Pesia; ol i ting wanpela man i gat dispela wankain nem i bin kirapim dispela kantri."
        }
      ]
    },
    "apd": {
      "preferred_label": "عيلام",
      "descriptions": [
        {
          "source": "acai",
          "description": "أمة كانت واقعة بين بلاد الرافدين وفارس، وتعتبر أنها اتأسست على يد راجل بي نفس الاسم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Elam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kantri we i stap long medel blong Mesopotemia mo Pesia; oli ting se wan man we i gat sem nem ya nao i statem kantri ya."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Elam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mba dị nʼetiti Mesopotamịa na Peshịa; a na-ewere ya dị ka onye nwere otu aha ahụ hiwere ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "एलाम",
      "descriptions": [
        {
          "source": "acai",
          "description": "मेसोपोटामिया र फारसको बीचमा अवस्थित एक राष्ट्र; सोही नामको व्यक्तिद्वारा स्थापित भएको मानिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-lam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một quốc gia nằm giữa Lưỡng Hà và Ba Tư; được xem là do một người cùng tên thành lập."
        }
      ]
    },
    "zht": {
      "preferred_label": "以攔",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於美索不達米亞和波斯之間的國家；被認為是由同名人物所建。"
        }
      ]
    }
