      "descriptions": [
        {
          "source": "acai",
          "article": "place:MountHermon",
          "gloss": "Mount Hermon",
          "description": "A mountain in the Anti-Lebanon range, northeast of Israel; also known as Senir, Sion, and Sirion."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَبَلُ حَرْمُونَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "جبل في سلسلة جبال لبنان الشرقية، شمال شرق إسرائيل؛ يُعرف أيضاً باسم سنير وسيون وسيريُون."
        }
      ]
    },
    "zhs": {
      "preferred_label": "黑门山",
      "descriptions": [
        {
          "source": "acai",
          "description": "黑门山是前黎巴嫩山脉的一座山峰，位于以色列东北部；亦称示尼珥、西云和西连。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Dutsen Hermon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dutse a jerin duwatsun Anti-Lebanon, a arewa maso gabashin Isra’ila; wanda kuma aka sani da Senir, Siyon, da Siriyon."
        }
      ]
    },
    "hin": {
      "preferred_label": "हेर्मोन पर्वत",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएल के उत्तर-पूर्व में अ Build-लबानोन (एंटी-लेबनान) पर्वतमाला में एक पर्वत; जिसे सनीर, सियोन और शिर्योन के नाम से भी जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gunung Hermon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah gunung di pegunungan Anti-Lebanon, di sebelah timur laut Israel; juga dikenal sebagai Senir, Sion, dan Sirion."
        }
      ]
    },
    "por": {
      "preferred_label": "Monte Hermom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma montanha na cordilheira do Antilíbano, a nordeste de Israel; também conhecida como Senir, Siom e Sirion."
        }
      ]
    },
    "spa": {
      "preferred_label": "monte Hermón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una montaña en la cordillera del Antilíbano, al noreste de Israel; también conocida como Senir, Sion y Sirión."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mlima Hermoni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mlima katika safu ya milima ya Lebanoni-kinyume (Anti-Lebanoni), kaskazini-mashariki mwa Israeli; pia unajulikana kama Seniri, Sioni, na Sirioni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Maunten Hermon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela maunten long Anti-Lebanon maunten lain, long hap not-is bilong Israel; ol i kolim tu olsem Senir, Sion, na Sirion."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبل حرمون",
      "descriptions": [
        {
          "source": "acai",
          "description": "جبل في سلسلة جبال لبنان الشرقية، شمال شرق إسرائيل؛ ومعروف كمان باسم سنير، وسيون، وسريون."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hil Hemon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hil long Anti-Lebanon we i stap long not-is long Isrel; oli singaotem tu se Senir, Sion, mo Sirion."
        }
      ]
    },
    "fra": {
      "preferred_label": "mont Hermon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une montagne de la chaîne de l'Anti-Liban, au nord-est d'Israël ; également connue sous les noms de Senir, Sion et Sirion."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ugwu Hemon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ugwu dị na mkpọda Anti-Lebanọn, nʼebe ugwu ọwụwa anyanwụ Izrel; nke a makwaara dị ka Senia, Saịọn, na Sirion."
        }
      ]
    },
    "nep": {
      "preferred_label": "हेर्मोन पर्वत",
      "descriptions": [
        {
          "source": "acai",
          "description": "एन्टि-लेबनान हिमशृङ्खलामा रहेको, इस्राएलको उत्तर-पूर्वमा अवस्थित एउटा पर्वत; सेनीर, सियोन र सिर्योनको नामले पनि चिनिन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "гора Ермон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Гора в хребте Антиливан к северо-востоку от Израиля; также известна как Сенир, Сион и Сирион."
        }
      ]
    },
    "vie": {
      "preferred_label": "Núi Hẹt-môn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ngọn núi thuộc dãy Chống Li-ban, ở phía đông bắc Y-sơ-ra-ên; còn được gọi là Sê-nia, Si-ôn và Si-ri-ôn."
        }
      ]
    },
    "zht": {
      "preferred_label": "黑門山",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於黎巴嫩前山山脈的一座山，在以色列的東北方；又稱示尼珥、西雲和示連。"
        }
      ]
    }
  },
