        }
      ]
    },
    "spa": {
      "preferred_label": "Laquis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad fortificada en las colinas del territorio de Judá, donde Amasías, rey de Judá, fue asesinado."
        }
      ]
    },
    "arb": {
      "preferred_label": "لَخِيش",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة محصنة في سفوح تلال أرض يهوذا، حيث قُتل أَمَصْيا ملك يهوذا غيلة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拉吉",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大领地山地丘陵的一座坚固城镇，犹大王亚玛谢在此遇刺。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Lakish",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani garu mai katanga a tuddan yankin Yahuda, inda aka kashe Amaziya, sarkin Yahuda."
        }
      ]
    },
    "hin": {
      "preferred_label": "लाकीश",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा के क्षेत्र की तराई में स्थित एक गढ़वाला नगर, जहाँ यहूदा के राजा अमस्याह की हत्या कर दी गई थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Lakhis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota berkubu di kaki perbukitan di wilayah Yehuda, tempat Amazia, raja Yehuda, dibunuh."
        }
      ]
    },
    "por": {
      "preferred_label": "Laquis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade fortificada na Sefelá do território de Judá, onde Amazias, rei de Judá, foi assassinado."
        }
      ]
    },
    "rus": {
      "preferred_label": "Лахис",
      "descriptions": [
        {
          "source": "acai",
          "description": "Укрепленный город в предгорьях на территории Иудеи, где был убит Амасия, царь Иудейский."
        }
      ]
    },
    "swh": {
      "preferred_label": "Lakishi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wenye ngome katika nchi ya vilima ya eneo la Yuda, ambapo Amazia mfalme wa Yuda aliuawa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lakis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun i gat strongpela banis long ol liklik maunten bilong hap bilong Juda, em ples ol i bin kilim i dai Amasia, king bilong Juda."
        }
      ]
    },
    "apd": {
      "preferred_label": "لخيش",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة محصنة في سفوح تلال أراضي يهوذا، اتقتل فيها أمصيا ملك يهوذا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Lakis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon we i gat strong stonwol long ol hil blong teritori blong Juda, we oli kilim King Amasia blong Juda i ded long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Lakish",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo e wusiri ike nʼugwu nta dị iche iche nke ókèala Juda, ebe e gburu Amazaya, bụ́ eze Juda."
        }
      ]
    },
    "nep": {
      "preferred_label": "लाकीश",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदाको इलाकाको पहाडी फेदीमा रहेको एक किल्लाबन्दी गरिएको सहर, जहाँ यहूदाका राजा अमस्याहको हत्या गरिएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "La-ki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn kiên cố ở vùng đồi thuộc lãnh thổ Giu-đa, nơi A-ma-xia, vua Giu-đa, bị ám sát."
        }
      ]
    },
    "zht": {
      "preferred_label": "拉吉",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大境內山地丘陵的一座防禦城，猶大王亞瑪謝在此被暗殺。"
        }
      ]
    }
  },
