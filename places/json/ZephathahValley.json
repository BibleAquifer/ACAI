  "localizations": {
    "eng": {
      "preferred_label": "Valley of Zephathah",
      "alternate_labels": [
        "valley of Zepah",
        "Zephathah Valley"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:ValleyOfZephathah",
          "gloss": "Valley of Zephathah",
          "description": "A valley near Mareshah in the Shephelah where Asa fought with Zerah the Cushite (2 Chronicles 14:9)."
        }
      ]
    },
    "fra": {
      "preferred_label": "vallée de Tsephata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une vallée près de Maréscha dans la Schéphéla où Asa combattit Zérach l'Éthiopien (2 Chroniques 14.9)."
        }
      ]
    },
    "spa": {
      "preferred_label": "valle de Sefata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un valle cerca de Maresa en la Sefela donde Asa luchó contra Zera el cusita (2 Crónicas 14:9)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "洗法谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "示非拉靠近玛利沙的一座山谷，亚撒曾在此与古实人谢拉交战（历代志下 14:9）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwarin Zefata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kwari kusa da Maresha a Shefela inda Asa ya yi yaƙi da Zerah mutumin Kush (2 Labarbaru 14:9)."
        }
      ]
    },
    "ind": {
      "preferred_label": "Lembah Zefata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah lembah dekat Maresa di Sefela tempat Asa berperang melawan Zerah, orang Etiopia itu (2 Tawarikh 14:9)."
        }
      ]
    },
    "por": {
      "preferred_label": "Vale de Zefatá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um vale perto de Maressa na Sefelá onde Asa lutou contra Zerá, o cuxita (2 Crônicas 14:9)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bonde la Sefatha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bonde karibu na Maresha katika Shefela ambapo Asa alipigana na Zera Mkushi (2 Mambo ya Nyakati 14:9)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples Daun Sefata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples daun klostu long Maresa long Sefela em Asa i bin pait wantaim Sera, man bilong Kus, long en (2 Stori 14:9)."
        }
      ]
    },
    "apd": {
      "preferred_label": "وادي صَفَاتَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادي قريب من مَرِيشَة في السَّفِيلَة (التلال الغربية)، حارب فيهو آسا ضد زارَح الكوشي (أخبار الأيام التاني 14: 9)."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَادِي صَفَاتَةَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادٍ بالقرب من مريشة في السهل (شفيلة) حيث حارب آسا زارح الكوشي (أخبار الأيام الثاني 14: 9)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Vali blong Jefata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan vali klosap long Maresa long Sefela we Asa i faet wetem Sera man Itiopia (2 Kronikel 14:9)."
        }
      ]
    },
    "hin": {
      "preferred_label": "सापता की तराई",
      "descriptions": [
        {
          "source": "acai",
          "description": "मारेशा के निकट शेफेला में एक तराई जहाँ आसा ने कूशी जेरह के विरुद्ध युद्ध किया (2 इतिहास 14:9)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndagwurugwu Zefata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndagwurugwu dị nso na Maresha nʼime Shefela ebe Asa busoro Zera onye Kush agha (2 Ihe E Mere 14:9)."
        }
      ]
    },
    "nep": {
      "preferred_label": "सपताको बेँसी",
      "descriptions": [
        {
          "source": "acai",
          "description": "शेफेलाको मारेशानेरको एउटा बेँसी जहाँ आसाले कूशी जेरहसँग युद्ध लडेका थिए (२ इतिहास १४:९)।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Долина Цефата",
      "descriptions": [
        {
          "source": "acai",
          "description": "Долина близ Мареши в Шефеле, где Аса сражался с Зараем ефиоплянином (2 Паралипоменон 14:9)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thung lũng Xép-pha-ta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thung lũng gần Ma-rê-sa ở miền Sơ-phê-la nơi A-sa giao chiến với Xê-rách người Cút (2 Sử Ký 14:9)."
        }
      ]
    },
    "zht": {
      "preferred_label": "洗法谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "示非拉高原鄰近瑪利沙的一道山谷，亞撒在此與古實人謝拉交戰（歷代志下 14:9）。"
        }
      ]
    }
  },
