        }
      ]
    },
    "spa": {
      "preferred_label": "Estemoa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad levítica en la región montañosa del territorio de Judá, asignada al clan de Aarón; también conocida como Estemo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Eshtemoa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa Walawi katika nchi ya vilima katika eneo la Yuda, uliotengwa kwa ajili ya ukoo wa Aroni; pia unajulikana kama Eshtemoa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Estemoa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun bilong ol Livai i stap long ples maunten long teritori bilong Juda, ol i bin givim long famili bilong Aron; ol i kolim tu olsem Estemo."
        }
      ]
    },
    "apd": {
      "preferred_label": "أشتموع",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في جبال أرض يهوذا، خصصوها لعشيرة هارون؛ ومعروفة كمان باسم أشتَموه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Estemoa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon blong ol Livaet long ples blong hil long teritori blong Juda, we oli givim long famle blong Eron; we oli singaotem tu se Estemo."
        }
      ]
    },
    "hin": {
      "preferred_label": "एश्तमोआ",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा के प्रदेश के पहाड़ी देश में एक लेवियों का नगर, जो हारून के कुल को सौंपा गया था; इसे एश्तमो भी कहा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Eshtemoa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo ndị Livaị nʼobodo ugwu ugwu nke ókèala Juda, nke e nyere ndị ikwu Erọn; nke a makwaara dị ka Eshtemo."
        }
      ]
    },
    "nep": {
      "preferred_label": "एश्‍तमो",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदाको इलाकाको पहाडी देशमा रहेको एक लेवीहरूको सहर, जुन हारूनको कुललाई तोकिएको थियो; यसलाई एश्‍तमह पनि भनिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ết-tê-mô-a",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn của người Lê-vi ở miền núi thuộc lãnh thổ Giu-đa, được chỉ định cho dòng dõi A-rôn; còn được gọi là Ết-tê-mô."
        }
      ]
    },
    "zht": {
      "preferred_label": "以實提莫",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大地業山地的一座利未人城鎮，分給亞倫的家族；亦稱以實提摩。"
        }
      ]
    }
