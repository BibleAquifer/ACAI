      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Gozan",
          "gloss": "Gozan",
          "description": "A town along the Habor River in Assyria; one of the places where the exiles from Samaria were relocated."
        }
      ]
    },
    "fra": {
      "preferred_label": "Gozan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville située le long du fleuve Habor en Assyrie ; l'un des lieux où furent déportés les exilés de Samarie."
        }
      ]
    },
    "spa": {
      "preferred_label": "Gozán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Población junto al río Habor en Asiria; uno de los lugares donde fueron reasentados los exiliados de Samaria."
        }
      ]
    },
    "arb": {
      "preferred_label": "جوزان",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة على طول نهر خابور في أشور؛ إحدى الأماكن التي أُعيد توطين مسبيّي السامرة فيها."
        }
      ]
    },
    "zhs": {
      "preferred_label": "歌散",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚述境内哈博河沿岸的一座城镇；撒玛利亚被掳之人的安置地之一。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Gozan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a bakin Kogin Habor a Assuriya; ɗaya daga cikin wuraren da aka kwashe mutanen da aka kora daga Samariya aka kai su."
        }
      ]
    },
    "hin": {
      "preferred_label": "गोजान",
      "descriptions": [
        {
          "source": "acai",
          "description": "अश्शूर में हाबोर नदी के किनारे बसा एक नगर; उन स्थानों में से एक जहाँ सामरिया के निर्वासितों को बसाया गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gozan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di sepanjang Sungai Habor di Asyur; salah satu tempat orang-orang buangan dari Samaria ditempatkan kembali."
        }
      ]
    },
    "por": {
      "preferred_label": "Gozã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade ao longo do rio Habor, na Assíria; um dos lugares para onde os exilados de Samaria foram transferidos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гозан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город на реке Хавор в Ассирии; одно из мест, куда были переселены изгнанники из Самарии."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gozani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji kando ya Mto Habori huko Ashuru; mojawapo ya maeneo ambapo watu waliohamishwa kutoka Samaria walipelekwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gosan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun klostu long wara Habor long Asiria; wanpela bilong ol ples we ol i bin kisim ol kalabusman bilong Samaria i go putim ol long en."
        }
      ]
    },
    "apd": {
      "preferred_label": "جوزان",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة على نهر خابور في آشور؛ واحدة من المحلات الاتنقلوا ليها المسبيين من السامرة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gosan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon klosap long Haboro Reva long Asiria; wan long ol ples we oli bin muvum ol man Sameria we oli go wok slef i go long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gozan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nʼakụkụ Osimiri Habor nʼAsịrịa; otu nʼime ebe ndị a dọọrọ nʼagha si Sameria biri."
        }
      ]
    },
    "nep": {
      "preferred_label": "गोजान",
      "descriptions": [
        {
          "source": "acai",
          "description": "अश्शूरको हाबोर नदीको किनारमा रहेको एउटा सहर; सामरियाबाट निर्वासित गरिएका मानिसहरूलाई बसाइएका ठाउँहरूमध्ये एक।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Gô-xan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn dọc theo sông Cha-bo ở A-sy-ri; một trong những nơi mà những người lưu đày từ Sa-ma-ri được tái định cư."
        }
      ]
    },
    "zht": {
      "preferred_label": "歌散",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞述境內哈博河邊的一座城鎮；撒馬利亞被擄之人被安置的地點之一。"
        }
      ]
    }
  },
