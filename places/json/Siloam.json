      "descriptions": [
        {
          "source": "acai",
          "article": "place:Siloam",
          "gloss": "Siloam",
          "description": "The name for a system of water supply in Jerusalem; the pool of Siloam was probably the basin into which the water flowed."
        }
      ]
    },
    "apd": {
      "preferred_label": "سلوام",
      "descriptions": [
        {
          "source": "acai",
          "description": "اسم لنظام إمداد الموية في أورشليم؛ وبركة سلوام في الغالب كانت الحوض البتصب فيه الموية."
        }
      ]
    },
    "arb": {
      "preferred_label": "سِلْوامُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "اسم لنظام إمداد بالمياه في أورشليم؛ وكانت بركة سلوام على الأرجح الحوض الذي تجري إليه المياه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Saeloam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nem blong wan sistem blong givim wota long Jerusalem; puul blong Saeloam ating hemia besin ya we wota i ron i go insaed long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "Siloé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nom d’un système d’approvisionnement en eau à Jérusalem ; le réservoir de Siloé était probablement le bassin dans lequel l’eau s’écoulait."
        }
      ]
    },
    "hau": {
      "preferred_label": "Silowam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sunan wani tsarin samar da ruwa a Urushalima; mai yiwuwa Tafkin Silowam shi ne matattarar da ruwan yake kwarara a ciki."
        }
      ]
    },
    "hin": {
      "preferred_label": "शीलोह",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेम में जल आपूर्ति प्रणाली का एक नाम; शीलोह का कुण्ड संभवतः वह जलाशय था जिसमें पानी बहकर आता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sailọm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aha usoro e si enye mmiri na Jeruselem; ọdọ mmiri Sailọm nwere ike ịbụ ọdọ ebe mmiri ahụ na-abanye."
        }
      ]
    },
    "ind": {
      "preferred_label": "Siloam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nama sebuah sistem penyediaan air di Yerusalem; kolam Siloam kemungkinan merupakan waduk tempat air tersebut mengalir."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिलोआम",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेममा पानी आपूर्तिको एक प्रणालीको नाम; सिलोआमको तलाउ सम्भवतः त्यो कुण्ड थियो जहाँ पानी बगेर आउँथ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "Siloé",
      "descriptions": [
        {
          "source": "acai",
          "description": "O nome de um sistema de abastecimento de água em Jerusalém; o tanque de Siloé era provavelmente o reservatório no qual a água fluía."
        }
      ]
    },
    "rus": {
      "preferred_label": "Силоам",
      "descriptions": [
        {
          "source": "acai",
          "description": "Название системы водоснабжения в Иерусалиме; купальня Силоам, вероятно, была водоёмом, в который стекала вода."
        }
      ]
    },
    "spa": {
      "preferred_label": "Siloé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nombre de un sistema de abastecimiento de agua en Jerusalén; el estanque de Siloé probablemente era el estanque en el que fluía el agua."
        }
      ]
    },
    "swh": {
      "preferred_label": "Siloamu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jina la mfumo wa ugavi wa maji huko Yerusalemu; bwawa la Siloamu labda lilikuwa birika ambalo maji yalitiririka ndani yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Siloam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nem bilong wanpela rot bilong bringim wara i kam insait long Jerusalem; hul wara Siloam em i dispela raunwara we wara i save ran i go insait long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Si-lô",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tên của một hệ thống dẫn nước tại Giê-ru-sa-lem; ao Si-lô có lẽ là bể chứa nước chảy vào."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西罗亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷供水系统的名称；西罗亚池可能是水流汇入的蓄水池。"
        }
      ]
    },
    "zht": {
      "preferred_label": "西羅亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷一套供水系統的名稱；西羅亞池很可能是水流入的水池。"
        }
      ]
    }
  },
