  "localizations": {
    "eng": {
      "preferred_label": "Seir (Region)",
      "alternate_labels": [
        "Seirites",
        "Edomites",
        "mountain of Seir",
        "Mount Seir",
        "Edom",
        "hill country of Seir",
        "Seir"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Seir",
          "gloss": "Seir (Region)",
          "description": "A mountainous area east of the Jordan Valley and south of Moab, first inhabited by the Horites and later by the Edomites. "
        }
      ]
    },
    "arb": {
      "preferred_label": "سِعِير (منطقة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "منطقة جبلية تقع شرقي وادي الأردن وجنوبي موآب، سكنها أولًا الحوريون ثم الأدوميون لاحقًا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西珥 (地区)",
      "descriptions": [
        {
          "source": "acai",
          "description": "约旦河谷以东、摩押以南的山区，起初由何利人居住，后来由以东人居住。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Séir (région)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une région montagneuse à l’est de la vallée du Jourdain et au sud de Moab, d’abord habitée par les Horiens, puis par les Édomites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Seyir (Yanki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani yanki mai duwatsu a gabashin Kwarin Urdun da kuma kudancin Mowab, wanda da farko Horiyawa suka zauna a ciki, daga baya kuma Edomawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "सेईर (क्षेत्र)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरदन घाटी के पूर्व और मोआब के दक्षिण में एक पहाड़ी क्षेत्र, जहाँ पहले होरी लोग और बाद में एदोमी लोग बसे थे।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Seir (Wilayah)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wilayah pegunungan di sebelah timur Lembah Yordan dan di sebelah selatan Moab, yang pertama-tama didiami oleh orang Hori dan kemudian oleh orang Edom."
        }
      ]
    },
    "por": {
      "preferred_label": "Seir (região)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma área montanhosa a leste do vale do Jordão e ao sul de Moabe, primeiramente habitada pelos horeus e mais tarde pelos edomitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сеир (область)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Горная область к востоку от долины Иордана и к югу от Моава, сначала населенная хорреями, а затем идумеями."
        }
      ]
    },
    "spa": {
      "preferred_label": "Seír (región)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una zona montañosa al este del valle del Jordán y al sur de Moab, habitada primero por los horeos y más tarde por los edomitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Seiri (Mkoa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eneo la milima mashariki mwa Bonde la Yordani na kusini mwa Moabu, lililokaliwa kwanza na Wahori na baadaye na Waedomu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Seir (Rijin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples maunten long hap sankamap bilong Daunbilo bilong Jordan na long hap saut bilong Moap. Pastaim ol Hor i bin stap long en na bihain ol Idom i kisim."
        }
      ]
    },
    "apd": {
      "preferred_label": "سعير (منطقة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "منطقة جبلية شرق وادي الأردن وجنوب موآب، سكنها أولاً الحوريين وبعدين الأدوميين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Seir (Rijin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan eria we i fulap long ol hil long is saed blong Daelon blong Jodan mo long saot blong Moab, we folem fasin blong bifo ol man Hori oli stap long hem fastaem mo biaen ol man Edom oli stap long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sia (Mpaghara)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpaghara ugwu dị nʼakụkụ ọwụwa anyanwụ nke Ndagwurugwu Jọdan na ndịda Moab, nke ndị Hori bu ụzọ biri na ya ma mechaa bụrụ nke ndị Idọm."
        }
      ]
    },
    "nep": {
      "preferred_label": "सेइर (क्षेत्र)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यर्दन उपत्यकाको पूर्व र मोआबको दक्षिणमा पर्ने एउटा पहाडी क्षेत्र, जहाँ सुरुमा होरीहरू र पछि एदोमीहरू बसोबास गर्थे।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-i-rơ (Vùng)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vùng miền núi ở phía đông Thung lũng Giô-đanh và phía nam Mô-áp, ban đầu do người Hô-rít cư ngụ và về sau do người Ê-đôm sinh sống."
        }
      ]
    },
    "zht": {
      "preferred_label": "西珥（地區）",
      "descriptions": [
        {
          "source": "acai",
          "description": "約旦河谷以東、摩押以南的一個多山地區，起初由何利人居住，後來由以東人居住。"
        }
      ]
    }
  },
