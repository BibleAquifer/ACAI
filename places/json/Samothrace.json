          "gloss": "Samothrace",
          "description": "An island in the northern Aegean Sea; Paul's ship stopped here on his journey from Troas to Philippi."
        }
      ]
    },
    "fra": {
      "preferred_label": "Samothrace",
      "descriptions": [
        {
          "source": "acai",
          "description": "Île du nord de la mer Égée ; le bateau de Paul s'y arrêta lors de son voyage de Troas à Philippes."
        }
      ]
    },
    "spa": {
      "preferred_label": "Samotracia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Isla en el norte del mar Egeo; el barco de Pablo se detuvo allí en su viaje desde Troas hasta Filipos."
        }
      ]
    },
    "arb": {
      "preferred_label": "ساموثراكي",
      "descriptions": [
        {
          "source": "acai",
          "description": "جزيرة في شمال بحر إيجة؛ توقفت عندها سفينة بولس في رحلته من ترواس إلى فيلبي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "撒摩特喇",
      "descriptions": [
        {
          "source": "acai",
          "description": "爱琴海北部的一座岛屿；保罗乘船从特罗亚前往腓立比的途中曾在此停留。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Samotiras",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani tsibiri a arewacin Tekun Ageya; jirgin ruwan Bulus ya tsaya a nan a tafiyarsa daga Toruwas zuwa Filibbi."
        }
      ]
    },
    "hin": {
      "preferred_label": "सुमात्राके",
      "descriptions": [
        {
          "source": "acai",
          "description": "उत्तरी एजियन सागर में एक द्वीप; त्रोआस से फिलिप्पी की यात्रा के दौरान पौलुस का जहाज यहाँ रुका था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Samotrake",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah pulau di bagian utara Laut Aegea; kapal Paulus singgah di sini dalam perjalanannya dari Troas ke Filipi."
        }
      ]
    },
    "por": {
      "preferred_label": "Samotrácia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma ilha no norte do mar Egeu; o navio de Paulo parou ali em sua viagem de Trôade a Filipos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Самофракия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Остров в северной части Эгейского моря; корабль Павла останавливался здесь по пути из Троады в Филиппы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Samothrake",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kisiwa kilicho kaskazini mwa Bahari ya Aegean; merikebu ya Paulo ilisimama hapa katika safari yake kutoka Troa kwenda Filipi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Samotres",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ailan long not bilong solwara Idian; sip bilong Pol i bin stop long dispela ailan taim em i lusim Troas i go long Filipai."
        }
      ]
    },
    "apd": {
      "preferred_label": "ساموتراكي",
      "descriptions": [
