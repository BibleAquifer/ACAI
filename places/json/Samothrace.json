        }
      ]
    },
    "bis": {
      "preferred_label": "Samotres",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan aelan long not haf blong Solwota blong Ijian; sip blong Pol i bin stop long ples ya long trip blong hem aot long Troas i go long Filipae."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Samotres",
      "descriptions": [
        {
          "source": "acai",
          "description": "Àgwàetiti dị n'ebe ugwu Oké Osimiri Ejian; ụgbọ mmiri Pọl kwụsịtụrụ ebe a na njem o si Troas na-aga Filipaị."
        }
      ]
    },
    "nep": {
