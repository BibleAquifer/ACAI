        }
      ]
    },
    "bis": {
      "preferred_label": "Laodisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Frigia long Esia Maena klosap long Kolosi mo Hierapolis; wan long ol seven taon we buk blong Revelesen i tokbaot olgeta."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Laodisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na Frigia nʼEshia Maịnọ nso Kọlọsi na Hayerapolis; otu nʼime obodo asaa a gwara okwu na Mkpughe."
        }
      ]
    },
    "nep": {
      "preferred_label": "लाउडिकिया",
      "descriptions": [
        {
          "source": "acai",
          "description": "कलस्सी र हिरापोलिस नजिकै एसिया माइनरको फ्रिगियामा पर्ने एउटा सहर; प्रकाशको पुस्तकमा सम्बोधन गरिएका सात सहरहरूमध्ये एक।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Lao-đi-xê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành phố ở Phi-ri-ghi thuộc Tiểu Á, gần Cô-lô-se và Hi-ê-ra-bô-li; một trong bảy thành phố được gửi thư trong sách Khải Huyền."
        }
      ]
    },
    "zht": {
      "preferred_label": "老底嘉",
      "descriptions": [
        {
          "source": "acai",
          "description": "小亞細亞弗呂家境內的一座城市，靠近歌羅西和希拉波立；為《啟示錄》中致信的七個城市之一。"
        }
      ]
    }
