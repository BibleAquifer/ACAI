        }
      ]
    },
    "rus": {
      "preferred_label": "Лаодикия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город во Фригии в Малой Азии близ Колосс и Иераполя; один из семи городов, к которым обращена книга Откровение."
        }
      ]
    },
    "spa": {
      "preferred_label": "Laodicea",
