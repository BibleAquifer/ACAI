        }
      ]
    },
    "hau": {
      "preferred_label": "Lawodiseya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani birni a Firigiya a ƙasar Asiya Ƙarama kusa da Kolossi da Hiyerafolis; ɗaya daga cikin birane bakwai da aka yi magana da su a Ru’uyar Yohanna."
        }
      ]
    },
    "hin": {
      "preferred_label": "लौदीकिया",
      "descriptions": [
        {
          "source": "acai",
          "description": "एशिया माइनर के फ्रुगिया में कुलुस्से और हियरापुलिस के पास स्थित एक नगर; प्रकाशितवाक्य में संबोधित सात नगरों में से एक।"
        }
      ]
    },
    "ind": {
