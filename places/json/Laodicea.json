        }
      ]
    },
    "swh": {
      "preferred_label": "Laodikia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko Frigia katika Asia Ndogo karibu na Kolosai na Hierapoli; mojawapo ya miji saba iliyoandikiwa katika kitabu cha Ufunuo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Laodisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela taun long Frigia long Esia Minor klostu long Kolosi na Hierapolis; wanpela bilong ol 7-pela taun Buk Kamapim Tok Hait i toktok long en."
        }
      ]
    },
    "apd": {
      "preferred_label": "لاودكية",
