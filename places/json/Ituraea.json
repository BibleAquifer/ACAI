        }
      ]
    },
    "hin": {
      "preferred_label": "इतूरैया",
      "descriptions": [
        {
          "source": "acai",
          "description": "गलील की झील के उत्तर-पूर्व में एक छोटा प्रान्त, जो फिलिप्पुस के चौथाई राज्य का भाग था (लूका 3:1)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Iturea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Provinsi kecil di sebelah timur laut Danau Galilea, yang merupakan bagian dari wilayah kekuasaan Filipus (Lukas 3:1)."
        }
      ]
    },
    "por": {
      "preferred_label": "Itureia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma pequena província a nordeste do mar da Galileia, que fazia parte da tetrarquia de Filipe (Lucas 3:1)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Итурея",
      "descriptions": [
        {
          "source": "acai",
          "description": "Небольшая область к северо-востоку от Галилейского моря, входившая в тетрархию Филиппа (Лк. 3:1)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Iturea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pequeña provincia al noreste del mar de Galilea, que formaba parte de la tetrarquía de Felipe (Lucas 3:1)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ituria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela liklik provins long not-is bilong Rausolwara Galili, em i bin stap hap bilong distrik em Filip i bin bosim (Luk 3:1)."
        }
      ]
    },
    "apd": {
      "preferred_label": "إيطورية",
      "descriptions": [
        {
          "source": "acai",
          "description": "إقليم صغير شمال شرق بحيرة طبريا، كان جزء من ولاية فيلبس (لوقا 3: 1)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ituria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol provins long not-is blong Leik Galili, we i bin haf blong teritori we Filip i rulum (Luk 3:1)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Iturịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere ógbè dị nʼebe ugwu ọwụwa anyanwụ nke Oké Osimiri Galili, nke bụ akụkụ nke mpaghara ọchịchị Filip (Luk 3:1)."
        }
      ]
    },
    "nep": {
      "preferred_label": "इतुरिया",
      "descriptions": [
        {
          "source": "acai",
          "description": "गालीलको समुद्रको उत्तर-पूर्वमा रहेको सानो प्रान्त, जुन फिलिपको चौथाइ-शासक क्षेत्र (लूका ३:१) को भाग थियो।"
        }
      ]
    },
    "swh": {
      "preferred_label": "Iturea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkoa mdogo kaskazini-mashariki mwa Bahari ya Galilaya, uliokuwa sehemu ya utawala wa robo wa Filipo (Luka 3:1)."
        }
      ]
    },
    "vie": {
      "preferred_label": "I-tu-rê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một tỉnh nhỏ ở phía đông bắc Biển Ga-li-lê, từng thuộc quyền cai trị của Phi-líp (Lu-ca 3:1)."
        }
      ]
    },
    "zht": {
      "preferred_label": "以土利亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於加利利海東北方的一個小行省，曾是腓力分封領地的一部分（路加福音 3:1）。"
        }
      ]
    }
