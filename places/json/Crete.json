      "descriptions": [
        {
          "source": "acai",
          "article": "place:Crete",
          "gloss": "Crete",
          "description": "An island in the Mediterranean Sea, south of Greece, where Titus ministered (Tit 1:5)."
        }
      ]
    },
    "arb": {
      "preferred_label": "كريت",
      "descriptions": [
        {
          "source": "acai",
          "description": "جزيرة في البحر الأبيض المتوسط، جنوب اليونان، خدم فيها تيطس (تيطس 1: 5)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "克里特",
      "descriptions": [
        {
          "source": "acai",
          "description": "地中海中位于希腊以南的一座岛屿，提多曾在此服事（多 1:5）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Crète",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une île de la mer Méditerranée, au sud de la Grèce, où Tite exerça son ministère (Tite 1:5)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kirit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani tsibiri a Bahar Rum, a kudancin Girka, inda Titus ya yi hidima (Tit 1:5)."
        }
      ]
    },
    "hin": {
      "preferred_label": "क्रेते",
      "descriptions": [
        {
          "source": "acai",
          "description": "भूमध्य सागर में यूनान के दक्षिण में स्थित एक द्वीप, जहाँ तीतुस ने सेवा की थी (तीतुस 1:5)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kreta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah pulau di Laut Tengah, di sebelah selatan Yunani, tempat Titus melayani (Tit 1:5)."
        }
      ]
    },
    "por": {
      "preferred_label": "Creta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma ilha no mar Mediterrâneo, ao sul da Grécia, onde Tito exerceu ministério (Tt 1:5)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Крит",
      "descriptions": [
        {
          "source": "acai",
          "description": "Остров в Средиземном море к югу от Греции, где нес служение Тит (Тит. 1:5)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Creta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una isla en el mar Mediterráneo, al sur de Grecia, donde ministró Tito (Tit 1:5)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Krete",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kisiwa katika Bahari ya Mediterania, kusini mwa Ugiriki, ambako Tito alihudumu (Tito 1:5)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Krit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ailan long Solwara Mediterenian, long hap saut bilong Gris, em Taitus i bin mekim wok bilong God long en (Tai 1:5)."
        }
      ]
    },
    "apd": {
      "preferred_label": "كريت",
      "descriptions": [
        {
          "source": "acai",
          "description": "جزيرة في البحر الأبيض المتوسط، جنوب اليونان، خدم فيها تيطس (تيطس 1: 5)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Krit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan aelan long Mediterenian Si, long saot blong Gris, we Taetas i mekem wok blong God long hem (Taet 1:5)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kriit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu agwaetiti dị nʼOsimiri Mediterenia, nʼakụkụ ndịda Gris, ebe Taịtọs jere ozi (Taịtọs 1:5)."
        }
      ]
    },
    "nep": {
      "preferred_label": "क्रेट",
      "descriptions": [
        {
          "source": "acai",
          "description": "भूमध्य सागरमा युनान (ग्रीस) को दक्षिणतर्फ रहेको एउटा टापु, जहाँ तीतसले सेवाकार्य गरेका थिए (तीतस १:५)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Cơ-rết",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một hòn đảo ở Địa Trung Hải, phía nam Hy Lạp, nơi Tít thi hành chức vụ (Tít 1:5)."
        }
      ]
    },
    "zht": {
      "preferred_label": "克里特",
      "descriptions": [
        {
          "source": "acai",
          "description": "地中海中的一個島嶼，位於希臘以南，提多曾在此事奉（多 1:5）。"
        }
      ]
    }
