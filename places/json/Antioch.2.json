        }
      ]
    },
    "tpi": {
      "preferred_label": "Antiok (bilong Pisidia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Pisidia, i stap long Via Sebaste, em Pol i bin go long en long nambawan raun bilong em bilong autim tok bilong God."
        }
      ]
    },
    "apd": {
      "preferred_label": "أنطاكية (حق بيسيدية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في بيسيدية، واقعة على طريق سيباستي، سافر ليها بولس في رحلته التبشيرية الأولى."
        }
      ]
    },
    "bis": {
      "preferred_label": "Antiok (blong Pisidia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala taon long Pisidia, we i stap long rod ya Via Sebaste, we Pol i bin travel i go long hem long faswan misinari trip blong hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Antiọk (nke Pisidia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na Pisidia, nke dị nʼụzọ Via Sebaste, ebe Pọl gara nʼoge njem mgbasa ozi ọma mbụ ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "एन्टीओखिया (पिसिदियाको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "पिसिदियाको एउटा सहर, जो भाया सेबास्तेमा अवस्थित थियो, जहाँ पावलले आफ्नो पहिलो मिसनरी यात्राको क्रममा भ्रमण गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "An-ti-ốt (thuộc Bi-si-đi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành phố ở Bi-si-đi, nằm trên đường Via Sebaste, nơi Phao-lô đã đến trong hành trình truyền giáo thứ nhất."
        }
      ]
    },
    "zht": {
      "preferred_label": "安提阿（彼西底）",
