        "Perazim"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:MountPerazim",
          "gloss": "Mount Perazim",
          "description": "A mountain where king David defeated the Philistines (2 Samuel 5:20); also known as Baal-Perazim."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَبَل فَرَاصِيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "جبل هزم فيه الملك داود الفلسطينيين (2 صموئيل 5: 20)؛ ويُعرف أيضاً باسم بعل فراصيم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "毗拉心山",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王击败非利士人的一座山（撒母耳记下 5:20）；也称作巴力·毗拉心。"
        }
      ]
    },
    "fra": {
      "preferred_label": "mont Peratsim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une montagne où le roi David vainquit les Philistins (2 Samuel 5:20) ; aussi appelée Baal-Peratsim."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dutsen Feratsim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani dutse inda Sarki Dawuda ya ci Filistiyawa da yaƙi (2 Samu’ila 5:20); ana kuma kiran sa Ba’al-Ferazim."
        }
      ]
    },
    "hin": {
      "preferred_label": "पराजीम पर्वत",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक पर्वत जहाँ राजा दाऊद ने पलिश्तियों को हराया था (2 शमूएल 5:20); इसे बाल-परासीम भी कहा जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gunung Perasim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah gunung tempat Raja Daud mengalahkan orang Filistin (2 Samuel 5:20); dikenal juga sebagai Baal-Perasim."
        }
      ]
    },
    "por": {
      "preferred_label": "Monte Perazim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um monte onde o rei Davi derrotou os filisteus (2 Samuel 5:20); também conhecido como Baal-Perazim."
        }
      ]
    },
    "spa": {
      "preferred_label": "monte Perazim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un monte donde el rey David derrotó a los filisteos (2 Samuel 5:20); también conocido como Baal-perazim."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mlima Perasimu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mlima ambapo mfalme Daudi aliwashinda Wafilisti (2 Samweli 5:20); pia unajulikana kama Baal-perasimu."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبل فراصيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "جبل هزم فيه الملك داود الفلسطينيين (2 صموئيل 5: 20)؛ وبيتسمى كمان بعل فراصيم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hil Perajim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hil we King Deved i bin winim ol Filastin long hem (2 Samuel 5:20); nem blong hem tu Bal-Perasim."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ugwu Perazim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ugwu ebe Eze Devid meriri ndị Filistia (2 Samuel 5:20); nke a makwaara dịka Baal-Perazim."
        }
      ]
    },
    "nep": {
      "preferred_label": "पराजीम पर्वत",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक डाँडा जहाँ राजा दाऊदले पलिश्‍तीहरूलाई हराए (२ शमूएल ५:२०); यसलाई बाल-पराजीम पनि भनिन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Гора Перацим",
      "descriptions": [
        {
          "source": "acai",
          "description": "Гора, на которой царь Давид поразил филистимлян (2 Царств 5:20); также известная как Ваал-Перацим."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Maunten Perasim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela maunten em King Devit i bin daunim ol Filistia long en (2 Samuel 5:20); ol i kolim tu Bal-Perasim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Núi Phê-ra-xim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ngọn núi nơi Vua Đa-vít đánh bại người Phi-li-tin (2 Sa-mu-ên 5:20); cũng gọi là Ba-anh Phê-ra-xim."
        }
      ]
    },
    "zht": {
      "preferred_label": "毗拉心山",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王擊敗非利士人的一座山（撒母耳記下 5:20）；也稱為巴力‧毗拉心。"
        }
      ]
    }
