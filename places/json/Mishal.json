        }
      ]
    },
    "hau": {
      "preferred_label": "Mishal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani garin Firistoci a yankin kabilar Asher, wanda aka ba wa dangin Gershon; ana kuma kiran shi Mashal."
        }
      ]
    },
    "hin": {
      "preferred_label": "मिशाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "आशेर के क्षेत्र में लेवियों का एक नगर, जिसे गेर्शोन के कुल को सौंपा गया था; इसे माशाल के नाम से भी जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Misal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota orang Lewi di wilayah Asyer, yang diberikan kepada kaum Gerson; dikenal juga sebagai Masal."
        }
      ]
    },
    "por": {
      "preferred_label": "Misal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade levítica no território de Aser, designada ao clã de Gérson; também conhecida como Masal."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мишал",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитский город в уделе Асира, выделенный роду Герсона; также известен как Машал."
        }
      ]
    },
    "spa": {
      "preferred_label": "Miseal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad levítica en el territorio de Aser, asignada al clan de Gersón; también conocida como Masal."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mishali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa Walawi katika eneo la Asheri, uliogawiwa ukoo wa Gershoni; pia unajulikana kama Mashali."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Misal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun bilong ol Livai long graun bilong lain Aser, ol i bin givim long famili bilong Gerson; em i gat narapela nem tu olsem Masal."
        }
      ]
    },
    "apd": {
      "preferred_label": "مشآل",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في أرض أشير، اتخصصت لعشيرة جرشون؛ وبتتعرف كمان باسم ماشال."
        }
      ]
    },
    "bis": {
      "preferred_label": "Misal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon blong ol Livaet long graon blong Asa, we oli givim i go long laen blong Gerson; we nem blong hem tu Masal."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mishal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo ndị Livaị dị nʼókèala Asha, nke e kenyere ezinụlọ Geashọn; a makwaara ya dị ka Mashal."
        }
      ]
    },
    "nep": {
      "preferred_label": "मिशाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "आशेरको इलाकामा रहेको र गेर्शोनको कुललाई दिइएको एउटा लेवीहरूको सहर; यसलाई माशाल पनि भनिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Mi-sanh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn của người Lê-vi trong lãnh thổ của A-se, được phân bổ cho thị tộc Gẹt-sôn; cũng được gọi là Ma-sanh."
        }
      ]
    },
    "zht": {
      "preferred_label": "米沙勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞設境內的一座利未人城鎮，分給革順家族；又名瑪沙。"
        }
      ]
    }
