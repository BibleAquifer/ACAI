      ]
    },
    "bis": {
      "preferred_label": "Ikoniam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Likaonia, long saot blong Esia Maena; Pol mo Banabas tufala i go long ples ya long faswan misinari trip blong Pol."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aikoniọm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na Laịkaonịa, na ndịda Eshịa Maịnọ; Pọl na Banabas gara ebe a nʼoge njem nkwusa oziọma mbụ nke Pọl."
        }
      ]
    },
    "nep": {
      "preferred_label": "आइकोनियम",
      "descriptions": [
        {
          "source": "acai",
          "description": "दक्षिणी एसिया माइनरको लुकाओनियाको एउटा सहर; पावल र बारनाबासले पावलको पहिलो मिसनरी यात्राको क्रममा यहाँ भ्रमण गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Y-cô-ni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành phố ở Ly-cao-ni, miền nam Tiểu Á; Phao-lô và Ba-na-ba đã đến đây trong chuyến hành trình truyền giáo thứ nhất của Phao-lô."
        }
      ]
    },
    "zht": {
      "preferred_label": "以哥念",
      "descriptions": [
        {
