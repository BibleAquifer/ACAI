        }
      ]
    },
    "tpi": {
      "preferred_label": "Aikoniam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Likonia, long hap saut bilong Esia Maina; Pol wantaim Barnabas i bin raun i go long dispela taun long taim Pol i mekim namba wan raun bilong misin bilong en."
        }
      ]
    },
    "apd": {
