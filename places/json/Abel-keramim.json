        }
      ]
    },
    "hau": {
      "preferred_label": "Abel-Keramim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani ƙauye ne a yankin Ammon, gabashin Kogin Urdun, inda Yefta ya ci Ammonawa da yaƙi (Alƙalawa 11:33)."
        }
      ]
    },
    "hin": {
      "preferred_label": "आबेलकरामीम",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरदन नदी के पूर्व में अम्मोन क्षेत्र का एक गाँव, जहाँ यप्तह ने अम्मोनियों को वश में किया (न्यायियों 11:33)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Abel-Keramim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah desa di wilayah Amon, sebelah timur Sungai Yordan, tempat Yefta menundukkan bani Amon (Hakim-hakim 11:33)."
        }
      ]
    },
    "por": {
      "preferred_label": "Abel-Queramim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma aldeia na região de Amom, a leste do rio Jordão, onde Jefté subjugou os amonitas (Juízes 11:33)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Abel-Keramimu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kijiji katika eneo la Amoni, mashariki mwa Mto Yordani, ambapo Yeftha aliwashinda Waamoni (Waamuzi 11:33)."
        }
      ]
    },
    "apd": {
      "preferred_label": "آبيل الكروم",
      "descriptions": [
        {
          "source": "acai",
          "description": "قرية في منطقة عمون، شرق نهر الأردن، المحل الهزم فيهو يفتاح العمونيين (القضاة ١١: ٣٣)."
        }
      ]
    },
    "arb": {
      "preferred_label": "آبَل الكُروم",
      "descriptions": [
        {
          "source": "acai",
          "description": "قرية في منطقة بني عمون، شرقي نهر الأردن، حيث أخضع يفتاح ٱلْعَمّونِيِّينَ (القضاة 11: 33)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Abelkeramim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan vilej long rijon blong Amon, long is long Jodan Reva, we Jifta i bin winim ol man Amon long hem (Jajes 11:33)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebel-Keramim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo nta dị na mpaghara Amọn, n'akụkụ ọwụwa anyanwụ nke Osimiri Jọdan, ebe Jefta nwetara mmeri n'isi ndị Amọn (Ndị Ikpe 11:33)."
        }
      ]
    },
    "nep": {
      "preferred_label": "हाबिल-करमीम",
      "descriptions": [
        {
          "source": "acai",
          "description": "यर्दन नदीको पूर्वमा रहेको अम्मोन इलाकाको एउटा गाउँ, जहाँ यप्‍तहले अम्मोनका मानिसहरूलाई पराजित गरे (न्यायकर्ता ११:३३)।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Авель-Керамим",
      "descriptions": [
        {
          "source": "acai",
          "description": "Селение в земле Аммона к востоку от реки Иордан, где Иеффай смирил аммонитян (Судей 11:33)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Abel Keramim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples long hap bilong Amon, long hap sankamap bilong wara Jordan, em ples Jepta i bin daunim ol Amon (Hetman 11:33)."
        }
      ]
    },
    "vie": {
      "preferred_label": "A-bên Kê-ra-mim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ngôi làng trong vùng Am-môn, ở phía đông sông Giô-đanh, nơi Giép-thê đã đánh bại dân Am-môn (Các Quan Xét 11:33)."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞備勒‧基拉明",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於約旦河東亞捫地區的一個村莊，耶弗他曾在此制伏亞捫人（士師記 11:33）。"
        }
      ]
    }
