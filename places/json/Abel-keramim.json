        }
      ]
    },
    "spa": {
      "preferred_label": "Abel-queramim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aldea en la región de Amón, al este del río Jordán, donde Jefté derrotó a los amonitas (Jueces 11:33)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚备勒·基拉明",
      "descriptions": [
        {
