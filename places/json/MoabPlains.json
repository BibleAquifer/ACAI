  "localizations": {
    "eng": {
      "preferred_label": "Plains of Moab",
      "alternate_labels": [
        "Desert-Plateau of Moab",
        "desert-plateaus of Moab",
        "rift valley plains by Moab",
        "Moab Plains"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Moab.2",
          "gloss": "Plains of Moab",
          "description": "The region north of the Dead Sea and east of the Jordan River, where Moses deilvered his final message to the Israelites."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَرَبَات موآب",
      "descriptions": [
        {
          "source": "acai",
          "description": "منطقة شمال البحر الميت وشرق نهر الأردن، حيث ألقى موسى رسالته الأخيرة لبني إسرائيل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "摩押平原",
      "descriptions": [
        {
          "source": "acai",
          "description": "死海以北、约旦河以东的地区，摩西在此向以色列人传达了他最后的信息。"
        }
      ]
    },
    "fra": {
      "preferred_label": "plaines de Moab",
      "descriptions": [
        {
          "source": "acai",
          "description": "La région située au nord de la mer Morte et à l’est du Jourdain, où Moïse a prononcé son dernier message aux Israélites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Filayen Mowab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yankin da ke arewacin Tekun Gishiri da kuma gabashin Kogin Urdun, inda Musa ya isar da saƙonsa na ƙarshe ga Isra'ilawa."
        }
      ]
    },
    "ind": {
      "preferred_label": "Dataran Moab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wilayah di sebelah utara Laut Mati dan sebelah timur Sungai Yordan, tempat Musa menyampaikan pesan terakhirnya kepada orang Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Campinas de Moabe",
      "descriptions": [
        {
          "source": "acai",
          "description": "A região ao norte do mar Morto e a leste do rio Jordão, onde Moisés transmitiu sua mensagem final aos israelitas."
        }
      ]
    },
    "spa": {
      "preferred_label": "llanuras de Moab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Región al norte del mar Muerto y al este del río Jordán, donde Moisés pronunció su último mensaje a los israelitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tambarare za Moabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eneo la kaskazini mwa Bahari ya Chumvi na mashariki mwa Mto Yordani, ambapo Musa alitoa ujumbe wake wa mwisho kwa Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples stret bilong Moap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dispela hap i stap long hap not bilong Solwara Dede na long hap sankamap bilong wara Jordan, em hap Moses i bin autim laspela tok bilong en long ol Israel."
        }
      ]
    },
    "apd": {
      "preferred_label": "سهول مؤاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "المنطقة شمال البحر الميت وشرق نهر الأردن، وين ما موسى ألقى رسالته الأخيرة للإسرائيليين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bigfala levelples long Moab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ples long not long Ded Si mo long is long Jodan Reva, we Moses i talemaot laswan tok blong hem long ol man Isrel."
        }
      ]
    },
    "hin": {
      "preferred_label": "मोआब का अराबा",
      "descriptions": [
        {
          "source": "acai",
          "description": "मृत सागर के उत्तर और यरदन नदी के पूर्व का क्षेत्र, जहाँ मूसा ने इस्राएलियों को अपना अंतिम संदेश दिया था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Obosara Ala Moab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpaghara dị nʼugwu Oké Osimiri Nwụrụ Anwụ na nʼọwụwa anyanwụ Osimiri Jọdan, ebe Mosis ziri ozi ikpeazụ ya nye ndị Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "मोआबको मैदान",
      "descriptions": [
        {
          "source": "acai",
          "description": "मृत सागरको उत्तर र यर्दन नदीको पूर्वमा रहेको क्षेत्र, जहाँ मोशाले इस्राएलीहरूलाई आफ्नो अन्तिम सन्देश दिएका थिए।"
        }
      ]
    },
    "rus": {
      "preferred_label": "равнины Моава",
      "descriptions": [
        {
          "source": "acai",
          "description": "Область к северу от Мертвого моря и к востоку от реки Иордан, где Моисей произнес свое последнее обращение к израильтянам."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đồng bằng Mô-áp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vùng đất ở phía bắc Biển Chết và phía đông Sông Giô-đan, nơi Môi-se đã truyền sứ điệp cuối cùng cho dân Ít-ra-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "摩押平原",
      "descriptions": [
        {
          "source": "acai",
          "description": "死海以北、約旦河以東的地區，摩西在此向以色列人傳達了他最後的訓言。"
        }
      ]
    }
  },
