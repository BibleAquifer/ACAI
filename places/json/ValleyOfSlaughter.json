          "gloss": "Valley of the Slaughter",
          "description": "A valley, also known as the Hinnom Valley, known for the idol worship that took place there."
        }
      ]
    },
    "fra": {
      "preferred_label": "vallée du carnage",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une vallée, également connue sous le nom de vallée de Hinnom, connue pour le culte des idoles qui s'y déroulait."
        }
      ]
    },
    "spa": {
      "preferred_label": "valle de la Matanza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Valle, también conocido como el valle de Hinón, conocido por el culto a los ídolos que se practicaba allí."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَادِي ٱلْقَتْلِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادٍ يُعرف أيضاً بوادي هنوم، واشتُهر بعبادة الأوثان التي كانت تُمارس فيه."
        }
      ]
    },
    "zhs": {
      "preferred_label": "杀戮谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "一座山谷，也称为欣嫩子谷，因在那里举行偶像崇拜而闻名。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwarin Kisa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kwari ne, wanda kuma aka sani da Kwarin Hinnom, sananne saboda bautar gumaka da aka yi a wurin."
        }
      ]
    },
    "ind": {
      "preferred_label": "Lembah Pembunuhan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah lembah, juga dikenal sebagai Lembah Hinom, yang dikenal karena penyembahan berhala yang dilakukan di sana."
        }
      ]
    },
    "por": {
      "preferred_label": "Vale da Matança",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um vale, também conhecido como Vale de Hinom, conhecido pela adoração a ídolos que ocorria ali."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bonde la Machinjo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bonde linalojulikana pia kama Bonde la Hinomu, lililojulikana kwa ibada ya sanamu iliyofanyika humo."
        }
      ]
    },
    "apd": {
      "preferred_label": "وادي القتل",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادي معروف كمان بوادي هنوم، ومشهور بعبادة الأوثان الحصلت فيه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Krik blong Kilim Man i Ded",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan krik/levelples, we oli save long hem tu olsem Krik ya Hinom, we i gat nem from wosip long ol aedol we i bin tekem ples long hem."
        }
      ]
    },
    "hin": {
      "preferred_label": "घात की तराई",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक तराई, जिसे हिन्नोम की तराई के नाम से भी जाना जाता है, जो वहाँ होने वाली मूर्तिपूजा के लिए जानी जाती थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndagwurugwu Ogbugbu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndagwurugwu, nke a makwaara dị ka Ndagwurugwu Hinom, nke a maara maka ikpere arụsị e mere nʼebe ahụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "हत्याको बेँसी",
      "descriptions": [
        {
          "source": "acai",
          "description": "एउटा बेँसी, जसलाई हिन्‍नोमको बेँसी पनि भनिन्छ, जुन त्यहाँ भएको मूर्तिपूजाको निम्ति परिचित छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "долина убийства",
      "descriptions": [
        {
          "source": "acai",
          "description": "Долина, также известная как долина Еннома, известная совершавшимся там идолопоклонством."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples bilong kilim planti man i dai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples daun ol i save kolim tu olsem Ples Daun bilong Hinom, em ples i gat nem long ol manmeri i bin lotuim ol giaman god long en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thung lũng Tàn Sát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thung lũng, còn được gọi là thung lũng Hi-nôm, nổi tiếng về việc thờ lạy thần tượng diễn ra ở đó."
        }
      ]
    },
    "zht": {
      "preferred_label": "殺戮谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "一處山谷，亦稱欣嫩谷，因曾在該處舉行偶像崇拜而聞名。"
        }
      ]
    }
  },
