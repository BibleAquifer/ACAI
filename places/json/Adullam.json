          "article": "place:Adullam",
          "gloss": "Adullam",
          "description": "A town in the foothills of the territory of Judah where David and his men hid in a nearby cave (1 Samuel 22:1)."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَدُلَّامُ",
