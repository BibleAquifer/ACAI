        {
          "source": "acai",
          "description": "Otu obodo dị nʼugwu nta nke ókèala Juda ebe Devid na ndị ikom ya zoro nʼọgba dị nso (1 Samuel 22:1)."
        }
      ]
    },
    "nep": {
      "preferred_label": "अदुल्लाम",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदाको इलाकाको पहाडी फेदीमा रहेको एउटा सहर जहाँ दाऊद र उनका मानिसहरू नजिकैको गुफामा लुकेका थिए (१ शमूएल २२:१)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-đu-lam",
