        {
          "source": "acai",
          "description": "Một thị trấn ở vùng chân đồi thuộc lãnh thổ Giu-đa, nơi Đa-vít và thuộc hạ của ông trốn trong một hang đá gần đó (1 Sa-mu-ên 22:1)."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞杜蘭",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大境內山麓丘陵地區的一座城鎮，大衛和跟隨他的人曾藏身於附近的洞穴中（撒母耳記上 22:1）。"
        }
      ]
