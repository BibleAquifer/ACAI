  "localizations": {
    "eng": {
      "preferred_label": "Macedonia",
      "alternate_labels": [
        "Macedonians",
        "Macedonian"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Macedonia",
          "gloss": "Macedonia",
          "description": "A Roman province in Greece; Paul had a vision of a man of Macedonia who pleaded with him to come and preach the gospel (Acts 16:9–10)."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَكِدُونِيَّة",
      "descriptions": [
        {
          "source": "acai",
          "description": "مقاطعة رومانية في اليونان؛ رأى فيها بولس رؤيا لرجل مقدوني يتوسل إليه أن يأتي ويكرز بالإنجيل (أعمال الرسل 16: 9-10)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "马其顿",
      "descriptions": [
        {
          "source": "acai",
          "description": "希腊的一个罗马行省；保罗曾看见一个马其顿人的异象，恳求他前去传福音（使徒行传 16:9-10）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Macédoine",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une province romaine en Grèce ; Paul eut la vision d'un Macédonien qui le suppliait de venir prêcher l'Évangile (Actes 16.9-10)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Makidoniya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lardin Roma a ƙasar Hellas; Bulus ya ga wahayin wani mutumin Makidoniya yana roƙonsa cewa ya zo ya yi wa’azin bishara (Ayyukan Manzanni 16:9–10)."
        }
      ]
    },
    "hin": {
      "preferred_label": "मकिदुनिया",
      "descriptions": [
        {
          "source": "acai",
          "description": "यूनान में एक रोमी प्रान्त; पौलुस ने एक मकिदुनी पुरुष का दर्शन देखा जिसने उससे आकर सुसमाचार का प्रचार करने की विनती की (प्रेरितों के काम 16:9-10)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Makedonia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah provinsi Romawi di Yunani; Paulus mendapat suatu penglihatan tentang seorang Makedonia yang memohon kepadanya untuk datang dan memberitakan Injil (Kis. 16:9–10)."
        }
      ]
    },
    "por": {
      "preferred_label": "Macedônia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma província romana na Grécia; Paulo teve uma visão de um homem da Macedônia que lhe suplicava que fosse e pregasse o evangelho (Atos 16:9–10)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Македония",
      "descriptions": [
        {
          "source": "acai",
          "description": "Римская провинция в Греции; Павлу было видение мужа-македонянина, просившего его прийти и проповедовать Евангелие (Деян. 16:9–10)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Macedonia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Provincia romana en Grecia; Pablo tuvo una visión de un varón macedonio que le rogaba que fuera a predicar el evangelio (Hechos 16:9-10)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Makedonia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jimbo la Kirumi huko Ugiriki; Paulo alipata maono ya mtu wa Makedonia aliyemsihi aje kuhubiri injili (Matendo 16:9–10)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Masedonia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela provins bilong Rom long Grik; Pol i bin lukim wanpela visen bilong wanpela man bilong Masedonia i singautim em long kam autim gutnius (Aposel 16:9–10)."
        }
      ]
    },
    "apd": {
      "preferred_label": "مكدونية",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولاية رومانية في بلاد اليونان؛ بولس شاف رؤيا فيها راجل مكدوني بترجاهو يجي ويكرز بالإنجيل (أعمال 16: 9-10)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Masedonia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan provins blong Rom long Gris; Pol i luk wan vison blong wan man Masedonia we i stap askem strong long hem blong i kam prijimaot gud nius (Ol Wok 16:9–10)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Masidonia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu ógbè ndị Rom dị na Gris; Pọl hụrụ ọhụ banyere otu nwoke onye Masidonia nke rịọrọ ya ka ọ bịa kwusaa oziọma (Ọrụ 16:9–10)."
        }
      ]
    },
    "nep": {
      "preferred_label": "माकेडोनिया",
      "descriptions": [
        {
          "source": "acai",
          "description": "ग्रीसको एउटा रोमी प्रान्त; पावलले म्यासिडोनियाका एक जना मानिसको दर्शन देखे जसले उनलाई आएर सुसमाचार प्रचार गर्न बिन्ती गरेका थिए (प्रेरित १६:९–१०)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-xê-đoan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một tỉnh của La Mã ở Hy Lạp; Phao-lô thấy một khải tượng về một người Ma-xê-đoan nài xin ông đến giảng tin lành (Công vụ 16:9–10)."
        }
      ]
    },
    "zht": {
      "preferred_label": "馬其頓",
      "descriptions": [
        {
          "source": "acai",
          "description": "希臘境內的一個羅馬行省；保羅曾看見一個馬其頓人的異象，求他過去傳福音（徒 16:9-10）。"
        }
      ]
    }
  },
