  "localizations": {
    "eng": {
      "preferred_label": "Troas",
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Troas",
          "gloss": "Troas",
          "description": "A city and region in the northwest corner of Asia Minor; Paul had a vision while visiting there (Acts 16:8–9)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Troas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville et une région situées à l'angle nord-ouest de l'Asie Mineure ; Paul y eut une vision lors d'un séjour (Actes 16.8-9)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Troas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad y región en el extremo noroccidental de Asia Menor; Pablo tuvo una visión durante su estancia allí (Hechos 16:8-9)."
        }
      ]
    },
    "arb": {
      "preferred_label": "ترواس",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة وإقليم في الركن الشمالي الغربي من آسيا الصغرى؛ رأى فيها بولس رؤيا أثناء زيارته هناك (أعمال الرسل 16: 8-9)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "特罗亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "小亚细亚西北角的一座城市及地区；保罗在那里访问时见到了异象（使徒行传16:8–9）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Toruwas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani birni da yanki a kusurwar arewa maso yamma ta Asiya Ƙarama; Bulus ya ga wahayi sa’ad da yake ziyara a can (Ayyukan Manzanni 16:8–9)."
        }
      ]
    },
    "hin": {
      "preferred_label": "त्रोआस",
      "descriptions": [
        {
          "source": "acai",
          "description": "एशिया माइनर के उत्तर-पश्चिमी कोने में स्थित एक नगर और क्षेत्र; वहाँ यात्रा के दौरान पौलुस को एक दर्शन मिला था (प्रेरितों के काम 16:8-9)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Troas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota dan wilayah di sudut barat laut Asia Kecil; Paulus mendapat suatu penglihatan ketika berkunjung ke sana (Kisah Para Rasul 16:8–9)."
        }
      ]
    },
    "por": {
      "preferred_label": "Trôade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade e região no extremo noroeste da Ásia Menor; Paulo teve uma visão enquanto a visitava (Atos 16:8–9)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Троада",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город и область на северо-западе Малой Азии; во время пребывания там Павлу было видение (Деян. 16:8–9)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Troa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji na eneo katika pembe ya kaskazini-magharibi mwa Asia Ndogo; Paulo alipata maono alipotembelea huko (Matendo 16:8–9)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Troas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun na distrik long not-wes bilong Esia Mainor; Pol i bin lukim wanpela visen taim em i stap long dispela hap (Aposel 16:8–9)."
        }
      ]
    },
    "apd": {
      "preferred_label": "ترواس",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة وإقليم في الركن الشمالي الغربي من آسيا الصغرى؛ شاف بولس رؤيا وهو هناك (أعمال ١٦: ٨-٩)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Troas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon mo rijon long not-wes saed blong Esia Maena; Pol i bin luk wan vison taem hem i go long ples ya (Ol Wok 16:8-9)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Troas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo na mpaghara dị nʼakụkụ ugwu ọdịda anyanwụ nke Eshia Maịnọ; Pọl hụrụ ọhụụ mgbe ọ gara ebe ahụ (Ọrụ Ndị Ozi 16:8–9)."
        }
      ]
    },
    "nep": {
      "preferred_label": "त्रोआस",
      "descriptions": [
        {
          "source": "acai",
          "description": "एसिया माइनरको उत्तर-पश्‍चिमी कुनामा रहेको एउटा सहर र क्षेत्र; त्यहाँ भ्रमण गर्दा पावलले एउटा दर्शन देखेका थिए (प्रेरित १६:८–९)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Trô-ách",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành phố và khu vực ở góc tây bắc của Tiểu Á; Phao-lô đã thấy một khải tượng khi đến thăm nơi đó (Công Vụ 16:8–9)."
        }
      ]
    },
    "zht": {
      "preferred_label": "特羅亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "小亞細亞西北角的一座城市與地區；保羅在此造訪時看見了異象（使徒行傳 16:8–9）。"
        }
      ]
    }
  },
