  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Hebron",
      "alternate_labels": [
        "Kiriath-Arba",
        "Arba",
        "Arbah",
        "Kirjath-Arba"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Hebron",
          "gloss": "Hebron",
          "description": "A Levitical town in the territory of Judah, assigned to the clan of Aaron; formerly known as Kiriath-Arba. The patriarchs were buried in a cave there."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَبْرون",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في أرض يهوذا، خُصصت لعشيرة هارون؛ وكانت تُعرف سابقًا بقرية أربع. دُفن فيها الآباء في مغارة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "希伯仑",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大领地内分给亚伦家族的一座利未人城镇；原名基列·亚巴。族长们葬在当地的一个洞里。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Hébron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville lévitique dans le territoire de Juda, attribuée au clan d’Aaron ; autrefois connue sous le nom de Kirjath-Arba. Les patriarches furent enterrés dans une grotte à cet endroit."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hebron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani garin Firistoci a yankin Yahuda, wanda aka ba wa dangin Haruna; wanda a dā aka fi sani da Kiriyat-Arba. An binne kakanni a wani kogo a can."
        }
      ]
    },
    "hin": {
      "preferred_label": "हेब्रोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा के क्षेत्र में एक लेवियों का नगर, जो हारून के कुल को सौंपा गया था; पहले किर्यतअर्बा के नाम से जाना जाता था। वहाँ की एक गुफा में पूर्वजों (कुलपिताओं) को दफनाया गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hebron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota orang Lewi di wilayah Yehuda, yang diberikan kepada puak Harun; sebelumnya dikenal sebagai Kiryat-Arba. Para leluhur dimakamkan di sebuah gua di sana."
        }
      ]
    },
    "por": {
      "preferred_label": "Hebrom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade levítica no território de Judá, designada ao clã de Arão; anteriormente conhecida como Quiriate-Arba. Os patriarcas foram sepultados em uma caverna ali."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хеврон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитский город в уделе Иуды, выделенный роду Аарона; ранее известный как Кириаф-Арба. В находящейся там пещере были погребены патриархи."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hebrón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad levítica en el territorio de Judá, asignada al clan de Aarón; antiguamente conocida como Quiriat-arba. Los patriarcas fueron sepultados en una cueva allí."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hebroni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa Walawi katika eneo la Yuda, uliotengwa kwa ukoo wa Haruni; hapo awali ulijulikana kama Kiriath-Arba. Mababu walizikwa katika pango huko."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hebron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun bilong ol Livai long graun bilong Juda, em ol i bin givim long famili bilong Aron; bipo ol i kolim Kiriat Arba. Ol i bin planim ol tumbuna papa long wanpela matmat bilong hul ston long dispela ples."
        }
      ]
    },
    "apd": {
      "preferred_label": "حبرون",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في أرض يهوذا، خُصصت لعشيرة هارون؛ كان اسمها زمان قرية أربع. الآباء اتدفنوا في مغارة هناك."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hebron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon blong ol Livaet long graon blong Juda, we oli bin givim long laen blong Eron; we bifo nem blong hem Kiriataba. Ol olfala abu blong Isrel oli berem olgeta long wan keo long ples ya."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hebrọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo ndị Livaị dị nʼókèala Juda, nke e kenyere ezinụlọ Erọn; nke a na-akpọbu Kiriat-Aba. E liri ndị nna nna ochie nʼotu ọgba dị nʼebe ahụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "हेब्रोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदाको इलाकामा रहेको लेवीहरूको एउटा सहर, जो हारूनको कुललाई तोकिएको थियो; पहिले किर्यत-अर्बा भनेर चिनिन्थ्यो। पुर्खाहरूलाई त्यहाँको एउटा गुफामा गाडिएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hếp-rôn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn của người Lê-vi trong lãnh thổ Giu-đa, được chỉ định cho dòng tộc A-rôn; trước kia gọi là Ki-ri-át A-ra-ba. Các tổ phụ được chôn cất trong một hang đá tại đây."
        }
      ]
    },
    "zht": {
      "preferred_label": "希伯崙",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大領地內分配給亞倫家族的一座利未城鎮；舊稱基列‧亞巴。先祖們被安葬在那裡的一個洞穴中。"
        }
      ]
    }
  },
