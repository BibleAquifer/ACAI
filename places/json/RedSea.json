  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Red Sea",
      "alternate_labels": [
        "Red",
        " Sea"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:RedSea.1",
          "gloss": "Red Sea",
          "description": "A body of salt water located between Egypt and the Sinai Peninsula, which the Israelites crossed after they left Egypt."
        }
      ]
    },
    "arb": {
      "preferred_label": "بحر سوف",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسطح مائي مالح يقع بين مصر وشبه جزيرة سيناء، عبره بنو إسرائيل بعد خروجهم من مصر."
        }
      ]
    },
    "zhs": {
      "preferred_label": "红海",
      "descriptions": [
        {
          "source": "acai",
          "description": "位于埃及和西奈半岛之间的一片咸水海域，以色列人出埃及后曾横渡此海。"
        }
      ]
    },
    "fra": {
      "preferred_label": "mer Rouge",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une étendue d’eau salée située entre l’Égypte et la péninsule du Sinaï, que les Israélites traversèrent après avoir quitté l’Égypte."
        }
      ]
    },
    "hau": {
      "preferred_label": "Jan Teku",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ruwan gishiri da ke tsakanin Masar da Tsibirin Sinai, wanda Isra’ilawa suka haye bayan sun bar Masar."
        }
      ]
    },
    "hin": {
      "preferred_label": "लाल समुद्र",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिस्र और सीनै प्रायद्वीप के बीच स्थित खारे पानी का एक जलाशय, जिसे इस्राएलियों ने मिस्र से निकलने के बाद पार किया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Laut Teberau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Badan air asin yang terletak di antara Mesir dan Semenanjung Sinai, yang diseberangi orang Israel setelah mereka meninggalkan Mesir."
        }
      ]
    },
    "por": {
      "preferred_label": "Mar Vermelho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um corpo de água salgada localizado entre o Egito e a Península do Sinai, que os israelitas atravessaram após saírem do Egito."
        }
      ]
    },
    "spa": {
      "preferred_label": "mar Rojo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cuerpo de agua salada ubicado entre Egipto y la península del Sinaí, que los israelitas cruzaron después de salir de Egipto."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bahari ya Shamu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bahari ya maji ya chumvi iliyo kati ya Misri na Rasi ya Sinai, ambayo Waisraeli waliivuka baada ya kuondoka Misri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Solwara Retsi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela solwara i gat sol i stap namel long Isip na hap bilong Sainai, em ol Israel i bin brukim bihain long ol i lusim Isip."
        }
      ]
    },
    "apd": {
      "preferred_label": "البحر الأحمر",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسطح مائي مالح بين مصر وشبه جزيرة سيناء، عبروه بني إسرائيل بعد ما طلعوا من مصر."
        }
      ]
    },
    "bis": {
      "preferred_label": "Red Si",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan solwota we i stap bitwin Ijip mo Penensula blong Saenae, we ol man Isrel oli krosem biaen we oli aot long Ijip."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Osimiri Uhie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmiri nnu dị nʼagbata Ijipt na ala dọtịị nke Saịnaị, bụ nke ụmụ Izrel gafere mgbe ha hapụrụ Ijipt."
        }
      ]
    },
    "nep": {
      "preferred_label": "लाल समुद्र",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिश्र र सीनै प्रायद्वीपको बीचमा अवस्थित नुनिलो पानीको समुद्र, जसलाई इस्राएलीहरूले मिश्रबाट निस्केपछि पार गरेका थिए।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Красное море",
      "descriptions": [
        {
          "source": "acai",
          "description": "Солёный водоём, расположенный между Египтом и Синайским полуостровом, который израильтяне перешли после исхода из Египта."
        }
      ]
    },
    "vie": {
      "preferred_label": "Biển Đỏ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vùng nước mặn nằm giữa Ai Cập và bán đảo Si-nai mà người Y-sơ-ra-ên đã vượt qua sau khi rời Ai Cập."
        }
      ]
    },
    "zht": {
      "preferred_label": "紅海",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於埃及與西奈半島之間的鹹水海域，以色列人出埃及後曾過此海。"
        }
      ]
    }
  },
