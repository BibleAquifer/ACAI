  "localizations": {
    "eng": {
      "preferred_label": "Taanach",
      "alternate_labels": [
        "Aner",
        "Tanach"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Taanach",
          "gloss": "Taanach",
          "description": "A Levitical town in the territory of Manasseh, west of the Jordan River; assigned to the clan of Kohath."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَعْنَكُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَدينَةٌ لِلَّاوِيِّينَ في أَرْضِ مَنَسَّى، غَرْبَ نَهْرِ الأُرْدُنِّ؛ خُصِّصَتْ لِعَشيرَةِ قَهاتَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "他纳",
      "descriptions": [
        {
          "source": "acai",
          "description": "玛拿西境内、约旦河西岸的一座利未人城镇，分给了哥辖家族。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ta’anak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani birnin Lawiyawa a yankin Manasse, yamma da Kogin Urdun; wanda aka ware wa zuriyar Kohat."
        }
      ]
    },
    "hin": {
      "preferred_label": "तानाक",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरदन नदी के पश्चिम में मनश्शे के क्षेत्र में एक लेवीय नगर; जो कहात के कुल को सौंपा गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Taanakh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota orang Lewi di wilayah Manasye, sebelah barat Sungai Yordan; diperuntukkan bagi puak Kehat."
        }
      ]
    },
    "por": {
      "preferred_label": "Taanaque",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade levítica no território de Manassés, a oeste do rio Jordão; designada ao clã de Coate."
        }
      ]
    },
    "rus": {
      "preferred_label": "Фаанах",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитский город в уделе Манассии, к западу от реки Иордан; был отведен роду Каафа."
        }
      ]
    },
    "spa": {
      "preferred_label": "Tanac",
      "descriptions": [
        {
          "source": "acai",
          "description": "Población levítica en el territorio de Manasés, al oeste del río Jordán; asignada al clan de Coat."
        }
      ]
    },
    "swh": {
      "preferred_label": "Taanaki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji wa Walawi katika eneo la Manase, magharibi mwa Mto Yordani; uliopewa ukoo wa Kohathi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tanak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun bilong ol Livai long graun bilong Manase, long hap wes bilong Wara Jordan; ol i bin givim long ol lain bilong Kohat."
        }
      ]
    },
    "apd": {
      "preferred_label": "تعنك",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة لاوية في أرض منسى، غرب نهر الأردن، اتخصصت لعشيرة قهات."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tahanak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon blong ol Livaet long teritori blong Manase, long wes saed blong Riva Jodan; oli givim long laen blong Kohat."
        }
      ]
    },
    "fra": {
      "preferred_label": "Taanac",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville lévitique sur le territoire de Manassé, à l'ouest du Jourdain ; attribuée au clan de Kehath."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Teanak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo ndị Livayị dị nʼókèala Manase, nʼọdịda anyanwụ nke Osimiri Jọdan; nke e kenyere ezinụlọ Kohat."
        }
      ]
    },
    "nep": {
      "preferred_label": "तानाक",
      "descriptions": [
        {
          "source": "acai",
          "description": "यर्दन नदीको पश्‍चिमपट्टि मनश्शेको इलाकामा पर्ने एउटा लेवीहरूको सहर; यो कहातको कुललाई दिइएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Tha-a-nác",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành Lê-vi trong lãnh thổ Ma-na-se, ở phía tây sông Giô-đanh; được chỉ định cho thị tộc Kê-hát."
        }
      ]
    },
    "zht": {
      "preferred_label": "他納",
      "descriptions": [
        {
          "source": "acai",
          "description": "約旦河西瑪拿西境內的一座利未人城鎮，分給哥轄宗族。"
        }
      ]
    }
  },
