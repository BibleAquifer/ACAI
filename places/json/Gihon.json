        }
      ]
    },
    "nep": {
      "preferred_label": "गीहोन (अदनको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कूश देश भएर बग्ने एउटा नदी; अदनको बगैँचाबाट निस्कने चारवटा नदीहरूमध्ये एक।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gihon (bilong Iden)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela wara i ran i go long graun Kus; em wanpela bilong foapela wara i bin kamap long Gaden Iden."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ghi-hôn (thuộc Ê-đen)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con sông chảy qua xứ Cút; một trong bốn con sông bắt nguồn từ Vườn Ê-đen."
        }
      ]
    },
    "zht": {
      "preferred_label": "基訓（伊甸）",
      "descriptions": [
        {
          "source": "acai",
          "description": "流經古實全地的一條河；為流出伊甸園的四條河之一。"
        }
      ]
    }
