      ]
    },
    "bis": {
      "preferred_label": "Gihon (blong Iden)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan reva we i stap ron i go olbaot long graon blong Kus; wan long fo reva we i kamaot long Garen blong Iden."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gaihọn (nke Iden)",
      "descriptions": [
        {
          "source": "acai",
