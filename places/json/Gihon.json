        }
      ]
    },
    "por": {
      "preferred_label": "Giom (do Éden)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um rio que percorre a terra de Cuxe; um dos quatro rios que fluíam do Jardim do Éden."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гихон (в Эдеме)",
      "descriptions": [
