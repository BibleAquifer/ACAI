        }
      ]
    },
    "swh": {
      "preferred_label": "Gihoni (wa Edeni)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mto unaopita katika nchi ya Kushi; mmoja wa mito minne inayotiririka kutoka Bustani ya Edeni."
        }
      ]
    },
    "apd": {
      "preferred_label": "جيحون (بتاع عدن)",
      "descriptions": [
        {
