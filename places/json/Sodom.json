  "localizations": {
    "eng": {
      "preferred_label": "Sodom",
      "alternate_labels": [
        "Sodoma",
        "[ ]"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Sodom",
          "gloss": "Sodom",
          "description": "A town near the Dead Sea where Lot settled when he separated himself from Abraham; it was destroyed with Gomorrah."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَدُوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة بالقرب من بحر الملح سكن فيها لوط حين فارق إبراهيم؛ وقد دُمرت مع عمورة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "所多玛",
      "descriptions": [
        {
          "source": "acai",
          "description": "死海附近的一座城镇，罗得与亚伯拉罕分开后定居于此；后来与蛾摩拉一同被毁灭。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Sodome",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville près de la mer Morte où Lot s'établit lorsqu'il se sépara d'Abraham ; elle fut détruite avec Gomorrhe."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sodom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari kusa da Tekun Gishiri inda Lutu ya zauna sa'ad da ya rabu da Ibrahim; an hallakar da shi tare da Gomorra."
        }
      ]
    },
    "hin": {
      "preferred_label": "सदोम",
      "descriptions": [
        {
          "source": "acai",
          "description": "मृत सागर के पास स्थित एक नगर जहाँ लूत इब्राहीम से अलग होने के बाद बस गया था; यह गमोरा के साथ नष्ट कर दिया गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Sodom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota dekat Laut Mati tempat Lot menetap ketika ia berpisah dari Abraham; kota ini dihancurkan bersama Gomora."
        }
      ]
    },
    "por": {
      "preferred_label": "Sodoma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade próxima ao Mar Morto onde Ló se estabeleceu quando se separou de Abraão; foi destruída com Gomorra."
        }
      ]
    },
    "rus": {
      "preferred_label": "Содом",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город близ Мертвого моря, где поселился Лот, отделившись от Авраама; был уничтожен вместе с Гоморрой."
        }
      ]
    },
    "spa": {
      "preferred_label": "Sodoma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad cerca del mar Muerto donde se estableció Lot cuando se separó de Abraham; fue destruida junto con Gomorra."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sodoma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji karibu na Bahari ya Chumvi ambapo Loti aliishi alipotengana na Abrahamu; uliharibiwa pamoja na Gomora."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sodom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun klostu long Detsi we Lot i bin i go sindaun taim em i bin lusim Abraham; na em i bin bagarap wantaim Gomora."
        }
      ]
    },
    "apd": {
      "preferred_label": "سدوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة قريبة من البحر الميت استقر فيها لوط لما فارق إبراهيم؛ واتدمرت مع عمورة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sodom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon klosap long Ded Si we Lot i go stap long hem taem hem i seraot wetem Ebraham; hem i bin distrowae wetem Gomora."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sọdọm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nso nʼOsimiri Nwụrụ Anwụ ebe Lọt biri mgbe ya na Ebreham kewasịrị; e bibiri ya na Gọmọra."
        }
      ]
    },
    "nep": {
      "preferred_label": "सदोम",
      "descriptions": [
        {
          "source": "acai",
          "description": "मृत सागर नजिकैको एउटा सहर जहाँ लोत अब्राहामबाट छुट्टिएपछि बसोबास गर्न गए; यो गमोरासँगै नष्ट भएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sô-đôm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn gần Biển Chết, nơi Lót đã đến định cư khi chia tay Áp-ra-ham; thành này đã bị hủy diệt cùng với Gô-mô-rơ."
        }
      ]
    },
    "zht": {
      "preferred_label": "所多瑪",
      "descriptions": [
        {
          "source": "acai",
          "description": "死海附近的一座城鎮，羅得與亞伯拉罕分開後在此定居；它與蛾摩拉一同被毀滅。"
        }
      ]
    }
  },
