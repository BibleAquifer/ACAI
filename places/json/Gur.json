        }
      ]
    },
    "spa": {
      "preferred_label": "Gur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cuesta en el territorio de Manasés, cerca de Ibleam, donde Jehú mató a Ocozías."
        }
      ]
    },
    "arb": {
      "preferred_label": "جور",
      "descriptions": [
        {
          "source": "acai",
          "description": "العقبة في أرض منسى بالقرب من يبلعام، حيث قتل ياهو أخزيا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "姑珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "玛拿西境内靠近以伯莲的一处斜坡，耶户曾在此击杀亚哈谢。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Gur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Haohan tudu a yankin Manasse, kusa da Ibileyam, inda Yehu ya kashe Ahaziya."
        }
      ]
    },
    "hin": {
      "preferred_label": "गूर",
      "descriptions": [
        {
          "source": "acai",
          "description": "मनश्शे के क्षेत्र में यिबलाम के पास की एक चढ़ाई, जहाँ येहू ने अहज्याह को मारा था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pendakian di daerah suku Manasye, dekat Yibleam, tempat Yehu membunuh Ahazia."
        }
      ]
    },
    "por": {
      "preferred_label": "Gur",
      "descriptions": [
        {
          "source": "acai",
          "description": "A subida no território de Manassés, perto de Ibleã, onde Jeú matou Acazias."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гур",
      "descriptions": [
        {
          "source": "acai",
          "description": "Возвышенность в уделе Манассии, близ Ивлеама, где Ииуй смертельно ранил Охозию."
        }
      ]
    },
    "swh": {
      "preferred_label": "Guri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwelekeo wa kupanda katika eneo la Manase, karibu na Ibleamu, ambapo Yehu alimuua Ahazia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rot i go antap long hap graun bilong Manase, klostu long Ipleam, em ples Jehu i bin kilim Ahasia i dai."
        }
      ]
    },
    "apd": {
      "preferred_label": "جور",
      "descriptions": [
        {
          "source": "acai",
          "description": "العقبة في أرض منسى، قريبة من يبلعام، وين ياهو قتل أخزيا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Guru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan rod we i goraon i go antap long hil long graon blong Manase, klosap long Jibleam, we Jehu i kilim King Ahasia i ded long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ugwu mgbago dị nʼókèala Manase, nso Ibleam, ebe Jehu gburu Ahazaya."
        }
      ]
    },
    "nep": {
      "preferred_label": "गूर",
      "descriptions": [
        {
          "source": "acai",
          "description": "मनश्शेको इलाकामा यिबलआमनेर भएको उकालो बाटो, जहाँ येहूले अहज्याहलाई मारेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Gu-rơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con dốc trong lãnh thổ Ma-na-se, gần Íp-lê-am, nơi Giê-hu giết A-cha-xia."
        }
      ]
    },
    "zht": {
      "preferred_label": "姑珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "瑪拿西境內靠近以伯蓮的坡道，耶戶在此擊殺了亞哈謝。"
        }
      ]
    }
  },
