  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Samaria (City)",
      "alternate_labels": [
        "Mount Samaria",
        "Samaritan",
        "Samaritans",
        "Samarian",
        "Samaria"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Samaria.1",
          "gloss": "Samaria (City)",
          "description": "A city constructed by King Omri which was the capital of the northern Israelite kingdom until it was conquered by Assyrians; often used to refer to the entire northern kingdom."
        }
      ]
    },
    "arb": {
      "preferred_label": "السامرة (مدينة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة بناها الملك عمري وكانت عاصمة مملكة إسرائيل الشمالية حتى استولى عليها الآشوريون؛ وكثيرًا ما كانت تُطلق للإشارة إلى كامل المملكة الشمالية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "撒玛利亚（城）",
      "descriptions": [
        {
          "source": "acai",
          "description": "由暗利王建造的城市，曾是以色列北国的首都，直到被亚述人攻陷；常用来指代整个北国。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Samarie (ville)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville construite par le roi Omri, qui fut la capitale du royaume d'Israël du Nord jusqu'à sa conquête par les Assyriens ; souvent utilisée pour désigner l'ensemble du royaume du Nord."
        }
      ]
    },
    "hau": {
      "preferred_label": "Samariya (Birni)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Birnin da Sarki Omri ya gina wanda ya kasance babban birnin masarautar arewa ta Isra’ila har zuwa lokacin da Assuriyawa suka ci shi da yaƙi; sau da yawa ana amfani da sunan wajen nufin dukan masarautar arewa."
        }
      ]
    },
    "hin": {
      "preferred_label": "सामरिया (नगर)",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा ओ Omnri (ओोम्री) द्वारा निर्मित एक नगर जो अश्शूरियों द्वारा जीते जाने तक उत्तरी इस्राएली राज्य की राजधानी था; अक्सर पूरे उत्तरी राज्य को संदर्भित करने के लिए उपयोग किया जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Samaria (Kota)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota yang dibangun oleh Raja Omri yang menjadi ibu kota kerajaan utara Israel hingga ditaklukkan oleh bangsa Asyur; sering digunakan untuk merujuk pada seluruh kerajaan utara."
        }
      ]
    },
    "por": {
      "preferred_label": "Samaria (cidade)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade construída pelo rei Onri que foi a capital do reino israelita do norte até ser conquistada pelos assírios; frequentemente usada para se referir a todo o reino do norte."
        }
      ]
    },
    "rus": {
      "preferred_label": "Самария (город)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город, построенный царем Амврием, который был столицей Северного израильского царства до его завоевания ассирийцами; часто использовался для обозначения всего Северного царства."
        }
      ]
    },
    "spa": {
      "preferred_label": "Samaria (ciudad)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad construida por el rey Omrí que fue la capital del reino del norte de Israel hasta que fue conquistada por los asirios; a menudo utilizada para referirse a todo el reino del norte."
        }
      ]
    },
    "swh": {
      "preferred_label": "Samaria (Mji)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji uliojengwa na Mfalme Omri uliokuwa mji mkuu wa ufalme wa kaskazini wa Israeli hadi ulipotekwa na Waashuru; mara nyingi ulitumiwa kurejelea ufalme mzima wa kaskazini."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Samaria (Biktaun)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela biktaun King Omri i bin wokim, em i bin stap nambawan taun bilong kingdom bilong Israel long hap not inap long taim ol Asiria i winim ol; planti taim ol i save yusim dispela nem bilong makim olgeta kingdom bilong not."
        }
      ]
    },
    "apd": {
      "preferred_label": "السامرة (مدينة)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة بناها الملك عمري وكانت عاصمة مملكة إسرائيل الشمالية لغاية ما استولى عليها الآشوريين؛ وغالباً كانت بتستخدم للإشارة للمملكة الشمالية كلها."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sameria (Taon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon we King Omri i bin bildimap we i bin kapitol blong not kingdom blong Isrel go kasem taem we ol man Asiria oli tekemoftem; plante taem oli yusum nem ya blong tokbaot ful not kingdom."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sameria (Obodo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo Eze Omri wuru nke bụbu isi obodo alaeze Izrel nke dị n'ugwu tupu ndị Asịrịa emerie ya; a na-ejikarị ya eme ihe na-ezo aka n'alaeze ugwu dum."
        }
      ]
    },
    "nep": {
      "preferred_label": "सामरिया (सहर)",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा ओम्रीद्वारा निर्माण गरिएको एउटा सहर जुन अश्शूरीहरूले कब्जा नगरुन्जेल उत्तरी इस्राएली राज्यको राजधानी थियो; प्रायः सम्पूर्ण उत्तरी राज्यलाई बुझाउन पनि प्रयोग गरिने।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sa-ma-ri (Thành phố)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành phố do Vua Ôm-ri xây dựng, từng là thủ đô của vương quốc phía bắc của dân Y-sơ-ra-ên cho đến khi bị người A-sy-ri đánh chiếm; thường được dùng để chỉ toàn bộ vương quốc phía bắc."
        }
      ]
    },
    "zht": {
      "preferred_label": "撒馬利亞（城）",
      "descriptions": [
        {
          "source": "acai",
          "description": "由暗利王所建的城邑，在被亞述人征服之前是以色列北國的首都；常被用來指稱整個北國。"
        }
      ]
    }
  },
