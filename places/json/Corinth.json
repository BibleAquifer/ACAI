  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Corinth",
      "alternate_labels": [
        "Corinthians",
        "[ ]",
        "Corinthus",
        "Corinthian"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Corinth",
          "gloss": "Corinth",
          "description": "A city in Greece where Paul ministered for a year and a half (Acts 18:11); Paul wrote at least two letters to the church here."
        }
      ]
    },
    "arb": {
      "preferred_label": "كُورِنْثُوسُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في اليونان خدم فيها بولس لمدة سنة وستة أشهر (أعمال ١٨: ١١)؛ كتب بولس رسالتين على الأقل إلى الكنيسة فيها."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哥林多",
      "descriptions": [
        {
          "source": "acai",
          "description": "希腊的一座城市，保罗曾在此事奉了一年半（徒 18:11）；保罗曾写了至少两封信给这里的教会。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Corinthe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville de Grèce où Paul exerça son ministère pendant un an et demi (Actes 18:11) ; Paul écrivit au moins deux épîtres à l'Église de cette ville."
        }
      ]
    },
    "hau": {
      "preferred_label": "Korint",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani birni a Hellas (Girka) inda Bulus ya yi hidima har tsawon shekara ɗaya da rabi (Ayyukan Manzanni 18:11); Bulus ya rubuta aƙalla wasiƙu biyu zuwa ga ikilisiyar da ke nan."
        }
      ]
    },
    "hin": {
      "preferred_label": "कुरिन्थुस",
      "descriptions": [
        {
          "source": "acai",
          "description": "यूनान का एक नगर जहाँ पौलुस ने डेढ़ वर्ष तक सेवा की (प्रेरितों के काम 18:11); पौलुस ने यहाँ की कलीसिया को कम से कम दो पत्रियाँ लिखीं।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Korintus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di Yunani tempat Paulus melayani selama satu setengah tahun (Kisah Para Rasul 18:11); Paulus menulis setidaknya dua surat kepada jemaat di sini."
        }
      ]
    },
    "por": {
      "preferred_label": "Corinto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade na Grécia onde Paulo ministrou durante um ano e meio (Atos 18:11); Paulo escreveu pelo menos duas cartas à igreja dali."
        }
      ]
    },
    "rus": {
      "preferred_label": "Коринф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в Греции, где Павел совершал служение в течение полутора лет (Деян. 18:11); церкви этого города Павел написал по меньшей мере два послания."
        }
      ]
    },
    "spa": {
      "preferred_label": "Corinto",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad de Grecia donde Pablo ministró durante un año y medio (Hechos 18:11); Pablo escribió al menos dos cartas a la iglesia de este lugar."
        }
      ]
    },
    "swh": {
      "preferred_label": "Korintho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko Ugiriki ambako Paulo alihudumu kwa mwaka mmoja na nusu (Matendo 18:11); Paulo aliandika angalau barua mbili kwa kanisa la hapa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Korin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Gris em Pol i bin mekim wok autim tok long en inap wanpela yia na hap (Aposel 18:11); Pol i bin raitim tupela pas long sios i stap hia."
        }
      ]
    },
    "apd": {
      "preferred_label": "كورنثوس",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في اليونان خدم فيها بولس لمدة سنة وستة شهور (أعمال ١٨: ١١)، وبولس كتب رسالتين على الأقل للكنيسة الهناك."
        }
      ]
    },
    "bis": {
      "preferred_label": "Korin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Gris we Pol i bin mekem wok blong God long hem blong wan yia wetem haf (Ol Wok 18:11); Pol i bin raetem tu leta long sios long ples ya."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kọrint",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na Gris ebe Pọl jere ozi ruo otu afọ na ọnwa isii (Ọrụ Ndị Ozi 18:11); Pọl degaara nzukọ Kraịst nọ nʼebe a ma ọ dịkarịa ala akwụkwọ ozi abụọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "कोरिन्थ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ग्रीसको एउटा सहर जहाँ पावलले डेढ वर्ष सेवा गरे (प्रेरित १८:११); पावलले यहाँको मण्डलीलाई कम्तीमा दुईवटा पत्र लेखेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Cô-rinh-tô",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành phố ở Hy Lạp nơi Phao-lô đã thi hành chức vụ trong một năm rưỡi (Công vụ 18:11); Phao-lô đã viết ít nhất hai bức thư cho hội thánh tại đây."
        }
      ]
    },
    "zht": {
      "preferred_label": "哥林多",
      "descriptions": [
        {
          "source": "acai",
          "description": "希臘的一座城市，保羅曾在那裏事奉了一年半（徒 18:11）；保羅曾給當地的教會寫了至少兩封書信。"
        }
      ]
    }
  },
