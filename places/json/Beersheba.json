  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Beersheba (in the Negev)",
      "alternate_labels": [
        "Beer-Sheba",
        "Shibah",
        "Sheba"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Beersheba.1",
          "gloss": "Beersheba (in the Negev)",
          "description": "A town located in the Negev, at the southern border of Judah; used especially in combination with Dan at the northern border of Israel to refer to all Israel."
        }
      ]
    },
    "zhs": {
      "preferred_label": "别是巴 (内盖夫)",
      "descriptions": [
        {
          "source": "acai",
          "description": "位于内盖夫、处于犹大南界的一座城镇；尤与以色列北界的但连用以指代全以色列。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Beyersheba (a Negeb)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a Negeb, a kan iyakar kudu ta Yahuda; ana amfani da shi musamman tare da Dan a kan iyakar arewa ta Isra'ila don nufin dukan Isra'ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "बेर्शेबा (नेगेव में)",
      "descriptions": [
        {
          "source": "acai",
          "description": "नेगेव में यहूदा की दक्षिणी सीमा पर स्थित एक नगर; विशेष रूप से इस्राएल की उत्तरी सीमा पर दान के साथ मिलकर समस्त इस्राएल को संदर्भित करने के लिए उपयोग किया जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Bersyeba (di Negeb)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota yang terletak di Negeb, di perbatasan selatan Yehuda; terutama digunakan dalam ungkapan bersama Dan di perbatasan utara Israel untuk merujuk pada seluruh wilayah Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Berseba (no Neguebe)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade localizada no Neguebe, na fronteira sul de Judá; usada especialmente em combinação com Dã, na fronteira norte de Israel, para se referir a todo o Israel."
        }
      ]
    },
    "spa": {
      "preferred_label": "Beerseba (en el Néguev)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad situada en el Néguev, en la frontera sur de Judá; utilizada especialmente en combinación con Dan, en la frontera norte de Israel, para referirse a todo Israel."
        }
      ]
    },
    "swh": {
      "preferred_label": "Beer-sheba (katika Negebu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko Negebu, kwenye mpaka wa kusini wa Yuda; uliotumiwa hasa pamoja na Dani kwenye mpaka wa kaskazini wa Israeli kurejelea Israeli yote."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Berseba (long Negev)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun i stap long Negev, long saut mak bilong Juda; ol i save yusim wantaim Dan long not mak bilong Israel bilong makim olgeta hap bilong Israel."
        }
      ]
    },
    "apd": {
      "preferred_label": "بئر سبع (في النقب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في النقب على الحد الجنوبي ليهوذا؛ كانت بتُذكر خصوصاً مع دان على الحد الشمالي لإسرائيل عشان تشير لكل إسرائيل."
        }
      ]
    },
    "arb": {
      "preferred_label": "بِئْر سَبْع (في النقب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة تقع في النقب عند حدود يهوذا الجنوبية؛ وتُستخدم خاصة بالاقتران مع دان عند حدود إسرائيل الشمالية للإشارة إلى كل إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bereseba (long Negif)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon we i stap long Negif, long saut boda blong Juda; we oli yusum espeseli wetem Dan long not boda blong Isrel blong minim olgeta Isrel evriwan."
        }
      ]
    },
    "fra": {
      "preferred_label": "Beer-Schéba (dans le Néguev)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville située dans le Néguev, à la frontière sud de Juda ; employée particulièrement avec Dan à la frontière nord d'Israël pour désigner tout Israël."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Bịasheba (dị na Neghev)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na Neghev, nʼókè ndịda nke Juda; a na-ejikarị ya na Dan nke dị nʼókè ugwu nke Izrel eme ihe iji rụtụ aka nʼIzrel dum."
        }
      ]
    },
    "nep": {
      "preferred_label": "बेर्शेबा (नेगेभमा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "नेगेभमा यहूदाको दक्षिणी सिमानामा अवस्थित एउटा सहर; इस्राएलको उत्तरी सिमानामा रहेको दानसँग मिलेर समग्र इस्राएललाई बुझाउन विशेष रूपमा प्रयोग गरिन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Вирсавия (в Негеве)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город, расположенный в Негеве, на южной границе Иудеи; часто упоминается вместе с Даном на северной границе Израиля для обозначения всей земли Израильской."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bê-e-sê-ba (ở Nê-gép)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn nằm ở vùng Nê-gép, tại biên giới phía nam của Giu-đa; đặc biệt thường được dùng kết hợp với Đan ở biên giới phía bắc của Ít-ra-ên để chỉ toàn bộ lãnh thổ Ít-ra-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "別是巴（在內革夫）",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於內革夫、猶大南部邊界的一座城鎮；常與以色列北部邊界的但並稱，用以指全以色列。"
        }
      ]
    }
  },
