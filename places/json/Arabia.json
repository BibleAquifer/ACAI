  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Arabia",
      "alternate_labels": [
        "Arabians",
        "Arab",
        "Arabian",
        "Arbite",
        "Arabs"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Arabia.1",
          "gloss": "Arabia",
          "description": "A peninsula located east and south-east of Israel, consisting primarily of steppe and desert and inhabited by nomadic tribes."
        }
      ]
    },
    "arb": {
      "preferred_label": "بِلَادُ ٱلْعَرَبِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "شبه جزيرة تقع إلى الشرق والجنوب الشرقي من إسرائيل، تتكون أساسًا من السهوب والصحراء ويسكنها قبائل رُحَّل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "阿拉伯",
      "descriptions": [
        {
          "source": "acai",
          "description": "位于以色列东部和东南部的半岛，主要由干草原和沙漠组成，由游牧部落居住。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Arabie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une péninsule située à l'est et au sud-est d'Israël, principalement composée de steppes et de déserts et habitée par des tribus nomades."
        }
      ]
    },
    "hau": {
      "preferred_label": "Arabiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yankin da yake gabas da kudu maso gabashin Isra'ila, wanda ya ƙunshi ciyayi da hamada kuma ƙabilu makiyaya suke zaune a ciki."
        }
      ]
    },
    "hin": {
      "preferred_label": "अरब",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएल के पूर्व और दक्षिण-पूर्व में स्थित एक प्रायद्वीप, जिसमें मुख्यतः स्तेपी और मरुस्थल शामिल हैं और जहाँ घुमंतू जातियाँ निवास करती थीं।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Arabia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Semenanjung yang terletak di sebelah timur dan tenggara Israel, yang sebagian besar terdiri dari stepa dan padang gurun serta dihuni oleh suku-suku pengembara."
        }
      ]
    },
    "por": {
      "preferred_label": "Arábia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma península localizada a leste e a sudeste de Israel, consistindo principalmente de estepe e deserto e habitada por tribos nômades."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аравия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Полуостров, расположенный к востоку и юго-востоку от Израиля, состоящий в основном из степей и пустынь и населенный кочевыми племенами."
        }
      ]
    },
    "spa": {
      "preferred_label": "Arabia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una península situada al este y sureste de Israel, formada principalmente por estepas y desiertos, y habitada por tribus nómadas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Arabia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rasi iliyo mashariki na kusini-mashariki mwa Israeli, yenye mbuga na jangwa hasa, na iliyokaliwa na makabila ya kuhamahama."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Arebia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela peninsila i stap long hap is na saut-is bilong Israel, em i gat bikpela hap gras na ples drai nating na ol lain i save raun olsem ol nomat i stap long en."
        }
      ]
    },
    "apd": {
      "preferred_label": "بلاد العرب",
      "descriptions": [
        {
          "source": "acai",
          "description": "شبه جزيرة واقعة شرق وجنوب شرق إسرائيل، أغلبها سهوب وصحراء وسكنتها قبائل بدوية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Arebia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan peninjula we i stap long is mo saot-is blong Isrel, we i fulap long draeples mo ol laen we oli no gat pomanen ples i stap laef long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Arebịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọkara agwaetiti dị nʼakụkụ ọwụwa anyanwụ na ndịda ọwụwa anyanwụ Israel, nke nwere ala ahịhịa na ọzara, ebe ebo ndị na-akwagharị akwagharị bi."
        }
      ]
    },
    "nep": {
      "preferred_label": "अरब",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलको पूर्व र दक्षिण-पूर्वमा अवस्थित प्रायद्वीप, जसमा मुख्यतया घाँसे मैदान र मरुभूमि पर्दछ र जहाँ फिरन्ते जातिहरू बसोबास गर्दथे।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-rập",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một bán đảo nằm ở phía đông và đông nam Y-sơ-ra-ên, chủ yếu bao gồm thảo nguyên và sa mạc, là nơi sinh sống của các bộ tộc du mục."
        }
      ]
    },
    "zht": {
      "preferred_label": "阿拉伯",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於以色列以東和東南方的半島，主要由乾草原和沙漠組成，居住著遊牧部落。"
        }
      ]
    }
  },
