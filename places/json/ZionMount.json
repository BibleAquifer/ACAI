  "localizations": {
    "eng": {
      "preferred_label": "MountZion",
      "alternate_labels": [
        "Sion",
        "mountain of Yahweh",
        "Temple Mount",
        "mountain of the house of the Lord",
        "Zion",
        "Jerusalem",
        "mountain of Zion",
        "mountain of the Lord’s temple",
        "heights where the Temple now stands",
        "mountain Zion",
