      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:MountZion",
          "gloss": "MountZion",
          "description": "A hill in Jerusalem where the temple was built; also the location of the fortification known as the City of David (2 Samuel 6:7)."
        }
      ]
    },
    "fra": {
      "preferred_label": "mont Sion",
      "descriptions": [
        {
          "source": "acai",
          "description": "Colline de Jérusalem où le temple fut bâti ; également l'emplacement de la fortification connue sous le nom de cité de David (2 Samuel 6:7)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Monte Sion",
      "descriptions": [
        {
          "source": "acai",
          "description": "Colina de Jerusalén donde se construyó el templo; también el lugar de la fortaleza conocida como la Ciudad de David (2 Samuel 6:7)."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَبَلُ صِهْيَوْنَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "تلة في أورشليم حيث بُني الهيكل؛ وكانت أيضًا موقع الحصن المعروف بمدينة داود (2 صموئيل 5: 7)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dutsen Sihiyona",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani tudu a Urushalima inda aka gina haikali; kuma shi ne wurin da sansanin nan da aka sani da Birnin Dawuda yake (2 Sama’ila 6:7)."
        }
      ]
    },
    "ind": {
      "preferred_label": "Gunung Sion",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah bukit di Yerusalem tempat bait suci dibangun; juga lokasi benteng yang dikenal sebagai Kota Daud (2 Samuel 6:7)."
        }
      ]
    },
    "por": {
      "preferred_label": "Monte Sião",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma colina em Jerusalém onde o templo foi construído; também o local da fortificação conhecida como a Cidade de Davi (2 Samuel 5:7)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mlima Sayuni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kilima huko Yerusalemu ambapo hekalu lilijengwa; pia ni eneo la ngome inayojulikana kama Mji wa Daudi (2 Samweli 6:7)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Maunten Saion",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela maunten long Jerusalem em haus bilong Bikpela i bin sanap long en; na tu em i ples bilong dispela taun i gat strongpela banis ol i kolim Taun bilong Devit (2 Samuel 6:7)."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبل صهيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "تلة في أورشليم اتبنى فيها الهيكل؛ وكمان هي مكان الحصن المعروف بمدينة داود."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hil ya Saeon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hil long Jerusalem we oli bin bildimap tempol long hem; mo hem i ples tu we strong ples blong haed we nem blong hem Taon blong Deved i bin stap long hem (2 Samuel 6:7)."
        }
      ]
    },
    "hin": {
      "preferred_label": "सिय्योन पर्वत",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेम की एक पहाड़ी जहाँ मंदिर बनाया गया था; दाऊदपुर के नाम से जाने जाने वाले गढ़ का स्थान भी (2 शमूएल 6:7)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ugwu Zayọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ugwu nta dị na Jerusalem ebe e wuru ụlọ nsọ; ọ bụkwa ebe ahụ e wusiri ike nke a maara dịka Obodo Devid (2 Samuel 6:7)."
        }
      ]
    },
    "nep": {
      "preferred_label": "सियोन पर्वत",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेमको एउटा डाँडा जहाँ मन्दिर निर्माण गरिएको थियो; दाऊदको सहर भनेर चिनिने किल्लाको स्थान पनि (२ शमूएल ५:७)।"
        }
      ]
    },
    "rus": {
      "preferred_label": "гора Сион",
      "descriptions": [
        {
          "source": "acai",
          "description": "Холм в Иерусалиме, где был построен храм; также место укрепления, известного как Город Давидов (2 Царств 5:7)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Núi Si-ôn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ngọn đồi ở Giê-ru-sa-lem nơi đền thờ được xây cất; cũng là nơi có pháo đài được biết đến là Thành Đa-vít (2 Sa-mu-ên 6:7)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "锡安山",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷的一座山丘，圣殿建于其上；也是被称为大卫城的堡垒所在地（撒母耳记下 6:7）。"
        }
      ]
    },
    "zht": {
      "preferred_label": "錫安山",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷境內建造聖殿的山丘；也是被稱為大衛城的堡壘所在地（撒母耳記下 6:7）。"
        }
      ]
    }
  },
