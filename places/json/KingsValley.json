  "localizations": {
    "eng": {
      "preferred_label": "King’s Valley",
      "alternate_labels": [
        "Valley of the King",
        "Valley of Shaveh",
        "king's dale",
        "King's Valley"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:KingsValley",
          "gloss": "King’s Valley",
          "description": "A valley near Salem where Abraham met Melchizedek (Genesis 14:17); also known as the valley of Shaveh."
        }
      ]
    },
    "arb": {
      "preferred_label": "عُمْقُ ٱلْمَلِكِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادٍ بالقرب من شاليم التقى فيه إبراهيم بملكي صادق (تكوين 14: 17)؛ يُعرف أيضاً بعمق شوى."
        }
      ]
    },
    "zhs": {
      "preferred_label": "王谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "撒冷附近的一座山谷，亚伯拉罕在此遇见麦基洗德（创世记 14:17）；又名沙微谷。"
        }
      ]
    },
    "fra": {
      "preferred_label": "vallée du roi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vallée près de Salem où Abraham rencontra Melchisédek (Genèse 14.17) ; aussi appelée la vallée de Schavé."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwarin Sarki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kwari ne kusa da Salem inda Ibrahim ya sadu da Malkisadak (Farawa 14:17); an kuma san shi da Kwarin Shabe."
        }
      ]
    },
    "ind": {
      "preferred_label": "Lembah Raja",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah lembah dekat Salem tempat Abraham bertemu Melkisedek (Kejadian 14:17); juga dikenal sebagai lembah Syawe."
        }
      ]
    },
    "spa": {
      "preferred_label": "Valle del Rey",
      "descriptions": [
        {
          "source": "acai",
          "description": "Valle cerca de Salem donde Abraham se encontró con Melquisedec (Génesis 14:17); también conocido como el valle de Save."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bonde la Mfalme",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bonde karibu na Salemu ambapo Abrahamu alikutana na Melkizedeki (Mwanzo 14:17); pia linajulikana kama bonde la Shawe."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples Daun Bilong King",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples daun klostu long Salem we Abraham i bin bungim Melkisedek (Stat 14:17); ol i save kolim tu olsem ples daun bilong Save."
        }
      ]
    },
    "apd": {
      "preferred_label": "وادي الملك",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادي قريب من ساليم محل ما قابل إبراهيم ملكي صادق (تكوين 14: 17)؛ ومعروف كمان بوادي شوى."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ples blong King",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan valea klosap long Salem we Ebraham i mitim Melkisedek long hem (Jenesis 14:17); we oli save tu olsem Valea blong Save."
        }
      ]
    },
    "hin": {
      "preferred_label": "राजा की तराई",
      "descriptions": [
        {
          "source": "acai",
          "description": "शालेम के पास स्थित एक तराई जहाँ इब्राहीम मल्कीसेदेक से मिला था (उत्पत्ति 14:17); इसे शावे की तराई भी कहा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndagwurugwu Eze",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndagwurugwu dị nso na Selem ebe Ebraham zutere Melkizedek (Jenesis 14:17); nke a makwaara dị ka ndagwurugwu Shave."
        }
      ]
    },
    "nep": {
      "preferred_label": "राजाको उपत्यका",
      "descriptions": [
        {
          "source": "acai",
          "description": "शालेम नजिकैको एउटा उपत्यका जहाँ अब्राहामले मल्कीसेदेकलाई भेटेका थिए (उत्पत्ति १४:१७); यसलाई शावेको उपत्यका पनि भनिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "Vale do Rei",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um vale perto de Salém onde Abraão se encontrou com Melquisedeque (Gênesis 14:17); também conhecido como o Vale de Savé."
        }
      ]
    },
    "rus": {
      "preferred_label": "Царская долина",
      "descriptions": [
        {
          "source": "acai",
          "description": "Долина близ Салима, где Авраам встретил Мелхиседека (Бытие 14:17); также известная как долина Шаве."
        }
      ]
    },
    "vie": {
      "preferred_label": "Trũng Vua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thung lũng gần Sa-lem nơi Áp-ra-ham đã gặp Mên-chi-xê-đéc (Sáng Thế Ký 14:17); còn được gọi là trũng Sa-ve."
        }
      ]
    },
    "zht": {
      "preferred_label": "王谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "撒冷附近的一處山谷，亞伯拉罕曾在此遇見麥基洗德（創世記 14:17）；又稱為沙微谷。"
        }
      ]
    }
  },
