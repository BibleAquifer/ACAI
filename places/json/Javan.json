        }
      ]
    },
    "hau": {
      "preferred_label": "Yaban",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata al'umma da galibi ake ɗauka a matsayin Girka; ana ɗaukar su a matsayin zuriyar Yafet ta wurin ɗansa Yaban."
        }
      ]
    },
    "hin": {
      "preferred_label": "यावान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक राष्ट्र जिसकी पहचान सामान्यतः यूनान से की जाती है; जिसे येपेत के पुत्र यावान के वंशज माना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yawan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah bangsa yang biasanya diidentifikasikan dengan Yunani; dianggap sebagai keturunan Yafet melalui anaknya, Yawan."
        }
      ]
    },
    "por": {
      "preferred_label": "Javã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma nação geralmente identificada com a Grécia; considerada descendente de Jafé por meio de seu filho Javã."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иаван",
      "descriptions": [
        {
          "source": "acai",
          "description": "Народ или страна, обычно отождествляемая с Грецией; потомки Иафета через его сына Иавана."
        }
      ]
    },
    "spa": {
      "preferred_label": "Javán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nación comúnmente identificada con Grecia; considerada descendiente de Jafet a través de su hijo Javán."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uyunani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taifa linalotambuliwa kwa kawaida kuwa Ugiriki; linalochukuliwa kuwa wazao wa Yafethi kupitia mwanawe Yavani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Javan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kantri planti man i ting em i Grik; ol i ting ol manmeri bilong en i ol tumbuna pikinini bilong Jafet long pikinini man bilong en Javan."
        }
      ]
    },
    "apd": {
      "preferred_label": "ياوان",
      "descriptions": [
        {
          "source": "acai",
          "description": "أمة عادة ما تُعرَف باليونان؛ اعتُبروا من نسل يافث عن طريق ابنه ياوان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Javan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan neson we plante taem oli ting se hem i Gris; oli luk olgeta olsem ol laen blong Jafet tru long pikinini man blong hem Javan."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Javan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mba a na-ejikarị mara Gris; a na-ewere ha dị ka ụmụ Jafet site nʼaka nwa ya nwoke bụ Javan."
        }
      ]
    },
    "nep": {
      "preferred_label": "यावान",
      "descriptions": [
        {
          "source": "acai",
          "description": "सामान्यतया युनान (ग्रीस) सँग पहिचान गरिने एक जाति वा देश; येपेतका छोरा यावानका सन्तान मानिन्छन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Gia-van",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một quốc gia thường được đồng nhất với Hy Lạp; được xem là hậu duệ của Gia-phết qua con trai ông là Gia-van."
        }
      ]
    },
    "zht": {
      "preferred_label": "雅完",
      "descriptions": [
        {
