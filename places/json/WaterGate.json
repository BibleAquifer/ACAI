  "localizations": {
    "eng": {
      "preferred_label": "Water Gate",
      "alternate_labels": [
        "Water",
        " Gate"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:WaterGate",
          "gloss": "Water Gate",
          "description": "An eastern gate in Jerusalem where Ezra read the Law before the returned exiles (Nehemiah 8:1–3)."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَاب المَاء",
      "descriptions": [
        {
          "source": "acai",
          "description": "باب شرقي في أورشليم قرأ عنده عزرا الشريعة أمام العائدين من السبي (نحميا 8: 1-3)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "水门",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷的一座东门，以斯拉曾在此处向回归的流亡民众宣读律法（尼希米记 8:1–3）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "porte des eaux",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une porte orientale de Jérusalem où Esdras lut la Loi devant les exilés de retour (Néhémie 8.1-3)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙofar Ruwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙofa ta gabas a Urushalima inda Ezra ya karanta Dokar a gaban waɗanda suka dawo daga zaman bauta (Nehemiya 8:1–3)."
        }
      ]
    },
    "hin": {
      "preferred_label": "जलफाटक",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेम का एक पूर्वी फाटक जहाँ एज्रा ने लौटे हुए बंधुओं के सामने व्यवस्था का पाठ किया था (नहेमायाह 8:1–3)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Pintu Gerbang Air",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah pintu gerbang timur di Yerusalem tempat Ezra membacakan Kitab Taurat di depan orang-orang buangan yang telah kembali (Nehemia 8:1–3)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Puerta de las Aguas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Puerta oriental de Jerusalén donde Esdras leyó la Ley ante los exiliados que habían regresado (Nehemías 8:1-3)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Lango la Maji",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lango la upande wa mashariki huko Yerusalemu ambapo Ezra alisoma Sheria mbele ya wahamishwa waliorudi (Nehemia 8:1–3)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Dua Bilong Kisim Wara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela dua bilong taun long hap sankamap bilong Jerusalem, em hap Esra i bin ritim Lo long ai bilong ol manmeri i bin lusim kalap na i kam bek (Nehemia 8:1–3)."
        }
      ]
    },
    "apd": {
      "preferred_label": "باب الموية",
      "descriptions": [
        {
          "source": "acai",
          "description": "بوابة شرقية في أورشليم قرا عندها عزرا الشريعة قدام الناس الراجعين من السبي (نحميا 8: 1–3)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Doa blong Wota",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan geit long saed i go long is long Jerusalem we Esra i bin ridim Loa long fes blong ol man we oli aot long kalabus oli kamtru bakegen (Nehemaea 8:1–3)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọnụ Ụzọ Ámá Mmiri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọnụ ụzọ ámá dị n'akụkụ ọwụwa anyanwụ na Jerusalem ebe Ezra gụrụ Iwu ahụ n'ihu ndị si na ndọrọ n'agha lọta (Nehemaya 8:1–3)."
        }
      ]
    },
    "nep": {
      "preferred_label": "पानी ढोका",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेमको एक पूर्वी ढोका जहाँ एज्राले निर्वासनबाट फर्केकाहरूका सामु व्यवस्था पढेर सुनाए (नहेम्याह ८:१–३)।"
        }
      ]
    },
    "por": {
      "preferred_label": "Porta das Águas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma porta oriental em Jerusalém onde Esdras leu a Lei diante dos exilados que haviam retornado (Neemias 8:1–3)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Водяные ворота",
      "descriptions": [
        {
          "source": "acai",
          "description": "Восточные ворота в Иерусалиме, у которых Ездра читал Закон перед вернувшимися изгнанниками (Неемия 8:1–3)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cổng Nước",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cổng phía đông ở Giê-ru-sa-lem, nơi Ê-xơ-ra đã đọc Luật pháp trước những người lưu đày trở về (Nê-hê-mi 8:1–3)."
        }
      ]
    },
    "zht": {
      "preferred_label": "水門",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷的一座東門，以斯拉曾在那裡向歸回的被擄之民宣讀律法書（尼希米記 8:1–3）。"
        }
      ]
    }
  },
