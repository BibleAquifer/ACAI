      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Harosheth-hagoyim",
          "gloss": "Harosheth-Hagoyim",
          "description": "A town north of Israel; residence of Sisera, army commander of Jabin, king of Hazor (Judges 4:2)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Haroscheth-Goïm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ville du nord d'Israël ; résidence de Sisera, chef de l'armée de Jabin, roi de Hatsor (Juges 4:2)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jaroset Goyim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo al norte de Israel; residencia de Sísara, jefe del ejército de Jabín, rey de Jazor (Jueces 4:2)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "夏罗设·哈歌印",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列以北的一座城镇；夏琐王耶宾的军队统帅西西拉的住处（士师记 4:2）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Haroshet Haggoyim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gari ne a arewacin Isra'ila; wurin zama na Sisera, shugaban rundunar sojojin Yabin, sarkin Hazor (Alƙalawa 4:2)."
        }
      ]
    },
    "hin": {
      "preferred_label": "अन्यजातियों का हरोशेत",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएल के उत्तर में एक नगर; हासोर के राजा याबीन के सेनापति सीसरा का निवास स्थान (न्यायियों 4:2)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Haroset-Hagoyim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di sebelah utara Israel; tempat tinggal Sisera, panglima tentara Yabin, raja Hazor (Hakim-hakim 4:2)."
        }
      ]
    },
    "por": {
      "preferred_label": "Harosete-Hagoim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade ao norte de Israel; residência de Sísera, comandante do exército de Jabim, rei de Hazor (Juízes 4:2)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Haroshethi-Hagoyimu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko kaskazini mwa Israeli; makazi ya Sisera, jemadari wa jeshi la Yabini mfalme wa Hazori (Waamuzi 4:2)."
        }
      ]
    },
    "apd": {
      "preferred_label": "حروشة الأمم",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة شمال إسرائيل، كانت مقر سيسرا قائد جيش يابين ملك حاصور (قضاة 4: 2)."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَرُوشَةُ الأُمَمِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة شمالي إسرائيل؛ مقر سكنى سيسرا قائد جيش يابين ملك حاصور (قضاة 4: 2)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Haroset",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long not blong Isrel; ples we Sisera, komanda blong ol soldia blong Jabin, king blong Hajoro, i stap long hem (Jajes 4:2)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Haroshet Hagoyim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nʼugwu Izrel; ebe obibi Sisera, bụ́ onyeisi usuu ndị agha Jabin, eze Hazọ (Ndị Ikpe 4:2)."
        }
      ]
    },
    "nep": {
      "preferred_label": "हरोशेत हग्गोयिम",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलको उत्तरमा रहेको एउटा सहर; हासोरका राजा याबीनका सेनापति सीसराको बसोबास स्थान (न्यायकर्ता ४:२)।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Харошеф-Гоим",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город к северу от Израиля; место пребывания Сисары, военачальника Иавина, царя Асорского (Судей 4:2)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Haroset Hagoim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long hap not bilong Israel; em ples bilong Sisera, komanda bilong ami bilong Jabin, king bilong Hasor (Hetman 4:2)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-rô-sết Ha-gô-im",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn ở phía bắc Y-sơ-ra-ên; nơi ở của Si-sê-ra, quan tổng binh của Gia-bin, vua Hát-so (Các Quan Xét 4:2)."
        }
      ]
    },
    "zht": {
      "preferred_label": "外邦人的夏羅設",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列以北的一座城鎮；夏瑣王耶賓的將軍西西拉的住所（士師記 4:2）。"
        }
      ]
    }
  },
