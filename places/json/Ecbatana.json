          "gloss": "Ecbatana",
          "description": "The capital city of the province of Media, where a scroll containing the decrees of King Darius were found (Ezra 6)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Ecbatane",
      "descriptions": [
        {
          "source": "acai",
          "description": "Capitale de la province de Médie, où un rouleau contenant les décrets du roi Darius a été retrouvé (Esdras 6)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ecbatana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad capital de la provincia de Media, donde se encontró un rollo que contenía los decretos del rey Darío (Esdras 6)."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَحْمَثَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "العاصمة لإقليم مادي، حيث عُثر على درج يحتوي على مرسوم الملك داريوس (عزرا 6)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚马他",
      "descriptions": [
        {
          "source": "acai",
          "description": "米底亚省的首府，在此发现了载有大流士王法令的书卷（以斯拉记 6章）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ekbatana",
      "descriptions": [
        {
          "source": "acai",
