        }
      ]
    },
    "ind": {
      "preferred_label": "Ahmeta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ibu kota provinsi Media, tempat ditemukannya sebuah gulungan berisi ketetapan-ketetapan Raja Darius (Ezra 6)."
        }
      ]
    },
    "por": {
      "preferred_label": "Ecbatana",
      "descriptions": [
        {
          "source": "acai",
          "description": "A capital da província da Média, onde foi encontrado um rolo com os decretos do rei Dario (Esdras 6)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Екбатана",
      "descriptions": [
        {
          "source": "acai",
          "description": "Столица провинции Мидия, где был найден свиток с указом царя Дария (Ездра 6)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ekbatana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji mkuu wa jimbo la Umedi, ambapo gombo lenye maagizo ya Mfalme Dario lilipatikana (Ezra 6)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ekbatana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Biktaun bilong provins Midia, em ples ol i bin painim wanpela skrol i gat tok bilong King Darius long en (Esra 6)."
        }
      ]
    },
    "apd": {
      "preferred_label": "أحمثا",
      "descriptions": [
        {
          "source": "acai",
          "description": "العاصمة بتاعة إقليم مادي، وين لقوا درج مكتوب فيه قرارات الملك داريوس (عزرا 6)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ekbatana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kaptel taon blong provins ya Media, we oli faenem wan skrol wetem ol oda blong King Darius long hem (Esra 6)."
        }
      ]
    },
    "hin": {
      "preferred_label": "अहमता",
      "descriptions": [
        {
          "source": "acai",
          "description": "मादी प्रान्त की राजधानी, जहाँ राजा दारा के आदेशों वाला एक ग्रंथ-पत्र मिला था (एज्रा 6)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ekbatana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Isi obodo nke ógbè Midia, ebe a chọtara akwụkwọ mpịakọta nwere iwu Eze Darayọs (Ezra 6)."
        }
      ]
    },
    "nep": {
      "preferred_label": "एक्बातान",
      "descriptions": [
        {
          "source": "acai",
          "description": "मादी प्रान्तको राजधानी सहर, जहाँ राजा दाराको आदेश भएको मुट्ठो भेट्टाइएको थियो (एज्रा ६)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Éc-ba-tan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kinh đô của tỉnh Mê-đi, nơi tìm thấy một cuộn sách chứa các chiếu chỉ của Vua Đa-ri-út (Ê-xơ-ra 6)."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞馬他",
      "descriptions": [
        {
          "source": "acai",
          "description": "米底亞省的首府，在此尋獲記載大利烏王諭令的書卷（以斯拉記 6章）。"
        }
      ]
    }
  },
