          "source": "acai",
          "article": "place:Gebal.1",
          "gloss": "Gebal (Byblos)",
          "description": "A town in Phoenicia, north of Israel, and functioning as the seaport of the major city of Byblos, which used to trade with Tyre."
        }
      ]
    },
    "arb": {
      "preferred_label": "جُبَيْل",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في فينيقية، شمال إسرائيل، وكانت ميناء بحرياً لمدينة جبيل الرئيسية التي تاجرت مع صور."
        }
      ]
    },
    "zhs": {
      "preferred_label": "迦巴勒 (比布鲁斯)",
      "descriptions": [
        {
          "source": "acai",
          "description": "腓尼基境内、以色列以北的一座城镇，作为主要城市比布鲁斯（曾与泰尔通商）的海港。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Guébal (Byblos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville de Phénicie, au nord d'Israël, servant de port maritime à la ville majeure de Byblos, qui commerçait avec Tyr."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gebal (Byblos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari ne a Funisiya, arewacin Isra'ila, wanda ya kasance tashar jiragen ruwa ta babban birnin Byblos, wanda ya saba kasuwanci da Taya."
        }
      ]
    },
    "hin": {
      "preferred_label": "गबल (बिब्लोस)",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएल के उत्तर में, फीनीके का एक नगर, जो बिब्लोस के प्रमुख नगर के बंदरगाह के रूप में कार्य करता था और सोर के साथ व्यापार करता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gebal (Biblos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di Fenisia, sebelah utara Israel, dan berfungsi sebagai pelabuhan kota besar Biblos, yang biasa berdagang dengan Tirus."
        }
      ]
    },
    "por": {
      "preferred_label": "Gebal (Biblos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade na Fenícia, ao norte de Israel, que funcionava como o porto marítimo da importante cidade de Biblos, a qual costumava comerciar com Tiro."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гевал (Библ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в Финикии, к северу от Израиля, служивший морским портом крупного города Библ и торговавший с Тиром."
        }
      ]
    },
    "spa": {
      "preferred_label": "Gebal (Biblos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad en Fenicia, al norte de Israel, que funcionaba como puerto marítimo de la importante ciudad de Biblos, la cual solía comerciar con Tiro."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gebali (Biblo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko Foinike, kaskazini mwa Israeli, uliotumika kama bandari ya mji mkuu wa Biblo, uliofanya biashara na Tiro."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gebal (Biblos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Fonisia, long not bilong Israel, na em i olsem wof o pasis bilong bikpela taun Biblos, em taun i bin save mekim bisnis wantaim Tair."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبال (بيبلوس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في فينيقية، شمال إسرائيل، وكانت شغالة كـ ميناء بحري لمدينة بيبلوس الكبيرة، الكانت بتتاجر مع صور."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gebal (Biblos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Fonisia, long not blong Isrel, we i bin stap olsem wan pot blong bigfala taon ya Biblos, we i stap mekem bisnes wetem Taea."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gebal (Baịblọs)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo dị na Fonishia, nʼebe ugwu Izrel, nke na-arụ ọrụ dị ka ọdụ ụgbọ mmiri nke nnukwu obodo Baịblọs (Byblos), nke na-azụbu ahịa na Taya."
        }
      ]
    },
    "nep": {
      "preferred_label": "गबाल (बब्लोस)",
      "descriptions": [
        {
          "source": "acai",
          "description": "टुरोससँग व्यापार गर्ने बब्लोस भन्ने मुख्य सहरको समुद्री बन्दरगाहको रूपमा काम गर्ने, इस्राएलको उत्तरमा फिनीकेको एउटा सहर।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ghê-ban (Byblos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn ở Phê-ni-xi, phía bắc Y-sơ-ra-ên, từng là cảng biển của thành phố lớn Byblos, nơi buôn bán với Ty-rơ."
        }
      ]
    },
    "zht": {
      "preferred_label": "迦巴勒 (比布魯斯)",
      "descriptions": [
        {
          "source": "acai",
          "description": "腓尼基境內、以色列以北的一座城鎮，為大城比布魯斯（Byblos）的海港，曾與泰爾進行貿易。"
        }
      ]
    }
  },
