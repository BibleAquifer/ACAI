        }
      ]
    },
    "spa": {
      "preferred_label": "Encina de Tabor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Árbol donde Saúl se encontró con tres hombres poco después de haber sido ungido como rey."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwaloni wa Tabori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mti ambapo Sauli alikutana na wanaume watatu muda mfupi baada ya kutiwa mafuta kuwa mfalme."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Diwai bilong Tabor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela diwai we Sol i bungim tripela man liklik taim bihain long ol i welim em bilong kamap king."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây sồi Tha-bô",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cây sồi nơi Sau-lơ gặp ba người đàn ông không lâu sau khi được xức dầu làm vua."
        }
      ]
    },
