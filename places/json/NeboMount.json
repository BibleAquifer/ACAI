  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Mount Nebo",
      "alternate_labels": [
        "Abarim",
        "Nebo"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:MountNebo",
          "gloss": "Mount Nebo",
          "description": "A mountain in Moab, near Jericho, where Moses had a view of the promised land before he died (Deuteronomy 34:1–4)."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَبَلُ نَبو",
      "descriptions": [
        {
          "source": "acai",
          "description": "جَبَلٌ في موآبَ قُرْبَ أَرِيحَا، حَيْثُ رَأَى موسَى أَرْضَ المَوْعِدِ قَبْلَ أَنْ يَموتَ (تَثْنِيَة ٣٤: ١–٤)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "尼波山",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩押境内、靠近耶利哥的一座山，摩西死前曾在此眺望应许之地（申命记 34:1–4）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "mont Nebo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une montagne en Moab, près de Jéricho, d'où Moïse a contemplé la terre promise avant de mourir (Deutéronome 34.1–4)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dutsen Nebo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani dutse a Mowab, kusa da Yeriko, inda Musa ya hangi ƙasar alkawari kafin ya mutu (Maimaitawar Shari’a 34:1–4)."
        }
      ]
    },
    "hin": {
      "preferred_label": "नबो पर्वत",
      "descriptions": [
        {
          "source": "acai",
          "description": "मोआब में यरीहो के निकट एक पहाड़, जहाँ से मूसा ने अपनी मृत्यु से पहले प्रतिज्ञात देश को देखा था (व्यवस्थाविवरण 34:1–4)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gunung Nebo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah gunung di Moab, dekat Yerikho, tempat Musa memandang tanah perjanjian sebelum ia mati (Ulangan 34:1–4)."
        }
      ]
    },
    "por": {
      "preferred_label": "Monte Nebo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma montanha em Moabe, perto de Jericó, de onde Moisés avistou a terra prometida antes de morrer (Deuteronômio 34:1–4)."
        }
      ]
    },
    "spa": {
      "preferred_label": "monte Nebo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Monte en Moab, cerca de Jericó, donde Moisés contempló la tierra prometida antes de morir (Deuteronomio 34:1–4)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mlima Nebo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mlima katika Moabu, karibu na Yeriko, ambapo Mose aliona nchi ya ahadi kabla hajafa (Kumbukumbu la Torati 34:1–4)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Maunten Nebo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela maunten long Moap, klostu long Jeriko, em ples Moses i bin lukim graun bilong promis bipo em i dai (Lo 34:1–4)."
        }
      ]
    },
    "apd": {
      "preferred_label": "جبل نبو",
      "descriptions": [
        {
          "source": "acai",
          "description": "جبل في موآب، قريب من أريحا، محل ما موسى شاف أرض الموعد قبل ما يموت (تثنية 34: 1–4)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hil Neboho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hil long Moab, klosap long Jeriko, we Moses i bin luk promes lan long hem bifo hem i ded (Dutronome 34:1–4)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ugwu Nebo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ugwu dị na Moab, dị nso na Jeriko, ebe Mosis nọ lee anya nʼala ekwere na nkwa tupu ya anwụọ (Deuterọnọmi 34:1–4)."
        }
      ]
    },
    "nep": {
      "preferred_label": "नेबो डाँडा",
      "descriptions": [
        {
          "source": "acai",
          "description": "मोआबको यरीहो नजिकको एउटा डाँडा, जहाँबाट मोशाले आफ्नो मृत्यु हुनुअघि प्रतिज्ञा गरिएको देश हेरेका थिए (व्यवस्था ३४:१–४)।"
        }
      ]
    },
    "rus": {
      "preferred_label": "гора Нево",
      "descriptions": [
        {
          "source": "acai",
          "description": "Гора в Моаве, близ Иерихона, с которой Моисей обозревал обетованную землю перед смертью (Второзаконие 34:1–4)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Núi Nê-bô",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một ngọn núi ở Mô-áp, gần Giê-ri-cô, nơi Môi-se nhìn thấy xứ hứa trước khi qua đời (Phục truyền Luật lệ Ký 34:1–4)."
        }
      ]
    },
    "zht": {
      "preferred_label": "尼波山",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於摩押境內靠近耶利哥的一座山，摩西去世前曾在此眺望應許之地（申命記 34:1–4）。"
        }
      ]
    }
  },
