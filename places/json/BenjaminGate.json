      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:BenjaminGate",
          "gloss": "Benjamin Gate",
          "description": "A gate in the wall of Jerusalem through which the prophet Jeremiah tried to leave the city (Jer 37:12–13)."
        }
      ]
    },
    "fra": {
      "preferred_label": "porte de Benjamin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une porte dans le rempart de Jérusalem par laquelle le prophète Jérémie tenta de quitter la ville (Jr 37.12-13)."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَاب بِنْيَامِينَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "باب في سور أورشليم حاول النبي إرميا الخروج عبره من المدينة (إر 37: 12-13)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "便雅悯门",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷城墙上的一座门，先知耶利米曾试图通过此门出城（耶 37:12–13）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙofar Benyamin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙofa a bangon Urushalima wadda Annabi Irmiya ya yi ƙoƙarin fita ta cikinta daga birnin (Irm 37:12–13)."
        }
      ]
    },
    "ind": {
      "preferred_label": "Pintu Gerbang Benyamin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah pintu gerbang di tembok Yerusalem yang melaluinya nabi Yeremia berusaha meninggalkan kota itu (Yer 37:12–13)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Вениаминовы ворота",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ворота в стене Иерусалима, через которые пророк Иеремия пытался выйти из города (Иер 37:12–13)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Puerta de Benjamín",
      "descriptions": [
        {
          "source": "acai",
          "description": "Puerta en la muralla de Jerusalén por la cual el profeta Jeremías intentó salir de la ciudad (Jer 37:12-13)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Lango la Benyamini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lango katika ukuta wa Yerusalemu ambapo nabii Yeremia alijaribu kupitia akitoka mjini (Yer 37:12–13)."
        }
      ]
    },
    "apd": {
      "preferred_label": "بوابة بنيامين",
      "descriptions": [
        {
          "source": "acai",
          "description": "بوابة في سور أورشليم حاول النبي إرميا يمرق منها من المدينة (إرميا 37: 12-13)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Doa blong Benjamin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan get long stonwol blong Jerusalem we profet Jeremaea i bin traem aot long taon tru long hem (Jer 37:12–13)."
        }
      ]
    },
    "hin": {
      "preferred_label": "बिन्यामीन का फाटक",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेम की शहरपनाह का एक फाटक जिसके द्वारा यिर्मयाह भविष्यद्वक्ता ने नगर से बाहर जाने का प्रयास किया था (यिर्म. 37:12–13)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọnụ Ụzọ Ama Benjamin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọnụ ụzọ ama dị na mgbidi Jeruselem nke onye amụma bụ Jeremaya nwara isi na ya pụọ nʼobodo ahụ (Jer 37:12–13)."
        }
      ]
    },
    "nep": {
      "preferred_label": "बेन्यामीनको मूल ढोका",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरूशलेमको पर्खालको एउटा ढोका, जहाँबाट अगमवक्ता यर्मियाले सहर छोडेर जाने प्रयास गरेका थिए (यर्मिया ३७:१२–१३)।"
        }
      ]
    },
    "por": {
      "preferred_label": "Porta de Benjamim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma porta na muralha de Jerusalém pela qual o profeta Jeremias tentou sair da cidade (Jr 37:12–13)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Dua bilong Benjamin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela dua bilong banis bilong Jerusalem em profet Jeremaia i bin traim long lusim siti long en (Jer 37:12–13)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cổng Bên-gia-min",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một cổng trên tường thành Giê-ru-sa-lem nơi nhà tiên tri Giê-rê-mi đã cố gắng rời khỏi thành (Giê 37:12–13)."
        }
      ]
    },
    "zht": {
      "preferred_label": "便雅憫門",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶路撒冷城牆上的一座城門，先知耶利米曾試圖經由這座門出城（耶 37:12–13）。"
        }
      ]
    }
  },
