  "localizations": {
    "eng": {
      "preferred_label": "Antioch (of Syria)",
      "alternate_labels": [
        "Antioch (Syria)",
        "Antiochian",
        "Antioch"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Antioch.1",
          "gloss": "Antioch (of Syria)",
          "description": "The capital of the Roman province Syria, located on the Orontes River, where followers of Jesus were first called Christians."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَنْطَاكِيَة (سورية)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عاصمة المقاطعة الرومانية سورية، الواقعة على نهر العاصي، حيث دُعي تلاميذ يسوع مسيحيين أولًا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "安提阿 (叙利亚)",
      "descriptions": [
        {
          "source": "acai",
          "description": "罗马叙利亚省的首府，位于奥龙特斯河畔，耶稣的跟随者在那里最先被称为基督徒。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Antioche (de Syrie)",
      "descriptions": [
        {
          "source": "acai",
          "description": "La capitale de la province romaine de Syrie, située sur le fleuve Oronte, où les disciples de Jésus furent appelés chrétiens pour la première fois."
        }
      ]
    },
    "hau": {
      "preferred_label": "Antiyok (na Siriya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban birnin lardin Romawa na Siriya, wanda yake a Kogin Orontes, inda aka fara kiran mabiyan Yesu Kiristoci."
        }
      ]
    },
    "hin": {
      "preferred_label": "अन्ताकिया (सीरिया का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "रोमी प्रान्त सीरिया की राजधानी, जो ओरोन्तेस नदी पर स्थित थी, जहाँ यीशु के अनुयायी पहली बार मसीही कहलाए।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Antiokhia (di Siria)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ibu kota provinsi Romawi Siria, yang terletak di tepi Sungai Orontes, tempat para pengikut Yesus pertama kali disebut Kristen."
        }
      ]
    },
    "por": {
      "preferred_label": "Antioquia (da Síria)",
      "descriptions": [
        {
          "source": "acai",
          "description": "A capital da província romana da Síria, localizada junto ao rio Orontes, onde os seguidores de Jesus foram chamados de cristãos pela primeira vez."
        }
      ]
    },
    "rus": {
      "preferred_label": "Антиохия (Сирийская)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Столица римской провинции Сирия, расположенная на реке Оронт, где последователи Иисуса впервые стали называться христианами."
        }
      ]
    },
    "spa": {
      "preferred_label": "Antioquía (de Siria)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Capital de la provincia romana de Siria, situada sobre el río Orontes, donde a los seguidores de Jesús se les llamó cristianos por primera vez."
        }
      ]
    },
    "swh": {
      "preferred_label": "Antiokia (ya Shamu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji mkuu wa jimbo la Kirumi la Shamu, ulioko kando ya Mto Orontes, ambapo wafuasi wa Yesu waliitwa Wakristo kwa mara ya kwanza."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Antiok (bilong Siria)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nambawan taun bilong provins Siria bilong Rom, i stap long wara Orontes, em ples ol i bin kolim ol disaipel bilong Jisas long Kristen nambawan taim."
        }
      ]
    },
    "apd": {
      "preferred_label": "أنطاكية (سوريا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "عاصمة الولاية الرومانية سوريا، الواقعة على نهر العاصي، حيث سُمّي أتباع يسوع مسيحيين لأول مرة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Antiok (blong Siria)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kaptal taon blong provins blong Rom ya Siria, we i stap long Reva ya Orontes, we long ples ya nao oli fas singaot ol man we oli folem Jisas se ol Kristin."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Antiọk (nke Siria)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Isi obodo nke ógbè Rom bụ Siria, nke dị nʼakụkụ Osimiri Orontes, ebe e bu ụzọ kpọọ ndị na-eso ụzọ Jisọs Ndị Kraịst."
        }
      ]
    },
    "nep": {
      "preferred_label": "एन्टिओखिया (सिरियाको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ओरोन्टेस नदीको किनारमा अवस्थित रोमी प्रान्त सिरियाको राजधानी, जहाँ येशूका अनुयायीहरूलाई पहिलो पटक मसीही भनिएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "An-ti-ốt (thuộc Si-ri)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thủ phủ của tỉnh Si-ri thuộc La Mã, nằm bên bờ sông Ô-rôn-tết (Orontes), nơi các môn đồ của Chúa Giê-xu lần đầu tiên được gọi là Cơ Đốc nhân."
        }
      ]
    },
    "zht": {
      "preferred_label": "安提阿（敘利亞）",
      "descriptions": [
        {
          "source": "acai",
          "description": "羅馬敘利亞省的首府，位於奧龍特斯河畔，耶穌的門徒在那裡首次被稱為基督徒。"
        }
      ]
    }
  },
