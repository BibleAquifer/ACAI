  "localizations": {
    "eng": {
      "preferred_label": "Nobah (of Manasseh)",
      "alternate_labels": [
        "Kenath",
        "Nobah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Nobah.1",
          "gloss": "Nobah (of Manasseh)",
          "description": "A town located east of the Jordan River and at some time part of territory of Manasseh; also known as Kenath."
        }
      ]
    },
    "arb": {
      "preferred_label": "نُوبَح (مَنَسَّى)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة تقع شرقي نهر الأردن وكانت في وقت ما جزءًا من أرض منسى؛ وتُعرف أيضًا بقناة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "挪巴 (玛拿西)",
      "descriptions": [
        {
          "source": "acai",
          "description": "位于约旦河东面的一座城镇，曾属于玛拿西支派的领地；也称作基纳。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Nobach (de Manassé)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville située à l'est du Jourdain et qui fit un temps partie du territoire de Manassé ; également connue sous le nom de Kenath."
        }
      ]
    },
    "hau": {
      "preferred_label": "Noba (na Manasse)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari da yake gabas da Kogin Urdun wanda kuma a wani lokaci ya kasance ɓangaren yankin Manasse; wanda aka kuma sani da Kenat."
        }
      ]
    },
    "hin": {
      "preferred_label": "नोबह (मनश्शे का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरदन नदी के पूर्व में स्थित एक नगर जो किसी समय मनश्शे के क्षेत्र का भाग था; इसे कनात के नाम से भी जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Nobah (Manasye)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota yang terletak di sebelah timur Sungai Yordan dan pernah menjadi bagian dari wilayah Manasye; dikenal juga sebagai Kenat."
        }
      ]
    },
    "por": {
      "preferred_label": "Noba (de Manassés)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade localizada a leste do rio Jordão e que, em certo período, fez parte do território de Manassés; também conhecida como Quenate."
        }
      ]
    },
    "rus": {
      "preferred_label": "Новах (Манассии)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город к востоку от реки Иордан, в определенное время входивший в состав территории Манассии; также известен как Кенаф."
        }
      ]
    },
    "spa": {
      "preferred_label": "Noba (de Manasés)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad situada al este del río Jordán y en algún momento parte del territorio de Manasés; también conocida como Quenat."
        }
      ]
    },
    "swh": {
      "preferred_label": "Noba (wa Manase)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko mashariki mwa Mto Yordani na wakati fulani ulikuwa sehemu ya eneo la Manase; pia unajulikana kama Kenathi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Noba (bilong Manase)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun i stap long hap sankamap bilong Wara Jordan na long wanpela taim em i hap bilong Manase; narapela nem bilong en em Kenat."
        }
      ]
    },
    "apd": {
      "preferred_label": "نُوبَح (حقت منسى)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة قاعدة شرق نهر الأردن وكانت في وقت من الأوقات جزء من أرض منسى؛ ومعروفة كمان بقناة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Noba (blong Manase)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon we i stap long is saed blong Jodan Reva mo long wan taem hem i pat blong graon blong Manase; nem blong hem tu Kenat."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nọba (nke Manase)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nʼọwụwa anyanwụ Osimiri Jọdan ma nwee oge ọ bụ akụkụ nke ókèala Manase; nke a makwaara dị ka Kenat."
        }
      ]
    },
    "nep": {
      "preferred_label": "नोबह (मनश्शेको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यर्दन नदीको पूर्वतिर अवस्थित र कुनै समयमा मनश्शेको इलाकाको अंश रहेको एउटा सहर; यसलाई केनात पनि भनिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Nô-bách (của Ma-na-se)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn nằm ở phía đông sông Giô-đanh và từng có thời kỳ thuộc lãnh thổ Ma-na-se; còn được gọi là Kê-nát."
        }
      ]
    },
    "zht": {
      "preferred_label": "挪巴（瑪拿西）",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於約旦河東的一座城鎮，曾為瑪拿西領地的一部分；又名基納。"
        }
      ]
    }
  },
