  "type": "place",
  "localizations": {
    "eng": {
      "preferred_label": "Dan",
      "alternate_labels": [
        "Danite",
        "Dan-Jaan",
        "Vedan",
        "Leshem",
        "Laish"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Dan",
          "gloss": "Dan",
          "description": "A town in northern Israel first inhabited by Sidonians, but later conquered by Danites, who renamed it Dan after the founder of their tribe; also known as Laish and Leshem."
        }
      ]
    },
    "arb": {
      "preferred_label": "دَانَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في شمال إسرائيل سكنها الصيدونيون أولاً، ولكن فتحها الدانيون لاحقاً، وأعادوا تسميتها دَان نسبةً إلى مؤسس سبطهم؛ وتُعرف أيضاً باسم لَايِش ولَشَم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "但",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列北部的一座城镇，起初由西顿人居住，后来被但支派人攻占，他们以其支派始祖但的名字重新命名；也称为拉亿和利善。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Dan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville du nord d'Israël d'abord habitée par les Sidoniens, puis conquise par les Danites, qui la renommèrent Dan d'après le fondateur de leur tribu ; également connue sous les noms de Laïsch et Léschem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani birni a arewacin Isra’ila wanda mutanen Sidon suka fara zama a ciki, amma daga baya mutanen Dan suka ci shi da yaƙi, suka sāke masa suna Dan bayan sunan wanda ya kafa ƙabilarsu; ana kuma kiran sa Layish da Leshem."
        }
      ]
    },
    "hin": {
      "preferred_label": "दान",
      "descriptions": [
        {
          "source": "acai",
          "description": "उत्तरी इस्राएल का एक नगर जहाँ पहले सीदोनी लोग रहते थे, परन्तु बाद में दानियों द्वारा जीत लिया गया, जिन्होंने अपने कुल के मूलपुरुष के नाम पर इसका नाम दान रखा; इसे लैश और लेशेम के नाम से भी जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Dan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di Israel utara yang pertama kali didiami oleh orang Sidon, tetapi kemudian ditaklukkan oleh orang Dan, yang menamainya Dan menurut bapa leluhur suku mereka; juga dikenal sebagai Lais dan Lesem."
        }
      ]
    },
    "por": {
      "preferred_label": "Dã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade no norte de Israel, inicialmente habitada por sidônios, mas posteriormente conquistada pelos danitas, que a renomearam como Dã em homenagem ao fundador de sua tribo; também conhecida como Laís e Lesém."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город на севере Израиля, первоначально населенный сидонянами, но позже завоеванный данитянами, которые переименовали его в Дан по имени основателя своего колена; также известен как Лаиш и Ласем."
        }
      ]
    },
    "spa": {
      "preferred_label": "Dan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad en el norte de Israel, habitada primero por los sidonios, pero conquistada más tarde por los danitas, quienes le cambiaron el nombre a Dan en honor al fundador de su tribu; también conocida como Lais y Lesem."
        }
      ]
    },
    "swh": {
      "preferred_label": "Dani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulio kaskazini mwa Israeli uliokaliwa kwanza na Wasidoni, lakini baadaye ukatekwa na Wadani, walioupa jina jipya la Dani kulingana na mwanzilishi wa kabila lao; pia unajulikana kama Laisha na Leshemu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Dan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long hap not bilong Israel, bipo ol manmeri bilong Saidon i bin sindaun long en, tasol bihain ol lain Dan i daunim ol, na ol i kolim nem bilong taun olsem Dan long nem bilong tumbuna papa bilong traib bilong ol; narapela nem bilong en em Lais na Lesem."
        }
      ]
    },
    "apd": {
      "preferred_label": "دان",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في شمال إسرائيل سكنوها الصيدونيين أول حاجة، لكن بعد داك فتحوها الدانيين وسموها دان على اسم مؤسس قبيلتهم؛ ومعروفة كمان بلايش ولشم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Dan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long not blong Isrel we ol man Saedon oli laef long hem fastaem, be biaen ol man Dan oli winim, mo oli jenisim nem blong hem i kam Dan folem nem blong stamba bubu blong laen blong olgeta; we nem blong hem tu Laes mo Lesem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Dan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nʼebe ugwu Izrel nke ndị Saịdọn buru ụzọ biri na ya, mana ndị Dan mesịrị merie ya, ma gbanwee aha ya ịbụ Dan nʼaha onye guzobere ebo ha; a makwaara ya dịka Laịsh na Leshem."
        }
      ]
    },
    "nep": {
      "preferred_label": "दान",
      "descriptions": [
        {
          "source": "acai",
          "description": "उत्तरी इस्राएलको एउटा सहर जहाँ सुरुमा सीदोनीहरू बसोबास गर्थे, तर पछि दानका कुलले यसलाई जिते र आफ्ना कुलका पुर्खाको नाउँबाट यसको नाउँ दान राखे; यसलाई लैश र लेशेम पनि भनिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Đan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành ở miền bắc Y-sơ-ra-ên, ban đầu do người Si-đôn cư ngụ, nhưng sau đó bị người Đan đánh chiếm và đổi tên thành Đan theo tên tổ phụ bộ tộc của họ; cũng được gọi là La-hót và Lê-sem."
        }
      ]
    },
    "zht": {
      "preferred_label": "但",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列北部的一座城鎮，起初由西頓人居住，後來被但人征服，但人按其支派創始人的名字將其改名為但；亦稱拉億和利善。"
        }
      ]
    }
  },
