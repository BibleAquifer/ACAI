        }
      ]
    },
    "hin": {
      "preferred_label": "कैसरिया फिलिप्पी",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेर्मोन पर्वत की तलहटी में स्थित एक नगर, जहाँ पतरस ने मसीह के विषय में अपना अंगीकार किया था (मत्ती 16:13–20; मरकुस 8:27–30)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sizaria Filipai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị nʼala ala Ugwu Hemon, ebe Pita kwupụtara nkwenkwe ya banyere Kraịst (Matiu 16:13–20; Mak 8:27–30)."
        }
      ]
    },
    "nep": {
      "preferred_label": "कैसरिया फिलिप्पी",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेर्मोन डाँडाको फेदीमा रहेको एउटा सहर, जहाँ पत्रुसले ख्रीष्टको विषयमा आफ्नो विश्‍वास स्वीकार गर्छन् (मत्ती १६:१३–२०; मर्कूस ८:२७–३०)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-sa-rê Phi-líp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành phố dưới chân núi Hẹt-môn, nơi Phi-e-rơ tuyên xưng niềm tin vào Đấng Christ (Ma-thi-ơ 16:13–20; Mác 8:27–30)."
        }
      ]
    },
    "zht": {
      "preferred_label": "凱撒利亞‧腓立比",
