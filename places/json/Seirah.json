          "source": "acai",
          "article": "place:Seirah",
          "gloss": "Seirah",
          "description": "A town or area in the hill country of Ephraim where Ehud escaped to after he killed Eglon, king of Moab."
        }
      ]
    },
    "arb": {
      "preferred_label": "سِعِيرَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة أو منطقة في جبل أفرايم هرب إليها إهود بعد أن قتل عجلون ملك موآب."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西伊拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法莲山地的一个城镇或地区，以笏杀死摩押王伊矶伦后逃到了那里。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Seïra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville ou région dans la région montagneuse d’Éphraïm où Éhud s’enfuit après avoir tué Églon, roi de Moab."
        }
      ]
    },
    "hau": {
      "preferred_label": "Seyira",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari ko yanki a ƙasar tudu ta Efraim inda Ehud ya gudu bayan ya kashe Eglon, sarkin Mowab."
        }
      ]
    },
    "hin": {
      "preferred_label": "सेइरे",
      "descriptions": [
        {
          "source": "acai",
          "description": "एप्रैम के पहाड़ी देश का एक नगर या क्षेत्र जहाँ मोआब के राजा एग्लोन को मारने के बाद एहूद भाग गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Seira",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota atau daerah di pegunungan Efraim tempat Ehud meloloskan diri setelah membunuh Eglon, raja Moab."
        }
      ]
    },
    "por": {
      "preferred_label": "Seirá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade ou região na região montanhosa de Efraim para onde Eúde fugiu depois de matar Eglom, rei de Moabe."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сеираф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город или местность в нагорной части Ефрема, куда бежал Аод после убийства Еглона, царя Моавитского."
        }
      ]
    },
    "spa": {
      "preferred_label": "Seirat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un pueblo o zona en la región montañosa de Efraín adonde huyó Aod después de matar a Eglón, rey de Moab."
        }
      ]
    },
    "swh": {
      "preferred_label": "Seira",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji au eneo katika nchi ya vilima ya Efraimu ambapo Ehudi alikimbilia baada ya kumuua Egloni, mfalme wa Moabu."
        }
      ]
    },
    "apd": {
      "preferred_label": "سعيرة",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة أو منطقة في جبال أفرايم هرب ليها إيهود بعد ما قتل عجلون ملك موآب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Seira",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon no eria long ples blong hil blong Efrem we Ehud i ronwe i go long hem afta we hem i kilim Eglon, king blong Moab."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Seira",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo ma ọ bụ mpaghara dị nʼugwu Efraim ebe Ehud gbagaara mgbe o gbusịrị Eglọn, eze Moab."
        }
      ]
    },
    "nep": {
      "preferred_label": "सीरा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एप्रैमको पहाडी देशमा पर्ने एउटा सहर वा क्षेत्र जहाँ मोआबका राजा एग्लोनलाई मारेपछि एहूद भागेर गएका थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Seira",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun o hap long ples maunten bilong Efraim we Ehut i bin ranawe i go long en bihain long em i kilim Eglon, king bilong Moap."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-i-ra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn hoặc khu vực trong vùng đồi núi Ép-ra-im, nơi Ê-hút trốn thoát đến sau khi giết Ên-lôn, vua Mô-áp."
        }
      ]
    },
    "zht": {
      "preferred_label": "西伊拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法蓮山地的一座城鎮或地區，以笏殺死摩押王伊磯倫後逃到此處。"
        }
      ]
    }
