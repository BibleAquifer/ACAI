          "description": "مدينة في لِيكأونية، جنوب شرق لِسْترة؛ خدم فيها بولس خلال رحلاته التبشيرية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "特庇",
      "descriptions": [
        {
          "source": "acai",
          "description": "吕高尼的一座城，位于路司得东南；保罗在宣教旅程中曾在此事奉。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Derbe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville de Lycaonie, au sud-est de Lystre ; Paul y exerça son ministère au cours de ses voyages missionnaires."
        }
      ]
    },
    "hau": {
      "preferred_label": "Derbe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani birni a Likawoniya, a kudu maso gabashin Listira; Bulus ya yi hidima a nan a lokacin tafiye-tafiyensa na mishan."
        }
      ]
    },
    "hin": {
      "preferred_label": "दिरबे",
      "descriptions": [
        {
          "source": "acai",
          "description": "लुकाउनिया में लुस्त्रा के दक्षिण-पूर्व में स्थित एक नगर; पौलुस ने अपनी प्रचार-यात्राओं के दौरान यहाँ सेवा की थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Derbe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di Likaonia, sebelah tenggara Listra; Paulus melayani di sini selama perjalanan misionarisnya."
        }
      ]
    },
    "por": {
      "preferred_label": "Derbe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade na Licônia, a sudeste de Listra; Paulo ministrou aqui durante suas viagens missionárias."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дервия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в Ликаонии, к юго-востоку от Листры; Павел нес здесь служение во время своих миссионерских путешествий."
        }
      ]
    },
    "spa": {
      "preferred_label": "Derbe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad en Licaonia, al sureste de Listra; Pablo ministró aquí durante sus viajes misioneros."
        }
      ]
    },
    "swh": {
      "preferred_label": "Derbe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko Likaonia, kusinimashariki mwa Listra; Paulo alihudumu hapa wakati wa safari zake za kimisionari."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Derbe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Likonia, long hap saut-is bilong Listra; Pol i bin mekim wok autim gutnius long dispela hap long ol raun bilong em bilong mekim wok misin."
        }
      ]
    },
    "apd": {
      "preferred_label": "دربة",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في ليكأونية، جنوب شرق لسترة؛ بولس خدم هنا أثناء رحلاته التبشيرية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Debe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Likaonia, long saotis blong Listra; Pol i bin mekem wok blong God long ples ya long ol misinari trip blong hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Debi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo dị na Likaonia, na ndịda-ọwụwa anyanwụ nke Listra; Pọl jere ozi nʼebe a nʼoge njem nkwusa oziọma ya niile."
        }
      ]
    },
    "nep": {
      "preferred_label": "डर्बी",
      "descriptions": [
        {
          "source": "acai",
          "description": "लुस्त्राको दक्षिण-पूर्वमा पर्ने लुकाओनियाको एउटा सहर; पावलले आफ्नो प्रचार यात्राको क्रममा यहाँ सेवा गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Đẹt-bơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành phố thuộc xứ Ly-ca-ô-ni, phía đông nam thành Lít-trơ; Phao-lô đã thi hành chức vụ tại đây trong các chuyến hành trình truyền giáo của ông."
        }
      ]
    },
    "zht": {
      "preferred_label": "特庇",
      "descriptions": [
        {
          "source": "acai",
          "description": "呂高尼境內、路司得東南的一座城；保羅在傳道旅程中曾在此事奉。"
        }
      ]
    }
  },
