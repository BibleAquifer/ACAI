  "localizations": {
    "eng": {
      "preferred_label": "Capernaum",
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Capernaum",
          "gloss": "Capernaum",
          "description": "A city on the northwest coast of the Sea of Galilee. After leaving Nazareth, Jesus moved here where he did much of his ministry."
        }
      ]
    },
    "fra": {
      "preferred_label": "Capernaüm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville sur la côte nord-ouest de la mer de Galilée. Après avoir quitté Nazareth, Jésus s'y installa et y accomplit une grande partie de son ministère."
        }
      ]
    },
    "spa": {
      "preferred_label": "Capernaúm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad en la costa noroeste del mar de Galilea. Después de dejar Nazaret, Jesús se trasladó aquí, donde realizó gran parte de su ministerio."
        }
      ]
    },
    "arb": {
      "preferred_label": "كَفْرَنَاحُوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة على الساحل الشمالي الغربي لبحر الجليل. بعد مغادرته الناصرة، انتقل يسوع إلى هنا حيث أجرى جزءًا كبيرًا من خدمته."
        }
      ]
    },
    "zhs": {
      "preferred_label": "迦百农",
      "descriptions": [
        {
          "source": "acai",
          "description": "加利利海西北岸的一座城市。耶稣离开拿撒勒后迁居于此，在此开展了祂的大部分事工。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kafarnahum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani birni a bakin tekun arewa maso yammacin Tekun Galili. Bayan barin Nazaret, Yesu ya ƙaura zuwa nan inda ya yi yawancin hidimarsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "कफरनहूम",
      "descriptions": [
        {
          "source": "acai",
          "description": "गलील की झील के उत्तर-पश्चिमी तट पर स्थित एक नगर। नासरत छोड़ने के बाद, यीशु यहाँ आकर रहने लगे जहाँ उन्होंने अपनी सेवकाई का अधिकांश कार्य किया।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kapernaum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di pantai barat laut Danau Galilea. Setelah meninggalkan Nazaret, Yesus pindah ke sini tempat Ia banyak melayani."
        }
      ]
    },
    "por": {
      "preferred_label": "Cafarnaum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade na costa noroeste do mar da Galileia. Depois de deixar Nazaré, Jesus mudou-se para lá, onde realizou grande parte do seu ministério."
        }
      ]
    },
    "rus": {
      "preferred_label": "Капернаум",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город на северо-западном побережье Галилейского моря. Покинув Назарет, Иисус перебрался сюда, где совершал большую часть своего служения."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kapernaumu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji kwenye pwani ya kaskazini-magharibi ya Bahari ya Galilaya. Baada ya kuondoka Nazareti, Yesu alihamia hapa ambapo alifanya sehemu kubwa ya huduma yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kaperneam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long not-wes nambis bilong Raunwara Galili. Bihain long Jisas i lusim Nasaret, em i bin i go stap long dispela taun we em i bin mekim planti wok bilong en."
        }
      ]
    },
    "apd": {
      "preferred_label": "كفرناحوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في الساحل الشمالي الغربي لبحر الجليل. بعد ما يسوع خلى الناصرة نقل ليها وعمل فيها جزء كبير من خدمته."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kapaneam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long notwes sanwis blong Raonwota blong Galili. Biaen we Jisas i aot long Nasaret, hem i muv i go stap long ples ya we hem i mekem plante wok blong minista blong hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kapanọm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị n'akụkụ ugwu ọdịda anyanwụ nke Oké Osimiri Galili. Mgbe ọ hapụsịrị Nazaret, Jisọs kwagara ebe a ebe o mere ọtụtụ n'ime ozi ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "कफर्नहुम",
      "descriptions": [
        {
          "source": "acai",
          "description": "गालीलको समुद्रको उत्तर-पश्चिमी किनारमा रहेको एउटा सहर। नासरत छोडेपछि येशू यहाँ सर्नुभयो जहाँ उहाँले आफ्नो धेरै सेवकाइ गर्नुभयो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ca-bê-na-um",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành ở bờ tây bắc biển Ga-li-lê. Sau khi rời Na-xa-rét, Chúa Giê-xu chuyển đến đây và thực hiện phần lớn chức vụ của Ngài."
        }
      ]
    },
    "zht": {
      "preferred_label": "迦百農",
      "descriptions": [
        {
          "source": "acai",
          "description": "加利利海西北岸的一座城。耶穌離開拿撒勒後定居於此，並在此展開了許多事工。"
        }
      ]
    }
  },
