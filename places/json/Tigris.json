          "source": "acai",
          "article": "place:Tigris",
          "gloss": "Tigris River",
          "description": "A large body of flowing water in Mesopotamia; one of the four rivers that flowed out of the river from the Garden of Eden."
        }
      ]
    },
    "fra": {
      "preferred_label": "Tigre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un grand cours d'eau en Mésopotamie ; l'un des quatre fleuves qui sortaient du fleuve issu du jardin d'Éden."
        }
      ]
    },
    "spa": {
      "preferred_label": "Río Tigris",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gran corriente de agua en Mesopotamia; uno de los cuatro ríos que nacían del río del jardín del Edén."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَهْرُ دِجْلَةَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَجْرًى مائِيٌّ كَبيرٌ فِي بِلادِ ما بَيْنَ النَّهْرَيْنِ؛ أَحَدُ الأَنْهارِ الأَرْبَعَةِ النّابِعَةِ مِنَ النَّهْرِ الَّذي كانَ يَخْرُجُ مِنْ جَنَّةِ عَدْنٍ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "底格里斯河",
      "descriptions": [
        {
          "source": "acai",
          "description": "美索不达米亚的一条大河；从伊甸园流出之河分出的四条河流之一。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kogin Tigris",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban kogi a Aram-Naharayim; ɗaya daga cikin koguna huɗu da suka fito daga kogin da ya fito daga Lambun Adan."
        }
      ]
    },
    "ind": {
      "preferred_label": "Sungai Tigris",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah aliran air besar di Mesopotamia; salah satu dari empat sungai yang mengalir keluar dari sungai dari Taman Eden."
        }
      ]
    },
    "por": {
      "preferred_label": "Rio Tigre",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um grande curso de água na Mesopotâmia; um dos quatro rios que saíam do rio do jardim do Éden."
        }
      ]
    },
    "rus": {
      "preferred_label": "Тигр",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупная река в Месопотамии; одна из четырех рек, выходивших из реки, орошавшей Едемский сад."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mto Tigrisi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mto mkubwa unaotiririka huko Mesopotamia; mojawapo ya mito minne iliyotoka kwenye ule mto wa Bustani ya Edeni."
        }
      ]
    },
    "apd": {
      "preferred_label": "نهر دجلة",
      "descriptions": [
        {
          "source": "acai",
          "description": "نهر كبير في بلاد ما بين النهرين؛ واحد من الأنهار الأربعة اللي كانت طالعة من النهر الجاي من جنة عدن."
        }
      ]
    },
    "bis": {
      "preferred_label": "Taegris Reva",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala reva long Mesopotamia; wan long ol fo reva we i aot long reva blong garen blong Iden."
        }
      ]
    },
    "hin": {
      "preferred_label": "हिद्देकेल नदी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मेसोपोटामिया की एक विशाल बहती जलधारा; अदन की वाटिका से निकलने वाली उस नदी की चार शाखाओं में से एक।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Osimiri Taịgris",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nnukwu osimiri dị na Mesopotemia; otu n'ime osimiri anọ ahụ siri n'osimiri na-asọpụta n'Ubi Iden pụta."
        }
      ]
    },
    "nep": {
      "preferred_label": "टाइग्रिस नदी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मेसोपोटामियाको एउटा ठूलो नदी; एदेनको बगैँचाबाट निस्केको नदीबाट विभाजित भएका चार नदीहरूमध्ये एक।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Wara Taigris",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela wara long Mesopotemia; wanpela bilong ol 4-pela wara i bin kamap long dispela wara i bin ran i go aut long Gaden Iden."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sông Ti-gơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một dòng sông lớn ở Mê-sô-bô-ta-mi; một trong bốn nhánh sông bắt nguồn từ con sông chảy ra từ vườn Ê-đen."
        }
      ]
    },
    "zht": {
      "preferred_label": "底格里斯河",
      "descriptions": [
        {
          "source": "acai",
          "description": "美索不達米亞的一條大河；為從伊甸園流出的河所分出的四道河之一。"
        }
      ]
    }
