        }
      ],
      "preferred_label": "Shaalbon"
    },
    "apd": {
      "preferred_label": "شعلبون",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلد إلياحبا، واحد من أبطال داود المحاربين؛ ويمكن تكون هي نفسها شعلبيم."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَعْلَبُون",
      "descriptions": [
        {
          "source": "acai",
          "description": "موطن إلياحبا، أحد أبطال داود؛ يحتمل أنها شعلبيم نفسها."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sahalbon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ples blong Eliabaha, wan long ol strong soldia blong Deved; maet hem i sem mak olsem Sahalbim."
        }
      ]
    },
    "fra": {
      "preferred_label": "Schaalbon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lieu d'origine d'Éliachba, l'un des vaillants guerriers de David ; peut-être le même lieu que Schaalbim."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sha’albo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahaifar Eliyaba, ɗaya daga cikin mayakan Dawuda; wataƙila gari ɗaya ne da Sha’albim."
        }
      ]
    },
    "hin": {
      "preferred_label": "शालबोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "दाऊद के शूरवीरों में से एक, एल्यहबा का गृह-नगर; संभवतः यह शाल्बीम ही है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shaalbon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ebe obibi Eliaba, otu nʼime ndị dike Devid; o nwere ike ịbụ otu na Shaalbim."
        }
      ]
    },
    "ind": {
      "preferred_label": "Saalbon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kampung halaman Elyahba, salah seorang pahlawan Daud; kemungkinan sama dengan Saalbim."
        }
      ]
    },
    "nep": {
      "preferred_label": "शाल्बोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "दाऊदका एक योद्धा एल्याहबाको घर; सम्भवतः शाल्बीमसँग उही ठाउँ।"
        }
      ]
    },
