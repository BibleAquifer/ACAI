        }
      ]
    },
    "arb": {
      "preferred_label": "سُورِيَّة",
      "descriptions": [
        {
          "source": "acai",
          "description": "مِنْطَقَةٌ إِلَى ٱلشَّمَالِ وَٱلشَّرْقِ مِنْ فِلَسْطِينَ؛ عُرِفَتْ بِٱسْمِ أَرَامَ فِي ٱلْعَهْدِ ٱلْقَدِيمِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Siria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan rijen long not mo is blong Palestaen; we long Olfala Testeman oli kolem Aram."
        }
      ]
    },
    "fra": {
      "preferred_label": "Syrie",
