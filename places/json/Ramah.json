          "gloss": "Ramah (of Ephraim)",
          "description": "A town in the territory of Ephraim, where Samuel lived; also known as Ramathaim Zophim."
        }
      ]
    },
    "arb": {
      "preferred_label": "الرامة (في أفرايم)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في أرض أفرايم عاش فيها صموئيل؛ وتُعرف أيضاً باسم رامتَايِمَ صوفِيمَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拉玛（以法莲）",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法莲境内的一座城镇，撒母耳居住于此；也称作“拉玛·琐非”。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Rama (d’Éphraïm)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville située sur le territoire d’Éphraïm, où vivait Samuel ; également connue sous le nom de Ramathaïm-Tsophim."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rama (ta Efraim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a yankin Efraim, inda Sama’ila ya zauna; wanda kuma aka sani da Ramatayim-Zofim."
        }
      ]
    },
    "hin": {
      "preferred_label": "रामाह (एप्रैम का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एप्रैम के क्षेत्र का एक नगर जहाँ शमूएल रहता था; इसे रामातैम-सोपीम भी कहा जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Rama (di Efraim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di wilayah Efraim, tempat tinggal Samuel; dikenal juga sebagai Ramataim-Zofim."
        }
      ]
    },
    "por": {
      "preferred_label": "Ramá (de Efraim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade no território de Efraim, onde Samuel vivia; também conhecida como Ramataim-Zofim."
        }
      ]
    },
    "rus": {
      "preferred_label": "Рама (в уделе Ефрема)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в уделе Ефрема, где жил Самуил; также известный как Рамафаим-Цофим."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ramá (de Efraín)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo en el territorio de Efraín, donde vivió Samuel; también conocido como Ramataim de Zofim."
        }
      ]
    },
    "swh": {
      "preferred_label": "Rama (ya Efraimu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji katika eneo la Efraimu, ambapo Samweli aliishi; pia unajulikana kama Ramathaimu-Zofimu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rama (bilong Efraim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long hap graun bilong Efraim, ples Samuel i bin stap long en; narapela nem bilong en Ramataim-Sofim."
        }
      ]
    },
    "apd": {
      "preferred_label": "الرامة (حقت أفرايم)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في أرض أفرايم محل ما كان عايش صموئيل؛ وبتتعرف كمان باسم رامتايم صوفيم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rama (blong Efrem)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long teritori blong Efrem, we Samuel i bin stap long hem; we oli save long hem tu olsem Ramataem-Sofim."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Rema (nke Ifrem)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo dị nʼókèala Ifrem, ebe Samuel biri; nke a makwaara dị ka Ramataim-zofim."
        }
      ]
    },
    "nep": {
      "preferred_label": "रामा (एफ्राइमको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एफ्राइमको इलाकाको एउटा सहर, जहाँ समुएल बस्थे; रामतैम-सोफीम भनेर पनि चिनिने ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ra-ma (ở Ép-ra-im)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn thuộc lãnh thổ Ép-ra-im, nơi Sa-mu-ên từng sinh sống; còn được gọi là Ra-ma-tha-im Xô-phim."
        }
      ]
    },
    "zht": {
      "preferred_label": "拉瑪 (以法蓮)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法蓮境內的一座城鎮，撒母耳居住之處；又名拉瑪‧瑣非。"
        }
      ]
    }
  },
