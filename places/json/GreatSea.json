      "descriptions": [
        {
          "source": "acai",
          "article": "place:GreatSea",
          "gloss": "Mediterranean Sea",
          "description": "A large body of water located between southern Europe, northern Africa, and western Asia, which borders Palestine on the west."
        }
      ]
    },
    "arb": {
      "preferred_label": "البحر الأبيض المتوسط",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسطح مائي كبير يقع بين جنوب أوروبا وشمال إفريقيا وغرب آسيا، ويحد فلسطين من الغرب."
        }
      ]
    },
    "zhs": {
      "preferred_label": "地中海",
      "descriptions": [
        {
          "source": "acai",
          "description": "位于南欧、北非和西亚之间的大片水域，西面与巴勒斯坦接壤。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Bahar Rum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban teku da yake tsakanin kudancin Turai, da arewacin Afirka, da yammacin Asiya, wanda ya yi iyaka da Falasɗinu a wajen yamma."
        }
      ]
    },
    "hin": {
      "preferred_label": "भूमध्य सागर",
      "descriptions": [
        {
          "source": "acai",
          "description": "दक्षिणी यूरोप, उत्तरी अफ्रीका और पश्चिमी एशिया के बीच स्थित एक विशाल जलराशि, जो पश्चिम में फ़िलिस्तीन की सीमा बनाती है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Laut Tengah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah perairan besar yang terletak di antara Eropa selatan, Afrika utara, dan Asia barat, yang berbatasan dengan Palestina di sebelah barat."
        }
      ]
    },
    "por": {
      "preferred_label": "Mar Mediterrâneo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um grande corpo de água localizado entre o sul da Europa, o norte da África e a Ásia ocidental, que limita a Palestina a oeste."
        }
      ]
    },
    "spa": {
      "preferred_label": "Mar Mediterráneo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gran extensión de agua situada entre el sur de Europa, el norte de África y el oeste de Asia, que limita con Palestina al oeste."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bahari ya Mediterania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bahari kubwa iliyoko kati ya kusini mwa Ulaya, kaskazini mwa Afrika, na magharibi mwa Asia, inayopakana na Palestina upande wa magharibi."
        }
      ]
    },
    "apd": {
      "preferred_label": "البحر الأبيض المتوسط",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسطح مائي كبير واقع بين جنوب أوروبا وشمال أفريقيا وغرب آسيا، وبحد فلسطين من جهة الغرب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mediterenian Si",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala solwota we i stap long medel blong saot Yurop, not Afrika, mo wes Esia, we i mekem boda blong Palestaen long wes."
        }
      ]
    },
    "fra": {
      "preferred_label": "mer Méditerranée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grande étendue d'eau située entre l'Europe méridionale, l'Afrique du Nord et l'Asie occidentale, qui borde la Palestine à l'ouest."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Osimiri Mediterenịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu mmiri dị nʼetiti ndịda Europe, ugwu Africa, na ọdịda anyanwụ Asia, nke dị nʼókè Palestine nʼọdịda anyanwụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "भूमध्य सागर",
      "descriptions": [
        {
          "source": "acai",
          "description": "दक्षिणी युरोप, उत्तरी अफ्रिका र पश्चिमी एसियाको बीचमा अवस्थित एउटा ठूलो जलपिण्ड, जसले पश्चिममा प्यालेस्टाइनलाई सिमाना गर्दछ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Средиземное море",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупный водоём, расположенный между южной Европой, северной Африкой и западной Азией, омывающий Палестину с запада."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Biksolwara Mediterenian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela solwara i stap namel long saut Yurop, not Afrika, na wes Esia, em i stap long hap san i go daun bilong graun Palestain."
        }
      ]
    },
    "vie": {
      "preferred_label": "Địa Trung Hải",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vùng biển lớn nằm giữa Nam Âu, Bắc Phi và Tây Á, giáp ranh với Pa-lét-tin ở phía tây."
        }
      ]
    },
    "zht": {
      "preferred_label": "地中海",
      "descriptions": [
        {
          "source": "acai",
          "description": "位於南歐、北非與西亞之間的一大片水域，西面與巴勒斯坦接壤。"
        }
      ]
    }
  },
