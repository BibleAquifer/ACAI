      "descriptions": [
        {
          "source": "acai",
          "article": "place:Hamath.1",
          "gloss": "Hamath",
          "description": "A town on the Orontes River in Syria; capital of Aramean kingdom; its inhabitants were relocated to Samaria by the king of Assyria."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَمَاة",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة على نهر العاصي في سوريا؛ عاصمة مملكة آرامية، نقل ملك أشور سكانها إلى السامرة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈马",
      "descriptions": [
        {
          "source": "acai",
          "description": "位于叙利亚奥龙特斯河畔的一座城镇；曾是亚兰王国的首都；其居民被亚述王迁往撒玛利亚。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Hamath",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville sur l'Oronte en Syrie ; capitale d'un royaume araméen ; ses habitants furent déportés en Samarie par le roi d'Assyrie."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hamat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a Kogin Orontes a Siriya; babban birnin mulkin Aramawa; sarkin Assuriya ya ƙaura da mazaunansa zuwa Samariya."
        }
      ]
    },
    "hin": {
      "preferred_label": "हमात",
      "descriptions": [
        {
          "source": "acai",
          "description": "सीरिया में ओरोन्तेस नदी पर स्थित एक नगर; अरामी राज्य की राजधानी; इसके निवासियों को अश्शूर के राजा द्वारा सामरिया में बसाया गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hamat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di tepi Sungai Orontes di Siria; ibu kota kerajaan Aram; penduduknya dipindahkan ke Samaria oleh raja Asyur."
        }
      ]
    },
    "por": {
      "preferred_label": "Hamate",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade junto ao rio Orontes, na Síria; capital de um reino arameu; seus habitantes foram transferidos para Samaria pelo rei da Assíria."
        }
      ]
    },
    "rus": {
      "preferred_label": "Емаф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город на реке Оронт в Сирии; столица арамейского царства; его жители были переселены в Самарию царем Ассирии."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hamat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad a orillas del río Orontes en Siria; capital de un reino arameo; sus habitantes fueron reubicados en Samaria por el rey de Asiria."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hamathi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji kwenye Mto Orontes huko Shamu; mji mkuu wa ufalme wa Waaramu; wakaaji wake walihamishiwa Samaria na mfalme wa Ashuru."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hamat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long wara Orontes long Siria; het-taun bilong wanpela kingdom bilong ol Aram; king bilong Asiria i bin kisim ol manmeri bilong en i go sindaun long Samaria."
        }
      ]
    },
    "apd": {
      "preferred_label": "حماة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حِلّة على نهر العاصي في سوريا؛ عاصمة لمملكة آرامية؛ ملك آشور نقل سكانها للسامرة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hamat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Reva ya Orontes long Siria; kapitol blong kingdom blong Aram; king blong Asiria i muvum ol man blong hem oli go stap long Sameria."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hamat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo dị nʼakụkụ Osimiri Orontes na Siria; isi obodo nke alaeze ndị Aram; eze Asịrịa dọkpụrụ ndị bi na ya gaa Sameria."
        }
      ]
    },
    "nep": {
      "preferred_label": "हमात",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिरियाको ओरोन्टेस नदी किनारमा अवस्थित एउटा सहर; अरामी राज्यको राजधानी; यहाँका बासिन्दाहरूलाई अश्शूरका राजाले सामरियामा निर्वासित गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-mát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành bên sông Ô-rôn-tê ở Sy-ri; kinh đô của vương quốc A-ram; cư dân tại đây đã bị vua A-si-ri dời đến Sa-ma-ri."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈馬",
      "descriptions": [
        {
          "source": "acai",
          "description": "敘利亞奧龍特斯河畔的一座城鎮；亞蘭王國的首都；其居民被亞述王遷移到撒馬利亞。"
        }
      ]
    }
  },
