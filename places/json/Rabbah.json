  "localizations": {
    "eng": {
      "preferred_label": "Rabbah (of the Ammonites)",
      "alternate_labels": [
        "Rabbath",
        "Ammon",
        "Rabbah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "article": "place:Rabbah.1",
          "gloss": "Rabbah (of the Ammonites)",
          "description": "A town in Ammon and capital of the Ammonite kingdom; first conquered by Israel on their way from Egypt, and later again by David."
        }
      ]
    },
    "arb": {
      "preferred_label": "رَبَّة (بني عمون)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في عمون وعاصمة مملكة العمونيين؛ غزاها إسرائيل أولاً في طريقهم من مصر، ولاحقاً غزاها داود مرة أخرى."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拉巴 (亚扪人)",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚扪境内的一座城镇，亚扪王国的首都；以色列人出埃及时首先征服了此地，后来大卫再次攻取。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Rabba (ta Ammonawa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a Ammon kuma babban birnin mulkin Ammonawa; Isra'ila suka fara cinye shi a kan hanyarsu daga Masar, daga baya kuma Dawuda ya sake cinye shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "रब्बाह (अम्मोनियों का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अम्मोन का एक नगर और अम्मोनियों के राज्य की राजधानी; इस पर पहले मिस्र से आते समय इस्राएलियों ने और बाद में फिर से दाऊद ने विजय प्राप्त की थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Raba (orang Amon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di Amon dan ibu kota kerajaan bani Amon; pertama kali ditaklukkan oleh Israel dalam perjalanan mereka dari Mesir, dan kemudian ditaklukkan lagi oleh Daud."
        }
      ]
    },
    "por": {
      "preferred_label": "Rabá (dos amonitas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade em Amom e capital do reino amonita; conquistada pela primeira vez por Israel no seu caminho do Egito, e mais tarde novamente por Davi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Равва (Аммонитская)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в Аммоне и столица Аммонитского царства; впервые был покорен Израилем на пути из Египта, а затем повторно Давидом."
        }
      ]
    },
    "spa": {
      "preferred_label": "Rabá (de los amonitas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una ciudad en Ammón y capital del reino amonita; conquistada primero por Israel en su camino desde Egipto, y más tarde de nuevo por David."
        }
      ]
    },
    "swh": {
      "preferred_label": "Raba (ya Waamoni)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji katika Amoni na mji mkuu wa ufalme wa Waamoni; ulitekwa kwanza na Israeli wakiwa njiani kutoka Misri, na baadaye tena na Daudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Raba (bilong ol Amon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Amon na biktaun bilong kantri Amon; pastaim ol Israel i daunim em long taim ol i lusim Isip, na bihain Devit i daunim em gen."
        }
      ]
    },
    "apd": {
      "preferred_label": "ربة (حق العمونيين)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مدينة في عمون وعاصمة مملكة العمونيين، فتحها بنو إسرائيل أولاً وهم في طريقهم من مصر، وبعد داك فتحها داود مرة تانية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Raba (blong ol man Amon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Amon mo hedtuataon blong kingdom blong Amon; ol laen blong Isrel oli tekem faswan taem oli aot long Ijip, mo biaen Deved i tekem bakegen."
        }
      ]
    },
    "fra": {
      "preferred_label": "Rabba (des Ammonites)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville d'Ammon et capitale du royaume ammonite ; d'abord conquise par Israël lors de son voyage depuis l'Égypte, puis plus tard à nouveau par David."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Raba (nke ndị Amọn)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obodo dị nʼAmọn na isi obodo nke alaeze ndị Amọn; nke Izrel buru ụzọ merie nʼụzọ ha si nʼIjipt na-apụta, na mechazie site nʼaka Devid."
        }
      ]
    },
    "nep": {
      "preferred_label": "रब्बा (अम्मोनीहरूको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अम्मोनको एक सहर र अम्मोनी राज्यको राजधानी; पहिले मिश्रबाट आउने बाटोमा इस्राएलद्वारा र पछि फेरि दाऊदद्वारा जितिएको।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ráp-ba (của người Am-môn)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn ở Am-môn và là thủ đô của vương quốc người Am-môn; lúc đầu bị người Y-sơ-ra-ên chinh phục trên đường rời khỏi Ai Cập, và sau đó một lần nữa bởi Đa-vít."
        }
      ]
    },
    "zht": {
      "preferred_label": "拉巴（亞捫人）",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞捫境內的一座城鎮，為亞捫王國的京城；以色列人出埃及途中曾先攻取此地，後來大衛又再次攻取。"
        }
      ]
    }
  },
