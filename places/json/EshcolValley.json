          "article": "place:ValleyOfEshcol",
          "gloss": "Valley of Eshcol",
          "description": "A valley near Hebron where Israelite spies cut off a large cluster of grapes (Numbers 13:23–24)."
        }
      ]
    },
    "fra": {
      "preferred_label": "vallée d'Eschcol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une vallée près d'Hébron où les explorateurs israélites coupèrent une grosse grappe de raisin (Nombres 13:23–24)."
        }
      ]
    },
    "spa": {
      "preferred_label": "valle de Escol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un valle cerca de Hebrón donde los espías israelitas cortaron un gran racimo de uvas (Números 13:23-24)."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَادِي أَشْكُولَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَادٍ قُرْبَ حَبْرُونَ قَطَفَ فِيهِ جَوَاسِيسُ إِسْرَائِيلَ عُنْقُودًا كَبِيرًا مِنَ ٱلْعِنَبِ (عَدَد 13: 23–24)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以实各谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "希伯仑附近的一个山谷，以色列探子曾在此砍下一大串葡萄（民数记 13:23–24）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwarin Eshkol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kwari kusa da Hebron inda ’yan leƙen asirin Isra'ila suka yanko babban nonon inabi (Ƙidaya 13:23-24)."
        }
      ]
    },
    "ind": {
      "preferred_label": "Lembah Eskol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah lembah di dekat Hebron tempat para pengintai Israel memotong setandan besar buah anggur (Bilangan 13:23–24)."
        }
      ]
    },
    "por": {
      "preferred_label": "Vale de Escol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um vale perto de Hebrom onde os espias israelitas cortaram um grande cacho de uvas (Números 13:23–24)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bonde la Eshkoli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bonde lililo karibu na Hebroni ambapo wapelelezi wa Israeli walikata kishada kikubwa cha zabibu (Hesabu 13:23–24)."
        }
      ]
    },
    "apd": {
      "preferred_label": "وادي أشكول",
      "descriptions": [
        {
          "source": "acai",
          "description": "وادي قريب من حبرون، الجواسيس الإسرائيليين قطعوا منو عنقود عنب كبير (العدد 13: 23-24)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Vale ya Eskol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan vale klosap long Hebron we ol spae blong Israel oli katemaot wan bigfala bandel grep long hem (Namba 13:23–24)."
        }
      ]
    },
    "hin": {
      "preferred_label": "एशकोल की घाटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेब्रोन के पास एक घाटी जहाँ इस्राएली भेदिए ने दाखों का एक बड़ा गुच्छा तोड़ा था (गिनती 13:23–24)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndagwurugwu Eshkọl",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndagwurugwu dị nso na Hebrọn ebe ndị nledo Izrel gbutere nnukwu ụyọkọ mkpụrụ vaịn (Ọnụ Ọgụgụ 13:23–24)."
        }
      ]
    },
    "nep": {
      "preferred_label": "एश्कोलको बेँसी",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेब्रोननजिकैको एउटा बेँसी जहाँबाट इस्राएली जासुसहरूले दाखको एउटा ठूलो झुप्पा काटेका थिए (गन्ती १३:२३–२४)।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Долина Есхол",
      "descriptions": [
        {
          "source": "acai",
          "description": "Долина близ Хеврона, где израильские соглядатаи срезали большую виноградную кисть (Числа 13:23–24)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples daun bilong Eskol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples daun klostu long Hebron we ol spai bilong Israel i bin katim wanpela bikpela rop wain i gat planti pikinini wain long en (Namba 13:23–24)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thung lũng Ếch-côn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thung lũng gần Hếp-rôn nơi các thám tử Y-sơ-ra-ên cắt một chùm nho lớn (Dân số Ký 13:23–24)."
        }
      ]
    },
    "zht": {
      "preferred_label": "以實各谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "希伯崙附近的一個山谷，以色列探子在那裡砍下一大掛葡萄（民數記 13:23–24）。"
        }
      ]
    }
