          "gloss": "Dibon (of Moab)",
          "description": "A town in Moab said to be built by the tribe of Gad, but also attributed to the tribe of Reuben."
        }
      ]
    },
    "arb": {
      "preferred_label": "دِيبُون (موآب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في موآب قيل إن سبط جاد بناها، ونُسبت أيضًا إلى سبط رأوبين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "底本 (摩押)",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩押的一座城镇，据称由迦得支派建造，但也归于流便支派。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Dibon (de Moab)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une ville de Moab que la tribu de Gad aurait bâtie, mais également attribuée à la tribu de Ruben."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dibon (na Mowab)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gari a Mowab da aka ce ƙabilar Gad ta gina shi, amma kuma aka jingina shi ga ƙabilar Rouben."
        }
      ]
    },
    "hin": {
      "preferred_label": "दीबोन (मोआब का)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मोआब का एक नगर जिसे गाद के गोत्र द्वारा बसाया गया बताया गया है, परंतु इसका संबंध रूबेन के गोत्र से भी जोड़ा गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Dibon (Moab)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebuah kota di Moab yang dikatakan dibangun oleh suku Gad, tetapi juga dianggap milik suku Ruben."
        }
      ]
    },
    "por": {
      "preferred_label": "Dibom (de Moabe)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cidade em Moabe que teria sido edificada pela tribo de Gade, mas também atribuída à tribo de Rúben."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дивон (в Моаве)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Город в Моаве, построенный коленом Гада, но также приписываемый колену Рувима."
        }
      ]
    },
    "spa": {
      "preferred_label": "Dibón (de Moab)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ciudad de Moab que, según se dice, fue edificada por la tribu de Gad, pero también atribuida a la tribu de Rubén."
        }
      ]
    },
    "swh": {
      "preferred_label": "Diboni (wa Moabu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mji ulioko Moabu unaosemekana ulijengwa na kabila la Gadi, lakini pia unahusishwa na kabila la Reubeni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Dibon (bilong Moap)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela taun long Moap em ol i tok lain Gat i bin wokim, tasol tok i go tu long lain Ruben."
        }
      ]
    },
    "apd": {
      "preferred_label": "ديبون (بتاعة موآب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "بلدة في موآب اتقال إن سبط جاد بناها، لكن كمان اتنسبت لسبط رأوبين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Dibon (blong Moab)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan taon long Moab we oli talem se laen blong Gad i bin wokem, be oli talem tu se hem i blong laen blong Ruben."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Dibọn (nke Moab)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu obodo dị na Moab nke a sịrị na ọ bụ ebo Gad wuru ya, ma e kwukwara na ọ bụ nke ebo Ruben."
        }
      ]
    },
    "nep": {
      "preferred_label": "दीबोन (मोआबको)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मोआबको एउटा सहर, जसलाई गादको कुलले बनाएको भनिएको छ, तर रूबेनको कुललाई पनि श्रेय दिइएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Đi-bôn (thuộc Mô-áp)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thị trấn tại Mô-áp được cho là do bộ tộc Gát xây dựng, nhưng cũng được quy cho bộ tộc Ru-bên."
        }
      ]
    },
    "zht": {
      "preferred_label": "底本（摩押）",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩押境內的一座城鎮，據記載由迦得支派建造，但也歸屬於流便支派。"
        }
      ]
    }
  },
