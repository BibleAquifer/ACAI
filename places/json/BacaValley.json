    "zhs": {
      "preferred_label": "流泪谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "一处未知地点；该名称可能反映出香脂树的“流泪（即滴下树胶）”。"
        }
      ]
    },
    "fra": {
      "preferred_label": "vallée de Baca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un lieu inconnu ; le nom pourrait évoquer les « pleurs » (ou l'égouttement) des baumiers."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kwarin Baka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani wuri da ba a sani ba; watakila sunan yana nuna \\\"kuka (= ɗigowa)\\\" na itatuwan balsam."
        }
      ]
    },
    "ind": {
      "preferred_label": "Lembah Baka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lokasi yang tidak diketahui; namanya mungkin mencerminkan lelehan getah (\"tangisan\") pohon balsam."
        }
      ]
    },
    "por": {
      "preferred_label": "Vale de Baca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um local desconhecido; o nome pode refletir o \\\"choro (= gotejar)\\\" de bálsamos."
        }
      ]
    },
    "spa": {
      "preferred_label": "valle de Baca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lugar desconocido; el nombre puede reflejar el «llanto (= goteo)» de los bálsamos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bonde la Baka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahali pasipojulikana; huenda jina hili linaonyesha \\\"kulia (= kutona)\\\" kwa miti ya zeri."
        }
      ]
    },
    "apd": {
      "preferred_label": "وادي البكا",
      "descriptions": [
        {
          "source": "acai",
          "description": "مكان ما معروف؛ الاسم يمكن يكون بيشير لـ \\\"بُكا (= تَقاطُر)\\\" شجر البلسان."
        }
      ]
    },
    "arb": {
      "preferred_label": "وَادِي ٱلْبُكَاءِ",
      "descriptions": [
        {
          "source": "acai",
          "description": "موقع غير معروف؛ قد يعكس الاسم \"بكاء (= تقاطر)\" شجر البلسان."
        }
      ]
    },
    "bis": {
      "preferred_label": "krik ya Baka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ples we man i no save; maet nem ya i minim we ol wud ya balsam oli stap \\\"krae (= liglig)\\\"."
        }
      ]
    },
    "hin": {
      "preferred_label": "रोने की तराई",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अज्ञात स्थान; यह नाम संभवतः बलसान के पेड़ों के \\\"रोने (= टपकने)\\\" को दर्शाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndagwurugwu Baka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ebe a na-amaghị ebe ọ dị; aha ahụ nwere ike ịpụta \\\"ịkwa akwa (= ịwụfu mmiri)\\\" nke osisi bọlsam."
        }
      ]
    },
    "nep": {
      "preferred_label": "आँसुको बेँसी",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अज्ञात स्थान; यो नामले सम्भवतः सुगन्धित रुखहरूबाट \"आँसु चुहिएको (= थोपा खसेको)\" जनाउँछ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Долина плача",
      "descriptions": [
        {
          "source": "acai",
          "description": "Неизвестная местность; название, возможно, отражает «плач» (сочащуюся смолу) бальзамовых деревьев."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ples daun Baka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ples ol i no save gut long en; dispela nem ating i makim pasin bilong ol diwai balsam i save “krai (= tiktik wara)”."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thung Lũng Ba-ca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một địa điểm không rõ; tên gọi này có thể phản ánh sự \\\"than khóc (= nhỏ giọt)\\\" của cây ban-sam."
        }
      ]
    },
    "zht": {
      "preferred_label": "流淚谷",
      "descriptions": [
        {
          "source": "acai",
          "description": "一個未知的地點；該名稱可能反映了香脂樹的「流淚（=滴落）」。"
        }
      ]
    }
  },
