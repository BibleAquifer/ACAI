          "gloss": "Sandalwood",
          "article": "flora:Sandalwood",
          "description": "A large evergreen tree similar to cedar, known for its high-quality timber."
        }
      ]
    },
    "apd": {
      "preferred_label": "صندل",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة كبيرة دايمة الخضرة بتشبه الأرز، مشهورة بخشبها الممتاز وعالي الجودة."
        }
      ]
    },
    "arb": {
      "preferred_label": "صَنْدَل",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة كبيرة دائمة الخضرة تشبه الأرز، تشتهر بخشبها عالي الجودة."
        }
      ]
    },
    "bis": {
      "preferred_label": "sandalwud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala tri we lif blong hem i stap grin oltaem, we i klosap sem mak long sida, mo timba blong hem i gud we i gud tumas."
        }
      ]
    },
    "fra": {
      "preferred_label": "santal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grand arbre à feuilles persistantes semblable au cèdre, réputé pour son bois de grande qualité."
        }
      ]
    },
    "hau": {
      "preferred_label": "Almug",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata babbar bishiya mai kore a ko yaushe mai kama da itacen al’ul, wadda aka sani da itacenta mai inganci sosai."
        }
      ]
    },
    "hin": {
      "preferred_label": "चन्दन",
      "descriptions": [
        {
          "source": "acai",
          "description": "देवदार के समान एक विशाल सदाबहार वृक्ष, जो अपनी उच्च गुणवत्ता वाली लकड़ी के लिए जाना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "osisi algụm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu osisi na-adị akwụkwọ ndụ mgbe niile nke yiri osisi sida, nke a maara nke ọma maka osisi dị mma nke ukwuu a na-enweta na ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "kayu cendana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pohon besar hijau abadi mirip pohon aras, dikenal karena kayunya yang berkualitas tinggi."
        }
      ]
    },
    "nep": {
      "preferred_label": "चन्दन",
      "descriptions": [
        {
          "source": "acai",
          "description": "उच्च गुणस्तरको काठका लागि परिचित, देवदार जस्तै एक ठूलो सदाबहार रूख।"
        }
      ]
    },
    "por": {
      "preferred_label": "sândalo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma grande árvore perene semelhante ao cedro, conhecida por sua madeira de alta qualidade."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сандаловое дерево",
      "descriptions": [
        {
          "source": "acai",
          "description": "Большое вечнозеленое дерево, похожее на кедр, известное своей ценной древесиной."
        }
      ]
    },
    "spa": {
      "preferred_label": "sándalo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Árbol grande de hoja perenne semejante al cedro, conocido por su madera de gran calidad."
        }
      ]
    },
    "swh": {
      "preferred_label": "Msandali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mti mkubwa wenye majani ya kijani daima unaofanana na mwerezi, unaojulikana kwa mbao zake za ubora wa juu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "sandalwut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela diwai i wankain olsem sida, na ol i save amamas long gutpela plang bilong en."
        }
      ]
    },
    "vie": {
      "preferred_label": "cây đàn hương",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài cây gỗ lớn thường xanh tương tự như tuyết tùng, nổi tiếng vì gỗ có chất lượng cao."
        }
      ]
    },
    "zhs": {
      "preferred_label": "檀香木",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种类似香柏树的大型常绿乔木，以其优质木材闻名。"
        }
      ]
    },
    "zht": {
      "preferred_label": "檀香木",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種類似雪松的大型常綠喬木，以其優質木材聞名。"
        }
      ]
    }
  },
