  "localizations": {
    "eng": {
      "preferred_label": "Sorghum",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Sorghum",
          "article": "flora:Sorghum",
          "description": "A tall grass with grain used for food, fodder, and syrup."
        }
      ]
    },
    "apd": {
      "preferred_label": "درة",
      "descriptions": [
        {
          "source": "acai",
          "description": "قش طويل حبوبه بتستعمل في الأكل وعلف للحيوانات والشراب المركز."
        }
      ]
    },
    "arb": {
      "preferred_label": "ذُرَة بيضاء",
      "descriptions": [
        {
          "source": "acai",
          "description": "عشب طويل تُستخدم حبوبه للغذاء والعلف والشراب المركز."
        }
      ]
    },
    "bis": {
      "preferred_label": "sogum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan longfala gras we sid blong hem oli stap yusum blong mekem kakae, kakae blong anamol, mo sirop."
        }
      ]
    },
    "fra": {
      "preferred_label": "sorgho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grande graminée dont les grains sont utilisés pour l'alimentation, le fourrage et le sirop."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata doguwar ciyawa mai hatsi da ake amfani da ita don abinci, abincin dabbobi, da kuma zuma."
        }
      ]
    },
    "hin": {
      "preferred_label": "बाजरा (ज्वार)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक ऊँची घास जिसके अनाज का उपयोग भोजन, चारे और चाशनी के लिए किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "sọgụm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ahịhịa dị ogologo nke nwere mkpụrụ a na-eji eme nri, nri anụmanụ, na sirop."
        }
      ]
    },
    "ind": {
      "preferred_label": "sekoi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rumput tinggi dengan biji-bijian yang digunakan untuk makanan, pakan ternak, dan sirup."
        }
      ]
    },
    "nep": {
      "preferred_label": "जुनेलो",
      "descriptions": [
        {
          "source": "acai",
          "description": "आहारा, दाना र चास्नीका लागि अन्न प्रयोग गरिने एक अग्लो घाँस प्रजातिको बिरुवा।"
        }
      ]
    },
    "por": {
      "preferred_label": "sorgo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma gramínea alta com grãos usados para alimentação, forragem e xarope."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сорго",
      "descriptions": [
        {
          "source": "acai",
          "description": "Высокая злаковая трава, зерно которой используется в пищу, на корм скоту и для приготовления сиропа."
        }
      ]
    },
    "spa": {
      "preferred_label": "sorgo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hierba alta cuyo grano se utiliza como alimento, forraje y jarabe."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mtama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmea wa jamii ya nyasi ndefu wenye nafaka inayotumiwa kwa chakula, malisho na shira."
        }
      ]
    },
    "tpi": {
      "preferred_label": "sogum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela longpela gras i save karim ol sid bilong wokim kaikai bilong man na abus, na bilong mekim sopsop loli (syrup)."
        }
      ]
    },
    "vie": {
      "preferred_label": "lúa miến",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài cỏ cao có hạt được dùng làm thực phẩm, thức ăn gia súc và mật xi-rô."
        }
      ]
    },
    "zhs": {
      "preferred_label": "高粱",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种高大的草本植物，其谷物可用作食物、饲料和糖浆。"
        }
      ]
    },
    "zht": {
      "preferred_label": "高粱",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種高大的禾本科植物，其籽粒可用作糧食、飼料和糖漿。"
        }
      ]
    }
  },
