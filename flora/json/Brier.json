      "descriptions": [
        {
          "source": "acai",
          "gloss": "Brier",
          "article": "flora:Brier",
          "description": "A thorny plant or shrub often seen as a painful nuisance or obstacle, symbolizing hardship and neglect in the Bible."
        }
      ]
    },
    "apd": {
      "preferred_label": "شوك",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبات أو شجيرة شوكية بتتعبر عادةً كحاجة مزعجة ومؤلمة أو عائق، وبترمز للمشقة والإهمال في الكتاب المقدس."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَوْك",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبات أو شجيرة شائكة تُعد غالبًا مصدر إزعاج مؤلم أو عائقًا، وترمز إلى المشقة والإهمال في الكتاب المقدس."
        }
      ]
    },
    "bis": {
      "preferred_label": "ropnil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol tri o wan rop we i gat nil, we plante taem ol man oli luk olsem wan samting we i save givim soa o blokem rod, mo i saen blong hadtaem mo les fasin long Baebol."
        }
      ]
    },
    "fra": {
      "preferred_label": "ronce",
      "descriptions": [
        {
          "source": "acai",
          "description": "Plante ou arbuste épineux souvent perçu comme une gêne douloureuse ou un obstacle, symbolisant l’adversité et l’abandon dans la Bible."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sarƙaƙƙiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tsiro ko ƙaramin itace mai ƙaya da galibi ake ɗauka a matsayin abin damuwa ko cikas mai ciwo, wanda a Littafi Mai Tsarki yake alamta wahala da rashin kulawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "कँटीली झाड़ी",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक काँटेदार पौधा या झाड़ी जिसे अक्सर कष्टदायक उपद्रव या बाधा के रूप में देखा जाता है, जो बाइबल में कठिनाई और उपेक्षा का प्रतीक है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "uke",
      "descriptions": [
        {
          "source": "acai",
          "description": "Osisi maọbụ obere osisi nwere ogwu nke a na-ahụkarị dị ka ihe na-egbu mgbu maọbụ ihe mgbochi, na-anọchite anya mkpagbu na ileghara anya na Baịbụl."
        }
      ]
    },
    "ind": {
      "preferred_label": "puteri malu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuhan atau semak berduri yang sering dianggap sebagai gangguan atau rintangan yang menyakitkan, melambangkan kesukaran dan pengabaian di dalam Alkitab."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिउँडी",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः कष्टप्रद उपद्रव वा बाधाको रूपमा हेरिने एक काँडेदार वनस्पति वा झाडी, जसले बाइबलमा कष्ट र उपेक्षालाई संकेत गर्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "sarça",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma planta ou arbusto espinhoso muitas vezes visto como um incômodo doloroso ou obstáculo, simbolizando dificuldade e negligência na Bíblia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Терновник",
      "descriptions": [
        {
          "source": "acai",
          "description": "Колючее растение или кустарник, часто воспринимаемое как болезненная помеха или препятствие и символизирующее в Библии невзгоды и запустение."
        }
      ]
    },
    "spa": {
      "preferred_label": "zarza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Planta o arbusto espinoso a menudo considerado una molestia u obstáculo doloroso, que simboliza las penalidades y el abandono en la Biblia."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mchongoma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmea au kichaka chenye miiba ambacho mara nyingi huonwa kuwa kero chungu au kikwazo, kikifananisha ugumu wa maisha na kutelekezwa katika Biblia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "rop i gat nil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain plant o liklik diwai i gat nil em i save bagarapim wokabaut o givim pen long man, na long Baibel em i makim ol hevi na ples i stap nating."
        }
      ]
    },
    "vie": {
      "preferred_label": "gai gốc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại cây hoặc bụi cây có gai, thường được coi là vật cản trở hoặc gây đau đớn khó chịu, tượng trưng cho gian khổ và sự bỏ bê hoang phế trong Kinh Thánh."
        }
      ]
    },
    "zhs": {
      "preferred_label": "蒺藜",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种多刺的植物或灌木，常被视作令人痛苦的麻烦或障碍，在圣经中象征艰难与荒废。"
        }
      ]
    },
    "zht": {
      "preferred_label": "蒺藜",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種多刺的植物或灌木，常被視為令人痛苦的麻煩或障礙，在聖經中象徵著艱難與荒廢。"
        }
      ]
    }
  },
