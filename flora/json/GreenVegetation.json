  "localizations": {
    "eng": {
      "preferred_label": "Green Vegetation",
      "alternate_labels": [
        "Grass",
        "Leafy Vegetables"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Green Vegetation",
          "article": "flora:GreenVegetation",
          "description": "It refers to plants that are green and leafy, often used as food for both humans and animals."
        }
      ]
    },
    "apd": {
      "preferred_label": "خضار",
      "descriptions": [
        {
          "source": "acai",
          "description": "قاصد بيها النباتات الخضرة والمورقة، والغالباً بستعملوها كأكل للناس والحيوانات."
        }
      ]
    },
    "arb": {
      "preferred_label": "عُشْب أخضر",
      "descriptions": [
        {
          "source": "acai",
          "description": "يُشير إلى النباتات الخضراء المورقة، التي تُستخدَم غالبًا طعامًا للبشر والحيوانات على حدٍّ سواء."
        }
      ]
    },
    "bis": {
      "preferred_label": "grin plant",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hem i minim ol plant we oli grin mo oli gat lif, we ol man mo ol anamol oli stap kakae olgeta."
        }
      ]
    },
    "fra": {
      "preferred_label": "verdure",
      "descriptions": [
        {
          "source": "acai",
          "description": "Désigne des plantes vertes et feuillues, souvent utilisées comme nourriture pour les êtres humains et les animaux."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ciyawa mai ƙwaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yana nufin tsire-tsire masu korayen ganye, waɗanda galibi ake amfani da su a matsayin abinci ga mutane da dabbobi."
        }
      ]
    },
    "hin": {
      "preferred_label": "हरी घास",
      "descriptions": [
        {
          "source": "acai",
          "description": "यह उन पौधों को संदर्भित करता है जो हरे और पत्तेदार होते हैं, जिनका उपयोग अक्सर मनुष्यों और जानवरों दोनों के भोजन के रूप में किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ahịhịa ndụ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọ na-ezo aka nʼahịhịa ndụ ma nweekwa akwụkwọ ndụ, nke a na-ejikarị eme nri maka ma mmadụ ma ụmụ anụmanụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "tumbuh-tumbuhan hijau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ini mengacu pada tumbuhan yang hijau dan berdaun, yang sering digunakan sebagai makanan bagi manusia maupun hewan."
        }
      ]
    },
    "nep": {
      "preferred_label": "हरियो वनस्पति",
      "descriptions": [
        {
          "source": "acai",
          "description": "यसले हरिया र पातिला वनस्पतिहरूलाई बुझाउँछ, जुन प्रायः मानिस र पशु दुवैका निम्ति आहाराको रूपमा प्रयोग गरिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "vegetação verdejante",
      "descriptions": [
        {
          "source": "acai",
          "description": "Refere-se a plantas verdes e folhosas, frequentemente usadas como alimento tanto para seres humanos quanto para animais."
        }
      ]
    },
    "rus": {
      "preferred_label": "зелень",
      "descriptions": [
        {
          "source": "acai",
          "description": "Относится к зеленым облиственным растениям, часто служащим пищей как для людей, так и для животных."
        }
      ]
    },
    "spa": {
      "preferred_label": "vegetación verde",
      "descriptions": [
        {
          "source": "acai",
          "description": "Se refiere a las plantas verdes y frondosas, a menudo utilizadas como alimento tanto para los seres humanos como para los animales."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mimea ya Kijani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Inarejelea mimea ya kijani kibichi na yenye majani, mara nyingi hutumika kama chakula cha wanadamu na wanyama."
        }
      ]
    },
    "tpi": {
      "preferred_label": "gras na kumu samting",
      "descriptions": [
        {
          "source": "acai",
          "description": "Em i makim olkain samting i save kamap long graun we lip bilong ol i grin, na man wantaim ol animal i save kaikai."
        }
      ]
    },
    "vie": {
      "preferred_label": "thảo mộc xanh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chỉ các loài thực vật có màu xanh và nhiều lá, thường được dùng làm thức ăn cho cả con người và động vật."
        }
      ]
    },
    "zhs": {
      "preferred_label": "青草",
      "descriptions": [
        {
          "source": "acai",
          "description": "指绿色的多叶植物，常作为人类和动物的食物。"
        }
      ]
    },
    "zht": {
      "preferred_label": "青草",
      "descriptions": [
        {
          "source": "acai",
          "description": "指綠色多葉的植物，常作為人類和動物的食物。"
        }
      ]
    }
  },
