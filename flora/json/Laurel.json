  "localizations": {
    "eng": {
      "preferred_label": "Laurel",
      "alternate_labels": [
        "Bay Tree"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Laurel",
          "article": "flora:Laurel",
          "description": "A type of tree with leaves, flowers, and fruit, and its wood can be used for carving."
        }
      ]
    },
    "apd": {
      "preferred_label": "غار",
      "descriptions": [
        {
          "source": "acai",
          "description": "نوع من الشجر عندو ورق وزهور وتمر، والحتة الخشبية منو بتنفع للنحت."
        }
      ]
    },
    "arb": {
      "preferred_label": "غَار",
      "descriptions": [
        {
          "source": "acai",
          "description": "نَوْعٌ مِنَ ٱلْأَشْجَارِ لَهُ أَوْرَاقٌ وَأَزْهَارٌ وَثِمَارٌ، وَيُمْكِنُ ٱسْتِخْدَامُ خَشَبِهِ فِي ٱلنَّحْتِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "samblong",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kaen tri we i gat ol lif, ol flaoa, mo ol frut, mo man i save yusum wud blong hem blong katem ol pija o kaving."
        }
      ]
    },
    "fra": {
      "preferred_label": "laurier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un type d’arbre pourvu de feuilles, de fleurs et de fruits, et dont le bois peut être utilisé pour la sculpture."
        }
      ]
    },
    "hau": {
      "preferred_label": "Loreli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani irin itace ne mai ganye, da furanni, da ’ya’ya, wanda kuma ana iya amfani da itacensa wajen yin sassaƙa."
        }
      ]
    },
    "hin": {
      "preferred_label": "लॉरेल (तेजपत्ता वृक्ष)",
      "descriptions": [
        {
          "source": "acai",
          "description": "पत्तियों, फूलों और फलों वाला एक प्रकार का वृक्ष, जिसकी लकड़ी का उपयोग नक्काशी के लिए किया जा सकता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Osisi fịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụdị osisi nwere akwụkwọ ndụ, ifuru, na mkpụrụ, a pụkwara iji osisi ya mee ihe a tụrụ atụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "pohon salam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sejenis pohon dengan daun, bunga, dan buah, yang kayunya dapat digunakan untuk mengukir."
        }
      ]
    },
    "nep": {
      "preferred_label": "लरेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "पात, फूल र फल लाग्ने एक प्रकारको रूख, जसको काठ काष्ठकला वा नक्काशीका निम्ति प्रयोग गर्न सकिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "loureiro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um tipo de árvore com folhas, flores e frutos, cuja madeira pode ser usada para entalhe."
        }
      ]
    },
    "rus": {
      "preferred_label": "Лавр",
      "descriptions": [
        {
          "source": "acai",
          "description": "Разновидность дерева с листьями, цветами и плодами, древесина которого может использоваться для резьбы."
        }
      ]
    },
    "spa": {
      "preferred_label": "laurel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tipo de árbol con hojas, flores y frutos, cuya madera puede utilizarse para tallar."
        }
      ]
    },
    "swh": {
      "preferred_label": "Lori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aina ya mti wenye majani, maua, na matunda, na mbao zake zinaweza kutumika kwa kuchonga."
        }
      ]
    },
    "tpi": {
      "preferred_label": "diwai lorel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain diwai i gat lip, plaua, na pikinini, na ol man inap yusim diwai bilong en bilong sapim ol samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây nguyệt quế",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại cây có lá, hoa và quả, và gỗ của nó có thể dùng để chạm khắc."
        }
      ]
    },
    "zhs": {
      "preferred_label": "月桂树",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种有叶、花和果实的树木，其木材可用于雕刻。"
        }
      ]
    },
    "zht": {
      "preferred_label": "月桂",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種有葉、花和果實的樹木，其木材可用於雕刻。"
        }
      ]
    }
  },
