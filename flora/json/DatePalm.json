  "localizations": {
    "eng": {
      "preferred_label": "Date Palm",
      "alternate_labels": [
        "Palm Branch",
        "Palm Tree",
        "Dates"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Date Palm",
          "article": "flora:DatePalm",
          "description": "A tall tree that grows 10-20 meters high, with large leaves at the top and sweet, edible fruits about the size of a thumb, known as dates."
        }
      ]
    },
    "apd": {
      "preferred_label": "نخلة",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة طويلة بطول من 10 لـ 20 متر، عندها ورق كبير فوق وثمار حلوة بتتاكل في حجم الإبهام معروفة بالتمر (البلح)."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَخْلَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرةٌ طويلةٌ يبلُغُ ارتفاعُها بينَ 10 إلى 20 مترًا، ذاتُ أوراقٍ كبيرةٍ في قمَّتِها وثِمارٍ حُلوةٍ صالحةٍ للأكلِ بِحجمِ الإبهامِ تقريبًا، تُعرَفُ بالتَّمرِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "pamtri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hae tri we i gru kasem 10–20 meta hae, wetem ol bigfala lif long antap mo ol swit kakae we man i save kakae, we saes blong olgeta i olsem tom, we oli singaot se det."
        }
      ]
    },
    "fra": {
      "preferred_label": "palmier dattier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un grand arbre qui atteint 10 à 20 mètres de hauteur, pourvu de grandes feuilles à son sommet et de fruits sucrés et comestibles d'environ la taille d'un pouce, appelés dattes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Dabino",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dogon itace da yake yin tsawon mita 10-20, mai manyan ganyaye a samansa da kuma zaƙaƙan ’ya’yan marmari da ake ci masu girman babban ɗan yatsa, da aka sani da dabino."
        }
      ]
    },
    "hin": {
      "preferred_label": "खजूर का पेड़",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक ऊँचा पेड़ जो 10-20 मीटर ऊँचा होता है, जिसके शीर्ष पर बड़े पत्ते और अँगूठे के आकार के मीठे, खाने योग्य फल होते हैं, जिन्हें खजूर कहा जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "nkwụ deeti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ogologo osisi na-eto mita 10-20 nʼogologo, nke nwere nnukwu igu nʼelu ya na mkpụrụ na-atọ ụtọ, a na-eri eri nke ruru nha mkpisi aka ukwu, nke a maara dị ka deeti."
        }
      ]
    },
    "ind": {
      "preferred_label": "pohon kurma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pohon tinggi yang tumbuh 10–20 meter, dengan daun besar di bagian atas dan buah manis yang dapat dimakan seukuran ibu jari, yang dikenal sebagai kurma."
        }
      ]
    },
    "nep": {
      "preferred_label": "खजुर",
      "descriptions": [
        {
          "source": "acai",
          "description": "१०-२० मिटर अग्लो हुने एउटा रूख, जसको टुप्पोमा ठूला पातहरू र बुढीऔंलाको आकारको खजुर भनिने मीठो, खान मिल्ने फल लाग्दछ।"
        }
      ]
    },
    "por": {
      "preferred_label": "tamareira",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma árvore alta que cresce de 10 a 20 metros de altura, com folhas grandes no topo e frutos doces e comestíveis do tamanho aproximado de um polegar, conhecidos como tâmaras."
        }
      ]
    },
    "rus": {
      "preferred_label": "Финиковая пальма",
      "descriptions": [
        {
          "source": "acai",
          "description": "Высокое дерево высотой 10–20 метров с крупными листьями на вершине и сладкими съедобными плодами размером примерно с большой палец, известными как финики."
        }
      ]
    },
    "spa": {
      "preferred_label": "palmera datilera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Árbol alto que alcanza de 10 a 20 metros de altura, con grandes hojas en la copa y frutos dulces y comestibles del tamaño de un pulgar, conocidos como dátiles."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mtende",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mti mrefu unaokua kwa urefu wa mita 10-20, wenye majani makubwa juu na matunda matamu yanayoliwa ya ukubwa wa kidole gumba, yanayojulikana kama tende."
        }
      ]
    },
    "tpi": {
      "preferred_label": "diwai det",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela longpela diwai pam i save kamap longpela inap 10-20 mita, i gat bikpela lip long het bilong en na switpela pikinini olsem bikpela bilong nambis bilong han we ol i save kolim det."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây chà là",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cây thân gỗ cao từ 10–20 mét, ngọn có các tán lá lớn và cho quả ngọt ăn được cỡ ngón tay cái, gọi là quả chà là."
        }
      ]
    },
    "zhs": {
      "preferred_label": "棕树",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种高达10至20米的高大乔木，顶部有大叶，结拇指大小的香甜可食果实，称为海枣。"
        }
      ]
    },
    "zht": {
      "preferred_label": "棗椰樹",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種高達10至20公尺的高大樹木，頂部有大型葉片，結拇指大小、香甜可食的果實，稱為椰棗。"
        }
      ]
    }
  },
