        }
      ]
    },
    "hin": {
      "preferred_label": "बिच्छू पेड़",
      "descriptions": [
        {
          "source": "acai",
          "description": "जंगल में उगने वाला एक काँटेदार पौधा, जिसे अक्सर बेकार और अनाकर्षक माना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Uke",
      "descriptions": [
        {
          "source": "acai",
          "description": "Osisi nwere ogwu nke na-epu nʼọzara ma a na-elekarị ya anya dị ka ihe na-abaghị uru ma na-adịghị mma ile anya."
        }
      ]
    },
    "ind": {
      "preferred_label": "onak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuhan berduri yang tumbuh di padang gurun dan sering dianggap tidak berguna serta tidak menarik."
        }
      ]
    },
    "nep": {
      "preferred_label": "काँढाघारी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मरुभूमिमा उम्रने एउटा काँडेदार वनस्पति, जसलाई प्रायः बेकामको र अनाकर्षक मानिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "cardo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma planta espinhosa que cresce em terrenos ermos e costuma ser vista como inútil e desagradável."
        }
      ]
    },
    "rus": {
      "preferred_label": "Чертополох",
      "descriptions": [
        {
          "source": "acai",
          "description": "Колючее растение, растущее в дикой местности и часто считающееся бесполезным и непривлекательным."
        }
      ]
    },
    "spa": {
      "preferred_label": "cardo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Planta espinosa que crece en el desierto y a menudo se considera inútil y poco atractiva."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mchongoma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmea wenye miiba unaoota nyikani na mara nyingi huonwa kuwa hauna faida wala mvuto."
        }
      ]
    },
    "tpi": {
      "preferred_label": "rop i gat nil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain gras o rop i gat nil we i save grou long ples drai na bus nating, na ol man i save ting em i samting nating na i no naispela."
        }
      ]
    },
    "vie": {
      "preferred_label": "cây kế",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại cây có gai mọc ở vùng hoang dã và thường được xem là vô dụng và xấu xí."
        }
      ]
    },
    "zhs": {
      "preferred_label": "蒺藜",
      "descriptions": [
        {
