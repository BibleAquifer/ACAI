  "localizations": {
    "eng": {
      "preferred_label": "Acacia",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Acacia",
          "article": "flora:Acacia",
          "description": "A desert tree with sharp spines, small pale yellow flowers, and twisted bean pods; its wood is often used for building."
        }
      ]
    },
    "apd": {
      "preferred_label": "سنط",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة صحراوية فيها شوك حاد وزهور صغيرة لونها أصفر باهت وقرون ملتوية؛ خشبها غالباً بيستعمل للبناء."
        }
      ]
    },
    "arb": {
      "preferred_label": "سنط",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة صحراوية ذات أشواك حادة وأزهار صفراء شاحبة صغيرة وقرون ملتوية تشبه الفاصولياء، وغالبًا ما يُستخدم خشبها في البناء."
        }
      ]
    },
    "bis": {
      "preferred_label": "kasis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tri blong draeples we i gat ol sap nil, smosmol yelo flaoa, mo ol bin pot we oli tantanem; wud blong hem oli stap yusum plante taem blong bildim haos."
        }
      ]
    },
    "fra": {
      "preferred_label": "acacia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un arbre du désert doté d'épines acérées, de petites fleurs jaune pâle et de gousses torsadées ; son bois est souvent employé dans la construction."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ƙirya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Itacen hamada mai ƙayoyi masu kaifi, da ƙananan furanni masu launin rawaya mai haske, da kwasan ’ya’ya karkatattu; ana yawan amfani da itacensa wajen gini."
        }
      ]
    },
    "hin": {
      "preferred_label": "बबूल",
      "descriptions": [
        {
          "source": "acai",
          "description": "नुकीले काँटों, हल्के पीले रंग के छोटे फूलों और मुड़ी हुई फलियों वाला एक रेगिस्तानी पेड़; इसकी लकड़ी अक्सर निर्माण कार्य में प्रयोग की जाती है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Akashia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Osisi ọzara nwere ogwu dị nkọ, obere okooko osisi na-acha odo odo na-achachaghị acha, na mkpụrụ dị ka agwa gbagọrọ agbagọ; a na-ejikarị osisi ya arụ ihe."
        }
      ]
    },
    "ind": {
      "preferred_label": "penaga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pohon padang gurun berduri tajam, berbunga kecil kuning pucat, dan memiliki polong berpilin; kayunya sering digunakan untuk bahan bangunan."
        }
      ]
    },
    "nep": {
      "preferred_label": "बबुल",
      "descriptions": [
        {
          "source": "acai",
          "description": "तीखा काँडाहरू, साना हल्का पहेँला फूलहरू र बटारिएका कोसाहरू भएको मरुभूमिको रूख; यसको काठ प्रायः निर्माण कार्यका लागि प्रयोग गरिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "acácia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma árvore do deserto com espinhos afiados, pequenas flores amarelo-claras e vagens retorcidas; sua madeira é frequentemente usada para construção."
        }
      ]
    },
    "rus": {
      "preferred_label": "Акация",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пустынное дерево с острыми шипами, мелкими бледно-желтыми цветками и скрученными стручками; его древесина часто использовалась для строительства."
        }
      ]
    },
    "spa": {
      "preferred_label": "acacia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Árbol del desierto con espinas afiladas, pequeñas flores de color amarillo pálido y vainas retorcidas; su madera se utiliza a menudo para la construcción."
        }
      ]
    },
    "swh": {
      "preferred_label": "mshita",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mti wa jangwani wenye miiba mikali, maua madogo ya manjano yaliyopauka, na maganda ya mbegu yaliyopotoka; mbao zake mara nyingi hutumiwa kwa ujenzi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Diwai akas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela diwai bilong ples drai nating i gat ol sapnil, ol liklik yelo plaua, na ol pikinini bin i krungut; ol i save yusim plang bilong en bilong wokim haus na ol samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây keo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại cây sa mạc có gai nhọn, hoa nhỏ màu vàng nhạt và quả đậu xoắn; gỗ của cây này thường được dùng để đóng đồ và xây cất."
        }
      ]
    },
    "zhs": {
      "preferred_label": "皂荚木",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种沙漠树木，带有尖刺、浅黄色小花和扭曲的豆荚；其木材常用于建筑建造。"
        }
      ]
    },
    "zht": {
      "preferred_label": "皂莢木",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種長有尖刺、淡黃色小花和扭曲豆莢的沙漠樹木；其木材常用於建造。"
        }
      ]
    }
  },
