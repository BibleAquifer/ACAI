  "localizations": {
    "eng": {
      "preferred_label": "Boxthorn",
      "alternate_labels": [
        "Bramble",
        "Thorn",
        "Thornbush"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Boxthorn",
          "article": "flora:Boxthorn",
          "description": "A thorny tree that grows up to 5 meters tall with small oval leaves and very sharp thorns."
        }
      ]
    },
    "apd": {
      "preferred_label": "عوسج",
      "descriptions": [
        {
          "source": "acai",
          "description": "شدرة شوكية بتكبر لحدي 5 أمتار، عندها ورق بيضاوي صغير وشوك حاد شديد."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَوْسَج",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة شائكة تنمو حتى يصل ارتفاعها إلى 5 أمتار بأوراق بيضاوية صغيرة وأشواك حادة جدًا."
        }
      ]
    },
    "bis": {
      "preferred_label": "piko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tri we i gat nil we i save gru go kasem 5 mita long hae blong hem, we ol lif blong hem i smosmol mo ol nil blong hem oli sap tumas."
        }
      ]
    },
    "fra": {
      "preferred_label": "buisson d'épines",
      "descriptions": [
        {
          "source": "acai",
          "description": "Arbre épineux pouvant atteindre 5 mètres de hauteur, aux petites feuilles ovales et aux épines très acérées."
        }
      ]
    },
    "hau": {
      "preferred_label": "Itacen ƙaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Itace mai ƙaya da yake girma har ya kai tsayin mita 5 mai ƙanana kuma kewayayyun ganyaye da ƙayayuwa masu kaifi ƙwarai."
        }
      ]
    },
    "hin": {
      "preferred_label": "झड़बेरी",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक काँटेदार वृक्ष जो 5 मीटर तक ऊँचा होता है, जिसकी छोटी अंडाकार पत्तियाँ और बहुत नुकीले काँटे होते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ogwu ọhịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Osisi nwere ogwu nke na-eto ruo mita ise nʼogologo, nwee obere akwụkwọ ndị gbara gburugburu dị ka àkwá na ogwu dị ezigbo nko."
        }
      ]
    },
    "ind": {
      "preferred_label": "semak duri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pohon berduri yang tumbuh hingga setinggi 5 meter dengan daun-daun kecil berbentuk bulat telur dan duri-duri yang sangat tajam."
        }
      ]
    },
    "nep": {
      "preferred_label": "काँढाको झाडी",
      "descriptions": [
        {
          "source": "acai",
          "description": "साना अन्डाकार पातहरू र धेरै तीखा काँढाहरू भएको, ५ मिटरसम्म अग्लो हुने एक काँडेदार रूख।"
        }
      ]
    },
    "por": {
      "preferred_label": "espinheiro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma árvore espinhosa que atinge até 5 metros de altura, com pequenas folhas ovais e espinhos muito pontiagudos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дереза",
      "descriptions": [
        {
          "source": "acai",
          "description": "Колючее дерево высотой до 5 метров с мелкими овальными листьями и очень острыми шипами."
        }
      ]
    },
    "spa": {
      "preferred_label": "cambrón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Árbol o arbusto espinoso que crece hasta 5 metros de altura con hojas ovaladas pequeñas y espinas muy afiladas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mti wa miiba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mti wenye miiba unaokua hadi kufikia urefu wa mita 5 wenye majani madogo ya mviringo na miiba mikali sana."
        }
      ]
    },
    "tpi": {
      "preferred_label": "liklik diwai i gat nil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela diwai i gat nil em i save gro inap 5 mita longpela wantaim ol liklik raunpela lip na ol sappela nil tru."
        }
      ]
    },
    "vie": {
      "preferred_label": "cây gai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại cây bụi có gai cao tới 5 mét với những chiếc lá nhỏ hình bầu dục và gai rất nhọn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "黑刺李",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种多刺的树木，可长至5米高，长有椭圆形小叶和非常锋利的刺。"
        }
      ]
    },
    "zht": {
      "preferred_label": "黑刺李",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種高達5公尺的多刺樹木，具有橢圓形的小葉和非常鋒利的刺。"
        }
      ]
    }
  },
