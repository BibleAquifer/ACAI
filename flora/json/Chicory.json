        }
      ]
    },
    "apd": {
      "preferred_label": "أعشاب مرة",
      "descriptions": [
        {
          "source": "acai",
          "description": "كتير بتتاكل في عيد الفصح اليهودي، وبتستعمل في الطبخ والعلاج."
        }
      ]
    },
    "arb": {
      "preferred_label": "أعشاب مُرَّة",
      "descriptions": [
        {
          "source": "acai",
          "description": "تؤكل غالبًا في أثناء الفصح اليهودي، وتُستخدم في الطهي والطب."
        }
      ]
    },
    "bis": {
      "preferred_label": "lif we i konkon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol lif gras we plante taem ol man Jiu oli stap kakae long Pasova, mo oli yusum tu blong kuki mo meresin."
        }
      ]
    },
    "fra": {
      "preferred_label": "herbes amères",
      "descriptions": [
        {
          "source": "acai",
          "description": "Souvent consommées pendant la Pâque juive, et utilisées en cuisine et en médecine."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ganyaye masu ɗaci",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sau da yawa ana cin sa a lokacin bikin Ƙetarewa na Yahudawa, kuma ana amfani da shi wajen girki da magani."
        }
      ]
    },
    "hin": {
      "preferred_label": "कड़वे सागपात",
      "descriptions": [
        {
          "source": "acai",
          "description": "अक्सर यहूदियों के फसह के पर्व के दौरान खाया जाता है, और भोजन पकाने तथा दवा के रूप में उपयोग किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ahịhịa na-elu ilu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nke a na-erikarị nʼoge Ememme Ngabiga nke ndị Juu, a na-ejikwa ya esi nri ma na-eme ọgwụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "sayur pahit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sering dimakan selama Paskah Yahudi, serta digunakan dalam masakan dan obat-obatan."
        }
      ]
    },
    "nep": {
      "preferred_label": "तितो साग",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः यहूदीहरूको निस्तार-चाडको समयमा खाइने र खाना पकाउन तथा औषधिमा प्रयोग गरिने वनस्पति।"
        }
      ]
    },
    "por": {
      "preferred_label": "ervas amargas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Frequentemente comidas durante a Páscoa judaica e usadas na culinária e na medicina."
        }
      ]
    },
    "rus": {
      "preferred_label": "Горькие травы",
      "descriptions": [
        {
          "source": "acai",
          "description": "Часто употребляются в пищу во время еврейской Пасхи, а также используются в кулинарии и медицине."
        }
      ]
    },
    "spa": {
      "preferred_label": "hierbas amargas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Se consumen a menudo durante la Pascua judía y se usan en la cocina y en la medicina."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mboga chungu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mara nyingi huliwa wakati wa Pasaka ya Kiyahudi, na hutumiwa katika mapishi na dawa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "kumu i pait",
      "descriptions": [
        {
          "source": "acai",
          "description": "Planti taim ol i save kaikai dispela long taim bilong Pasova bilong ol Juda, na ol i save yusim long kuk na long marasin."
        }
      ]
    },
    "vie": {
      "preferred_label": "Rau đắng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thường được ăn trong Lễ Vượt Qua của người Do Thái, và được dùng trong nấu nướng cũng như y học."
        }
      ]
    },
    "zhs": {
      "preferred_label": "苦菜",
      "descriptions": [
        {
          "source": "acai",
          "description": "常在犹太人逾越节期间食用，也用于烹饪和药用。"
        }
      ]
    },
    "zht": {
      "preferred_label": "苦菜",
      "descriptions": [
        {
          "source": "acai",
          "description": "常在猶太人逾越節期間食用，也用於烹飪和醫藥。"
        }
      ]
    }
  },
