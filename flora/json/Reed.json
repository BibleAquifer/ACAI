  "localizations": {
    "eng": {
      "preferred_label": "Reed",
      "alternate_labels": [
        "Straw",
        "Thatch"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Reed",
          "article": "flora:Reed",
          "description": "A tall grass, over 2 meters high, that grows in lakes and streams, used for making various items like baskets, mats, and flutes."
        }
      ]
    },
    "apd": {
      "preferred_label": "بوص",
      "descriptions": [
        {
          "source": "acai",
          "description": "قش طويل، طوله أكتر من مترين، بينبت في البحيرات ومجاري الموية، وبيستعملوه لعمل حاجات كتيرة زي القفف والحُصر والمزامير."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَصَب",
      "descriptions": [
        {
          "source": "acai",
          "description": "عشب طويل يتجاوز ارتفاعه المترين، ينمو في البحيرات ومجاري المياه، ويُستخدم في صناعة أدوات مختلفة مثل السلال والحُصر والمزامير."
        }
      ]
    },
    "bis": {
      "preferred_label": "waelken",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan longfala gras, we i save gru antap bitim 2 meta, we i stap gru long ol lek mo krik, mo man i stap yusum blong mekem ol difren samting olsem basket, mat, mo flut."
        }
      ]
    },
    "fra": {
      "preferred_label": "roseau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Haute graminée de plus de 2 mètres de haut, poussant dans les lacs et les cours d'eau, utilisée pour confectionner divers objets comme des corbeilles, des nattes et des flûtes."
        }
      ]
    },
    "hau": {
      "preferred_label": "Iwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata doguwar ciyawa, mai tsayin fiye da mita 2, wadda take girma a tafkuna da rafuka, wadda ake amfani da ita wajen yin abubuwa daban-daban kamar kwanduna, tabarmi, da sarewa."
        }
      ]
    },
    "hin": {
      "preferred_label": "सरकण्डा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक ऊँची घास, जो 2 मीटर से अधिक ऊँची होती है और झीलों तथा नालों में उगती है, जिसका उपयोग टोकरियाँ, चटाइयाँ और बाँसुरी जैसी विभिन्न वस्तुएँ बनाने के लिए किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "achara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụdị ahịhịa dị ogologo, nke na-eto karịa mita abụọ n'ogologo, nke na-epu n'ọdọ mmiri na iyi, nke a na-eji akpa ngwongwo dị iche iche dịka nkata, ute, na ọjà."
        }
      ]
    },
    "ind": {
      "preferred_label": "buluh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rumput tinggi, setinggi lebih dari 2 meter, yang tumbuh di danau dan aliran air, digunakan untuk membuat berbagai barang seperti keranjang, tikar, dan seruling."
        }
      ]
    },
    "nep": {
      "preferred_label": "निगालो",
      "descriptions": [
        {
          "source": "acai",
          "description": "ताल र खोलाहरूमा २ मिटरभन्दा अग्लो हुने एक अग्लो घाँस, जसको प्रयोग टोकरी, गुन्द्री र बाँसुरी जस्ता विभिन्न वस्तुहरू बनाउन गरिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "caniço",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma gramínea alta, com mais de 2 metros de altura, que cresce em lagos e riachos, usada para fazer vários itens, como cestos, esteiras e flautas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Трость",
      "descriptions": [
        {
          "source": "acai",
          "description": "Высокая трава более 2 метров высотой, растущая в озерах и ручьях, используемая для изготовления различных предметов, таких как корзины, циновки и свирели."
        }
      ]
    },
    "spa": {
      "preferred_label": "caña",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hierba alta, de más de 2 metros de altura, que crece en lagos y arroyos, utilizada para fabricar diversos artículos como cestas, esteras y flautas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwanzi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmea wa jamii ya nyasi ndefu, wenye urefu wa zaidi ya mita 2, unaoota katika maziwa na vijito, na hutumiwa kutengeneza vitu mbalimbali kama vile vikapu, mikeka na filimbi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "pitpit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela longpela gras o kavingka i save go antap winim 2 mita na i save gro long ol raunwara na wara, na ol i save yusim bilong wokim ol basket, mat, na mambu bilong winim."
        }
      ]
    },
    "vie": {
      "preferred_label": "cây sậy",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài cỏ cao, trên 2 mét, mọc ở các hồ và suối, được dùng để làm nhiều vật dụng như giỏ, chiếu và sáo."
        }
      ]
    },
    "zhs": {
      "preferred_label": "芦苇",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种生长在湖泊和溪流中的高大草本植物，高逾两米，可用于制作篮子、席子和笛子等各种物品。"
        }
      ]
    },
    "zht": {
      "preferred_label": "蘆葦",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種高達兩公尺以上的高大禾本科植物，生長於湖泊和溪流中，可用於製作籃子、席子和笛子等各種物品。"
        }
      ]
    }
  },
