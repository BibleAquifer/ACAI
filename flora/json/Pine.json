  "flora_type": "Wild Trees and Shrubs",
  "ubsdbh": [
    "007936001001000"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Stone Pine",
      "alternate_labels": [
        "Stone Pine"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Stone Pine",
          "article": "flora:Pine",
          "description": "A tree that can grow up to 10 meters tall, often has an umbrella-like shape, and produces edible seeds."
        }
      ]
    },
    "apd": {
      "preferred_label": "صنوبر ثمري",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة ممكن يوصل طولها لحدي 10 أمتار، شكلها غالباً بشبه المظلة، وبتنتج بذور بتتاكل."
        }
      ]
    },
    "arb": {
      "preferred_label": "صَنَوْبَر ثَمَرِيّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة قد يصل ارتفاعها إلى 10 أمتار، وغالبًا ما تتخذ شكل المظلة وتنتج بذورًا صالحة للأكل."
        }
      ]
    },
    "bis": {
      "preferred_label": "ston paen",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan tri we i save gru kasem 10 meta long heved blong hem, we plante taem i luk olsem wan ambrela, mo i karem ol sid we man i save kakae."
        }
      ]
    },
    "fra": {
      "preferred_label": "pin parasol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Arbre pouvant atteindre 10 mètres de hauteur, souvent en forme de parasol, qui produit des graines comestibles."
        }
      ]
    },
    "hau": {
      "preferred_label": "Itacen fir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Itace ne mai iya girma har tsawon mita 10, yakan kasance da siffar laima, kuma yana fitar da ’ya’ya masu cinwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "स्टोन पाइन",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक वृक्ष जो 10 मीटर तक ऊँचा हो सकता है, अक्सर छतरी के आकार का होता है, और खाद्य बीज उत्पन्न करता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "osisi paịn nkume",
      "descriptions": [
        {
          "source": "acai",
          "description": "Osisi nke nwere ike ito ruo mita 10 nʼogologo, nke na-enwekarị ọdịdị dị ka ncheanwụ, ma na-amị mkpụrụ a na-eri eri."
        }
      ]
    },
    "ind": {
      "preferred_label": "pinus payung",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pohon yang dapat tumbuh hingga 10 meter tingginya, sering kali berbentuk menyerupai payung, dan menghasilkan biji yang dapat dimakan."
        }
      ]
    },
    "nep": {
      "preferred_label": "ढुङ्गे सल्ला",
      "descriptions": [
        {
          "source": "acai",
          "description": "१० मिटरसम्म अग्लो हुन सक्ने, प्रायः छाता आकारको हुने र खानयोग्य बीउ फल्ने एउटा रूख।"
        }
      ]
    },
    "por": {
      "preferred_label": "pinheiro-manso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma árvore que pode atingir até 10 metros de altura, frequentemente tem a forma de guarda-chuva e produz sementes comestíveis."
        }
      ]
    },
    "rus": {
      "preferred_label": "Итальянская сосна",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дерево высотой до 10 метров, часто зонтиковидной формы, дающее съедобные семена."
        }
      ]
    },
    "spa": {
      "preferred_label": "pino piñonero",
      "descriptions": [
        {
          "source": "acai",
          "description": "Árbol que puede alcanzar hasta 10 metros de altura, a menudo tiene forma de sombrilla y produce semillas comestibles."
        }
      ]
    },
    "swh": {
      "preferred_label": "Msunobari wa Mawe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mti unaoweza kukua hadi kufikia urefu wa mita 10, mara nyingi huwa na umbo kama la mwavuli, na huzaa mbegu zinazoliwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ston pain",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain diwai pain i ken kamap longpela inap 10-pela mita, planti taim em i luk olsem ambrela, na i save karim ol pikinini ol man i ken kaikai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây thông đá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại cây có thể cao tới 10 mét, thường có hình dạng giống như chiếc dù và sinh hạt ăn được."
        }
      ]
    },
    "zhs": {
      "preferred_label": "石松",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种可高达10米的树木，通常呈伞状，并结出可食用的种子。"
        }
      ]
    },
    "zht": {
      "preferred_label": "義大利石松",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種高達10公尺的樹木，常呈傘狀樹冠，能結出可食用的種子。"
        }
      ]
    }
  },
  "possibly_same_as": [
