  "localizations": {
    "eng": {
      "preferred_label": "Phoenician Juniper",
      "alternate_labels": [
        "Cedar"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Phoenician Juniper",
          "article": "flora:JuniperTree",
          "description": "A short shrub or tree that can grow up to 5 meters, with small, tough leaves and tiny berry-like cones."
        }
      ]
    },
    "apd": {
      "preferred_label": "عرعر فينيقي",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجيرة أو شجرة قصيرة ممكن تطول لحد خمسة أمتار، عندها ورق صغير وقوي ومخاريط صغيرة بتشبه التوت."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَرْعَر فينيقي",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجيرة قصيرة أو شجرة يمكن أن تنمو حتى خمسة أمتار، ذات أوراق صغيرة قاسية ومخاريط صغيرة تشبه التوت."
        }
      ]
    },
    "bis": {
      "preferred_label": "junipa blong Fonisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol tri we i save gro kasem 5 mita, i gat ol smolsmol lif we oli strong mo ol smolsmol kon olsem beri."
        }
      ]
    },
    "fra": {
      "preferred_label": "genévrier de Phénicie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un arbuste ou petit arbre pouvant atteindre 5 mètres de haut, aux petites feuilles coriaces et aux cônes minuscules semblables à des baies."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yunifa na Finikiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani ɗan gajeren tsiro ne ko itace da zai iya girma har mita 5, mai ƙanana kuma taurin ganyaye da ƙananan ’ya’ya masu kama da beri."
        }
      ]
    },
    "hin": {
      "preferred_label": "फोनीशियन सनोवर",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक छोटी झाड़ी या पेड़ जो 5 मीटर तक बढ़ सकता है, जिसकी छोटी, सख्त पत्तियां और बेरी जैसे छोटे शंकु होते हैं।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "junipa Fonisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Obere osisi dị mkpụmkpụ nke nwere ike ito ruo mita ise, nwee obere akwụkwọ siri ike na obere mkpụrụ yiri beri."
        }
      ]
    },
    "ind": {
      "preferred_label": "sanobar Fenisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Semak atau pohon pendek yang dapat tumbuh hingga 5 meter, dengan daun-daun kecil yang kaku serta runjung kecil menyerupai buah beri."
        }
      ]
    },
    "nep": {
      "preferred_label": "फिनिसियाली धुपी",
      "descriptions": [
        {
          "source": "acai",
          "description": "एउटा होचो पोथ्रा वा रूख जुन ५ मिटरसम्म अग्लो हुन सक्छ, जसमा साना, कडा पातहरू र साना फलजस्ता कोनहरू हुन्छन्।"
        }
      ]
    },
    "por": {
      "preferred_label": "zimbro-da-fenícia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um arbusto baixo ou árvore que pode crescer até 5 metros, com folhas pequenas e duras e cones minúsculos semelhantes a bagas."
        }
      ]
    },
    "rus": {
      "preferred_label": "можжевельник красноплодный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Невысокий кустарник или дерево высотой до 5 метров с мелкими жесткими листьями и крошечными ягодообразными шишками."
        }
      ]
    },
    "spa": {
      "preferred_label": "enebro fenicio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Arbusto o árbol bajo que puede alcanzar hasta 5 metros de altura, con hojas pequeñas y resistentes y conos diminutos semejantes a bayas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Msunobari wa Foinike",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kichaka au mti mfupi unaoweza kufikia urefu wa mita 5, wenye majani madogo, magumu na koni ndogo zinazofanana na beri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "diwai junipa bilong Fonisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela sotpela liklik diwai inap go antap inap 5 mita, em i gat liklik strongpela lip wantaim liklik pikinini olsem beri."
        }
      ]
    },
    "vie": {
      "preferred_label": "cây bách Phê-ni-xi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại cây bụi hoặc cây gỗ thấp có thể cao tới 5 mét, với lá nhỏ, dai và các quả nón nhỏ giống như quả mọng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "腓尼基桧",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种可长至5米高的矮灌木或乔木，叶小而坚韧，结微小的浆果状球果。"
        }
      ]
    },
    "zht": {
      "preferred_label": "腓尼基刺柏",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種矮小的灌木或喬木，高可達5公尺，具有堅韌的小葉和微小的漿果狀毬果。"
        }
      ]
    }
  },
