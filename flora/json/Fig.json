  "localizations": {
    "eng": {
      "preferred_label": "Fig",
      "alternate_labels": [
        "Early Fig",
        "Fig Tree",
        "Late Fig"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Fig",
          "article": "flora:Fig",
          "description": "A fig is the sweet, soft fruit of a fig tree, which grows 5-8 meters tall with deep roots and produces fruit that can be green, yellow, purple, or brown."
        }
      ]
    },
    "apd": {
      "preferred_label": "تين",
      "descriptions": [
        {
          "source": "acai",
          "description": "التين هو الثمرة الحلوة واللينة لشجرة التين، البتنمو بارتفاع بين 5 لـ 8 أمتار وعندها جذور عميقة وبتنتج ثمر لونو أخضر أو أصفر أو بنفسجي أو بني."
        }
      ]
    },
    "arb": {
      "preferred_label": "تِين",
      "descriptions": [
        {
          "source": "acai",
          "description": "التين هو الثمرة الحلوة والطرية لشجرة التين، التي تنمو بارتفاع يتراوح بين 5 إلى 8 أمتار وتتميز بجذور عميقة، وتنتج ثماراً يمكن أن تكون خضراء أو صفراء أو أرجوانية أو بنية."
        }
      ]
    },
    "bis": {
      "preferred_label": "fig",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan fig i frut blong wan figtri we i swit mo i sofsof, we tri ya i stap gru 5 kasem 8 mita long hae mo rus blong hem i go dip long graon, mo frut blong hem i save grin, yalo, pepol, o braon."
        }
      ]
    },
    "fra": {
      "preferred_label": "figue",
      "descriptions": [
        {
          "source": "acai",
          "description": "La figue est le fruit doux et sucré du figuier, un arbre de 5 à 8 mètres de haut aux racines profondes qui produit des fruits pouvant être verts, jaunes, violets ou bruns."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ɓaure",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɓaure shi ne ɗa mai zaƙi da taushi na itacen ɓaure, wanda yake girma tsawon mita 5-8 tare da saiwa masu zurfi kuma yana ba da ’ya’ya waɗanda za su iya zama kore, rawaya, shuɗi mai duhu, ko ruwan ƙasa."
        }
      ]
    },
    "hin": {
      "preferred_label": "अंजीर",
      "descriptions": [
        {
          "source": "acai",
          "description": "अंजीर, अंजीर के पेड़ का मीठा, गूदेदार फल है, जो गहरी जड़ों के साथ 5-8 मीटर ऊँचा बढ़ता है और हरा, पीला, बैंगनी या भूरा फल देता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "fiig",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fiig bụ mkpụrụ osisi fiig dị nro ma na-atọ ụtọ, nke na-eto mita 5 ruo 8 n'ogologo nwee mgbọrọgwụ dị omimi ma na-amị mkpụrụ nwere ike ịcha akwụkwọ ndụ, odo odo, odo-uhie ma ọ bụ nchara nchara."
        }
      ]
    },
    "ind": {
      "preferred_label": "ara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ara adalah buah manis dan lunak dari pohon ara, yang tumbuh setinggi 5–8 meter dengan akar yang dalam serta menghasilkan buah yang dapat berwarna hijau, kuning, ungu, atau cokelat."
        }
      ]
    },
    "nep": {
      "preferred_label": "अञ्जीर",
      "descriptions": [
        {
          "source": "acai",
          "description": "अञ्जीर अञ्जीरको रूखको मीठो, नरम फल हो, जुन गहिरो जरा भएर ५-८ मिटर अग्लो हुन्छ र हरियो, पहेंलो, बैजनी वा खैरो फल फलाउँछ।"
        }
      ]
    },
    "por": {
      "preferred_label": "figo",
      "descriptions": [
        {
          "source": "acai",
          "description": "O figo é o fruto doce e macio da figueira, árvore que cresce de 5 a 8 metros de altura com raízes profundas e produz frutos que podem ser verdes, amarelos, roxos ou marrons."
        }
      ]
    },
    "rus": {
      "preferred_label": "Смоква",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сладкий, мягкий плод смоковницы (инжира) — дерева высотой 5–8 метров с глубокими корнями, приносящего плоды зеленого, желтого, фиолетового или коричневого цвета."
        }
      ]
    },
    "spa": {
      "preferred_label": "higo",
      "descriptions": [
        {
          "source": "acai",
          "description": "El higo es el fruto dulce y blando de la higuera, un árbol que alcanza de 5 a 8 metros de altura con raíces profundas y produce frutos que pueden ser verdes, amarillos, morados o marrones."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tini ni tunda tamu na laini la mtini, unaokua kwa kimo cha mita 5–8 ukiwa na mizizi mirefu na kuzaa matunda yanayoweza kuwa ya rangi ya kijani, njano, zambarau, au kahawia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "fik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fik em i switpela na sof-pela pikinini bilong diwai fik, em i save gro 5 inap 8 mita longpela wantaim ol strongpela rop bilong en, na em i save karim ol pikinini i ken i stap grin, yelo, pepol, o braun."
        }
      ]
    },
    "vie": {
      "preferred_label": "Trái vả",
      "descriptions": [
        {
          "source": "acai",
          "description": "Trái vả là loại quả ngọt, mềm của cây vả—loài cây cao từ 5–8 mét với rễ ăn sâu và sinh ra quả có thể mang màu xanh, vàng, tím hoặc nâu."
        }
      ]
    },
    "zhs": {
      "preferred_label": "无花果",
      "descriptions": [
        {
          "source": "acai",
          "description": "无花果是无花果树香甜柔软的果实，树高5至8米，根系深，结出的果实可为绿色、黄色、紫色或褐色。"
        }
      ]
    },
    "zht": {
      "preferred_label": "無花果",
      "descriptions": [
        {
          "source": "acai",
          "description": "無花果是無花果樹甜美柔軟的果實。無花果樹高約五至八公尺，根系發達，所結的果實呈綠色、黃色、紫色或棕色。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
