  "localizations": {
    "eng": {
      "preferred_label": "Oak",
      "alternate_labels": [
        "Oak of More",
        "Oaks of Mamre",
        "Diviner's Oak",
        "Oak of Tabor",
        "Oak Tree"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Oak",
          "article": "flora:Oak",
          "description": "A large tree often found in clumps or forests. In ancient times, it was used a landmark or a gathering place."
        }
      ]
    },
    "apd": {
      "preferred_label": "شجرة بلوط",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة كبيرة غالباً بتلقاها في مجموعات أو غابات. في الأزمنة القديمة كانت بتستعمل كعلامة للطريق أو مكان للتجمع."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَلُّوط",
      "descriptions": [
        {
          "source": "acai",
          "description": "شَجَرَةٌ كَبِيرَةٌ غَالِبًا مَا تُوجَدُ فِي مَجْمُوعَاتٍ أَوْ غَابَاتٍ. وَفِي ٱلْعُصُورِ ٱلْقَدِيمَةِ، كَانَتْ تُسْتَخْدَمُ كَمَعْلَمٍ بَارِزٍ أَوْ مَكَانٍ لِلِٱجْتِمَاعِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Oktri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bigfala tri we plante taem oli stap gru tugeta no long bus. Long taem bifo, oli stap yusum blong makem ol ples no wan ples blong miting."
        }
      ]
    },
    "fra": {
      "preferred_label": "chêne",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grand arbre que l'on trouve souvent en bosquets ou en forêts. Dans l'Antiquité, il servait de point de repère ou de lieu de rassemblement."
        }
      ]
    },
    "hau": {
      "preferred_label": "Oak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban itace wanda galibi ake samunsa a rukuni ko a kurmi. A zamanin dā, ana amfani da shi a matsayin alamar iyakar wuri ko wurin taruwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "बांज वृक्ष",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक बड़ा वृक्ष जो अक्सर झुंडों या जंगलों में पाया जाता है। प्राचीन काल में, इसका उपयोग सीमा-चिह्न या सभा स्थल के रूप में किया जाता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Osisi ook",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nnukwu osisi a na-ahụkarị nʼìgwè ma ọ bụ nʼoké ọhịa. Nʼoge ochie, a na-eji ya eme ihe dị ka ihe ịrịba ama ma ọ bụ ebe mgbakọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "pohon ek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pohon besar yang sering ditemukan dalam rumpun atau hutan. Pada zaman kuno, pohon ini digunakan sebagai tengara atau tempat berkumpul."
        }
      ]
    },
    "nep": {
      "preferred_label": "फलाँट",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रायः झाडी वा जङ्गलमा पाइने एउटा ठूलो रुख। प्राचीन समयमा यसलाई सीमाचिह्न वा भेला हुने ठाउँको रूपमा प्रयोग गरिन्थ्यो।"
        }
      ]
    },
    "por": {
      "preferred_label": "carvalho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma árvore de grande porte frequentemente encontrada em bosques ou florestas. Na antiguidade, era usada como marco de referência ou local de reunião."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дуб",
      "descriptions": [
        {
          "source": "acai",
          "description": "Крупное дерево, часто растущее группами или лесами. В древние времена служило ориентиром или местом собраний."
        }
      ]
    },
    "spa": {
      "preferred_label": "roble",
      "descriptions": [
        {
          "source": "acai",
          "description": "Árbol grande que a menudo se encuentra en grupos o bosques. En la antigüedad, se utilizaba como punto de referencia o lugar de reunión."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwaloni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mti mkubwa ambao mara nyingi hupatikana katika mafungu au misitu. Katika nyakati za kale, ulitumiwa kama alama ya ardhi au mahali pa kukusanyikia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Diwai ok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela diwai em planti taim i save stap long ol bikbus. Long bipo, ol i save yusim olsem mak bilong ples o ples bilong bung."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây sồi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài cây lớn thường mọc thành bụi rậm hoặc rừng cây. Vào thời cổ đại, cây thường được dùng làm cột mốc hoặc nơi hội họp."
        }
      ]
    },
    "zhs": {
      "preferred_label": "橡树",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种大型树木，常见于树丛或森林中。在古代，它被用作地标或聚会场所。"
        }
      ]
    },
    "zht": {
      "preferred_label": "橡樹",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種常成叢或成林生長的大樹。在古代常被用作地標或聚會場所。"
        }
      ]
    }
  },
