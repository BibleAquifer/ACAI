  ],
  "localizations": {
    "eng": {
      "preferred_label": "Myrrh",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Myrrh",
          "article": "flora:Myrrh",
          "description": "A resin from a small, thorny bush with leaves in sets of three. It has oval fruits, used in oil and perfume."
        }
      ]
    },
    "apd": {
      "preferred_label": "مر",
      "descriptions": [
        {
          "source": "acai",
          "description": "صمغ من شجيرة صغيرة وشوكية ورقها بيطلع في مجموعات تلاتية. عندها ثمار بيضاوية، وبيستعمل في الزيت والعطور."
        }
      ]
    },
    "arb": {
      "preferred_label": "مُرّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "صمغ راتنجي من شجيرة صغيرة شائكة ذات أوراق ثلاثية، ولها ثمار بيضاوية، ويُستخدم في الزيت والعطور."
        }
      ]
    },
    "bis": {
      "preferred_label": "mir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan dresing o rasin we i kamaot long wan smol katen bus we i gat busong wetem trifala lif long wan brens. Hem i gat ol oval frut, mo oli stap yusum long oel mo smel samting."
        }
      ]
    },
    "fra": {
      "preferred_label": "myrrhe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Résine issue d'un petit arbuste épineux à feuilles groupées par trois, portant des fruits ovales, utilisée dans l'huile et le parfum."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kankara ne ko danko daga wani ɗan ƙaramin kurmi mai ƙaya mai ganye a rukuni na uku. Yana da 'ya'ya masu siffar ƙwai, waɗanda ake amfani da su a cikin mai da turare."
        }
      ]
    },
    "hin": {
      "preferred_label": "गन्धरस",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक छोटे, काँटेदार झाड़ से निकलने वाला गोंद/राल जिसकी पत्तियाँ तीन-तीन के समूह में होती हैं। इसके फल अण्डाकार होते हैं, और इसका उपयोग तेल तथा इत्र में किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "máá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkpụrụ osisi ma ọ bụ eso na-esi n'obere osisi nwere ogwu na-epulite nke nwere akwụkwọ dị atọ atọ. Ọ na-amị mkpụrụ dị gburugburu dị ogologo, nke a na-eji eme mmanụ na ihe na-esi isi ụtọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "mur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Damar dari semak berduri kecil berdaun majemuk tiga. Tumbuhan ini berbuah bulat telur, dan damarnya digunakan dalam minyak serta minyak wangi."
        }
      ]
    },
    "nep": {
      "preferred_label": "मूर्र",
      "descriptions": [
        {
          "source": "acai",
          "description": "तीन-तीनवटा पातहरू हुने काँडेदार सानो पोथ्राबाट निस्कने चोप (खोटो)। यसमा अण्डाकार फलहरू लाग्छन्, र यो तेल तथा अत्तरमा प्रयोग गरिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "mirra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma resina de um arbusto pequeno e espinhoso com folhas trifoliadas. Possui frutos ovais e era usada em óleos e perfumes."
        }
      ]
    },
    "rus": {
      "preferred_label": "Смирна",
      "descriptions": [
        {
          "source": "acai",
          "description": "Смола небольшого колючего кустарника с тройчатыми листьями. Имеет овальные плоды; используется в маслах и благовониях."
        }
      ]
    },
    "spa": {
      "preferred_label": "mirra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Resina de un arbusto pequeño y espinoso con hojas trifoliadas. Tiene frutos ovalados y se utilizaba en aceites y perfumes."
        }
      ]
    },
    "swh": {
      "preferred_label": "Manemane",
      "descriptions": [
        {
          "source": "acai",
          "description": "Utomvu kutoka kwenye kichaka kidogo chenye miiba na majani katika mafungu ya matatu matatu. Ina matunda yenye umbo la yai, yanayotumika katika mafuta na manukato."
        }
      ]
    },
    "tpi": {
      "preferred_label": "sanda mea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela wel o blut i kamap long wanpela liklik rop o diwai i gat nil na ol lip i save kamap tripela tripela. Em i gat ol raunpela pikinini, na ol i save yusim long wokim wel na sanda."
        }
      ]
    },
    "vie": {
      "preferred_label": "Một dược",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chất nhựa từ một loại cây bụi nhỏ, có gai với lá mọc cụm ba lá. Cây có quả hình bầu dục, được dùng làm dầu thơm và nước hoa."
        }
      ]
    },
    "zhs": {
      "preferred_label": "没药",
      "descriptions": [
        {
          "source": "acai",
          "description": "来自一种三出复叶的小型多刺灌木的树脂。具有卵形果实，用于香膏和香水。"
        }
      ]
    },
    "zht": {
      "preferred_label": "沒藥",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種取自帶刺小灌木的樹脂，該灌木長有三出複葉並結卵形果實，其樹脂用於香油和香水。"
        }
      ]
    }
  },
