  "localizations": {
    "eng": {
      "preferred_label": "Balsam Tree",
      "alternate_labels": [
        "Aspen Tree",
        "Poplar",
        "Opobalsamum"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Balsam Tree",
          "article": "flora:BalsamTree",
          "description": "It grows up to 3 meters tall and produces a valuable fragrant resin used in anointing oil, medicine, and perfume."
        }
      ]
    },
    "apd": {
      "preferred_label": "شجرة البلسم",
      "descriptions": [
        {
          "source": "acai",
          "description": "بيطول لحد 3 أمتار وبيطلع صمغ عطري قيّم بيُستعمل في زيت المسحة، الدواء، والعطور."
        }
      ]
    },
    "arb": {
      "preferred_label": "شجر البلسان",
      "descriptions": [
        {
          "source": "acai",
          "description": "تنمو حتى يصل ارتفاعها إلى 3 أمتار وتنتج صمغًا عطريًا ثمينًا يُستخدم في دهن المسحة والطب والعطور."
        }
      ]
    },
    "bis": {
      "preferred_label": "tri ya balsam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tri ya i save gru kasem 3 mita hae mo i karem wan gudfala melek we i gat naesfala smel we oli stap yusum long tabu oel, meresin, mo senta."
        }
      ]
    },
    "fra": {
      "preferred_label": "baumier",
      "descriptions": [
        {
          "source": "acai",
          "description": "Arbre pouvant atteindre 3 mètres de haut, qui produit une résine parfumée de grande valeur utilisée pour l’huile d’onction, la médecine et le parfum."
        }
      ]
    },
    "hau": {
      "preferred_label": "Itacen Balsam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yana girma har ya kai mita 3 tsayi kuma yana fitar da ƙaro mai daraja da ƙanshi wanda ake amfani da shi a cikin man shafe, magani, da turare."
        }
      ]
    },
    "hin": {
      "preferred_label": "बलसान का वृक्ष",
      "descriptions": [
        {
          "source": "acai",
          "description": "यह 3 मीटर तक ऊँचा होता है और इससे एक मूल्यवान सुगंधित गोंद/राल प्राप्त होती है जिसका उपयोग अभिषेक के तेल, औषधि और इत्र में किया जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "osisi bọlsam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọ na-eto ruo mita atọ nʼogologo, na-amịpụtakwa eso bara uru na-esi isi ụtọ nke a na-eji na mmanụ nsọ, ọgwụ, na ihe na-esi isi ụtọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "pohon balsam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pohon ini tumbuh setinggi hingga 3 meter dan menghasilkan damar wangi berharga yang digunakan dalam minyak urapan, obat-obatan, dan minyak wangi."
        }
      ]
    },
    "nep": {
      "preferred_label": "बलसानको रूख",
      "descriptions": [
        {
          "source": "acai",
          "description": "यो ३ मिटरसम्म अग्लो हुन्छ र यसले अभिषेक गर्ने तेल, औषधि र अत्तरमा प्रयोग हुने बहुमूल्य सुगन्धित चोप उत्पादन गर्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "balsameiro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cresce até 3 metros de altura e produz uma valiosa resina aromática usada em óleos de unção, remédios e perfumes."
        }
      ]
    },
    "rus": {
      "preferred_label": "Бальзамное дерево",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вырастает до 3 метров в высоту и дает ценную благовонную смолу, используемую для елея помазания, в медицине и парфюмерии."
        }
      ]
    },
    "spa": {
      "preferred_label": "balsamero",
      "descriptions": [
        {
          "source": "acai",
          "description": "Crece hasta 3 metros de altura y produce una valiosa resina aromática utilizada en el aceite de la unción, en la medicina y en los perfumes."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mti wa zeri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hukua hadi kufikia urefu wa mita 3 na hutoa utomvu wa thamani wenye harufu nzuri unaotumiwa katika mafuta ya upako, dawa, na manukato."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Diwai balsom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Em i save kamap longpela inap 3-pela mita na i save kamapim wanpela blut i gat gutpela smel na bikpela pe bilong en, em ol i save yusim long wel bilong bilas o bilong makim ol samting, long marasin, na long sent i gat smel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây một dược",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cây cao đến 3 mét và tiết ra chất nhựa thơm quý giá được dùng làm dầu xức, thuốc và dầu thơm."
        }
      ]
    },
    "zhs": {
      "preferred_label": "香脂树",
      "descriptions": [
        {
          "source": "acai",
          "description": "它可高达3米，产生珍贵的芳香树脂，用于制作膏油、药物和香水。"
        }
      ]
    },
    "zht": {
      "preferred_label": "香脂樹",
      "descriptions": [
        {
          "source": "acai",
          "description": "可高達3公尺，能產出珍貴的芳香樹脂，用於膏油、醫藥和香料。"
        }
      ]
    }
  },
