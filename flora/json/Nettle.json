    "eng": {
      "preferred_label": "Nettle",
      "alternate_labels": [
        "Nettles",
        "Thornbush"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Nettle",
          "article": "flora:Nettle",
          "description": "A plant with stinging hairs that can cause pain and is often considered a weed."
        }
      ]
    },
    "apd": {
      "preferred_label": "قريص",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبات عنده شوك بيقرص وممكن يسبب ألم وغالباً بيعتبروه من الشوك أو العشب الضار."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَرِيص",
      "descriptions": [
        {
          "source": "acai",
          "description": "نَبَاتٌ ذُو شُعَيْرَاتٍ لَاذِعَةٍ تَتَسَبَّبُ فِي ٱلْأَلَمِ، وَغَالِبًا مَا يُعَدُّ عُشْبًا ضَارًّا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ropnil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan plant we i gat ol nilsakwe long hem we i save givim soa, mo plante taem ol man oli tingbaot hem olsem grasnogud."
        }
      ]
    },
    "fra": {
      "preferred_label": "ortie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Plante munie de poils urticants pouvant provoquer de la douleur et souvent considérée comme une mauvaise herbe."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sarƙaƙƙiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tsiron da ke da gashin harbi wanda zai iya jawo ciwo kuma galibi ana ɗaukarsa a matsayin sarƙaƙƙiya ko ciyawar banza."
        }
      ]
    },
    "hin": {
      "preferred_label": "बिच्छू बूटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "डंक मारने वाले काँटों वाला एक पौधा जो दर्द का कारण बन सकता है और इसे अक्सर एक खरपतवार माना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Uke",
      "descriptions": [
        {
          "source": "acai",
          "description": "Osisi na-adị mma nʼanya nwere ajị na-agba mmadụ nke na-akpata ihe mgbu, a na-ewerekwa ya dị ka uke ma ọ bụ ahịhịa na-abaghị uru."
        }
      ]
    },
    "ind": {
      "preferred_label": "jelatang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuhan dengan rambut-rambut penyengat yang dapat menimbulkan rasa sakit dan sering dianggap sebagai gulma."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिस्नु",
      "descriptions": [
        {
          "source": "acai",
          "description": "घोच्ने रौँहरू भएको वनस्पति जसले पीडा दिन्छ र यसलाई अक्सर झार मानिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "urtiga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma planta com pelos urticantes que podem causar dor, frequentemente considerada uma erva daninha."
        }
      ]
    },
    "rus": {
      "preferred_label": "Крапива",
      "descriptions": [
        {
          "source": "acai",
          "description": "Растение со жгучими волосками, способными вызывать боль; часто считается сорняком."
        }
      ]
    },
    "spa": {
      "preferred_label": "ortiga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Planta con pelos urticantes que pueden causar dolor y que a menudo se considera una mala hierba."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uwasha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmea wenye miiba inayochoma na kuwasha ambayo inaweza kusababisha maumivu, na mara nyingi huhesabiwa kuwa gugu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rop i gat nil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela gras o liklik diwai i gat ol nil bilong paitim skin na inap givim pen, na planti taim ol i tingim olsem gras nogut."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cây tầm ma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loại cây có lông châm gây đau nhức và thường bị coi là cỏ dại."
        }
      ]
    },
    "zhs": {
      "preferred_label": "荨麻",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种带有蜇毛的植物，能引起疼痛，通常被视为杂草。"
        }
      ]
    },
    "zht": {
      "preferred_label": "蕁麻",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種長有刺毛、能引起疼痛的植物，常被視為雜草。"
        }
      ]
    }
  },
