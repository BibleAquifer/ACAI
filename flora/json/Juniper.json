  "localizations": {
    "eng": {
      "preferred_label": "Grecian Juniper",
      "alternate_labels": [
        "Cypress",
        "Fir"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Grecian Juniper",
          "article": "flora:Juniper",
          "description": "An evergreen tree from Lebanon with round leaves and fleshy cones, often considered one of the region’s finest trees."
        }
      ]
    },
    "apd": {
      "preferred_label": "عرعر يوناني",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة دايمة الخضرة من لبنان، أوراقها مدورة ومخاريطها لحمية، وكتير بعتبروها من أحسن الشجر في المنطقة."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَرْعَر يوناني",
      "descriptions": [
        {
          "source": "acai",
          "description": "شجرة دائمة الخضرة من لبنان ذات أوراق مستديرة ومخاريط لحمية، تُعَد غالبًا إحدى أجود أشجار المنطقة."
        }
      ]
    },
    "bis": {
      "preferred_label": "junipa blong Gris",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kaen paentri we i stap stap grin oltaem, i kam long Lebanon mo i gat ol raon lif mo ol kon we oli gat mit, we plante taem oli tingbaot hem olsem wan nambawan tri blong eria ya."
        }
      ]
    },
    "fra": {
      "preferred_label": "genévrier de Grèce",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un arbre à feuilles persistantes du Liban, aux feuilles rondes et aux cônes charnus, souvent considéré comme l’un des plus beaux arbres de la région."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yunifa na Hellas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani tsiro ne mai korayen ganye a ko da yaushe daga Lebanon mai zagayen ganyaye da kuma ƙwayoyi masu ƙiba, wanda galibi ake ɗaukarsa a matsayin ɗaya daga cikin mafi kyawun itatuwa na yankin."
        }
      ]
    },
    "hin": {
      "preferred_label": "ग्रीक सनोवर",
      "descriptions": [
        {
          "source": "acai",
          "description": "लेबनान का एक सदाबहार पेड़ जिसकी पत्तियां गोल और शंकु गूदेदार होते हैं, जिसे अक्सर इस क्षेत्र के सबसे बेहतरीन पेड़ों में से एक माना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "junipa Gris",
      "descriptions": [
        {
          "source": "acai",
          "description": "Osisi na-anọgide na-acha akwụkwọ ndụ nke sitere na Lebanọn nke nwere akwụkwọ dị okirikiri na mkpụrụ dị nro, nke a na-ewerekarị dịka otu nʼime osisi kachasị mma nʼógbè ahụ."
        }
      ]
    },
    "ind": {
      "preferred_label": "sanobar Yunani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pohon malar hijau dari Libanon dengan daun bundar dan runjung berdaging, sering kali dianggap sebagai salah satu pohon terbaik di wilayah tersebut."
        }
      ]
    },
    "nep": {
      "preferred_label": "ग्रीक धुपी",
      "descriptions": [
        {
          "source": "acai",
          "description": "लेबनानमा पाइने गोलो पात र बाक्ला फलजस्ता कोनहरू हुने सदाबहार रूख, जसलाई प्रायः त्यस क्षेत्रका उत्कृष्ट रूखहरूमध्ये एक मानिन्छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "zimbro-da-grécia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma árvore perene do Líbano com folhas arredondadas e cones carnosos, frequentemente considerada uma das árvores mais nobres da região."
        }
      ]
    },
    "rus": {
      "preferred_label": "можжевельник греческий",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вечнозеленое дерево из Ливана с округлыми чешуевидными листьями и мясистыми шишкоягодами, часто считавшееся одним из лучших деревьев региона."
        }
      ]
    },
    "spa": {
      "preferred_label": "enebro griego",
      "descriptions": [
        {
          "source": "acai",
          "description": "Árbol perenne del Líbano con hojas redondeadas y conos carnosos, considerado a menudo uno de los mejores árboles de la región."
        }
      ]
    },
    "swh": {
      "preferred_label": "Msunobari wa Ugiriki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mti unaobaki na majani mabichi daima kutoka Lebanoni wenye majani ya mviringo na koni zenye nyama, mara nyingi huhesabiwa kuwa mmoja wa miti bora zaidi ya eneo hilo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "diwai junipa bilong Gris",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kain diwai pain bilong Lebanon we lip bilong en i no save drai na pundaun, em i gat raunpela lip na liklik kaikai olsem kon, na planti man i tingim em olsem wanpela nambawan diwai bilong dispela hap."
        }
      ]
    },
    "vie": {
      "preferred_label": "cây bách Hy Lạp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài cây thường xanh từ Li-ban có lá tròn và nón mọng thịt, thường được coi là một trong những loài cây đẹp nhất vùng."
        }
      ]
    },
    "zhs": {
      "preferred_label": "希腊桧",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种产自黎巴嫩的常绿乔木，叶片圆润，结肉质球果，常被视为该地区最优美的树木之一。"
        }
      ]
    },
    "zht": {
      "preferred_label": "希臘刺柏",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種產自黎巴嫩的常綠喬木，具有圓形葉和肉質毬果，常被認為是該地區最優良的樹木之一。"
        }
      ]
    }
  },
