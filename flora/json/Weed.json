  "localizations": {
    "eng": {
      "preferred_label": "Weed",
      "alternate_labels": [
        "Weeds",
        "Rotten Fruit",
        "Darnel"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Weed",
          "article": "flora:Weed",
          "description": "An unwanted plant that looks like wheat but has poisonous seeds and is usually bad-smelling and inedible."
        }
      ]
    },
    "apd": {
      "preferred_label": "زوان",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبتة ما مرغوب فيها بتشبه القمح لكن بذورها سامة، وغالباً ريحتها كعبة وما بتتاكل."
        }
      ]
    },
    "arb": {
      "preferred_label": "زَوَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبات غير مرغوب فيه يشبه الحنطة، لكن بذوره سامة ويكون عادة كريه الرائحة وغير صالح للأكل."
        }
      ]
    },
    "bis": {
      "preferred_label": "rabis gras",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan rabis gras we i luk olsem wit be ol sid blong hem oli posen, mo klosap oltaem i smel nogud mo man i no save kakae."
        }
      ]
    },
    "fra": {
      "preferred_label": "ivraie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Plante indésirable qui ressemble au blé mais dont les graines sont toxiques, et qui est généralement malodorante et non comestible."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ciyawa marar amfani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tsiro marar so wadda take kama da alkama amma take da ’ya’ya masu dafi, kuma yawanci tana da wari mara daɗi kuma ba a iya cinta ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "जंगली बीज",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अवांछित पौधा जो गेहूँ जैसा दिखता है लेकिन इसके बीज विषैले होते हैं, और यह आमतौर पर दुर्गंधयुक्त तथा अखाद्य होता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ahịhịa ọjọọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ahịhịa na-achọghị nke yiri ọka wiiti ma nwee mkpụrụ na-egbu egbu, na-esikwa ísì ọjọọ ma ghara ịbụ ihe a na-eri eri."
        }
      ]
    },
    "ind": {
      "preferred_label": "lalang",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuhan liar yang tidak diinginkan yang menyerupai gandum tetapi berbiji beracun, biasanya berbau busuk dan tidak dapat dimakan."
        }
      ]
    },
    "nep": {
      "preferred_label": "सामा",
      "descriptions": [
        {
          "source": "acai",
          "description": "गहुँजस्तै देखिने तर विषाक्त बीउ भएको, सामान्यतया दुर्गन्धित र खान नहुने एक अवाञ्छित झार।"
        }
      ]
    },
    "por": {
      "preferred_label": "joio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Planta indesejável que se parece com o trigo, mas tem sementes venenosas e geralmente tem mau cheiro e não é comestível."
        }
      ]
    },
    "rus": {
      "preferred_label": "Плевел",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сорное растение, похожее на пшеницу, но с ядовитыми семенами; обычно имеет неприятный запах и несъедобно."
        }
      ]
    },
    "spa": {
      "preferred_label": "cizaña",
      "descriptions": [
        {
          "source": "acai",
          "description": "Planta no deseada que se parece al trigo pero tiene semillas venenosas y generalmente tiene mal olor y no es comestible."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gugu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmea usiotakiwa unaofanana na ngano lakini una mbegu zenye sumu na kwa kawaida una harufu mbaya na haufai kuliwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "gras nogut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela samting nogut i save kamap long gaden na i luk olsem wit, tasol em i gat pikinini i gat posin na em i sting na man i no inap kaikai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cỏ lùng",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một loài thực vật không mong muốn trông giống như lúa mì nhưng có hạt độc, thường có mùi hôi và không ăn được."
        }
      ]
    },
    "zhs": {
      "preferred_label": "毒麦",
      "descriptions": [
        {
          "source": "acai",
          "description": "一种不受欢迎的植物，外表类似小麦，但种子有毒，通常气味难闻且不能食用。"
        }
      ]
    },
    "zht": {
      "preferred_label": "稗子",
      "descriptions": [
        {
          "source": "acai",
          "description": "一種外觀似小麥但種子有毒的不良植物，通常帶有臭味且不可食用。"
        }
      ]
    }
  },
