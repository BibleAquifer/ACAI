        }
      ]
    },
    "arb": {
      "preferred_label": "أَجُور",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل حكيم من فترة المملكة الموحدة لإسرائيل، وهو ابن متقية، ومذكور في سفر الأمثال."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚古珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列联合王国时期的一位智者，雅基的儿子，见于《箴言》。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Agur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mai hikima a lokacin haɗin kan masarautar Isra’ila, ɗan Yake, wanda aka ambata a Misalai."
        }
      ]
    },
    "hin": {
      "preferred_label": "आगूर",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएल के संयुक्त राजशाही काल का एक बुद्धिमान पुरुष, याके का पुत्र, जिसका उल्लेख नीतिवचन में हुआ है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Agur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pria bijak dari masa kerajaan bersatu Israel, anak Yake, yang disebutkan dalam Amsal."
        }
      ]
    },
    "por": {
      "preferred_label": "Agur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem sábio do período da monarquia unida de Israel, filho de Jaque, mencionado em Provérbios."
        }
      ]
    },
    "rus": {
      "preferred_label": "Агур",
      "descriptions": [
        {
          "source": "acai",
          "description": "Мудрец периода единого царства Израиля, сын Иакея, упомянутый в Притчах."
        }
      ]
    },
    "swh": {
      "preferred_label": "Aguri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu mwenye hekima kutoka kipindi cha ufalme ulioungana wa Israeli, mwana wa Yake, aliyetajwa katika kitabu cha Mithali."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Agur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela saveman bilong taim bilong wanbel kingdom bilong Israel, pikinini man bilong Jake, em Buk Sindaun i kolim nem bilong en."
        }
      ]
    },
    "apd": {
      "preferred_label": "أجُور",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل حكيم من زمن المملكة الموحدة لبني إسرائيل، ولد ياَقِي، ومذكور في سفر الأمثال."
        }
      ]
    },
    "bis": {
      "preferred_label": "Aguru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan waesman long taem we Isrel i wan nesen nomo, we papa blong hem Jake, we Ol Proveb i tokbaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Agọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nwoke maara ihe site nʼoge alaeze dị nʼotu nke Izrel, nwa Jeke, nke a kpọtụrụ aha nʼIlu."
        }
      ]
    },
    "nep": {
      "preferred_label": "आगूर",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलको संयुक्त अधिराज्यको समयका एक बुद्धिमान् पुरुष, याकेका छोरा, जसको उल्लेख हितोपदेशमा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-gu-ra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người khôn ngoan vào thời kỳ vương quốc thống nhất của Y-sơ-ra-ên, con trai của Gia-kê, được nhắc đến trong sách Châm Ngôn."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞古珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列王國統一時期的一位智者，雅基的兒子，記載於箴言中。"
        }
      ]
    }
  },
