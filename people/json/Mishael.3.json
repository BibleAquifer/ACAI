  ],
  "localizations": {
    "eng": {
      "preferred_label": "Mishael",
      "alternate_labels": [
        "Meshach"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Mishael",
          "article": "person:Mishael.3",
          "description": "One of Daniel’s three friends who was thrown into a fiery furnace by the Babylonian king Nebuchadnezzar. An angel sent from God protected the three friends and they did not die."
        }
      ]
    },
    "arb": {
      "preferred_label": "مِيشَائِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "أحد أصحاب دانيال الثلاثة الذين أُلقوا في أتون النار المتقدة بأمر الملك البابلي نبوخذنصر. أنقذ ملاكٌ أرسله الله الأصحاب الثلاثة فلم يموتوا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "米沙利",
      "descriptions": [
        {
          "source": "acai",
          "description": "但以理的三位朋友之一，曾被巴比伦王尼布甲尼撒扔进烈火的窑中。神差遣使者保护了这三位朋友，他们没有丧命。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Mischaël",
      "descriptions": [
        {
          "source": "acai",
          "description": "L’un des trois amis de Daniel qui fut jeté dans une fournaise ardente par le roi babylonien Nebucadnetsar. Un ange envoyé de Dieu protégea les trois amis et ils ne moururent pas."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mishayel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗaya daga cikin abokan Daniyel uku da Nebukadnezzar sarkin Babila ya jefa cikin tanderun wuta. Mala’ikan da Allah ya aiko ya kāre abokan nan uku, ba su mutu ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "मीशाएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "दानिय्येल के तीन मित्रों में से एक जिसे बाबुल के राजा नबूकदनेस्सर द्वारा धधकते हुए भट्ठे में फेंक दिया गया था। परमेश्वर द्वारा भेजे गए एक स्वर्गदूत ने तीनों मित्रों की रक्षा की और वे नहीं मरे।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Misael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Salah seorang dari ketiga sahabat Daniel yang dicampakkan ke dalam perapian yang menyala-nyala oleh raja Babel, Nebukadnezar. Seorang malaikat yang diutus oleh Allah melindungi ketiga sahabat tersebut sehingga mereka tidak mati."
        }
      ]
    },
    "por": {
      "preferred_label": "Misael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um dos três amigos de Daniel que foi lançado em uma fornalha ardente pelo rei babilônio Nabucodonosor. Um anjo enviado por Deus protegeu os três amigos e eles não morreram."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мисаил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Один из трех друзей Даниила, брошенный в раскаленную печь вавилонским царем Навуходоносором. Ангел, посланный Богом, защитил трех друзей, и они не погибли."
        }
      ]
    },
    "spa": {
      "preferred_label": "Misael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uno de los tres amigos de Daniel que fue arrojado a un horno de fuego por el rey babilonio Nabucodonosor. Un ángel enviado por Dios protegió a los tres amigos y no murieron."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mishaeli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmoja wa marafiki watatu wa Danieli aliyetupwa kwenye tanuru ya moto na Nebukadneza mfalme wa Babeli. Malaika aliyetumwa kutoka kwa Mungu aliwalinda hao marafiki watatu nao hawakufa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Misael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bilong tripela pren bilong Daniel em Nebukatnesar, king bilong Babilon, i bin tromoi ol i go insait long bikpela paia. Wanpela ensel God i salim i bin lukautim tripela pren na ol i no dai."
        }
      ]
    },
    "apd": {
      "preferred_label": "ميشائيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحد من أصحاب دانيال التلاتة الكانوا اترموا في أتون النار بواسطة الملك البابلي نبوخذنصر. ملاك مرسل من الله حمى الأصحاب التلاتة وما ماتوا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Misael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan long trifala fren blong Daniel we King Nebukadnesar blong Babilonia i sakem trifala i go insaed long wan bigfala faea. Wan enjel we God i sanem i protektem trifala fren ya mo oli no ded."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mishael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nʼime ndị enyi Daniel atọ ahụ eze Babilọn bụ Nebukadneza tụbara nʼime oké ọkụ na-ere ere. Mmụọ ozi e si nʼaka Chineke zite chebere ndị enyi atọ ahụ, ha anwụghịkwa."
        }
      ]
    },
    "nep": {
      "preferred_label": "मीशाएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "दानिएलका तीन जना साथीहरूमध्ये एक, जसलाई बेबिलोनी राजा नबूकदनेसरले दन्किरहेको आगोको भट्टीमा फालिदिएका थिए। परमेश्‍वरबाट पठाइएका एक स्वर्गदूतले ती तीन जना साथीहरूको रक्षा गर्नुभयो र तिनीहरू मरेनन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Mi-sa-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một trong ba người bạn của Đa-ni-ên bị vua Nê-bu-cát-nết-sa của Ba-by-lôn ném vào lò lửa hực. Một thiên sứ do Đức Chúa Trời sai đến đã bảo vệ ba người bạn và họ không hề hấn gì."
        }
      ]
    },
    "zht": {
      "preferred_label": "米沙利",
      "descriptions": [
        {
          "source": "acai",
          "description": "但以理的三個朋友之一，被巴比倫王尼布甲尼撒扔進烈火的窯中。神差遣使者保護這三個朋友，他們便沒有死。"
        }
      ]
    }
  },
