  "localizations": {
    "eng": {
      "preferred_label": "Belteshazzar (Daniel)",
      "alternate_labels": [
        "Daniel (Prophet)"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Daniel (Prophet)",
          "article": "person:Belteshazzar",
          "description": "A Israelite prophet during the time of Israelite exile and return of the Israelites. His Hebrew name is Daniel."
        }
      ]
    },
    "fra": {
      "preferred_label": "Beltschatsar (Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prophète israélite ayant vécu pendant l'exil et le retour d'Israël. Son nom hébreu est Daniel."
        }
      ]
    },
    "spa": {
      "preferred_label": "Beltsasar (Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Profeta israelita durante la época del exilio y el regreso de los israelitas. Su nombre hebreo es Daniel."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَلْطَشَاصَّر (دانيآل)",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبي إسرائيلي خلال فترة سبي الإسرائيليين ورجوعهم. اسمه العبري هو دانيآل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "伯提沙撒 (但以理)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人被掳与回归时期的一位以色列先知。他的希伯来名字是但以理。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Belteshazar (Daniyel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani annabin Isra’ila a zamanin zaman bauta da komowar Isra’ilawa. Sunansa na Ibrananci shi ne Daniyel."
        }
      ]
    },
    "hin": {
      "preferred_label": "बेलतशस्सर (दानिय्येल)",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलियों के बंधुआई और वापसी के काल का एक इस्राएली भविष्यद्वक्ता। उसका इब्रानी नाम दानिय्येल है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Beltsazar (Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang nabi Israel pada masa pembuangan dan pemulangan orang Israel. Nama Ibraninya adalah Daniel."
        }
      ]
    },
    "por": {
      "preferred_label": "Beltessazar (Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um profeta israelita durante o tempo do exílio e retorno dos israelitas. Seu nome hebraico é Daniel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Валтасар (Даниил)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Израильский пророк во времена вавилонского пленения и возвращения израильтян. Его еврейское имя — Даниил."
        }
      ]
    },
    "apd": {
      "preferred_label": "بلطشاصر (دانيال)",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبي إسرائيلي عاش في زمن السبي والرجوع حق بني إسرائيل. اسمه العبراني هو دانيال."
        }
      ]
    },
    "bis": {
      "preferred_label": "Beltesasa (Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan profet blong Isrel long taem blong eksael mo taem we ol man Isrel oli kambak. Nem blong hem long lanwis Hibru hemia Daniel."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Belteshaza (Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye amụma Izrel nʼoge a dọọrọ ndị Izrel nʼagha na nloghachi ha. Aha Hibru ya bụ Daniel."
        }
      ]
    },
    "nep": {
      "preferred_label": "बेलतसजर (दानिएल)",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलीहरूको निर्वासन र फिर्तीको समयका एक इस्राएली अगमवक्ता। उनको हिब्रू नाउँ दानिएल हो।"
        }
      ]
    },
    "swh": {
      "preferred_label": "Belteshaza (Danieli)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nabii Mwisraeli wakati wa uhamisho wa Waisraeli na kurejea kwa Waisraeli. Jina lake la Kiebrania ni Danieli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Beltesasar (Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela profet bilong Israel long taim bilong ol Israel i go kalabus na kam bek bilong ol Israel. Nem bilong em long tok Hibru em Daniel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bên-tơ-sát-xa (Đa-ni-ên)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nhà tiên tri Y-sơ-ra-ên trong thời kỳ dân Y-sơ-ra-ên bị lưu đày và hồi hương. Tên tiếng Hê-bơ-rơ của ông là Đa-ni-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "伯提沙撒 (但以理)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人被擄及歸回時期的一位以色列先知。他的希伯來名字是但以理。"
        }
      ]
    }
  },
