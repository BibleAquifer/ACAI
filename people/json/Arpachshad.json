  "localizations": {
    "eng": {
      "preferred_label": "Arpachshad",
      "alternate_labels": [
        "Arphaxad"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Arpachshad",
          "article": "person:Arpachshad",
          "description": "Son of Shem and the grandson of Noah. He was the father of Shelah."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَرْفَكْشَاد",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن سام وحفيد نوح، وهو والد شالح."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚法撒",
      "descriptions": [
        {
          "source": "acai",
          "description": "闪的儿子，挪亚的孙子。他是沙拉的父亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Arpacschad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Sem et petit-fils de Noé. Il était le père de Schélach."
        }
      ]
    },
    "hau": {
      "preferred_label": "Arfakshad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Shem kuma jikan Nuhu. Shi ne mahaifin Shela."
        }
      ]
    },
    "hin": {
      "preferred_label": "अर्पक्षद",
      "descriptions": [
        {
          "source": "acai",
          "description": "शेम का पुत्र और नूह का पोता। वह शेलह का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Arpakhsad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Sem dan cucu Nuh. Ia adalah ayah Selah."
        }
      ]
    },
    "por": {
      "preferred_label": "Arfaxade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Sem e neto de Noé. Foi pai de Salá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Арфаксад",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Сима и внук Ноя. Он был отцом Салы."
        }
      ]
    },
    "spa": {
      "preferred_label": "Arfaxad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Sem y nieto de Noé. Fue padre de Selaj."
        }
      ]
    },
    "swh": {
      "preferred_label": "Arfaksadi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Shemu na mjukuu wa Nuhu. Alikuwa baba yake Shela."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Arpaksat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Siem na tumbuna pikinini bilong Noa. Em i papa bilong Sela."
        }
      ]
    },
    "apd": {
      "preferred_label": "أرفكشاد",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد سام وحفيد نوح. وكان أبو شالح."
        }
      ]
    },
    "bis": {
      "preferred_label": "Apaksad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Sem mo smolbubu boe blong Noa. Hem i papa blong Sela."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Apakshad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke Shem na nwa nwa Noa. Ọ bụ nna Shela."
        }
      ]
    },
    "nep": {
      "preferred_label": "अर्पक्षद",
      "descriptions": [
        {
          "source": "acai",
          "description": "शेमका छोरा र नूहका नाति। उनी शेलहका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-bác-sát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Sem và là cháu nội của Nô-ê. Ông là cha của Sê-lách."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞法撒",
      "descriptions": [
        {
          "source": "acai",
          "description": "閃的兒子，挪亞的孫子。他是沙拉的父親。"
        }
      ]
    }
  },
