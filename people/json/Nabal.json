  "localizations": {
    "eng": {
      "preferred_label": "Nabal",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Nabal",
          "article": "person:Nabal",
          "description": "A wealthy but foolish man first married to Abigail, who later became wife of King David."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَابَال",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل ثري لكنه أحمق كان الزوج الأول لأبيجايل، التي أصبحت لاحقاً زوجة الملك داود."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拿八",
      "descriptions": [
        {
          "source": "acai",
          "description": "一个富有却愚顽的人，亚比该的原配丈夫；亚比该后来成为大卫王的妻子。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Nabal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Homme riche mais insensé, premier époux d'Abigaïl, qui devint plus tard la femme du roi David."
        }
      ]
    },
    "hau": {
      "preferred_label": "Nabal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mawadaci amma wawa wanda ya kasance mijin Abigiyel na farko, wadda daga baya ta zama matar Sarki Dawuda."
        }
      ]
    },
    "hin": {
      "preferred_label": "नाबाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक धनी परन्तु मूर्ख पुरुष जिसका पहला विवाह अबीगैल से हुआ था, जो बाद में राजा दाऊद की पत्नी बनी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Nabal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pria kaya tetapi bebal yang awalnya menikah dengan Abigail, yang kemudian menjadi istri Raja Daud."
        }
      ]
    },
    "por": {
      "preferred_label": "Nabal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem rico, porém insensato, que foi o primeiro marido de Abigail, a qual mais tarde se tornou esposa do rei Davi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Навал",
      "descriptions": [
        {
          "source": "acai",
          "description": "Богатый, но безрассудный человек, первый муж Авигеи, которая позже стала женой царя Давида."
        }
      ]
    },
    "spa": {
      "preferred_label": "Nabal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un hombre rico pero necio, primer esposo de Abigaíl, quien más tarde llegó a ser esposa del rey David."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nabali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu tajiri lakini mpumbavu aliyekuwa mume wa kwanza wa Abigaili, ambaye baadaye alikuja kuwa mke wa Mfalme Daudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Nabal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela maniman tasol em i kranki, em i bin maritim pastaim Abigel, dispela meri em bihain i kamap meri bilong King Devit."
        }
      ]
    },
    "apd": {
      "preferred_label": "نابال",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل غني لكن غبي كان أول زوج لأبيجايل، البعدين بقت زوجة الملك داود."
        }
      ]
    },
    "bis": {
      "preferred_label": "Nabal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan rij man we i no gat hed, we fas woman blong hem Abigel, we biaen i kam waef blong King Deved."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nebal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke bara ọgaranya ma bụrụ onye nzuzu nke buru ụzọ lụọ Abigel, onye mechara bụrụ nwunye Eze Devid."
        }
      ]
    },
    "nep": {
      "preferred_label": "नाबाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक धनी तर मूर्ख मानिस जसको विवाह पहिले अबीगेलसँग भएको थियो, जो पछि राजा दाऊदकी पत्नी भइन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Na-banh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người đàn ông giàu có nhưng ngu muội, là người chồng đầu tiên của A-bi-ga-in, người sau này trở thành vợ của Vua Đa-vít."
        }
      ]
    },
    "zht": {
      "preferred_label": "拿八",
      "descriptions": [
        {
          "source": "acai",
          "description": "一個富有但愚頑的人，初娶亞比該為妻，亞比該後來成為大衛王的妻子。"
        }
      ]
    }
  },
