  "tribe": "group:Earlypatriarchs",
  "localizations": {
    "eng": {
      "preferred_label": "Reu",
      "alternate_labels": [
        "Ragau"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Reu",
          "article": "person:Reu",
          "description": "Grandson of the patriarch Eber, son of Peleg, and father of Serug. He is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "رَعُو",
      "descriptions": [
        {
          "source": "acai",
          "description": "حَفِيدُ الآبِ الأَوَّلِ عَابِرَ، وَابْنُ فَالَجَ، وَأَبُو سَرُوجَ. وَهُوَ مَذْكُورٌ فِي نَسَبِ يَسُوعَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拉吴",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖希伯的孙子，法勒的儿子，西鹿的父亲。他列在耶稣的家谱中。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Reyu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jikan uban iyali Eber, ɗan Feleg, kuma mahaifin Serug. An jera shi a cikin layin iyalin Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "रऊ",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता एबेर का पोता, पेलेग का पुत्र और सरूग का पिता। उसे यीशु की वंशावली में सूचीबद्ध किया गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Rehu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cucu dari bapa leluhur Eber, anak dari Peleg, dan ayah dari Serug. Ia terdaftar dalam garis keturunan Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Reú",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neto do patriarca Éber, filho de Pelegue e pai de Serugue. Ele é listado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Рагав",
      "descriptions": [
        {
          "source": "acai",
          "description": "Внук патриарха Евера, сын Фалека и отец Серуха. Он упомянут в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Reú",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nieto del patriarca Éber, hijo de Péleg y padre de Serug. Aparece en la línea genealógica de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Reu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mjukuu wa patriarki Eberi, mwana wa Pelegi, na baba ya Serugi. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Reu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuna pikinini bilong hetman Eber, pikinini man bilong Pelek, na papa bilong Seruk. Nem bilong en i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "رعو",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد البطريرك عابر، وولد فالج، وأبو سروج. وهو مذكور في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Reu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hem i smolbubu blong Eba, pikinini boe blong Peleg, mo papa blong Serug. Nem blong hem i stap long laen blong famle blong Jisas."
        }
      ]
    },
    "fra": {
      "preferred_label": "Rehu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit-fils du patriarche Héber, fils de Péleg et père de Serug. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Reu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa nke nna ochie bụ Eba, nwa Pelẹg, na nna Serug. E depụtara ya nʼusoro ọmụmụ nke Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "रऊ",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता एबेरका नाति, पेलेगका छोरा र सरूगका पिता। उहाँ येशूको वंशावलीमा सूचीकृत हुनुहुन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Rê-hu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cháu nội của tổ phụ Hê-be, con trai của Bê-léc, và cha của Sê-rúc. Ông được liệt kê trong dòng dõi gia phổ của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "拉吳",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長希伯的孫子、法勒的兒子、西鹿的父親。他被列在耶穌的家譜中。"
        }
      ]
    }
  },
