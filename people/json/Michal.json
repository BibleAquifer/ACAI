          "description": "A daughter of King Saul and wife of David, and later the wife of Palti."
        }
      ]
    },
    "fra": {
      "preferred_label": "Mical",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fille du roi Saül et femme de David, et plus tard femme de Palthi."
        }
      ]
    },
    "spa": {
      "preferred_label": "Mical",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hija del rey Saúl y esposa de David, y más tarde esposa de Palti."
        }
      ]
    },
    "arb": {
      "preferred_label": "مِيكَال",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابنة الملك شاول وزوجة داود، ثم زوجة فلطي بعد ذلك."
        }
      ]
    },
    "zhs": {
      "preferred_label": "米甲",
      "descriptions": [
        {
          "source": "acai",
          "description": "扫罗王的女儿，大卫的妻子，后来成为帕提的妻子。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Mikal",
      "descriptions": [
        {
          "source": "acai",
          "description": "’Yar Sarki Shawulu kuma matar Dawuda, wadda daga baya ta zama matar Falti."
        }
      ]
    },
    "hin": {
      "preferred_label": "मीकल",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा शाऊल की एक बेटी और दाऊद की पत्नी, और बाद में पलती की पत्नी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Mikhal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Putri Raja Saul dan istri Daud, yang kemudian menjadi istri Palti."
        }
      ]
    },
    "por": {
      "preferred_label": "Mical",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filha do rei Saul e esposa de Davi, e mais tarde esposa de Palti."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мелхола",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дочь царя Саула и жена Давида, а позже жена Фалтия."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mikali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Binti wa Mfalme Sauli na mke wa Daudi, na baadaye mke wa Palti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mikal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini meri bilong King Sol na meri bilong Devit, na bihain em i meri bilong Palti."
        }
      ]
    },
    "apd": {
      "preferred_label": "ميكال",
      "descriptions": [
        {
          "source": "acai",
          "description": "بت الملك شاول ومرت داود، وبعدين بقت مرت فلطي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mikal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan dota blong King Sol mo woman blong Deved, mo biaen woman blong Palti."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mikal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ada Eze Sọl na nwunye Devid, nke mechara bụrụkwa nwunye Palti."
        }
      ]
    },
    "nep": {
      "preferred_label": "मीकल",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा शाऊलकी छोरी र दाऊदकी पत्नी, र पछि पल्तिका पत्नी।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Mi-canh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con gái của Vua Sau-lơ và là vợ của Đa-vít, về sau là vợ của Phan-ti."
        }
      ]
    },
    "zht": {
      "preferred_label": "米甲",
      "descriptions": [
        {
          "source": "acai",
          "description": "掃羅王的女兒，大衛的妻子，後來成為帕提的妻子。"
        }
      ]
    }
  },
