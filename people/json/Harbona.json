          "description": "Харбона, евнух при дворе царя Артаксеркса в Персии, упомянутый в Есфирь 1:10."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Harbona",
      "descriptions": [
        {
          "source": "acai",
          "description": "Harbona, wanpela wokman i no gat kakaruk bilong haus king bilong King Ahasuerus bilong Pesia, em Esta 1:10 i stori long em."
        }
      ]
    },
    "apd": {
      "preferred_label": "حربونا",
      "descriptions": [
        {
          "source": "acai",
          "description": "حربونا، خصي في قصر الملك أحشويروش ملك فارس، مذكور في أستير 1: 10."
        }
      ]
    },
    "bis": {
      "preferred_label": "Habona",
      "descriptions": [
        {
          "source": "acai",
          "description": "Habona, wan eunuk long haos blong King Ahasuerus blong Pesia, we Esta 1:10 i tokbaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Habona",
      "descriptions": [
        {
          "source": "acai",
          "description": "Habona, onye onozi nʼụlọ eze Ahasuerọs (Sekses) nke Peasia, nke a kpọtụrụ aha nʼakwụkwọ Esta 1:10."
        }
      ]
    },
    "nep": {
      "preferred_label": "हर्बोना",
      "descriptions": [
        {
          "source": "acai",
          "description": "पर्सियाका राजा अहासूएरूसको दरबारका एक नपुंसक (अधिकारी), जसको उल्लेख एस्तर १:१० मा गरिएको छ।"
        }
      ]
    },
    "swh": {
      "preferred_label": "Harbona",
      "descriptions": [
        {
          "source": "acai",
          "description": "Harbona, towashi katika makao ya kifalme ya Mfalme Ahasuero wa Uajemi, anayetajwa katika Esta 1:10."
        }
      ]
    },
    "vie": {
      "preferred_label": "Hạc-bô-na",
