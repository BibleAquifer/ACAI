  "localizations": {
    "eng": {
      "preferred_label": "Er",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Er",
          "article": "person:Er.2",
          "description": "First-born son of the patriarch Judah and Bath-shua, and husband of Tamar. Er was put to death by YHWH."
        }
      ]
    },
    "fra": {
      "preferred_label": "Er",
      "descriptions": [
        {
          "source": "acai",
          "description": "Premier-né du patriarche Juda et de Bath-Schua, et époux de Tamar. Er fut mis à mort par l'Éternel."
        }
      ]
    },
    "spa": {
      "preferred_label": "Er",
      "descriptions": [
        {
          "source": "acai",
          "description": "Primogénito del patriarca Judá y de la hija de Súa, y esposo de Tamar. Er murió a manos de Yahvé."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِير",
      "descriptions": [
        {
          "source": "acai",
          "description": "الابن البكر ليعقوب من بثشوع (ابنة شوع)، وزوج ثَامَار. أماته الرب."
        }
      ]
    },
    "zhs": {
      "preferred_label": "珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖犹大与拔·书亚的长子，她玛的丈夫。珥被耶和华处死。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Er",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan fari na uban iyali Yahuda da Bat-shuwa, kuma mijin Tamar. Yahweh ya kashe Er."
        }
      ]
    },
    "hin": {
      "preferred_label": "एर",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता यहूदा और बतशूआ का जेठा पुत्र, और तामार का पति। एर यहोवा द्वारा मार डाला गया था।"
        }
      ]
    },
    "por": {
      "preferred_label": "Er",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho primogênito do patriarca Judá com a filha de Suá, e marido de Tamar. Er foi morto por Javé."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ир",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первенец патриарха Иуды и дочери Шуи (Бат-Шуи), муж Фамари. Ир был умерщвлен Господом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Eri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mzaliwa wa kwanza wa mzee wa ukoo Yuda na binti Shua, na mume wa Tamari. Eri aliuawa na BWANA."
        }
      ]
    },
    "apd": {
      "preferred_label": "عير",
      "descriptions": [
        {
          "source": "acai",
          "description": "البكر للبطريرك يهوذا وبنت شوع، وزوج ثامار. عير قتله الرب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ere",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasbon pikinini boe blong Juda wetem Batsua, mo hasban blong Tamara. Hae God i kilim Ere i ded from we fasin blong hem i nogud."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọkpara nke nna ochie bụ Juda mụrụ site nʼaka Bat-shua, na di Tama. Onyenwe anyị gburu Ịa."
        }
      ]
    },
    "ind": {
      "preferred_label": "Er",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak sulung dari patriark Yehuda dan Batsyua, serta suami Tamar. Er dihukum mati oleh TUHAN."
        }
      ]
    },
    "nep": {
      "preferred_label": "एर्",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता यहूदा र बतशूआका जेठा छोरा, र तामारका पति। एर्‌लाई परमप्रभुले मार्नुभएको थियो।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Er",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba wan pikinini man bilong bikpela tumbuna Juda wantaim Batsua, na man bilong Tamar. Bikpela i bin kilim Er i dai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-rơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai đầu lòng của tổ phụ Giu-đa với Ba-sua, và là chồng của Ta-ma. Ê-rơ bị Đức Giê-hô-va xử tử."
        }
      ]
    },
    "zht": {
      "preferred_label": "珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖猶大與書亞的女兒所生的長子，她瑪的丈夫。珥在耶和華眼中看為惡，被耶和華處死。"
        }
      ]
    }
  },
