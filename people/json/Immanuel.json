  "localizations": {
    "eng": {
      "preferred_label": "Immanuel (Jesus)",
      "alternate_labels": [
        "Emmanuel",
        "Jesus"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jesus",
          "article": "person:Immanuel",
          "description": "Another name for Jesus, meaning 'God with us,' mentioned in the New Testament, son of Joseph and Mary."
        }
      ]
    },
    "fra": {
      "preferred_label": "Emmanuel (Jésus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un autre nom pour Jésus, signifiant « Dieu avec nous », mentionné dans le Nouveau Testament, fils de Joseph et de Marie."
        }
      ]
    },
    "spa": {
      "preferred_label": "Emanuel (Jesús)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otro nombre para Jesús, que significa «Dios con nosotros», mencionado en el Nuevo Testamento, hijo de José y María."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِمَّانُوئِيل (يَسوع)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اسْمٌ آخَرُ لِيَسُوعَ، مَعْنَاهُ «اللَّهُ مَعَنَا»، ذُكِرَ فِي العَهْدِ الجَدِيدِ، ابْنُ يُوسُفَ وَمَرْيَمَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以马内利 (耶稣)",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶稣的另一个名字，意思是“神与我们同在”，在新约中提及，约瑟和马利亚的儿子。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Immanuwel (Yesu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani suna na Yesu, ma’anarsa “Allah tare da mu,” wanda aka ambata a Sabon Alkawari, ɗan Yusuf da Maryamu."
        }
      ]
    },
    "hin": {
      "preferred_label": "इम्मानुएल (यीशु)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु का दूसरा नाम, जिसका अर्थ है 'परमेश्वर हमारे साथ', जिसका उल्लेख नए नियम में मिलता है, यूसुफ और मरियम का पुत्र।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Imanuel (Yesus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nama lain untuk Yesus, yang berarti 'Allah beserta kita', disebutkan dalam Perjanjian Baru, anak Yusuf dan Maria."
        }
      ]
    },
    "por": {
      "preferred_label": "Emanuel (Jesus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Outro nome de Jesus, que significa 'Deus conosco', mencionado no Novo Testamento, filho de José e Maria."
        }
      ]
    },
    "rus": {
      "preferred_label": "Еммануил (Иисус)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Другое имя Иисуса, означающее «с нами Бог», упоминаемое в Новом Завете; сын Иосифа и Марии."
        }
      ]
    },
    "swh": {
      "preferred_label": "Imanueli (Yesu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jina jingine la Yesu, linalomaanisha 'Mungu pamoja nasi,' anayetajwa katika Agano Jipya, mwana wa Yusufu na Mariamu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Emanuel (Jisas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Narapela nem bilong Jisas, as bilong en i olsem 'God i stap wantaim yumi', Nupela Testamen i stori long em, pikinini man bilong Josep na Maria."
        }
      ]
    },
    "apd": {
      "preferred_label": "عمانوئيل (يسوع)",
      "descriptions": [
        {
          "source": "acai",
          "description": "اسم تاني ليسوع، ومعناه 'الله معانا'، مذكور في العهد الجديد، وهو ولد يوسف ومريم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Emanuel (Jisas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan narafala nem blong Jisas, we mining blong hem ‘God i stap wetem yumi,’ we Niutesteman i tokbaot hem, we papa blong hem Josef mo mama blong hem Meri."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịmanụel (Jisọs)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aha ọzọ maka Jisọs, nke pụtara 'Chineke nọnyeere anyị,' nke a kpọtụrụ aha n'Ọgbụgba Ndụ Ọhụrụ, nwa Josef na Meri."
        }
      ]
    },
    "nep": {
      "preferred_label": "इम्मानुएल (येशू)",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूको अर्को नाउँ, जसको अर्थ 'परमेश्‍वर हामीसँग' हो, नयाँ नियममा उल्लेखित, योसेफ र मरियमका पुत्र।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Em-ma-nu-ên (Chúa Giê-xu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một danh hiệu khác của Chúa Giê-xu, có nghĩa là \\\"Đức Chúa Trời ở cùng chúng ta\\\", được nhắc đến trong Tân Ước, con của Giô-sép và Ma-ri."
        }
      ]
    },
    "zht": {
      "preferred_label": "以馬內利（耶穌）",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶穌的另一個名字，意思是「神與我們同在」，在新約聖經中提及，為約瑟和馬利亞之子。"
        }
      ]
    }
  },
