        {
          "source": "acai",
          "gloss": "Kenan",
          "article": "person:Kenan",
          "description": "A son of Enosh, and father of Mahalalel. He is mentioned in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "قِينَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن أنوش، ووالد مهللئيل. مذكور في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "该南",
      "descriptions": [
        {
          "source": "acai",
          "description": "以挪士的儿子，玛勒列的父亲，见于耶稣的家系谱系中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Kénan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d'Énosch et père de Mahalaleel. Il est mentionné dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kenan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Enosh, kuma mahaifin Mahalalel. An ambace shi a cikin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "केनान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एनोश का पुत्र, और महललेल का पिता। उसका उल्लेख यीशु की वंशावली में है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kenan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang putra Enos, dan ayah Mahalaleel. Ia disebutkan dalam silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Cainã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho de Enos e pai de Maalalel. Ele é mencionado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Каинан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Еноса и отец Малелеила. Упомянут в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Cainán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un hijo de Enós y padre de Mahalaleel. Se le menciona en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kenani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Enoshi, na baba wa Mahalaleli. Ametajwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kenan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Enos, na papa bilong Mahalalel. Nem bilong en i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "قينان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد أنوش، وأبو مهللئيل. مذكور في شجرة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kenan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Enos, mo papa blong Mahalalel. Baebol i tokbaot hem long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kenan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Enọsh, na nna Mahalalel. A kpọtụrụ ya aha nʼusoro ọmụmụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "केनान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एनोशका छोरा र महलालेलका पिता। उनी येशूको वंशावलीमा उल्लिखित छन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Kê-nan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Ê-nót, và cha của Ma-ha-la-lê. Ông được đề cập trong gia phả của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "該南",
      "descriptions": [
        {
          "source": "acai",
          "description": "以挪士的兒子，瑪勒列的父親。他被記載於耶穌的家譜中。"
        }
      ]
    }
  },
