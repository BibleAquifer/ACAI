  "localizations": {
    "eng": {
      "preferred_label": "Ittai",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ittai",
          "article": "person:Ittai",
          "description": "A Gittite and a loyal companion of King David and military commander of a third of David's forces. "
        }
      ]
    },
    "arb": {
      "preferred_label": "إِتَّاي",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل جتي ورفيق مخلص للملك داود، وقائد عسكري لثلث قوات داود."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以太",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦特人，大卫王的忠实同伴，也是统领大卫三分之一军队的指挥官。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Ittaï",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gattien, compagnon loyal du roi David et chef militaire d'un tiers des forces de David."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ittai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bafillace kuma abokin aminci na Sarki Dawuda, kuma kwamandan soja na kashi ɗaya cikin uku na sojojin Dawuda."
        }
      ]
    },
    "hin": {
      "preferred_label": "इत्तै",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक गत्ती पुरुष, जो राजा दाऊद का वफादार साथी और दाऊद की सेना के एक-तिहाई हिस्से का सैन्य सेनापति था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Itai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang orang Gat dan rekan setia Raja Daud serta panglima perang dari sepertiga pasukan Daud."
        }
      ]
    },
    "por": {
      "preferred_label": "Itai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um giteu e companheiro leal do rei Davi, além de comandante militar de um terço das forças de Davi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Еффей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Гефянин, верный соратник царя Давида и военачальник трети войск Давида."
        }
      ]
    },
    "spa": {
      "preferred_label": "Itai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Geteo, leal compañero del rey David y comandante militar de un tercio de las fuerzas de David."
        }
      ]
    },
    "swh": {
      "preferred_label": "Itai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mgiti na mwandani mwaminifu wa Mfalme Daudi na kamanda wa kijeshi wa theluthi moja ya vikosi vya Daudi."
        }
      ]
    },
    "apd": {
      "preferred_label": "إتاي",
      "descriptions": [
        {
          "source": "acai",
          "description": "جتي ورفيق وفيّ للملك داود وقائد عسكري لِتُلت جيش داود."
        }
      ]
    },
    "bis": {
      "preferred_label": "Itae",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man Gat mo wan fetful fren blong King Deved mo komanda blong wan sekenhaf blong ol faeta blong Deved."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Itai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye Git na ezigbo enyi Eze Devid kwesịrị ntụkwasị obi, nakwa ọchịagha nke otu ụzọ n'ụzọ atọ nke ndị agha Devid."
        }
      ]
    },
    "nep": {
      "preferred_label": "इत्तै",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक गित्ती र राजा दाऊदका विश्‍वासयोग्य सहयोगी तथा दाऊदको सेनाको एक तिहाइका सेनापति।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Itai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong Get na gutpela poroman bilong King Devit, em i komanda bilong wanpela hap long tripela hap bilong ol soldia bilong Devit."
        }
      ]
    },
    "vie": {
      "preferred_label": "Y-tai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người Ghi-tít, bạn đồng hành trung thành của Vua Đa-vít và là chỉ huy quân sự một phần ba lực lượng của Đa-vít."
        }
      ]
    },
    "zht": {
      "preferred_label": "以太",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦特人，大衛王的忠實追隨者，統領大衛軍隊的三分之一。"
        }
      ]
    }
  },
