  "localizations": {
    "eng": {
      "preferred_label": "Aristarchus",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Aristarchus",
          "article": "person:Aristarchus",
          "description": "A early Christian disciple from Thessalonica. He was a missionary worker, companion, and fellow prisoner of the apostle Paul."
        }
      ]
    },
    "fra": {
      "preferred_label": "Aristarque",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un disciple chrétien de l'Église primitive, originaire de Thessalonique. Il était missionnaire, compagnon de route et compagnon de captivité de l'apôtre Paul."
        }
      ]
    },
    "spa": {
      "preferred_label": "Aristarco",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un primer discípulo cristiano de Tesalónica. Fue colaborador misionero, compañero y consiervo de prisión del apóstol Pablo."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَرِسْتَرْخُس",
      "descriptions": [
        {
          "source": "acai",
          "description": "تلميذ مسيحي من أوائل المسيحيين من تسالونيكي. كان عاملاً مرسلاً ورفيقاً وشريكاً في الأسر للرسول بولس."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚里达古",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位来自帖撒罗尼迦的早期基督徒门徒。他是传道同工，也是使徒保罗的同伴和同坐监者。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Aristarkus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani almajiri na farko na Kirista daga Tessalonika. Ya kasance ma'aikacin mishan, abokin tafiya, kuma abokin ɗaurin manzo Bulus a kurkuku."
        }
      ]
    },
    "hin": {
      "preferred_label": "अरिस्तर्खुस",
      "descriptions": [
        {
          "source": "acai",
          "description": "थिस्सलुनीके का एक आरंभिक मसीही चेला। वह प्रेरित पौलुस का मिशनरी सहकर्मी, साथी और साथी कैदी था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Aristarkhus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang murid Kristen mula-mula dari Tesalonika. Ia adalah seorang pekerja misi, rekan seperjalanan, dan sesama tahanan rasul Paulus."
        }
      ]
    },
    "por": {
      "preferred_label": "Aristarco",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um dos primeiros discípulos cristãos de Tessalônica. Foi missionário, companheiro de viagem e companheiro de prisão do apóstolo Paulo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аристарх",
      "descriptions": [
        {
          "source": "acai",
          "description": "Раннехристианский ученик из Фессалоники. Он был миссионером, спутником и товарищем по заключению апостола Павла."
        }
      ]
    },
    "swh": {
      "preferred_label": "Aristarko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanafunzi Mkristo wa awali kutoka Thesalonike. Alikuwa mfanyakazi wa umishonari, mwandamani, na mfungwa mwenziwe mtume Paulo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Aristarkus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela disaipel bilong bipo bilong Tesalonaika. Em i wanpela misinari woker, poroman bilong raun, na kalabus wantaim aposel Pol."
        }
      ]
    },
    "apd": {
      "preferred_label": "أرسترخس",
      "descriptions": [
        {
          "source": "acai",
          "description": "تلميذ مسيحي من الأوائل من تسالونيكي. كان عامل إرسالي ورفيق وسجين مع الرسول بولس."
        }
      ]
    },
    "bis": {
      "preferred_label": "Aristakas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan disaepol blong Jisas bifo we i blong Tesalonaeka. Hem i wan misinari, wan man we i stap wokbaot wetem aposol Pol, mo i kalabus wetem hem tu."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Arịstakọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu onye na-eso ụzọ Kraịst oge mbụ nke sitere na Tesalonaịka. Ọ bụ onye ozi ala ọzọ na-arụkọ ọrụ, onye ibe, na onye mkpọrọ ibe nke Pita na Pọl (karịsịa onyeozi Pọl)."
        }
      ]
    },
    "nep": {
      "preferred_label": "अरिस्तार्खस",
      "descriptions": [
        {
          "source": "acai",
          "description": "थेसलोनिकाका एक प्रारम्भिक ख्रीष्टियन चेला। उनी प्रेरित पावलका एक मिसनरी सहकर्मी, साथी, र सङ्गी कैदी थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-ri-tạc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một môn đồ Cơ Đốc đầu tiên đến từ Tê-sa-lô-ni-ca. Ông là một người bạn cùng làm việc truyền giáo, người đồng hành và người cùng chịu tù đày với sứ đồ Phao-lô."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞里達古",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位來自帖撒羅尼迦的早期基督徒門徒。他是使徒保羅的傳道同工、同行者與同坐監者。"
        }
      ]
    }
  },
