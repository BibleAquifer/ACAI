  "localizations": {
    "eng": {
      "preferred_label": "Kohath",
      "alternate_labels": [
        "Kohathite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Kohath",
          "article": "person:Kohath",
          "description": "A son of the patriarch Levi who lived during the time of the Egyptian slavery and wilderness wandering of the Israelites."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَهَات",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن ليعقوب/اللاوي، عاش في فترة العبودية في مصر والتيه في البرية لبني إسرائيل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哥辖",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖利未的儿子，生活在以色列人受埃及奴役和旷野漂泊时期。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Kehath",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Lévi, ayant vécu pendant la période de l'esclavage en Égypte et de l'errance des Israélites dans le désert."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kohat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan uban iyali Lawi wanda ya rayu a lokacin bautar Masar da kuma yawon Isra’ilawa a hamada."
        }
      ]
    },
    "hin": {
      "preferred_label": "कहात",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता लेवी का एक पुत्र, जो मिस्र की दासता और इस्राएलियों के जंगल में भटकने के समय जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kehat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari bapa leluhur Lewi yang hidup pada masa perbudakan di Mesir dan pengembaraan bangsa Israel di padang gurun."
        }
      ]
    },
    "por": {
      "preferred_label": "Coate",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho do patriarca Levi que viveu durante a escravidão no Egito e a peregrinação dos israelitas no deserto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Кааф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Левия, живший во времена египетского рабства и странствования израильтян по пустыне."
        }
      ]
    },
    "spa": {
      "preferred_label": "Coat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Leví que vivió durante la época de la esclavitud en Egipto y la travesía por el desierto de los israelitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kohathi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa mzee wa ukoo Lawi aliyeishi wakati wa utumwa wa Misri na kutangatanga jangwani kwa Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kohat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong tumbuna Livai em i bin stap laip long taim bilong ol Israel i stap kalabus long Isip na long taim ol i bin raun long ples drai nating."
        }
      ]
    },
    "apd": {
      "preferred_label": "قهات",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد من أولاد لاوي الأب، عاش وكت العبودية في مصر والتوهان في البرية بتاع بني إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kohat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong patriaka Livae we i laef long taem we ol man Isrel oli slef long Isip mo oli stap wokbaot long draeples."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kohat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke nna ochie bụ Livayị onye dịrị ndụ n'oge ịbụ ohu n'Ijipt na njegharị n'ọzara nke ụmụ Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "कहात",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता लेवीका एक छोरा, जो इस्राएलीहरूको मिश्रको दासत्व र उजाड-स्थानको यात्राको समयमा बाँचेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Kê-hát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của tổ phụ Lê-vi, sống trong thời kỳ dân Y-sơ-ra-ên chịu cảnh nô lệ tại Ai Cập và lưu lạc trong đồng vắng."
        }
      ]
    },
    "zht": {
      "preferred_label": "哥轄",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長利未的兒子，生活在以色列人在埃及受奴役和曠野漂泊的時期。"
        }
      ]
    }
  },
