        }
      ]
    },
    "hau": {
      "preferred_label": "Iskariyot (Yahuda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Siman, ɗaya daga cikin almajiran Yesu goma sha biyu, wanda aka sani da bashe Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "इस्करियोती (यहूदा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "शमौन का पुत्र, यीशु के बारह चेलों में से एक, जो यीशु को पकड़वाने (विश्वासघात करने) के लिए जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Iskariot (Yudas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Simon, salah seorang dari kedua belas murid Yesus, yang dikenal karena mengkhianati Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Iscariotes (Judas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Simão, um dos doze discípulos de Jesus, conhecido por trair Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Искариот (Иуда)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Симона, один из двенадцати учеников Иисуса, известный тем, что предал Иисуса."
        }
      ]
    },
    "swh": {
      "preferred_label": "Iskarioti (Yuda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Simoni, mmoja wa wanafunzi kumi na wawili wa Yesu, anayejulikana kwa kumsaliti Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Iskariot (Judas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Saimon, em wanpela bilong ol 12-pela disaipel bilong Jisas, em man i bin givim Jisas long han bilong ol birua bilong em."
        }
      ]
    },
    "apd": {
      "preferred_label": "الإسخريوطي (يهوذا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن سمعان، واحد من تلاميذ يسوع الاثناعشر، ومعروف بخيانته ليسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Iskariot (Judas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Saemon, wan long ol twelef disaepol blong Jisas, we i karem nem from we hem i traem givim Jisas i go long han blong ol enemi blong hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Iskarịọt (Judas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Saịmọn, otu nʼime ndị ozi iri na abụọ nke Jizọs, onye a maara maka ịrara Jizọs nye."
        }
      ]
    },
    "nep": {
      "preferred_label": "इस्करियोत (यहूदा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिमोनका छोरा, येशूका बाह्र चेलाहरूमध्ये एक, जो येशूलाई धोका दिनका निम्ति चिनिन्छन्‌।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ích-ca-ri-ốt (Giu-đa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Si-môn, một trong mười hai sứ đồ của Chúa Giê-xu, được biết đến vì đã phản bội Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "加略人 (猶大)",
      "descriptions": [
        {
          "source": "acai",
          "description": "西門的兒子，耶穌的十二門徒之一，以背叛耶穌而為人所知。"
        }
      ]
    }
  },
