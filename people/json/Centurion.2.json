  "localizations": {
    "eng": {
      "preferred_label": "Centurion With Sick Servant",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Centurion With Sick Servant",
          "description": "A centurion who asked Jesus to heal his sick servant."
        }
      ]
    },
    "apd": {
      "preferred_label": "قائد مية خادمو عيان",
      "descriptions": [
        {
          "source": "acai",
          "description": "قائد مية طلب من يسوع يشفي خادمو العيان."
        }
      ]
    },
    "arb": {
      "preferred_label": "قائِدُ المِئَةِ الَّذِي مَرِضَ غُلامُهُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "قائِدُ مِئَةٍ طَلَبَ مِنْ يَسُوعَ أَنْ يَشْفِيَ غُلامَهُ المَرِيضَ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kapten we man blong wok blong hem i sik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kapten we i askem Jisas blong mekem man blong wok blong hem we i sik i oraet bakegen."
        }
      ]
    },
    "fra": {
      "preferred_label": "Centenier au serviteur malade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un centenier qui a demandé à Jésus de guérir son serviteur malade."
        }
      ]
    },
    "hau": {
      "preferred_label": "Jarumin da bawansa yake ciwo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani jarumi (shugaban sojoji) da ya roƙi Yesu ya warkar da bawansa da ke ciwo."
        }
      ]
    },
    "hin": {
      "preferred_label": "बीमार सेवक वाला सूबेदार",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक सूबेदार जिसने यीशु से अपने बीमार सेवक को चंगा करने की विनती की।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọchịagha Nwere Ohu Na-arịa Ọrịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọchịagha rịọrọ Jisọs ka ọ gwọọ ohu ya na-arịa ọrịa."
        }
      ]
    },
    "ind": {
      "preferred_label": "Perwira dengan Hamba yang Sakit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang perwira yang memohon kepada Yesus untuk menyembuhkan hambanya yang sakit."
        }
      ]
    },
    "nep": {
      "preferred_label": "बिरामी नोकर भएको कप्तान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक जना कप्तान जसले येशूलाई आफ्नो बिरामी नोकरलाई निको पारिदिन आग्रह गरेका थिए।"
        }
      ]
    },
    "por": {
      "preferred_label": "Centurião com o servo doente",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um centurião que pediu a Jesus para curar o seu servo doente."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сотник с больным слугой",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сотник, который просил Иисуса исцелить своего больного слугу."
        }
      ]
    },
    "spa": {
      "preferred_label": "Centurión con el siervo enfermo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un centurión que le pidió a Jesús que sanara a su siervo enfermo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Akida Mwenye Mtumishi Mgonjwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Akida aliyemwomba Yesu amponye mtumishi wake aliyekuwa mgonjwa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kepten i gat wokboi i sik",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kepten bilong ol soldia i bin askim Jisas long oraitim wokboi bilong em i sik."
        }
      ]
    },
    "vie": {
      "preferred_label": "Viên đội trưởng có đầy tớ đau ốm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một viên đội trưởng đã cầu xin Chúa Giê-xu chữa lành cho người đầy tớ bị bệnh của mình."
        }
      ]
    },
    "zhs": {
      "preferred_label": "仆人患病的百夫长",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位求耶稣医治自己患病仆人的百夫长。"
        }
      ]
    },
    "zht": {
      "preferred_label": "僕人患病的百夫長",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位請求耶穌醫治其患病僕人的百夫長。"
        }
      ]
    }
  },
