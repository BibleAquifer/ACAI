  "localizations": {
    "eng": {
      "preferred_label": "Hagri",
      "alternate_labels": [
        "Haggeri",
        "Hagrite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hagri",
          "article": "person:Hagri",
          "description": "The father of Mibhar, one of King David's mighty men. Hagri was founder of the Hagrites."
        }
      ]
    },
    "arb": {
      "preferred_label": "هَاجِرِيّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "وَالِدُ مَبْحَارَ، أَحَدِ أَبْطَالِ ٱلْمَلِكِ دَاوُدَ. وَكَانَ هَاجِرِيٌّ جَدَّ ٱلْهَاجَرِيِّينَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈基利",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王勇士之一弥伯哈的父亲。哈基利是夏甲人（哈基利人）的祖先。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Hagri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le père de Mibchar, l'un des vaillants guerriers du roi David. Hagri était le fondateur des Hagaréniens."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hagri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahaifin Mibhar, ɗaya daga cikin jarumawan Sarki Dawuda. Hagri shi ne kakan Hagirawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "हग्री",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊद के शूरवीरों में से एक मिभार का पिता। हग्री हग्रियों का मूलपुरुष था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hagri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ayah dari Mibhar, salah seorang pahlawan perkasa Raja Daud. Hagri adalah leluhur orang Hagri."
        }
      ]
    },
    "por": {
      "preferred_label": "Hagri",
      "descriptions": [
        {
          "source": "acai",
          "description": "O pai de Mibar, um dos guerreiros valentes do rei Davi. Hagri foi o fundador dos hagarenos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хагри",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отец Мивхара, одного из храбрых воинов царя Давида. Хагри был родоначальником агарян."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hagrí",
      "descriptions": [
        {
          "source": "acai",
          "description": "Padre de Mibar, uno de los valientes del rey David. Hagrí fue el antepasado de los agarenos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hagri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Baba yake Mibhari, mmoja wa mashujaa wa Mfalme Daudi. Hagri alikuwa mwanzilishi wa Wahagari."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hagri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa bilong Miphar, wanpela bilong ol strongpela soldia bilong King Devit. Hagri em i tumbuna papa bilong ol lain Hagar."
        }
      ]
    },
    "apd": {
      "preferred_label": "هجري",
      "descriptions": [
        {
          "source": "acai",
          "description": "أبو مبحار، واحد من أبطال الملك داود. وهجري كان مؤسس الهاجريين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hagri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa blong Mibhar, we hem i wan long ol strong soldia blong King Deved. Hagri i stamba blong ol man Hagri."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hagri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nna Mibha, otu nʼime ndị dike Eze Devid. Hagri bụ onye guzobere ndị Haga."
        }
      ]
    },
    "nep": {
      "preferred_label": "हग्री",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊदका एक वीर पुरुष मिभारका बुबा। हग्री, हग्रीहरूका संस्थापक थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hê-gơ-ri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cha của Míp-ha, một trong các dũng sĩ của Vua Đa-vít. Hê-gơ-ri là tổ phụ của người Ha-ga-rít."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈基",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王勇士之一米伯哈的父親。哈基是夏甲人的祖先。"
        }
      ]
    }
  },
