  "localizations": {
    "eng": {
      "preferred_label": "Lud",
      "alternate_labels": [
        "Lydia",
        "Lydian",
        "Ludiim",
        "Ludim"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Lud",
          "article": "person:Lud",
          "description": "A son of the patriarch Shem. He was a brother of Asshur, Elam, Arpachshad, and Aram."
        }
      ]
    },
    "arb": {
      "preferred_label": "لُود",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱبْنُ سَامٍ، وَأَخُو أَشُّورَ وَعِيلَامَ وَأَرْفَكْشَادَ وَأَرَامَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "路德",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长闪的儿子，是以拦、亚述、亚法撒和亚兰的弟兄。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Lud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Sem. Il était le frère d’Assur, d’Élam, d’Arpacschad et d’Aram."
        }
      ]
    },
    "hau": {
      "preferred_label": "Lud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan uban iyali Shem. Ɗan’uwan Asshur, Elam, Arfakshad, da Aram ne."
        }
      ]
    },
    "hin": {
      "preferred_label": "लूद",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता शेम का एक पुत्र। वह अश्शूर, एलाम, अर्पक्षद और अराम का भाई था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Lud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki dari bapa leluhur Sem. Ia adalah saudara laki-laki Asyur, Elam, Arpakhsad, dan Aram."
        }
      ]
    },
    "por": {
      "preferred_label": "Lude",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho do patriarca Sem. Ele era irmão de Assur, Elão, Arfaxade e Arã."
        }
      ]
    },
    "rus": {
      "preferred_label": "Луд",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Сима, брат Ассура, Елама, Арфаксада и Арама."
        }
      ]
    },
    "spa": {
      "preferred_label": "Lud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Sem. Era hermano de Asur, Elam, Arfaxad y Aram."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ludi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa mzee wa ukoo Shemu. Alikuwa ndugu wa Ashuru, Elamu, Arfaksadi, na Aramu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lidia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong hetman Siem. Em i brata bilong Asur, Elam, Arpaksat, na Aram."
        }
      ]
    },
    "apd": {
      "preferred_label": "لود",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد من أولاد سام أب الآباء. وكان أخو أشور وعيلام وأرفكشاد وأرام."
        }
      ]
    },
    "bis": {
      "preferred_label": "Lud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong patriak Sem. Hem i brata blong Asuru, Elam, Apaksad, mo Aram."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Lud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke nke nna ochie bụ Shem. Ọ bụ nwanne Ashua, Elam, Apakshad, na Aram."
        }
      ]
    },
    "nep": {
      "preferred_label": "लूद",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता शेमका एक छोरा। उनी अश्शूर, एलाम, अर्पक्षद र अरामका भाइ थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Lút",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con trai của tổ phụ Sem. Ông là anh em với A-su-rơ, Ê-lam, A-bác-sát, và A-ram."
        }
      ]
    },
    "zht": {
      "preferred_label": "路德",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖閃的兒子。他是亞述、以攔、亞法撒和亞蘭的兄弟。"
        }
      ]
    }
  },
