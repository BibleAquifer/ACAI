  "localizations": {
    "eng": {
      "preferred_label": "Beriah",
      "alternate_labels": [
        "Beriite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Beriah",
          "article": "person:Beriah",
          "description": "A son of the patriarch Asher, who was a son of the patriarch Jacob. Beriah was the chief of the Beriite clan."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَرِيعَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن لأشير، الذي كان ابنًا ليعقوب. وكان بريعة رئيسًا لعشيرة البريعيين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "比利亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长亚设的儿子，亚设是族长雅各的儿子。比利亚是比利亚族的族长。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Beria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Aser, qui était fils du patriarche Jacob. Beria était le chef du clan des Beriites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Beriya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan kakan nan Asher, wanda yake ɗan kakan nan Yaƙub ne. Beriya shi ne shugaban kabilar Beriyawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "बरीआ",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता आशेर का एक पुत्र, जो कुलपति याकूब का पुत्र था। बरीआ बरीइयों के कुल का प्रधान था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Beria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki dari bapa leluhur Asyer, yang merupakan anak dari bapa leluhur Yakub. Beria adalah kepala dari kaum orang Beria."
        }
      ]
    },
    "por": {
      "preferred_label": "Berias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho do patriarca Aser, que era filho do patriarca Jacó. Berias foi o chefe do clã beriaíta."
        }
      ]
    },
    "rus": {
      "preferred_label": "Бриа",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Асира, сына патриарха Иакова. Берия был главой клана вериитян."
        }
      ]
    },
    "spa": {
      "preferred_label": "Beriá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Aser, quien fue hijo del patriarca Jacob. Beriá fue el jefe del clan de los beriaítas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Beria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa baba wa taifa Asheri, aliyekuwa mwana wa baba wa taifa Yakobo. Beria alikuwa kiongozi wa ukoo wa Waberia."
        }
      ]
    },
    "apd": {
      "preferred_label": "بريعه",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد من أولاد أشير، الأب القبلي، الكان ولد يعقوب الأب القبلي. بريعه كان رئيس عشيرة البريعيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Beria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Asere, we Asere i pikinini boe blong Jekob. Beria hem i jif blong laen blong Beria."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Beriya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke nke nna ochie bụ Asha, onye bụ nwa nwoke nke nna ochie bụ Jekọb. Beriya bụ onyeisi nke ikwu ndị Beriya."
        }
      ]
    },
    "nep": {
      "preferred_label": "बरीआ",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता याकूबका छोरा कुलपति आशेरका छोरा। बरीआ बरीआती कुलका प्रमुख थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Beria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong hetman Aser, em pikinini man bilong hetman Jekop. Beria em i hetman bilong famili lain Beria."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bê-ri-a",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của tổ phụ A-se, người vốn là con trai của tổ phụ Gia-cốp. Bê-ri-a là trưởng tộc của thị tộc Bê-ri-a."
        }
      ]
    },
    "zht": {
      "preferred_label": "比利亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長亞設的兒子，亞設是族長雅各的兒子。比利亞是比利亞族的首領。"
        }
      ]
    }
  },
