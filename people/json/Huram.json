        }
      ]
    },
    "hau": {
      "preferred_label": "Huram (Hiram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Taya a lokacin mulkin Dawuda da Solomon, wanda ya ba da kayayyaki da taimako domin ayyukan gini."
        }
      ]
    },
    "hin": {
      "preferred_label": "हूराम (हीराम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दाऊद और सुलैमान के शासनकाल के दौरान सोर का राजा, जिसने निर्माण परियोजनाओं के लिए सामग्री और सहायता प्रदान की।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Huram (Hiram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Raja Tirus pada masa pemerintahan Daud dan Salomo, yang menyediakan bahan-bahan dan dukungan untuk proyek-proyek pembangunan."
        }
      ]
    },
    "por": {
      "preferred_label": "Hurão (Hirão)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O rei de Tiro durante os reinados de Davi e Salomão, que forneceu materiais e apoio para projetos de construção."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хурам (Хирам)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь Тира во времена правления Давида и Соломона, предоставлявший материалы и поддержку для строительных проектов."
        }
      ]
    },
    "swh": {
      "preferred_label": "Huramu (Hiramu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Tiro wakati wa utawala wa Daudi na Solomoni, aliyetoa vifaa na msaada kwa ajili ya miradi ya ujenzi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hiram (Huram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "King bilong Tair long taim bilong Devit na Solomon, em i bin givim ol samting na helpim ol long ol wok bilong bildim haus bilong Bikpela na haus king."
        }
      ]
    },
    "apd": {
      "preferred_label": "حورام (حيرام)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك صور في زمن حكم داود وسليمان، قدم مواد ودعم لمشاريع البناء."
        }
      ]
    },
    "bis": {
      "preferred_label": "Huram (Hiram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "King blong Taea long taem we Deved mo Solomon tufala i king, we hem i givim ol timba mo samting blong bildim ol haos."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Huram (Hiram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze Taya nʼoge ọchịchị Devid na Solomọn, onye nyere ngwongwo na nkwado maka ọrụ owuwu dị iche iche."
        }
      ]
    },
    "nep": {
      "preferred_label": "हूराम (हीराम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दाऊद र सोलोमनको शासनकालमा टायरका राजा, जसले निर्माण परियोजनाहरूका लागि सामग्री र सहयोग उपलब्ध गराएका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hu-ram (Hi-ram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vua thành Ty-rơ trong thời kỳ trị vì của Đa-vít và Sa-lô-môn, người đã cung cấp vật liệu và hỗ trợ cho các công trình xây dựng."
        }
      ]
    },
    "zht": {
      "preferred_label": "戶蘭（希蘭）",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛和所羅門統治時期的推羅王，曾為建造工程提供建材和支援。"
        }
      ]
    }
