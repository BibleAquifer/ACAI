        }
      ]
    },
    "tpi": {
      "preferred_label": "Jahasiel (2 Kronikel 20:14)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela Livai na pikinini man bilong Sekaraia em i stap long taim bilong King Jehosafat, em Baibel i kolim long 2 Stori 20:14."
        }
      ]
    },
    "apd": {
      "preferred_label": "يحزيئيل (أخبار الأيام الثاني 20:14)",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوي وولد زكريا عاش في زمن الملك يهوشافاط، مذكور في أخبار الأيام الثاني 20: 14."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jahasiel (2 Kronikol 20:14)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan Livaet mo pikinini boe blong Sekaraea we i laef long taem blong King Jehosafat, we 2 Kronikel 20:14 i tokbaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jahaziel (2 Akụkọ Ihe Gara Aga 20:14)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye Livayị na nwa Zekaraya nke biri nʼoge Eze Jehoshifat, onye a kpọtụrụ aha nʼime 2 Ihe Emere 20:14."
        }
      ]
    },
    "nep": {
      "preferred_label": "यहासेल (2 इतिहास 20:14)",
      "descriptions": [
        {
          "source": "acai",
          "description": "२ इतिहास २०:१४ मा उल्लेख गरिएका, राजा यहोशापातको समयका एक लेवी र जकरियाका छोरा।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Иозиил (2-я Паралипоменон 20:14)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левит и сын Захарии, живший во времена царя Иосафата, упомянутый во 2 Паралипоменон 20:14."
        }
      ]
    },
    "vie": {
      "preferred_label": "Gia-ha-xi-ên (2 Sử Ký 20:14)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người Lê-vi và là con trai của Xa-cha-ri, sống vào thời Vua Giô-sa-phát, được nhắc đến trong 2 Sử ký 20:14."
        }
      ]
    },
    "zht": {
      "preferred_label": "雅哈悉 (歷代志下 20:14)",
      "descriptions": [
        {
          "source": "acai",
          "description": "約沙法王時期的一位利未人，撒迦利雅的兒子，記載於歷代志下20:14。"
        }
      ]
    }
