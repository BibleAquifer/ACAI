  "type": "person",
  "gender": "male",
  "localizations": {
    "eng": {
      "preferred_label": "Ornan",
      "alternate_labels": [
        "Ornah",
        "Arania",
        "Araunah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ornan",
          "article": "person:Ornan",
          "description": "A Jebusite man who lived during Israel’s united kingdom. He was known for selling his threshing floor to David."
        }
      ]
    },
    "arb": {
      "preferred_label": "أُرْنَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل يبوسي عاش في زمن المملكة المتحدة لإسرائيل. اشتهر ببيعه بيدره لداود."
        }
      ]
    },
    "zhs": {
      "preferred_label": "阿珥楠",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在以色列联合王国时期的一名耶布斯人。他因将自己的麦场卖给大卫而闻名。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Ornan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jébusien ayant vécu à l'époque de la monarchie unifiée d'Israël, connu pour avoir vendu son aire de battage à David."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ornan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin Yebus ne da ya rayu a lokacin haɗin kan masarautar Isra’ila. An san shi da sayar wa Dawuda masussukarsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "ओर्नान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक यबूसी पुरुष जो इस्राएल के संयुक्त राज्य के समय रहता था। वह दाऊद को अपना खलिहान बेचने के लिए जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ornan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pria Yebus yang hidup pada masa kerajaan bersatu Israel. Ia dikenal karena menjual tempat pengirikannya kepada Daud."
        }
      ]
    },
    "por": {
      "preferred_label": "Ornã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um jebuseu que viveu durante o reino unificado de Israel. Ele ficou conhecido por vender sua eira a Davi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Орна",
      "descriptions": [
        {
          "source": "acai",
          "description": "Иевусеянин, живший во времена единого царства Израиля. Известен тем, что продал свое гумно Давиду."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ornán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un hombre jebuseo que vivió durante la monarquía unida de Israel. Fue conocido por vender su era a David."
        }
      ]
    },
    "swh": {
      "preferred_label": "Arauna",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamume Myebusi aliyeishi wakati wa ufalme wa umoja wa Israeli. Alijulikana kwa kumwuzia Daudi sakafu yake ya kupuria."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Arauna",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong lain Jebus i bin stap long taim bilong wanbel kingdom bilong Israel. Em i man i bin salim hap graun bilong krungutim kaikai bilong wit i go long Devit."
        }
      ]
    },
    "apd": {
      "preferred_label": "أرنان",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل يبوسي عاش في زمن المملكة الموحدة لإسرائيل. كان معروف ببيعه بيادر دراسه لداود."
        }
      ]
    },
    "bis": {
      "preferred_label": "Aravnaha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man Jebus we i laef long taem blong yunaeted kingdom blong Isrel. Oli save hem from we hem i salem ples blong klinim wit blong hem i go long Deved."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ọnan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke onye Jebus nke biri nʼoge alaeze dị nʼotu nke Izrel. A maara ya maka ire ebe ịzọcha ọka ya nye Devid."
        }
      ]
    },
    "nep": {
      "preferred_label": "अरौना",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलको संयुक्त राज्यको समयमा बाँचेका एक यबूसी पुरुष। तिनी दाऊदलाई आफ्नो खला बेच्नका लागि परिचित थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ọt-nan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người Giê-bu sống trong thời kỳ vương quốc thống nhất của Y-sơ-ra-ên. Ông nổi tiếng về việc bán sân đập lúa của mình cho Đa-vít."
        }
      ]
    },
    "zht": {
      "preferred_label": "阿珥楠",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在以色列聯合王國時期的一位耶布斯人，以將自己的禾場賣給大衛而聞名。"
        }
      ]
    }
  },
