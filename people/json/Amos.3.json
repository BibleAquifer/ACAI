  "localizations": {
    "eng": {
      "preferred_label": "Amos (Prophet)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Amos (Prophet)",
          "article": "person:Amos.3",
          "description": "A prophet to the northern kingdom of Israel during the divided kingdom. A book of the Old Testament is named for him."
        }
      ]
    },
    "fra": {
      "preferred_label": "Amos (prophète)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un prophète envoyé au royaume du nord (Israël) à l’époque du royaume divisé. Un livre de l’Ancien Testament porte son nom."
        }
      ]
    },
    "spa": {
      "preferred_label": "Amós (profeta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Profeta enviado al reino del norte de Israel durante el reino dividido. Un libro del Antiguo Testamento lleva su nombre."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَامُوس (النبي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبي أُرسل إلى مملكة إسرائيل الشمالية أثناء فترة المملكة المنقسمة. سُمي أحد أسفار العهد القديم باسمه."
        }
      ]
    },
    "zhs": {
      "preferred_label": "阿摩司 (先知)",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期派往北国以色列的先知。旧约圣经中的一卷以他的名字命名。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Amos (Annabi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani annabi ga masarautar arewa ta Isra’ila a lokacin rabuwar mulki. An sa wa wani littafi a Tsohon Alkawari sunansa."
        }
      ]
    },
    "hin": {
      "preferred_label": "आमोस (भविष्यद्वक्ता)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के समय इस्राएल के उत्तरी राज्य के लिए एक भविष्यद्वक्ता। पुराने नियम की एक पुस्तक का नाम उनके नाम पर रखा गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Amos (nabi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang nabi bagi kerajaan utara Israel pada masa kerajaan terpecah. Sebuah kitab dalam Perjanjian Lama dinamai menurut namanya."
        }
      ]
    },
    "por": {
      "preferred_label": "Amós (profeta)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um profeta para o reino do norte de Israel durante o reino dividido. Um livro do Antigo Testamento leva o seu nome."
        }
      ]
    },
    "rus": {
      "preferred_label": "Амос (пророк)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пророк в северном царстве Израиля во времена разделенного царства. Его именем названа книга Ветхого Завета."
        }
      ]
    },
    "swh": {
      "preferred_label": "Amosi (Nabii)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nabii kwa ufalme wa kaskazini wa Israeli wakati wa ufalme uliogawanyika. Kitabu cha Agano la Kale kimepewa jina lake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Amos (Profet)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela profet i go long not kingdom bilong Israel long taim bilong kingdom i stap tupela hap. Wanpela buk bilong Olpela Testamen i kisim nem bilong en."
        }
      ]
    },
    "apd": {
      "preferred_label": "عاموص (النبي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبي لمملكة إسرائيل الشمالية في زمن المملكة المنقسمة. اتسمى سفر في العهد القديم على اسمه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Amos (Profet)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan profet long not kingdom blong Isrel long taem we kingdom i seraot. Wan buk blong Oltesteman i karem nem blong hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Emọs (Onye Amụma)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye amụma nʼalaeze ugwu nke Izrel nʼoge alaeze kewara ekewa. A kpọrọ otu akwụkwọ nke Agba Ochie aha ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "आमोस (अगमवक्ता)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा इस्राएलको उत्तरी राज्यका एक अगमवक्ता। पुरानो करारको एउटा पुस्तकको नाउँ यिनकै नाउँबाट राखिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-mốt (tiên tri)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nhà tiên tri cho vương quốc phía bắc là Ít-ra-ên trong thời kỳ vương quốc phân chia. Một sách trong Cựu Ước được đặt theo tên ông."
        }
      ]
    },
    "zht": {
      "preferred_label": "阿摩司（先知）",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期北國以色列的先知。舊約聖經中有一卷書以他的名字命名。"
        }
      ]
    }
  },
