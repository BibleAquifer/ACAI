      "preferred_label": "Zilpah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Zilpah",
          "article": "person:Zilpah",
          "description": "A slave of the matriarch Leah and concubine of the patriarch Jacob, and the mother of Gad and Asher."
        }
      ]
    },
    "fra": {
      "preferred_label": "Zilpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Servante de la matriarche Léa et concubine du patriarche Jacob, et mère de Gad et d'Aser."
        }
      ]
    },
    "spa": {
      "preferred_label": "Zilpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esclava de la matriarca Lea y concubina del patriarca Jacob, y madre de Gad y Aser."
        }
      ]
    },
    "arb": {
      "preferred_label": "زِلْفَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "جارية للأم ليئة وسُرِّيَّة ليعقوب، وأم جاد وأشير."
        }
      ]
    },
    "zhs": {
      "preferred_label": "悉帕",
      "descriptions": [
        {
          "source": "acai",
          "description": "女先祖利亚的婢女，族长雅各的妾，迦得和亚设的母亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Zilfa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuyangar uwar iyali Liyatu kuma ƙwarƙwarar uban iyali Yaƙub, kuma mahaifiyar Gad da Asher."
        }
      ]
    },
    "hin": {
      "preferred_label": "जिल्पा",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलमाता लिआ की एक दासी और कुलपिता याकूब की रखैल, तथा गाद और आशेर की माता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Zilpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Budak perempuan dari sang matriark Lea dan gundik dari sang patriark Yakub, serta ibu dari Gad dan Asyer."
        }
      ]
    },
    "por": {
      "preferred_label": "Zilpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Serva da matriarca Lia e concubina do patriarca Jacó, e mãe de Gade e Aser."
        }
      ]
    },
    "rus": {
      "preferred_label": "Зелфа",
      "descriptions": [
        {
          "source": "acai",
          "description": "Служанка праматери Лии и наложница патриарха Иакова, мать Гада и Асира."
        }
      ]
    },
    "swh": {
      "preferred_label": "Zilpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtumwa wa Lea na suria wa mzee wa ukoo Yakobo, naye alikuwa mama yao Gadi na Asheri."
        }
      ]
    },
    "apd": {
      "preferred_label": "زلفة",
      "descriptions": [
        {
          "source": "acai",
          "description": "جارية ليئة وأمة يعقوب، وأم جاد وأشير."
        }
      ]
    },
    "bis": {
      "preferred_label": "Silpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan woman slef blong Lea mo woman blong Jekob, mo mama blong Gad mo Aser."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Zilpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Odibo nwanyị Lịa na iko nwanyị nna ochie bụ Jekọb, na nne Gad na Asha."
        }
      ]
    },
    "nep": {
      "preferred_label": "जिल्पा",
      "descriptions": [
        {
          "source": "acai",
          "description": "मातृका लेआकी कमारी र कुलपिता याकूबकी उपपत्नी, तथा गाद र आशेरकी आमा।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Silpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela wokmeri bilong Lea na namba 2 meri bilong Jekop, na mama bilong Gat na Aser."
        }
      ]
    },
    "vie": {
      "preferred_label": "Xinh-ba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người nữ tì của tổ mẫu Lê-a, người vợ lẽ của tổ phụ Gia-cốp, và là mẹ của Gát cùng A-se."
        }
      ]
    },
    "zht": {
      "preferred_label": "悉帕",
      "descriptions": [
        {
          "source": "acai",
          "description": "女族長利亞的女僕，族長雅各的妾，迦得和亞設的母親。"
        }
      ]
    }
  },
