  "localizations": {
    "eng": {
      "preferred_label": "Ruth",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ruth",
          "article": "person:Ruth",
          "description": "Moabite wife of Mahlon who was the son of Elimelech and Naomi. After the death of Mahlon, Ruth married Boaz and so became the mother of Obed and the great-grandmother of David. She is listed in in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "رَاعُوث",
      "descriptions": [
        {
          "source": "acai",
          "description": "زوجة مَحْلون الموآبية، وهو ابن أَلِيمَالِك ونُعْمِي. وبعد موت مَحْلون، تزوجت راعوث من بُوعَز وأصبحت بذلك أُمَّ عُوبِيد وجدة داود الكبرى. وهي مذكورة في سلسلة نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "路得",
      "descriptions": [
        {
          "source": "acai",
          "description": "以利米勒和拿俄米的儿子玛伦的摩押妻子。玛伦死后，路得嫁给波阿斯，成为俄备得的母亲和大卫的曾祖母。她被列在耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Ruth",
      "descriptions": [
        {
          "source": "acai",
          "description": "Épouse moabite de Machlon, fils d'Élimélec et de Naomi. Après la mort de Machlon, Ruth épousa Boaz et devint ainsi la mère d'Obed et l'arrière-grand-mère de David. Elle est mentionnée dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutuniyar Mowab matar Malon wanda yake ɗan Elimelek da Na’omi. Bayan mutuwar Malon, Rut ta auri Bowaz kuma ta haka ta zama mahaifiyar Obed da kuma kakar kakan Dawuda. An lissafa ta a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "रूत",
      "descriptions": [
        {
          "source": "acai",
          "description": "महलोन की मोआबी पत्नी, जो एलीमेलेक और नाओमी का पुत्र था। महलोन की मृत्यु के बाद, रूत ने बोअज से विवाह किया और इस प्रकार वह ओबेद की माता और दाऊद की परदादी बनी। वह यीशु की वंशावली में सूचीबद्ध है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Rut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Perempuan Moab yang menjadi istri Mahlon, anak laki-laki Elimelekh dan Naomi. Setelah kematian Mahlon, Rut menikah dengan Boas dan menjadi ibu dari Obed serta buyut Daud. Dia tercatat dalam silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Rute",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esposa moabita de Malom, que era filho de Elimeleque e Noemi. Após a morte de Malom, Rute casou-se com Boaz e tornou-se mãe de Obede e bisavó de Davi. Ela está listada na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Руфь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Моавитянка, жена Махлона, сына Елимелеха и Ноемини. После смерти Махлона Руфь вышла замуж за Вооза и стала матерью Овида и прабабушкой Давида. Включена в родословие Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Rut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esposa moabita de Mahalón, hijo de Elimelec y Noemí. Tras la muerte de Mahalón, Rut se casó con Booz y se convirtió en madre de Obed y bisabuela de David. Está incluida en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ruthu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mke Mmoabu wa Maloni aliyekuwa mwana wa Elimeleki na Naomi. Baada ya kifo cha Maloni, Ruthu aliolewa na Boazi na hivyo akawa mama ya Obedi na nyanya mkuu wa Daudi. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Meri Moap em meri bilong Malon em i pikinini man bilong Elimelek tupela Naomi. Bihain long Malon i dai pinis, Rut i maritim Boas na em i kamap mama bilong Obet na bubu bilong Devit. Em i stap tu long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "راعوث",
      "descriptions": [
        {
          "source": "acai",
          "description": "المرأة الموآبية، زوجة محلون ود أليمالك ونعمي. بعد موت محلون، راعوث اتزوجت بوعز وبقت أم عوبيد وجدة داود الكبيرة. وهي مذكورة في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan woman Moab we i waef blong Malon, pikinini boe blong Elimelek mo Nomi. Afta we Malon i ded, Rut i mared long Boas nao i kam mama blong Obed mo aontata-bubu blong Deved. Hem i stap long lis blong laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Rut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwanyị Moab nke bụ nwunye Mahlọn, nwa Elimelek na Naomi. Mgbe Mahlọn nwụsịrị, Rut lụrụ Boaz wee ghọọ nne Obed na nne nna nna Devid. E depụtara ya nʼusoro ọmụmụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "रूथ",
      "descriptions": [
        {
          "source": "acai",
          "description": "एलीमेलेक र नाओमीका छोरा महलोनकी मोआबी पत्नी। महलोनको मृत्युपछि रूथले बोअजसँग विवाह गरिन् र यसरी तिनी ओबेदकी आमा तथा दाऊदकी जिजुआमा बनिन्। तिनी येशूको वंशावलीमा सूचीकृत छिन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ru-tơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người nữ Mô-áp, vợ của Mát-lôn là con trai của Ê-li-mê-léc và Na-ô-mi. Sau khi Mát-lôn qua đời, Ru-tơ kết hôn với Bô-ô và trở thành mẹ của Ô-bết cùng bà cố của Đa-vít. Bà được liệt kê trong dòng dõi của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "路得",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩押女子，以利米勒和拿俄米的兒子瑪倫的妻子。瑪倫去世後，路得嫁給波阿斯，成為俄備得的母親，以及大衛的曾祖母。她被列在耶穌的家譜中。"
        }
      ]
    }
  },
