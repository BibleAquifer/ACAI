  "tribe": "group:Earlypatriarchs",
  "localizations": {
    "eng": {
      "preferred_label": "Nahor",
      "alternate_labels": [
        "Nachor"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Nahor",
          "article": "person:Nahor",
          "description": "A son of Serug, father of Terah, and the patriarch Abraham's grandfather. He is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَاحور",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن سروج، وأبو تارح، وجدّ إبراهيم. وهو مذكور في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拿鹤",
      "descriptions": [
        {
          "source": "acai",
          "description": "西鹿的儿子，他拉的父亲，先祖亚伯拉罕的祖父。他被列在耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Nachor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Serug, père de Térach et grand-père du patriarche Abraham. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Nahor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Serug, mahaifin Tera, kuma kakan uba na uban iyali Ibrahim. An lissafa shi a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "नाहोर",
      "descriptions": [
        {
          "source": "acai",
          "description": "सरूग का एक पुत्र, तेरह का पिता, और कुलपति अब्राहम का दादा। उसका नाम यीशु की वंशावली में दर्ज है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Nahor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Serug, ayah Terah, dan kakek dari bapa leluhur Abraham. Ia tercatat dalam silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Naor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Serugue, pai de Terá e avô do patriarca Abraão. Ele está listado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Нахор",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Серуха, отец Фарры и дед патриарха Авраама. Упоминается в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Najor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Serug, padre de Téraj y abuelo del patriarca Abraham. Se le menciona en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nahori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Serugi, baba yake Tera, na babu yake mzee wa ukoo Abrahamu. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Nahor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Seruk, papa bilong Tera, na tumbuna papa bilong Abraham. Nem bilong em i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "ناحور",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد سروج، وأبو تارح، وجد أبونا إبراهيم. ومذكور في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Naho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Seruk, papa blong Tera, mo bubu man blong Ebraham. Nem blong hem i stap long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nahọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Serụg, nna Tera, na nna nna nke nna ochie Ebraham. E depụtara ya nʼagbụrụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "नाहोर",
      "descriptions": [
        {
          "source": "acai",
          "description": "सरूगका छोरा, तेरहका पिता र कुलपिता अब्राहामका बाजे। उहाँको नाउँ येशूको वंशावलीमा सूचीकृत छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Na-cô",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Sê-rúc, cha của Tha-rê, và là ông nội của tổ phụ Áp-ra-ham. Ông được liệt kê trong gia phả của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "拿鶴",
      "descriptions": [
        {
          "source": "acai",
          "description": "西鹿的兒子、他拉的父親，也是先祖亞伯拉罕的祖父。他被列在耶穌的家譜中。"
        }
      ]
    }
  },
