  "localizations": {
    "eng": {
      "preferred_label": "Jezaniah",
      "alternate_labels": [
        "Jaazaniah",
        "Azariah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jezaniah",
          "article": "person:Jezaniah",
          "description": "A son of Hoshaiah who opposed Gedaliah the governor and Jeremiah the prophet after the Israelite return from exile."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَزَنْيَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن هوشعيا الذي عارض جدليا الحاكم وإرميا النبي بعد رجوع بني إسرائيل من السبي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耶撒尼亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "何沙雅的儿子，在以色列人流亡归回后反对省长基大利和先知耶利米。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jezania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d'Hosée qui s'opposa au gouverneur Guedalia et au prophète Jérémie après le retour de l'exil des Israélites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yezaniya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Hoshahiya wanda ya yi hamayya da Gwamna Gedaliya da annabi Irmiya bayan komowar Isra’ilawa daga zaman bauta."
        }
      ]
    },
    "hin": {
      "preferred_label": "याजन्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "होशायाह का एक पुत्र जिसने इस्राएलियों की बंधुआई से वापसी के बाद राज्यपाल गदल्याह और भविष्यद्वक्ता यिर्मयाह का विरोध किया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yezanya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Hosaya yang menentang Gubernur Gedalya dan Nabi Yeremia setelah pembuangan bangsa Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Jezanias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho de Hosaías que se opôs a Gedalias, o governador, e ao profeta Jeremias após o retorno dos israelitas do exílio."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иезония",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Гошаии, противостоявший наместнику Годолии и пророку Иеремии после возвращения израильтян из плена."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jezanías",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Osaías que se opuso al gobernador Guedalías y al profeta Jeremías tras el regreso de los israelitas del exilio."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yezania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Hoshaya aliyempinga liwali Gedalia na nabii Yeremia baada ya Waisraeli kurudi kutoka uhamishoni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jesania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Hosaia em i bin givim baksait long Gedalia, em gavana, na profet Jeremaia bihain long ol Israel i lusim Babilon na i go bek long graun bilong ol."
        }
      ]
    },
    "apd": {
      "preferred_label": "يزنيا",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد هوشعيا اللي عارض جدليا الحاكم وإرميا النبي بعد رجوع بني إسرائيل من السبي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jesania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan boe blong Hosaea we i agensem gavana Gedalia mo profet Jeremaea afta we ol man Isrel oli aot long kalabus."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jezanaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Hoshaya nke megidere Gedalaya bụ gọvanọ na Jeremaya bụ onye amụma mgbe ụmụ Izrel si na ndọrọ n'agha lọta."
        }
      ]
    },
    "nep": {
      "preferred_label": "याजन्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "होशयाहका छोरा जसले निर्वासनबाट इस्राएलीहरूको फर्काइपछि राज्यपाल गदल्याह र अगमवक्ता यर्मियाको विरोध गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giê-xa-nia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Hô-sa-gia, người đã chống đối tổng đốc Ghê-đa-lia và tiên tri Giê-rê-mi sau khi dân Y-sơ-ra-ên trở về từ nơi lưu đày."
        }
      ]
    },
    "zht": {
      "preferred_label": "耶撒尼亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "何沙雅的兒子，在以色列人從被擄之地歸回後反對省長基大利和先知耶利米。"
        }
      ]
    }
  },
