        }
      ]
    },
    "hin": {
      "preferred_label": "सिकुन्दुस",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिकुन्दुस थिस्सलुनीके का एक मसीही था जो पौलुस का साथी था और जिसका उल्लेख प्रेरितों के काम 20:4 में मिलता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Sekundus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sekundus adalah seorang Kristen dari Tesalonika yang menjadi teman seperjalanan Paulus dan disebutkan dalam Kisah Para Rasul 20:4."
        }
      ]
    },
    "por": {
      "preferred_label": "Secundo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Secundo foi um cristão de Tessalônica, companheiro de Paulo, mencionado em Atos 20:4."
        }
      ]
    },
    "rus": {
      "preferred_label": "Секунд",
      "descriptions": [
        {
          "source": "acai",
          "description": "Секунд — христианин из Фессалоники, спутник Павла, упомянутый в Деяниях 20:4."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sekundo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sekundo alikuwa Mkristo kutoka Thesalonike aliyekuwa mwenzi wa Paulo naye ametajwa katika Matendo 20:4."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sekundus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sekundus em i wanpela Kristen man bilong Tesalonaika na em i bin go wantaim Pol, na Buk Aposel 20:4 i kamapim nem bilong en."
        }
      ]
    },
    "apd": {
      "preferred_label": "سكوندس",
      "descriptions": [
        {
          "source": "acai",
          "description": "سكوندس كان مسيحي من تسالونيكي، وكان رفيق لبولس واتذكر في أعمال الرسل 20: 4."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sekandas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sekandas hem i wan Kristin we i man Tesalonaeka mo wan kampani blong Pol, we nem blong hem i kamaot long Ol Wok 20:4."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sekundus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sekundus bụ Onye Kraịst si na Tesalonaịka nke bụ onye so Pọl na-eje ije ma kpọtụrụ ya aha nʼỌrụ Ndị Ozi 20:4."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिकन्दस",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिकन्दस थेसलोनिकेका एक ख्रीष्‍टियन थिए जो पावलका सहयात्री थिए र उनको उल्लेख प्रेरित २०:४ मा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-cun-đúc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sê-cun-đúc là một Cơ Đốc nhân từ Tê-sa-lô-ni-ca, người bạn đồng hành của Phao-lô và được nhắc đến trong Công vụ các Sứ đồ 20:4."
        }
      ]
    },
    "zht": {
      "preferred_label": "西公都",
      "descriptions": [
        {
          "source": "acai",
          "description": "西公都是來自帖撒羅尼迦的基督徒，是保羅的同工，記載於使徒行傳20:4。"
        }
      ]
    }
  },
