  "localizations": {
    "eng": {
      "preferred_label": "Hadad",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hadad",
          "article": "person:Hadad",
          "description": "An Edomite king and son of Bedad from Avith, who lived before the Israelite kingdom."
        }
      ]
    },
    "fra": {
      "preferred_label": "Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi édomite et fils de Bedad, originaire d'Avith, qui vivait avant l'établissement de la royauté en Israël."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey edomita e hijo de Bedad, de Avit, que vivió antes del reino israelita."
        }
      ]
    },
    "arb": {
      "preferred_label": "هَدَاد",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَلِكٌ أَدُومِيٌّ وَابْنُ بَدَادَ مِنْ عَوِيتَ، عَاشَ قَبْلَ قِيَامِ الْمَمْلَكَةِ الإِسْرَائِيلِيَّةِ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈达",
      "descriptions": [
        {
          "source": "acai",
          "description": "以东王，比达之子，来自亚未得，生活在以色列建国之前。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Edom kuma ɗan Bedad daga Awit, wanda ya rayu kafin masarautar Isra’ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "हदद",
      "descriptions": [
        {
          "source": "acai",
          "description": "अबीत का एक एदोमी राजा और बदद का पुत्र, जो इस्राएली राजतंत्र के समय से पहले जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang raja Edom dan anak Bedad dari Awit, yang hidup sebelum kerajaan Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Hadade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um rei edomita e filho de Bedade, de Avite, que viveu antes do reino israelita."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гадад",
      "descriptions": [
        {
          "source": "acai",
          "description": "Эдомитский царь и сын Бедада из Авифа, живший до возникновения Израильского царства."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hadadi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Edomu na mwana wa Bedadi kutoka Avithi, aliyeishi kabla ya ufalme wa Israeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hadat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela king bilong Idom na pikinini man bilong Bedat bilong taun Avit, em i bin stap paslain long taim bilong kingdom bilong Israel."
        }
      ]
    },
    "apd": {
      "preferred_label": "هدد",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك أدومي وود بداد من عويت، عاش قبل المملكة الإسرائيلية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong Edom we papa blong hem Bedad mo i kamaot long Avit, we i laef bifo long kingdom blong Isrel."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu eze ndị Idọm na nwa Bedad onye si Avit, nke dịrị ndụ tupu alaeze Izrel amalite."
        }
      ]
    },
    "nep": {
      "preferred_label": "हदद",
      "descriptions": [
        {
          "source": "acai",
          "description": "अवीतका बददका छोरा एक एदोमी राजा, जो इस्राएली राज्यकालभन्दा पहिले जीवित थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-đát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vua Ê-đôm và là con trai của Bê-đa quê ở A-vít, sống trước thời vương quốc Ít-ra-en."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈達",
      "descriptions": [
        {
          "source": "acai",
          "description": "以東王，是亞未得人比達的兒子，生活在以色列王國建立之前。"
        }
      ]
    }
  },
