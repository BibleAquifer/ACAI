  "localizations": {
    "eng": {
      "preferred_label": "Ephron",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ephron",
          "article": "person:Ephron.2",
          "description": "The Hittite from whom Abraham bought the cave in Machpelah that he used to bury his wife Sarah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Éphron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le Héthien à qui Abraham acheta la caverne de Macpéla dont il se servit pour enterrer sa femme Sara."
        }
      ]
    },
    "spa": {
      "preferred_label": "Efrón",
      "descriptions": [
        {
          "source": "acai",
          "description": "El hitita a quien Abraham compró la cueva de Macpela que utilizó para sepultar a su esposa Sara."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِفْرون",
      "descriptions": [
        {
          "source": "acai",
          "description": "الحثي الذي اشترى منه إبراهيم مغارة المكفيلة لدفن زوجته سارة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以弗仑",
      "descriptions": [
        {
          "source": "acai",
          "description": "赫人，亚伯拉罕向他买下麦比拉洞，用来安葬妻子撒拉。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Efron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin Hitti wanda Ibrahim ya sayi kogon Makfela daga wurinsa domin ya binne matarsa Saratu."
        }
      ]
    },
    "hin": {
      "preferred_label": "एप्रोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह हित्ती जिससे इब्राहीम ने मकपेला की गुफा खरीदी थी, ताकि वह अपनी पत्नी सारा को दफना सके।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Efron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang Het yang darinya Abraham membeli gua di Makhpela yang ia gunakan untuk menguburkan istrinya, Sara."
        }
      ]
    },
    "por": {
      "preferred_label": "Efrom",
      "descriptions": [
        {
          "source": "acai",
          "description": "O hitita de quem Abraão comprou a caverna de Macpela, usada para sepultar sua esposa Sara."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ефрон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Хеттеянин, у которого Авраам купил пещеру Махпелу, чтобы похоронить свою жену Сарру."
        }
      ]
    },
    "swh": {
      "preferred_label": "Efroni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mhiti ambaye Abrahamu alinunua kutoka kwake pango la Makpela alilotumia kumzika mkewe Sara."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Efron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man bilong lain Hit em Abraham i bin baim hul bilong ston long Makpela long han bilong en bilong planim meri bilong en Sara."
        }
      ]
    },
    "apd": {
      "preferred_label": "عفرون",
      "descriptions": [
        {
          "source": "acai",
          "description": "الحثي الاشتَرَى منه إبراهيم مغارة المكفيلة عشان يدفن فيها زوجته سارة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Efron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man Het ya we Ebraham i bin pem hol blong ston long Makpela long hem blong berem woman blong hem Sera."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Efrọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye Het ahụ Ebraham zụtara ọgba dị na Makipela nʼaka ya nke o ji lie nwunye ya Sera."
        }
      ]
    },
    "nep": {
      "preferred_label": "एप्रोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "हित्ती व्यक्ति जसबाट अब्राहामले आफ्नी पत्नी सारालाई गाड्नका निम्ति मकपेलाको ओडार किनेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ép-rôn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người Hê-tít mà từ ông Áp-ra-ham đã mua hang đá Mạc-bê-la để chôn cất vợ mình là Sa-ra."
        }
      ]
    },
    "zht": {
      "preferred_label": "以弗崙",
      "descriptions": [
        {
          "source": "acai",
          "description": "赫人，亞伯拉罕曾向他買下麥比拉洞，用以安葬妻子撒拉。"
        }
      ]
    }
  },
