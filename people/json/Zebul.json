  "localizations": {
    "eng": {
      "preferred_label": "Zebul",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Zebul",
          "article": "person:Zebul",
          "description": "Zebul was the governor of Shechem and an assistant to Gideon's son Abimelech during the time of the Israelite judges."
        }
      ]
    },
    "fra": {
      "preferred_label": "Zebul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zebul était le gouverneur de Sichem et un adjoint d'Abimélec, fils de Gédéon, à l'époque des juges d'Israël."
        }
      ]
    },
    "spa": {
      "preferred_label": "Zebul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zebul fue el gobernador de Siquem y asistente de Abimelec, hijo de Gedeón, durante la época de los jueces israelitas."
        }
      ]
    },
    "arb": {
      "preferred_label": "زَبُول",
      "descriptions": [
        {
          "source": "acai",
          "description": "زَبُولُ كَانَ رَئِيسَ شَكِيمَ وَمُعَاوِنًا لِأَبِيمَالِكَ بْنِ جِدْعُونَ فِي عَهْدِ قُضَاةِ إِسْرَائِيلَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西布勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "西布勒是以色列士师时代示剑城的长官，也是基甸之子亚比米勒的助手。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Zebul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zebul shi ne gwamnan Shekem kuma mataimakin Abimelek ɗan Gidiyon a zamanin alƙalan Isra’ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "जबूल",
      "descriptions": [
        {
          "source": "acai",
          "description": "जबूल शेकेम का हाकिम था और इस्राएली न्यायियों के समय गिदोन के पुत्र अबीमेलेक का सहायक था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Zebul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zebul adalah penguasa Sikhem dan pembantu Abimelekh anak Gideon pada zaman para hakim Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Zebul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zebul foi o governador de Siquém e assistente de Abimeleque, filho de Gideão, durante a época dos juízes de Israel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Зевул",
      "descriptions": [
        {
          "source": "acai",
          "description": "Зевул был начальником Сихема и помощником Авимелеха, сына Гедеона, во времена израильских судей."
        }
      ]
    },
    "swh": {
      "preferred_label": "Zebuli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zebuli alikuwa mtawala wa Shekemu na msaidizi wa Abimeleki mwana wa Gideoni wakati wa waamuzi wa Israeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sebul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebul em i hetman bilong taun Sekem na wanpela helpim bilong pikinini man bilong Gideon, Abimelek, long taim bilong ol hetman bilong Israel."
        }
      ]
    },
    "apd": {
      "preferred_label": "زبول",
      "descriptions": [
        {
          "source": "acai",
          "description": "زبول كان حاكم شكيم ومساعد لأبيمالك ولد جدعون في زمن قضاة إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sebul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sebul hem i gavana blong Sekem mo man blong givhan long Abimelek we i boe blong Gidion long taem blong ol jaj blong Isrel."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Zebul",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zebul bụ onye na-achị Shekem na onye na-enyere nwa Gidiọn bụ Abimelek aka nʼoge ndị ikpe Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "जबूल",
      "descriptions": [
        {
          "source": "acai",
          "description": "जबूल इस्राएली न्यायकर्ताहरूको समयमा शकेमका अधिकारी र गिदोनका छोरा अबीमेलेकका एक सहयोगी थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Xê-bun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Xê-bun là quan cai quản thành Si-chem và là phụ tá của A-bi-mê-léc, con trai Ghê-đê-ôn, trong thời kỳ các quan xét của Y-sơ-ra-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "西布勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "西布勒是以色列士師時期示劍的邑宰，也是基甸之子亞比米勒的助手。"
        }
      ]
    }
  },
