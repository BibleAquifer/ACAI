        {
          "source": "acai",
          "gloss": "Naphish",
          "article": "person:Naphish",
          "description": "Naphish, a man living at the time of the patriarchs, was a son of Ishmael and part of the Arab tribes."
        }
      ]
    },
    "fra": {
      "preferred_label": "Naphisch",
      "descriptions": [
        {
          "source": "acai",
          "description": "Naphisch, un homme ayant vécu à l’époque des patriarches, était un fils d’Ismaël et faisait partie des tribus arabes."
        }
      ]
    },
    "spa": {
      "preferred_label": "Nafis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nafis, un hombre que vivió en la época de los patriarcas, fue hijo de Ismael y parte de las tribus árabes."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَافِيش",
      "descriptions": [
        {
          "source": "acai",
          "description": "نافيش، رجل عاش في زمن الآباء، وكان ابنًا لإسماعيل ومن القبائل العربية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拿非施",
      "descriptions": [
        {
          "source": "acai",
          "description": "拿非施是生活在先祖时期的人物，是以实玛利的儿子，属于阿拉伯部族。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Nafish",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nafish, wani mutum da ya rayu a zamanin kakannin dā, ya kasance ɗan Ishmayel kuma ɓangaren ƙabilun Larabawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "नापीश",
      "descriptions": [
        {
          "source": "acai",
          "description": "नापीश, कुलपिताओं के समय रहने वाला एक व्यक्ति, इश्माएल का पुत्र और अरब जनजातियों का हिस्सा था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Nafish",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nafish, seorang pria yang hidup pada zaman para bapa leluhur, adalah anak Ismael dan bagian dari suku-suku Arab."
        }
      ]
    },
    "por": {
      "preferred_label": "Nafis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nafis, um homem que viveu na época dos patriarcas, foi filho de Ismael e fez parte das tribos árabes."
        }
      ]
    },
    "rus": {
      "preferred_label": "Нафиш",
      "descriptions": [
        {
          "source": "acai",
          "description": "Нафиш, живший во времена патриархов, был сыном Измаила и принадлежал к арабским племенам."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nafishi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nafishi, mtu aliyeishi wakati wa wazee wa ukoo, alikuwa mwana wa Ishmaeli na sehemu ya makabila ya Kiarabu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Nafis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nafis em i wanpela man i bin stap long taim bilong ol bikbipo tumbuna, em i pikinini man bilong Ismael na em i wanpela bilong ol lain Arab."
        }
      ]
    },
    "apd": {
      "preferred_label": "نافيش",
      "descriptions": [
        {
          "source": "acai",
          "description": "نافيش، راجل عاش في زمن الآباء الأولين، كان ولد إسماعيل ومن قبائل العرب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Nafis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nafis, wan man we i laef long taem blong ol fastelem papa, hem i wan pikinini boe blong Ismael mo haf blong ol laen blong Arebia."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nafish",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nafish, nwoke biri nʼoge ndị nna ochie, bụ nwa Ishmel na akụkụ nke ebo ndị Arab."
        }
      ]
    },
    "nep": {
      "preferred_label": "नापीश",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिताहरूको समयमा बाँचेका एक पुरुष नापीश, जो इश्‍माएलका छोरा र अरबी कुलहरूका हिस्सा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Na-phích",
      "descriptions": [
        {
          "source": "acai",
          "description": "Na-phích, một người sống vào thời các tổ phụ, là con trai của Ích-ma-ên và thuộc các bộ tộc Ả-rập."
        }
      ]
    },
    "zht": {
      "preferred_label": "拿非施",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在先祖時期的男子拿非施，是以實瑪利的兒子，屬於阿拉伯部族。"
        }
      ]
    }
  },
