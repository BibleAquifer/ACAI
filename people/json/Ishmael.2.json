  "localizations": {
    "eng": {
      "preferred_label": "Ishmael",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ishmael",
          "article": "person:Ishmael.2",
          "description": "A son of Nethaniah and royal family member. Ishmael killed the governor Gedaliah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Ismaël",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Nethania et membre de la famille royale. Ismaël tua le gouverneur Guedalia."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ismael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Nethanías y miembro de la familia real. Ismael mató al gobernador Guedalías."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِسْمَاعِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن نَثَنْيَا وأحد أفراد النسل الملكي. قتل إِسْمَاعِيل الحاكم جَدَلْيَا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以实玛利",
      "descriptions": [
        {
          "source": "acai",
          "description": "尼探雅的儿子，王室后裔。以实玛利刺杀了省长基大利。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ishmayel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Netaniya kuma ɗan gidan sarauta. Ishmayel ya kashe gwamna Gedaliya."
        }
      ]
    },
    "hin": {
      "preferred_label": "इश्माएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "नतन्याह का एक पुत्र और राजवंश का सदस्य। इश्माएल ने राज्यपाल गदल्याह की हत्या की थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ismael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak Netanya dan anggota keluarga kerajaan. Ismael membunuh gubernur Gedalya."
        }
      ]
    },
    "por": {
      "preferred_label": "Ismael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho de Netanias e membro da família real. Ismael matou o governador Gedalias."
        }
      ]
    },
    "rus": {
      "preferred_label": "Исмаил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Нефании и член царского рода. Исмаил убил наместника Годолию."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ishmaeli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Nethania na mshiriki wa familia ya kifalme. Ishmaeli alimuua liwali Gedalia."
        }
      ]
    },
    "apd": {
      "preferred_label": "إسماعيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن نثنيا ومن أفراد العيلة الملكية. إسماعيل قتل الحاكم جدليا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ismael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Netania mo memba blong famle blong king. Ismael i kilim gavman Gedalia i ded."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ishmel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke Netanaya na onye si nʼagbụrụ eze. Ishmel gburu gọvanọ Gedaliya."
        }
      ]
    },
    "nep": {
      "preferred_label": "इश्माएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "नतन्याहका छोरा र राजकीय वंशका सदस्य। इश्माएलले गभर्नर गदल्याहलाई मारेका थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ismael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Netania na wanpela memba bilong lain famili bilong king. Ismael i bin kilim gavana Gedalia i dai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ích-ma-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Nê-tha-nia và là một thành viên hoàng tộc. Ích-ma-ên đã giết tổng trấn Ghê-đa-lia."
        }
      ]
    },
    "zht": {
      "preferred_label": "以實瑪利",
      "descriptions": [
        {
          "source": "acai",
          "description": "尼探雅的兒子，王室成員。以實瑪利殺害了省長基大利。"
        }
      ]
    }
  },
