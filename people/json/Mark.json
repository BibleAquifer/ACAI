      "descriptions": [
        {
          "source": "acai",
          "gloss": "Mark",
          "article": "person:Mark",
          "description": "A fellow traveller of Paul and Barnabas he is also traditionally considered to be the author of the Gospel of Mark."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَرْقُس",
      "descriptions": [
        {
          "source": "acai",
          "description": "رفيق سفر لبولس وبرنابا، ويُعتبر تقليدياً كاتب إنجيل مرقس."
        }
      ]
    },
    "zhs": {
      "preferred_label": "马可",
      "descriptions": [
        {
          "source": "acai",
          "description": "保罗和巴拿巴的同行旅伴，传统上也认为他是马可福音的作者。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Marc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Compagnon de voyage de Paul et Barnabas, il est aussi traditionnellement considéré comme l'auteur de l'Évangile selon Marc."
        }
      ]
    },
    "hau": {
      "preferred_label": "Markus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abokin tafiyar Bulus da Barnabas, wanda kuma bisa al’ada ake ɗaukarsa marubucin Bisharar Markus."
        }
      ]
    },
    "hin": {
      "preferred_label": "मरकुस",
      "descriptions": [
        {
          "source": "acai",
          "description": "पौलुस और बरनबास का एक सहयात्री, जिसे पारंपरिक रूप से मरकुस के सुसमाचार का लेखक भी माना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Markus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Teman seperjalanan Paulus dan Barnabas yang menurut tradisi juga dianggap sebagai penulis Injil Markus."
        }
      ]
    },
    "por": {
      "preferred_label": "Marcos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Companheiro de viagem de Paulo e Barnabé, também considerado tradicionalmente o autor do Evangelho de Marcos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Марк",
      "descriptions": [
        {
          "source": "acai",
          "description": "Спутник Павла и Варнавы в путешествиях; по церковному преданию, автор Евангелия от Марка."
        }
      ]
    },
    "spa": {
      "preferred_label": "Marcos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Compañero de viaje de Pablo y Bernabé, considerado también tradicionalmente el autor del Evangelio de Marcos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Marko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Msafiri mwenza wa Paulo na Barnaba, ambaye pia kimapokeo anachukuliwa kuwa mwandishi wa Injili ya Marko."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela poroman bilong Pol na Barnabas long ol raun bilong ol, na bilip bilong bipo i tok em i man i bin raitim Gutnius bilong Mak."
        }
      ]
    },
    "apd": {
      "preferred_label": "مرقس",
      "descriptions": [
        {
          "source": "acai",
          "description": "رفيق سفر لبولس وبرنابا، وحسب التقليد بيعتبر كاتب إنجيل مرقس."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i stap travel wetem Pol mo Banabas, we olgeta man oli bilif tu se hem nao i raetem Gospel blong Mak."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye njem ibe Pọl na Banabas, nke a na-ewerekwa dị ka onye dere Oziọma Mak dịka omenala si dị."
        }
      ]
    },
    "nep": {
      "preferred_label": "मर्कूस",
      "descriptions": [
        {
          "source": "acai",
          "description": "पावल र बारनाबासका एक सहयात्री, जसलाई परम्परागत रूपमा मर्कूसको सुसमाचारका लेखक पनि मानिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Mác",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một bạn đồng hành của Phao-lô và Ba-na-ba, theo truyền thống cũng được xem là tác giả của Phúc âm Mác."
        }
      ]
    },
    "zht": {
      "preferred_label": "馬可",
      "descriptions": [
        {
          "source": "acai",
          "description": "保羅和巴拿巴的同工與旅伴，傳統上也被認為是《馬可福音》的作者。"
        }
      ]
    }
  },
