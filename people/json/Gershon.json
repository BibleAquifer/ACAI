    "arb": {
      "preferred_label": "جِرْشُونُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَحَدُ أَبْنَاءِ لَاوِي الثَّلَاثَةِ. وَكَانَ مُؤَسِّسَ عَشِيرَةِ الْجَرْشُونِيِّينَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "革顺",
      "descriptions": [
        {
          "source": "acai",
          "description": "利未的三个儿子之一，是革顺家族的始祖。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Guerschon",
      "descriptions": [
        {
          "source": "acai",
          "description": "L'un des trois fils de Lévi. Il fut le fondateur du clan des Guershonites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gershon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗaya daga cikin ’ya’ya maza uku na Lawi. Shi ne ya kafa dangin Gershonawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "गेर्शोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "लेवी के तीन पुत्रों में से एक। वह गेर्शोनियों के कुल का संस्थापक था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gerson",
      "descriptions": [
        {
          "source": "acai",
          "description": "Salah satu dari ketiga putra Lewi. Ia adalah pendiri kaum orang Gerson."
        }
      ]
    },
    "por": {
      "preferred_label": "Gérson",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um dos três filhos de Levi. Ele foi o fundador do clã dos gersonitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гирсон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Один из трех сыновей Левия. Он был родоначальником клана гирсонитян."
        }
      ]
    },
    "spa": {
      "preferred_label": "Gersón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uno de los tres hijos de Leví. Fue el fundador del clan gersonita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gershoni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmoja wa wana watatu wa Lawi. Alikuwa mwanzilishi wa ukoo wa Wagershoni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gerson",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bilong tripela pikinini man bilong Livai. Em i as bilong lain Gerson."
        }
      ]
    },
    "apd": {
      "preferred_label": "جرشون",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحد من أولاد لاوي التلاتة. وهو مؤسس عشيرة الجرشونيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Geson",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan long trifala pikinini boe blong Livae. Hem i stamba blong laen blong ol pikinini blong Geson."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Geshọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nʼime ụmụ ndị ikom atọ nke Livayị. Ọ bụ onye guzobere ezinụlọ ndị Geshọn."
        }
      ]
    },
    "nep": {
      "preferred_label": "गेर्शोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "लेवीका तीन छोराहरूमध्ये एक, जो गेर्शोनी कुलका संस्थापक थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ghẹt-sôn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một trong ba người con trai của Lê-vi. Ông là người sáng lập thị tộc người Ghẹt-sôn."
        }
      ]
    },
    "zht": {
      "preferred_label": "革順",
      "descriptions": [
        {
          "source": "acai",
          "description": "利未的三個兒子之一。他是革順家族的創始人。"
        }
      ]
    }
  },
