  "localizations": {
    "eng": {
      "preferred_label": "Korah",
      "alternate_labels": [
        "Core",
        "Korahite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Korah",
          "article": "person:Korah.3",
          "description": "A Levitical priest and adversary of the high priest Aaron who lived during the time of the Egyptian slavery and wilderness wandering of the Israelites. "
        }
      ]
    },
    "arb": {
      "preferred_label": "قُورَح",
      "descriptions": [
        {
          "source": "acai",
          "description": "كاهن لاوي ومقاوم لرئيس الكهنة هارون، عاش في فترة العبودية في مصر وتيه بني إسرائيل في البرية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "可拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "利未支派的祭司，大祭司亚伦的反对者，生活在以色列人受埃及奴役和旷野漂泊时期。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Koré",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prêtre lévitique et adversaire du grand prêtre Aaron ayant vécu à l'époque de l'esclavage en Égypte et de l'errance des Israélites dans le désert."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Firist ɗan Lawi kuma abokin hamayyar babban firist Haruna wanda ya rayu a lokacin bautar Masar da yawon Isra’ilawa a hamada."
        }
      ]
    },
    "hin": {
      "preferred_label": "कोरह",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक लेवीय याजक और महायाजक हारून का विरोधी, जो मिस्र की दासता और इस्राएलियों के जंगल में भटकने के समय जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Korah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang imam Lewi dan penentang imam besar Harun yang hidup pada masa perbudakan di Mesir dan pengembaraan bangsa Israel di padang gurun."
        }
      ]
    },
    "por": {
      "preferred_label": "Corá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um sacerdote levita e adversário do sumo sacerdote Arão que viveu durante a escravidão no Egito e a peregrinação dos israelitas no deserto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Корей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитский священник и противник первосвященника Аарона, живший во времена египетского рабства и странствования израильтян по пустыне."
        }
      ]
    },
    "spa": {
      "preferred_label": "Coré",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sacerdote levita y adversario del sumo sacerdote Aarón que vivió durante la época de la esclavitud en Egipto y la travesía por el desierto de los israelitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhani Mlawi na mpinzani wa kuhani mkuu Haruni aliyeishi wakati wa utumwa wa Misri na kutangatanga jangwani kwa Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pris bilong lain Livai na birua bilong bikpris Aron, em i bin stap laip long taim bilong ol Israel i stap kalabus long Isip na long taim ol i bin raun long ples drai nating."
        }
      ]
    },
    "apd": {
      "preferred_label": "قورح",
      "descriptions": [
        {
          "source": "acai",
          "description": "كاهن لاوي ومخاصم لرئيس الكهنة هارون، عاش في زمن العبودية في مصر والتوهان في البرية لبني إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pris blong laen blong Livae mo enemi blong hae pris Eron we i laef long taem we ol man Isrel oli slef long Isip mo oli stap wokbaot long draeples."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye nchụàjà sitere n'agbụrụ Livayị na onye mmegide nke nnukwu onye nchụàjà bụ Erọn, onye dịrị ndụ n'oge ịbụ ohu n'Ijipt na njegharị n'ọzara nke ụmụ Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "कोरह",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक लेवी पुजारी र प्रधान पुजारी हारूनका विरोधी, जो इस्राएलीहरूको मिश्रको दासत्व र उजाड-स्थानको यात्राको समयमा बाँचेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Cô-ra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thầy tế lễ người Lê-vi và là kẻ chống đối thầy tế lễ thượng phẩm A-rôn, sống trong thời kỳ dân Y-sơ-ra-ên chịu cảnh nô lệ tại Ai Cập và lưu lạc trong đồng vắng."
        }
      ]
    },
    "zht": {
      "preferred_label": "可拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位利未祭司，大祭司亞倫的反對者，生活在以色列人在埃及受奴役和曠野漂泊的時期。"
        }
      ]
    }
  },
