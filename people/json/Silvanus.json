        }
      ]
    },
    "por": {
      "preferred_label": "Silvano (Silas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem cristão que foi cooperador do apóstolo Paulo, mencionado muitas vezes no Novo Testamento."
        }
      ]
    },
    "rus": {
      "preferred_label": "Силуан (Сила)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Христианин, бывший сотрудником апостола Павла и многократно упоминаемый в Новом Завете."
        }
      ]
    },
    "swh": {
      "preferred_label": "Silwano (Sila)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu Mkristo aliyekuwa mtendakazi mwenza wa mtume Paulo, aliyetajwa mara nyingi katika Agano Jipya."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Silvanus (Sailas)",
      "descriptions": [
        {
          "source": "acai",
