      ]
    },
    "hin": {
      "preferred_label": "सिलवानुस (सीलास)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक मसीही व्यक्ति जो प्रेरित पौलुस का सहकर्मी था, और जिसका नया नियम में कई बार उल्लेख आया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Silwanus (Silas)",
      "descriptions": [
        {
          "source": "acai",
