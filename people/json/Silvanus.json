        }
      ]
    },
    "bis": {
      "preferred_label": "Silvanas (Saelas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan Kristin man we i wan wokman wetem aposol Pol, we Niu Testamen i tokbaot hem plante taem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Silvanọs (Saịlas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke bụ Onye Kraịst nke bụ onye ya na ya na-arụkọ ọrụ nke Pọl onye ozi, nke a kpọtụrụ aha ọtụtụ ugboro nʼAgba Ọhụrụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिल्भानुस (सिलास)",
