        {
          "source": "acai",
          "gloss": "Hananiah",
          "article": "person:Hananiah.12",
          "description": "A son of Azzur from Gibeon and false prophet during the time of the prophet Jeremiah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Hanania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d’Azzur originaire de Gabaon et faux prophète à l’époque du prophète Jérémie."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hananías",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Azur de Gabaón y falso profeta durante la época del profeta Jeremías."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَنَنْيَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن عَزُور من جبعون ونبي كاذب في زمن النبي إرميا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈拿尼雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "来自基遍的押朔的儿子，先知耶利米时期的假先知。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hananiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Azzur daga Gibeyon kuma annabin ƙarya a zamanin annabi Irmiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "हनन्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "गिबोन निवासी अज्जूर का पुत्र और भविष्यद्वक्ता यिर्मयाह के समय का एक झूठा भविष्यद्वक्ता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hananya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Azur dari Gibeon dan nabi palsu pada zaman nabi Yeremia."
        }
      ]
    },
    "por": {
      "preferred_label": "Hananias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Azur, de Gibeom, e falso profeta durante o tempo do profeta Jeremias."
        }
      ]
    },
    "rus": {
      "preferred_label": "Анания",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Азура из Гаваона и лжепророк во времена пророка Иеремии."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hanania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Azuri kutoka Gibeoni na nabii wa uongo wakati wa nabii Yeremia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hanania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Asur bilong Gibeon na giaman profet long taim bilong profet Jeremaia."
        }
      ]
    },
    "apd": {
      "preferred_label": "حنانيا",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد عزور من جبعون ونبي كذاب في زمن النبي إرميا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hanania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan boe blong Asuru we i kamaot long Gibeon mo wan giaman profet long taem blong Profet Jeremaea."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hananaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Azoa onye si Gibiọn na onye amụma ụgha n'oge onye amụma Jeremaya."
        }
      ]
    },
    "nep": {
      "preferred_label": "हनन्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "गिबोनका अजूरका छोरा र अगमवक्ता यर्मियाको समयका एक झूटा अगमवक्ता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-na-nia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của A-xua đến từ Ga-ba-ôn và là một tiên tri giả trong thời của tiên tri Giê-rê-mi."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈拿尼雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "來自基遍的押朔的兒子，先知耶利米時期的假先知。"
        }
      ]
    }
  },
