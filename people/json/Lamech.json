  "localizations": {
    "eng": {
      "preferred_label": "Lamech",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Lamech",
          "article": "person:Lamech",
          "description": "A son of Methushael, descendant of Adam's son Cain, and father of Jabal, Jubal, Tubal-cain, and Naamah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Lémec",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Metuschaël, descendant de Caïn le fils d'Adam, et père de Jabal, de Jubal, de Tubal-Caïn et de Naama."
        }
      ]
    },
    "spa": {
      "preferred_label": "Lamec",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Metusael, descendiente de Caín, hijo de Adán, y padre de Jabal, Jubal, Tubal-Caín y Naama."
        }
      ]
    },
    "arb": {
      "preferred_label": "لَامَك",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن متوشائيل، من نسل قايين بن آدم، وأبو يابال ويوبال وتوبال قايين ونعمة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拉麦",
      "descriptions": [
        {
          "source": "acai",
          "description": "玛土撒利的儿子，亚当之子该隐的后代，雅八、犹八、土八·该隐和拿玛的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Lamek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Metushayel, zuriyar Kayinu ɗan Adamu, kuma mahaifin Yabal, Yubal, Tubal-Kayinu, da Na’ama."
        }
      ]
    },
    "hin": {
      "preferred_label": "लेमेक",
      "descriptions": [
        {
          "source": "acai",
          "description": "मतूशाएल का एक पुत्र, आदम के पुत्र कैन का वंशज, और याबाल, यूबाल, तूबल्कैन और नामाह का पिता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Lamekh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Metusael, keturunan Kain anak Adam, dan ayah Yabal, Yubal, Tubal-Kain, dan Naama."
        }
      ]
    },
    "por": {
      "preferred_label": "Lameque",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Metusael, descendente de Caim, filho de Adão, e pai de Jabal, Jubal, Tubalcaim e Naamá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ламех",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Мафусала, потомок Каина, сына Адама, и отец Иавала, Иувала, Тувалкаина и Ноемы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Lameki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Methushaeli, mzao wa Kaini mwana wa Adamu, na baba ya Yabali, Yubali, Tubal-kaini, na Naama."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lamek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Metusael, tumbuna pikinini bilong Kein em pikinini man bilong Adam, na papa bilong Jabal, Jubal, Tubalkein, na Nama."
        }
      ]
    },
    "apd": {
      "preferred_label": "لامك",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد متوشائيل، ومن نسل قايين ولد آدم، وأبو يابال، ويوبال، وتوبال قايين، ونعمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Lamek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Metusael, laen blong Ken we i pikinini blong Adam, mo papa blong Jabal, Jubal, Tubal-ken, mo Naama."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Lamek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Metusael, nwa nwa Ken nwa Adam, na nna Jabal, Jubal, Tubal-ken, na Naama."
        }
      ]
    },
    "nep": {
      "preferred_label": "लेमेख",
      "descriptions": [
        {
          "source": "acai",
          "description": "मतूशाएलका छोरा, आदमका छोरा कयिनका सन्तान, र याबाल, यूबाल, तूबल्कयिन तथा नामाका पिता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Lê-méc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Mê-tu-sa-ên, hậu tự của Ca-in là con trai của A-đam, và là cha của Gia-banh, Giu-banh, Tu-banh Ca-in, và Na-a-ma."
        }
      ]
    },
    "zht": {
      "preferred_label": "拉麥",
      "descriptions": [
        {
          "source": "acai",
          "description": "瑪土撒利的兒子，亞當之子該隱的後裔，是雅八、猶八、土八‧該隱和拿瑪的父親。"
        }
      ]
    }
  },
