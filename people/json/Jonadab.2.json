          "source": "acai",
          "gloss": "Jonadab",
          "article": "person:Jonadab.2",
          "description": "King David’s nephew from the tribe of Judah and a son of Shimeah."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُونَادَاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن أخي الملك داود، من سبط يهوذا، وهو ابن شمعى."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约拿达",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王的侄子，出自犹大支派，是示米亚的儿子。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neveu du roi David de la tribu de Juda et fils de Schimea."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan ɗan'uwan Sarki Dawuda daga kabilar Yahuda kuma ɗan Shimeya."
        }
      ]
    },
    "hin": {
      "preferred_label": "योनादाब",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा के गोत्र से राजा दाऊद का भतीजा और शिमआह का पुत्र।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kemenakan Raja Daud dari suku Yehuda dan anak laki-laki Simea."
        }
      ]
    },
    "por": {
      "preferred_label": "Jonadabe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sobrinho do rei Davi, da tribo de Judá, e filho de Simeia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ионадав",
      "descriptions": [
        {
          "source": "acai",
          "description": "Племянник царя Давида из колена Иуды, сын Самая."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sobrino del rey David, de la tribu de Judá e hijo de Simea."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yonadabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mpwa wa Mfalme Daudi kutoka kabila la Yuda na mwana wa Shama."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jonadap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kandere bilong King Devit bilong lain bilong Juda na wanpela pikinini man bilong Sama."
        }
      ]
    },
    "apd": {
      "preferred_label": "يوناداب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن أخو الملك داود من قبيلة يهوذا، وولد شمعي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini blong brata blong King Deved we i kamaot long laen blong Juta, mo pikinini boe blong Simea."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwanne Eze Devid nke sitere nʼebo Juda na nwa Shimea."
        }
      ]
    },
    "nep": {
      "preferred_label": "योनादाब",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा कुलका राजा दाऊदका भतिजा र शिमाहका छोरा।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-na-đáp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cháu gọi Vua Đa-vít bằng bác, thuộc bộ tộc Giu-đa và là con trai của Si-mê-a."
        }
      ]
    },
    "zht": {
      "preferred_label": "約拿達",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王的姪兒，出自猶大支派，是示米亞的兒子。"
        }
      ]
    }
  },
