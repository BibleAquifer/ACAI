        }
      ]
    },
    "swh": {
      "preferred_label": "Prisila",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanafunzi Mkristo na mke wa Akila, ambao wote wawili walikuwa wenzi na wafanyakazi wenza wa mtume Paulo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Prisila",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela Kristen disaipel na meri bilong Akwila, tupela wantaim i bin stap poroman na wanwok bilong aposel Pol."
        }
      ]
    },
    "apd": {
      "preferred_label": "بريسكلا",
      "descriptions": [
        {
          "source": "acai",
          "description": "تلميذة مسيحية وزوجة أكيلا، والاثنان كانا رفقاء وزملاء عمل للرسول بولس."
        }
      ]
    },
    "bis": {
      "preferred_label": "Prisila",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan disaepol blong Jisas mo woman blong Akwila, we tufala i fren mo man blong wok wetem aposol Pol."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Prisila",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye na-eso ụzọ Kraịst na nwunye Akwila, bụ́ ndị ha abụọ bụ ndị enyi na ndị ọrụ ibe nke Pọl onye ozi."
        }
      ]
    },
    "nep": {
      "preferred_label": "प्रिस्किला",
      "descriptions": [
        {
          "source": "acai",
          "description": "ख्रीष्टियान चेली र अकिलासकी पत्नी, जो दुवै प्रेरित पावलका साथी र सहकर्मी थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Bê-rít-sin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Môn đồ Cơ Đốc và là vợ của A-qui-la; cả hai đều là bạn đồng hành và bạn đồng sự của sứ đồ Phao-lô."
        }
      ]
    },
    "zht": {
      "preferred_label": "百基拉",
      "descriptions": [
        {
