  "localizations": {
    "eng": {
      "preferred_label": "Javan",
      "alternate_labels": [
        "Greek",
        "Greek, Gentile",
        "Gentile"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Javan",
          "article": "person:Javan",
          "description": "A grandson of the patriarch Noah, a son of Japheth, and ancestor of the Greeks."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَاوَانُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد البطريرك نوح، وابن يَافَثَ، وجدّ اليونانيين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "雅完",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖挪亚的孙子，雅弗的儿子，希腊人的祖先。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Javan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit-fils du patriarche Noé, fils de Japhet et ancêtre des Grecs."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yaban",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jikan uban iyali Nuhu, ɗan Yafet, kuma kakan Helenawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "यावान",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नूह का एक पोता, येपेत का एक पुत्र, और यूनानियों का पूर्वज।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yawan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cucu dari bapa leluhur Nuh, anak laki-laki Yafet, dan leluhur orang Yunani."
        }
      ]
    },
    "por": {
      "preferred_label": "Javã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neto do patriarca Noé, filho de Jafé e antepassado dos gregos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иаван",
      "descriptions": [
        {
          "source": "acai",
          "description": "Внук патриарха Ноя, сын Иафета и предок греков."
        }
      ]
    },
    "spa": {
      "preferred_label": "Javán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nieto del patriarca Noé, hijo de Jafet y antepasado de los griegos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yavani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mjukuu wa mzee wa ukoo Nuhu, mwana wa Yafethi, na babu wa Wagiriki."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Javan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela tumbuna pikinini bilong bikpela tumbuna Noa, pikinini man bilong Jafet, na tumbuna bilong ol Grik."
        }
      ]
    },
    "apd": {
      "preferred_label": "ياوان",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد نوح، وولد يافث، وجد اليونانيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Javan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smol bubu boe blong patriak Noa, wan pikinini boe blong Jafet, mo stambapapa blong ol man Gris."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Javan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa nke nna ochie bụ Noa, nwa Jafet, na nna nna ochie nke ndị Gris."
        }
      ]
    },
    "nep": {
      "preferred_label": "यावान",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नूहका एक नाति, येपेतका छोरा र युनानीहरूका पुर्खा।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Gia-van",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người cháu nội của tổ phụ Nô-ê, con trai của Gia-phết, và là tổ tiên của người Hy Lạp."
        }
      ]
    },
    "zht": {
      "preferred_label": "雅完",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖挪亞的孫子，雅弗的兒子，希臘人的祖先。"
        }
      ]
    }
  },
