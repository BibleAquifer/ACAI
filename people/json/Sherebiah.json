  "localizations": {
    "eng": {
      "preferred_label": "Sherebiah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Sherebiah",
          "article": "person:Sherebiah",
          "description": "A Levite who was called a \"man of discretion,\" and lived during the time of Israelite exile and return."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَرَبْيَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوي وُصف بأنه «رجل فطن»، وعاش في زمن سبي بني إسرائيل ورجوعهم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "示利比",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位被称为“通达人”的利未人，生活在以色列人流亡与归回时期。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Schérébia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lévite qualifié d'« homme de sens », qui vivait à l'époque de l'exil et du retour des Israélites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sherebiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani Balarawi wanda aka kira \\\"mutum mai fahimi,\\\" kuma ya rayu a lokacin zaman bautar Isra’ilawa da komowa."
        }
      ]
    },
    "hin": {
      "preferred_label": "शेरेब्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक लेवीय जिसे \\\"समझदार पुरुष\\\" कहा गया था, और वह इस्राएलियों की बंधुआई और वापसी के समय जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Serebya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang Lewi yang disebut sebagai \\\"orang yang berakal budi\\\", dan hidup pada masa pembuangan dan pemulangan bangsa Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Serebias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um levita que era chamado de \\\"homem prudente\\\", e viveu durante a época do exílio e do retorno israelita."
        }
      ]
    },
    "rus": {
      "preferred_label": "Шеревия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левит, названный «человеком умным», живший во времена изгнания и возвращения израильтян."
        }
      ]
    },
    "spa": {
      "preferred_label": "Serebías",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un levita llamado «hombre entendido», que vivió durante la época del exilio y el retorno israelita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sherebia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mlawi aliyeitwa \\\"mtu mwenye busara,\\\" na aliyeishi wakati wa uhamisho na kurudi kwa Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Serebia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela Livai ol i bin kolim “man bilong mekim gutpela wok,” na em i bin stap long taim bilong ol Israel i go kalabus na taim bilong ol i kam bek."
        }
      ]
    },
    "apd": {
      "preferred_label": "شربيا",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوي اتوصف بأنه \\\"راجل فهيم\\\"، وعاش في زمن سبي ورجوع بني إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Serebia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan Livaet we oli kolem se wan \\\"man we i gat hed,\\\" mo hem i bin laef long taem we ol man Isrel oli stap long kalabus mo taem we oli kambak."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sherebaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu onye Livayị a kpọrọ \\\"nwoke nwere ezi uche,\\\" nke biri nʼoge ndọrọ nʼagha na nloghachi nke ndị Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "शरेबियाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक लेवी जसलाई \\\"बुद्धिमान् मानिस\\\" भनिएको थियो, र जो इस्राएलीहरूको निर्वासन र फिर्तीको समयमा जिउँथे।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-rê-bia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người Lê-vi được gọi là \\\"người thông sáng\\\" và sống vào thời kỳ dân Y-sơ-ra-ên bị lưu đày và hồi hương."
        }
      ]
    },
    "zht": {
      "preferred_label": "示利比",
      "descriptions": [
        {
          "source": "acai",
          "description": "一名被稱為「通達人」的利未人，生活於以色列人流亡及回歸時期。"
        }
      ]
    }
  },
