          "description": "Hija del patriarca Jacob y de su esposa Lea. Era hermana de Simeón y Leví."
        }
      ]
    },
    "arb": {
      "preferred_label": "دِينَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابنة رئيس الآباء يعقوب وزوجته ليئة. وكانت أختًا لشمعون ولاوي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "底拿",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长雅各与其妻利亚的女儿，西缅和利未的妹妹。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Dina",
      "descriptions": [
        {
          "source": "acai",
          "description": "’Yar uban iyali Yaƙub da matarsa Liyatu. Ita ’yar’uwar Simeyon ce da Lawi."
        }
      ]
    },
    "hin": {
      "preferred_label": "दीना",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता याकूब और उनकी पत्नी लिआ की पुत्री। वह शिमोन और लेवी की बहन थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Dina",
      "descriptions": [
        {
          "source": "acai",
          "description": "Putri dari bapa leluhur Yakub dan istrinya, Lea. Ia adalah saudari Simeon dan Lewi."
        }
      ]
    },
    "por": {
      "preferred_label": "Diná",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filha do patriarca Jacó e de sua esposa Lia. Ela era irmã de Simeão e Levi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дина",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дочь патриарха Иакова и его жены Лии. Она была сестрой Симеона и Левия."
        }
      ]
    },
    "swh": {
      "preferred_label": "Dina",
      "descriptions": [
        {
          "source": "acai",
          "description": "Binti wa babu mkuu Yakobo na mkewe Lea. Alikuwa dada wa Simeoni na Lawi."
        }
      ]
    },
    "apd": {
      "preferred_label": "دينة",
      "descriptions": [
        {
          "source": "acai",
          "description": "بت يعقوب أبو الآباء من مرته ليئة. كانت أخت شمعون ولاوي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Daena",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini gel blong Jekob wetem waef blong hem Lea. Hem i sista blong Simeon mo Levi."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Daịna",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwanyị nke nna ochie bụ Jekọb na nwunye ya Lịa. Ọ bụ nwanne Simiọn na Livaị."
        }
      ]
    },
    "nep": {
      "preferred_label": "दीना",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता याकूब र उनकी पत्‍नी लेआकी छोरी। उनी सिमोन र लेवीकी बहिनी थिइन्।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Daina",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini meri bilong bikpela man Jekop wantaim meri bilong en Lea. Em i sista bilong Saimon na Livai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Đi-na",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con gái của tổ phụ Gia-cốp và vợ ông là Lê-a. Nàng là em gái của Si-mê-ôn và Lê-vi."
        }
      ]
    },
    "zht": {
      "preferred_label": "底拿",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長雅各和他妻子利亞的女兒。她是西緬和利未的妹妹。"
        }
      ]
    }
  },
