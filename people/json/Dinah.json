          "source": "acai",
          "gloss": "Dinah",
          "article": "person:Dinah",
          "description": "Daughter of the patriarch Jacob and his wife Leah. She was a sister of Simeon and Levi."
        }
      ]
    },
    "fra": {
      "preferred_label": "Dina",
      "descriptions": [
        {
