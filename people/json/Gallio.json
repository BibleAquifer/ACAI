      ]
    },
    "swh": {
      "preferred_label": "Galio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Galio, prokonsuli Mroma wa Akaya wakati wa Agano Jipya, anatajwa katika Matendo ya Mitume 18:12."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Galio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Galio, wanpela prokonsul bilong Rom long Akaia long taim bilong Nupela Testamen, Baibel i kolim nem bilong en long Aposel 18:12."
        }
      ]
    },
    "apd": {
      "preferred_label": "غاليون",
      "descriptions": [
        {
          "source": "acai",
          "description": "غاليون، والي روماني على أخائية في زمن العهد الجديد، ومذكور في أعمال الرسل 18: 12."
        }
      ]
    },
    "bis": {
      "preferred_label": "Galio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Galio, wan gavman blong Rom we i lukaot long provins ya Akaea long taem blong Niu Testeman, we Ol Wok 18:12 i tokbaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Galio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Galio, onye ọchịchị ndị Rom na Akaịa n'oge Agba Ọhụrụ, ka a kpọtụrụ aha n'ime Ọrụ Ndị Ozi 18:12."
        }
      ]
    },
    "nep": {
      "preferred_label": "गालियो",
      "descriptions": [
        {
          "source": "acai",
          "description": "गालियो, नयाँ नियमको अवधिमा अखैयाका एक रोमी उप-प्रशासक थिए, जसको उल्लेख प्रेरित १८:१२ मा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ga-li-ôn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ga-li-ôn, tổng trấn La Mã cai quản A-chai trong thời kỳ Tân Ước, được nhắc đến trong Công Vụ 18:12."
        }
      ]
    },
    "zht": {
      "preferred_label": "迦流",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦流是新約時期羅馬駐亞該亞的方伯，記載於使徒行傳18:12。"
        }
      ]
    }
