      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shallum",
          "article": "person:Shallum.7",
          "description": "The son of Zadok, and the father of Hilkiah, and priest during the Israelite return from exile."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَلّوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن صَادُوقَ، وأبو حِلْقِيَّا، وكاهن عاش أثناء رجوع بني إسرائيل من السبي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "沙龙",
      "descriptions": [
        {
          "source": "acai",
          "description": "撒督的儿子，希勒迦的父亲，以色列人被掳归回时期的祭司。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Schallum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Tsadok, père de Hilkija et prêtre à l'époque du retour de l'exil des Israélites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shallum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Zadok, kuma mahaifin Hilkiya, kuma firist a lokacin dawowar Isra’ilawa daga zaman bauta."
        }
      ]
    },
    "hin": {
      "preferred_label": "शल्लूम",
      "descriptions": [
        {
          "source": "acai",
          "description": "सादोक का पुत्र और हिल्किय्याह का पिता, जो इस्राएलियों की बंधुवाई से वापसी के समय याजक था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Salum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Zadok, dan ayah Hilkia, serta imam pada masa pemulangan orang Israel dari pembuangan."
        }
      ]
    },
    "por": {
      "preferred_label": "Salum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Zadoque e pai de Hilquias, e sacerdote durante o retorno dos israelitas do exílio."
        }
      ]
    },
    "rus": {
      "preferred_label": "Шаллум",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Садока, отец Хелкии и священник во время возвращения израильтян из изгнания."
        }
      ]
    },
    "spa": {
      "preferred_label": "Salún",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Sadoc y padre de Hilcías, y sacerdote durante el retorno israelita del exilio."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shalumu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Sadoki, na baba wa Hilkia, na kuhani wakati Waisraeli waliporudi kutoka uhamishoni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Salum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Sadok, na papa bilong Hilkia, na wanpela pris long taim ol Israel i lusim kalabus na i go bek."
        }
      ]
    },
    "apd": {
      "preferred_label": "شلوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد صادوق وأبو حلقيا، وكان كاهن وقت رجوع بني إسرائيل من السبي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Salum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Jadok, mo papa blong Hilkia, mo wan pris long taem we ol man Isrel oli aot long eksael i gobak."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shalum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Zadọk, na nna Hilkaya, ma bụrụkwa onye nchụaja nʼoge nloghachi ndị Izrel site na ndọrọ nʼagha."
        }
      ]
    },
    "nep": {
      "preferred_label": "शल्लूम",
      "descriptions": [
        {
          "source": "acai",
          "description": "सादोकका छोरा, हिल्कियाहका पिता र इस्राएलीहरूको निर्वासनबाट फिर्तीको समयका पुजारी।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sa-lum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Xa-đốc, cha của Hinh-kia, và là thầy tế lễ trong thời kỳ dân Y-sơ-ra-ên hồi hương từ chốn lưu đày."
        }
      ]
    },
    "zht": {
      "preferred_label": "沙龍",
      "descriptions": [
        {
          "source": "acai",
          "description": "撒督的兒子，希勒家的父親，是以色列人被擄歸回時期的祭司。"
        }
      ]
    }
  },
