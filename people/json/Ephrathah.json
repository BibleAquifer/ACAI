      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ephrathah",
          "article": "person:Ephrathah",
          "description": "A woman of the tribe of Judah, one of the wives of Caleb the son of Hezron, and mother of Hur."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَفْرَاتَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "امرأة من سبط يهوذا، وإحدى زوجات كَالِب بن حصرون، وأم حور."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以法他",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大支派的一位妇人，希斯仑之子迦勒的妻子之一，户珥的母亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Éphrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Femme de la tribu de Juda, l'une des épouses de Caleb, fils de Hetsron, et mère de Hur."
        }
      ]
    },
    "hau": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata mace daga kabilar Yahuda, ɗaya daga cikin matan Kaleb ɗan Hezron, kuma mahaifiyar Hur."
        }
      ]
    },
    "ind": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang wanita dari suku Yehuda, salah satu istri Kaleb anak Hezron, dan ibu dari Hur."
        }
      ]
    },
    "por": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mulher da tribo de Judá, uma das esposas de Calebe, filho de Hezrom, e mãe de Hur."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ефрафа",
      "descriptions": [
        {
          "source": "acai",
          "description": "Женщина из колена Иуды, одна из жен Халева, сына Есрома, и мать Хура."
        }
      ]
    },
    "spa": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una mujer de la tribu de Judá, una de las esposas de Caleb, hijo de Hezrón, y madre de Hur."
        }
      ]
    },
    "swh": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamke wa kabila la Yuda, mmoja wa wakeze Kalebu mwana wa Hesroni, na mama yake Huri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela meri bilong lain Juda, wanpela bilong ol meri bilong Kalep, pikinini man bilong Hesron, na mama bilong Hur."
        }
      ]
    },
    "apd": {
      "preferred_label": "أفراتة",
      "descriptions": [
        {
          "source": "acai",
          "description": "مرأة من سبط يهوذا، واحدة من زوجات كالب ابن حصرون، وأم حور."
        }
      ]
    },
    "bis": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan woman blong laen blong Juda, wan long ol woman blong Keleb pikinini boe blong Hesron, mo mama blong Huru."
        }
      ]
    },
    "hin": {
      "preferred_label": "एप्राता",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा के गोत्र की एक स्त्री, हेस्रोन के पुत्र कालेब की पत्नियों में से एक, और हूर की माता।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Efrata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwanyị sitere nʼebo Juda, otu nʼime ndị nwunye Kaleb nwa Hezrọn, na nne Hua."
        }
      ]
    },
    "nep": {
      "preferred_label": "एप्राता",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा कुलकी एक महिला, हेस्रोनका छोरा कालेबकी एक पत्नी र हूरकी आमा।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-phơ-rát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người nữ thuộc bộ tộc Giu-đa, một trong các người vợ của Ca-lép con trai Hết-rôn, và là mẹ của Hu-rơ."
        }
      ]
    },
    "zht": {
      "preferred_label": "以法她",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大支派的一位婦女，希斯崙之子迦勒的妻子之一，戶珥的母親。"
        }
      ]
    }
  },
