  "localizations": {
    "eng": {
      "preferred_label": "Saul (Paul)",
      "alternate_labels": [
        "Paul"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Paul",
          "article": "person:Saul",
          "description": "A former persecutor of Christians who was chosen by Jesus in a vision to be an apostle to the non-Jewish people. Most of the New Testament letters are written by him."
        }
      ]
    },
    "fra": {
      "preferred_label": "Saul (Paul)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ancien persécuteur des chrétiens qui a été choisi par Jésus dans une vision pour être l'apôtre des non-Juifs. La plupart des lettres du Nouveau Testament ont été écrites par lui."
        }
      ]
    },
    "spa": {
      "preferred_label": "Saulo (Pablo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Antiguo perseguidor de cristianos que fue elegido por Jesús en una visión para ser apóstol de los no judíos. La mayoría de las cartas del Nuevo Testamento fueron escritas por él."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَاوُل (بُولُس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مضطهد سابق للمسيحيين اختاره يسوع في رؤيا ليكون رسولاً للأمم (غير اليهود). كتب معظم رسائل العهد الجديد."
        }
      ]
    },
    "zhs": {
      "preferred_label": "扫罗 (保罗)",
      "descriptions": [
        {
          "source": "acai",
          "description": "他曾迫害基督徒，后在异象中被耶稣选召成为外邦人的使徒。新约圣经中的多数书信均出自他手。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Shawulu (Bulus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani tsohon mai tsananta wa Kiristoci wanda Yesu ya zaɓa a cikin wahayi ya zama manzo ga waɗanda ba Yahudawa ba. Shi ya rubuta yawancin wasiƙun Sabon Alkawari."
        }
      ]
    },
    "hin": {
      "preferred_label": "शाऊल (पौलुस)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मसीहियों का एक पूर्व सताने वाला, जिसे यीशु ने दर्शन में गैर-यहूदी लोगों के लिए प्रेरित होने के लिए चुना था। नए नियम की अधिकांश पत्रियाँ उसी के द्वारा लिखी गई हैं।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Saulus (Paulus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mantan penganiaya orang Kristen yang dipilih oleh Yesus dalam suatu penglihatan untuk menjadi seorang rasul bagi bangsa-bangsa bukan Yahudi. Sebagian besar surat Perjanjian Baru ditulis olehnya."
        }
      ]
    },
    "por": {
      "preferred_label": "Saulo (Paulo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Antigo perseguidor dos cristãos que foi escolhido por Jesus em uma visão para ser apóstolo dos gentios. A maior parte das cartas do Novo Testamento foi escrita por ele."
        }
      ]
    },
    "rus": {
      "preferred_label": "Савл (Павел)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Бывший гонитель христиан, избранный Иисусом в видении апостолом для нееврейских народов. Им написано большинство посланий Нового Завета."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sauli (Paulo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtesi wa zamani wa Wakristo aliyechaguliwa na Yesu katika maono kuwa mtume kwa watu wasio Wayahudi. Barua nyingi za Agano Jipya ziliandikwa naye."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sol (Pol)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bipo em i bin mekim nogut long ol Kristen, tasol Jisas i kamap long em long wanpela visen na makim em bilong kamap wanpela aposel i go long ol haiden manmeri. Em i bin raitim planti pas bilong Nupela Testamen."
        }
      ]
    },
    "apd": {
      "preferred_label": "شاول (بولس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كان زمان بضطهد المسيحيين، وبعدين يسوع اختاره في رؤيا عشان يكون رسول لغير اليهود. وكتب أغلب رسايل العهد الجديد."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sol (Pol)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we bifo i stap mekem i nogud tumas long ol Kristin man, be Jisas i jusumaot hem long wan vison blong i kam wan aposol i go long ol jentael (olgeta we oli no laen blong Isrel). Mo hem nao i raetem bighaf blong ol leta blong Niu Testeman."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sọl (Pọl)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye na-akpagbu ndị Kraịst na mbụ nke Jisọs họọrọ nʼọhụụ ka ọ bụrụ onyeozi nye ndị na-abụghị ndị Juu. Ọtụtụ nʼime akwụkwọ ozi nke Agba Ọhụrụ bụ ya dere ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "शाऊल (पावल)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ख्रीष्टियनहरूलाई पहिले सताउने एक व्यक्ति, जसलाई येशूले दर्शनमा गैर-यहूदी जातिका निम्ति प्रेरित हुन चुन्नुभयो। नयाँ नियमका धेरैजसो पत्रहरू उनैले लेखेका हुन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sau-lơ (Phao-lô)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người từng bắt bớ các Cơ Đốc nhân, được Chúa Giê-xu chọn trong một khải tượng để làm sứ đồ cho các dân ngoại. Phần lớn các thư tín trong Tân Ước đều do ông viết."
        }
      ]
    },
    "zht": {
      "preferred_label": "掃羅（保羅）",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位從前逼迫基督徒的人，後來在異象中被耶穌選召成為非猶太人的使徒。新約書信大部分由他撰寫。"
        }
      ]
    }
  },
