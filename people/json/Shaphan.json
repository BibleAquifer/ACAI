  "localizations": {
    "eng": {
      "preferred_label": "Shaphan",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shaphan",
          "article": "person:Shaphan",
          "description": "A son of Azaliah, and father of Ahikam. He was secretary to King Josiah of the kingdom of Judah."
        }
      ]
    },
    "arb": {
      "preferred_label": "شافان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن أَصَلْيا، ووالد أَخيقام. كان كاتبًا للملك يوشِيّا في مملكة يهوذا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "沙番",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚萨利雅的儿子，亚希甘的父亲。他是犹大国国王约西亚的书记。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Schaphan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d'Atsalia et père d'Achikam. Il était secrétaire du roi Josias du royaume de Juda."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shafan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Azaliya, kuma mahaifin Ahikam. Shi magatakarda ne ga Sarki Yosiya na masarautar Yahuda."
        }
      ]
    },
    "hin": {
      "preferred_label": "शापान",
      "descriptions": [
        {
          "source": "acai",
          "description": "असल्याह का पुत्र और अहीकाम का पिता। वह यहूदा राज्य के राजा योशिय्याह का मंत्री (सचिव) था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Safan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Putra Azalya dan ayah Ahikam. Ia adalah panitera bagi Raja Yosia dari kerajaan Yehuda."
        }
      ]
    },
    "por": {
      "preferred_label": "Safã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Azalias e pai de Aicam. Ele foi secretário do rei Josias do reino de Judá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Шафан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Ацалии и отец Ахикама. Он был писцом у царя Иосии в Иудейском царстве."
        }
      ]
    },
    "spa": {
      "preferred_label": "Safán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Azalías y padre de Ahicam. Fue secretario del rey Josías del reino de Judá."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shafani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Azalia, na babaye Ahikamu. Alikuwa mwandishi wa Mfalme Yosia wa ufalme wa Yuda."
        }
      ]
    },
    "apd": {
      "preferred_label": "شافان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد أصلية، وأبو أخيقام. كان كاتب للملك يوشيا ملك مملكة يهوذا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Safan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Ajalia, mo papa blong Ahikam. Hem i bin sekretari blong King Josaea blong kingdom blong Juda."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shefan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Azalaya, na nna Ahikam. Ọ bụ odeakwụkwọ nye Eze Josaya nke alaeze Juda."
        }
      ]
    },
    "nep": {
      "preferred_label": "शापान",
      "descriptions": [
        {
          "source": "acai",
          "description": "अRankल्याहका छोरा र अहीकामका पिता। तिनी यहूदा राज्यका राजा योशियाहका सचिव थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Safan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Asalia, na papa bilong Ahikam. Em i bin stap kuskus bilong King Josaia bilong kingdom bilong Juda."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sa-phan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con của A-xa-lia và là cha của A-hi-cam. Ông là thư ký của Vua Giô-si-a thuộc vương quốc Giu-đa."
        }
      ]
    },
    "zht": {
      "preferred_label": "沙番",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞薩利的兒子，亞希甘的父親。他是猶大王約西亞的書記。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
