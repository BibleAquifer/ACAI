  "type": "person",
  "gender": "male",
  "roles": [
    "Coworker of Paul",
    "Church Leader"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Titus",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Titus",
          "article": "person:Titus",
          "description": "A Gentile convert and close friend of the apostle Paul. A New Testament letter was written to him by the apostle Paul."
        }
      ]
    },
    "arb": {
      "preferred_label": "تِيطُس",
      "descriptions": [
        {
          "source": "acai",
          "description": "مهتدٍ من الأمم وصديق حميم للرسول بولس. كتب له الرسول بولس رسالة في العهد الجديد."
        }
      ]
    },
    "zhs": {
      "preferred_label": "提多",
      "descriptions": [
        {
          "source": "acai",
          "description": "一名外邦人归信者，也是使徒保罗的密友。使徒保罗曾写了一封新约书信给他。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Tite",
      "descriptions": [
        {
          "source": "acai",
          "description": "Converti d'origine païenne et ami proche de l'apôtre Paul. Une lettre du Nouveau Testament lui a été adressée par l'apôtre Paul."
        }
      ]
    },
    "hau": {
      "preferred_label": "Titus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani wanda ba Ba’isra’ile ba da ya ba da gaskiya kuma babban abokin manzo Bulus. Manzo Bulus ya rubuta masa wasiƙar Sabon Alkawari."
        }
      ]
    },
    "hin": {
      "preferred_label": "तीतुस",
      "descriptions": [
        {
          "source": "acai",
          "description": "अन्यजातियों में से एक धर्मांतरित व्यक्ति और प्रेरित पौलुस का घनिष्ठ मित्र। प्रेरित पौलुस द्वारा उसे नए नियम का एक पत्र लिखा गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Titus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang petobat bukan Yahudi dan sahabat karib rasul Paulus. Sebuah surat Perjanjian Baru ditulis kepadanya oleh rasul Paulus."
        }
      ]
    },
    "por": {
      "preferred_label": "Tito",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um gentio convertido e amigo próximo do apóstolo Paulo. Uma carta do Novo Testamento foi escrita a ele pelo apóstolo Paulo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Тит",
      "descriptions": [
        {
          "source": "acai",
          "description": "Новообращенный из язычников и близкий друг апостола Павла. Апостол Павел написал ему одно из новозаветных посланий."
        }
      ]
    },
    "spa": {
      "preferred_label": "Tito",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un converso gentil y amigo cercano del apóstol Pablo. El apóstol Pablo le escribió una carta del Nuevo Testamento."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tito",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mataifa aliyeongoka na rafiki wa karibu wa mtume Paulo. Barua ya Agano Jipya iliandikwa kwake na mtume Paulo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Taitus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong narapela lain i bin tanim bel na kamap Kristen na em i gutpela pren bilong aposel Pol. Aposel Pol i bin raitim wanpela pas bilong Nupela Testamen i go long em."
        }
      ]
    },
    "apd": {
      "preferred_label": "تيطس",
      "descriptions": [
        {
          "source": "acai",
          "description": "مؤمن من الأمم وصاحب قريب لبولس الرسول. وبولس الرسول كتب ليهو رسالة في العهد الجديد."
        }
      ]
    },
    "bis": {
      "preferred_label": "Taetas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i no laen blong Isrel we i tanem tingting blong hem i kam long Kraes mo hem i wan klosap fren blong aposol Pol. Wan leta long Niutesteman, aposol Pol i raetem i go long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Taịtọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye mba ọzọ a tọghatara nʼokwukwe na ezigbo enyi nke Pita onye ozi Paul. Onye ozi Paul deere ya akwụkwọ ozi nʼime Agba Ọhụrụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "तीतस",
      "descriptions": [
        {
          "source": "acai",
          "description": "अन्यजातिहरूमध्येबाट विश्‍वासमा आएका र प्रेरित पावलका घनिष्ठ मित्र। प्रेरित पावलद्वारा उहाँलाई एउटा नयाँ नियमको पत्र लेखिएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Tích",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người ngoại quy đạo và là bạn thân thiết của sứ đồ Phao-lô. Sứ đồ Phao-lô đã viết một bức thư trong Tân Ước gửi cho ông."
        }
      ]
    },
    "zht": {
      "preferred_label": "提多",
      "descriptions": [
        {
          "source": "acai",
          "description": "提多是一位歸信的外邦人，也是使徒保羅的摯友。新約聖經中有一卷書信是使徒保羅寫給他的。"
        }
      ]
    }
  },
