  "roles": [
    "King",
    "Emperor"
  ],
  "tribe": "group:Mesopotamia",
  "localizations": {
    "eng": {
      "preferred_label": "Belshazzar",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Belshazzar",
          "article": "person:Belshazzar",
          "description": "An emperor during the time of Israelite exile and return of the Israelites. He was a son of King Nebuchadnezzar."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَيْلْشَاصَّر",
      "descriptions": [
        {
          "source": "acai",
          "description": "إمبراطور خلال فترة سبي الإسرائيليين ورجوعهم. وهو ابن الملك نبوخذنصر."
        }
      ]
    },
    "zhs": {
      "preferred_label": "伯沙撒",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人被掳与回归时期的统治者。他是尼布甲尼撒王的儿子（或后裔）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Belschatsar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Souverain ayant régné à l'époque de l'exil et du retour d'Israël. Il était un fils (ou descendant) du roi Nebucadnetsar."
        }
      ]
    },
    "hau": {
      "preferred_label": "Belshazar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani sarki a zamanin zaman bauta da komowar Isra’ilawa. Shi ɗan Sarki Nebukadnezzar ne."
        }
      ]
    },
    "hin": {
      "preferred_label": "बेलशस्सर",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलियों के बंधुआई और वापसी के समय का एक सम्राट। वह राजा नबूकदनेस्सर का एक पुत्र था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Belsyazar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang kaisar pada masa pembuangan dan pemulangan orang Israel. Ia adalah anak Raja Nebukadnezar."
        }
      ]
    },
    "por": {
      "preferred_label": "Belsazar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um imperador durante o tempo do exílio e retorno dos israelitas. Era filho do rei Nabucodonosor."
        }
      ]
    },
    "rus": {
      "preferred_label": "Валтасар",
      "descriptions": [
        {
          "source": "acai",
          "description": "Правитель во времена вавилонского пленения и возвращения израильтян. Был сыном (потомком) царя Навуходоносора."
        }
      ]
    },
    "spa": {
      "preferred_label": "Belsasar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Emperador durante la época del exilio y el regreso de los israelitas. Era hijo del rey Nabucodonosor."
        }
      ]
    },
    "apd": {
      "preferred_label": "بيلشاصر",
      "descriptions": [
        {
          "source": "acai",
          "description": "إمبراطور عاش في زمن السبي والرجوع حق بني إسرائيل. وهو ولد الملك نبوخذنصر."
        }
      ]
    },
    "bis": {
      "preferred_label": "Belsasa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan empera long taem blong eksael mo taem we ol man Isrel oli kambak. Hem i pikinini blong King Nebukadnesa."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Belshaza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Empera nʼoge a dọọrọ ndị Izrel nʼagha na nloghachi ha. Ọ bụ nwa Eze Nebukadneza."
        }
      ]
    },
    "nep": {
      "preferred_label": "बेलसजर",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलीहरूको निर्वासन र फिर्तीको समयका एक सम्राट। तिनी राजा नबूकदनेसरका छोरा थिए।"
        }
      ]
    },
    "swh": {
      "preferred_label": "Belshaza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme mkuu wakati wa uhamisho wa Waisraeli na kurejea kwa Waisraeli. Alikuwa mwana wa Mfalme Nebukadneza."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Belsasar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela empera long taim bilong ol Israel i go kalabus na kam bek bilong ol Israel. Em i pikinini man bilong King Nebukatnesar."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bên-xát-sa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vị hoàng đế trong thời kỳ dân Y-sơ-ra-ên bị lưu đày và hồi hương. Ông là con trai của Vua Nê-bu-cát-nết-sa."
        }
      ]
    },
    "zht": {
      "preferred_label": "伯沙撒",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人被擄及歸回時期的帝王。他是尼布甲尼撒王的兒子。"
        }
      ]
    }
  },
