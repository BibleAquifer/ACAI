  "localizations": {
    "eng": {
      "preferred_label": "Doeg",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Doeg",
          "article": "person:Doeg",
          "description": "An Edomite official during King Saul’s reign. Doeg betrayed where David was located and later killed the priests of YHWH."
        }
      ]
    },
    "fra": {
      "preferred_label": "Doëg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fonctionnaire édomite sous le règne du roi Saül. Doëg révéla où se trouvait David et tua plus tard les prêtres de l'Éternel."
        }
      ]
    },
    "spa": {
      "preferred_label": "Doeg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Funcionario edomita durante el reinado del rey Saúl. Doeg traicionó la ubicación de David y más tarde mató a los sacerdotes de YHWH."
        }
      ]
    },
    "arb": {
      "preferred_label": "دُوَاغ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسؤول أدومي في عهد الملك شاول. وشى دُوَاغُ بمكان وجود داود، وقتل لاحقًا كهنة الرب."
        }
      ]
    },
    "zhs": {
      "preferred_label": "多益",
      "descriptions": [
        {
          "source": "acai",
          "description": "扫罗王统治时期的一名以东官员。多益泄露了大卫的行踪，后来杀害了耶和华的祭司。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Doyeg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban jami'in Edom a zamanin mulkin Sarki Shawulu. Doyeg ya fallasa inda Dawuda yake kuma daga baya ya kashe firistocin Yahweh."
        }
      ]
    },
    "hin": {
      "preferred_label": "दोएग",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा शाऊल के शासनकाल के दौरान एक एदोमी अधिकारी। दोएग ने दाऊद के ठिकाने का भेद खोला और बाद में यहोवा के याजकों को मार डाला।"
        }
      ]
    },
    "por": {
      "preferred_label": "Doegue",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um oficial edomita durante o reinado do rei Saul. Doegue revelou o paradeiro de Davi e mais tarde matou os sacerdotes do SENHOR."
        }
      ]
    },
    "rus": {
      "preferred_label": "Доик",
      "descriptions": [
        {
          "source": "acai",
          "description": "Идумейский чиновник во время правления царя Саула. Доик выдал местонахождение Давида и позже убил священников Господа."
        }
      ]
    },
    "swh": {
      "preferred_label": "Doegi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Afisa Mwedomu wakati wa utawala wa Mfalme Sauli. Doegi alisaliti mahali Daudi alipokuwa na baadaye akawaua makuhani wa BWANA."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Doek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ofisa bilong Idom long taim King Sol i stap king. Doek i bin autim ples Devit i hait long en na bihain em i kilim i dai ol pris bilong Bikpela."
        }
      ]
    },
    "apd": {
      "preferred_label": "دوعغ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسؤول أدومي في عهد الملك شاول. دوعغ خان مكان داود وكشفه، وبعدين قتل كهنة الرب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Doeg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ofisel blong Edom long taem we King Sol i rula. Doeg i talemaot ples we Deved i stap long hem mo biaen i kilim ol pris blong Hae God."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Doeg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye ọrụ nchịkwa si Edọm nʼoge ọchịchị Eze Sọl. Doeg raara ebe Devid nọ nye ma mechaa gbuo ndị nchụaja nke YHWH."
        }
      ]
    },
    "ind": {
      "preferred_label": "Doeg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pejabat Edom pada masa pemerintahan Raja Saul. Doeg memberitahukan keberadaan Daud dan kemudian membunuh para imam TUHAN."
        }
      ]
    },
    "nep": {
      "preferred_label": "दोएग",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा शाऊलको शासनकालका एक एदोमी अधिकारी। दोएगले दाऊद कहाँ छन् भनी धोका दिए र पछि परमप्रभुका पुजारीहरूलाई मारे।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Đô-e",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một quan chức người Ê-đôm dưới triều Vua Sau-lơ. Đô-e đã phản bội tiết lộ nơi ở của Đa-vít và sau đó tàn sát các thầy tế lễ của Đức Giê-hô-va."
        }
      ]
    },
    "zht": {
      "preferred_label": "多益",
      "descriptions": [
        {
          "source": "acai",
          "description": "掃羅王統治時期的一位以東官員。多益洩露了大衛的行蹤，後來殺害了耶和華的祭司。"
        }
      ]
    }
  },
