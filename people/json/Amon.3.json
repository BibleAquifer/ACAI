  "localizations": {
    "eng": {
      "preferred_label": "Amon (Son of Manasseh)",
      "alternate_labels": [
        "Amos"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Amon (Son of Manasseh)",
          "article": "person:Amon.3",
          "description": "King of Judah during the divided kingdom. He was a son of Manasseh and Meshullemeth and father of King Josiah. "
        }
      ]
    },
    "arb": {
      "preferred_label": "آمُون (ابن مَنَسَّى)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك يهوذا أثناء فترة المملكة المنقسمة. كان ابنًا لمنسى ومشلمة وأبًا للملك يوشيا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚们 (玛拿西的儿子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期的犹大王。他是玛拿西和米舒利密的儿子，也是约西亚王的父亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Amon (fils de Manassé)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi de Juda à l’époque du royaume divisé. Il était fils de Manassé et de Meschullémeth, et père du roi Josias."
        }
      ]
    },
    "hau": {
      "preferred_label": "Amon (Ɗan Manasse)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Yahuda a lokacin rabuwar mulki. Shi ɗan Manasse ne da Meshullemet kuma mahaifin Sarki Yosiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "आमोन (मनश्शे का पुत्र)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के समय यहूदा का राजा। वह मनश्शे और मशुल्लेमेत का पुत्र तथा राजा योशियाह का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Amon (anak Manasye)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Raja Yehuda pada masa kerajaan terpecah. Ia adalah anak Manasye dan Mesulemet, serta ayah dari Raja Yosia."
        }
      ]
    },
    "por": {
      "preferred_label": "Amom (filho de Manassés)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rei de Judá durante o reino dividido. Era filho de Manassés e Mesulemete, e pai do rei Josias."
        }
      ]
    },
    "rus": {
      "preferred_label": "Амон (сын Манассии)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь Иудеи во времена разделенного царства. Сын Манассии и Мешуллемеф, отец царя Иосии."
        }
      ]
    },
    "spa": {
      "preferred_label": "Amón (hijo de Manasés)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey de Judá durante el reino dividido. Fue hijo de Manasés y Mesulémet y padre del rey Josías."
        }
      ]
    },
    "swh": {
      "preferred_label": "Amoni (Mwana wa Manase)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Yuda wakati wa ufalme uliogawanyika. Alikuwa mwana wa Manase na Meshulemethi na baba yake Mfalme Yosia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Emon (Pikinini Man Bilong Manase)",
      "descriptions": [
        {
          "source": "acai",
          "description": "King bilong Juda long taim bilong kingdom i stap tupela hap. Em i pikinini man bilong Manase wantaim Mesulemet na papa bilong King Josaia."
        }
      ]
    },
    "apd": {
      "preferred_label": "أمون (ابن منسى)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك يهوذا في زمن المملكة المنقسمة. كان ابن منسى ومشلمة، وأبو الملك يوشيا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Amon (Pikinini man blong Manase)",
      "descriptions": [
        {
          "source": "acai",
          "description": "King blong Juda long taem we kingdom i seraot. Hem i wan pikinini man blong Manase mo Mesulemet mo papa blong King Josaea."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Amọn (Nwa Manase)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze Juda nʼoge alaeze kewara ekewa. Ọ bụ nwa Manase na Meshulemet, ma bụrụkwa nna Eze Josaya."
        }
      ]
    },
    "nep": {
      "preferred_label": "आमोन (मनश्शेका छोरा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा यहूदाका राजा। तिनी मनश्शे र मशुललेमेतका छोरा तथा राजा योशियाहका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-môn (con của Ma-na-se)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vua Giu-đa trong thời kỳ vương quốc phân chia. Ông là con trai của Ma-na-se và Mê-su-lê-mết, và là cha của Vua Giô-si-a."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞們（瑪拿西之子）",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期的猶大王。他是瑪拿西和米舒利密之子，也是約西亞王的父親。"
        }
      ]
    }
  },
