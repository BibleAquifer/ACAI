  "localizations": {
    "eng": {
      "preferred_label": "Zerubbabel",
      "alternate_labels": [
        "Zorobabel",
        "Sheshbazzar"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Zerubbabel",
          "article": "person:Zerubbabel.2",
          "description": "A son of Shealtiel/Pedaiah and father of Meshullam and Hananiah. He was a governor of the tribe of Judah during the time of Israelite return from exile. He is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "زَرُبَّابِلُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱبْنُ شَأَلْتِئِيلَ/فَدَايَا وَأَبُو مَشُلَّامَ وَحَنَنِيَّا. كَانَ حَاكِمًا مِنْ سِبْطِ يَهُوذَا فِي زَمَنِ رُجُوعِ بَنِي إِسْرَائِيلَ مِنَ ٱلسَّبْيِ. وَهُوَ مَذْكُورٌ فِي نَسَبِ يَسُوعَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "所罗巴伯",
      "descriptions": [
        {
          "source": "acai",
          "description": "撒拉铁/毗大雅的儿子，米书兰和哈拿尼雅的父亲。他在以色列人从被掳之地归回时期担任犹大支派的省长。他被列在耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Zorobabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Schealthiel/Pedaja et père de Meschullam et Hanania. Il était gouverneur de la tribu de Juda à l'époque du retour des Israélites d'exil. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zerubbabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Sheyaltiyel/Fedahiya kuma mahaifin Meshullam da Hananiya. Shi gwamna ne na kabilar Yahuda a lokacin da Isra'ilawa suka dawo daga bauta. An jera shi a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "जरुब्बाबेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "शालतीएल/पदायाह का एक पुत्र और मशुल्लाम व हनन्याह का पिता। वह इस्राएलियों के बंधुआई से लौटने के समय यहूदा के गोत्र का एक अधिपति (राज्यपाल) था। वह यीशु की वंशावली में भी दर्ज है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Zerubabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak laki-laki Sealtiel/Pedaya dan ayah dari Mesulam serta Hananya. Ia adalah seorang bupati dari suku Yehuda pada masa kepulangan bangsa Israel dari pembuangan. Ia tercatat dalam silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Zorobabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Sealtiel/Pedaías e pai de Mesulão e Hananias. Ele foi governador da tribo de Judá durante a época do retorno israelita do exílio. Ele está listado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Зоровавель",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Салафиила/Федаии и отец Мешуллама и Ханании. Правитель колена Иуды во времена возвращения израильтян из пленения. Упоминается в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Zorobabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Salatiel/Pedaía y padre de Mesullam y Hananías. Fue gobernador de la tribu de Judá durante la época del regreso del exilio israelita. Está incluido en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Zerubabeli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Shealtieli/Pedaya na baba yake Meshulamu na Hanania. Alikuwa liwali wa kabila la Yuda wakati wa kurudi kwa Waisraeli kutoka uhamishoni. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Serubabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Sealtiel/Pedaia na papa bilong Mesulam wantaim Hanania. Em i bin nambawan gavman bilong lain bilong Juda long taim ol Israel i lusim kalabus na i kam bek. Nem bilong em i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "زرُبّابل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد شألتئيل/فدايا وأبو مشلام وحننيا. كان حاكم لقبيلة يهوذا في زمن رجوع بني إسرائيل من السبي، ومذكور في شجرة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Serubabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan boe blong Sealtiel/Pedaia mo papa blong Mesulam wetem Hanania. Hem i wan gavna blong traeb blong Juda long taem we ol man Isrel oli aot long trabol blong kalabus oli kambak. Nem blong hem i stap long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Zerubabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Shealtiel/Pedaya na nna Meshulam na Hananaya. Ọ bụ gọvanọ nke ebo Juda nʼoge ndị Izrel si na ndọrọ nʼagha lọta. E depụtara ya nʼagbụrụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "यरुबाबेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "शालतिएल/पदायाहका छोरा तथा मशुल्लाम र हनन्याहका पिता। तिनी इस्राएलीहरू निर्वासनबाट फर्किने समयमा यहूदा कुलका राज्यपाल थिए। येशूको वंशावलीमा पनि उनको नाम उल्लेख छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Xô-rô-ba-bên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Sa-anh-thi-ên/Phê-đa-gia và là cha của Mê-su-lam cùng Ha-na-nia. Ông là quan tổng trấn thuộc bộ tộc Giu-đa vào thời kỳ dân Y-sơ-ra-ên trở về sau cuộc lưu đày. Ông được liệt kê trong dòng dõi gia phổ của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "所羅巴伯",
      "descriptions": [
        {
          "source": "acai",
          "description": "撒拉鐵／毘大雅的兒子，米書蘭和哈拿尼雅的父親。他是以色列人被擄歸回時期的猶大省長，名列於耶穌的家譜中。"
        }
      ]
    }
  },
