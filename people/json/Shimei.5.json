  "localizations": {
    "eng": {
      "preferred_label": "Shimei",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shimei",
          "article": "person:Shimei.5",
          "description": "A son of Gera and relative of King Saul from Bahurim who cursed King David as he fled from Absalom. "
        }
      ]
    },
    "fra": {
      "preferred_label": "Schimeï",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Guéra et parent du roi Saül, originaire de Bachurim, qui maudit le roi David alors qu’il fuyait devant Absalom."
        }
      ]
    },
    "spa": {
      "preferred_label": "Simei",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Gera y pariente del rey Saúl, natural de Bahurim, que maldijo al rey David cuando este huía de Absalón."
        }
      ]
    },
    "arb": {
      "preferred_label": "شِمْعِي",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱبْنُ جِيرَا وَأَحَدُ أَقْرِبَاءِ ٱلْمَلِكِ شَاوُلَ مِنْ بَحُورِيمَ، سَبَّ ٱلْمَلِكَ دَاوُدَ أَثْنَاءَ هُرُوبِهِ مِنْ أَبْشَالُومَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "示每",
      "descriptions": [
        {
          "source": "acai",
          "description": "基拉的儿子，来自巴户琳的扫罗王亲属。他在大卫王逃避押沙龙时咒骂大卫。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Shimeyi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Gera kuma dangin Sarki Shawulu daga Bahurim wanda ya la’anci Sarki Dawuda yayin da yake guje wa Absalom."
        }
      ]
    },
    "hin": {
      "preferred_label": "शिमी",
      "descriptions": [
        {
          "source": "acai",
          "description": "बहूरीम का रहने वाला गेरा का एक पुत्र और राजा शाऊल का सम्बन्धी, जिसने अबशालोम से भागते समय राजा दाऊद को शाप दिया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Simei",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak Gera dan kerabat Raja Saul dari Bahurim yang mengutuki Raja Daud saat ia melarikan diri dari Absalom."
        }
      ]
    },
    "por": {
      "preferred_label": "Simei",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho de Gera e parente do rei Saul, de Baurim, que amaldiçoou o rei Davi quando este fugia de Absalão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Семей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Геры и родственник царя Саула из Бахурима, который злословил царя Давида, когда тот бежал от Авессалома."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shimei",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Gera na mtu wa ukoo wa Mfalme Sauli kutoka Bahurimu aliyemlaani Mfalme Daudi alipokuwa akikimbia kutoka kwa Absalomu."
        }
      ]
    },
    "apd": {
      "preferred_label": "شمعي",
      "descriptions": [
        {
          "source": "acai",
          "description": "ود جيرا وقريب الملك شاول من بحوريم، وهو السَبّ الملك داود لما كان هربان من أبشالوم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Simei",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Gera mo famle blong King Sol we i man Bahurim, we i tok spolem King Deved taem hem i stap ronwe long Absalom."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shimei",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Gera na onye ikwu Eze Sọl nke sitere na Bahurim, onye kọchara Eze Devid mgbe ọ na-agbalaga Absalọm."
        }
      ]
    },
    "nep": {
      "preferred_label": "शिमी",
      "descriptions": [
        {
          "source": "acai",
          "description": "गेराका एक छोरा र बहूरीमका राजा शाऊलका नातेदार, जसले अबशालोमबाट भाग्दै गर्दा राजा दाऊदलाई सरापेका थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Simei",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Gera na wanblut bilong King Sol long Bahurim em i bin kros na tok nogut long King Devit long taim Devit i ranawe long Absalom."
        }
      ]
    },
    "vie": {
      "preferred_label": "Si-mê-i",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Ghê-ra và là họ hàng của Vua Sau-lơ đến từ Ba-hu-rim, người đã nguyền rủa Vua Đa-vít khi vua chạy trốn khỏi Áp-sa-lôm."
        }
      ]
    },
    "zht": {
      "preferred_label": "示每",
      "descriptions": [
        {
          "source": "acai",
          "description": "基拉的兒子，來自巴戶琳，為掃羅王的親屬；在大衛王躲避押沙龍逃亡時咒罵大衛。"
        }
      ]
    }
  },
