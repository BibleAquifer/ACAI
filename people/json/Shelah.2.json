  "localizations": {
    "eng": {
      "preferred_label": "Shelah",
      "alternate_labels": [
        "Sala",
        "Salah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shelah",
          "article": "person:Shelah.2",
          "description": "A son of the patriarch Arphaxad and father of Eber. He is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَالَح",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن أَرْفَكْشَاد وأبو عَابِر. وهو مذكور في نسب يسوع المسيح."
        }
      ]
    },
    "zhs": {
      "preferred_label": "沙拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长亚法撒的儿子，希伯的父亲。他被列在耶稣的家谱中。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Shela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan uban iyali Arfakshad kuma mahaifin Eber. An lissafa shi a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "शेलह",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता अर्पक्षद का एक पुत्र और एबेर का पिता। वह यीशु की वंशावली में सूचीबद्ध है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Selah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari patriark Arpakhsad dan ayah dari Eber. Ia tercatat dalam silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Salá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho do patriarca Arfaxade e pai de Éber. Ele está listado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сала",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Арфаксада и отец Евера. Он упомянут в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Selaj",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Arfaxad y padre de Éber. Está incluido en la línea genealógica de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa patriarki Arfaksadi na baba yake Eberi. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong hetman bilong famili Arpaksat na papa bilong Eber. Nem bilong em i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "شالح",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد أرفكشاد أبو الآباء وأبو عابر. ومذكور في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong patriaka Apaksad mo papa blong Eba. Oli raetem nem blong hem long laen blong Jisas."
        }
      ]
    },
    "fra": {
      "preferred_label": "Schélach",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Arpacschad et père d’Éber. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke nke nna ochie bụ Apakshad na nna Eba. E depụtara ya nʼagbụrụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "शेलह",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता अर्पक्षदका छोरा र एबेरका पिता। तिनी येशूको वंशावलीमा सूचीकृत छन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-lách",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của tổ phụ A-bác-sát và là cha của Hê-be. Ông được liệt kê trong dòng tộc của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "沙拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖亞法撒的兒子，希伯的父親。他被列於耶穌的家譜中。"
        }
      ]
    }
  },
