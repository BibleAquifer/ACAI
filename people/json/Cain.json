  "localizations": {
    "eng": {
      "preferred_label": "Cain",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Cain",
          "article": "person:Cain",
          "description": "The first son of Adam and Eve, and brother of Abel whom he murdered out of jealousy. "
        }
      ]
    },
    "arb": {
      "preferred_label": "قَايِين",
      "descriptions": [
        {
          "source": "acai",
          "description": "الابن البكر لآدم وحواء، وأخو هابيل الذي قتله بدافع الغيرة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "该隐",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚当和夏娃的长子，亚伯的哥哥，因嫉妒而杀害了亚伯。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Caïn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Premier fils d'Adam et Ève, et frère d'Abel qu'il assassina par jalousie."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kayinu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan fari na Adamu da Hawwa’u, kuma ɗan’uwan Habila wanda ya kashe shi saboda kishi."
        }
      ]
    },
    "hin": {
      "preferred_label": "कैन",
      "descriptions": [
        {
          "source": "acai",
          "description": "आदम और हव्वा का पहला पुत्र, और हाबिल का भाई जिसकी उसने ईर्ष्या के कारण हत्या कर दी थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kain",
      "descriptions": [
        {
          "source": "acai",
          "description": "Putra pertama Adam dan Hawa, serta saudara laki-laki Habel yang dibunuhnya karena cemburu."
        }
      ]
    },
    "por": {
      "preferred_label": "Caim",
      "descriptions": [
        {
          "source": "acai",
          "description": "O primeiro filho de Adão e Eva, e irmão de Abel, a quem ele assassinou por ciúmes."
        }
      ]
    },
    "rus": {
      "preferred_label": "Каин",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первый сын Адама и Евы и брат Авеля, которого он убил из зависти."
        }
      ]
    },
    "spa": {
      "preferred_label": "Caín",
      "descriptions": [
        {
          "source": "acai",
          "description": "El primer hijo de Adán y Eva, y hermano de Abel, a quien asesinó por celos."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kaini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa kwanza wa Adamu na Hawa, na ndugu yake Habili ambaye alimuua kwa wivu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kein",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba wan pikinini man bilong Adam wantaim Iv, na brata bilong Abel em Kein i bin kilim i dai bikos em i jeles long em."
        }
      ]
    },
    "apd": {
      "preferred_label": "قايين",
      "descriptions": [
        {
          "source": "acai",
          "description": "الولد الأول لآدم وحواء، وأخو هابيل الكتلو من الغيرة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ken",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fas pikinini boe blong Adam mo Iv, mo brata blong Ebel we hem i kilim hem i ded from we hem i jalus long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ken",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọkpara Adam na Iv, na nwanne Ebel nke o gburu nʼihi ekworo."
        }
      ]
    },
    "nep": {
      "preferred_label": "कयिन",
      "descriptions": [
        {
          "source": "acai",
          "description": "आदम र हव्वाका जेठा छोरा, र हाबिलका दाजु जसलाई तिनले डाह गरेर मारेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ca-in",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai đầu lòng của A-đam và Ê-va, và là anh của A-bên, người mà ông đã sát hại vì lòng ghen tị."
        }
      ]
    },
    "zht": {
      "preferred_label": "該隱",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞當和夏娃的長子，亞伯的哥哥，因嫉妒而殺害了亞伯。"
        }
      ]
    }
  },
