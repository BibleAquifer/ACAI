  "localizations": {
    "eng": {
      "preferred_label": "Rehabiah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rehabiah",
          "article": "person:Rehabiah",
          "description": "Grandson of Moses, son of Eliezer, and father of Isshiah. He was chief of the clan of Eliezer."
        }
      ]
    },
    "fra": {
      "preferred_label": "Rechabia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit-fils de Moïse, fils d’Éliézer et père de Jischija. Il était le chef du clan d’Éliézer."
        }
      ]
    },
    "spa": {
      "preferred_label": "Rehabías",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nieto de Moisés, hijo de Eliezer y padre de Isías. Era jefe del clan de Eliezer."
        }
      ]
    },
    "arb": {
      "preferred_label": "رَحَبْيَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد موسى، وابن أليعزر، وأبو يشّيّا. وكان رئيسًا لعشيرة أليعزر."
        }
      ]
    },
    "zhs": {
      "preferred_label": "利哈比雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩西的孙子，以利以谢的儿子，伊示雅的父亲。他是以利以谢家族的首领。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Rehabiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jikan Musa, ɗan Eliyezer, kuma mahaifin Isshiya. Shi ne shugaban dangin Eliyezer."
        }
      ]
    },
    "hin": {
      "preferred_label": "रहब्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "मूसा का पोता, एलीएजेर का पुत्र और यिश्शिय्याह का पिता। वह एलीएजेर के कुल का मुख्य था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Rehabya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cucu Musa, anak Eliezer, dan ayah Yisia. Ia adalah kepala puak Eliezer."
        }
      ]
    },
    "por": {
      "preferred_label": "Reabias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neto de Moisés, filho de Eliezer e pai de Issias. Ele era chefe do clã de Eliezer."
        }
      ]
    },
    "rus": {
      "preferred_label": "Рехавия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Внук Моисея, сын Елиезера и отец Ишшии. Он был главой рода Елиезера."
        }
      ]
    },
    "swh": {
      "preferred_label": "Rehabia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mjukuu wa Musa, mwana wa Eliezeri, na baba wa Ishia. Alikuwa kiongozi wa ukoo wa Eliezeri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rehabia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuna pikinini bilong Moses, pikinini man bilong Elieser, na papa bilong Isia. Em i bin hetman bilong famili bilong Elieser."
        }
      ]
    },
    "apd": {
      "preferred_label": "رحَبْيا",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد موسى، وولد أليعازر، وأبو يشيا. كان رئيس عشيرة أليعازر."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rehabia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Eliesa mo smolbubu boe blong Moses, mo papa blong Jisia. Hem i lida blong laen blong Eliesa."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Rehabaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa Mosis, nwa nwoke Elieza, na nna Ishaya. Ọ bụ onyeisi ezinụlọ Elieza."
        }
      ]
    },
    "nep": {
      "preferred_label": "रहब्‍याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "मोशाका नाति, एलीएजरका छोरा र यिशियाहका पिता। तिनी एलीएजर कुलका मुखिया थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Rê-ha-bia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cháu nội của Môi-se, con trai của Ê-li-ê-se, và là cha của Di-si-gia. Ông là trưởng tộc của dòng dõi Ê-li-ê-se."
        }
      ]
    },
    "zht": {
      "preferred_label": "利哈比雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩西的孫子、以利以謝的兒子、伊示雅的父親。他是以利以謝家族的首領。"
        }
      ]
    }
  },
