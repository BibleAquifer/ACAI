    "eng": {
      "preferred_label": "Shemaiah (Jeremiah 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shemaiah (Jeremiah 26:20)",
          "article": "person:Shemaiah.24",
          "description": "Shemaiah, mentioned in Jeremiah 26:20, was a man living during the time of the divided kingdom and the father of Uriah."
        }
      ]
    },
    "arb": {
      "preferred_label": "شِمْعِيَا (إرميا 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "شمعيا، المذكور في إرميا 26: 20، كان رجلاً عاش في عهد المملكة المنقسمة وهو والد أوريا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "示玛雅 (耶利米书 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶利米书26:20中提到的示玛雅，是一个生活在王国分裂时期的人，是乌利亚的父亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Schemaeja (Jérémie 26.20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Schemaeja, mentionné dans Jérémie 26.20, était un homme qui vivait à l'époque du royaume divisé et le père d'Urie."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shemahiya (Irmiya 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shemahiya, wanda aka ambata a Irmiya 26:20, wani mutum ne da ya rayu a lokacin rarrabuwar mulki kuma mahaifin Uriya ne."
        }
      ]
    },
    "hin": {
      "preferred_label": "शमायाह (यिर्मयाह 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "शमायाह, जिसका उल्लेख यिर्मयाह 26:20 में है, विभाजित राज्य के समय का एक पुरुष तथा ऊरिय्याह का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Semaya (Yeremia 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Semaya, yang disebutkan dalam Yeremia 26:20, adalah seorang laki-laki yang hidup pada zaman kerajaan terbagi dan merupakan ayah dari Uria."
        }
      ]
    },
    "por": {
      "preferred_label": "Semaías (Jeremias 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Semaías, mencionado em Jeremias 26:20, foi um homem que viveu durante a época do reino dividido e pai de Urias."
        }
      ]
    },
    "rus": {
      "preferred_label": "Шемаия (Иеремия 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Шемаия, упомянутый в Иеремии 26:20, — человек, живший во времена разделенного царства, отец Урии."
        }
      ]
    },
    "spa": {
      "preferred_label": "Semaías (Jeremías 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Semaías, mencionado en Jeremías 26:20, fue un hombre que vivió durante la época de la monarquía dividida y padre de Uría."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shemaya (Yeremia 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shemaya, anayetajwa katika Yeremia 26:20, alikuwa mwanamume aliyeishi wakati wa ufalme uliogawanyika na baba yake Uria."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Semaia (Jeremia 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Semaia, em man Baibel i kolim nem bilong en long Jeremaia 26:20, em i wanpela man i bin stap long taim bilong kingdom i bruik tupela na em i papa bilong Uria."
        }
      ]
    },
    "apd": {
      "preferred_label": "شمعيا (إرميا 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "شمعيا، المذكور في إرميا 26: 20، كان راجل عاش في زمن المملكة المنقسمة، وكان أبو أوريا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Semaea (Jeremaea 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Semaea, we Jeremaea 26:20 i tokbaot hem, hem i wan man we i laef long taem we kingdom i seraot, mo hem i papa blong Uria."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shemaya (Jeremaia 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shemaya, nke a kpọtụrụ aha na Jeremaya 26:20, bụ nwoke dịrị ndụ n'oge alaeze kewara ekewa ma bụrụkwa nna Ụraya."
        }
      ]
    },
    "nep": {
      "preferred_label": "शमायाह (यर्मिया 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यर्मिया २६:२० मा उल्लेख गरिएका शमायाह, विभाजित राज्यको समयमा बाँचेका एक व्यक्ति र उरियाहका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-ma-gia (Giê-rê-mi 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sê-ma-gia, được đề cập trong Giê-rê-mi 26:20, là một người sống vào thời kỳ vương quốc phân chia và là cha của U-ri."
        }
      ]
    },
    "zht": {
      "preferred_label": "示瑪雅 (耶利米書 26:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "示瑪雅在耶利米書 26:20 中被提及，是生活在王國分裂時期的一名男子，也是烏利亞的父親。"
        }
      ]
    }
  },
