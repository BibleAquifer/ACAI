        {
          "source": "acai",
          "gloss": "Cush",
          "article": "person:Cush.2",
          "description": "A first-born son of Ham, and grandson of Noah. He is the founder of the Cushites."
        }
      ]
    },
    "fra": {
      "preferred_label": "Cusch",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils premier-né de Cham et petit-fils de Noé. Il est l'ancêtre des Kouchites."
        }
      ]
    },
    "spa": {
      "preferred_label": "Cus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Primogénito de Cam y nieto de Noé. Es el antepasado de los cusitas."
        }
      ]
    },
    "arb": {
      "preferred_label": "كُوش",
      "descriptions": [
        {
          "source": "acai",
          "description": "بكر حام وحفيد نوح، وهو أبو الكوشيين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "古实",
      "descriptions": [
        {
          "source": "acai",
          "description": "含的长子，挪亚的孙子。他是古实人的始祖。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kush",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan fari na Ham, kuma jikan Nuhu. Shi ne tushen Kushawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "कूश",
      "descriptions": [
        {
          "source": "acai",
          "description": "हाम का पहला जन्मा पुत्र, और नूह का पोता। वह कूशियों का पूर्वज है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kush",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak sulung Ham, dan cucu Nuh. Ia adalah leluhur orang Kusy."
        }
      ]
    },
    "por": {
      "preferred_label": "Cuxe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Primogênito de Cam e neto de Noé. Ele é o fundador dos cuxitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хуш",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первенец Хама и внук Ноя. Родоначальник кушитов (хуситов)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kushi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa kwanza wa kiume wa Hamu, na mjukuu wa Nuhu. Yeye ndiye mwanzilishi wa Wakushi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba wan pikinini man bilong Ham, na tumbuna pikinini bilong Noa. Em i tumbuna bilong ol Kus."
        }
      ]
    },
    "apd": {
      "preferred_label": "كوش",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد حام البكر، وحفيد نوح. هو أبو الكوشيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasbon boe blong Ham, mo smolbububoe blong Noa. Hem i stamba blong ol man Kus."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kush",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọkpara Ham, na nwa nwa Noa. Ọ bụ ya kpatara ndị Kush."
        }
      ]
    },
    "nep": {
      "preferred_label": "कूश",
      "descriptions": [
        {
          "source": "acai",
          "description": "हामका जेठा छोरा र नूहका नाति। उनी कूशीहरूका पुर्खा हुन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Cút",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai trưởng của Cham và là cháu nội của Nô-ê. Ông là tổ phụ của người Cút."
        }
      ]
    },
    "zht": {
      "preferred_label": "古實",
      "descriptions": [
        {
          "source": "acai",
          "description": "含的長子，挪亞的孫子。他是古實人的始祖。"
        }
      ]
    }
