      "descriptions": [
        {
          "source": "acai",
          "gloss": "Bichri",
          "article": "person:Bichri",
          "description": "A man from the tribe of Benjmain who lived during the time of Israel’s united kingdom, and the father of Sheba."
        }
      ]
    },
    "arb": {
      "preferred_label": "بِكْرِي",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل من سبط بنيامين عاش في زمن المملكة الموحدة لإسرائيل، وهو أبو شبع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "比基利",
      "descriptions": [
        {
          "source": "acai",
          "description": "便雅悯支派的一名男子，生活在以色列联合王国时期，是示巴的父亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Bicri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un homme de la tribu de Benjamin qui a vécu à l'époque du royaume uni d'Israël, et père de Schéba."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bikri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutum daga kabilar Benyamin da ya rayu a lokacin haɗaɗɗiyar daular Isra’ila, kuma mahaifin Sheba."
        }
      ]
    },
    "hin": {
      "preferred_label": "बिक्री",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिन्यामीन के गोत्र का एक पुरुष जो इस्राएल के संयुक्त राज्य के समय रहा, और शेबा का पिता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Bikri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang laki-laki dari suku Benyamin yang hidup pada masa kerajaan bersatu Israel, dan ayah dari Seba."
        }
      ]
    },
    "por": {
      "preferred_label": "Bicri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem da tribo de Benjamim que viveu durante a época da monarquia unificada de Israel e pai de Seba."
        }
      ]
    },
    "rus": {
      "preferred_label": "Бихри",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек из колена Вениамина, живший во времена единого царства Израиля, отец Савея."
        }
      ]
    },
    "spa": {
      "preferred_label": "Bicrí",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre de la tribu de Benjamín que vivió durante la época del reino unido de Israel, y padre de Seba."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bikri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamume wa kabila la Benyamini aliyeishi wakati wa ufalme wa umoja wa Israeli, na baba yake Sheba."
        }
      ]
    },
    "apd": {
      "preferred_label": "بكري",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل من قبيلة بنيامين عاش في زمن المملكة الموحدة لبني إسرائيل، وهو أبو شبع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bikri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man blong laen blong Benjamin we i laef long taem blong wan neson blong Isrel, mo papa blong Seba."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Bikri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke si nʼebo Benjamin nke biri nʼoge alaeze dị nʼotu nke Izrel, na nna Sheba."
        }
      ]
    },
    "nep": {
      "preferred_label": "बिक्री",
      "descriptions": [
        {
          "source": "acai",
          "description": "बेन्यामीनको कुलका एक व्यक्ति जो इस्राएलको संयुक्त राज्यको समयमा बाँचेका थिए, र शेबाका पिता।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Bikri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong lain bilong Benjamin em i bin stap long taim bilong wanbel kingdom bilong Israel, na em i papa bilong Seba."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bích-ri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người thuộc bộ tộc Bên-gia-min, sống vào thời kỳ vương quốc thống nhất của Y-sơ-ra-ên, và là cha của Sê-ba."
        }
      ]
    },
    "zht": {
      "preferred_label": "比基利",
      "descriptions": [
        {
          "source": "acai",
          "description": "便雅憫支派的一名男子，生活於以色列聯合王國時期，是示巴的父親。"
        }
      ]
    }
