        }
      ]
    },
    "spa": {
      "preferred_label": "Ahías (Ahimelec)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sacerdote e hijo de Ahitud durante el reino unificado de Israel, llamado también Ahimelec y Ahías."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَخِيَّا (أَخِيمَالِك)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كاهن وابن أخيطوب في عهد المملكة الموحدة لإسرائيل، يُدعى أيضًا أخيمالك وأخيا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚希雅（亚希米勒）",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列联合王国时期的一位祭司，亚希突的儿子，也称为亚希米勒或亚希亚。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ahiya (Ahimelek)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani firist kuma ɗan Ahitub a lokacin haɗaɗɗiyar masarautar Isra'ila, wanda kuma ake kira Ahimelek da Ahiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "अहिय्याह (अहीमेलेक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएल के संयुक्त राजतंत्र के दौरान एक याजक और अहीतूब का पुत्र, जिसे अहीमेलेक और अहियाह भी कहा गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ahia (Ahimelekh)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang imam dan anak Ahitub pada masa kerajaan bersatu Israel, yang juga disebut Ahimelekh dan Ahia."
        }
      ]
    },
    "por": {
      "preferred_label": "Aías (Aimeleque)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um sacerdote e filho de Aitube durante a monarquia unida de Israel, também chamado de Aimeleque e Aías."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ахия (Ахимелех)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Священник и сын Ахитува во времена единого царства Израиля, также называемый Ахимелехом и Ахией."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ahiya (Ahimeleki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhani na mwana wa Ahitubu wakati wa ufalme wa umoja wa Israeli, anayeitwa pia Ahimeleki na Ahia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ahiya (Ahimelek)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pris na pikinini man bilong Ahitup long taim bilong kingdom bilong Israel i stap wanbel yet, na ol i kolim em tu Ahimelek na Ahia."
        }
      ]
    },
    "apd": {
      "preferred_label": "أخيا (أخيمالك)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كاهن وود أخيطوب في زمن المملكة الموحدة لبني إسرائيل، وكان بيتسمى كمان أخيمالك وأخيا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ahia (Ahimelek)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pris mo boe blong Ahitub long taem we ol laen blong Isrel oli joen wanples, we oli singaot hem tu se Ahimelek mo Ahia."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ahija (Ahimelek)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye nchụaja na nwa Ahitub nʼoge alaeze dị nʼotu nke Izrel, nke a na-akpọkwa Ahimelek na Ahaya."
        }
      ]
    },
    "nep": {
      "preferred_label": "अहियाह (अहीमेलेक)",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलको संयुक्त अधिराज्यको समयमा अहीतूबका छोरा र एक पूजाहारी, जसलाई अहीमेलेक र अहिया पनि भनिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-hi-gia (A-hi-mê-léc)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thầy tế lễ và là con trai của A-hi-túp trong thời kỳ vương quốc thống nhất của Y-sơ-ra-ên, còn được gọi là A-hi-mê-léc và A-hi-gia."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞希亞（亞希米勒）",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列聯合王國時期的祭司，亞希突的兒子，又稱亞希米勒與亞希亞。"
        }
      ]
    }
  },
