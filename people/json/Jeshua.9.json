  "localizations": {
    "eng": {
      "preferred_label": "Jeshua (Joshua)",
      "alternate_labels": [
        "Joshua"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Joshua",
          "article": "person:Jeshua.9",
          "description": "A son of Jehozadak and high priest from the tribe of Levi, who lived after the Israelite return from exile."
        }
      ]
    },
    "fra": {
      "preferred_label": "Josué (Josué)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Jotsadak et souverain sacrificateur de la tribu de Lévi, qui vécut après le retour d’exil des Israélites."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jesúa (Josué)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Josadac y sumo sacerdote de la tribu de Leví, que vivió después del regreso del exilio israelita."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَشوع (يَشوع)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن يَهوصَادِق ورئيس كهنة من سبط لَّاوِي، عاش بعد عودة بني إسرائيل من السبي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耶书亚 (约书亚)",
      "descriptions": [
        {
          "source": "acai",
          "description": "约萨答的儿子，来自利未支派的大祭司，生活在以色列人被掳归回之后。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yeshuwa (Yoshuwa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Yehozadak kuma babban firist daga kabilar Lawiyawa, wanda ya rayu bayan dawowar Isra'ilawa daga bauta."
        }
      ]
    },
    "hin": {
      "preferred_label": "येशुअ (यहोशू)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहोसादाक का एक पुत्र और लेवी के गोत्र से महायाजक, जो बंधुआई से इस्राएलियों के लौटने के बाद जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yesua (Yosua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang putra Yozadak dan imam besar dari suku Lewi, yang hidup setelah kembalinya bangsa Israel dari pembuangan."
        }
      ]
    },
    "por": {
      "preferred_label": "Jesua (Josué)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Jeozadaque e sumo sacerdote da tribo de Levi, que viveu após o retorno dos israelitas do exílio."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иисус (Иисус сын Иоседеков)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Иоседека, первосвященник из колена Левия, живший после возвращения израильтян из изгнания."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yeshua (Yoshua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Yehosadaki na kuhani mkuu kutoka kabila la Lawi, aliyeishi baada ya Waisraeli kurudi kutoka uhamishoni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jesua (Josua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Jehosadak na bikpris bilong lain Livai, em i bin stap bihain long ol Israel i kam bek long kalabus."
        }
      ]
    },
    "apd": {
      "preferred_label": "يشوع (يشوع)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد يهوصاداق ورئيس كهنة من سبط لاوي، عاش بعد رجوع بني إسرائيل من السبي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Josua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini man blong Jehosadak mo hae pris we i kamaot long laen blong Livae, we i laef biaen we ol laen blong Isrel oli aot long kalabus oli kambak."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jeshua (Joshua)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Jehozadak na nnukwu onye nchụaja sitere nʼebo Livayị, onye dịrị ndụ mgbe ndị Izrel si na ndọta nʼagha lọta."
        }
      ]
    },
    "nep": {
      "preferred_label": "येशूअ (यहोशू)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहोसादाकका छोरा र लेवी कुलका प्रधान पुजारी, जो निर्वासनबाट इस्राएलीहरूको फिर्तीपछि जीवित थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giê-sua (Giô-suê)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Giô-xa-đác và là thầy tế lễ thượng phẩm thuộc bộ tộc Lê-vi, sống sau khi người Y-sơ-ra-ên hồi hương từ chốn lưu đày."
        }
      ]
    },
    "zht": {
      "preferred_label": "耶書亞（約書亞）",
      "descriptions": [
        {
          "source": "acai",
          "description": "約薩達的兒子，出自利未支派的大祭司，生活於以色列人被擄歸回之後。"
        }
      ]
    }
  },
