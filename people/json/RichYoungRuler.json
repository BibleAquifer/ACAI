  "localizations": {
    "eng": {
      "preferred_label": "Rich Young Ruler",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rich Young Ruler",
          "description": "A rich young ruler who had a conversation with Jesus about eternal life."
        }
      ]
    },
    "apd": {
      "preferred_label": "الشاب الغني صاحب المنصب",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاكم شاب غني دخل في نقاش مع يسوع عن الحياة الأبدية."
        }
      ]
    },
    "arb": {
      "preferred_label": "الشاب الغني",
      "descriptions": [
        {
          "source": "acai",
          "description": "شاب غني ذو منصب تحاور مع يسوع عن الحياة الأبدية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Yangfala Rila we i Ritsman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan yangfala man we i gat plante mane mo i wan lida, we i bin toktok wetem Jisas long saed blong laef we i no save finis."
        }
      ]
    },
    "fra": {
      "preferred_label": "Jeune homme riche",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un jeune homme riche et notable qui eut une conversation avec Jésus au sujet de la vie éternelle."
        }
      ]
    },
    "hau": {
      "preferred_label": "Matashin Shugaba Mai Arziki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani matashin shugaba mai arziki wanda ya yi magana da Yesu game da rai madawwami."
        }
      ]
    },
    "hin": {
      "preferred_label": "धनी युवा अधिकारी",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक धनी युवा अधिकारी जिसने यीशु से अनन्त जीवन के विषय में बातचीत की थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye Ọchịchị Na-eto Eto Ọgaranya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye ọchịchị na-eto eto bara ọgaranya nke ya na Jisọs kparịtara ụka banyere ndụ ebighị ebi."
        }
      ]
    },
    "ind": {
      "preferred_label": "Pemimpin Muda yang Kaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pemimpin muda yang kaya yang bercakap-cakap dengan Yesus tentang hidup yang kekal."
        }
      ]
    },
    "nep": {
      "preferred_label": "धनी जवान शासक",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक धनी जवान शासक जसले अनन्त जीवनको बारेमा येशूसँग कुराकानी गरेका थिए।"
        }
      ]
    },
    "por": {
      "preferred_label": "Jovem Rico",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um jovem rico e líder que teve uma conversa com Jesus sobre a vida eterna."
        }
      ]
    },
    "rus": {
      "preferred_label": "Богатый юноша",
      "descriptions": [
        {
          "source": "acai",
          "description": "Богатый юноша (начальник), беседовавший с Иисусом о вечной жизни."
        }
      ]
    },
    "spa": {
      "preferred_label": "Joven rico",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un joven rico y gobernante que tuvo una conversación con Jesús sobre la vida eterna."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kijana Tajiri Mtawala",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kijana tajiri mtawala aliyekuwa na mazungumzo na Yesu kuhusu uzima wa milele."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Yangpela hetman i gat planti mani kago",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela yangpela lida i gat planti mani kago em i bin toktok wantaim Jisas long kisim laip i stap oltaim oltaim."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người trẻ tuổi giàu có",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người trẻ tuổi giàu có có địa vị đã trò chuyện với Chúa Giê-xu về sự sống đời đời."
        }
      ]
    },
    "zhs": {
      "preferred_label": "富有的年轻官长",
      "descriptions": [
        {
          "source": "acai",
          "description": "曾与耶稣谈论永生的富有的年轻官长。"
        }
      ]
    },
    "zht": {
      "preferred_label": "少年的官",
      "descriptions": [
        {
          "source": "acai",
          "description": "曾與耶穌談論永生的一位有錢的青年官。"
        }
      ]
    }
  },
