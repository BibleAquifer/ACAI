  "localizations": {
    "eng": {
      "preferred_label": "Adah",
      "alternate_labels": [
        "Bashemath",
        "Basemath"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Adah",
          "article": "person:Adah.2",
          "description": "One of Esau’s wives from Canaan. She was the daughter of Elon the Hittite."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَدَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "إحدى زوجات عيسو من كنعان، وهي ابنة إيلون الحثي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚大",
      "descriptions": [
        {
          "source": "acai",
          "description": "以扫在迦南娶的妻子之一，赫人以伦的女儿。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Ada",
      "descriptions": [
        {
          "source": "acai",
          "description": "L’une des femmes cananéennes d’Ésaü. Elle était la fille d’Élon le Héthien."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗaya daga cikin matan Isuwa daga Kan’ana. Ita ’yar Elon mutumin Hitti ce."
        }
      ]
    },
    "hin": {
      "preferred_label": "आदा",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनान से एसाव की पत्नियों में से एक। वह हित्ती एलोन की बेटी थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Salah satu istri Esau dari Kanaan. Dia adalah anak perempuan Elon orang Het."
        }
      ]
    },
    "por": {
      "preferred_label": "Ada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma das esposas de Esaú vindas de Canaã. Ela era filha de Elom, o hitita."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ада",
      "descriptions": [
        {
          "source": "acai",
          "description": "Одна из жён Исава родом из Ханаана, дочь Елона хеттеянина."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una de las esposas de Esaú, de Canaán. Era hija de Elón el hitita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmoja wa wake wa Esau kutoka Kanaani. Alikuwa binti wa Eloni Mhiti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bilong ol meri bilong Iso long Kenan. Em i pikinini meri bilong Elon bilong lain Hit."
        }
      ]
    },
    "apd": {
      "preferred_label": "عادة",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحدة من نسوان عيسو من كنعان، وهي بت إيلون الحثي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan long ol woman blong Esao we i kamaot long Kenan. Hem i dota blong Elon we i man Het."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nʼime ndị nwunye Ịsọ si Kenan. Ọ bụ nwa nwanyị Elọn onye Het."
        }
      ]
    },
    "nep": {
      "preferred_label": "आदा",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनानबाट एसावकी एक पत्नी। तिनी हित्ती एलोनकी छोरी थिइन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-đa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một trong các người vợ của Ê-sau đến từ Ca-na-an. Bà là con gái của Ê-lôn người Hê-tít."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞大",
      "descriptions": [
        {
          "source": "acai",
          "description": "以掃來自迦南的妻子之一，是赫人以倫的女兒。"
        }
      ]
    }
  },
