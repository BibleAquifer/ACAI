  "localizations": {
    "eng": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Tamar",
          "article": "person:Tamar.2",
          "description": "A daughter of King David by Maacah, and sister of Absalom. Her half-brother Amnon raped her."
        }
      ]
    },
    "arb": {
      "preferred_label": "ثَامَارُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابنة الملك داود من معكة، وأخت أبشالوم. اغتصبها أخوها غير الشقيق أمنون."
        }
      ]
    },
    "zhs": {
      "preferred_label": "她玛",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王与玛迦的女儿，押沙龙的妹妹。她被同父异母的哥哥暗嫩玷污。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fille du roi David et de Maaca, et sœur d'Absalom. Son demi-frère Amnon la viola."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "'Yar Sarki Dawuda ta wurin Ma’aka, kuma 'yar'uwar Absalom. Ɗan'uwanta Amnon ya yi mata fyaɗe."
        }
      ]
    },
    "hin": {
      "preferred_label": "तामार",
      "descriptions": [
        {
          "source": "acai",
          "description": "माका द्वारा उत्पन्न राजा दाऊद की एक पुत्री और अबशालोम की बहन। उसके सौतेले भाई अम्नोन ने उसके साथ बलात्कार किया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak perempuan Raja Daud dari Maakha, dan saudara perempuan Absalom. Saudara tirinya, Amnon, memperkosanya."
        }
      ]
    },
    "por": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filha do rei Davi com Maaca e irmã de Absalão. Seu meio-irmão Amnom a estuprou."
        }
      ]
    },
    "rus": {
      "preferred_label": "Фамарь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дочь царя Давида от Маахи и сестра Авессалома. Ее единокровный брат Амнон обесчестил ее."
        }
      ]
    },
    "spa": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hija del rey David con Macá y hermana de Absalón. Su medio hermano Amnón la violó."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tamari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Binti wa Mfalme Daudi aliyezaliwa na Maaka, na dada yake Absalomu. Amnoni, kaka yake wa kambo, alimbaka."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini meri bilong King Devit wantaim Maka, na susa bilong Apsalom. Amnon, haf brata bilong en, i bin reipim em."
        }
      ]
    },
    "apd": {
      "preferred_label": "ثامار",
      "descriptions": [
        {
          "source": "acai",
          "description": "بت للملك داود من معكة، وأخت أبشالوم. اغتصبها أخوها من أبوها أمنون."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tamara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan dota blong King Deved we mama blong hem Mahaka, mo sista blong Absalom. Haf-brata blong hem Amnon i fosem hem mo slip wetem hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Tama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwanyị Eze Devid nke Maaka mụrụ, na nwanne nwanyị Absalọm. Ọkara nwanne ya nwoke bụ Amnọn dinara ya n'ike."
        }
      ]
    },
    "nep": {
      "preferred_label": "तामार",
      "descriptions": [
        {
          "source": "acai",
          "description": "माकाद्वारा जन्मिएकी राजा दाऊदकी छोरी, र अब्शालोमकी बहिनी। उनका सौतेनी दाजु अमनोनले उनलाई बलात्कार गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ta-ma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con gái của Vua Đa-vít với Ma-a-ca, và là em gái của Áp-sa-lôm. Nàng bị người anh cùng cha khác mẹ là Am-nôn cưỡng hiếp."
        }
      ]
    },
    "zht": {
      "preferred_label": "她瑪",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王與瑪迦所生的女兒，押沙龍的胞妹。她被同父異母的哥哥暗嫩強暴。"
        }
      ]
    }
  },
