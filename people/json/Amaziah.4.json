          "description": "كاهن في بيت إيل عاش في زمن المملكة المنقسمة، ورد ذكره في عاموس 7: 10، في عهد النبي عاموس."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚玛谢 (阿摩司书 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期的一位伯特利的祭司，在阿摩司书7:10中提及，生活在先知阿摩司的时代。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Amaziya (Amos 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani firist na Betel da ya rayu a lokacin rabuwar mulki, wanda aka ambata a Amos 7:10, a zamanin annabi Amos."
        }
      ]
    },
    "hin": {
      "preferred_label": "अमस्याह (आमोस 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के समय रहने वाला बेतेल का एक याजक, जिसका उल्लेख आमोस भविष्यद्वक्ता के समय में आमोस 7:10 में किया गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Amazia (Amos 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang imam di Betel yang hidup pada zaman kerajaan terpecah, disebutkan dalam Amos 7:10, pada masa nabi Amos."
        }
      ]
    },
    "por": {
      "preferred_label": "Amazias (Amós 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um sacerdote de Betel que viveu na época do reino dividido, mencionado em Amós 7:10, durante o tempo do profeta Amós."
        }
      ]
    },
    "rus": {
      "preferred_label": "Амасия (Амос 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Священник Вефильский, живший во времена разделенного царства, упоминаемый в Амоса 7:10, во времена пророка Амоса."
        }
      ]
    },
    "swh": {
      "preferred_label": "Amazia (Amosi 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhani wa Betheli aliyeishi wakati wa ufalme uliogawanyika, aliyetajwa katika Amosi 7:10, wakati wa nabii Amosi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Amasia (Amos 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pris bilong Betel i stap long taim bilong kingdom i brukbruk, em Baibel i kolim nem bilong en long Amos 7:10, long taim bilong profet Amos."
        }
      ]
    },
    "apd": {
      "preferred_label": "أمصيا (عاموس 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كاهن في بيت إيل عاش في زمن المملكة المنقسمة، مذكور في عاموس 7: 10، في زمن النبي عاموس."
        }
      ]
    },
    "bis": {
      "preferred_label": "Amajia (Emos 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pris blong Betel we i laef long taem we kingdom i seraot, we Baebol i tokbaot hem long Amos 7:10, long taem blong Profet Amos."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Amazaya (Emọs 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye nchụaja nke Betel nke dịrị ndụ nʼoge alaeze ahụ kewara ekewa, nke a kpọtụrụ aha nʼEmọs 7:10, nʼoge onye amụma bụ Emọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "अमस्याह (आमोस 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा बाँचेका बेथेलका एक पुजारी, आमोस ७:१० मा उल्लिखित, अगमवक्ता आमोसको समयका।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-ma-xia (A-mốt 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thầy tế lễ tại Bê-tên sống vào thời vương quốc phân chia, được nhắc đến trong A-mốt 7:10, vào thời của nhà tiên tri A-mốt."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞瑪謝 (阿摩司書 7:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期生活在先知阿摩司時代的伯特利祭司，記載於阿摩司書7:10。"
        }
      ]
    }
  },
