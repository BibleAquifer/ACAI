  "localizations": {
    "eng": {
      "preferred_label": "Andrew",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Andrew",
          "article": "person:Andrew",
          "description": "First called of the twelve disciples of Jesus. Andrew was a brother of Simon Peter."
        }
      ]
    },
    "fra": {
      "preferred_label": "André",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le premier appelé des douze disciples de Jésus. André était le frère de Simon Pierre."
        }
      ]
    },
    "spa": {
      "preferred_label": "Andrés",
      "descriptions": [
        {
          "source": "acai",
          "description": "El primero de los doce discípulos de Jesús en ser llamado. Andrés era hermano de Simón Pedro."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَنْدَرَاوُس",
      "descriptions": [
        {
          "source": "acai",
          "description": "أول من دُعي من تلاميذ يسوع الاثني عشر، وكان أندراوس أخًا لسمعان بطرس."
        }
      ]
    },
    "zhs": {
      "preferred_label": "安得烈",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶稣十二门徒中最早蒙召者，西门彼得的兄弟。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Andarawus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Na farko da aka kira a cikin almajiran Yesu goma sha biyu. Andarawus ɗan’uwan Bitrus ne."
        }
      ]
    },
    "hin": {
      "preferred_label": "अन्द्रियास",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु के बारह चेलों में सबसे पहले बुलाए गए प्रेरित। अन्द्रियास शमौन पतरस का भाई था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Andreas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Murid pertama yang dipanggil dari kedua belas murid Yesus. Andreas adalah saudara dari Simon Petrus."
        }
      ]
    },
    "por": {
      "preferred_label": "André",
      "descriptions": [
        {
          "source": "acai",
          "description": "O primeiro a ser chamado entre os doze discípulos de Jesus. André era irmão de Simão Pedro."
        }
      ]
    },
    "rus": {
      "preferred_label": "Андрей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первозванный из двенадцати учеников Иисуса. Андрей был братом Симона Петра."
        }
      ]
    },
    "swh": {
      "preferred_label": "Andrea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wa kwanza kuitwa miongoni mwa wale wanafunzi kumi na wawili wa Yesu. Andrea alikuwa ndugu yake Simoni Petro."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Andru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba wan man Jisas i singautim namel long ol 12-pela disaipel bilong en. Andru em i brata bilong Saimon Pita."
        }
      ]
    },
    "apd": {
      "preferred_label": "أندراوس",
      "descriptions": [
        {
          "source": "acai",
          "description": "أول واحد ناداه يسوع من تلاميذه الاثنا عشر. أندراوس كان أخو سمعان بطرس."
        }
      ]
    },
    "bis": {
      "preferred_label": "Andru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Faswan we Jisas i singaotem long olgeta twelef disaepol blong hem. Andru hem i brata blong Saemon Pita."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Andru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye mbụ a kpọrọ nʼime ndị na-eso ụzọ Jisọs iri na abụọ. Andru bụ nwanne Saimọn Pita."
        }
      ]
    },
    "nep": {
      "preferred_label": "अन्द्रियास",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूका बाह्र चेलाहरूमध्ये पहिलो बोलाइएका चेला। अन्द्रियास सिमोन पत्रुसका भाइ थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Anh-rê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Môn đồ đầu tiên được kêu gọi trong số mười hai sứ đồ của Chúa Giê-xu. Anh-rê là anh em của Si-môn Phi-e-rơ."
        }
      ]
    },
    "zht": {
      "preferred_label": "安得烈",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶穌十二門徒中首先蒙召者。安得烈是西門彼得的兄弟。"
        }
      ]
    }
  },
