  "type": "person",
  "gender": "male",
  "roles": [
    "Prophet"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Haggai",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Haggai",
          "article": "person:Haggai",
          "description": "Haggai was a prophet living during the time of Israelite exile and return, mentioned in the book of Ezra. There is an Old Testament book named after him."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَجَّي",
      "descriptions": [
        {
          "source": "acai",
          "description": "حجي كان نبيًا عاش في زمن سبي بني إسرائيل والرجوع منه، وقد ورد ذكره في سفر عزرا. وهناك سفر في العهد القديم يحمل اسمه."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈该",
      "descriptions": [
        {
          "source": "acai",
          "description": "哈该是一名先知，生活在以色列人被掳及归回时期，见以斯拉记。旧约中有一卷书以他命名。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Aggée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Aggée était un prophète vivant à l'époque de l'exil et du retour d'Israël, mentionné dans le livre d'Esdras. Un livre de l'Ancien Testament porte son nom."
        }
      ]
    },
    "hau": {
      "preferred_label": "Haggai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Haggai annabi ne da ya rayu a lokacin bautar Isra'ilawa da komowa, wanda aka ambata a littafin Ezra. Akwai littafin Tsohon Alkawari da aka sanya wa sunansa."
        }
      ]
    },
    "hin": {
      "preferred_label": "हाग्गै",
      "descriptions": [
        {
          "source": "acai",
          "description": "हाग्गै इस्राएलियों के बंधुवाई और वापसी के समय रहने वाला एक नबी था, जिसका उल्लेख एज्रा की पुस्तक में मिलता है। उनके नाम पर पुराने नियम की एक पुस्तक है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hagai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hagai adalah seorang nabi yang hidup pada masa pembuangan dan pemulangan bangsa Israel, yang disebutkan dalam kitab Ezra. Terdapat sebuah kitab di Perjanjian Lama yang dinamai menurut namanya."
        }
      ]
    },
    "por": {
      "preferred_label": "Ageu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ageu foi um profeta que viveu durante o tempo do exílio e retorno dos israelitas, mencionado no livro de Esdras. Há um livro do Antigo Testamento com o seu nome."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аггей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Аггей был пророком, жившим во времена изгнания и возвращения израильтян, упоминаемым в книге Ездры. Его именем названа книга Ветхого Завета."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hageo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hageo fue un profeta que vivió durante la época del exilio y el retorno israelita, mencionado en el libro de Esdras. Hay un libro del Antiguo Testamento que lleva su nombre."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hagai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hagai alikuwa nabii aliyeishi wakati wa uhamisho na kurudi kwa Waisraeli, anayetajwa katika kitabu cha Ezra. Kuna kitabu cha Agano la Kale kilichopewa jina lake."
        }
      ]
    },
    "apd": {
      "preferred_label": "حجي",
      "descriptions": [
        {
          "source": "acai",
          "description": "حجي كان نبي عاش في زمن سبي بني إسرائيل ورجوعهم، واتذكر في سفر عزرا. وفيه سفر في العهد القديم متسمي باسمه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hagae",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hagae hem i wan profet we i laef long taem blong eksael mo riton blong ol man Isrel, we Buk blong Esra i tokbaot hem. I gat wan buk long Oltesteman we oli singaotem long nem blong hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hegai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hegai bụ onye amụma biri n'oge a dọọrọ ndị Izrel n'agha na nloghachi, nke a kpọtụrụ aha n'akwụkwọ Ezra. E nwere akwụkwọ Agba Ochie nke akpọrọ aha ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "हाग्गै",
      "descriptions": [
        {
          "source": "acai",
          "description": "हाग्गै इस्राएलीहरूको निर्वासन र पुनरागमनको समयमा बाँचेका एक अगमवक्ता थिए, जसको उल्लेख एज्राको पुस्तकमा गरिएको छ। पुरानो करारमा उनको नाममा एउटा पुस्तक छ।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hagai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hagai em i wanpela profet i bin stap long taim bilong ol Israel i go kalabus na i go bek, em buk bilong Esra i kamapim stori bilong en. I gat wanpela buk bilong Olpela Testamen ol i givim nem bilong en long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "A-gai",
      "descriptions": [
        {
          "source": "acai",
          "description": "A-gai là một nhà tiên tri sống vào thời kỳ dân Y-sơ-ra-ên bị lưu đày và hồi hương, được đề cập trong sách Ê-xơ-ra. Có một sách Cựu Ước mang tên ông."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈該",
      "descriptions": [
        {
          "source": "acai",
          "description": "哈該是一名生活在以色列人被擄及歸回時期的先知，見於以斯拉記。舊約聖經中有一卷書以他命名。"
        }
      ]
    }
  },
