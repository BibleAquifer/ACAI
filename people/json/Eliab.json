  "localizations": {
    "eng": {
      "preferred_label": "Eliab",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Eliab",
          "article": "person:Eliab",
          "description": "Son of Helon, who was the chief of the tribe of Zebulun during the wilderness wandering of the Israelites."
        }
      ]
    },
    "fra": {
      "preferred_label": "Éliab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Hélon, qui était le chef de la tribu de Zabulon pendant l'errance des Israélites dans le désert."
        }
      ]
    },
    "spa": {
      "preferred_label": "Eliab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Helón, quien fue jefe de la tribu de Zabulón durante la travesía de los israelitas por el desierto."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَلِيآب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن حِيلُونَ، وكان رئيس سبط زَبُولُونَ أثناء تيه بني إسرائيل في البرية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以利押",
      "descriptions": [
        {
          "source": "acai",
          "description": "希伦的儿子，以色列人漂流旷野时期西布伦支派的首领。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Eliyab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Helon, wanda shi ne shugaban kabilar Zebulun a lokacin yawon Isra’ilawa a hamada."
        }
      ]
    },
    "hin": {
      "preferred_label": "एलीआब",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेलोन का पुत्र, जो इस्राएलियों के जंगल में भटकने के समय जबूलून के गोत्र का प्रधान था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Eliab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Helon, yang merupakan pemimpin suku Zebulon selama pengembaraan bangsa Israel di padang gurun."
        }
      ]
    },
    "por": {
      "preferred_label": "Eliabe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Helom, que foi chefe da tribo de Zebulom durante a peregrinação dos israelitas no deserto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Елиав",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Хелона, вождь колена Завулона во время странствования израильтян по пустыне."
        }
      ]
    },
    "swh": {
      "preferred_label": "Eliabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Heloni, aliyekuwa kiongozi wa kabila la Zabuloni wakati wa Waisraeli kutangatanga nyikani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Eliap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Helon, em i hetman bilong lain Sebulun long taim ol Israel i bin wokabaut long ples drai nating."
        }
      ]
    },
    "apd": {
      "preferred_label": "أليآب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد حيلون، وكان رئيس سبط زبولون وكت تيه بني إسرائيل في البرية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Eliab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Helon, we i bin lida blong laen blong Sebulun long taem we ol man Isrel oli stap wokbaot long draeples."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Eliab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Helọn, onye bụ onyeisi ebo Zebụlọn nʼoge ụmụ Izrel na-awagharị nʼọzara."
        }
      ]
    },
    "nep": {
      "preferred_label": "एलीआब",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेलोनका छोरा, जो इस्राएलीहरूको उजाड-स्थानको यात्राको समयमा जबूलून कुलका अगुवा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-li-áp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Hê-lôn, từng là thủ lĩnh của chi phái Sa-bu-luân trong thời kỳ dân Y-sơ-ra-ên lưu lạc trong hoang mạc."
        }
      ]
    },
    "zht": {
      "preferred_label": "以利押",
      "descriptions": [
        {
          "source": "acai",
          "description": "希倫的兒子，以色列人曠野漂流時期西布倫支派的領袖。"
        }
      ]
    }
  },
