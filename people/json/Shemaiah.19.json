      "preferred_label": "Shemaya (Nehemia 6:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shemaya, anayetajwa katika Nehemia 6:10, alikuwa mwanamume aliyeishi wakati wa uhamisho na kurejea, naye alikuwa mwana wa Delaya."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Semaia (Nehemia 6:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Semaia, em i wanpela man i stap long taim bilong kalabus na taim bilong ol i go bek na em i pikinini man bilong Delaia, na ol i kolim nem bilong en long Nehemia 6:10."
        }
      ]
    },
    "apd": {
