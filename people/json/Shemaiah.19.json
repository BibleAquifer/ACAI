      ]
    },
    "bis": {
      "preferred_label": "Semaea (Nehemaea 6:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Semaea, we Nehemiah 6:10 i tokbaot hem, hem i wan man we i laef long taem blong eksael mo taem blong kambak, mo hem i pikinini boe blong Delaea."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shemaya (Nehemaịa 6:10)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shemaya, nke a kpọtụrụ aha na Nehemaya 6:10, bụ nwoke biri ndụ nʼoge a dọọrọ nʼagha na mgbe a lọtara, bụrụkwa nwa Delaya."
        }
      ]
    },
    "nep": {
