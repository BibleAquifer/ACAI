  "localizations": {
    "eng": {
      "preferred_label": "Herod Antipas",
      "alternate_labels": [
        "Herod"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Herod Antipas",
          "article": "person:Herod.2",
          "description": "Ruler of Galilee and tetrarch during the time of Jesus. He was the son of King Herod the Great."
        }
      ]
    },
    "fra": {
      "preferred_label": "Hérode Antipas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dirigeant de la Galilée et tétrarque à l'époque de Jésus. Il était le fils du roi Hérode le Grand."
        }
      ]
    },
    "spa": {
      "preferred_label": "Herodes Antipas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gobernante de Galilea y tetrarca durante el tiempo de Jesús. Era hijo del rey Herodes el Grande."
        }
      ]
    },
    "arb": {
      "preferred_label": "هِيرُودُس أَنْتِيبَاس",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاكِمُ الجَلِيلِ ورَئِيسُ رُبْعٍ في عَهْدِ يَسُوعَ. وكانَ ابنَ المَلِكِ هِيرُودُسَ الكَبِيرِ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "希律·安提帕",
      "descriptions": [
        {
          "source": "acai",
          "description": "加利利的统治者，耶稣时代的分封王。他是大希律王的儿子。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hiridus Antifas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mai mulkin Galili kuma mai mulkin yanki a zamanin Yesu. Ya kasance ɗan Sarki Hiridus Mai Girma."
        }
      ]
    },
    "ind": {
      "preferred_label": "Herodes Antipas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Penguasa Galilea dan raja wilayah (tetrark) pada zaman Yesus. Ia adalah putra Raja Herodes Agung."
        }
      ]
    },
    "por": {
      "preferred_label": "Herodes Antipas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Governante da Galileia e tetrarca durante o tempo de Jesus. Era filho do rei Herodes, o Grande."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ирод Антипа",
      "descriptions": [
        {
          "source": "acai",
          "description": "Правитель Галилеи и тетрарх во времена Иисуса. Сын царя Ирода Великого."
        }
      ]
    },
    "swh": {
      "preferred_label": "Herode Antipa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtawala wa Galilaya na mtawala wa robo wakati wa Yesu. Alikuwa mwana wa Mfalme Herode Mkuu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Herot Antipas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rula bilong Galili na namba wan gavman long taim bilong Jisas. Em i pikinini man bilong King Herot Bikpela."
        }
      ]
    },
    "apd": {
      "preferred_label": "هيرودس أنتيباس",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاكم الجليل ورئيس ربع في زمن يسوع، وهو ولد الملك هيرودس الكبير."
        }
      ]
    },
    "bis": {
      "preferred_label": "Herod Antipas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rula blong Galili mo hed gavman long taem blong Jisas. Hem i pikinini boe blong King Herod we i Haefala King."
        }
      ]
    },
    "hin": {
      "preferred_label": "हेरोदेस अन्तिपास",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु के समय में गलील का शासक और चौथाई देश का राजा (चौथाईदार)। वह राजा हेरोदेस महान का पुत्र था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Herọd Antipas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye chịrị Galili na tetrarch nʼoge Jisọs. Ọ bụ nwa Eze Herọd Onye Ukwu."
        }
      ]
    },
    "nep": {
      "preferred_label": "हेरोद एन्टिपास",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूको समयमा गालीलका शासक तथा चौथाइ-शासक (टेट्रार्क)। तिनी राजा महाहेरोदका छोरा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hê-rốt An-ti-pa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người cai trị xứ Ga-li-lê và là vua chư hầu (phân vương) vào thời Chúa Giê-xu. Ông là con trai của Vua Hê-rốt Đại Đế."
        }
      ]
    },
    "zht": {
      "preferred_label": "希律·安提帕",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶穌時代的加利利統治者兼分封王。他是大希律王的兒子。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
