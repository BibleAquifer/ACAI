  "localizations": {
    "eng": {
      "preferred_label": "Jahzeel",
      "alternate_labels": [
        "Jahziel",
        "Jahzeelite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jahzeel",
          "article": "person:Jahzeel",
          "description": "A son of the patriarch Naphtali and brother of Guni, Jezer, and Shillem. He was founder of the clan of the Jahzeelites."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَاحَصْئِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن لنفتالي وأخو جوني ويصر وشليم. وهو مؤسس عشيرة الياحصئيليين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "雅薛",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖拿弗他利的儿子，沽尼、耶色和示冷的兄弟。他是雅薛家族的始祖。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yazeyel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan kakan nan Naftali kuma ɗan’uwan Guni, Yezer, da Shillem. Shi ne ya kafa kabilar Yazeyelawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहसेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नप्ताली का एक पुत्र तथा गूनी, येसेर और शिल्लेम का भाई। वह यहसेलियों के कुल का संस्थापक था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yahzeel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki dari bapa leluhur Naftali dan saudara laki-laki Guni, Yezer, dan Syilem. Ia adalah pendiri kaum orang Yahzeel."
        }
      ]
    },
    "por": {
      "preferred_label": "Jazeel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho do patriarca Naftali e irmão de Guni, Jezer e Silém. Ele foi o fundador do clã dos jazeelitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иахцеил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Неффалима и брат Гуния, Иецера и Шиллема. Основатель рода Иахцеила."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jahzeel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Neftalí y hermano de Guni, Jéser y Silén. Fue fundador del clan de los jahzeelitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yaseeli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa mzee wa ukoo Naftali na ndugu wa Guni, Yeseri, na Shilemu. Alikuwa mwanzilishi wa ukoo wa Wayaseeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jasel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Naptali na brata bilong Guni, Jeser, na Silem. Em i as bilong lain wanblut bilong ol Jasiel."
        }
      ]
    },
    "apd": {
      "preferred_label": "يَحْصَئيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ود أبونا نفتالي وأخو جوني ويَصِر وشِلّيم. هو كان مؤسس عشيرة اليَحْصَئيليين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jajehel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong tufala Naftali mo brata blong Guni, Jeja, mo Silem. Hem i stamba blong laen blong ol man Jajehel."
        }
      ]
    },
    "fra": {
      "preferred_label": "Jahtseel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Nephthali et frère de Guni, Jetser et Schillem. Il fut le fondateur du clan des Jahtseélites."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jaziil",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nke nna ochie Naftalị na nwanne Guni, Jeza, na Shilem. Ọ bụ ya guzobere ikwu ndị Jaziil."
        }
      ]
    },
    "nep": {
      "preferred_label": "यहसेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नप्‍तालीका एक छोरा र गुनी, येसेर र शिल्‍लेमका दाजुभाइ। तिनी यहसीलीहरूका कुलका संस्‍थापक थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Gia-xên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của tổ phụ Nép-ta-li và là anh em với Gu-ni, Giê-xe và Si-lem. Ông là người sáng lập thị tộc Giát-sê-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "雅薛",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖拿弗他利的兒子，沽尼、耶色和示冷的兄弟。他是雅薛族的始祖。"
        }
      ]
    }
  },
