  "localizations": {
    "eng": {
      "preferred_label": "Joram",
      "alternate_labels": [
        "Jehoram"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Joram",
          "article": "person:Joram.3",
          "description": "A king of Israel during the divided kingdom. He was a son of Ahab by Jezebel."
        }
      ]
    },
    "arb": {
      "preferred_label": "يورَام",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك على إسرائيل في عهد المملكة المنقسمة، وهو ابن أخآب من إيزابل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约兰",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期的一位以色列王。他是亚哈与耶洗别的儿子。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Joram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi d'Israël à l'époque du royaume divisé. Il était fils d'Achab et de Jézabel."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yoram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Isra’ila a lokacin rarrabuwar masarauta. Shi ɗan Ahab ne ta wurin Yezebel."
        }
      ]
    },
    "hin": {
      "preferred_label": "योराम",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राजतंत्र के दौरान इस्राएल का एक राजा। वह ईजेबेल से उत्पन्न अहाब का पुत्र था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yoram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang raja Israel pada masa kerajaan terpecah. Ia adalah anak Ahab dari Izebel."
        }
      ]
    },
    "por": {
      "preferred_label": "Jorão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rei de Israel durante o reino dividido. Era filho de Acabe com Jezabel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иорам",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь Израиля в период разделенного царства. Сын Ахава от Иезавели."
        }
      ]
    },
    "spa": {
      "preferred_label": "Joram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey de Israel durante el reino dividido. Fue hijo de Acab y Jezabel."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yoramu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Israeli wakati wa ufalme uliogawanyika. Alikuwa mwana wa Ahabu na Yezebeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Joram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela king bilong Israel long taim kantri i brukbruk. Em i pikinini man bilong Ahap tupela Jesebel."
        }
      ]
    },
    "apd": {
      "preferred_label": "يورام",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك على إسرائيل زمن المملكة المنقسمة. كان ولد أخاب من إيزابل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Joram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong Isrel long taem we kingdom i seraot. Hem i pikinini man blong Ehab wetem Jesebel."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Joram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze Izrel n'oge alaeze kewara ekewa. Ọ bụ nwa Ehab nke Jezebel mụrụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "योराम",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा इस्राएलका एक राजा। तिनी ईजबेलद्वारा जन्मेका आहाबका छोरा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-ram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vua của Ít-ra-ên trong thời kỳ vương quốc phân chia. Ông là con trai của A-háp và Giê-xa-bên."
        }
      ]
    },
    "zht": {
      "preferred_label": "約蘭",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期的以色列王。他是亞哈與耶洗別的兒子。"
        }
      ]
    }
  },
