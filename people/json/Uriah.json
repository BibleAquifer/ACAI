  "partners": [
    "person:Bathsheba"
  ],
  "roles": [
    "Military Commander",
    "Relative of Jesus"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Uriah",
      "alternate_labels": [
        "Urias"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Uriah",
          "article": "person:Uriah",
          "description": "Uriah the Hittite was Bathsheba’s first husband, who was murdered by King David. He is listed in record of Jesus' family line."
        }
      ]
    },
    "arb": {
      "preferred_label": "أُورِيَّا",
      "descriptions": [
        {
          "source": "acai",
          "description": "كان أُورِيَّا الحِثِّيّ زوج بَثْشَبَع الأول، الذي قتله الملك داود. وهو مذكور في سجل نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "乌利亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "赫人乌利亚是拔示巴的第一任丈夫，被大卫王谋杀。他被列入耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Urie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Urie le Héthien était le premier mari de Bath-Schéba, assassiné par le roi David. Il est mentionné dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Uriya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uriya mutumin Hitti shi ne mijin Batsheba na farko, wanda Sarki Dawuda ya sa aka kashe. An lissafa shi a tarihin asalin iyalin Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "ऊरिय्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "हित्ती ऊरिय्याह बतशेबा का पहला पति था, जिसकी राजा दाऊद द्वारा हत्या करवा दी गई थी। उसका नाम यीशु की वंशावली के अभिलेख में दर्ज है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Uria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uria orang Het adalah suami pertama Batsyeba, yang dibunuh oleh Raja Daud. Ia tercatat dalam silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Urias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Urias, o hitita, foi o primeiro marido de Bate-Seba, assassinado pelo rei Davi. Ele consta no registro da linhagem de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Урия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Урия Хеттеянин — первый муж Вирсавии, убитый по приказу царя Давида. Он упомянут в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Urías",
      "descriptions": [
        {
          "source": "acai",
          "description": "Urías el hitita fue el primer esposo de Betsabé, asesinado por el rey David. Está incluido en el registro de la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uria Mhiti alikuwa mume wa kwanza wa Bathsheba, aliyeuawa na Mfalme Daudi. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Uria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uria bilong lain Hit em i namba wan man bilong Batseba, na King Devit i bin mekim pasin nogut na kilim em i dai. Nem bilong em i stap tu long lista bilong lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "أوريا",
      "descriptions": [
        {
          "source": "acai",
          "description": "أوريا الحثي كان راجل بتشبع الأول، والملك داود قتلو. ومذكور في سجل نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Uria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uria we i man Het hem i fas hasban blong Batseba, we King Deved i kilim hem i ded. Nem blong hem i stap long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụraya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ụraya onye Het bụ di mbụ Batsheba, onye Eze Devid mere ka e gbuo. E depụtara ya n'akwụkwọ usoro ọmụmụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "उरियाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "हित्ती उरियाह बतशेबाका पहिलो पति थिए, जसलाई राजा दाऊदले हत्या गराएका थिए। उनी येशूको वंशावलीको विवरणमा सूचीकृत छन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "U-ri",
      "descriptions": [
        {
          "source": "acai",
          "description": "U-ri người Hê-tít là người chồng đầu tiên của Bát-sê-ba, bị Vua Đa-vít mưu hại giết chết. Ông được liệt kê trong gia phả của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "烏利亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "赫人烏利亞是拔示巴的第一任丈夫，被大衛王謀害。他被列在耶穌的家譜中。"
        }
      ]
    }
  },
