    "eng": {
      "preferred_label": "Jehoash (Joash)",
      "alternate_labels": [
        "Joash"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Joash",
          "article": "person:Jehoash.2",
          "description": "A king of the northern kingdom of Israel during the divided kingdom. He was a son of Jehoahaz and father of Jeroboam."
        }
      ]
    },
    "fra": {
      "preferred_label": "Joas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi du royaume du Nord (Israël) à l’époque du royaume divisé. Il était fils de Joachaz et père de Jéroboam."
        }
      ]
    },
    "spa": {
      "preferred_label": "Joás (rey de Israel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey del reino del norte de Israel durante el reino dividido. Era hijo de Joacaz y padre de Jeroboam."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَهُوآش (يُوآش)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَلِكٌ لِمَمْلَكَةِ إِسْرَائِيلَ ٱلشَّمَالِيَّةِ أَثْنَاءَ عَهْدِ ٱلْمَمْلَكَةِ ٱلْمُنْقَسِمَةِ. كَانَ ٱبْنًا لِيَهُوآحَازَ وَأَبًا لِيَرُبْعَامَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约阿施 (以色列)",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期北国以色列的一位王。他是约哈斯的儿子，耶罗波安的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yehowash (Yowash)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin masarautar arewa ta Isra’ila a lokacin rarrabuwar masarauta. Ɗan Yehoyahaz ne kuma mahaifin Yerobowam."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहोआश (योआश)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के काल में इस्राएल के उत्तरी राज्य का एक राजा। वह यहोआहाज का पुत्र और यारोबाम का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yoas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang raja dari kerajaan utara Israel pada masa kerajaan terpecah. Ia adalah anak Yoahas dan ayah Yerobeam."
        }
      ]
    },
    "por": {
      "preferred_label": "Jeoás (Joás)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um rei do reino do norte de Israel durante o reino dividido. Ele era filho de Jeoacaz e pai de Jeroboão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иоас (Иоас)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь северного царства Израиля в период разделенного царства. Сын Иоахаза и отец Иеровоама."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yehoashi (Yoashi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa ufalme wa kaskazini wa Israeli wakati wa ufalme uliogawanyika. Alikuwa mwana wa Yehoahazi na baba yake Yeroboamu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jehoas (Joas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela king bilong not kingdom Israel long taim kingdom i bin brukpais. Em i pikinini man bilong Joahas na papa bilong Jeroboam."
        }
      ]
    },
    "apd": {
      "preferred_label": "يهوآش (يوآش)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك لمملكة إسرائيل الشمالية وكت المملكة كانت مقسومة. كان ولد يهوآحاز وأبو يربعام."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jehoas (Joas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong not kingdom blong Isrel long taem we kingdom i seraot. Hem i wan pikinini boe blong Jehoahas mo papa blong Jeroboam."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jehoash (Joash)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze alaeze ugwu nke Izrel nʼoge alaeze kewara ekewa. Ọ bụ nwa nwoke Jehoahaz na nna Jeroboam."
        }
      ]
    },
    "nep": {
      "preferred_label": "यहोआश (योआश)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा इस्राएलको उत्तरी राज्यका एक राजा। तिनी यहोआहाजका छोरा र यारोबामका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-ách (Giô-ách)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vị vua của vương quốc phía bắc Y-sơ-ra-ên trong thời kỳ vương quốc phân chia. Ông là con trai của Giô-a-cha và là cha của Giê-rô-bô-am."
        }
      ]
    },
    "zht": {
      "preferred_label": "約阿施 (約阿施)",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期的北國以色列王。他是約哈斯的兒子，耶羅波安的父親。"
        }
      ]
    }
  },
