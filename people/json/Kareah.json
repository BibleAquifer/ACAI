          "gloss": "Kareah",
          "article": "person:Kareah",
          "description": "Father of the military officer Johanan who opposed the governor Gedaliah during the time of the Isrealite return from exile. "
        }
      ]
    },
    "fra": {
      "preferred_label": "Karéach",
      "descriptions": [
        {
          "source": "acai",
          "description": "Père de l’officier militaire Jochanan, qui s’opposa au gouverneur Guedalia à l’époque du retour d’exil des Israélites."
        }
      ]
    },
    "spa": {
      "preferred_label": "Carea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Padre del oficial militar Johanán que se opuso al gobernador Guedalías durante la época del retorno de los israelitas del exilio."
        }
      ]
    },
    "arb": {
      "preferred_label": "قاريح",
      "descriptions": [
        {
          "source": "acai",
          "description": "أبو القائد العسكري يوحانان الذي عارض الوالي جدليا في زمن رجوع بني إسرائيل من السبي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "加利亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "军官约哈难的父亲，在以色列人从流亡归回时期反对省长基大利。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kareya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahaifin hafsan soja Yohanan wanda ya yi hamayya da gwamna Gedaliya a lokacin komowar Isra’ilawa daga bauta."
        }
      ]
    },
    "hin": {
      "preferred_label": "कारेह",
      "descriptions": [
        {
          "source": "acai",
          "description": "सैन्य अधिकारी योहानान का पिता, जिसने इस्राएलियों की बंधुआई से वापसी के समय राज्यपाल गदल्याह का विरोध किया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kareah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ayah dari perwira tentara Yohanan yang menentang gubernur Gedalya pada masa kepulangan bangsa Israel dari pembuangan."
        }
      ]
    },
    "por": {
      "preferred_label": "Careá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pai do oficial militar Joanã, que se opôs ao governador Gedalias durante o tempo do retorno israelita do exílio."
        }
      ]
    },
    "rus": {
      "preferred_label": "Карей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отец военачальника Иоханана, противостоявшего правителю Годолии во время возвращения израильтян из пленения."
        }
      ]
    },
    "swh": {
      "preferred_label": "Karea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Baba wa ofisa wa jeshi Yohanani aliyempinga liwali Gedalia wakati wa kurejea kwa Waisraeli kutoka uhamishoni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Karea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa bilong ofisa bilong ami Johanan em i bin krosim gavana Gedalia long taim bilong ol Israel i kam bek long kalabus."
        }
      ]
    },
    "apd": {
      "preferred_label": "قريح",
      "descriptions": [
        {
          "source": "acai",
          "description": "أبو القائد العسكري يوحنان العارض الحاكم جدليا في زمن رجوع بني إسرائيل من السبي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Karea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa blong ofisa blong ami ya Johanan we i bin agensem gavana Gedalia long taem we ol man Isrel oli kambak long kalabus."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kariya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nna onyeisi agha bụ Johanan onye megidere gọvanọ Gedaliya nʼoge nlọghachi ụmụ Izrel site na ndọrọ nʼagha."
        }
      ]
    },
    "nep": {
      "preferred_label": "कारेह",
      "descriptions": [
        {
          "source": "acai",
          "description": "सैन्य अधिकारी योहानानका पिता, जसले इस्राएलीहरूको निर्वासनबाट फिर्तीको समयमा राज्यपाल गदल्याहको विरोध गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ca-rê-át",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cha của viên chỉ huy quân đội Giô-ha-nan, người đã chống lại quan tổng đốc Ghê-đa-lia vào thời kỳ dân Y-sơ-ra-ên hồi hương sau thời lưu đày."
        }
      ]
    },
    "zht": {
      "preferred_label": "加利亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "軍長約哈難的父親，約哈難在以色列人被擄回歸時期曾反對省長基大利。"
        }
      ]
    }
  },
