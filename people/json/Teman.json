  "localizations": {
    "eng": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Teman",
          "article": "person:Teman",
          "description": "Grandson of the patriarch Esau, son of Eliphaz, and a chief of the Edomites."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَيْمان",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد أب الآباء عيسو، وابن أليفاز، وأمير من أمراء الأدوميين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "提幔",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖以扫的孙子，以利法的儿子，以东人的族长。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Théman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit-fils du patriarche Ésaü, fils d'Éliphaz, et chef des Édomites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jikan uban iyali Isuwa, ɗan Elifaz, kuma shugaba a cikin Edomawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "तेमान",
      "descriptions": [
        {
          "source": "acai",
          "description": "पूर्वपिता एसाव का पोता, एलीपज का पुत्र और एदोमियों का एक अधिपति।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cucu dari bapa leluhur Esau, putra Elifas, dan seorang kepala kaum orang Edom."
        }
      ]
    },
    "por": {
      "preferred_label": "Temã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neto do patriarca Esaú, filho de Elifaz e chefe dos edomitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Феман",
      "descriptions": [
        {
          "source": "acai",
          "description": "Внук патриарха Исава, сын Елифаза и старейшина эдомитян."
        }
      ]
    },
    "spa": {
      "preferred_label": "Temán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nieto del patriarca Esaú, hijo de Elifaz y jefe de los edomitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Temani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mjukuu wa patriarki Esau, mwana wa Elifazi, na kiongozi wa Waedomi."
        }
      ]
    },
    "apd": {
      "preferred_label": "تيمان",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد البطريرك عيسو، وابن أليفاز، وكان زعيم من زعماء الأدوميين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Smalbubu blong Esao, pikinini boe blong Elifas, mo wan jif blong ol laen blong Edom."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa nke nna ochie bụ Ịsọ, nwa Elifaz, na otu onye ndú nke ndị Idọm."
        }
      ]
    },
    "nep": {
      "preferred_label": "तेमान",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता एसावका नाति, एलीपजका छोरा, र एदोमीहरूका एक जना प्रधान।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuna pikinini bilong hetman Iso, pikinini man bilong Elifas, na wanpela hetman bilong ol lain Idom."
        }
      ]
    },
    "vie": {
      "preferred_label": "Thê-man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cháu nội của tổ phụ Ê-sau, con trai của Ê-li-pha, và là một thủ lĩnh của người Ê-đôm."
        }
      ]
    },
    "zht": {
      "preferred_label": "提幔",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長以掃的孫子、以利法的兒子，也是以東人的一位族長。"
        }
      ]
    }
  },
