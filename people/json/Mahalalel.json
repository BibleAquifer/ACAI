      "descriptions": [
        {
          "source": "acai",
          "gloss": "Mahalalel",
          "article": "person:Mahalalel",
          "description": "A son of Kenan and father of Jared. He is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَهْلَلْئِيلَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن قينان وأبو يارد، وهو مذكور في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "玛勒列",
      "descriptions": [
        {
          "source": "acai",
          "description": "该南的儿子，雅列的父亲。他被列入耶稣的家谱中。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Mahalalel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Kenan kuma mahaifin Yared. An lissafa shi a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "महललेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "केनान का पुत्र और येरेद का पिता। वह यीशु की वंशावली में सूचीबद्ध है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Mahalaleel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki Kenan dan ayah Yared. Ia terdaftar dalam silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Maalaleel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho de Cainã e pai de Jarede. Ele está listado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Малелеил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Каинана и отец Иареда. Он упомянут в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Mahalalel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Cainán y padre de Jared. Está incluido en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mahalaleli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Kenani na baba yake Yaredi. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mahalalel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Kenan na papa bilong Jaret. Nem bilong em i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "مهللئيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن قينان وأبو يارد، ومذكور في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mahalalel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Kenan mo papa blong Jared. Hem i stap long laen blong ol olfala bubu blong Jisas."
        }
      ]
    },
    "fra": {
      "preferred_label": "Mahalaleel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Kénan et père de Jéred. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mahalalel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Kenan na nna Jared. E denyere aha ya nʼusoro ọmụmụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "महलालेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "केनानका छोरा र येरेदका बुबा। उहाँको नाउँ येशूको वंशावलीमा सूचीकृत छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-ha-la-lê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Kê-nan và là cha của Gia-rết. Ông được liệt kê trong dòng dõi của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "瑪勒列",
      "descriptions": [
        {
          "source": "acai",
          "description": "該南的兒子，雅列的父親。他列在耶穌的家譜中。"
        }
      ]
    }
  },
