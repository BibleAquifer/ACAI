      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Perez",
          "article": "person:Perez",
          "description": "A son of Judah by Tamar, and brother to Zerah. He is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "فَارِص",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن يَهوذَا من ثَامَارَ، وأخو زارح. وهو مذكور في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "法勒斯",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大与她玛所生的儿子，谢拉的孪生兄弟。他被列在耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Pérets",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Juda et de Tamar, et frère de Zérach. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ferez",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Yahuda ta wurin Tamar, kuma ɗan’uwan Zera. An jera shi a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "पेरेस",
      "descriptions": [
        {
          "source": "acai",
          "description": "तामार से यहूदा का एक पुत्र और जेरह का भाई। वह यीशु की वंशावली में सूचीबद्ध है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Peres",
      "descriptions": [
        {
          "source": "acai",
          "description": "Putra Yehuda dari Tamar, dan saudara laki-laki Zerah. Ia terdaftar dalam garis keturunan Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Perez",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Judá com Tamar e irmão de Zerá. Ele é citado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Фарес",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Иуды от Фамари и брат Зары. Он включён в родословие Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Fares",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Judá y Tamar, y hermano de Zera. Está incluido en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Peresi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Yuda kwa Tamari, na nduguye Zera. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Peres",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Juda wantaim Tamar, na brata bilong Sera. Nem bilong en i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "فارص",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن يهوذا من ثامار، وأخو زارح. وهو مذكور في شجرة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Peres",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Juda wetem Tama, mo brata blong Sera. Nem blong hem i stap long laen blong ol bubu blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Perez",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke nke Juda mụrụ site na Tama, na nwanne Zera. E depụtara ya n'usoro ọmụmụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "फारेस",
      "descriptions": [
        {
          "source": "acai",
          "description": "तामारद्वारा जन्मेका यहूदाका छोरा र जेरहका भाइ। उनी येशूको वंशावलीमा सूचीकृत छन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Phê-rết",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của Giu-đa với Ta-ma, và là anh em của Xê-rách. Ông được liệt kê trong dòng dõi của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "法勒斯",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大與她瑪所生的兒子，謝拉的兄弟。他被列在耶穌的家譜中。"
        }
      ]
    }
  },
