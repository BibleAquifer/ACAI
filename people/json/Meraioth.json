        {
          "source": "acai",
          "gloss": "Meraioth",
          "article": "person:Meraioth",
          "description": "A son of Zerahiah and father of Amariah. He was a priest during the time of the divided kingdom."
        }
      ]
    },
    "fra": {
      "preferred_label": "Merajoth",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Zerachja et père d'Amaria. Il était prêtre à l'époque du royaume divisé."
        }
      ]
    },
    "spa": {
      "preferred_label": "Meraiot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Zeraías y padre de Amarías. Fue un sacerdote durante la época del reino dividido."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَرَايوث",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن زرحيا وأبو أمريا. كان كاهناً في زمن المملكة المنقسمة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "米拉约",
      "descriptions": [
        {
          "source": "acai",
          "description": "西拉希雅的儿子，亚玛利雅的父亲。他在王国分裂时期担任祭司。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Merahiyot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Zerahiya kuma mahaifin Amariya. Ya kasance firist a lokacin rabuwar mulki."
        }
      ]
    },
    "hin": {
      "preferred_label": "मरायोत",
      "descriptions": [
        {
          "source": "acai",
          "description": "जरहयाह का पुत्र और अमर्याह का पिता। वह विभक्त राज्य के समय एक याजक था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Merayot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Zeraya dan ayah Amarya. Dia adalah seorang imam pada zaman kerajaan terbagi."
        }
      ]
    },
    "por": {
      "preferred_label": "Meraiote",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Zeraías e pai de Amarias. Ele foi sacerdote durante o período do reino dividido."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мераиоф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Зерахии и отец Амарии. Он был священником во времена разделенного царства."
        }
      ]
    },
    "swh": {
      "preferred_label": "Merayothi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Zerahia na baba wa Amaria. Alikuwa kuhani wakati wa ufalme uliogawanyika."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Meraiot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Serahia na papa bilong Amaria. Em i bin stap pris long taim bilong kingdom i brok long tupela hap."
        }
      ]
    },
    "apd": {
      "preferred_label": "مرايوث",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن زرحيا وأبو أمريا. كان كاهن في زمن المملكة المنقسمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Meraeot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan boe blong Serahia mo papa blong Amaria. Hem i wan pris long taem we kingdom i seraot."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Meraiọt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Zeradaya na nna Amaraya. Ọ bụ onye nchụaja nʼoge alaeze kewara ekewa."
        }
      ]
    },
    "nep": {
      "preferred_label": "मरायोत",
      "descriptions": [
        {
          "source": "acai",
          "description": "जरयाहका छोरा र अमर्याहका पिता। तिनी विभाजित राज्यको समयका एक पुजारी थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Mê-ra-giốt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Xê-ra-hia và là cha của A-ma-ria. Ông là một thầy tế lễ trong thời kỳ vương quốc phân chia."
        }
      ]
    },
    "zht": {
      "preferred_label": "米拉約",
      "descriptions": [
        {
          "source": "acai",
          "description": "西拉希雅的兒子，亞瑪利雅的父親。他是王國分裂時期的祭司。"
        }
      ]
    }
  },
