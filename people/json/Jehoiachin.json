  "localizations": {
    "eng": {
      "preferred_label": "Jehoiachin",
      "alternate_labels": [
        "Jeconiah",
        "Jechonias",
        "Shallum",
        "Coniah",
        "Jechoniah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jehoiachin",
          "article": "person:Jehoiachin",
          "description": "A son of Jehoiakim by Nehushta and king of Judah during the divided kingdom. He is listed under the family line of Jesus in the New Testament."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَهُويَاكِينُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن يهوياقيم من نحوشتا وملك يهوذا في زمن المملكة المنقسمة. ورد اسمه في نسب يسوع في العهد الجديد."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约雅斤",
      "descriptions": [
        {
          "source": "acai",
          "description": "约雅敬与尼护施她所生的儿子，王国分裂时期的犹大王。在新约中被列入耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jojakin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Jojakim et de Nehuschtha, et roi de Juda à l’époque du royaume divisé. Il figure dans la généalogie de Jésus dans le Nouveau Testament."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yehohiyacin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Yehohiyakim ta wurin Nehushta kuma sarkin Yahuda a lokacin rarrabuwar masarauta. An jera shi a cikin layin zuriyar Yesu a Sabon Alkawari."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहोयाकीन",
      "descriptions": [
        {
          "source": "acai",
          "description": "नहुश्ता के द्वारा यहोयाकीम का पुत्र और विभाजित राज्य के दौरान यहूदा का राजा। नए नियम में उसका नाम यीशु की वंशावली में दर्ज है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yoyakhin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki Yoyakim dari Nehusta dan raja Yehuda pada masa kerajaan terpecah. Ia terdaftar dalam garis keturunan Yesus di Perjanjian Baru."
        }
      ]
    },
    "por": {
      "preferred_label": "Joaquim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Jeoaquim com Neústa e rei de Judá durante o reino dividido. Ele é listado na genealogia de Jesus no Novo Testamento."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иехония",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Иоакима от Нехушты и царь Иудеи во времена разделенного царства. Упоминается в родословии Иисуса в Новом Завете."
        }
      ]
    },
    "spa": {
      "preferred_label": "Joaquín",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Joacim y Nejusta, y rey de Judá durante el reino dividido. Aparece en la genealogía de Jesús en el Nuevo Testamento."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yehoyakini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Yehoyakimu kwa Nehushta na mfalme wa Yuda wakati wa ufalme uliogawanyika. Ameorodheshwa katika ukoo wa Yesu katika Agano Jipya."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jehoiakin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Jehoiakim wantaim Nehusta na em i wanpela king bilong Juda long taim bilong kingdom i bruk. Nem bilong em i stap long lain tumbuna bilong Jisas long Nupela Testamen."
        }
      ]
    },
    "apd": {
      "preferred_label": "يهوياكين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد يهوياقيم من نحوشتا وملك يهوذا في زمن المملكة المقسومة. هو مذكور في سلسلة نسب يسوع في العهد الجديد."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jehoeakin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan boe blong Jehoeakim wetem Nehustaha mo king blong Juda long taem blong kingdom we i seraot. Nem blong hem i stap long laen blong Jisas long Niu Testamen."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jehoiakin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke Jehoiakim site nʼaka Nehushta na eze Juda nʼoge alaeze kewara ekewa. E depụtara ya nʼagbụrụ Jisọs nʼime Agba Ọhụrụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "यहोयाकीन",
      "descriptions": [
        {
          "source": "acai",
          "description": "नहूश्ताद्वारा यहोयाकीमका छोरा र विभाजित राज्यको समयमा यहूदाका राजा। नयाँ नियममा उहाँलाई येशूको वंशावलीमा सूचीकृत गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giê-hô-gia-kin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Giê-hô-gia-kim với Nê-hu-ta và là vua của Giu-đa trong thời kỳ vương quốc phân chia. Ông được liệt kê trong dòng dõi của Chúa Giê-xu trong Tân Ước."
        }
      ]
    },
    "zht": {
      "preferred_label": "約雅斤",
      "descriptions": [
        {
          "source": "acai",
          "description": "約雅敬與尼護施她所生的兒子，王國分裂時期的猶大王。他在新約聖經中被列入耶穌的家譜。"
        }
      ]
    }
  },
