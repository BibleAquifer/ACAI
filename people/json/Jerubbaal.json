  "localizations": {
    "eng": {
      "preferred_label": "Jerubbaal (Gideon)",
      "alternate_labels": [
        "Gideon"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Gideon",
          "article": "person:Jerubbaal",
          "description": "A son of Joash the Abiezrite from the tribe of Manasseh, who served as a judge of Israel. He was father of Jether, Abimelech, and Jotham."
        }
      ]
    },
    "fra": {
      "preferred_label": "Jerubbaal (Gédéon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Yoash, l'Abiézerite, issu de la tribu de Manassé, qui fut juge d'Israël. Il était le père de Jéther, d'Abimélec et de Jotham."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jerobaal (Gedeón)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Joás el abiezerita, de la tribu de Manasés, que sirvió como juez de Israel. Fue padre de Jéter, Abimelec y Jotam."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَرُبَّعْل (جِدْعُون)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن يوآش الأبيعزري من سبط منسى، وقاضٍ من قضاة إسرائيل. وهو والد يَثَرَ وأبيمالك ويوثام."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耶路巴力 (基甸)",
      "descriptions": [
        {
          "source": "acai",
          "description": "玛拿西支派亚比以谢族人约阿施的儿子，曾作以色列的士师。他是益帖、亚比米勒和约坦的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yerub-Ba’al (Gideyon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Yowash mutumin Abiyezer daga kabilar Manasseh, wanda ya yi aiki a matsayin alkali na Isra’ila. Ya kasance uban Yeter, Abimelek, da Yotam."
        }
      ]
    },
    "hin": {
      "preferred_label": "यरूब्बाल (गिदोन)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मनश्शे के गोत्र से अबीएजेरी योआश का एक पुत्र, जिसने इस्राएल के न्यायी के रूप में कार्य किया। वह येतेर, अबीमेलेक और योताम का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yerubaal (Gideon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak Yoas, orang Abiezer dari suku Manasye, yang melayani sebagai hakim Israel. Ia adalah ayah dari Yeter, Abimelekh, dan Yotam."
        }
      ]
    },
    "por": {
      "preferred_label": "Jerubaal (Gideão)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Joás, o abiezrita, da tribo de Manassés, que serviu como juiz de Israel. Ele foi pai de Jéter, Abimeleque e Jotão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иероваал (Гедеон)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Иоаса, потомка Авиезерова, из колена Манассии, служивший судьей Израиля. Он был отцом Иефера, Авимелеха и Иофама."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yerub-baali (Gideoni)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Yoashi Mwabiezeri kutoka kabila la Manase, aliyetumika kama mwamuzi wa Israeli. Alikuwa baba wa Yetheri, Abimeleki, na Yothamu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jerubal (Gideon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Joas bilong lain Abieser bilong traip bilong Manase, em i bin stap hetman bilong Israel. Em i papa bilong Jeter, Abimelek, na Jotam."
        }
      ]
    },
    "apd": {
      "preferred_label": "يرُبَّعل (جدعون)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد يوآش الأبيعزري من سبط منسى، خدم كقاضي لإسرائيل. وكان أبو يثر، وأبيمالك، ويوثام."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jerubal (Gideon)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Joas we i man Abiesa blong laen blong Manase, we i bin mekem wok olsem wan jif jas blong Isrel. Hem i papa blong Jeter, Abimelek, mo Jotam."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jerub-Baal (Gidiọn)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke Joash onye Abieza nke sitere nʼebo Manase, onye rụrụ ọrụ dị ka onyeikpe nke Izrel. Ọ bụ nna Jeta, Abimelek, na Jotam."
        }
      ]
    },
    "nep": {
      "preferred_label": "यरूब-बाल (गिदोन)",
      "descriptions": [
        {
          "source": "acai",
          "description": "मनश्शे कुलका अबीएजेरी योआशका छोरा, जसले इस्राएलको न्यायकर्ताको रूपमा सेवा गरे। तिनी येथर, अबीमेलेक र योतामका बुबा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giê-ru-ba-anh (Ghi-đê-ôn)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Giô-ách người A-bi-ê-xe thuộc chi phái Ma-na-se, từng phục vụ với tư cách là quan xét của Y-sơ-ra-ên. Ông là cha của Giê-the, A-bi-mê-léc và Giô-tham."
        }
      ]
    },
    "zht": {
      "preferred_label": "耶路‧巴力（基甸）",
      "descriptions": [
        {
          "source": "acai",
          "description": "瑪拿西支派中亞比以謝族人約阿施的兒子，曾任以色列的士師。他是益帖、亞比米勒和約坦的父親。"
        }
      ]
    }
  },
