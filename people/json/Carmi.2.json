      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Carmi",
          "article": "person:Carmi.2",
          "description": "A son of the Reuben, the first-born son of the patriarch Jacob. He is also known as Karmi."
        }
      ]
    },
    "arb": {
      "preferred_label": "كَرْمِي",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن رَأوبَيْنَ، الابن البكر ليعقوب. يُعرَف أيضًا باسم كرمي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "迦米",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长雅各的长子吕便的儿子。他也被称为卡米（Karmi）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Carmi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Ruben, le fils premier-né du patriarche Jacob. Il est aussi connu sous le nom de Karmi."
        }
      ]
    },
    "hau": {
      "preferred_label": "Karmi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Ruben, ɗan fari na kakan nan Yaƙub. Wani lokaci ana kiransa da Karmi."
        }
      ]
    },
    "hin": {
      "preferred_label": "कर्मी",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता याकूब के पहलौठे पुत्र रूबेन का एक बेटा। उसे कर्मी के नाम से भी जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Karmi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Ruben, anak sulung bapa leluhur Yakub. Ia juga dikenal sebagai Karmi."
        }
      ]
    },
    "por": {
      "preferred_label": "Carmi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Rúben, o primogênito do patriarca Jacó. Ele também é conhecido como Karmi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Харми",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Рувима, первенца патриарха Иакова. Также известен как Карми."
        }
      ]
    },
    "spa": {
      "preferred_label": "Carmí",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Rubén, el hijo primogénito del patriarca Jacob. También se le conoce como Karmi."
        }
      ]
    },
    "swh": {
      "preferred_label": "Karmi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Reubeni, mzaliwa wa kwanza wa patriarki Yakobo. Pia anajulikana kama Karmi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Karmi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Ruben, namba wan pikinini man bilong tumbuna Jekop. Ol i save kolim em tu Karmi."
        }
      ]
    },
    "apd": {
      "preferred_label": "كرمي",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد لرأوبين، البكر ليعقوب. وبيتعرف كمان باسم كارمي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kami",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Ruben, we i fasbon pikinini boe blong stamba bubu Jekob. Oli save long hem tu olsem Karmi."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kami",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Ruben, bụ́ ọkpara nna ochie Jekọb. A na-akpọkwa ya Karmi."
        }
      ]
    },
    "nep": {
      "preferred_label": "कर्मी",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता याकूबका जेठा छोरा रूबेनका एक छोरा। तिनलाई कर्मी पनि भनिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Cát-mi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con trai của Ru-bên, con trưởng nam của tổ phụ Gia-cốp. Ông còn được gọi là Karmi."
        }
      ]
    },
    "zht": {
      "preferred_label": "迦米",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列先祖雅各的長子呂便的兒子。他也被稱為Karmi。"
        }
      ]
    }
  },
