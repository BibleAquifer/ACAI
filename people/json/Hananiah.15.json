  ],
  "localizations": {
    "eng": {
      "preferred_label": "Hananiah",
      "alternate_labels": [
        "Shadrach",
        "Azariah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hananiah",
          "article": "person:Hananiah.15",
          "description": "One of Daniel’s three friends who was thrown into a fiery furnace by the Babylonian king Nebuchadnezzar. An angel sent from God protected the three friends and they did not die."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَنَنْيَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "أحد رفقاء دانيآل الثلاثة الذين أُلقوا في أتون النار المتقدة على يد نبوخذنصر ملك بابل. أرسل الله ملاكًا فحماهم ولم يموتوا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈拿尼雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "但以理的三位朋友之一，曾被巴比伦王尼布甲尼撒扔进烈火的窑中。上帝差遣使者保护了这三位朋友，他们没有丧生。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Hanania",
      "descriptions": [
        {
          "source": "acai",
          "description": "L’un des trois compagnons de Daniel, jeté dans une fournaise ardente par le roi babylonien Nebucadnetsar. Un ange envoyé par Dieu protégea les trois compagnons, qui survécurent."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hananiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗaya daga cikin abokan Daniyel uku da sarkin Babilon Nebukadnezzar ya jefa a cikin tanderun wuta. Mala’ika da Allah ya aiko ya kāre abokan ukun kuma ba su mutu ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "हनन्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "दानिय्येल के तीन मित्रों में से एक जिसे बाबेल के राजा नबूकदनेस्सर द्वारा धधकते हुए भट्ठे में फेंक दिया गया था। परमेश्वर द्वारा भेजे गए एक दूत ने तीनों मित्रों की रक्षा की और वे नहीं मरे।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hananya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Salah satu dari tiga sahabat Daniel yang dicampakkan ke dalam perapian yang menyala-nyala oleh raja Babel, Nebukadnezar. Malaikat yang diutus Allah melindungi ketiga sahabat itu dan mereka tidak mati."
        }
      ]
    },
    "por": {
      "preferred_label": "Hananias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um dos três amigos de Daniel que foi lançado em uma fornalha ardente pelo rei babilônio Nabucodonosor. Um anjo enviado por Deus protegeu os três amigos, e eles não morreram."
        }
      ]
    },
    "rus": {
      "preferred_label": "Анания",
      "descriptions": [
        {
          "source": "acai",
          "description": "Один из трех друзей Даниила, брошенный вавилонским царем Навуходоносором в огненную печь. Ангел, посланный Богом, защитил трех друзей, и они не погибли."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hananías",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uno de los tres amigos de Daniel que fue arrojado a un horno de fuego ardiente por el rey babilonio Nabucodonosor. Un ángel enviado por Dios protegió a los tres amigos y no murieron."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hanania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmoja wa marafiki watatu wa Danieli aliyetupwa kwenye tanuru ya moto na Nebukadreza, mfalme wa Babeli. Malaika aliyetumwa kutoka kwa Mungu aliwalinda hao marafiki watatu nao hawakufa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hanania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bilong tripela poroman bilong Daniel em Nebukatnesar, king bilong Babilon, i bin tromoi em i go insait long bikpela paia. Wanpela ensel God i salim i lukautim dispela tripela poroman na ol i no dai."
        }
      ]
    },
    "apd": {
      "preferred_label": "حنانيا",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحد من أصحاب دانيال التلاتة اللي رماهم نبوخذنصر ملك بابل في أتون النار. وملاك مرسل من الله حما التلاتة أصحاب وما ماتوا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hanania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan long trifala fren blong Daniel we King Nebukadnesar blong Babilonia i sakem trifala i go insaed long wan bigfala faea. Wan enjel we God i sanem i protektem trifala fren ya mo trifala i no ded."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hananaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu n'ime ndị enyi atọ nke Daniel nke eze Babilọn bụ Nebukadneza tụbara n'ime ọkụ na-enwu gbaa. Mmụọ ozi sitere na Chineke chebere ndị enyi atọ ahụ, ha anwụghịkwa."
        }
      ]
    },
    "nep": {
      "preferred_label": "हनन्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "दानिएलका तीन साथीहरूमध्ये एक जसलाई बेबिलोनी राजा नबूकदनेसरले दन्किरहेको आगोको भट्टीमा हालेका थिए। परमेश्‍वरले पठाउनुभएको स्वर्गदूतले यी तीन साथीहरूको रक्षा गर्नुभयो र तिनीहरू मरेनन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-na-nia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một trong ba người bạn của Đa-ni-ên bị vua Ba-by-lôn là Nê-bu-cát-nê-xa ném vào lò lửa hừng. Một thiên sứ do Đức Chúa Trời sai đến đã bảo vệ ba người bạn và họ không chết."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈拿尼雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "但以理的三個朋友之一，被巴比倫王尼布甲尼撒扔進烈火的窯中。上帝差遣使者保護這三位朋友，他們並未喪命。"
        }
      ]
    }
  },
