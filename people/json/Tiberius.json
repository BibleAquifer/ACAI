    "ibo": {
      "preferred_label": "Tiberiọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye eze ukwu Rom nʼoge Jisọs. A makwaara ya dịka Nero."
        }
      ]
    },
    "nep": {
      "preferred_label": "तिबेरियस",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूको समयका एक रोमी सम्राट् । उनलाई निरो भनेर पनि चिनिन्छ ।"
        }
      ]
    },
    "vie": {
