          "gloss": "Tiberius",
          "article": "person:Tiberius",
          "description": "A Roman emperor during the time of Jesus. He is also known as Nero."
        }
      ]
    },
    "arb": {
      "preferred_label": "طِيبَارِيُوس",
      "descriptions": [
        {
          "source": "acai",
          "description": "إمبراطور روماني في زمن يسوع. يُعرف أيضًا باسم نيرون."
        }
      ]
    },
    "zhs": {
      "preferred_label": "提庇留",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶稣时代的罗马皇帝。他也称为尼禄。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Tibère",
      "descriptions": [
        {
          "source": "acai",
          "description": "Empereur romain à l'époque de Jésus. Il est également connu sous le nom de Néron."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tiberiyus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani sarkin Roma a zamanin Yesu. An kuma san shi da Nero."
        }
      ]
    },
    "hin": {
      "preferred_label": "तिबिरियुस",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु के समय का एक रोमी सम्राट। उसे नीरो के नाम से भी जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Tiberius",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang kaisar Romawi pada zaman Yesus. Ia juga dikenal sebagai Nero."
        }
      ]
    },
    "por": {
      "preferred_label": "Tibério",
      "descriptions": [
        {
          "source": "acai",
          "description": "Imperador romano durante a época de Jesus. Ele também é conhecido como Nero."
        }
      ]
    },
    "rus": {
      "preferred_label": "Тиверий",
      "descriptions": [
        {
          "source": "acai",
          "description": "Римский император времен Иисуса. Он также известен как Нерон."
        }
      ]
    },
    "spa": {
      "preferred_label": "Tiberio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Emperador romano durante la época de Jesús. También es conocido como Nerón."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tiberio",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kaisari wa Roma wakati wa Yesu. Pia anajulikana kama Nero."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Taiberius",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela empera bilong Rom long taim bilong Jisas. Narapela nem bilong em em Nero."
        }
      ]
    },
    "apd": {
      "preferred_label": "تيباريوس",
      "descriptions": [
        {
          "source": "acai",
          "description": "إمبراطور روماني في زمن يسوع. ومعروف كمان باسم نيرون."
