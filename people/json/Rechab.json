      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rechab",
          "article": "person:Rechab",
          "description": "A son of the Benajmite Rimmon and brother of Baanah who lived during the time of King Saul."
        }
      ]
    },
    "arb": {
      "preferred_label": "رَكَاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن رِمون البنياميني وأخو بعنة، عاش في زمن الملك شاول."
        }
      ]
    },
    "zhs": {
      "preferred_label": "利甲",
      "descriptions": [
        {
          "source": "acai",
          "description": "便雅悯人临门的儿子，巴拿的兄弟，生活在扫罗王时期。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Récab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du Benjamite Rimmon et frère de Baana ayant vécu à l’époque du roi Saül."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rekab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Rimmon mutumin Benyamin kuma ɗan’uwan Ba’ana wanda ya rayu a zamanin Sarki Shawulu."
        }
      ]
    },
    "hin": {
      "preferred_label": "रेकाब",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिन्यामीनी रिम्मोन का एक पुत्र और बानाह का भाई जो राजा शाऊल के समय में रहता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Rekhab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari Rimon, orang Benyamin, dan saudara laki-laki Baana yang hidup pada masa Raja Saul."
        }
      ]
    },
    "por": {
      "preferred_label": "Recabe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho do benjamita Rimom e irmão de Baaná, que viveu durante a época do rei Saul."
        }
      ]
    },
    "rus": {
      "preferred_label": "Рихав",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын вениамитянина Реммона и брат Бааны, живший во времена царя Саула."
        }
      ]
    },
    "spa": {
      "preferred_label": "Recab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del benjamita Rimmón y hermano de Baana que vivió durante la época del rey Saúl."
        }
      ]
    },
    "swh": {
      "preferred_label": "Rekabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Rimoni Mbenyamini na ndugu wa Baana aliyeishi wakati wa Mfalme Sauli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rekap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Rimon bilong lain Benjamin na brata bilong Bana em i bin stap long taim bilong King Sol."
        }
      ]
    },
    "apd": {
      "preferred_label": "ركاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد ريمون البنياميني وأخو بعنة، عاش في زمن الملك شاول."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rekab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Rimon we i man Benjamin, mo brata blong Bahanaha, we i bin laef long taem blong King Sol."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Rekab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke Rimọn onye Benjamin na nwanne Baana nke dịrị ndụ nʼoge Eze Sọl."
        }
      ]
    },
    "nep": {
      "preferred_label": "रेकाब",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा शाऊलको समयमा बाँचेका बेन्यामिनी रिम्मोनका छोरा र बानाहका भाइ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Rê-cáp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Rim-môn người Bên-gia-min và là anh em của Ba-a-na, sống vào thời Vua Sau-lơ."
        }
      ]
    },
    "zht": {
      "preferred_label": "利甲",
      "descriptions": [
        {
          "source": "acai",
          "description": "便雅憫人臨門的兒子，巴拿的兄弟，生活在掃羅王時期。"
        }
      ]
    }
  },
