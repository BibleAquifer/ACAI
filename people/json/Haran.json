  "localizations": {
    "eng": {
      "preferred_label": "Haran",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Haran",
          "article": "person:Haran",
          "description": "A son of Terah and brother of Abraham. He was the father of Lot, Milcah, and Iscah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Haran",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Térach et frère d'Abraham. Il était le père de Lot, Milca et Jisca."
        }
      ]
    },
    "spa": {
      "preferred_label": "Harán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Taré y hermano de Abraham. Fue padre de Lot, Milca e Isca."
        }
      ]
    },
    "arb": {
      "preferred_label": "هَارَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابْنُ تَارَحَ وَأَخُو إِبْرَاهِيمَ. كَانَ أَبَا لُوطٍ وَمِلْكَةَ وَيِسْكَةَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈兰",
      "descriptions": [
        {
          "source": "acai",
          "description": "他拉的儿子，亚伯拉罕的兄弟。他是罗得、密迦和亦迦的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Haran",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Tera kuma ɗan’uwan Ibrahim. Shi ne mahaifin Lot, Milka, da Iska."
        }
      ]
    },
    "hin": {
      "preferred_label": "हारान",
      "descriptions": [
        {
          "source": "acai",
          "description": "तेरह का एक पुत्र और अब्राहम का भाई। वह लूत, मिल्का और यिस्का का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Haran",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari Terah dan saudara laki-laki Abraham. Ia adalah ayah dari Lot, Milka, dan Yiska."
        }
      ]
    },
    "por": {
      "preferred_label": "Harã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Terá e irmão de Abraão. Foi pai de Ló, Milca e Iscá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аран",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Фарры и брат Авраама. Отец Лота, Милки и Иски."
        }
      ]
    },
    "swh": {
      "preferred_label": "Harani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Tera na ndugu ya Abrahamu. Alikuwa baba wa Lutu, Milka, na Iska."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Haran",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Tera na brata bilong Abraham. Em i papa bilong Lot, Milka, na Iska."
        }
      ]
    },
    "apd": {
      "preferred_label": "هاران",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن تارح وأخو إبراهيم. كان أبو لوط وملكة ويسكة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Haran",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Tera mo brata blong Ebraham. Hem i papa blong Lot, Milka, mo Jiskaha."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Haran",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Tera na nwanne Ebraham. Ọ bụ nna Lọt, Milka, na Iska."
        }
      ]
    },
    "nep": {
      "preferred_label": "हारान",
      "descriptions": [
        {
          "source": "acai",
          "description": "तेरहका छोरा र अब्राहामका भाइ। तिनी लोत, मिल्का र यिस्काका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-ran",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Tha-rê và là anh em của Áp-ra-ham. Ông là cha của Lót, Minh-ca và Ích-ca."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈蘭",
      "descriptions": [
        {
          "source": "acai",
          "description": "他拉的兒子，亞伯拉罕的兄弟。他是羅得、密迦和亦迦的父親。"
        }
      ]
    }
  },
