  "localizations": {
    "eng": {
      "preferred_label": "Abram (Abraham)",
      "alternate_labels": [
        "Abraham"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Abraham",
          "article": "person:Abram",
          "description": "The first patriarch of Israel, later named Abraham. Husband of Sarah, Hagar, and Keturah, and father of Ishmael, Isaac, and other sons."
        }
      ]
    },
    "fra": {
      "preferred_label": "Abram (Abraham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Premier patriarche d'Israël, nommé plus tard Abraham. Époux de Sara, Agar et Ketura, et père d'Ismaël, Isaac et d'autres fils."
        }
      ]
    },
    "spa": {
      "preferred_label": "Abram (Abraham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Primer patriarca de Israel, llamado más tarde Abraham. Esposo de Sara, Agar y Cetura, y padre de Ismael, Isaac y otros hijos."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَبْرَام (إِبْرَاهِيمَ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "أول آباء إسرائيل، دُعي لاحقًا إبراهيم. وهو زوج سارة وهاجر وقطورة، وأبو إسماعيل وإسحاق وبنين آخرين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚伯兰 (亚伯拉罕)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列的第一位先祖，后来改名为亚伯拉罕。撒拉、夏甲和基土拉的丈夫，以实玛利、以撒及其他儿子的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Abram (Ibrahim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uban iyali na farko na Isra’ila, wanda daga baya aka kira Ibrahim. Mijin Saratu, Hagar, da Ketura, kuma mahaifin Ishmayel, Ishaku, da sauran ’ya’ya maza."
        }
      ]
    },
    "hin": {
      "preferred_label": "अब्राम (अब्राहम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएल का पहला कुलपिता, जिसका नाम बाद में अब्राहम रखा गया। सारा, हागार और कतूरा का पति, तथा इश्माएल, इसहाक और अन्य पुत्रों का पिता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Abram (Abraham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bapa leluhur pertama Israel, yang kemudian dinamai Abraham. Suami dari Sara, Hagar, dan Ketura, serta ayah dari Ismael, Ishak, dan anak-anak lainnya."
        }
      ]
    },
    "por": {
      "preferred_label": "Abrão (Abraão)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O primeiro patriarca de Israel, mais tarde chamado de Abraão. Marido de Sara, Hagar e Quetura, e pai de Ismael, Isaque e outros filhos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аврам (Авраам)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первый патриарх Израиля, позже названный Авраамом. Муж Сарры, Агари и Хеттуры, а также отец Исмаила, Исаака и других сыновей."
        }
      ]
    },
    "swh": {
      "preferred_label": "Abramu (Abrahamu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Patriarki wa kwanza wa Israeli, baadaye akaitwa Abrahamu. Mume wa Sara, Hajiri, na Ketura, na baba wa Ishmaeli, Isaka, na wana wengine."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Abram (Abraham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nambawan bikpela tumbuna man bilong Israel, bihain ol i kolim em Abraham. Man bilong Sara, Hagar, na Ketura, na papa bilong Ismael, Aisak, na sampela arapela pikinini man."
        }
      ]
    },
    "apd": {
      "preferred_label": "أبرام (إبراهيم)",
      "descriptions": [
        {
          "source": "acai",
          "description": "أول الآباء لإسرائيل، بعدين اتسمى إبراهيم. زوج سارة وهاجر وقطورة، وأبو إسماعيل وإسحاق وأولاد تانيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ebram (Ebraham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fas patriake blong Isrel, we biaen nem blong hem Ebraham. Man blong Sera, Hega, mo Ketura, mo papa blong Ismael, Aeseak, mo ol narafala boe."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebram (Ebraham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nna nna mbụ nke Izrel, nke e mesịrị kpọọ Ebraham. Di Sera, Hega, na Ketura, na nna Ishmael, Aịzik, na ụmụ ndị ọzọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "अब्राम (अब्राहाम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलका पहिलो धर्मपिता, जसको पछिल्लो नाउँ अब्राहाम राखियो। सारा, हागार र कतूराका पति, तथा इश्माएल, इसहाक र अन्य छोराहरूका पिता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Áp-ram (Áp-ra-ham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tổ phụ đầu tiên của Y-sơ-ra-ên, về sau được đổi tên thành Áp-ra-ham. Chồng của Sa-ra, Ha-ga và Kê-tu-ra, và là cha của Ích-ma-ên, Y-sác cùng những người con trai khác."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞伯蘭（亞伯拉罕）",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列的第一位先祖，後來得名亞伯拉罕。撒拉、夏甲和基土拉的丈夫，以實瑪利、以撒及其他兒子的父親。"
        }
      ]
    }
  },
