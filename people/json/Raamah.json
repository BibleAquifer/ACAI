      "descriptions": [
        {
          "source": "acai",
          "gloss": "Raamah",
          "article": "person:Raamah",
          "description": "Grandson of the patriarch ham, a son of Cush, and father of Sheba and Dedan."
        }
      ]
    },
    "arb": {
      "preferred_label": "رَعْمَةُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "حَفِيدُ حَامَ، وَٱبْنُ كُوشَ، وَأَبُو سَبَا وَدَدَانَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拉玛",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖含的孙子，古实的儿子，示巴和底但的父亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Raema",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit-fils du patriarche Cham, fils de Cusch et père de Séba et Dedan."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ra’ama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jikan uban iyali Ham, ɗan Kush, kuma uban Sheba da Dedan."
        }
      ]
    },
    "hin": {
      "preferred_label": "रामाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता हाम का पोता, कूश का पुत्र, और शेबा और ददान का पिता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Raema",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cucu dari bapa leluhur Ham, anak Kusy, dan ayah dari Syeba dan Dedan."
        }
      ]
    },
    "por": {
      "preferred_label": "Raamá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neto do patriarca Cam, filho de Cuxe e pai de Sebá e Dedã."
        }
      ]
    },
    "rus": {
      "preferred_label": "Раама",
      "descriptions": [
        {
          "source": "acai",
          "description": "Внук патриарха Хама, сын Хуша и отец Шевы и Дедана."
        }
      ]
    },
    "spa": {
      "preferred_label": "Raama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nieto del patriarca Cam, hijo de Cus y padre de Sabá y Dedán."
        }
      ]
    },
    "swh": {
      "preferred_label": "Raama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mjukuu wa patriarki Hamu, mwana wa Kushi, na baba ya Sheba na Dedani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuna pikinini bilong bikpela man Ham, wanpela pikinini man bilong Kus, na papa bilong Seba na Dedan."
        }
      ]
    },
    "apd": {
      "preferred_label": "رعمة",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد حام، وولد كوش، وأبو سبا وددان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ramaha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grapapa blong hem i Ham, mo hem i pikinini boe blong Kus, mo papa blong Seba wetem Dedan."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Raama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa nke nna ochie bụ Ham, nwa Kush, na nna Sheba na Dedan."
        }
      ]
    },
    "nep": {
      "preferred_label": "रामाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता हामका नाति, कूशका छोरा, र शेबा अनि ददानका पिता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ra-ma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cháu nội của tổ phụ Cham, con trai của Cút, và là cha của Sê-ba và Đê-đan."
        }
      ]
    },
    "zht": {
      "preferred_label": "拉瑪",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長含的孫子，古實的兒子，示巴和底但的父親。"
        }
      ]
    }
  },
