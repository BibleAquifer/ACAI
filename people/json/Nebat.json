  "localizations": {
    "eng": {
      "preferred_label": "Nebat",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Nebat",
          "article": "person:Nebat",
          "description": "Husband of Zeruah and father of King Jeroboam, who became the first king of the northern kingdom of Israel."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَبَاط",
      "descriptions": [
        {
          "source": "acai",
          "description": "زوج صَروعَة ووالد الملك يَربْعَام، الذي أصبح أول ملوك مملكة إسرائيل الشمالية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "尼八",
      "descriptions": [
        {
          "source": "acai",
          "description": "洗鲁阿的丈夫，也是北国以色列第一任君王耶罗波安王的父亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Nebath",
      "descriptions": [
        {
          "source": "acai",
          "description": "Époux de Tserua et père du roi Jéroboam, qui devint le premier roi du royaume du Nord (Israël)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Nebat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mijin Zeruwa kuma mahaifin Sarki Yerobowam, wanda ya zama sarki na farko na masarautar arewa ta Isra'ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "नबात",
      "descriptions": [
        {
          "source": "acai",
          "description": "सरूआह का पति और राजा यारोबाम का पिता, जो इस्राएल के उत्तरी राज्य का पहला राजा बना।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Nebat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suami dari Zerua dan ayah dari Raja Yerobeam, yang menjadi raja pertama kerajaan utara Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Nebate",
      "descriptions": [
        {
          "source": "acai",
          "description": "Marido de Zerua e pai do rei Jeroboão, que se tornou o primeiro rei do reino do norte de Israel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Нават",
      "descriptions": [
        {
          "source": "acai",
          "description": "Муж Церуа и отец царя Иеровоама, ставшего первым царем северного царства Израиля."
        }
      ]
    },
    "spa": {
      "preferred_label": "Nabat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esposo de Serva y padre del rey Jeroboam, quien llegó a ser el primer rey del reino del norte de Israel."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nebati",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mume wa Serua na baba wa Mfalme Yeroboamu, aliyekuwa mfalme wa kwanza wa ufalme wa kaskazini wa Israeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Nebat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man bilong Serua na papa bilong King Jeroboam, em man i bin kamap namba wan king bilong not kingdom bilong Israel."
        }
      ]
    },
    "apd": {
      "preferred_label": "نباط",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل صروعة وأبو الملك يربغام، الكان أول ملك لمملكة إسرائيل الشمالية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Nebat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man blong Jerua mo papa blong King Jeroboam we i kam fas king blong not kingdom blong Isrel."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nebat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Di Zerua na nna Eze Jeroboam, onye ghọrọ eze mbụ nke alaeze ugwu nke Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "नबात",
      "descriptions": [
        {
          "source": "acai",
          "description": "सेरूआका पति र राजा यारोबामका पिता, जो इस्राएलको उत्तरी राज्यका पहिलो राजा बने।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Nê-bát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chồng của Xê-ru-a và là cha của Vua Giê-rô-bô-am, người đã trở thành vị vua đầu tiên của vương quốc phía bắc Y-sơ-ra-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "尼八",
      "descriptions": [
        {
          "source": "acai",
          "description": "洗魯阿的丈夫，也是北國以色列第一位國王耶羅波安王的父親。"
        }
      ]
    }
  },
