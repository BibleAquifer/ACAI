        }
      ]
    },
    "hin": {
      "preferred_label": "मरियम (बैतनिय्याह की)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु की एक सखी, तथा बैतनिय्याह के मार्था और लाज़र की बहन।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Maria (dari Betania)",
      "descriptions": [
        {
          "source": "acai",
