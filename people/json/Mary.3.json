      ]
    },
    "tpi": {
      "preferred_label": "Maria (bilong Betani)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pren bilong Jisas, na susa bilong Marta na Lasarus bilong Betani."
        }
      ]
    },
    "apd": {
      "preferred_label": "مريم (بيت عنيا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "صاحبة ليسوع، وأخت مرثا ولعازر من بيت عنيا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Meri (blong Betani)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan fren blong Jisas, mo sista blong Mata wetem Lasaros blong Betani."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Meri (onye Betani)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Enyi Jisọs, na nwanne Mata na Lazarọs si Betani."
        }
      ]
    },
    "nep": {
      "preferred_label": "मरियम (बेथानियाकी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूकी एक मित्र, र बेथानियाका मार्था र लाजरसकी बहिनी।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-ri (ở Bê-tha-ni)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người bạn của Chúa Giê-xu, là chị/em của Ma-thê và La-xa-rơ ở Bê-tha-ni."
        }
      ]
    },
    "zht": {
      "preferred_label": "馬利亞（伯大尼）",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶穌的朋友，也是伯大尼的馬大和拉撒路的妹妹。"
        }
      ]
    }
