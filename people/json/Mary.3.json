      "descriptions": [
        {
          "source": "acai",
          "description": "صَدِيقَةٌ لِيَسُوعَ، وَأُخْتُ مَرْثَا وَلِعَازَرَ مِنْ بَيْتِ عَنْيَا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "马利亚（伯大尼）",
      "descriptions": [
        {
