        }
      ]
    },
    "por": {
      "preferred_label": "Maria (de Betânia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Amiga de Jesus e irmã de Marta e Lázaro, de Betânia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мария (из Вифании)",
      "descriptions": [
        {
          "source": "acai",
