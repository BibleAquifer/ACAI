  "localizations": {
    "eng": {
      "preferred_label": "Mareshah",
      "alternate_labels": [
        "Mesha"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Mareshah",
          "article": "person:Mareshah",
          "description": "A man of the tribe of Judah during the time of Egypt and the wilderness, son of Caleb, and father of Ziph and Hebron."
        }
      ]
    },
    "fra": {
      "preferred_label": "Maréscha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Homme de la tribu de Juda à l'époque de l'Égypte et du désert, fils de Caleb, et père de Ziph et d'Hébron."
        }
      ]
    },
    "spa": {
      "preferred_label": "Maresa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre de la tribu de Judá durante el tiempo de Egipto y el desierto, hijo de Caleb y padre de Zif y Hebrón."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَرِيشَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل من سبط يهوذا في زمن مصر والبرية، وهو ابن كالب، وأبو زيف وحبرون."
        }
      ]
    },
    "zhs": {
      "preferred_label": "玛利沙",
      "descriptions": [
        {
          "source": "acai",
          "description": "埃及和旷野时期的犹大支派男子，迦勒的儿子，西弗和希伯伦的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Maresha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutumin kabilar Yahuda a zamanin Masar da hamada, ɗan Kaleb, kuma mahaifin Zifa da Hebron."
        }
      ]
    },
    "hin": {
      "preferred_label": "मारेशा",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिस्र और जंगल के समय के दौरान यहूदा के गोत्र का एक पुरुष, कालेब का पुत्र, और जीप व हेब्रोन का पिता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Maresa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang laki-laki dari suku Yehuda pada masa Mesir dan padang gurun, anak Kaleb, dan ayah dari Zif dan Hebron."
        }
      ]
    },
    "por": {
      "preferred_label": "Maressa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Homem da tribo de Judá durante a época do Egito e do deserto, filho de Calebe e pai de Zife e Hebrom."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мареша",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек из колена Иуды времен пребывания в Египте и странствования по пустыне, сын Халева и отец Зифа и Хеврона."
        }
      ]
    },
    "swh": {
      "preferred_label": "Maresha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamume wa kabila la Yuda wakati wa Misri na jangwani, mwana wa Kalebu, na baba yao Zifu na Hebroni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Maresa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong lain bilong Juda long taim bilong Isip na long ples drai nating, pikinini man bilong Kalep, na papa bilong Sif na Hebron."
        }
      ]
    },
    "apd": {
      "preferred_label": "مريشة",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل من سبط يهوذا في زمن مصر والبرية، ولد كالب، وأبو زيف وحبرون."
        }
      ]
    },
    "bis": {
      "preferred_label": "Maresa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man blong laen blong Juda long taem blong Isip mo draeples, pikinini boe blong Keleb, mo papa blong Sif mo Hebron."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Maresha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke nke ebo Juda n'oge Ijipt na ọzara, nwa Kaleb, na nna Zif na Hebrọn."
        }
      ]
    },
    "nep": {
      "preferred_label": "मारेशा",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिश्र र उजाड-स्थानको समयका यहूदा कुलका एक व्यक्ति, कालेबका छोरा, र जीप तथा हेब्रोनका पिता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-rê-sa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người thuộc bộ tộc Giu-đa trong thời kỳ ở Ai Cập và đồng vắng, con trai của Ca-lép, và là cha của Xíp và Hếp-rôn."
        }
      ]
    },
    "zht": {
      "preferred_label": "瑪利沙",
      "descriptions": [
        {
          "source": "acai",
          "description": "在埃及和曠野時期猶大支派的一名男子，是迦勒的兒子，也是西弗和希伯崙之祖。"
        }
      ]
    }
  },
