  "localizations": {
    "eng": {
      "preferred_label": "Hilkiah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hilkiah",
          "article": "person:Hilkiah.2",
          "description": "The high priest living during the reign of King Josiah, who found the book of the Law. He was a son of Shallum and the father of Azariah and Gemariah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Hilkija",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le souverain sacrificateur ayant vécu sous le règne du roi Josias, qui trouva le livre de la Loi. Il était fils de Schallum et père d'Azaria et de Guemaria."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hilcías",
      "descriptions": [
        {
          "source": "acai",
          "description": "El sumo sacerdote que vivió durante el reinado del rey Josías y encontró el libro de la ley. Era hijo de Sallum y padre de Azarías y Gemarías."
        }
      ]
    },
    "arb": {
      "preferred_label": "حِلْقِيَّا",
      "descriptions": [
        {
          "source": "acai",
          "description": "رَئيسُ الكَهَنَةِ الَّذي عاشَ في عَهدِ المَلِكِ يُوشِيَّا، وهوَ الَّذي وَجَدَ سِفرَ الشَّريعَةِ. كانَ ابنَ شَلّوم وأبا عَزَرْيَا وجَمَرْيَا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "希勒家",
      "descriptions": [
        {
          "source": "acai",
          "description": "约西亚王统治时期的大祭司，他发现了律法书。他是沙龙的儿子，亚撒利雅和基玛利雅的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hilkiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban firist ne da ya rayu a zamanin mulkin Sarki Yosiya, wanda ya sami littafin Doka. Shi ɗan Shallum ne kuma mahaifin Azariya da Gemariya."
        }
      ]
    },
    "hin": {
      "preferred_label": "हिल्किय्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा योशिय्याह के शासनकाल के समय का महायाजक, जिसे व्यवस्था की पुस्तक मिली। वह शल्लूम का पुत्र तथा अजर्याह और गमर्याह का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hilkia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Imam besar yang hidup pada masa pemerintahan Raja Yosia, yang menemukan kitab Taurat. Ia adalah anak dari Salum dan ayah dari Azarya serta Gemarya."
        }
      ]
    },
    "por": {
      "preferred_label": "Hilquias",
      "descriptions": [
        {
          "source": "acai",
          "description": "O sumo sacerdote que viveu durante o reinado do rei Josias e encontrou o Livro da Lei. Ele era filho de Salum e pai de Azarias e Gemarias."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хелкия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первосвященник, живший во время правления царя Иосии и нашедший книгу Закона. Он был сыном Шаллума и отцом Азарии и Гемарии."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hilkia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhani mkuu aliyeishi wakati wa utawala wa Mfalme Yosia, aliyekipata kile kitabu cha Sheria. Alikuwa mwana wa Shalumu na baba yake Azaria na Gemaria."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hilkia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nambawan hetpris i bin stap long taim bilong King Josaia, em man i bin painim buk bilong Lo. Em i pikinini man bilong Salum na papa bilong Asaria na Gemaria."
        }
      ]
    },
    "apd": {
      "preferred_label": "حلقيا",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيس الكهنة الكان عايش في عهد الملك يوشيا، وهو اللقى سفر الشريعة. كان ابن شلوم وأبو عزريا وجمريا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hilkia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hae pris we i laef long taem we King Josaea i rul, we i faenem buk blong Loa. Hem i wan pikinini man blong Salum mo papa blong Asaria mo Gemaria."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hilkaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyeisi nchụaja biri ndụ nʼoge ọchịchị Eze Josaya, bụ onye chọtara akwụkwọ Iwu ahụ. Ọ bụ nwa Shalụm ma bụrụkwa nna Azaraya na Gemaraya."
        }
      ]
    },
    "nep": {
      "preferred_label": "हिल्कियाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा योशियाहको शासनकालमा सेवा गर्ने प्रधान पुजारी, जसले व्यवस्थाको पुस्तक भेट्टाएका थिए। उनी शल्लूमका छोरा तथा अजर्याह र गमर्याहका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hinh-kia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thầy tế lễ thượng phẩm sống dưới triều vua Giô-si-a, người đã tìm thấy sách Luật pháp. Ông là con trai của Sa-lum và là cha của A-xa-ria cùng Ghê-ma-ria."
        }
      ]
    },
    "zht": {
      "preferred_label": "希勒家",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在約西亞王統治時期的大祭司，他發現了律法書。他是沙龍的兒子，也是亞撒利雅和基瑪利雅的父親。"
        }
      ]
    }
  },
