  "localizations": {
    "eng": {
      "preferred_label": "Baasha",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Baasha",
          "article": "person:Baasha",
          "description": "A king of the northern kingdom of Israel during the divided kingdom. He was a son of Ahijah, from the tribe of Isaachar."
        }
      ]
    },
    "fra": {
      "preferred_label": "Baescha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi du royaume du Nord (Israël) à l'époque du royaume divisé. Fils d'Achija, de la tribu d'Issacar."
        }
      ]
    },
    "spa": {
      "preferred_label": "Baasa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey del reino del norte de Israel durante el reino dividido. Era hijo de Ahías, de la tribu de Isacar."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَعْشَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك لمملكة إسرائيل الشمالية في عهد المملكة المنقسمة. كان ابن أخيا من سبط يساكر."
        }
      ]
    },
    "zhs": {
      "preferred_label": "巴沙",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期北国以色列的一位国王。他是以萨迦支派亚希雅的儿子。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ba’asha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin masarautar arewa ta Isra’ila a lokacin rarrabuwar masarauta. Shi ɗan Ahiya ne, daga kabilar Issakar."
        }
      ]
    },
    "hin": {
      "preferred_label": "बाशा",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के दौरान इस्राएल के उत्तरी राज्य का एक राजा। वह इस्साकार के गोत्र से अहिय्याह का पुत्र था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Baesa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Raja kerajaan utara Israel pada masa kerajaan terpecah. Ia adalah anak Ahia, dari suku Isakhar."
        }
      ]
    },
    "por": {
      "preferred_label": "Baasa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rei do reino do norte de Israel durante o período do reino dividido. Era filho de Aías, da tribo de Issacar."
        }
      ]
    },
    "rus": {
      "preferred_label": "Вааса",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь северного царства Израиля в период разделенного царства. Сын Ахии из колена Иссахара."
        }
      ]
    },
    "swh": {
      "preferred_label": "Baasha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa ufalme wa kaskazini wa Israeli wakati wa ufalme uliogawanyika. Alikuwa mwana wa Ahiya, kutoka kabila la Isakari."
        }
      ]
    },
    "apd": {
      "preferred_label": "بعشا",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك على مملكة إسرائيل الشمالية في زمن انقسام المملكة. كان ابن أخيا من قبيلة يساكر."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bahasa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong not kingdom blong Isrel long taem we kingdom i seraot. Hem i wan boe blong Ahia, we i laen blong Isakar."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Baasha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze nke alaeze ugwu nke Izrel nʼoge alaeze kewara ekewa. Ọ bụ nwa Ahija, onye si nʼebo Isaka."
        }
      ]
    },
    "nep": {
      "preferred_label": "बाशा",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा इस्राएलको उत्तरी राज्यका एक राजा। तिनी इस्साकार कुलका अहियाहका छोरा थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Basa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela king bilong not kingdom bilong Israel long taim kingdom i bruk. Em i wanpela pikinini man bilong Ahiya, bilong lain Isakar."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ba-ê-sa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vị vua của vương quốc phía bắc Y-sơ-ra-ên trong thời kỳ vương quốc phân chia. Ông là con trai của A-hi-gia, thuộc bộ tộc Y-sa-ca."
        }
      ]
    },
    "zht": {
      "preferred_label": "巴沙",
      "descriptions": [
        {
          "source": "acai",
          "description": "分裂王國時期以色列北國的一位國王。他是以薩迦支派亞希雅的兒子。"
        }
      ]
    }
  },
