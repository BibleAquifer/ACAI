  "tribe": "group:Syria",
  "localizations": {
    "eng": {
      "preferred_label": "Naaman",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Naaman",
          "article": "person:Naaman.3",
          "description": "A Syrian commander who was healed of leprosy by the Prophet Elisha during the time of the divided kingdom of Israel."
        }
      ]
    },
    "arb": {
      "preferred_label": "نُعْمَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "قائد جيش أرامي شُفي من البرص على يد النبي أليشع في زمن مملكة إسرائيل المنقسمة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "乃缦",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列分裂王国时期的一位叙利亚军长，曾被先知以利沙医好了麻风病。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Naaman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chef de l'armée syrienne qui fut guéri de la lèpre par le prophète Élisée à l'époque du royaume divisé d'Israël."
        }
      ]
    },
    "hau": {
      "preferred_label": "Na’aman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban hafsan sojan ƙasar Suriya wanda Annabi Elisha ya warkar da shi daga kuturta a lokacin mulkin rabuwar masarautar Isra’ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "नामान",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक सीरियाई (अरामी) सेनापति जिसे इस्राएल के विभाजित राज्य के समय भविष्यद्वक्ता एलीशा द्वारा कोढ़ से चंगा किया गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Naaman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang panglima Aram yang disembuhkan dari kusta oleh Nabi Elisa pada zaman kerajaan Israel yang terbagi."
        }
      ]
    },
    "por": {
      "preferred_label": "Naamã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um comandante sírio que foi curado de lepra pelo profeta Eliseu durante a época do reino dividido de Israel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Нееман",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сирийский военачальник, исцеленный от проказы пророком Елисеем во времена разделенного царства Израиля."
        }
      ]
    },
    "spa": {
      "preferred_label": "Naamán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un comandante sirio que fue sanado de lepra por el profeta Eliseo durante el tiempo del reino dividido de Israel."
        }
      ]
    },
    "swh": {
      "preferred_label": "Naamani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jemadari wa jeshi la Shamu aliyeponywa ukoma na Nabii Elisha wakati wa ufalme uliogawanyika wa Israeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Naman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ofisa bilong ami bilong Siria em profet Elisa i bin mekim sik lepra bilong en i pinis long taim ol lain bilong Israel i bin bruknap long tupela kingdom."
        }
      ]
    },
    "apd": {
      "preferred_label": "نعمان",
      "descriptions": [
        {
          "source": "acai",
          "description": "قائد جيش سوري طاب من مرض البرص على يد النبي إليشع في زمن مملكة إسرائيل المنقسمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Neman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan komanda blong ol soldia blong Siria we Profet Elisa i mekem rabis sik blong skin blong hem i kam gud bakegen long taem we kingdom blong Isrel i hafhaf."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Neeman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọchịagha ndị Siria nke Ịlaisha onye amụma gwọrọ ekpenta nʼoge alaeze Izrel kewara ekewa."
        }
      ]
    },
    "nep": {
      "preferred_label": "नामान",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलको विभाजित राज्यको समयमा अगमवक्ता एलीशाद्वारा कुष्ठरोगबाट निको पारिएका एक सिरियाली सेनापति।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Na-a-man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vị tướng chỉ huy người Sy-ri (A-ram) đã được Tiên tri Ê-li-sê chữa khỏi bệnh phong hủi trong thời kỳ vương quốc Y-sơ-ra-ên phân chia."
        }
      ]
    },
    "zht": {
      "preferred_label": "乃縵",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞蘭的一位元帥，在以色列王國分裂時期由先知以利沙治好了大痲瘋。"
        }
      ]
    }
  },
