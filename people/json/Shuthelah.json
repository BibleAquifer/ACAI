  "localizations": {
    "eng": {
      "preferred_label": "Shuthelah",
      "alternate_labels": [
        "Shuthelahite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shuthelah",
          "article": "person:Shuthelah",
          "description": "A son of the patriarch Ephraim and father of Eran and Bered. He was founder of the clan of the Shuthelahites."
        }
      ]
    },
    "arb": {
      "preferred_label": "شوتالح",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابنٌ لأفرايم وأبو عيران وبرد. كان مؤسس عشيرة الشوتالحيين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "书提拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖以法莲的儿子，以兰和巴列的父亲。他是书提拉族的始祖。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Schutélach",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Éphraïm et père d'Éran et de Bèred. Il fut le fondateur du clan des Schutalchites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shutela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan kakan nan Efraim kuma mahaifin Eran da Bered. Shi ne ya kafa kabilar Shutelawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "शूतेलह",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता एप्रैम का एक पुत्र और एरान व बेरेद का पिता। वह शूतेलहियों के कुल का संस्थापक था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Sutelah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak dari bapa leluhur Efraim dan ayah dari Eran dan Bered. Ia adalah pendiri kaum orang Sutelah."
        }
      ]
    },
    "por": {
      "preferred_label": "Sutela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho do patriarca Efraim e pai de Erã e Berede. Foi o fundador do clã dos sutelaítas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Шутелах",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Ефрема и отец Арана и Береда. Основатель рода шутелахитян."
        }
      ]
    },
    "spa": {
      "preferred_label": "Sutela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Efraín y padre de Herán y Bered. Fue fundador del clan de los sutelaítas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shuthela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa mzee wa ukoo Efraimu na baba ya Erani na Beredi. Alikuwa mwanzilishi wa ukoo wa Washuthela."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sutela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong tumbuna Efraim na papa bilong Eran na Beret. Em i tumbuna bilong lain Sutela."
        }
      ]
    },
    "apd": {
      "preferred_label": "شوتالح",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن البطريرك أفرايم وأبو عيران وبرد. وهو كان مؤسس عشيرة الشوتالحيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sutela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong patriaka Efrem mo papa blong Eran mo Bered. Hem i stamba blong laen blong ol man Sutela."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shutela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nke nna ochie Ifrem na nna Eran na Bered. Ọ bụ onye guzobere ikwu ndị Shutela."
        }
      ]
    },
    "nep": {
      "preferred_label": "शूतेलह",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता एफ्राइमका छोरा र एरान तथा बेरेदका पिता। उनी शूतेलहीहरूका कुलका संस्थापक थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Su-tê-la",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con trai của tổ phụ Ép-ra-im và là cha của Ê-ran cùng Bê-re. Ông là người sáng lập thị tộc người Su-thê-lách."
        }
      ]
    },
    "zht": {
      "preferred_label": "書提拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長以法蓮的兒子，以蘭和比列的父親。他是書提拉族的始祖。"
        }
      ]
    }
  },
