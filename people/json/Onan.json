        {
          "source": "acai",
          "gloss": "Onan",
          "article": "person:Onan",
          "description": "A son of the patriarch Judah by the Canaanite Shua and brother of Er, Onan, Shelah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Onan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Juda par la Cananéenne Shoua, et frère d’Er et de Schéla."
        }
      ]
    },
    "spa": {
      "preferred_label": "Onán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Judá con la cananea Bat-súa y hermano de Er y Sela."
        }
      ]
    },
    "arb": {
      "preferred_label": "أُونَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن لبطريرك يهوذا من الكنعانية بنت شوع، وشقيق عير وشيلة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "俄南",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长犹大与迦南人书亚所生的儿子，是珥的弟弟、示拉的哥哥。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Onan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan uban iyali Yahuda ta wurin Bat-shuwa mutuniyar Kan’ana, kuma ɗan’uwan Er da Shela."
        }
      ]
    },
    "hin": {
      "preferred_label": "ओनान",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनानी शूआ से उत्पन्न कुलपिता यहूदा का एक पुत्र और एर तथा शेला का भाई।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Onan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak laki-laki dari bapa leluhur Yehuda melalui perempuan Kanaan anak Syua dan saudara laki-laki Er serta Syela."
        }
      ]
    },
    "por": {
      "preferred_label": "Onã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho do patriarca Judá com a cananeia Suá, e irmão de Er e Selá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Онан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Иуды от хананеянки, дочери Шуи, и брат Ира и Шелы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Onani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa baba wa taifa Yuda aliyezaa na Mkanaani Shua, na kaka/ndugu yake Eri, Onani, Shela."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Onan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong bikpela tumbuna Juda wantaim Sua, meri bilong Kenan, na em i brata bilong Er na Sela."
        }
      ]
    },
    "apd": {
      "preferred_label": "أونان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ود للأب يهوذا من الكنعانية بنت شوع، وهو أخو عير وشيلة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Onan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong olfala bubu blong bifo Juda wetem woman Kenan Sua, mo brata blong Ere, Onan, Sela."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nna ochie bụ Juda mụrụ site n'onye Kenan bụ Shua na nwanne Ịa na Shela."
        }
      ]
    },
    "nep": {
      "preferred_label": "ओनान",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनानी शूआद्वारा कुलपिता यहूदाका छोरा तथा एर् र शेलहका भाइ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ô-nan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của tổ phụ Giu-đa với người phụ nữ Ca-na-an tên Su-a, và là anh em của Ê-rơ và Sê-la."
        }
      ]
    },
    "zht": {
      "preferred_label": "俄南",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖猶大與迦南人書亞之女所生的兒子，珥和示拉的兄弟。"
        }
      ]
    }
  },
