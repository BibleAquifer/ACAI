  "localizations": {
    "eng": {
      "preferred_label": "Hanun",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hanun",
          "article": "person:Hanun",
          "description": "An Ammonite king and son of Nahash, who humiliated King David’s ambassadors and became his enemy."
        }
      ]
    },
    "fra": {
      "preferred_label": "Hanun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi ammonite et fils de Nachasch, qui humilia les ambassadeurs du roi David et devint son ennemi."
        }
      ]
    },
    "spa": {
      "preferred_label": "Janún",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey amonita e hijo de Naas, que humilló a los embajadores del rey David y se convirtió en su enemigo."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَانُون",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَلِكٌ عَمُّونِيٌّ وَابْنُ نَاحَاشَ، أَذَلَّ رُسُلَ ٱلْمَلِكِ دَاوُدَ وَصَارَ عَدُوًّا لَهُ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈嫩",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚扪人的王，拿辖的儿子。他羞辱了大卫王的使者，并成为大卫的仇敌。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hanun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Ammonawa kuma ɗan Nahash, wanda ya wulakanta jakadun Sarki Dawuda har ya zama maƙiyinsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "हानून",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अम्मोनियों का राजा और नाहाश का पुत्र, जिसने राजा दाऊद के राजदूतों को अपमानित किया और उसका शत्रु बन गया।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hanun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang raja Amon dan anak dari Nahas, yang mempermalukan para utusan Raja Daud dan menjadi musuhnya."
        }
      ]
    },
    "por": {
      "preferred_label": "Hanum",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um rei amonita e filho de Naás, que humilhou os embaixadores do rei Davi e se tornou seu inimigo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аннон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь аммонитян и сын Нааса, который унизил послов царя Давида и стал его врагом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hanuni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Waamoni na mwana wa Nahashi, aliyewavunjia heshima wajumbe wa Mfalme Daudi na akawa adui yake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hanun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela king bilong ol Amon na pikinini man bilong Nahas. Em i bin mekim sem pasin long ol mausman bilong King Devit na i kamap birua bilong en."
        }
      ]
    },
    "apd": {
      "preferred_label": "حانون",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك عموني وابن ناحاش، أهان رسل الملك داود وبقى عدوه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hanun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong ol man Amon mo pikinini blong Nahas, we i daonem ol man blong King Deved we oli karem tok blong hem mo i kam enemi blong hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hanọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze ndị Amọn na nwa Nahash, onye wedara ndị ozi Eze Devid nʼala ma ghọọ onye iro ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "हानून",
      "descriptions": [
        {
          "source": "acai",
          "description": "अम्‍मोनीहरूका एक राजा र नाहाशका छोरा, जसले राजा दाऊदका राजदूतहरूलाई अपमान गरे र उनका शत्रु बने।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-nun",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vua dân Am-môn và là con trai của Na-hách; ông đã làm nhục các sứ giả của Vua Đa-vít và trở thành kẻ thù của vua."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈嫩",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞捫人的王，拿轄的兒子。他羞辱了大衛王的使者，並成了大衛的仇敵。"
        }
      ]
    }
  },
