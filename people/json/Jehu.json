  "localizations": {
    "eng": {
      "preferred_label": "Jehu",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jehu",
          "article": "person:Jehu",
          "description": "A prophet, son of Hanani, living during the time of kings Baasha and Jehoshaphat."
        }
      ]
    },
    "fra": {
      "preferred_label": "Jéhu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prophète, fils de Hanani, vivant à l'époque des rois Baescha et Josaphat."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jehú",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un profeta, hijo de Hanani, que vivió durante el tiempo de los reyes Basá y Josafat."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَاهو",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبي، وهو ابن حناني، عاش في زمن الملكين بعشا ويهوشافاط."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耶户",
      "descriptions": [
        {
          "source": "acai",
          "description": "哈拿尼的儿子，一位先知，生活在巴沙王和约沙法王时期。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yehu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani annabi, ɗan Hanani, wanda ya rayu a zamanin sarakuna Ba’asha da Yehoshafat."
        }
      ]
    },
    "hin": {
      "preferred_label": "येहू",
      "descriptions": [
        {
          "source": "acai",
          "description": "हनानी का पुत्र एक नबी, जो राजा बाशा और यहोशापात के समय में जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yehu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang nabi, anak Hanani, yang hidup pada zaman raja Baesa dan Yosafat."
        }
      ]
    },
    "por": {
      "preferred_label": "Jeú",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um profeta, filho de Hanani, que viveu durante o tempo dos reis Baasa e Josafá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ииуй",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пророк, сын Ханания, живший во времена царей Ваасы и Иосафата."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yehu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nabii, mwana wa Hanani, aliyeishi wakati wa wafalme Baasha na Yehoshafati."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jehu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela profet, pikinini bilong Hanani, em i stap long taim bilong King Basa na King Jehosafat."
        }
      ]
    },
    "apd": {
      "preferred_label": "ياهو",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبي، ولد حناني، عاش في زمن الملكين بعشا ويهوشافاط."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jehu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan profet, we hem i pikinini boe blong Hanani, we i laef long taem blong King Bahasa mo King Jehosafat."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jehu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye amụma, nwa Hanani, nke dịrị ndụ nʼoge ndị eze bụ Baasha na Jehoshafat."
        }
      ]
    },
    "nep": {
      "preferred_label": "येहू",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा बाशा र यहोशापातको समयमा बस्ने हनानीका छोरा एक अगमवक्ता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giê-hu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nhà tiên tri, con của Ha-na-ni, sống vào thời vua Ba-ê-sa và vua Giô-sa-phát."
        }
      ]
    },
    "zht": {
      "preferred_label": "耶戶",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位先知，哈拿尼的兒子，生活在巴沙王和約沙法王統治時期。"
        }
      ]
    }
  },
