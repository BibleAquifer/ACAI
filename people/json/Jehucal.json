  "type": "person",
  "gender": "male",
  "father": "person:Shelemiah.8",
  "localizations": {
    "eng": {
      "preferred_label": "Jehucal",
      "alternate_labels": [
        "Jehukal",
        "Jucal"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jehucal",
          "article": "person:Jehucal",
          "description": "A man living during the divided kingdom, son of Shelemiah, mentioned in Jeremiah 37:3 and also called Jucal in Jeremiah 38:1."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَهُوخَل",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل عاش في عهد المملكة المنقسمة، وهو ابن شلميا، ورد ذكره في إرميا 37: 3، ودُعي أيضًا يوخل في إرميا 38: 1."
        }
      ]
    },
    "zhs": {
      "preferred_label": "犹甲",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期的人，示利米雅的儿子，见于耶利米书37:3，在耶利米书38:1中也被称为犹甲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jéhucal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Homme vivant à l'époque de la monarchie divisée, fils de Schélémia, mentionné en Jérémie 37:3 et également appelé Jucal en Jérémie 38:1."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yehukal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutum da ya rayu a zamanin mulkin da ya rabu, ɗan Shelemiya, wanda aka ambata a Irmiya 37:3 kuma ana kiransa Yukal a Irmiya 38:1."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहूकल",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के काल का एक पुरुष, शेलेम्याह का पुत्र, जिसका उल्लेख यिर्मयाह 37:3 में है और जिसे यिर्मयाह 38:1 में यूकल भी कहा गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yukhal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang laki-laki yang hidup pada masa kerajaan terpecah, anak Selemya, yang disebutkan dalam Yeremia 37:3 dan juga disebut Yukhal dalam Yeremia 38:1."
        }
      ]
    },
    "por": {
      "preferred_label": "Jucal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem que viveu durante o reino dividido, filho de Selemias, mencionado em Jeremias 37:3 e também chamado de Jucal em Jeremias 38:1."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иегухал",
      "descriptions": [
        {
          "source": "acai",
          "description": "Мужчина, живший в период разделенного царства, сын Шелемии; упоминается в Иеремии 37:3 и также называется Юхалом в Иеремии 38:1."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jehucal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un hombre que vivió durante el reino dividido, hijo de Selemías, mencionado en Jeremías 37:3 y también llamado Jucal en Jeremías 38:1."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yehukali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamume aliyeishi wakati wa ufalme uliogawanyika, mwana wa Shelemia, anayetajwa katika Yeremia 37:3 na pia akiitwa Yukali katika Yeremia 38:1."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jehukal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man i stap long taim bilong kingdom i bruuk, pikinini bilong Selemia, em Jeremaia 37:3 i kolim nem bilong em na Jeremaia 38:1 i kolim em Jehukal tu."
        }
      ]
    },
    "apd": {
      "preferred_label": "يهوخل",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل عاش في زمن المملكة المنقسمة، ولد شلميا، مذكور في إرميا 37: 3 وكمان مسمى يوكل في إرميا 38: 1."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jukal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i laef long taem we kingdom i seraot, we hem i pikinini boe blong Selemia, we Jeremaea 37:3 i tokbaot hem mo Jeremaea 38:1 i kolem hem tu se Jukal."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jehukal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke dịrị ndụ nʼoge alaeze kewara ekewa, nwa Shelemaya, nke a kpọtụrụ aha na Jeremaya 37:3, nke a na-akpọkwa Jukal na Jeremaya 38:1."
        }
      ]
    },
    "nep": {
      "preferred_label": "यहूकल",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा बस्ने शेलेम्याहका छोरा एक पुरुष, जसलाई यर्मिया ३७:३ मा उल्लेख गरिएको छ र यर्मिया ३८:१ मा यहूकल पनि भनिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giê-hu-canh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người sống vào thời vương quốc phân chia, con của Sê-lê-mia, được chép trong Giê-rê-mi 37:3 và cũng được gọi là Giu-can trong Giê-rê-mi 38:1."
        }
      ]
    },
    "zht": {
      "preferred_label": "猶甲",
      "descriptions": [
        {
          "source": "acai",
          "description": "分裂王國時期的一名男子，示利米雅的兒子，見於耶利米書37:3，在耶利米書38:1中也被稱為猶甲。"
        }
      ]
    }
  },
