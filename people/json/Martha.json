  "localizations": {
    "eng": {
      "preferred_label": "Martha",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Martha",
          "article": "person:Martha",
          "description": "A friend of Jesus, and sister of Mary and Lazarus from Bethany."
        }
      ]
    },
    "fra": {
      "preferred_label": "Marthe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Amie de Jésus, et sœur de Marie et de Lazare de Béthanie."
        }
      ]
    },
    "spa": {
      "preferred_label": "Marta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Amiga de Jesús y hermana de María y de Lázaro, de Betania."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَرْثَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "صَدِيقَةٌ لِيَسُوعَ، وَأُخْتُ مَرْيَمَ وَلِعَازَرَ مِنْ بَيْتِ عَنْيَا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "马大",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶稣的朋友，来自伯大尼，是马利亚和拉撒路的姐姐。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Marta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata abokiyar Yesu, kuma ’yar’uwar Maryamu da Lazarus daga Betani."
        }
      ]
    },
    "hin": {
      "preferred_label": "मार्था",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु की एक सखी, तथा बैतनिय्याह के मरियम और लाज़र की बहन।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Marta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sahabat Yesus, serta saudara perempuan Maria dan Lazarus dari Betania."
        }
      ]
    },
    "por": {
      "preferred_label": "Marta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Amiga de Jesus e irmã de Maria e Lázaro, de Betânia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Марфа",
      "descriptions": [
        {
          "source": "acai",
          "description": "Друг Иисуса, сестра Марии и Лазаря из Вифании."
        }
      ]
    },
    "swh": {
      "preferred_label": "Martha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rafiki ya Yesu, na dada yake Mariamu na Lazaro kutoka Bethania."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Marta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pren bilong Jisas, na susa bilong Maria na Lasarus bilong Betani."
        }
      ]
    },
    "apd": {
      "preferred_label": "مرثا",
      "descriptions": [
        {
          "source": "acai",
          "description": "صاحبة ليسوع، وأخت مريم ولعازر من بيت عنيا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan fren blong Jisas, mo sista blong Meri wetem Lasaros blong Betani."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Enyi Jisọs, na nwanne Meri na Lazarọs si Betani."
        }
      ]
    },
    "nep": {
      "preferred_label": "मार्था",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूकी एक मित्र, र बेथानियाकी मरियम र लाजरसकी दिदी।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-thê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người bạn của Chúa Giê-xu, là chị/em của Ma-ri và La-xa-rơ ở Bê-tha-ni."
        }
      ]
    },
    "zht": {
      "preferred_label": "馬大",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶穌的朋友，也是伯大尼的馬利亞和拉撒路的姊姊。"
        }
      ]
    }
  },
