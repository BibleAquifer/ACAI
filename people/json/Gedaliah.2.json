  "localizations": {
    "eng": {
      "preferred_label": "Gedaliah (Son of Ahikam)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Gedaliah (Son of Ahikam)",
          "article": "person:Gedaliah.2",
          "description": "A son of Ahikam, who was appointed as governor of Judah by King Nebuchadnezzar at the beginning of Israel's exile."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَدَلْيَا (ابن أخيقام)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن أخيقام، الذي عُيّن حاكمًا على يهوذا من قِبل الملك نبوخذناصر في بداية سبي إسرائيل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "基大利 (亚希甘的儿子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚希甘的儿子，在以色列人被掳之初被尼布甲尼撒王委任为犹大省长。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Guedalia (fils d'Achikam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d'Achikam, établi gouverneur de Juda par le roi Nebucadnetsar au début de l'exil d'Israël."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gedaliya (Ɗan Ahikam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Ahikam, wanda Sarki Nebukadnezzar ya naɗa a matsayin gwamnan Yahuda a farkon zaman bautar Isra’ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "गदल्याह (अहीकाम का पुत्र)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अहीकाम का एक पुत्र, जिसे इस्राएल की बंधुआई की शुरुआत में राजा नबूकदनेस्सर द्वारा यहूदा का राज्यपाल नियुक्त किया गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gedalya (anak Ahikam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak laki-laki Ahikam, yang diangkat sebagai gubernur Yehuda oleh Raja Nebukadnezar pada permulaan masa pembuangan Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Gedalias (filho de Aicam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Aicam, que foi nomeado governador de Judá pelo rei Nabucodonosor no início do exílio de Israel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Годолия (сын Ахикама)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Ахикама, назначенный царем Навуходоносором правителем Иудеи в начале вавилонского пленения Израиля."
        }
      ]
    },
    "spa": {
      "preferred_label": "Gedalías (hijo de Ahicam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Ahicam, que fue nombrado gobernador de Judá por el rey Nabucodonosor al comienzo del exilio de Israel."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gedalia (Mwana wa Ahikamu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Ahikamu, aliyeteuliwa kuwa liwali wa Yuda na Mfalme Nebukadneza mwanzo mwa uhamisho wa Israeli."
        }
      ]
    },
    "apd": {
      "preferred_label": "جدليا (ولد أخيقام)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد أخيقام، الكان اتعين والي على يهوذا بواسطة الملك نبوخذنصر في بداية سبي إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gedalia (Pikinini boe blong Ahikam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Ahikam, we King Nebukadnesa i putumap hem olsem distrikejen blong Juda long stat blong eksael blong Isrel."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gedaliya (Nwa Ahikam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Ahikam, onye Eze Nebukadneza mere gọvanọ Juda na mmalite nke ndọrọ nʼagha Israel."
        }
      ]
    },
    "nep": {
      "preferred_label": "गदल्याह (अहीकामका छोरा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अहीकामका छोरा, जसलाई इस्राएलको निर्वासनको सुरुमा राजा नबूकदनेसरले यहूदाको राज्यपाल नियुक्त गरेका थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gedalia (Pikinini Man Bilong Ahikam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Ahikam, em King Nebukatnesar i bin makim em bilong stap gavana bilong Juda long taim ol Israel i stat i go stap kalabus."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ghê-đa-lia (con của A-hi-cam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của A-hi-cam, được Vua Nê-bu-cát-nết-sa bổ nhiệm làm tổng đốc Giu-đa vào đầu thời kỳ lưu đày của Y-sơ-ra-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "基大利 (亞希甘的兒子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞希甘的兒子，在以色列人被擄之初被尼布甲尼撒王立為猶大省長。"
        }
      ]
    }
  },
