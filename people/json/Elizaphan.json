  "localizations": {
    "eng": {
      "preferred_label": "Elizaphan",
      "alternate_labels": [
        "Elzaphan"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Elizaphan",
          "article": "person:Elizaphan",
          "description": "Son of Uzziel and cousin of the high priest Aaron. He was a levitival priest and chief of the clan of the Kohathites. "
        }
      ]
    },
    "arb": {
      "preferred_label": "أَلِيصَافَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن عزِّيئِيل وابن عم رئيس الكهنة هَارون. كان كاهناً لاوياً ورئيساً لعشيرة القهاتيين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以利撒番",
      "descriptions": [
        {
          "source": "acai",
          "description": "乌薛的儿子，大祭司亚伦的堂弟。他是利未祭司，也是哥辖家族的首领。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Élitsaphan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d’Uziel et cousin du grand prêtre Aaron. Il était prêtre lévitique et chef du clan des Kehathites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Elizafan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Uzziyel kuma ɗan’uwan babban firist Haruna. Firist ne na Lawiyawa kuma shugaban dangin Kohatawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "एलीसापान",
      "descriptions": [
        {
          "source": "acai",
          "description": "उज्जीएल का पुत्र और महायाजक हारून का चचेरा भाई। वह एक लेवीय याजक और कहातियों के कुल का प्रधान था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Elisafan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari Uziel dan sepupu dari imam besar Harun. Ia adalah seorang imam Lewi dan pemimpin kaum Kehat."
        }
      ]
    },
    "por": {
      "preferred_label": "Elisafã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Uziel e primo do sumo sacerdote Arão. Foi um sacerdote levita e líder do clã dos coatitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Елцафан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Узиила и двоюродный брат первосвященника Аарона. Он был священником-левитом и начальником родов Каафовых."
        }
      ]
    },
    "spa": {
      "preferred_label": "Elizafán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Uziel y primo del sumo sacerdote Aarón. Fue sacerdote levita y jefe del clan de los coatitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Elisafani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Uzieli na binamu wa kuhani mkuu Haruni. Alikuwa kuhani wa Kilawi na kiongozi wa ukoo wa Wakohathi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Elisafan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Usiel na kasen brata bilong bikpris Aron. Em i wanpela pris bilong lain Livai na hetman bilong famili lain Kohat."
        }
      ]
    },
    "apd": {
      "preferred_label": "أليصافان",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد عزيئيل وود عم رئيس الكهنة هارون. كان كاهن لاوي ورئيس عشيرة القهاتيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Elijafan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Usiel mo kasen blong hae pris Eron. Hem i wan pris blong laen blong Livae mo lida blong laen blong Kohat."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Elizafan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Uziel na nwa nwanne nna nke nnukwu onye nchụaja bụ Erọn. Ọ bụ onye nchụaja ndị Livaị na onyeisi ezinụlọ ndị Kohat."
        }
      ]
    },
    "nep": {
      "preferred_label": "एलीजापान",
      "descriptions": [
        {
          "source": "acai",
          "description": "उज्जीएलका छोरा र प्रधान पुजारी हारूनका काकाका छोरा। उनी एक लेवी पुजारी र कहातीहरूको कुलका अगुवा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-li-sa-phan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của U-xi-ên và là em họ của thầy tế lễ thượng phẩm A-rôn. Ông là thầy tế lễ thuộc bộ tộc Lê-vi và là người lãnh đạo gia tộc Kê-hát."
        }
      ]
    },
    "zht": {
      "preferred_label": "以利撒反",
      "descriptions": [
        {
          "source": "acai",
          "description": "烏薛的兒子，大祭司亞倫的堂兄弟。他是一位利未祭司，也是哥轄宗族的首領。"
        }
      ]
    }
  },
