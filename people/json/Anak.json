      "descriptions": [
        {
          "source": "acai",
          "gloss": "Anak",
          "article": "person:Anak",
          "description": "Ancestor of a race of giants in Canaan. He was the son of Arba."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَنَاق",
      "descriptions": [
        {
          "source": "acai",
          "description": "جدّ لسلالة من الجبابرة في كنعان، وكان ابن أربع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚衲",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦南巨人族的先祖，是亚巴的儿子。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Anak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ancêtre d’une race de géants en Canaan. Il était le fils d’Arba."
        }
      ]
    },
    "hau": {
      "preferred_label": "Anak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kakan wani jinsin ƙattai a Kan’ana. Shi ɗan Arba ne."
        }
      ]
    },
    "hin": {
      "preferred_label": "अनाक",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनान में दानवों की एक जाति का पूर्वज। वह अर्बा का पुत्र था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Enak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Leluhur dari bangsa orang-orang raksasa di Kanaan. Dia adalah anak laki-laki Arba."
        }
      ]
    },
    "por": {
      "preferred_label": "Enaque",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ancestral de uma raça de gigantes em Canaã. Ele era filho de Arba."
        }
      ]
    },
    "rus": {
      "preferred_label": "Енак",
      "descriptions": [
        {
          "source": "acai",
          "description": "Прародитель племени великанов в Ханаане, сын Арбы."
        }
      ]
    },
    "spa": {
      "preferred_label": "Anac",
      "descriptions": [
        {
          "source": "acai",
          "description": "Antepasado de una raza de gigantes en Canaán. Era hijo de Arba."
        }
      ]
    },
    "swh": {
      "preferred_label": "Anaki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babu wa ukoo wa majitu huko Kanaani. Alikuwa mwana wa Arba."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Anak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuna bilong wanpela lain bilong ol traipela man long Kenan. Em i pikinini man bilong Arba."
        }
      ]
    },
    "apd": {
      "preferred_label": "عناق",
      "descriptions": [
        {
          "source": "acai",
          "description": "جدّ جنس من العماليق في كنعان. وكان ولد أربع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Anak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Stamba bubu blong wan laen blong ol dabolbun man long Kenan. Hem i pikinini blong Aba."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Anak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nna nna nke agbụrụ ndị dike nʼime Kenan. Ọ bụ nwa Aaba."
        }
      ]
    },
    "nep": {
      "preferred_label": "अनाक",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनानका दैत्यहरूको जातिको पुर्खा। तिनी अर्बाका छोरा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-nác",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tổ phụ của một chủng tộc người khổng lồ ở Ca-na-an. Ông là con trai của A-ra-ba."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞衲",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦南巨人族的先祖，是亞巴的兒子。"
        }
      ]
    }
  },
