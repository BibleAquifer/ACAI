      "descriptions": [
        {
          "source": "acai",
          "gloss": "Pashhur",
          "article": "person:Pashhur",
          "description": "A son of Malchijah and father of Zechariah, living during the time of Israelite exile and return."
        }
      ]
    },
    "arb": {
      "preferred_label": "فَشْحور",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن ملكيا ووالد زكريا، عاش في زمن سبي بني إسرائيل ورجوعهم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "巴施户珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "玛基雅的儿子，撒迦利雅的父亲，生活在以色列人被掳和归回时期。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Paschhur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Malkija et père de Zacharie, ayant vécu à l'époque de l'exil et du retour des Israélites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fashhur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Malkiya kuma mahaifin Zakariya, wanda ya rayu a lokacin bautar Isra’ilawa da dawowarsu."
        }
      ]
    },
    "hin": {
      "preferred_label": "पशहूर",
      "descriptions": [
        {
          "source": "acai",
          "description": "मल्किय्याह का एक पुत्र और जकर्याह का पिता, जो इस्राएलियों के बंधुवाई और वापसी के समय जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Pasyhur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki Malkia dan ayah dari Zakharia, yang hidup pada masa pembuangan dan pemulangan bangsa Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Pasur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Malquias e pai de Zacarias, que viveu durante o tempo do exílio e retorno dos israelitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Пашхур",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Малхии и отец Захарии, живший во время израильского пленения и возвращения."
        }
      ]
    },
    "spa": {
      "preferred_label": "Pasur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Malquías y padre de Zacarías, que vivió durante el tiempo del exilio y el regreso de los israelitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Pashuri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Malkiya na baba yake Zekaria, aliyeishi wakati wa uhamisho na kurudi kwa Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Malkia na papa bilong Sekaraia, em i bin stap laip long taim ol Israel i stap kalabus na taim ol i go bek."
        }
      ]
    },
    "apd": {
      "preferred_label": "فشحور",
      "descriptions": [
        {
          "source": "acai",
          "description": "ود ملكيا وأبو زكريا، عاش في زمن السبي ورجوع بني إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Pasuru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini man blong Malkia mo papa blong Sekaraea, we i laef long taem we ol man Isrel oli stap long kalabus long Babilon mo taem we oli kambak."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Pashua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Malkija na nna Zekaraya, nke biri nʼoge ndọkpụ nʼagha na nlọghachi nke ndị Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "पशहूर",
      "descriptions": [
        {
          "source": "acai",
          "description": "मल्कियाहका छोरा र जकरियाका पिता, जो इस्राएलीहरूको निर्वासन र फिर्तीको समयमा बाँचेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Pha-su-rơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của Manh-ki-gia và là cha của Xa-cha-ri, sống vào thời kỳ dân Y-sơ-ra-ên bị lưu đày và hồi hương."
        }
      ]
    },
    "zht": {
      "preferred_label": "巴施戶珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "瑪基雅的兒子，撒迦利亞的父親，生活於以色列人被擄及回歸時期。"
        }
      ]
    }
  },
