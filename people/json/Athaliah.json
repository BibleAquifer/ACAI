  "localizations": {
    "eng": {
      "preferred_label": "Athaliah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Athaliah",
          "article": "person:Athaliah",
          "description": "A queen during the divided kingdom, who destroyed the royal family. She was a daughter of Ahab, wife of Jehoram, and mother of Ahaziah and Jehosheba."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَثَلْيَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَلِكَةٌ فِي عَصْرِ الْمَمْلَكَةِ الْمُنْقَسِمَةِ، أَبَادَتِ النَّسْلَ الْمَلَكِيَّ. كَانَتِ ابْنَةَ أَخْآبَ، وَزَوْجَةَ يَهُورَامَ، وَأُمَّ أَخَزْيَا وَيَهُوشَبَعَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚她利雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期的一位王后，她铲除了王室家族。她是亚哈的女儿，约兰的妻子，亚哈谢和约示巴的母亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Athalie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Reine à l'époque du royaume divisé, qui extermina la famille royale. Elle était fille d'Achab, épouse de Joram, et mère d'Achazia et de Joschéba."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ataliya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarauniya a lokacin rabuwar mulki, wadda ta hallaka iyalin sarauta. Ita ’yar Ahab ce, matar Yoram, kuma mahaifiyar Ahaziya da Yehosheba."
        }
      ]
    },
    "hin": {
      "preferred_label": "अतल्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के समय की एक रानी, जिसने राजवंश का नाश किया था। वह अहाब की बेटी, यहोराम की पत्नी, और अहज्याह तथा यहोशेबा की माँ थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Atalya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang ratu pada masa kerajaan terpecah yang membinasakan keturunan raja. Ia adalah anak perempuan Ahab, istri Yoram, serta ibu dari Ahazia dan Yoseba."
        }
      ]
    },
    "por": {
      "preferred_label": "Atalia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma rainha durante o reino dividido que destruiu a família real. Era filha de Acabe, esposa de Jeorão e mãe de Acazias e Jeoseba."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гофолия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царица во времена разделенного царства, истребившая царский род. Дочь Ахава, жена Иорама и мать Охозии и Иосавеф."
        }
      ]
    },
    "spa": {
      "preferred_label": "Atalía",
      "descriptions": [
        {
          "source": "acai",
          "description": "Reina durante el reino dividido, que destruyó a la familia real. Fue hija de Acab, esposa de Joram y madre de Ocozías y Josaba."
        }
      ]
    },
    "swh": {
      "preferred_label": "Athalia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Malkia wakati wa ufalme uliogawanyika, aliyeiangamiza jamaa ya kifalme. Alikuwa binti wa Ahabu, mke wa Yehoramu, na mama ya Ahazia na Yehosheba."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Atalia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kwin long taim bilong hap kingdom, em i bin bagarapim na kilim i dai famili bilong king. Em i pikinini meri bilong Ahap, meri bilong Jehoram, na mama bilong Ahasia na Jehoseba."
        }
      ]
    },
    "apd": {
      "preferred_label": "عثليا",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملكة في زمن المملكة المنقسمة، أهلكت النسل الملكي. كانت بت أخاب، وزوجة يهورام، وأم أخزيا ويهوشبعة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Atalia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kwin long taem blong kingdom we i seraot, we i bin spolem mo kilimded ol pikinini mo laen blong king. Hem i wan dota blong Ahab, woman blong Jehoram, mo mama blong Ahasia wetem Jehoseba."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Atalaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwanyị eze nʼoge alaeze kewara ekewa, onye bibiri ezinụlọ eze. Ọ bụ nwa nwanyị Ehab, nwunye Jehoram, na nne Ahazaya na Jehosheba."
        }
      ]
    },
    "nep": {
      "preferred_label": "अतल्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयकी एक रानी, जसले राजकीय परिवारलाई नष्ट पारिन्। तिनी आहाबकी छोरी, यहोरामकी पत्नी, तथा अहज्याह र यहोशेबाकी आमा थिइन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-tha-li",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nữ hoàng trong thời kỳ vương quốc phân chia, người đã tiêu diệt hoàng tộc. Bà là con gái của A-háp, vợ của Giô-ram, và là mẹ của A-cha-xia và Giô-sê-ba."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞她利雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期的一位王后，曾剿滅王室。她是亞哈的女兒、約蘭的妻子，以及亞哈謝和約示巴的母親。"
        }
      ]
    }
  },
