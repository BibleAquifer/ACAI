        }
      ]
    },
    "hin": {
      "preferred_label": "हताक",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा क्षयर्ष का एक खोजा और सेवक जो रानी एस्तेर के व्यक्तिगत परिचारक के रूप में सेवा करता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hatah",
      "descriptions": [
        {
