          "description": "Евнух и слуга царя Артаксеркса, служивший личным служителем царицы Есфири."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hatak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela yunak na wokman bilong King Ahasuerus em i bin mekim wok olsem wasman bilong Kwin Esta."
        }
      ]
    },
    "apd": {
      "preferred_label": "هتاخ",
      "descriptions": [
        {
          "source": "acai",
          "description": "خصي وخادم للملك أحشويروش، خدم كمساعد شخصي للملكة أستير."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hatak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan eunuk mo man blong wok blong King Ahasuerus we i bin wok olsem wan spesel man blong givhan long Kwin Esta."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hatak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu onye onozi na ohu Eze Ahasuerọs nke jere ozi dị ka onye na-ejere Eze Nwanyị Esta ozi."
        }
      ]
    },
    "nep": {
      "preferred_label": "हताक",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा अहासूरसका एक नपुंसक र सेवक जसले रानी एस्तरका व्यक्तिगत परिचारकको रूपमा सेवा गरेका थिए।"
        }
      ]
    },
    "swh": {
      "preferred_label": "Hathaki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Towashi na mtumishi wa Mfalme Ahasuero aliyetumika kama mhudumu binafsi wa Malkia Esta."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-thác",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một hoạn quan và tôi tớ của vua A-ha-suê-ru, người hầu cận riêng của Hoàng hậu Ê-xơ-tê."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈他革",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞哈隨魯王的一名太監與僕人，擔任以斯帖王后的侍從。"
        }
      ]
    }
