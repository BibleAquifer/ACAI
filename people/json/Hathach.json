        }
      ]
    },
    "por": {
      "preferred_label": "Hataque",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um eunuco e servo do rei Assuero que servia como assistente pessoal da rainha Ester."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гафах",
      "descriptions": [
        {
