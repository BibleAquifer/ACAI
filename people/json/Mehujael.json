      "descriptions": [
        {
          "source": "acai",
          "gloss": "Mehujael",
          "article": "person:Mehujael",
          "description": "A man living before the Flood, descendant of Cain, son of Irad, and father of Methushael."
        }
      ]
    },
    "fra": {
      "preferred_label": "Mehujaël",
      "descriptions": [
        {
          "source": "acai",
          "description": "Homme ayant vécu avant le Déluge, descendant de Caïn, fils d’Irad et père de Metuschaël."
        }
      ]
    },
    "spa": {
      "preferred_label": "Mejuyael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre que vivió antes del diluvio, descendiente de Caín, hijo de Irad y padre de Metusael."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَحُويَائِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل عاش قبل الطوفان، من نسل قايين، ابن عيراد، وأبو متوشائيل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "米户雅利",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在洪水前的一名男子，是该隐的后代，以拿的儿子，玛土撒利的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Mehujayel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutum da ya rayu kafin Rigyawa, zuriyar Kayinu, ɗan Irad, kuma mahaifin Metushayel."
        }
      ]
    },
    "hin": {
      "preferred_label": "महूयाएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "जलप्रलय से पहले रहने वाला एक मनुष्य, कैन का वंशज, ईराद का पुत्र और मतूशाएल का पिता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Mehuyael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang laki-laki yang hidup sebelum Air Bah, keturunan Kain, anak Irad, dan ayah Metusael."
        }
      ]
    },
    "por": {
      "preferred_label": "Meujael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem que viveu antes do Dilúvio, descendente de Caim, filho de Irade e pai de Metusael."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мехиаель",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, живший до Потопа, потомок Каина, сын Ирада и отец Мафусала."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mehuyaeli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamume aliyeishi kabla ya Gharika, mzao wa Kaini, mwana wa Iradi, na baba ya Methushaeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mehujael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man i stap paslain long Bikpela Tait, tumbuna pikinini bilong Kein, pikinini man bilong Irat, na papa bilong Metusael."
        }
      ]
    },
    "apd": {
      "preferred_label": "محويائيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل عاش قبل الطوفان، من نسل قايين، ولد عيراد وأبو متوشائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mehujael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i laef bifo long Bigfala Wota i ron, laen blong Kain, pikinini boe blong Irad, mo papa blong Metusael."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mehujael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke biri ndụ tupu Iju Mmiri ahụ, nwa nwa Ken, nwa Irad, na nna Metusael."
        }
      ]
    },
    "nep": {
      "preferred_label": "महूयाएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "जलप्रलयभन्दा अघि जीवित रहेका एक व्यक्ति, जो कयिनका वंशज, ईरादका छोरा र मतुशाएलका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Mê-hu-gia-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người nam sống trước thời Nước Lụt, hậu duệ của Ca-in, con trai của Y-rát và cha của Mê-tu-sa-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "米戶雅利",
      "descriptions": [
        {
          "source": "acai",
          "description": "大洪水前生活的一個人，該隱的後裔，以拿的兒子，瑪土撒利的父親。"
        }
      ]
    }
  },
