  "localizations": {
    "eng": {
      "preferred_label": "Nicodemus",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Nicodemus",
          "article": "person:Nicodemus",
          "description": "A member of the Jewish Sanhedrin and secret disciple of Jesus who buried Jesus with Joseph of Aramathea."
        }
      ]
    },
    "fra": {
      "preferred_label": "Nicodème",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membre du sanhédrin juif et disciple secret de Jésus, qui ensevelit Jésus avec Joseph d’Arimathée."
        }
      ]
    },
    "spa": {
      "preferred_label": "Nicodemo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Miembro del Sanedrín judío y discípulo secreto de Jesús que sepultó a Jesús junto con José de Arimatea."
        }
      ]
    },
    "arb": {
      "preferred_label": "نِيقودِيموس",
      "descriptions": [
        {
          "source": "acai",
          "description": "عضو في مجمع السَّنْهَدْرِيم اليهودي وتلميذ سري ليسوع، دفن يسوع مع يوسف الرامي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "尼哥德慕",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹太公会的一位成员，耶稣暗中的门徒，与亚利马太的约瑟一同安葬了耶稣。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Nikodimus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani ɗan majalisar Sanhedirin ta Yahudawa kuma almajirin Yesu a ɓoye wanda ya binne Yesu tare da Yusuf mutumin Arimateya."
        }
      ]
    },
    "hin": {
      "preferred_label": "नीकुदेमुस",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदी महासभा (सन्हेद्रिन) का एक सदस्य और यीशु का एक गुप्त चेला जिसने अरिमतियाह के यूसुफ के साथ मिलकर यीशु को दफनाया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Nikodemus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anggota Mahkamah Agama Yahudi dan murid rahasia Yesus yang memakamkan Yesus bersama Yusuf dari Arimatea."
        }
      ]
    },
    "por": {
      "preferred_label": "Nicodemos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membro do Sinédrio judaico e discípulo secreto de Jesus que sepultou Jesus com José de Arimateia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Никодим",
      "descriptions": [
        {
          "source": "acai",
          "description": "Член иудейского синедриона и тайный ученик Иисуса, который похоронил Иисуса вместе с Иосифом из Аримафеи."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nikodemo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mshiriki wa Sanhedrini ya Kiyahudi na mwanafunzi wa siri wa Yesu aliyemzika Yesu pamoja na Yosefu wa Arimathaya."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Nikodemus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela memba bilong Kaunsil bilong ol Juda na wanpela hait disaipel bilong Jisas, em i bin planim bodi bilong Jisas wantaim Josep bilong Arimatea."
        }
      ]
    },
    "apd": {
      "preferred_label": "نيقوديموس",
      "descriptions": [
        {
          "source": "acai",
          "description": "عضو في مجمع السنهدريم اليهودي وتلميذ ليسوع بالسر، دفن يسوع مع يوسف الرامي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Nikodimas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan memba blong Sanhedrin blong ol Jiu mo disaepol blong Jisas we i haedem bilif blong hem, we hem wetem Josef blong Aramatia tufala i berem Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nikọdimọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu onye nʼime ndị Sanhedrin nke ndị Juu na onye na-eso ụzọ Jisọs na nzuzo, onye ya na Josef onye Arimatia liri Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "निकोदेमस",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदी न्यायपरिषद् (सन्हेड्रिन) का एक सदस्य र येशूका गुप्त चेला, जसले अरिमाथियाका योसेफसँग मिलेर येशूलाई गाडे।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ni-cô-đem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thành viên của Tòa Công Luận Do Thái và là môn đồ kín giấu của Chúa Giê-xu, người đã cùng Giô-sép người A-ri-ma-thê chôn cất Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "尼哥德慕",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶太公會的一位成員，也是耶穌的隱密門徒，曾與亞利馬太的約瑟一同安葬耶穌。"
        }
      ]
    }
  },
