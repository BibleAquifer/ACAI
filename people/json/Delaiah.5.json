          "gloss": "Delaiah (Jeremiah 36:12)",
          "article": "person:Delaiah.5",
          "description": "Delaiah, mentioned in Jeremiah 36:12, was an official and the son of Shemaiah during the time of King Jehoiakim in the divided kingdom."
        }
      ]
    },
    "fra": {
      "preferred_label": "Delaja (Jérémie 36.12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Delaja, mentionné dans Jérémie 36:12, était un haut fonctionnaire et le fils de Schemaeja à l'époque du roi Jojakim, durant le royaume divisé."
        }
      ]
    },
    "spa": {
      "preferred_label": "Delaías (Jeremías 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Delaías, mencionado en Jeremías 36:12, fue un funcionario e hijo de Semaías durante la época del rey Joacim en el reino dividido."
        }
      ]
    },
    "arb": {
      "preferred_label": "دَلَايَا (إرميا 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "دَلَايَا، المذكور في إرميا 36: 12، كان مسؤولًا وابن شِمْعِيَا في عهد الملك يهوياقيم في المملكة المنقسمة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "第莱雅 (耶利米书 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "第莱雅见于耶利米书36:12，是分裂王国时期约雅敬王时的一名官员，示玛雅的儿子。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Delahiya (Irmiya 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Delahiya, wanda aka ambata a Irmiya 36:12, bafade ne kuma ɗan Shemahiya a zamanin Sarki Yehoyakim a masarautar da ta rabu."
        }
      ]
    },
    "hin": {
      "preferred_label": "दलायाह (यिर्मयाह 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दलायाह, जिसका उल्लेख यिर्मयाह 36:12 में हुआ है, विभाजित राज्य में राजा यहोयाकीम के समय एक अधिकारी और शमायाह का पुत्र था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Delaya (Yeremia 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Delaya, yang disebutkan dalam Yeremia 36:12, adalah seorang pembesar dan anak Semaya pada masa Raja Yoyakim di zaman kerajaan yang terbagi."
        }
      ]
    },
    "por": {
      "preferred_label": "Delaías (Jeremias 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Delaías, mencionado em Jeremias 36:12, era um oficial e filho de Semaías durante o tempo do rei Jeoaquim no reino dividido."
        }
      ]
    },
    "rus": {
      "preferred_label": "Делаия (Иеремия 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Делаия, упомянутый в Иеремии 36:12, был сановником и сыном Шемаии во времена царя Иоакима в период разделенного царства."
        }
      ]
    },
    "swh": {
      "preferred_label": "Delaya (Yeremia 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Delaya, anayetajwa katika Yeremia 36:12, alikuwa afisa na mwana wa Shemaya wakati wa Mfalme Yehoyakimu katika ufalme uliogawanyika."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Delaia (Jeremia 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Delaia, em Baibel i kolim long Jeremaia 36:12, em i wanpela ofisa na pikinini man bilong Semaia long taim bilong King Jehoiakim long taim kingdom i brok tupela."
        }
      ]
    },
    "apd": {
      "preferred_label": "دلايا (إرميا 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "دلايا، المذكور في إرميا 36: 12، كان مسؤول وولد شمعيا في زمن الملك يهوياقيم في المملكة المنقسمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Delaea (Jeremaea 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Delaea, we oli tokbaot hem long Jeremaea 36:12, hem i wan haeman mo boe blong Semaea long taem blong King Jehoiakim long taem we kingdom i hafhaf."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Delaya (Jeremaia 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Delaya, nke a kpọtụrụ aha na Jeremaya 36:12, bụ onyeisi ọchịchị na nwa Shemaya nʼoge Eze Jehoiakim nʼalaeze kewara ekewa."
        }
      ]
    },
    "nep": {
      "preferred_label": "दलायाह (यर्मिया 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यर्मिया ३६:१२ मा उल्लिखित दलायाह, विभाजित राज्यकालमा राजा यहोयाकीमको समयका एक अधिकारी र शमायाहका छोरा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Đê-la-gia (Giê-rê-mi 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đê-la-gia, được nhắc đến trong Giê-rê-mi 36:12, là một quan chức và là con trai của Sê-ma-gia vào thời Vua Giê-hô-gia-kim trong thời kỳ vương quốc phân chia."
        }
      ]
    },
    "zht": {
      "preferred_label": "第萊雅 (耶利米書 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶利米書36:12中提及的第萊雅，是一名官長，示瑪雅的兒子，生活在王國分裂時期猶大王約雅敬年間。"
        }
      ]
    }
  },
