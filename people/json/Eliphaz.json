  "localizations": {
    "eng": {
      "preferred_label": "Eliphaz",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Eliphaz",
          "article": "person:Eliphaz",
          "description": "First-born son of Esau and his wife Adah. He was the chief of the people of Edom."
        }
      ]
    },
    "fra": {
      "preferred_label": "Éliphaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Premier-né d'Ésaü et de sa femme Ada. Il était chef du peuple d'Édom."
        }
      ]
    },
    "spa": {
      "preferred_label": "Elifaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo primogénito de Esaú y su esposa Ada. Fue jefe del pueblo de Edom."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَلِيفَاز",
      "descriptions": [
        {
          "source": "acai",
          "description": "الابن البكر لعيسو وزوجته عدا. وكان أميرًا لشعب أدوم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以利法",
      "descriptions": [
        {
          "source": "acai",
          "description": "以扫和妻子亚大的长子。他是以东人的族长。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Elifaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan fari na Isuwa da matarsa Ada. Shi ne shugaban mutanen Edom."
        }
      ]
    },
    "hin": {
      "preferred_label": "एलीपज",
      "descriptions": [
        {
          "source": "acai",
          "description": "एसाव और उसकी पत्नी आदा का पहलौठा पुत्र। वह एदोम के लोगों का एक अधिपति था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Elifas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak sulung Esau dan istrinya, Ada. Ia adalah kepala kaum orang Edom."
        }
      ]
    },
    "por": {
      "preferred_label": "Elifaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho primogênito de Esaú e de sua esposa Ada. Foi chefe do povo de Edom."
        }
      ]
    },
    "rus": {
      "preferred_label": "Елифаз",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первенец Исава и его жены Ады. Он был старейшиной народа Едома."
        }
      ]
    },
    "swh": {
      "preferred_label": "Elifazi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa kwanza wa Esau na mkewe Ada. Alikuwa kiongozi wa watu wa Edomu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Elifas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba wan pikinini man bilong Iso wantaim meri bilong en Ada. Em i bin hetman bilong ol lain Idom."
        }
      ]
    },
    "apd": {
      "preferred_label": "أليفاز",
      "descriptions": [
        {
          "source": "acai",
          "description": "الولد البكر لـ عيسو ومَرتُو عَدة. وهو كان زعيم شعب أدوم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Elifas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasbon boe blong Esao wetem woman blong hem Ada. Hem i wan jif blong ol man Edom."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Elifaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọkpara Ịsọ na nwunye ya Ada. Ọ bụ onye isi nke ndị Edọm."
        }
      ]
    },
    "nep": {
      "preferred_label": "एलीपज",
      "descriptions": [
        {
          "source": "acai",
          "description": "एसाव र उनकी पत्‍नी आदाका जेठा छोरा। उनी एदोमका मानिसहरूका प्रमुख थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-li-pha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai đầu lòng của Ê-sau và vợ ông là A-đa. Ông là tộc trưởng của dân Ê-đôm."
        }
      ]
    },
    "zht": {
      "preferred_label": "以利法",
      "descriptions": [
        {
          "source": "acai",
          "description": "以掃與妻子亞大的長子。他是以東人的族長。"
        }
      ]
    }
  },
