  "localizations": {
    "eng": {
      "preferred_label": "Ishmael",
      "alternate_labels": [
        "Ishmeelite",
        "Ishmaelite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ishmael",
          "article": "person:Ishmael",
          "description": "The patriarch Abraham’s first-born son by Hagar. He was father to twelve sons and half-brother to Isaac."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِسْمَاعِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "الابن البكر للبطريرك إبراهيم من هاجر. كان أبًا لاثني عشر ابنًا وأخًا غير شقيق لإسحاق."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以实玛利",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长亚伯拉罕与夏甲所生的长子。他是十二个儿子的父亲，也是以撒同父异母的兄弟。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Ismaël",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le premier-né du patriarche Abraham et d'Agar. Il fut le père de douze fils et le demi-frère d'Isaac."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ishmayel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan fari na kakan nan Ibrahim ta wurin Hagar. Ya zama uban ’ya’ya maza goma sha biyu, kuma ɗan’uwan Ishaku ne uba ɗaya."
        }
      ]
    },
    "hin": {
      "preferred_label": "इश्माएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "हागार से उत्पन्न कुलपिता अब्राहम का पहिलौठा पुत्र। वह बारह पुत्रों का पिता और इसहाक का सौतेला भाई था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ismael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak sulung dari bapa leluhur Abraham bersama Hagar. Ia adalah ayah dari dua belas anak laki-laki dan saudara sebapa dari Ishak."
        }
      ]
    },
    "por": {
      "preferred_label": "Ismael",
      "descriptions": [
        {
          "source": "acai",
          "description": "O filho primogênito do patriarca Abraão com Hagar. Ele foi pai de doze filhos e meio-irmão de Isaque."
        }
      ]
    },
    "rus": {
      "preferred_label": "Измаил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первенец патриарха Авраама от Агари. Он был отцом двенадцати сыновей и единокровным братом Исаака."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ismael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Primogénito del patriarca Abraham con Agar. Fue padre de doce hijos y medio hermano de Isaac."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ishmaeli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa kwanza wa kiume wa mzee wa ukoo Abrahamu aliyezaliwa na Hajiri. Alikuwa baba wa wana kumi na wawili na ndugu wa kambo wa Isaki."
        }
      ]
    },
    "apd": {
      "preferred_label": "إسماعيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "الولد البكر لي إبراهيم من هاجر. كان أبو لي تناشر ولد، وأخو إسحق من أبوه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ismael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasbon pikinini boe blong Ebraham we Hega i bonem. Hem i papa blong twelef pikinini boe mo haf brata blong Aesak."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ishmel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa mbụ nna ochie bụ Ebreham mụrụ site na Hega. Ọ bụ nna ụmụ nwoke iri na abụọ ma bụrụkwa nwanne nna Aịzik."
        }
      ]
    },
    "nep": {
      "preferred_label": "इश्माएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "हागारद्वारा जन्मिएका कुलपिता अब्राहामका जेठा छोरा। तिनी बाह्र जना छोराहरूका पिता र इसहाकका सौतेनी भाइ थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ismael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nambawan pikinini man bilong Abraham em Hagar i karim. Em i papa bilong 12-pela pikinini man na em i hap brata bilong Aisak."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ích-ma-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai đầu lòng của tổ phụ Áp-ra-ham với nàng Ha-ga. Ông là cha của mười hai người con trai và là anh em cùng cha khác mẹ với Y-sác."
        }
      ]
    },
    "zht": {
      "preferred_label": "以實瑪利",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長亞伯拉罕與夏甲所生的長子。他是十二個兒子的父親，也是以撒同父異母的哥哥。"
        }
      ]
    }
  },
