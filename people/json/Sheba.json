          "gloss": "Sheba",
          "article": "person:Sheba",
          "description": "A grandson the patriarch Cush, son of Raamah, and brother of Dedan. "
        }
      ]
    },
    "arb": {
      "preferred_label": "شَبَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد كوش، وابن رعمة، وأخو ددان."
        }
      ]
    },
    "zhs": {
      "preferred_label": "示巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖古实的孙子，拉玛的儿子，底但的兄弟。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Sheba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jikan kakan nan Kush, ɗan Ra’ama, kuma ɗan’uwan Dedan."
        }
      ]
    },
    "hin": {
      "preferred_label": "शेबा",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता कूश का एक पोता, रामाह का पुत्र और ददान का भाई।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Syeba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang cucu dari bapa leluhur Kush, anak laki-laki Raema, dan saudara laki-laki Dedan."
        }
      ]
    },
    "por": {
      "preferred_label": "Sabá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neto do patriarca Cuxe, filho de Raamá e irmão de Dedã."
        }
      ]
    },
    "rus": {
      "preferred_label": "Шева",
      "descriptions": [
        {
          "source": "acai",
          "description": "Внук патриарха Хуша, сын Раамы и брат Дедана."
        }
      ]
    },
    "spa": {
      "preferred_label": "Seba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nieto del patriarca Cus, hijo de Raama y hermano de Dedán."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sheba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mjukuu wa mzee wa imani Kushi, mwana wa Raama, na ndugu yake Dedani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Seba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela tumbuna pikinini bilong Kus, pikinini man bilong Rama, na brata bilong Dedan."
        }
      ]
    },
    "apd": {
      "preferred_label": "شَبا",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد كوش، ابن رَعْمة، وأخو دَدان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Seba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan smolbubu blong patriak Kus, pikinini boe blong Ramaha, mo brata blong Dedan."
        }
      ]
    },
    "fra": {
      "preferred_label": "Séba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit-fils du patriarche Cusch, fils de Raema et frère de Dedan."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sheba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa nke nna ochie Kush, nwa Raama, na nwanne Dedan."
        }
      ]
    },
    "nep": {
      "preferred_label": "शेबा",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता कूशका नाति, रामाहका छोरा र ददानका भाइ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-ba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người cháu nội của tổ phụ Cút, con trai của Ra-ma và là anh em của Đê-đan."
        }
      ]
    },
    "zht": {
      "preferred_label": "示巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "古實族長之孫，拉瑪的兒子，底但的兄弟。"
        }
      ]
    }
  },
