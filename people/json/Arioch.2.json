      "descriptions": [
        {
          "source": "acai",
          "gloss": "Arioch",
          "article": "person:Arioch.2",
          "description": "A captain of King Nebuchadnezzar’s guard living during the time of Israel's exile to Babylon."
        }
      ]
    },
    "fra": {
      "preferred_label": "Arjoc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chef des gardes du roi Nebucadnetsar ayant vécu à l’époque de l’exil d’Israël à Babylone."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَرْيُوخُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيس شُرَط الملك نبوخذنصر، عاش خلال فترة سبي إسرائيل إلى بابل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚略",
      "descriptions": [
        {
          "source": "acai",
          "description": "尼布甲尼撒王的护卫长，生活在以色列人被掳到巴比伦时期。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ariyok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shugaban dakarun matsaran Sarki Nebukadnezzar da ya rayu a zamanin bautar Isra’ila a Babilon."
        }
      ]
    },
    "hin": {
      "preferred_label": "अर्योक",
      "descriptions": [
        {
          "source": "acai",
          "description": "बाबेल में इस्राएल के निर्वासन के समय राजा नबूकदनेस्सर के अंगरक्षकों का एक प्रधान।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ariokh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pemimpin pengawal Raja Nebukadnezar yang hidup pada masa pembuangan Israel ke Babel."
        }
      ]
    },
    "por": {
      "preferred_label": "Arioque",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um capitão da guarda do rei Nabucodonosor que viveu durante a época do exílio de Israel na Babilônia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ариох",
      "descriptions": [
        {
          "source": "acai",
          "description": "Начальник телохранителей царя Навуходоносора, живший во время вавилонского пленения Израиля."
        }
      ]
    },
    "spa": {
      "preferred_label": "Arioc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Capitán de la guardia del rey Nabucodonosor que vivió durante el tiempo del exilio de Israel a Babilonia."
        }
      ]
    },
    "swh": {
      "preferred_label": "Arioko",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkuu wa walinzi wa Mfalme Nebukadneza aliyeishi wakati wa uhamisho wa Israeli huko Babeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ariok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela namba wan ofisa bilong ol soldia bilong King Nebukatnesar i bin stap laip long taim ol Isrel i stap kalabus long Babilon."
        }
      ]
    },
    "apd": {
      "preferred_label": "أريوخ",
      "descriptions": [
        {
          "source": "acai",
          "description": "قائد حرس الملك نبوخذنصر عاش في زمن سبي إسرائيل لبابل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ariok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kapten blong ol gad blong King Nebukadnesa we i laef long taem we ol man Isrel oli stap long eksael long Babilon."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ariok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọchịagha ndị nche Eze Nebukadneza nke biri nʼoge a dọọrọ Izrel nʼagha gaa Babilọn."
        }
      ]
    },
    "nep": {
      "preferred_label": "अर्योक",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलको बेबिलोन निर्वासनको समयमा बाँचेका राजा नबूकदनेसरका अङ्गरक्षकहरूका एक कमान्डर।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-ri-ốc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chỉ huy thị vệ của Vua Nê-bu-cát-nết-xa sống trong thời kỳ dân Y-sơ-ra-ên bị lưu đày sang Ba-by-lôn."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞略",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人被擄至巴比倫時期尼布甲尼撒王的護衛長。"
        }
      ]
    }
  },
