  "localizations": {
    "eng": {
      "preferred_label": "Seraiah (Jeremiah 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Seraiah (Jeremiah 51:59)",
          "article": "person:Seraiah.8",
          "description": "Seraiah, mentioned in Jeremiah 51:59, was a man living during the divided kingdom, the son of Neriah and brother of Baruch."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَرَايَا (إرميا 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "سرايا، المذكور في إرميا 51: 59، كان رجلاً عاش خلال فترة المملكة المنقسمة، وهو ابن نيريا وأخو باروخ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西莱雅 (耶利米书 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶利米书51:59中提到的西莱雅，是生活在王国分裂时期的一名男子，尼利亚的儿子，巴录的弟兄。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Seraja (Jérémie 51.59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seraja, mentionné dans Jérémie 51.59, était un homme qui vivait à l'époque du royaume divisé, fils de Nérija et frère de Baruc."
        }
      ]
    },
    "hau": {
      "preferred_label": "Serahiya (Irmiya 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Serahiya, wanda aka ambata a Irmiya 51:59, wani mutum ne da ya rayu a lokacin rabuwar mulki, ɗan Neriya kuma ɗan’uwan Baruk."
        }
      ]
    },
    "hin": {
      "preferred_label": "सरायाह (यिर्मयाह 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यिर्मयाह 51:59 में उल्लिखित सरायाह, विभाजित राज्य के समय रहने वाला एक पुरुष था, जो नेरिय्याह का पुत्र और बारूक का भाई था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Seraya (Yeremia 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seraya, yang disebutkan dalam Yeremia 51:59, adalah seorang pria yang hidup pada masa kerajaan terpecah, anak Neria dan saudara laki-laki Barukh."
        }
      ]
    },
    "por": {
      "preferred_label": "Seraías (Jeremias 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seraías, mencionado em Jeremias 51:59, era um homem que viveu durante o reino dividido, filho de Nerias e irmão de Baruque."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сераия (Иеремия 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сераия, упомянутый в Иеремии 51:59, был человеком, жившим во времена разделенного царства, сыном Нирии и братом Варуха."
        }
      ]
    },
    "spa": {
      "preferred_label": "Seraías (Jeremías 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seraías, mencionado en Jeremías 51:59, fue un hombre que vivió durante la monarquía dividida, hijo de Nerías y hermano de Baruc."
        }
      ]
    },
    "swh": {
      "preferred_label": "Seraya (Yeremia 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seraya, anayetajwa katika Yeremia 51:59, alikuwa mwanamume aliyeishi wakati wa ufalme uliogawanyika, mwana wa Neria na ndugu ya Baruku."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Seraia (Jeremia 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seraia, em Baibel i kolim nem bilong en long Jeremaia 51:59, em i wanpela man i bin stap long taim bilong kingdom i brukbruk, em i pikinini man bilong Neria na brata bilong Baruk."
        }
      ]
    },
    "apd": {
      "preferred_label": "سرايا (إرميا 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "سرايا، المذكور في إرميا 51: 59، كان راجل عاش في زمن المملكة المنقسمة، وهو ولد نيريا وأخو باروخ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Seraea (Jeremaea 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seraea, we Jeremaea 51:59 i tokbaot hem, hem i wan man we i laef long taem we kingdom i seraot, pikinini man blong Neria mo brata blong Baruk."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Seraya (Jeremaia 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seraya, nke a kpọtụrụ aha na Jeremaya 51:59, bụ nwoke biri n'oge alaeze kewara ekewa, nwa Neraya na nwanne Baruk."
        }
      ]
    },
    "nep": {
      "preferred_label": "सरायाह (यर्मिया 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यर्मिया ५१:५९ मा उल्लेख गरिएका सरायाह विभाजित राज्यको समयमा बाँचेका एक मानिस, नेरियाहका छोरा र बारूकका भाइ थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-ra-gia (Giê-rê-mi 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sê-ra-gia, được đề cập trong Giê-rê-mi 51:59, là một người sống trong thời kỳ vương quốc phân chia, con trai của Nê-ri-gia và anh em của Ba-rúc."
        }
      ]
    },
    "zht": {
      "preferred_label": "西萊雅 (耶利米書 51:59)",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶利米書51:59中提到的西萊雅是王國分裂時期的一個人，是尼利亞的兒子，巴錄的兄弟。"
        }
      ]
    }
  },
