          "description": "A son of Lotan and brother of Hemam, who lived during the time of the patriarchs."
        }
      ]
    },
    "arb": {
      "preferred_label": "حُورِي",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن لوطان وأخو هيمام، عاش في عصر الآباء."
        }
      ]
    },
    "zhs": {
      "preferred_label": "何利",
      "descriptions": [
        {
          "source": "acai",
          "description": "罗坍的儿子，荷幔的兄弟，生活在族长时期。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Hori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Lothan et frère d'Hémam, qui vécut à l'époque des patriarches."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Lotan kuma ɗan'uwan Homam, wanda ya rayu a zamanin kakanni."
        }
      ]
    },
    "hin": {
      "preferred_label": "होरी",
      "descriptions": [
        {
          "source": "acai",
          "description": "लोतान का पुत्र और हेमाम का भाई, जो कुलपिताओं के समय में रहता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak laki-laki Lotan dan saudara laki-laki Heman, yang hidup pada zaman para bapa leluhur."
        }
      ]
    },
    "por": {
      "preferred_label": "Hori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Lotã e irmão de Hemã, que viveu durante a época dos patriarcas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хори",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Лотана и брат Гемана, живший в эпоху патриархов."
        }
      ]
    },
    "spa": {
      "preferred_label": "Horí",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Lotán y hermano de Hemam, que vivió durante la época de los patriarcas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Lotani na ndugu yake Hemamu, aliyeishi wakati wa wazee wa imani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Lotan na brata bilong Heman, em i bin stap long taim bilong ol tumbuna yet."
        }
      ]
    },
    "apd": {
      "preferred_label": "حوري",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد لوطان وأخو هيمام، عاش في زمن الآباء."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan boe blong Lotan mo brata blong Hemam, we i laef long taem blong ol olfala bubu."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Lotan na nwanne nwoke nke Hemam, onye dịrị ndụ nʼoge ndị nna nna ochie."
        }
      ]
    },
    "nep": {
      "preferred_label": "होरी",
      "descriptions": [
        {
          "source": "acai",
          "description": "लोतानका छोरा र हेमानका भाइ, जो कुलपिताहरूको समयमा बाँचेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hô-ri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Lô-than và là anh em của Hê-man, sống vào thời kỳ các tổ phụ."
        }
      ]
    },
    "zht": {
      "preferred_label": "何利",
      "descriptions": [
        {
          "source": "acai",
          "description": "羅坍的兒子，希幔的兄弟，生活在先祖時期。"
        }
      ]
    }
  },
