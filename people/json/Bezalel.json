  "localizations": {
    "eng": {
      "preferred_label": "Bezalel",
      "alternate_labels": [
        "Bezaleel"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Bezalel",
          "article": "person:Bezalel",
          "description": "A man from the tribe of Judah, and a son of Uri. Bezalel was a skilled craftsman gifted and chosen by God to work on the tabernacle during the time the wilderness wandering of the Israelites."
        }
      ]
    },
    "fra": {
      "preferred_label": "Betsaleel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un homme de la tribu de Juda, fils d'Uri. Betsaleel était un artisan habile, doué et choisi par Dieu pour travailler au tabernacle pendant la période de l'errance des Israélites dans le désert."
        }
      ]
    },
    "spa": {
      "preferred_label": "Bezalel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre de la tribu de Judá e hijo de Uri. Bezalel fue un hábil artesano dotado y escogido por Dios para trabajar en el tabernáculo durante el tiempo en que los israelitas vagaron por el desierto."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَصَلْئِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل من سبط يهوذا، وابن أوري. كان بصلئيل صانعًا ماهرًا وهبه الله واختاره للعمل في خيمة الاجتماع أثناء تيه بني إسرائيل في البرية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "比撒列",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大支派的一名男子，乌利的儿子。在以色列人旷野漂流时期，比撒列是一名技艺精湛的工匠，蒙上帝赐予才能并拣选参与建造会幕的工作。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Bezalel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutum daga kabilar Yahuda, kuma ɗan Uri. Bezalel ƙwararren mai sana’ar hannu ne da Allah ya ba da baiwa kuma ya zaɓa don yin aiki a kan mazauni a lokacin da Isra’ilawa suke yawo a cikin daji."
        }
      ]
    },
    "hin": {
      "preferred_label": "बसलेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा के गोत्र का एक पुरुष, और ऊरी का पुत्र। बसलेल एक कुशल कारीगर था जिसे इस्राएलियों के जंगल में भटकने के समय निवास-स्थान के निर्माण कार्य के लिए परमेश्वर द्वारा वरदान दिया गया और चुना गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Bezaleel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang laki-laki dari suku Yehuda dan anak dari Uri. Bezaleel adalah seorang pengrajin terampil yang diberi karunia serta dipilih oleh Allah untuk mengerjakan Kemah Suci selama masa pengembaraan orang Israel di padang gurun."
        }
      ]
    },
    "por": {
      "preferred_label": "Bezalel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem da tribo de Judá e filho de Uri. Bezalel foi um artesão habilidoso, capacitado e escolhido por Deus para trabalhar no tabernáculo durante a peregrinação dos israelitas pelo deserto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Веселеил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек из колена Иуды, сын Урия. Веселеил был искусным ремесленником, одарённым и избранным Богом для работ над скинией во время странствования израильтян по пустыне."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bezaleli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamume wa kabila la Yuda, na mwana wa Uri. Bezaleli alikuwa fundi stadi mwenye vipawa aliyechaguliwa na Mungu kufanya kazi kwenye maskani wakati Waisraeli walipokuwa wakitangatanga jangwani."
        }
      ]
    },
    "apd": {
      "preferred_label": "بصلئيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل من قبيلة يهوذا، وولد أوري. بصلئيل كان حرفي ماهر الله وهبه واختاره عشان يشتغل في خيمة الاجتماع في فترة تيهان بني إسرائيل في البرية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bejalehel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man blong laen blong Juda, mo boe blong Uri. Bejalehel i wan man we i gat gudhan long wok we God i givim presen long hem mo jusum hem blong wok long tabenakol long taem we ol man Isrel oli stap wokbaot long draeples."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Bezalel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke si nʼebo Juda, na nwa Uri. Bezalel bụ onye omenkà nwere nkà nke Chineke nyere onyinye ma họrọ ka ọ rụọ ọrụ nʼụlọ ikuu nʼoge njem ndị Izrel nʼọzara."
        }
      ]
    },
    "nep": {
      "preferred_label": "बजलेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदाको कुलका एक व्यक्ति र ऊरीका छोरा। इस्राएलीहरूको उजाडस्थानको यात्राको समयमा वासस्थानको निर्माण कार्य गर्नका लागि बजलेल परमेश्‍वरद्वारा छानिएका र वरदान दिइएका सिपालु कारीगर थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Besalel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong lain bilong Juda, na pikinini man bilong Uri. Besalel em i wanpela man bilong wokim olkain samting i gat bikpela save, em God i bin givim presen long em na makim em bilong wokim haus sel bilong Bikpela long taim ol Israel i bin raun long bikples drai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bê-sa-lê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người thuộc bộ tộc Giu-đa, con trai của U-ri. Bê-sa-lê là một người thợ thủ công tài giỏi được Đức Chúa Trời ban ơn và chọn lựa để xây dựng đền tạm trong thời gian người Y-sơ-ra-ên lưu lạc trong đồng vắng."
        }
      ]
    },
    "zht": {
      "preferred_label": "比撒列",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大支派的一名男子，烏利的兒子。比撒列是一名技藝精湛的工匠，在以色列人曠野漂流時期，蒙神賜予恩賜並揀選來建造帳幕。"
        }
      ]
    }
  },
