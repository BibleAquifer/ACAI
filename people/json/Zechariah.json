        }
      ]
    },
    "spa": {
      "preferred_label": "Zacarías",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sumo sacerdote y padre de Juan el Bautista, casado con Elisabet."
        }
      ]
    },
    "arb": {
      "preferred_label": "زَكَرِيَّا",
      "descriptions": [
        {
          "source": "acai",
          "description": "كَاهِنٌ وَأَبُو يُوحَنَّا المَعْمَدَانِ، زَوْجُ أَلِيصَابَاتَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "撒迦利亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位祭司，施洗约翰的父亲，妻子是伊利莎白。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Zakariya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban firist kuma mahaifin Yohanna Mai Ba da Baftisma, mijin Elizabet."
        }
      ]
    },
    "hin": {
      "preferred_label": "जकर्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक महायाजक और यूहन्ना बपतिस्मा देनेवाले का पिता, जिसका विवाह एलीशिबा से हुआ था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Zakharia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang imam besar dan ayah dari Yohanes Pembaptis, suami Elisabet."
        }
      ]
    },
    "por": {
      "preferred_label": "Zacarias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um sacerdote e pai de João Batista, casado com Isabel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Захария",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первосвященник и отец Иоанна Крестителя, муж Елисаветы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Zekaria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhani mkuu na baba yake Yohana Mbatizaji, aliyeolewa na Elizabeti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sekaraia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hetpris na papa bilong Jon Bilip, em i bin maritim Elisabet."
        }
      ]
    },
    "apd": {
      "preferred_label": "زكريا",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيس كهنة وأبو يوحنا المعمدان، وكان متزوج أليصابات."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sekaraea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hae pris mo papa blong Jon Baptaes, we i mared wetem Elisabet."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Zekaraya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyeisi nchụaja na nna Jọn Onye Na-eme Baptizim, onye lụrụ Elizabet."
        }
      ]
    },
    "nep": {
      "preferred_label": "जकरिया",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक प्रधान पुजारी र बप्तिस्मा दिने यूहन्‍नाका पिता, जसको विवाह एलीशिबासँग भएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Xa-cha-ri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thầy tế lễ thượng phẩm và là cha của Giăng Báp-tít, kết hôn với Ê-li-sa-bét."
        }
      ]
    },
    "zht": {
      "preferred_label": "撒迦利亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "施洗約翰的父親，娶以利沙伯為妻的一位祭司。"
        }
      ]
    }
  },
