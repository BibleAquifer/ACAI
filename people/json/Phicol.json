  "localizations": {
    "eng": {
      "preferred_label": "Phicol",
      "alternate_labels": [
        "Phichol"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Phicol",
          "article": "person:Phicol",
          "description": "Phicol, first mentioned in Genesis 21:22, was a military commander who lived at the time of the patriarchs."
        }
      ]
    },
    "arb": {
      "preferred_label": "فيكول",
      "descriptions": [
        {
          "source": "acai",
          "description": "فيكول، المذكور أول مرة في التكوين 21: 22، كان قائداً عسكرياً عاش في زمن الآباء."
        }
      ]
    },
    "zhs": {
      "preferred_label": "非各",
      "descriptions": [
        {
          "source": "acai",
          "description": "非各于创世记21:22中首次被提及，是生活在族长时代的一位军长。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Picol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Picol, mentionné pour la première fois dans Genèse 21:22, était un chef d'armée qui vivait à l'époque des patriarches."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fikol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fikol, wanda aka fara ambatonsa a Farawa 21:22, shi ne komandan rundunar soja wanda ya rayu a zamanin kakanni."
        }
      ]
    },
    "hin": {
      "preferred_label": "पीकोल",
      "descriptions": [
        {
          "source": "acai",
          "description": "पीकोल, जिसका पहला उल्लेख उत्पत्ति 21:22 में है, एक सेनापति था जो कुलपिताओं के समय में रहता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Pikhol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikhol, yang pertama kali disebutkan dalam Kejadian 21:22, adalah seorang panglima tentara yang hidup pada zaman para bapa leluhur."
        }
      ]
    },
    "por": {
      "preferred_label": "Ficol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ficol, mencionado pela primeira vez em Gênesis 21:22, foi um comandante militar que viveu na época dos patriarcas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Фихол",
      "descriptions": [
        {
          "source": "acai",
          "description": "Фихол, впервые упомянутый в Бытии 21:22, был военачальником, жившим во времена патриархов."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ficol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ficol, mencionado por primera vez en Génesis 21:22, fue un comandante militar que vivió en la época de los patriarcas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Fikoli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fikoli, aliyetajwa kwa mara ya kwanza katika Mwanzo 21:22, alikuwa mkuu wa jeshi aliyeishi wakati wa mababu wa imani."
        }
      ]
    },
    "apd": {
      "preferred_label": "فيكول",
      "descriptions": [
        {
          "source": "acai",
          "description": "فيكول، المذكور أول مرة في تكوين 21: 22، كان قائد جيش عاش في زمن الآباء الأولين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fikol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fikol, we fas nem blong hem i kamaot long Jenesis 21:22, hem i wan komanda blong ol soldia we i laef long taem blong ol frapaeta."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Fikọl",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fikọl, nke e bu ụzọ kpọtụ aha na Jenesis 21:22, bụ onyeisi ndị agha biri nʼoge ndị nna ochie."
        }
      ]
    },
    "nep": {
      "preferred_label": "पीकोल",
      "descriptions": [
        {
          "source": "acai",
          "description": "उत्पत्ति २१:२२ मा पहिलो पटक उल्लेख गरिएका पीकोल, कुलपिताहरूका समयमा बस्ने एक सेनापति थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Fikol",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fikol, em Baibel i stori pastaim long en long Stat 21:22, em i wanpela namba wan ofisa bilong ami husat i bin stap long taim bilong ol bikman bilong lain Israel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Phi-côn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Phi-côn, được nhắc đến lần đầu trong Sáng Thế Ký 21:22, là một vị tướng chỉ huy quân đội sống vào thời các tổ phụ."
        }
      ]
    },
    "zht": {
      "preferred_label": "非各",
      "descriptions": [
        {
          "source": "acai",
          "description": "非各首次提及於創世記21:22，是生活在族長時期的一位軍長。"
        }
      ]
    }
  },
