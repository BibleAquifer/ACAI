  "localizations": {
    "eng": {
      "preferred_label": "Bathsheba",
      "alternate_labels": [
        "Bath-shua"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Bathsheba",
          "article": "person:Bathsheba",
          "description": "A wife of King David and mother of King Solomon. Also called Bath-shua, she was originally married to Uriah the Hittite."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拔示巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王的妻子，所罗门王的母亲。又名拔书亚，原嫁与赫人乌利亚。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Batsheba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Matar Sarki Dawuda kuma mahaifiyar Sarki Solomon. Ana kuma kiran ta Bat-shuwa, a dā tana auren Uriya Bahetti ne."
        }
      ]
    },
    "hin": {
      "preferred_label": "बतशेबा",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊद की एक पत्नी और राजा सुलैमान की माता। बतशूआ भी कहलाई, उसका पहला विवाह हित्ती ऊरिय्याह से हुआ था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Batsyeba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Istri Raja Daud dan ibu dari Raja Salomo. Juga disebut Bat-Syua, ia awalnya menikah dengan Uria orang Het."
        }
      ]
    },
    "por": {
      "preferred_label": "Bate-Seba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esposa do rei Davi e mãe do rei Salomão. Também chamada de Bate-Sua, foi casada originalmente com Urias, o hitita."
        }
      ]
    },
    "spa": {
      "preferred_label": "Betsabé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esposa del rey David y madre del rey Salomón. También llamada Bat-súa, originalmente estuvo casada con Urías el hitita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bathsheba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mke wa Mfalme Daudi na mama yake Mfalme Sulemani. Pia aliitwa Bath-shua, hapo kwanza aliolewa na Uria Mhiti."
        }
      ]
    },
    "apd": {
      "preferred_label": "بثشبع",
      "descriptions": [
        {
          "source": "acai",
          "description": "زوجة للملك داود وأم الملك سليمان. وبتتسمى كمان بتشوع، وفي الأول كانت متزوجة أوريا الحثي."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَثْشَبَع",
      "descriptions": [
        {
          "source": "acai",
          "description": "زوجة للملك داود وأم للملك سليمان. دُعيت أيضًا بثشوع، وكانت في الأصل متزوجة من أوريا الحثي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Batseba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan woman blong King Deved mo mama blong King Solomon. Nem blong hem tu Batsua, mo fastaem hem i bin mared long Uria we i man Het."
        }
      ]
    },
    "fra": {
      "preferred_label": "Bath-Schéba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Épouse du roi David et mère du roi Salomon. Également appelée Bath-Schua, elle fut d'abord mariée à Urie le Héthien."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Batsheba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwunye Eze Devid na nne Eze Solomọn. A na-akpọkwa ya Bat-shua, na mbụ ọ lụrụ Ụraya onye Het."
        }
      ]
    },
    "nep": {
      "preferred_label": "बतशेबा",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊदकी पत्‍नी र राजा सोलोमनकी आमा। बत-शूआ पनि भनिने उनले सुरुमा हित्ती उरियाहसँग विवाह गरेकी थिइन्।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Вирсавия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жена царя Давида и мать царя Соломона. Также называемая Бат-Шуа (Вирсавия), она первоначально была замужем за Урией Хеттеянином."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Batseba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela meri bilong King Devit na mama bilong King Solomon. Ol i kolim em tu Batsua, na pastaim em i bin marit long Uria bilong lain Hit."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bát-sê-ba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người vợ của Vua Đa-vít và là mẹ của Vua Sa-lô-môn. Cũng được gọi là Bát-su-a, bà ban đầu kết hôn với U-ri người Hê-tít."
        }
      ]
    },
    "zht": {
      "preferred_label": "拔示巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王的妻子，所羅門王的母親。又名拔書亞，起初嫁給赫人烏利亞。"
        }
      ]
    }
  },
