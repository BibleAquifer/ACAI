          "description": "Lévite et femme du prêtre Zacharie, et mère de Jean le Baptiste."
        }
      ]
    },
    "spa": {
      "preferred_label": "Elisabet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Levita y esposa del sacerdote Zacarías, y madre de Juan el Bautista."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَلِيصَابَات",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوية وزوجة الكاهن زَكَرِيَّا، وأم يوحَنَّا المعمدان."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以利沙伯",
      "descriptions": [
        {
          "source": "acai",
          "description": "利未人，祭司撒迦利亚的妻子，施洗约翰的母亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Elizabet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Balawiyya kuma matar firist Zakariya, kuma mahaifiyar Yohanna Mai Ba Da Baftisma."
        }
      ]
    },
    "hin": {
      "preferred_label": "एलीशिबा",
      "descriptions": [
        {
          "source": "acai",
          "description": "लेवी वंश की और याजक जकर्याह की पत्नी, तथा यूहन्ना बपतिस्मा देनेवाले की माता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Elisabet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Keturunan Lewi dan istri dari imam Zakharia, serta ibu dari Yohanes Pembaptis."
        }
      ]
    },
    "por": {
      "preferred_label": "Isabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Levita e esposa do sacerdote Zacarias, e mãe de João Batista."
        }
      ]
    },
    "rus": {
      "preferred_label": "Елисавета",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левитянка, жена священника Захарии и мать Иоанна Крестителя."
        }
      ]
    },
    "swh": {
      "preferred_label": "Elizabeti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mlawi na mke wa kuhani Zekaria, na mama yake Yohana Mbatizaji."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Elisabet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela meri bilong lain Livai na em i meri bilong pris Sekaraia, na mama bilong Jon Bilong Baptais."
        }
      ]
    },
    "apd": {
      "preferred_label": "أليصابات",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوية ومَرت الكاهن زكريا، وأم يوحنا المعمدان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Elisabet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan woman blong laen blong Livae mo woman blong pris Sekaraea, mo mama blong Jon Baptaes."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Elizabet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye Livaị na nwunye onye nchụaja bụ Zekaraya, nakwa nne Jọn Onye Na-eme Baptizim."
        }
      ]
    },
    "nep": {
      "preferred_label": "एलीशिबा",
      "descriptions": [
        {
          "source": "acai",
          "description": "लेवी र पुजारी जकरियाकी पत्नी, र बप्तिस्मा दिने यूहन्नाकी आमा।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-li-sa-bét",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người thuộc chi tộc Lê-vi, vợ của thầy tế lễ Xa-cha-ri và là mẹ của Giăng Báp-tít."
        }
      ]
    },
    "zht": {
      "preferred_label": "伊利莎白",
      "descriptions": [
        {
          "source": "acai",
          "description": "利未人，祭司撒迦利亞的妻子，施洗約翰的母親。"
        }
      ]
    }
  },
