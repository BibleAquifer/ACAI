        }
      ]
    },
    "tpi": {
      "preferred_label": "Sisar (Taiberius)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taiberius em i wanpela king bilong Rom long taim bilong Jisas. Ol i save kolim em tu long Nero."
        }
      ]
    },
    "apd": {
      "preferred_label": "قيصر (تيباريوس)",
      "descriptions": [
        {
          "source": "acai",
