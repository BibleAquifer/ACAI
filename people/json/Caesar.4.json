        }
      ]
    },
    "bis": {
      "preferred_label": "Sisa (Taebirias)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Taebirias i wan empera blong Rom long taem blong Jisas. Narafala nem blong hem Nero."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Siza (Tiberiọs)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tiberiọs bụ eze ukwu Rom nʼoge Jisọs. A makwaara ya dịka Nero."
        }
      ]
    },
    "nep": {
      "preferred_label": "कैसर (तिबेरियस)",
      "descriptions": [
        {
          "source": "acai",
          "description": "तिबेरियस येशूको समयका एक रोमी सम्राट् थिए। तिनलाई नीरो भनेर पनि चिनिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-sa (Ti-be-rơ)",
