  "localizations": {
    "eng": {
      "preferred_label": "Hanani",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hanani",
          "article": "person:Hanani",
          "description": "The father of Jehu and a prophet (seer) during the time of the divided kingdom of Israel."
        }
      ]
    },
    "fra": {
      "preferred_label": "Hanani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Père de Jéhu et prophète (voyant) à l'époque du royaume divisé d'Israël."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hanani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Padre de Jehú y profeta (vidente) durante la época del reino dividido de Israel."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَنَانِي",
      "descriptions": [
        {
          "source": "acai",
          "description": "أبو يَاهُو ونبي (راءٍ) في زمن المملكة المنقسمة في إسرائيل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈拿尼",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶户的父亲，以色列分裂王国时期的先知（先见）。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hanani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uban Yehu kuma annabi (mai duba) a lokacin rarrabuwar masarautar Isra’ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "हनानी",
      "descriptions": [
        {
          "source": "acai",
          "description": "येहू का पिता और इस्राएल के विभाजित राज्य के समय का एक भविष्यद्वक्ता (दर्शी)।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hanani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ayah Yehu dan seorang nabi (pelihat) pada masa kerajaan Israel terpecah."
        }
      ]
    },
    "por": {
      "preferred_label": "Hanani",
      "descriptions": [
        {
          "source": "acai",
          "description": "O pai de Jeú e um profeta (vidente) durante o período do reino dividido de Israel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ананий",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отец Ииуя и пророк (прозорливец) во времена разделенного царства Израиля."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hanani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Baba yake Yehu na nabii (mwonaji) wakati wa ufalme uliogawanyika wa Israeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hanani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa bilong Jehu na wanpela profet long taim bilong kingdom bilong Israel i stap tupela hap."
        }
      ]
    },
    "apd": {
      "preferred_label": "حناني",
      "descriptions": [
        {
          "source": "acai",
          "description": "أبو ياهو ونبي (رائي) في زمن مملكة إسرائيل المنقسمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hanani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa blong Jehu mo wan profet (man we i save luk samting we bambae i kamtru) long taem we kingdom blong Isrel i seraot."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hanani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nna Jehu na onye amụma (onye ọhụ ụzọ) n'oge alaeze Izrel kewara ekewa."
        }
      ]
    },
    "nep": {
      "preferred_label": "हनानी",
      "descriptions": [
        {
          "source": "acai",
          "description": "येहूका पिता र इस्राएलको विभाजित राज्यको समयका एक अगमवक्ता (दर्शी)।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-na-ni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cha của Giê-hu và là một tiên tri (người tiên kiến) trong thời kỳ vương quốc Y-sơ-ra-ên phân chia."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈拿尼",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶戶的父親，以色列王國分裂時期的先知（先見）。"
        }
      ]
    }
  },
