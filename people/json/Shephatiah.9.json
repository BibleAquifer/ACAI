        }
      ]
    },
    "bis": {
      "preferred_label": "Sefatia (Jeremaea 38:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sefatia, we i laef long taem we kingdom i seraot, Baebol i tokbaot hem long Jeremaea 38:1 olsem pikinini boe blong Matan."
        }
      ]
    },
    "fra": {
      "preferred_label": "Schephathia (Jérémie 38.1)",
