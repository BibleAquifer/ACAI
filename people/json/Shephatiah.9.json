    "ibo": {
      "preferred_label": "Shefataya (Jeremaia 38:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shefataya, onye dịrị ndụ nʼoge alaeze kewara ekewa, ka a kpọtụrụ aha na Jeremaya 38:1 dị ka nwa Matan."
        }
      ]
    },
    "nep": {
