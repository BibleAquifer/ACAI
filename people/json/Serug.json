  "localizations": {
    "eng": {
      "preferred_label": "Serug",
      "alternate_labels": [
        "Saruch"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Serug",
          "article": "person:Serug",
          "description": "The son of the patriarch Reu and father of Abraham's grandfather Nahor. He is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَرُوج",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن رعو وأبو ناحور جدّ إبراهيم. وقد ورد اسمه في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西鹿",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖拉吴的儿子，亚伯拉罕祖父拿鹤的父亲。他被列在耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Serug",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Reu et père de Nachor, le grand-père d'Abraham. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Serug",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan kakan dā Reyu kuma mahaifin Nahor kakan Ibrahim. An jera shi a layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "सरूग",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता रऊ का पुत्र और इब्राहीम के दादा नाहोर का पिता। उसे यीशु की वंशावली में सूचीबद्ध किया गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Serug",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari bapa leluhur Rehu dan ayah dari kakek Abraham, Nahor. Ia tercatat dalam garis keturunan Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Serugue",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho do patriarca Reú e pai de Naor, avô de Abraão. Ele está listado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Серух",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Рагава и отец Нахора, деда Авраама. Он включен в родословие Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Serug",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Reu y padre de Nacor, el abuelo de Abraham. Está incluido en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Serugi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa patriarki Reu na baba ya babu yake Abrahamu, Nahori. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Seruk",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong bikman Reu na papa bilong Nahor, tumbuna papa bilong Abraham. Nem bilong em i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "سروج",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد أبو الآباء رعو وأبو ناحور جد إبراهيم. مذكور في نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Serug",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man blong Reu mo papa blong Naho we i bubu man blong Ebraham. Nem blong hem i stap long laen blong famle blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Serug",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nke nna ochie bụ Reu na nna nke nna nna Ebraham bụ Nahọ. E deputara ya n'usoro ọmụmụ nke Jizọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "सरूग",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता रऊका छोरा र अब्राहामका हजुरबुबा नाहोरका पिता। उनी येशूको वंशावलीमा सूचीकृत छन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-rúc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của tộc trưởng Rê-hu và là cha của Na-cô (ông nội của Áp-ra-ham). Ông được liệt kê trong gia phả của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "西鹿",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖拉吳的兒子，亞伯拉罕祖父拿鶴的父親。他被列在耶穌的家譜中。"
        }
      ]
    }
  },
