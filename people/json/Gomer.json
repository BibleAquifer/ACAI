  "localizations": {
    "eng": {
      "preferred_label": "Gomer",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Gomer",
          "article": "person:Gomer",
          "description": "A son of the patriarch Noah's son Japheth. He was father of Ashkenaz, Riphath, and Togarmah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Gomer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Japhet, fils du patriarche Noé. Il était le père d'Aschkenaz, Riphath et Togarma."
        }
      ]
    },
    "spa": {
      "preferred_label": "Gómer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Jafet, hijo de Noé. Fue padre de Asquenaz, Rifat y Togarma."
        }
      ]
    },
    "arb": {
      "preferred_label": "جُومَر",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن ليافث بن نوح، وكان أبا لأشكناز وريفاث وتوجرمة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "歌篾",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖挪亚之子雅弗的儿子。他是亚实基拿、利法和陀迦玛的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Gomer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Yafet ɗan kakan nan Nuhu. Shi ne mahaifin Ashkenaz, Rifat, da Togarma."
        }
      ]
    },
    "hin": {
      "preferred_label": "गोमेर",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नूह के पुत्र येपेत का एक पुत्र। वह अश्कनज, रीपत और तोगर्मा का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gomer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak laki-laki dari putra bapa leluhur Nuh, Yafet. Ia adalah ayah dari Askenas, Rifat, dan Togarma."
        }
      ]
    },
    "por": {
      "preferred_label": "Gômer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Jafé, filho do patriarca Noé. Ele foi pai de Asquenaz, Rifate e Togarma."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гомер",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Иафета, сына Ноя. Он был отцом Аскеназа, Рифата и Фогармы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gomeri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Yafethi mwana wa mzee wa ukoo Nuhu. Alikuwa baba wa Ashkenazi, Rifathi, na Togama."
        }
      ]
    },
    "apd": {
      "preferred_label": "جومر",
      "descriptions": [
        {
          "source": "acai",
          "description": "ود يافث ود النبي نوح. وكان أبو أشكناز وريفاث وتوجرمة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Goma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Jafet we i pikinini blong Noa. Hem i papa blong Askenas, Rifat, mo Togama."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Goma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nwa nwoke nna ochie bụ Noa mụrụ site na nwa ya nwoke Jafet. Ọ bụ nna Ashkenaz, Rifat, na Togama."
        }
      ]
    },
    "nep": {
      "preferred_label": "गोमेर",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नूहका छोरा येपेतका एक छोरा। उनी अश्कनज, रीपत र तोगर्माका बुबा थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gomer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Jafet, pikinini bilong Noa. Em i papa bilong Askenas, Rifat, na Togarma."
        }
      ]
    },
    "vie": {
      "preferred_label": "Gô-me",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con trai của tổ phụ Gia-phết (con trai của Nô-ê). Ông là cha của Ách-kê-na, Ri-phát, và Tô-gạt-ma."
        }
      ]
    },
    "zht": {
      "preferred_label": "歌篾",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖挪亞之子雅弗的兒子。他是亞實基拿、利法和陀迦瑪的父親。"
        }
      ]
    }
  },
