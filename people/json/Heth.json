  "localizations": {
    "eng": {
      "preferred_label": "Heth",
      "alternate_labels": [
        "of Heth",
        "Hittite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Heth",
          "article": "person:Heth",
          "description": "Son of the patriarch Noah's grandson Canaan and regarded as the founder of the Hittites."
        }
      ]
    },
    "arb": {
      "preferred_label": "حِثّ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن كنعان حفيد نوح البطريرك، ويُعتبر مؤسس الحثيين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赫",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖挪亚的孙子迦南的儿子，被视为赫人的始祖。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Heth",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Canaan, le petit-fils du patriarche Noé, et considéré comme le fondateur des Hittites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Het",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Kan’ana jikan uban iyali Nuhu, wanda ake ɗauka a matsayin kakan Hittiyawa."
        }
      ]
    },
    "ind": {
      "preferred_label": "Het",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari Kanaan, cucu dari bapa leluhur Nuh, dan dipandang sebagai leluhur orang Het."
        }
      ]
    },
    "por": {
      "preferred_label": "Hete",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Canaã, neto do patriarca Noé, e considerado o fundador dos hititas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хет",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Ханаана, внука патриарха Ноя, почитаемый как родоначальник хеттеев."
        }
      ]
    },
    "spa": {
      "preferred_label": "Het",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Canaán, nieto del patriarca Noé, y considerado el fundador de los hititas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hethi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Kanaani, mjukuu wa mzee wa ukoo Nuhu, naye huhesabiwa kuwa mwanzilishi wa Wahiti."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Het",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Kenan, em tumbuna pikinini bilong Noa, na ol i ting em i as bilong ol Hit."
        }
      ]
    },
    "apd": {
      "preferred_label": "حِث",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد كنعان حفيد نوح البطريرك، وبيعتبروه مؤسس الحثيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Het",
      "descriptions": [
        {
          "source": "acai",
          "description": "Boe blong Kenan we i smolbubu boe blong Noa, mo oli luk hem olsem stamba blong ol man Het."
        }
      ]
    },
    "hin": {
      "preferred_label": "हेत",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नूह के पोते कनान का पुत्र और हित्तियों का मूल संस्थापक माना जाता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Het",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa nwa nna ochie Noa bụ Kenan, onye a na-ewere dị ka onye guzobere ndị Het."
        }
      ]
    },
    "nep": {
      "preferred_label": "हेत",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नूहका नाति कनानका छोरा र हित्तीहरूका संस्थापक मानिएका व्यक्ति।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hếch",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Ca-na-an (cháu nội tổ phụ Nô-ê) và được coi là thủy tổ của người Hê-tít."
        }
      ]
    },
    "zht": {
      "preferred_label": "赫",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長挪亞的孫子迦南的兒子，被視為赫人的始祖。"
        }
      ]
    }
  },
