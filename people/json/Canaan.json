  "localizations": {
    "eng": {
      "preferred_label": "Canaan (Son of Ham)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Canaan (Son of Ham)",
          "article": "person:Canaan",
          "description": "The youngest son of Ham, and a grandson of Noah. Canaan is thought to be the ancestor of the Canaanites."
        }
      ]
    },
    "fra": {
      "preferred_label": "Canaan (fils de Cham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le plus jeune fils de Cham et petit-fils de Noé. Canaan est considéré comme l'ancêtre des Cananéens."
        }
      ]
    },
    "spa": {
      "preferred_label": "Canaán (hijo de Cam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "El hijo menor de Cam y nieto de Noé. Se considera que Canaán es el antepasado de los cananeos."
        }
      ]
    },
    "arb": {
      "preferred_label": "كَنْعَان (ابن حَام)",
      "descriptions": [
        {
          "source": "acai",
          "description": "أصغر أبناء حَام، وحفيد نوح. يُعتقد أن كنعان هو أصل الكنعانيين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "迦南 (含的儿子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "含最小的儿子，挪亚的孙子。迦南被认为是迦南人的先祖。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Kan’ana (Ɗan Ham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Autan ɗan Ham, kuma jikan Nuhu. Ana ɗaukar Kan’ana a matsayin kakan Kan’aniyawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "कनान (हाम का पुत्र)",
      "descriptions": [
        {
          "source": "acai",
          "description": "हाम का सबसे छोटा पुत्र, और नूह का पोता। कनान को कनानियों का पूर्वज माना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kanaan (Anak Ham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak bungsu Ham, dan cucu Nuh. Kanaan dianggap sebagai leluhur orang Kanaan."
        }
      ]
    },
    "por": {
      "preferred_label": "Canaã (filho de Cam)",
      "descriptions": [
        {
          "source": "acai",
          "description": "O filho mais novo de Cam e neto de Noé. Considera-se que Canaã é o ancestral dos cananeus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ханаан (сын Хама)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Младший сын Хама и внук Ноя. Ханаан считается родоначальником хананеев."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kanaani (Mwana wa Hamu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana mdogo kabisa wa Hamu, na mjukuu wa Noa. Kanaani anadhaniwa kuwa babu wa Wakanaani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kenan (Pikinini man bilong Ham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba tri pikinini man bilong Ham na tumbuna pikinini bilong Noa. Ol i ting Kenan em i tumbuna bilong ol Kenan."
        }
      ]
    },
    "apd": {
      "preferred_label": "كنعان (ولد حام)",
      "descriptions": [
        {
          "source": "acai",
          "description": "أصغر أولاد حام، وحفيد لنوح. كنعان بيعتبر أب أو جد الكنعانيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kenan (Pikinini boe blong Ham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Smol pikinini boe blong Ham, mo wan smolbubu blong Noa. Oli ting se Kenan hem i stamba bubu blong ol man Kenan."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kenan (Nwa Ham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa ikpeazụ nke Ham, na nwa nwa Noa. A na-eche na Kenan bụ nna nna ndị Kenan."
        }
      ]
    },
    "nep": {
      "preferred_label": "कनान (हामका छोरा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "हामका कान्छा छोरा र नोआका नाति। कनानलाई कनानीहरूका पुर्खा मानिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ca-na-an (con trai của Cham)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai út của Cham và là cháu nội của Nô-ê. Ca-na-an được coi là tổ phụ của người Ca-na-an."
        }
      ]
    },
    "zht": {
      "preferred_label": "迦南 (含的兒子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "含最小的兒子，挪亞的孫子。迦南被認為是迦南人的祖先。"
        }
      ]
    }
  },
