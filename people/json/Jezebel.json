  "localizations": {
    "eng": {
      "preferred_label": "Jezebel",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jezebel",
          "article": "person:Jezebel",
          "description": "A queen of Israel during the divided kingdom, daughter of Ethbaal, wife of Ahab, and mother of Ahaziah and Joram."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِيزَابَل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملكة إسرائيل في زمن المملكة المنقسمة، ابنة أثبعل، وزوجة أخآب، وأم أخزيا ويورام."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耶洗别",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期的以色列王后，谒巴力的女儿，亚哈的妻子，亚哈谢和约兰的母亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jézabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Reine d'Israël à l'époque du royaume divisé, fille d'Ethbaal, femme d'Achab et mère d'Achazia et de Joram."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yezebel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarauniyar Isra’ila a lokacin rarrabuwar masarauta, ’yar Etba’al, matar Ahab, kuma uwar Ahaziya da Yoram."
        }
      ]
    },
    "hin": {
      "preferred_label": "ईजेबेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के समय इस्राएल की एक रानी, एतबाल की बेटी, अहाब की पत्नी, और अहज्याह तथा योराम की माता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Izebel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ratu Israel pada masa kerajaan terpecah, anak perempuan Etbaal, istri Ahab, dan ibu dari Ahazia dan Yoram."
        }
      ]
    },
    "por": {
      "preferred_label": "Jezabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma rainha de Israel durante o reino dividido, filha de Etbaal, esposa de Acabe e mãe de Acazias e Jorão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иезавель",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царица Израиля во времена разделенного царства, дочь Ефваала, жена Ахава и мать Охозии и Иорама."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jezabel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Reina de Israel durante el reino dividido, hija de Ethbaal, esposa de Acab y madre de Ocozías y Joram."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yezebeli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Malkia wa Israeli wakati wa ufalme uliogawanyika, binti wa Ethbaali, mke wa Ahabu, na mama yao Ahazia na Yoramu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jesebel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kwin bilong Israel long taim kingdom i bruh, pikinini meri bilong Etbal, meri bilong Ahap, na mama bilong Ahasia tupela Joram."
        }
      ]
    },
    "apd": {
      "preferred_label": "إيزابل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملكة إسرائيل في زمن المملكة المنقسمة، بت إثبعل، ومَرة أخاب، وأم أخزيا ويورام."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jesebel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kwin blong Isrel long taem we kingdom i seraot, dota blong Etbal, woman blong Ahab, mo mama blong Ahasia mo Joram."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jezebel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze nwaanyị Izrel n'oge alaeze kewara ekewa, nwa nwaanyị Etbaal, nwunye Ehab, na nne Ahazaya na Joram."
        }
      ]
    },
    "nep": {
      "preferred_label": "ईजेबेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा इस्राएलकी रानी, एतबालकी छोरी, आहाबकी पत्‍नी, र अहस्याह तथा योरामकी आमा।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giê-sa-bên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vương hậu của Y-sơ-ra-ên trong thời kỳ vương quốc phân chia, con gái của Ết-ba-an, vợ của A-háp, và mẹ của A-cha-xia và Giô-ram."
        }
      ]
    },
    "zht": {
      "preferred_label": "耶洗別",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期的以色列王后，謁巴利的女兒，亞哈的妻子，亞哈謝和約蘭的母親。"
        }
      ]
    }
  },
