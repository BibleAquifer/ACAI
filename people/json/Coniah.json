  "localizations": {
    "eng": {
      "preferred_label": "Coniah (Jehoiachin)",
      "alternate_labels": [
        "Jehoiachin"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jehoiachin",
          "article": "person:Coniah",
          "description": "Coniah, also known as Jehoiachin, was a king of Judah taken captive to Babylon by Nebuchadnezzar."
        }
      ]
    },
    "fra": {
      "preferred_label": "Conia (Jojakin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Conia, également connu sous le nom de Jojakin, était un roi de Juda emmené captif à Babylone par Nebucadnetsar."
        }
      ]
    },
    "spa": {
      "preferred_label": "Conías (Joaquín)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Conías, también conocido como Joaquín, fue un rey de Judá llevado cautivo a Babilonia por Nabucodonosor."
        }
      ]
    },
    "arb": {
      "preferred_label": "كُنْيَاهُو (يَهويَاكِين)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كان كُنْيَاهو، المعروف أيضًا باسم يَهويَاكِين، ملكًا ليهوذا سباه نبوخذنصر إلى بابل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哥尼雅 (约雅斤)",
      "descriptions": [
        {
          "source": "acai",
          "description": "哥尼雅又名约雅斤，是一位被尼布甲尼撒掳到巴比伦的犹大王。"
        }
      ]
    },
    "hin": {
      "preferred_label": "कोन्याह (यहोयाकीन)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कोन्याह, जिसे यहोयाकीन के नाम से भी जाना जाता है, यहूदा का एक राजा था जिसे नबूकदनेस्सर द्वारा बन्दी बनाकर बाबेल ले जाया गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Konya (Yoyakhin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Konya, yang juga dikenal sebagai Yoyakhin, adalah seorang raja Yehuda yang ditawan ke Babel oleh Nebukadnezar."
        }
      ]
    },
    "por": {
      "preferred_label": "Conias (Joaquim)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Conias, também conhecido como Joaquim, foi um rei de Judá levado cativo para a Babilônia por Nabucodonosor."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иехония (Иехояхин)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Иехония, также известный как Иехояхин, был царем Иудеи, уведенным в плен в Вавилон Навуходоносором."
        }
      ]
    },
    "swh": {
      "preferred_label": "Konia (Yehoyakini)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Konia, aliyejulikana pia kama Yehoyakini, alikuwa mfalme wa Yuda aliyechukuliwa mateka kwenda Babeli na Nebukadneza."
        }
      ]
    },
    "apd": {
      "preferred_label": "كنياه (يهوياكين)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كنياه، المعروف كمان بـ يهوياكين، كان ملك على يهوذا وسباه نبوخذنصر لبابل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Konaea (Jehoeakin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Konaea, we nem blong hem Jehoeakin tu, i wan king blong Juta we Nebukadnesa i tekem hem i go kalabus long Babilon."
        }
      ]
    },
    "hau": {
      "preferred_label": "Koniya (Yehohiyacin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Koniya, wanda kuma aka sani da Yehohiyacin, sarki ne na Yahuda wanda Nebukadnezzar ya kora zuwa bauta a Babilon."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Konaya (Jehoiakin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Konaya, nke a makwaara dị ka Jehoiakin, bụ eze Juda nke Nebukadneza dọtara nʼagha gaa Babilọn."
        }
      ]
    },
    "nep": {
      "preferred_label": "कोन्याह (यहोयाकीन)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कोन्याह, जसलाई यहोयाकीन पनि भनिन्छ, नबूकदनेसरद्वारा बेबिलोनमा कैदी बनाएर लगिएका यहूदाका राजा थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Konia (Jehoiakin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Konia, em narapela nem bilong en Jehoiakin, em i wanpela king bilong Juda em Nebukatnesar i bin kisim em i go kalabus long Babilon."
        }
      ]
    },
    "vie": {
      "preferred_label": "Cô-nia (Giê-hô-gia-kin)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cô-nia, còn được gọi là Giê-hô-gia-kin, là một vị vua của Giu-đa bị Nê-bu-cát-nết-sa bắt đày sang Ba-by-lôn."
        }
      ]
    },
    "zht": {
      "preferred_label": "哥尼雅（約雅斤）",
      "descriptions": [
        {
          "source": "acai",
          "description": "哥尼雅，又名約雅斤，是猶大國的一位國王，被尼布甲尼撒擄到巴比倫。"
        }
      ]
    }
  },
