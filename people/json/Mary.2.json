  "localizations": {
    "eng": {
      "preferred_label": "Mary",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Mary",
          "article": "person:Mary.2",
          "description": "A disciple of Jesus who was among the myrhhbearing women. She was the mother of James and Joseph (Joses)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Marie",
      "descriptions": [
        {
          "source": "acai",
          "description": "Disciple de Jésus qui faisait partie des myrophores. Elle était la mère de Jacques et de Joseph (Joses)."
        }
      ]
    },
    "spa": {
      "preferred_label": "María",
      "descriptions": [
        {
          "source": "acai",
          "description": "Discípula de Jesús que estuvo entre las mujeres miróforas. Era la madre de Jacobo y de José."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَرْيَم",
      "descriptions": [
        {
          "source": "acai",
          "description": "تِلْمِيذَةٌ لِيَسُوعَ كَانَتْ بَيْنَ حَامِلَاتِ الطِّيبِ. وَكَانَتْ أُمَّ يَعْقُوبَ وَيُوسِي (يُوسُفَ)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "马利亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶稣的女门徒，也是携香料前往坟墓的妇女之一。她是雅各和约西（约瑟）的母亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Maryamu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata almajirar Yesu wadda take cikin matan da suka ɗauki kayan ƙanshi. Ita ce uwar Yaƙub da Yusuf (Yoses)."
        }
      ]
    },
    "hin": {
      "preferred_label": "मरियम",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु की एक शिष्या जो सुगन्धित द्रव्य ले जाने वाली स्त्रियों में शामिल थी। वह याकूब और यूसुफ (योसेस) की माता थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Maria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang murid Yesus yang termasuk di antara para perempuan pembawa mur. Ia adalah ibu dari Yakobus dan Yusuf (Yoses)."
        }
      ]
    },
    "por": {
      "preferred_label": "Maria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Discípula de Jesus que esteve entre as mulheres miróforas. Era mãe de Tiago e José."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мария",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ученица Иисуса, входившая в число жен-мироносиц. Она была матерью Иакова и Иосии (Иосифа)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mariamu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanafunzi wa Yesu aliyekuwa miongoni mwa wanawake waliobeba manukato. Alikuwa mama yao Yakobo na Yusufu (Yose)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Maria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela disaipel bilong Jisas em i bin i stap namel long ol meri i bin karim wel i go long matmat. Em i mama bilong Jems tupela Josep (Joses)."
        }
      ]
    },
    "apd": {
      "preferred_label": "مريم",
      "descriptions": [
        {
          "source": "acai",
          "description": "تلميذة ليسوع كانت من بين حاملات الطيب. وهي كانت أم يعقوب ويوسف (يوسي)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Meri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan disaepol blong Jisas we i wan long ol woman we oli karem lif we i gat gudfala smel i go. Hem i mama blong Jemes mo Josef (Joses)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Meri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu onye na-eso ụzọ Jisọs nke so nʼime ndị inyom bu mmanụ na-esi ísì ụtọ. Ọ bụ nne Jemis na Josef (Joses)."
        }
      ]
    },
    "nep": {
      "preferred_label": "मरियम",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूकी एक चेली जो सुगन्धित मसला बोक्ने स्त्रीहरूमध्ये थिइन्। उनी याकूब र योसेफ (जोसेस) की आमा थिइन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-ri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một môn đệ của Chúa Giê-xu thuộc nhóm các phụ nữ mang hương liệu. Bà là mẹ của Gia-cơ và Giô-sép (Giô-sê)."
        }
      ]
    },
    "zht": {
      "preferred_label": "馬利亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶穌的女門徒，屬於帶香膏前往墳墓的婦女之一。她是雅各和約西（約瑟）的母親。"
        }
      ]
    }
  },
