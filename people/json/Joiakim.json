      "preferred_label": "Joiakim",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Joiakim",
          "article": "person:Joiakim",
          "description": "A priest during the Israelite exile and return. He was a son of Joshua, and father of Eliashib."
        }
      ]
    },
    "fra": {
      "preferred_label": "Jojakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un prêtre pendant l'exil et le retour des Israélites. Il était fils de Josué et père d'Éliaschib."
        }
      ]
    },
    "spa": {
      "preferred_label": "Joaquim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sacerdote durante el exilio y retorno de los israelitas. Fue hijo de Jesúa y padre de Eliasib."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُويَاقِيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "كاهن عاش خلال فترة سبي بني إسرائيل والرجوع منه. كان ابن يشوع، وأبا ألياشيب."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约雅金",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人流亡与回归时期的一位祭司。他是约书亚的儿子，以利亚实的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yohiyakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani firist a lokacin bauta da komowar Isra'ilawa. Ya kasance ɗan Yoshuwa, kuma mahaifin Eliyashib."
        }
      ]
    },
    "hin": {
      "preferred_label": "योयाकीम",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलियों के बंधुवाई और वापसी के समय का एक याजक। वह यहोशू का पुत्र और एल्याशीब का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yoyakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang imam pada masa pembuangan dan pemulangan Israel. Ia adalah anak Yosua, dan ayah Elyasib."
        }
      ]
    },
    "por": {
      "preferred_label": "Joiaquim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um sacerdote durante o exílio e o retorno israelita. Ele era filho de Josué e pai de Eliasibe."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иоаким",
      "descriptions": [
        {
          "source": "acai",
          "description": "Священник во время вавилонского пленения и возвращения из него. Сын Иисуса и отец Елиашива."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yoyakimu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhani wakati wa uhamisho wa Waisraeli na kurudi kwao. Alikuwa mwana wa Yoshua, na baba wa Eliashibu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Joiakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pris long taim ol Israel i stap kalabus na taim ol i go bek long graun bilong ol. Em i pikinini man bilong Josua, na papa bilong Eliasip."
        }
      ]
    },
    "apd": {
      "preferred_label": "يوياقيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "كاهن عاش وكت السبي والرجوع لبني إسرائيل. كان ولد يشوع، وأبو ألياشيب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Joeakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pris long taem blong eksael mo kambak blong ol laen blong Isrel. Hem i wan pikinini man blong Josua, mo papa blong Eliasib."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Joiakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye nchụaja nʼoge nchụpụ na nloghachi ndị Izrel. Ọ bụ nwa Joshua, na nna Eliashib."
        }
      ]
    },
    "nep": {
      "preferred_label": "योयाकीम",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएली निर्वासन र फिर्तीको समयका एक पुजारी। तिनी येशूअका छोरा र एल्‍यासीबका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-gia-kim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thầy tế lễ trong thời kỳ dân Y-sơ-ra-ên bị lưu đày và hồi hương. Ông là con của Giê-sua và là cha của Ê-li-a-síp."
        }
      ]
    },
    "zht": {
      "preferred_label": "約雅金",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人被擄與回歸時期的祭司。他是耶書亞的兒子，也是以利亞實的父親。"
        }
      ]
    }
  },
