{
  "id": "person:Informant",
  "primary_id": "person:Informant",
  "type": "person",
  "localizations": {
    "eng": {
      "preferred_label": "An Informant",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "An Informant",
          "description": "A person disclosing unknown (and usually negative) information."
        }
      ]
    },
    "apd": {
      "preferred_label": "مخبّر",
      "descriptions": [
        {
          "source": "acai",
          "description": "زول بيكشف معلومات ما كانت معروفة (وغالباً بتكون سالبة)."
        }
      ]
    },
    "arb": {
      "preferred_label": "مُخْبِر",
      "descriptions": [
        {
          "source": "acai",
          "description": "شخص يكشف عن معلومات غير معروفة (وغالباً ما تكون سلبية)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Man we i karem nius i kam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i stap talemaot samting we narafala i no save (mo plante taem i wan rabis nius)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Un informateur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personne divulguant une information inconnue (et généralement négative)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mai ba da labari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutumin da ke tona asiri ko bayyana wani labari da ba a sani ba (kuma yawanci mara daɗi)."
        }
      ]
    },
    "hin": {
      "preferred_label": "सूचना देने वाला",
      "descriptions": [
        {
          "source": "acai",
          "description": "अज्ञात (और सामान्यतः नकारात्मक) जानकारी प्रकट करने वाला व्यक्ति।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Onye na-enye ozi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye na-ekpughe ozi a na-amaghị (nke na-abụkarị ihe ọjọọ)."
        }
      ]
    },
    "ind": {
      "preferred_label": "Pemberi informasi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seseorang yang memberitahukan informasi yang belum diketahui (dan biasanya bernada negatif)."
        }
      ]
    },
    "nep": {
      "preferred_label": "सूचना दिने व्यक्ति",
      "descriptions": [
        {
          "source": "acai",
          "description": "अज्ञात (र प्रायः नकारात्मक) जानकारी प्रकट गर्ने व्यक्ति।"
        }
      ]
    },
    "por": {
      "preferred_label": "Informante",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma pessoa que revela informações desconhecidas (e geralmente negativas)."
        }
      ]
    },
    "rus": {
      "preferred_label": "доносчик",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, сообщающий неизвестную (и обычно неблагоприятную) информацию."
        }
      ]
    },
    "spa": {
      "preferred_label": "informante",
      "descriptions": [
        {
          "source": "acai",
          "description": "Persona que revela información desconocida (y por lo general negativa)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mtoa taarifa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu anayetoa taarifa isiyojulikana (na kwa kawaida isiyo nzuri)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Man bilong autim tok hait",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man i autim tok hait (planti taim em samting i no gutpela)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người báo tin",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người tiết lộ thông tin chưa biết (và thường là tiêu cực)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "告密者",
      "descriptions": [
        {
          "source": "acai",
          "description": "透露未知（且通常是负面）信息的人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "報信者",
      "descriptions": [
        {
          "source": "acai",
          "description": "透露未知（通常是負面）消息的人。"
        }
      ]
    }
  },
