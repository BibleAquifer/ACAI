      ]
    },
    "tpi": {
      "preferred_label": "Nimrot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nimrot em i wanpela strongpela man bilong painim abus na hetman, em ol i tok em i namba wan bikpela soldia long graun."
        }
      ]
    },
    "apd": {
      "preferred_label": "نمرود",
      "descriptions": [
        {
          "source": "acai",
          "description": "نمرود كان صياد جبار وحاكم، ووصوف بأنه أول جبار في الأرض."
        }
      ]
    },
    "bis": {
      "preferred_label": "Nimrod",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nimrod hem i bin wan strong man blong lukaot anamol mo wan rula, we oli tokbaot hem olsem fas nambawan man blong faet long wol."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nimrọd",
