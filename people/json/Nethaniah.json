  "localizations": {
    "eng": {
      "preferred_label": "Nethaniah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Nethaniah",
          "article": "person:Nethaniah",
          "description": "A son of Elishama and father of Ishmael, who opposed Governor Gedaliah during the time of the Prophet Jeremiah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Nethania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d’Élischama et père d’Ismaël, qui s’opposa au gouverneur Guedalia à l’époque du prophète Jérémie."
        }
      ]
    },
    "spa": {
      "preferred_label": "Netanías",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Elisama y padre de Ismael, quien se opuso al gobernador Guedalías durante la época del profeta Jeremías."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَثَنْيَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن أَلِيشَمَع ووالد إِسْمَاعِيل، الذي قاوم الحاكم جَدَلْيَا في زمن النبي إرميا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "尼探雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "以利沙玛的儿子，以实玛利的父亲；在先知耶利米时代反对省长基大利。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Netaniya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Elishama kuma mahaifin Ishmayel, wanda ya yi hamayya da Gwamna Gedaliya a zamanin Annabi Irmiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "नतन्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "एलीशामा का एक पुत्र और इश्माएल का पिता, जिसने भविष्यद्वक्ता यिर्मयाह के समय में राज्यपाल गदल्याह का विरोध किया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Netanya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak Elisama dan ayah dari Ismael, yang menentang Gubernur Gedalya pada zaman Nabi Yeremia."
        }
      ]
    },
    "por": {
      "preferred_label": "Netanias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Elisama e pai de Ismael, que se opôs ao governador Gedalias durante o tempo do profeta Jeremias."
        }
      ]
    },
    "rus": {
      "preferred_label": "Нефания",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Елисамы и отец Исмаила, противостоявший наместнику Годолии во времена пророка Иеремии."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nethania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Elishama na babaye Ishmaeli, aliyepingana na Gavana Gedalia wakati wa Nabii Yeremia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Netania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Elisama na papa bilong Ismael, em i bin birua long Gavana Gedalia long taim bilong profet Jeremaia."
        }
      ]
    },
    "apd": {
      "preferred_label": "نثنيا",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد أليشمع وأبو إسماعيل، عارض الحاكم جدليا في زمن النبي إرميا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Netania",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Elisama mo papa blong Ismael, we i bin agensem Gavana Gedalia long taem blong Profet Jeremaea."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Netanaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Elishama na nna Ishmel, onye megidere Gọvanọ Gedaliya nʼoge Onye Amụma Jeremaya."
        }
      ]
    },
    "nep": {
      "preferred_label": "नतन्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "एलीशामाका छोरा र इश्माएलका पिता, जसले अगमवक्ता यर्मियाको समयमा राज्यपाल गदल्याहको विरोध गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Nê-tha-nia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của Ê-li-sa-ma và là cha của Ích-ma-ên, người đã chống lại Tổng đốc Ghê-đa-lia vào thời Tiên tri Giê-rê-mi."
        }
      ]
    },
    "zht": {
      "preferred_label": "尼探雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "以利沙瑪的兒子，以實瑪利的父親；以實瑪利在先知耶利米時代反抗省長基大利。"
        }
      ]
    }
  },
