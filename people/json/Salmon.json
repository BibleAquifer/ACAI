  "localizations": {
    "eng": {
      "preferred_label": "Salmon",
      "alternate_labels": [
        "Sala",
        "Salma"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Salmon",
          "article": "person:Salmon",
          "description": "Husband of Rahab the prostitute, the father of Boaz, and son of Nahshon. He is in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَلْمون",
      "descriptions": [
        {
          "source": "acai",
          "description": "زوج رَاحَاب الزانية، ووالد بوعَز، وابن نَحْشونَ. وهو في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "撒门",
      "descriptions": [
        {
          "source": "acai",
          "description": "妓女喇合的丈夫，波阿斯的父亲，拿顺的儿子。他在耶稣的家谱中。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Salmon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mijin Rahab karuwa, mahaifin Bowaz, kuma ɗan Nashon. Yana cikin layin iyalin Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "सलमोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "राहाब वेश्या का पति, बोअज का पिता और नहशोन का पुत्र। वह यीशु की वंशावली में शामिल है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Salmon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suami dari Rahab si pelacur, ayah dari Boas, dan anak dari Nahason. Ia termasuk dalam garis keturunan Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Salmom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Marido de Raabe, a prostituta, pai de Boaz e filho de Naassom. Ele está na linhagem genealógica de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Салмон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Муж блудницы Раав, отец Вооза и сын Наассона. Он входит в родословие Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Salmón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esposo de Rahab la prostituta, padre de Booz e hijo de Nahasón. Pertenece a la línea genealógica de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Salmoni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mume wa Rahabu yule kahaba, baba yake Boazi, na mwana wa Nashoni. Yumo katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Salmon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man bilong pamukmeri Rahap, papa bilong Boas, na pikinini man bilong Nason. Em i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "سلمون",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل راحاب الزانية، وأبو بوعز، وولد نحشون. هو في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Salmon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man blong Rahab woman blong pampele ya, papa blong Boas, mo pikinini man blong Nason. Hem i stap long laen blong Jisas."
        }
      ]
    },
    "fra": {
      "preferred_label": "Salmon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Époux de Rahab la prostituée, père de Boaz et fils de Naasson. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Salmọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Di Rehab bụ nwanyị akwụna ahụ, nna Boaz, na nwa Neshọn. Ọ nọ nʼusoro ọmụmụ nke Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "सल्मोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "वेश्या राहाबका पति, बोअजका पिता र नहशोनका छोरा। उनी येशूको वंशावलीमा पर्छन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sanh-môn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chồng của kỵ nữ Ra-háp, cha của Bô-ô, và là con trai của Na-ách-son. Ông thuộc dòng dõi của Chúa Cứu Thế Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "撒門",
      "descriptions": [
        {
          "source": "acai",
          "description": "妓女喇合的丈夫、波阿斯的父親、拿順的兒子。他在耶穌的家譜譜系中。"
        }
      ]
    }
  },
