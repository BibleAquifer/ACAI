  "localizations": {
    "eng": {
      "preferred_label": "Eliab (Son of Jesse)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Eliab (Son of Jesse)",
          "article": "person:Eliab.3",
          "description": "First-born son of Jesse, member of Saul's army, and King David’s oldest brother."
        }
      ]
    },
    "fra": {
      "preferred_label": "Éliab (fils d'Isaï)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils premier-né d'Isaï, membre de l'armée de Saül et frère aîné du roi David."
        }
      ]
    },
    "spa": {
      "preferred_label": "Eliab (hijo de Isaí)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo primogénito de Isaí, miembro del ejército de Saúl y hermano mayor del rey David."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَلِيآب (ابن يَسَّى)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن يَسَّى البكر، وأحد أفراد جيش شاول، والأخ الأكبر للملك دَاوُد."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以利押 (耶西之子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶西的长子，扫罗军队的成员，大卫王的长兄。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Eliyab (Ɗan Yesse)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan fari na Yesse, ɗan rundunar sojojin Shawulu, kuma babban wan Sarki Dawuda."
        }
      ]
    },
    "hin": {
      "preferred_label": "एलीआब (यिशै का पुत्र)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यिशै का पहलौठा पुत्र, शाऊल की सेना का एक योद्धा, और राजा दाऊद का सबसे बड़ा भाई।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Eliab (anak Isai)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak sulung Isai, anggota tentara Saul, dan kakak tertua Raja Daud."
        }
      ]
    },
    "por": {
      "preferred_label": "Eliabe (filho de Jessé)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho primogênito de Jessé, membro do exército de Saul e irmão mais velho do rei Davi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Елиав (сын Иессея)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первенец Иессея, воин в войске Саула и старший брат царя Давида."
        }
      ]
    },
    "swh": {
      "preferred_label": "Eliabu (Mwana wa Yese)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mzaliwa wa kwanza wa Yese, mshiriki wa jeshi la Sauli, na kaka mkubwa wa Mfalme Daudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Eliap (Pikinini man bilong Jesi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba wan pikinini man bilong Jesi, wanpela soldia bilong ami bilong Sol, na bikpela brata bilong King Devit."
        }
      ]
    },
    "apd": {
      "preferred_label": "أليآب (ولد يسى)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد يسى البكر، وعضو في جيش شاول، وأكبر إخوان الملك داود."
        }
      ]
    },
    "bis": {
      "preferred_label": "Eliab (Pikinini boe blong Jese)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasbon pikinini boe blong Jese, memba blong ami blong Sol, mo bigfala brata blong King Deved."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Eliab (Nwa Jesi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọkpara Jesi, onye agha nʼusuu ndị agha Sọl, na nwanne nwoke nke okenye nke Eze Devid."
        }
      ]
    },
    "nep": {
      "preferred_label": "एलीआब (यिशैका छोरा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यिशैका जेठा छोरा, शाऊलको सेनाका सदस्य, र राजा दाऊदका सबैभन्दा जेठा दाजु।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-li-áp (Con của Gie-sê)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai trưởng của Gie-sê, một binh lính trong quân đội của Sau-lơ, và là anh cả của Vua Đa-vít."
        }
      ]
    },
    "zht": {
      "preferred_label": "以利押 (耶西之子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶西的長子，掃羅軍隊的一員，大衛王的長兄。"
        }
      ]
    }
  },
