    "ibo": {
      "preferred_label": "Livayị (Matiu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye ọna ụtụ nke mechara bụrụ otu nʼime ndị ozi iri na abụọ ahụ, onye a na-akpọkwa Matiu."
        }
      ]
    },
