        "Shimei"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Obed-Edom",
          "article": "person:Obed-edom",
          "description": "A Gittite in whose house the ark of the covenat was stored during King David's reign."
        }
      ]
    },
    "hau": {
      "preferred_label": "Obed-Edom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutumin Gat wanda aka ajiye akwatin alkawari a gidansa a lokacin sarautar Sarki Dawuda."
        }
      ]
    },
    "hin": {
      "preferred_label": "ओबेदेदोम",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक गतवासी जिसके घर में राजा दाऊद के शासनकाल के दौरान वाचा का सन्दूक रखा गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Obed-Edom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang Gat yang rumahnya menjadi tempat penyimpanan tabut perjanjian pada masa pemerintahan Raja Daud."
        }
      ]
    },
    "por": {
      "preferred_label": "Obede-Edom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um geteu em cuja casa a arca da aliança ficou guardada durante o reinado do rei Davi."
        }
      ]
    },
    "spa": {
      "preferred_label": "Obed-edom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un geteo en cuya casa se guardó el arca del pacto durante el reinado del rey David."
        }
      ]
    },
    "swh": {
      "preferred_label": "Obed-Edomu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mgiti ambaye nyumbani kwake sanduku la agano lilihifadhiwa wakati wa utawala wa Mfalme Daudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Obetidom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong Git em Bokis Kontrak bilong Bikpela i bin stap long haus bilong en long taim King Devit i stap king."
        }
      ]
    },
    "apd": {
      "preferred_label": "عوبيد أدوم",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل جتي اتحفظ تابوت العهد في بيته في عهد الملك داود."
        }
      ]
    },
    "arb": {
      "preferred_label": "عُوبِيدَ أَدُومَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "جَتِّيٌّ وُضع تابوت العهد في بيته خلال عهد الملك داود."
        }
      ]
    },
    "bis": {
      "preferred_label": "Obededom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man Git we oli bin putum Bokis blong Kontrak long haos blong hem long taem we King Deved i rula."
        }
      ]
    },
    "fra": {
      "preferred_label": "Obed-Édom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un Guittien dans la maison duquel l'arche de l'alliance fut gardée pendant le règne du roi David."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Obed-Edọm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye Git nke e doro igbe ọgbụgba ndụ nʼụlọ ya nʼoge ọchịchị Eze Devid."
        }
      ]
    },
    "nep": {
      "preferred_label": "ओबेद-एदोम",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक जना गित्ती, जसको घरमा राजा दाऊदको शासनकालमा करारको सन्दुक राखिएको थियो।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Аведдар",
      "descriptions": [
        {
          "source": "acai",
          "description": "Гефянин, в доме которого находился ковчег завета во время правления царя Давида."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ô-bết Ê-đôm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người Ghít mà Hòm Giao Ước đã được lưu giữ tại nhà ông trong suốt triều đại Vua Đa-vít."
        }
      ]
    },
    "zhs": {
      "preferred_label": "俄别·以东",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王统治时期约柜存放在其家中的迦特人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "俄別‧以東",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦特人，大衛王統治期間約櫃曾存放在他的家中。"
        }
      ]
    }
  },
