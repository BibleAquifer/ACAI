  "localizations": {
    "eng": {
      "preferred_label": "Amnon",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Amnon",
          "article": "person:Amnon",
          "description": "The firstborn son of King David by Ahinoam. Amnon raped his half-sister, Tamar, and was killed by his half-brother Absalom."
        }
      ]
    },
    "fra": {
      "preferred_label": "Amnon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils premier-né du roi David et d’Achinoam. Amnon viola sa demi-sœur Tamar et fut tué par son demi-frère Absalom."
        }
      ]
    },
    "spa": {
      "preferred_label": "Amnón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo primogénito del rey David con Ahinoam. Amnón violó a su media hermana Tamar y fue asesinado por su medio hermano Absalón."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَمْنُون",
      "descriptions": [
        {
          "source": "acai",
          "description": "بكر الملك داود من أخينوعم. اغتصب أخته غير الشقيقة ثامار، فقتله أخوه غير الشقيق أبشالوم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "暗嫩",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王与亚希暖所生的长子。暗嫩强暴了同父异母的妹妹他玛，后被同父异母的兄弟押沙龙所杀。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Amnon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan fari na Sarki Dawuda ta wurin Ahinowam. Amnon ya yi wa ’yar’uwarsa Tamar fyaɗe, sai ɗan’uwansa Absalom ya kashe shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "अम्नोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "अहीनोअम से उत्पन्न राजा दाऊद का जेठा पुत्र। अम्नोन ने अपनी सौतेली बहन तामार के साथ बलात्कार किया, और उसके सौतेले भाई अबशालोम ने उसे मार डाला।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Amnon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak sulung Raja Daud dari Ahinoam. Amnon memperkosa adik tirinya, Tamar, dan dibunuh oleh saudara tirinya, Absalom."
        }
      ]
    },
    "por": {
      "preferred_label": "Amnom",
      "descriptions": [
        {
          "source": "acai",
          "description": "O filho primogênito do rei Davi com Ainoã. Amnom violentou sua meia-irmã Tamar e foi morto por seu meio-irmão Absalão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Амнон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первенец царя Давида от Ахиноамы. Амнон обесчестил свою единокровную сестру Фамарь и был убит своим единокровным братом Авессаломом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Amnoni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa kwanza wa Mfalme Daudi aliyezaliwa na Ahinoamu. Amnoni alimbaka dada yake wa kambo, Tamari, naye aliuawa na ndugu yake wa kambo Absalomu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Amnon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba wan pikinini man bilong King Devit wantaim Ahinoam. Amnon i bin mekim pasin pamuk long susa bilong en Tamar na hafbrata bilong en Apsalom i kilim em i dai."
        }
      ]
    },
    "apd": {
      "preferred_label": "أمنون",
      "descriptions": [
        {
          "source": "acai",
          "description": "الولد البكر للملك داود من أخينوعم. أمنون اغتصب أخته غير الشقيقة ثامار، وكتلو أخوه غير الشقيق أبشالوم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Amnon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasbon pikinini boe blong King Deved wetem Ahinoam. Amnon i fosem haf-sista blong hem Tamara blong slip wetem hem, nao haf-brata blong hem Absalom i kilim hem i ded."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Amnọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọkpara Eze Devid nke Ahinoam mụrụ. Amnọn dinara Tama nwanne ya nwanyị nʼike, Absalọm nwanne ya nwoke wee gbuo ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "अमनोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "अहीनोमद्वारा जन्मेका राजा दाऊदका जेठा छोरा। अमनोनले आफ्नी सौतेनी बहिनी तामारलाई बलात्कार गरे र आफ्ना सौतेना भाइ अबशालोमद्वारा मारिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Am-nôn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai trưởng của Vua Đa-vít với bà A-hi-nô-am. Am-nôn đã cưỡng hiếp em gái cùng cha khác mẹ của mình là Ta-ma, và bị người anh em cùng cha khác mẹ là Áp-sa-lôm giết chết."
        }
      ]
    },
    "zht": {
      "preferred_label": "暗嫩",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王與亞希暖所生的長子。暗嫩玷污了他的同父異母妹她瑪，後被同父異母弟押沙龍殺害。"
        }
      ]
    }
  },
