        }
      ]
    },
    "nep": {
      "preferred_label": "अदोनिसेदेक",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहोशूको समयमा यरूशलेमका राजा, जसको पहिलो उल्लेख यहोशू १०:१ मा पाइन्छ।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Адониседек",
