        }
      ]
    },
    "arb": {
      "preferred_label": "أَدُونِي صَادَقَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَلِكُ أُورُشَلِيمَ فِي زَمَنِ يَشُوعَ، ذُكِرَ لِأَوَّلِ مَرَّةٍ فِي يَشُوع 10: 1."
        }
      ]
    },
    "bis": {
      "preferred_label": "Adonijedek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong Jerusalem we i laef long taem blong Josua, we faswan tokbaot hem i stap long Josua 10:1."
        }
      ]
    },
    "hin": {
      "preferred_label": "अदोनीसेदेक",
