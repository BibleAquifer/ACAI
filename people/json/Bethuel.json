  "localizations": {
    "eng": {
      "preferred_label": "Bethuel",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Bethuel",
          "article": "person:Bethuel",
          "description": "An ancestor of the patriarch Abraham. Bethuel was a son of Nahor (Abraham's brother) and Milcah, and the father of Laban and Rebekah (the patriarch Isaac's wife)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Bethuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ancêtre du patriarche Abraham. Bethuel était un fils de Nachor (frère d'Abraham) et de Milca, et le père de Laban et de Rebecca (la femme du patriarche Isaac)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Betuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Antepasado del patriarca Abraham. Betuel fue hijo de Nacor (hermano de Abraham) y Milca, y padre de Labán y Rebeca (esposa del patriarca Isaac)."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَتُوئِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "أحد أسلاف إبراهيم. كان بتوئيل ابنًا لناحور (أخي إبراهيم) وملكة، ووالد لابان ورفقة (زوجة إسحاق)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "彼土利",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长亚伯拉罕的祖先。彼土利是拿鹤（亚伯拉罕的兄弟）和密迦的儿子，也是拉班和利百加（族长以撒的妻子）的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Betuwel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani kakan kakan nan Ibrahim. Betuwel ɗan Nahor ne (ɗan’uwan Ibrahim) da Milka, kuma mahaifin Laban da Rebeka (matar kakan nan Ishaƙu)."
        }
      ]
    },
    "hin": {
      "preferred_label": "बतूएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता अब्राहम का एक पूर्वज। बतूएल नाहोर (अब्राहम के भाई) और मिल्का का पुत्र था, तथा लाबान और रिबका (कुलपिता इसहाक की पत्नी) का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Betuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Leluhur dari bapa leluhur Abraham. Betuel adalah anak dari Nahor (saudara Abraham) dan Milka, serta ayah dari Laban dan Ribka (istri bapa leluhur Ishak)."
        }
      ]
    },
    "por": {
      "preferred_label": "Betuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um antepassado do patriarca Abraão. Betuel era filho de Naor (irmão de Abraão) e Milca, e pai de Labão e Rebeca (esposa do patriarca Isaque)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Вафуил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Предок патриарха Авраама. Вафуил был сыном Нахора (брата Авраама) и Милки, а также отцом Лавана и Ревекки (жены патриарха Исаака)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bethueli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babu wa baba wa taifa Abrahamu. Bethueli alikuwa mwana wa Nahori (ndugu wa Abrahamu) na Milka, na baba wa Labani na Rebeka (mke wa baba wa taifa Isaka)."
        }
      ]
    },
    "apd": {
      "preferred_label": "بتوئيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "جد من أجداد الأب القبلي إبراهيم. بتوئيل كان ولد ناحور (أخو إبراهيم) ومِلكة، وأبو لابان ورفقة (مرت الأب القبلي إسحاق)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Betuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan bubu blong Ebraham. Betuel hem i wan pikinini boe blong Naho (brata blong Ebraham) mo Milka, mo hem i papa blong Laban mo Rebeka (woman blong Aesak)."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Betuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nna nna ochie nke nna ochie bụ Ebraham. Betuel bụ nwa nwoke Nahọ (nwanne Ebraham) na Milka, ma bụrụ nna Leban na Ribeka (nwunye nna ochie bụ Aịzik)."
        }
      ]
    },
    "nep": {
      "preferred_label": "बतूएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता अब्राहामका एक पुर्खा। बतूएल नाहोर (अब्राहामका भाइ) र मिल्काका छोरा, तथा लाबान र रिबेका (कुलपिता इसहाककी पत्नी) का पिता थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Betuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela tumbuna bilong hetman Abraham. Betuel em i pikinini man bilong Nahor (brata bilong Abraham) wantaim Milka, na papa bilong Laban na Rebeka (meri bilong hetman Aisak)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bê-tu-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tổ phụ của Áp-ra-ham. Bê-tu-ên là con trai của Na-cô (em trai Áp-ra-ham) và Minh-ca, đồng thời là cha của La-ban và Rê-bê-ca (vợ của tổ phụ Y-sác)."
        }
      ]
    },
    "zht": {
      "preferred_label": "彼土利",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長亞伯拉罕的親族。彼土利是拿鶴（亞伯拉罕的兄弟）和密迦的兒子，也是拉班和利百加（族長以撒的妻子）的父親。"
        }
      ]
    }
  },
