  "localizations": {
    "eng": {
      "preferred_label": "Hazael",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hazael",
          "article": "person:Hazael",
          "description": "Anointed by the Prophet Elijah to be king of Syria, confirmed by the Prophet Elisha. Hazael seized power by murdering his predecessor, Ben-Hadad."
        }
      ]
    },
    "fra": {
      "preferred_label": "Hazaël",
      "descriptions": [
        {
          "source": "acai",
          "description": "Oint par le prophète Élie pour être roi de Syrie, ce que confirma le prophète Élisée. Hazaël s'empara du pouvoir en assassinant son prédécesseur, Ben-Hadad."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jazael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ungido por el profeta Elías para ser rey de Siria, confirmado por el profeta Eliseo. Jazael tomó el poder asesinando a su predecesor, Ben-adad."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَزَائِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسحه النبي إيليا ملكًا على أرام، وثبته النبي أليشع. استولى حزائيل على السلطة بقتل سلفه بنهدد."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈薛",
      "descriptions": [
        {
          "source": "acai",
          "description": "受先知以利亚膏立为叙利亚王，后由先知以利沙证实。哈薛通过谋杀其前任便·哈达篡夺王位。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hazayel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ananniyin Annabi Iliya domin yă zama sarkin Suriya (Aram), wanda Annabi Elisha ya tabbatar. Hazayel ya ƙwace mulki ta wurin kashe wanda ya gaje shi, wato Ben-Hadad."
        }
      ]
    },
    "hin": {
      "preferred_label": "हजाएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "सीरिया (अराम) के राजा होने के लिए भविष्यद्वक्ता एलिय्याह द्वारा अभिषिक्त, और भविष्यद्वक्ता एलीशा द्वारा संपुष्ट। हजाएल ने अपने पूर्ववर्ती बेन्हदद की हत्या करके सत्ता हथिया ली थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hazael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Diurapi oleh Nabi Elia untuk menjadi raja Aram, diteguhkan oleh Nabi Elisa. Hazael merebut kekuasaan dengan membunuh pendahulunya, Benhadad."
        }
      ]
    },
    "por": {
      "preferred_label": "Hazael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ungido pelo profeta Elias para ser rei da Síria, confirmado pelo profeta Eliseu. Hazael tomou o poder assassinando seu predecessor, Ben-Hadade."
        }
      ]
    },
    "rus": {
      "preferred_label": "Азаил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Помазан пророком Илией на царство над Сирией, утвержден пророком Елисеем. Азаил захватил власть, убив своего предшественника Венадада."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hazaeli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alitiwa mafuta na Nabii Eliya kuwa mfalme wa Shamu (Aramu), na kuthibitishwa na Nabii Elisha. Hazaeli alitwaa madaraka kwa kumuua mtangulizi wake, Ben-hadadi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hasael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Profet Elaija i bin kapsaitim wel long het bilong em bilong makim em i kamap king bilong Siria, na profet Elisa i bin mekim dispela tok i kamap strong. Hasael i bin kilim i dai Benhadat em king i bin stap paslain long em, na em i stilim dispela bikpela namba."
        }
      ]
    },
    "apd": {
      "preferred_label": "حزائيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسحه النبي إيليا عشان يبقى ملك على آرام (سوريا)، وأكده النبي أليشع. حزائيل استولى على السلطة بعد ما قتل سلفه بنهدد."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hasael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Profet Elaeja i anointem hem blong kam king blong Siria, mo Profet Elisa i konfemem samting ya. Hasael i tekem paoa taem hem i kilim i ded King Benadad we i rul bifo long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hazael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye onye amụma Ịlaịja tere mmanụ ka ọ bụrụ eze Siria, nke onye amụma Ịlaịsha mekwara ka o guzosie ike. Hazael weghaara ọchịchị site nʼigbu onye bu ya ụzọ, Ben-Hadad."
        }
      ]
    },
    "nep": {
      "preferred_label": "हजाएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "अगमवक्ता एलियाद्वारा अरामका राजा हुन अभिषेक गरिएका, अगमवक्ता एलीशाद्वारा पुष्टि गरिएका। हजाएलले आफ्ना पूर्ववर्ती बेन-हददको हत्या गरेर सत्ता कब्जा गरे।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-xa-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Được Tiên tri Ê-li xức dầu làm vua Sy-ri (A-ram), và được Tiên tri Ê-li-sê xác nhận. Ha-xa-ên đã đoạt lấy quyền lực bằng cách ám sát người tiền nhiệm là Bên-Ha-đát."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈薛",
      "descriptions": [
        {
          "source": "acai",
          "description": "由先知以利亞膏立為亞蘭王，並經先知以利沙證實。哈薛藉由謀殺其前任便‧哈達奪取權力。"
        }
      ]
    }
  },
