  "localizations": {
    "eng": {
      "preferred_label": "Eliakim",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Eliakim",
          "article": "person:Eliakim.3",
          "description": "A son of Hilkiah who was supervisor of King Hezekiah's household during the Assyrian king Sennacherib's attack on Judah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Éliakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Hilkija, qui était chef de la maison du roi Ézéchias lors de l'attaque de Juda par le roi assyrien Sennachérib."
        }
      ]
    },
    "spa": {
      "preferred_label": "Eliaquim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Hilcías que fue mayordomo del palacio del rey Ezequías durante el ataque a Judá por parte de Senaquerib, rey de Asiria."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَلِيَاقِيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱبْنُ حِلْقِيَّا ٱلَّذِي كَانَ نَاظِرًا عَلَى قَصْرِ ٱلْمَلِكِ حَزَقِيَّا أَثْنَاءَ هُجُومِ سَنْحَارِيبَ مَلِكِ أَشُّورَ عَلَى يَهُوذَا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以利亚敬",
      "descriptions": [
        {
          "source": "acai",
          "description": "希勒家的儿子，在亚述王西拿基立攻打犹大期间担任希西家王的王宫总管。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Eliyakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Hilkiya wanda shi ne mai kula da gidan Sarki Hezekiya a lokacin harin Sennakerib sarkin Assuriya a kan Yahuda."
        }
      ]
    },
    "hin": {
      "preferred_label": "एलयाकीम",
      "descriptions": [
        {
          "source": "acai",
          "description": "हिल्किय्याह का एक पुत्र जो अश्शूर के राजा सन्हेरीब द्वारा यहूदा पर आक्रमण के समय राजा हिजकिय्याह के राजघराने का प्रबंधक था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Elyakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak Hilkia yang menjadi kepala istana Raja Hizkia pada waktu serangan Sanherib raja Asyur ke Yehuda."
        }
      ]
    },
    "por": {
      "preferred_label": "Eliaquim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Hilquias que foi administrador do palácio do rei Ezequias durante o ataque do rei assírio Senaqueribe contra Judá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Елиаким",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Хелкии, бывший начальником дворца царя Езекии во время нападения ассирийского царя Сеннахирима на Иудею."
        }
      ]
    },
    "swh": {
      "preferred_label": "Eliakimu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Hilkia aliyekuwa msimamizi wa jumba la Mfalme Hezekia wakati Senakeribu mfalme wa Ashuru aliposhambulia Yuda."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Eliakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Hilkia em i man bilong bosim haus bilong King Hesekia long taim Senakerip, king bilong Asiria, i go pait long Juda."
        }
      ]
    },
    "apd": {
      "preferred_label": "ألياقيم",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد حلقيا الكان ناظر قصر الملك حزقيا وكت هجوم سنحاريب ملك أشور على يهوذا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Eliakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Hilkia we i lida blong lukaot long haos blong King Hesekia long taem we King Senakerib blong Asiria i kam faet agensim Juda."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Eliakịm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Hilkaya nke bụ onye nlekọta ụlọ Eze Hezekaya n'oge mwakpo eze Asịrịa bụ Senakerib wakporo Juda."
        }
      ]
    },
    "nep": {
      "preferred_label": "एल्याकीम",
      "descriptions": [
        {
          "source": "acai",
          "description": "हिल्कियाहका एक छोरा जो अश्शूरका राजा सन्हेरीबले यहूदामाथि आक्रमण गर्दा राजा हिजकियाहका राजदरबारका निरीक्षक थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-li-a-kim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con của Hinh-kia, người quản lý hoàng cung của Vua Ê-xê-chia trong cuộc tấn công của Vua Sanh-chê-ríp nước A-si-ri vào Giu-đa."
        }
      ]
    },
    "zht": {
      "preferred_label": "以利亞敬",
      "descriptions": [
        {
          "source": "acai",
          "description": "希勒家的兒子，在亞述王西拿基立進攻猶大期間擔任希西家王的家宰。"
        }
      ]
    }
  },
