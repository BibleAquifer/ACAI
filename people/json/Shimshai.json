  "localizations": {
    "eng": {
      "preferred_label": "Shimshai",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shimshai",
          "article": "person:Shimshai",
          "description": "A Persian official who opposed the rebuilding of the Temple during the time of Israelite exile and return."
        }
      ]
    },
    "fra": {
      "preferred_label": "Schimschaï",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fonctionnaire perse qui s'opposa à la reconstruction du Temple à l'époque de l'exil et du retour des Israélites."
        }
      ]
    },
    "spa": {
      "preferred_label": "Simsay",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un funcionario persa que se opuso a la reconstrucción del templo durante la época del exilio y el regreso de los israelitas."
        }
      ]
    },
    "arb": {
      "preferred_label": "شِمْشَاي",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَسْؤُولٌ فارِسِيٌّ عارَضَ إِعادَةَ بِناءِ الهَيْكَلِ في زَمَنِ سَبْيِ بَنِي إِسْرائِيلَ ورُجوعِهِمْ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "伸帅",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位波斯官员，在以色列人被掳和归回时期反对重建圣殿。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Shimshai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani babban jami'in Farisa wanda ya yi hamayya da sake gina Haikali a lokacin zaman bauta da dawowar Isra'ilawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "शिमशै",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक फ़ारसी अधिकारी जिसने इस्राएलियों के निर्वासन और वापसी के समय मंदिर के पुनर्निर्माण का विरोध किया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Simsai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pejabat Persia yang menentang pembangunan kembali Bait Suci pada masa pembuangan dan kepulangan bangsa Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Sinsai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um oficial persa que se opôs à reconstrução do Templo durante o tempo do exílio e retorno dos israelitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Шимшай",
      "descriptions": [
        {
          "source": "acai",
          "description": "Персидский сановник, который противился восстановлению Храма во времена израильского плена и возвращения."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shimshai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Afisa Mwajemi aliyepinga kujengwa upya kwa Hekalu wakati wa uhamisho na kurejea kwa Waisraeli."
        }
      ]
    },
    "apd": {
      "preferred_label": "شمشاي",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسؤول فارسي عارض إعادة بناء الهيكل في زمن سبي إسرائيل والرجوع من السبي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Simsae",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ofisel blong Pesia we i bin agensem wok blong bildim bakegen Haos Tempol long taem we ol man Isrel oli stap long eksael mo taem oli kambak."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shimshai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye ọrụ gọọmentị Peshịa nke megidere iwughachi Ụlọnsọ ahụ nʼoge a dọọrọ ndị Izrel nʼagha nakwa nloghachi ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "शिम्शै",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएली निर्वासन र फिर्तीको समयमा मन्दिर पुनर्निर्माणको विरोध गर्ने एक फारसी अधिकारी।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Simsai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ofisa bilong Persia em i bin pasim wok bilong wokim gen Tempel long taim ol Israel i bin stap long kalabus na go bek long graun bilong ol."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sim-sai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một quan chức Ba Tư chống đối việc tái thiết Đền Thờ trong thời kỳ người Y-sơ-ra-ên bị lưu đày và hồi hương."
        }
      ]
    },
    "zht": {
      "preferred_label": "伸帥",
      "descriptions": [
        {
          "source": "acai",
          "description": "一名波斯官員，在以色列人被擄與回歸時期反對重建聖殿。"
        }
      ]
    }
  },
