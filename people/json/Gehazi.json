  ],
  "localizations": {
    "eng": {
      "preferred_label": "Gehazi",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Gehazi",
          "article": "person:Gehazi",
          "description": "The servant of the prophet Elisha, who was struck with leprosy for lying to Elisha and his greed."
        }
      ]
    },
    "fra": {
      "preferred_label": "Guéhazi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Serviteur du prophète Élisée, qui fut frappé de lèpre pour avoir menti à Élisée et pour sa cupidité."
        }
      ]
    },
    "spa": {
      "preferred_label": "Giezi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sirviente del profeta Eliseo, que fue castigado con lepra por mentirle a Eliseo y por su codicia."
        }
      ]
    },
    "arb": {
      "preferred_label": "جِيحْزِي",
      "descriptions": [
        {
          "source": "acai",
          "description": "غلام النبي أليشع، الذي ضُرب بالبرص لكذبه على أليشع ولطمعه."
        }
      ]
    },
    "zhs": {
      "preferred_label": "基哈西",
      "descriptions": [
        {
          "source": "acai",
          "description": "先知以利沙的仆人，因贪婪及欺骗以利沙而染上麻风病。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Gehazi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bawan annabi Elisha, wanda aka buge da cutar kuturta saboda yi wa Elisha ƙarya da kuma kwaɗayinsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "गेहजी",
      "descriptions": [
        {
          "source": "acai",
          "description": "भविष्यद्वक्ता एलीशा का सेवक, जो एलीशा से झूठ बोलने और अपने लालच के कारण कोढ़ से पीड़ित हो गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gehazi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pelayan nabi Elisa, yang ditimpa kusta karena berbohong kepada Elisa dan karena ketamakannya."
        }
      ]
    },
    "por": {
      "preferred_label": "Geazi",
      "descriptions": [
        {
          "source": "acai",
          "description": "O servo do profeta Eliseu, que foi ferido de lepra por mentir para Eliseu e por sua ganância."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гиезий",
      "descriptions": [
        {
          "source": "acai",
          "description": "Слуга пророка Елисея, пораженный проказой за ложь Елисею и свою алчность."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gehazi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtumishi wa nabii Elisha, aliyepigwa kwa ukoma kwa sababu ya kumwambia Elisha uongo na kwa sababu ya tamaa yake."
        }
      ]
    },
    "apd": {
      "preferred_label": "جيحزي",
      "descriptions": [
        {
          "source": "acai",
          "description": "خادم النبي إليشع، الضرب بالبرص عشان كضب على إليشع وعشان طمعه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gehasi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man blong wok blong profet Elisa, we leprosi i kasem hem from we hem i giaman long Elisa mo from gridi fasin blong hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gehazi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye na-ejere onye amụma Ịlaisha ozi, onye e ji ekpenta tie nʼihi ịgha ụgha nye Ịlaisha na anyaukwu ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "गेहजी",
      "descriptions": [
        {
          "source": "acai",
          "description": "एलीशा अगमवक्ताका सेवक, जो एलीशासँग झूट बोलेको र आफ्नो लोभको कारणले कुष्ठरोगबाट पीडित भएका थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gehasi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wokman bilong profet Elisa, em skin lepra i bin kisim em bikos em i giamanim Elisa na em i mangalim ol samting."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ghê-ha-si",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đầy tớ của tiên tri Ê-li-sê, người bị phạt mắc bệnh phong hủi vì nói dối Ê-li-sê và vì tính tham lam của mình."
        }
      ]
    },
    "zht": {
      "preferred_label": "基哈西",
      "descriptions": [
        {
          "source": "acai",
          "description": "先知以利沙的僕人，因向以利沙撒謊及貪心而染上大痲瘋。"
        }
      ]
    }
  },
