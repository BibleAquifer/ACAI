  ],
  "localizations": {
    "eng": {
      "preferred_label": "Pashhur",
      "alternate_labels": [
        "Magor-missabib",
        "Terror on Every Side",
        "Pashur"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Pashhur",
          "article": "person:Pashhur.3",
          "description": "Son of Immer who lived during the time of the divided kingdom of Israel. He was given the title, \"Terror on Every Side.\" "
        }
      ]
    },
    "arb": {
      "preferred_label": "فَشْحور",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن إمير الذي عاش في زمن المملكة المنقسمة لبني إسرائيل. أُعطي اللقب «مَجُورَ مِسَّابِيبَ» (رعب من كل جانب)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "巴施户珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "音麦的儿子，生活在以色列分裂王国时期。他被赐予“四面惊吓”的称号。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Paschhur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d’Immer qui vivait à l’époque du royaume divisé d’Israël. Il reçut le titre de « Terreur de toutes parts »."
        }
      ]
    },
    "hau": {
      "preferred_label": "Fashhur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Immer wanda ya rayu a lokacin rarrabuwar masarautar Isra’ila. An ba shi laƙabi, \\\"Tsoro a Kowanne Gefe.\\\""
        }
      ]
    },
    "hin": {
      "preferred_label": "पशहूर",
      "descriptions": [
        {
          "source": "acai",
          "description": "इम्मेर का पुत्र जो इस्राएल के विभाजित राज्य के समय जीवित था। उसे \\\"चारों ओर भय\\\" (मागोर्मिस्साबीब) की उपाधि दी गई थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Pasyhur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki Imer yang hidup pada masa kerajaan Israel terpecah. Ia diberi julukan \\\"Kegentaran-dari-segala-jurusan\\\"."
        }
      ]
    },
    "por": {
      "preferred_label": "Pasur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Imer que viveu durante a época do reino dividido de Israel. Ele recebeu o título de \\\"Terror por Todos os Lados\\\"."
        }
      ]
    },
    "rus": {
      "preferred_label": "Пасхор",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Еммера, живший во времена разделенного царства Израиля. Ему было дано имя «Ужас вокруг»."
        }
      ]
    },
    "spa": {
      "preferred_label": "Pasur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Imer que vivió durante el tiempo del reino dividido de Israel. Recibió el sobrenombre de «Terror por todas partes»."
        }
      ]
    },
    "swh": {
      "preferred_label": "Pashuri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Imeri aliyeishi wakati wa ufalme uliogawanyika wa Israeli. Alipewa jina, \\\"Hofu Pande Zote.\\\""
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pasur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Imer em i bin stap laip long taim kantri Israel i بروk i go long tupela hap. Em i bin kisim dispela nem, \\\"Samting bilong pretim ol man long olgeta hap.\\\""
        }
      ]
    },
    "apd": {
      "preferred_label": "فشحور",
      "descriptions": [
        {
          "source": "acai",
          "description": "ود إمير العاش في زمن المملكة المنقسمة لبني إسرائيل. أخد اللقب «رعب من كل جهة»."
        }
      ]
    },
    "bis": {
      "preferred_label": "Pasuru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man blong Ime we i laef long taem we kingdom blong Isrel i seraot. Hem i kasem taetel ya, “Mama blong fraet.”"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Pashua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Imea nke biri nʼoge alaeze kewara ekewa nke Izrel. E nyere ya aha nsọpụrụ bụ, “Ihe Egwu Gbara Gburugburu.”"
        }
      ]
    },
    "nep": {
      "preferred_label": "पशहूर",
      "descriptions": [
        {
          "source": "acai",
          "description": "इम्मेरका छोरा जो इस्राएलको विभाजित राज्यको समयमा बाँचेका थिए। तिनलाई \\\"वरिपरि त्रास\\\" (मागोर-मिस्साबीब) भन्‍ने उपाधि दिइएको थियो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Pha-su-rơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Y-mê, sống vào thời vương quốc Y-sơ-ra-ên phân chia. Ông được đặt cho biệt danh là \\\"Kinh hãi mọi bề.\\\""
        }
      ]
    },
    "zht": {
      "preferred_label": "巴施戶珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "音麥的兒子，生活於以色列王國分裂時期。他被賜予稱號「四面驚嚇」（瑪歌珥‧米撒畢）。"
        }
      ]
    }
  },
