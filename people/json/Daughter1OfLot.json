  "localizations": {
    "eng": {
      "preferred_label": "Daughter1 of Lot",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Daughter1 of Lot",
          "article": "person:Daughter1OfLot",
          "description": "Daughter1 of Lot was the unnamed older daughter of Lot, living during the time of the patriarchs, and mentioned in Genesis 19:30."
        }
      ]
    },
    "apd": {
      "preferred_label": "بت لوط الكبيرة",
      "descriptions": [
        {
          "source": "acai",
          "description": "بت لوط الكبيرة كانت بت لوط الما مسمية، عاشت في زمن الآباء الأوائل، ومذكورة في تكوين 19: 30."
        }
      ]
    },
    "arb": {
      "preferred_label": "ابنة لوط الكبرى",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابنة لوط الأولى هي ابنة لوط الكبرى التي لم يُذكر اسمها، عاشت في زمن الآباء، وذُكرت في التكوين 19: 30."
        }
      ]
    },
    "bis": {
      "preferred_label": "Fas dota blong Lot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fas dota blong Lot i bigfala dota blong Lot we Baebol i no talem nem blong hem, we i stap laef long taem blong ol olfala bubu, mo Jenesis 19:30 i tokbaot hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "fille aînée de Lot",
      "descriptions": [
        {
          "source": "acai",
          "description": "La fille aînée de Lot était la fille de Lot non nommée, vivant à l'époque des patriarches et mentionnée dans Genèse 19:30."
        }
      ]
    },
    "hau": {
      "preferred_label": "Babbar ’yar Lot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babbar ’yar Lot wadda ba a ambaci sunanta ba ce, wadda ta rayu a zamanin kakanni, kuma aka ambata a Farawa 19:30."
        }
      ]
    },
    "hin": {
      "preferred_label": "लूत की बड़ी बेटी",
      "descriptions": [
        {
          "source": "acai",
          "description": "लूत की पहली बेटी लूत की अनाम बड़ी बेटी थी, जो कुलपिताओं के समय में जीवित थी, और इसका उल्लेख उत्पत्ति 19:30 में मिलता है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nwa nwanyị 1 nke Lọt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwanyị 1 nke Lọt bụ ada Lọt nke okenye a na-akpọghị aha ya, nke biri nʼoge ndị nna ochie, a kpọtụkwara ya aha na Jenesis 19:30."
        }
      ]
    },
    "ind": {
      "preferred_label": "Putri sulung Lot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Putri sulung Lot adalah putri tertua Lot yang tidak disebutkan namanya, hidup pada masa para bapa leluhur, dan disebutkan dalam Kejadian 19:30."
        }
      ]
    },
    "nep": {
      "preferred_label": "लोतकी जेठी छोरी",
      "descriptions": [
        {
          "source": "acai",
          "description": "लोतकी जेठी छोरी लोतकी नाम नखुलाइएकी जेठी छोरी थिइन्, जो कुलपिताहरूको समयमा बाँचेकी थिइन्, र उत्पत्ति १९:३० मा उल्लेख गरिएको छ।"
        }
      ]
    },
    "por": {
      "preferred_label": "Filha mais velha de Ló",
      "descriptions": [
        {
          "source": "acai",
          "description": "A primeira filha de Ló foi a filha mais velha e sem nome de Ló, que viveu durante a época dos patriarcas e é mencionada em Gênesis 19:30."
        }
      ]
    },
    "rus": {
      "preferred_label": "Старшая дочь Лота",
      "descriptions": [
        {
          "source": "acai",
          "description": "Старшая дочь Лота — безымянная старшая дочь Лота, жившая во времена патриархов и упомянутая в Бытии 19:30."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hija mayor de Lot",
      "descriptions": [
        {
          "source": "acai",
          "description": "La primera hija de Lot fue la hija mayor no nombrada de Lot, que vivió durante la época de los patriarcas y es mencionada en Génesis 19:30."
        }
      ]
    },
    "swh": {
      "preferred_label": "Binti wa kwanza wa Lutu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Binti wa kwanza wa Lutu alikuwa binti mkubwa wa Lutu asiyetajwa jina, aliyeishi wakati wa wazee wa imani, naye anatajwa katika Mwanzo 19:30."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pikinini meri namba 1 bilong Lot",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini meri namba 1 bilong Lot em i bikpela pikinini meri bilong Lot em Baibel i no kolim nem bilong en. Em i bin stap long taim bilong ol bikman bilong lain Israel, na Buk Stat 19:30 i toktok long em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Con gái lớn của Lót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con gái lớn của Lót là người con gái lớn không được nêu tên của Lót, sống vào thời các tộc trưởng, và được nhắc đến trong Sáng Thế Ký 19:30."
        }
      ]
    },
    "zhs": {
      "preferred_label": "罗得的大女儿",
      "descriptions": [
        {
          "source": "acai",
          "description": "罗得的大女儿是罗得未提名字的长女，生活在先祖时代，记载于创世记19:30。"
        }
      ]
    },
    "zht": {
      "preferred_label": "羅得的大女兒",
      "descriptions": [
        {
          "source": "acai",
          "description": "羅得的大女兒是一位未具名的女子，生活於族長時期，記載於創世記19:30。"
        }
      ]
    }
  },
