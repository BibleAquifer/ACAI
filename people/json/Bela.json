  "localizations": {
    "eng": {
      "preferred_label": "Bela",
      "alternate_labels": [
        "Belah",
        "Belaite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Bela",
          "article": "person:Bela",
          "description": "A son of the patriarch Benjamin and chief of the clan of the Belaites. He was father of Addar and Naaman."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَالَع",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن بنيامين ورئيس عشيرة البالعيين. وهو والد أرد ونعمان."
        }
      ]
    },
    "zhs": {
      "preferred_label": "比拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长便雅悯的儿子，比拉族的族长。他是亚勒和乃幔的父亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Béla",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Benjamin et chef du clan des Balites (ou Bélaïtes). Il était le père d'Addar et de Naaman."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan kakan nan Benyamin kuma shugaban dangin Belawa. Shi ne mahaifin Addar da Na’aman."
        }
      ]
    },
    "hin": {
      "preferred_label": "बेला",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता बिन्यामीन का एक पुत्र और बेलियों के कुल का मुखिया। वह अद्दार और नामान का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Bela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki dari bapa leluhur Benyamin dan kepala kaum orang Bela. Ia adalah ayah dari Adar dan Naaman."
        }
      ]
    },
    "por": {
      "preferred_label": "Bela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho do patriarca Benjamim e chefe do clã dos belaítas. Foi pai de Adar e Naamã."
        }
      ]
    },
    "rus": {
      "preferred_label": "Бела",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Вениамина и глава рода белитов. Был отцом Аддара и Наамана."
        }
      ]
    },
    "spa": {
      "preferred_label": "Bela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Benjamín y jefe del clan de los belaítas. Fue padre de Adar y Naamán."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa mzee wa imani Benyamini na kiongozi wa ukoo wa Wabela. Alikuwa baba yake Adari na Naamani."
        }
      ]
    },
    "apd": {
      "preferred_label": "بالع",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد من أولاد بنيامين ورئيس عشيرة البالعيين. وهو أبو أدار ونعمان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini man blong bubu Benjamin mo jif blong laen blong ol man Bela. Hem i papa blong Ada mo Nahaman."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Bela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke nke nna ochie Benjamin na onyeisi ikwu ndị Bela. Ọ bụ nna Adaa na Neeman."
        }
      ]
    },
    "nep": {
      "preferred_label": "बेला",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता बेन्यामीनका छोरा र बेलाही कुलका प्रमुख। तिनी अद्दार र नामानका बुबा थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Bela",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong bikpela tumbuna Benjamin na hetman bilong lain bilong Bela. Em i papa bilong Adar na Naman."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bê-la",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của tổ phụ Bên-gia-min và là người đứng đầu thị tộc người Bê-la. Ông là cha của A-đa và Na-a-man."
        }
      ]
    },
    "zht": {
      "preferred_label": "比拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長便雅憫的兒子，比拉族的族長。他是亞勒和乃幔的父親。"
        }
      ]
    }
  },
