  "localizations": {
    "eng": {
      "preferred_label": "Jared",
      "alternate_labels": [
        "Jered"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jared",
          "article": "person:Jared",
          "description": "An ancestor of the patriarch Noah, son of Mahalalel and father of Enoch. He is mentioned in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَارَد",
      "descriptions": [
        {
          "source": "acai",
          "description": "أحد أسلاف بطريرك نوح، وهو ابن مهللئيل وأبو أخنوخ. ذُكر في نسب يسوع المسيح."
        }
      ]
    },
    "zhs": {
      "preferred_label": "雅列",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖诺亚的祖先，玛勒列的儿子，以诺的父亲。他被列在耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jéred",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ancêtre du patriarche Noé, fils de Mahalaleel et père d’Hénoc. Il est mentionné dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yared",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kakan uban dā na uban iyali Nuhu, ɗan Mahalalel kuma mahaifin Enok. An ambace shi a cikin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "येरेद",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नूह का एक पूर्वज, महललेल का पुत्र और हनोक का पिता। उसका उल्लेख यीशु की वंशावली में है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yared",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nenek moyang dari bapa leluhur Nuh, anak Mahalaleel dan ayah Henokh. Ia disebutkan dalam silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Jarede",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um ancestral do patriarca Noé, filho de Maalalel e pai de Enoque. Ele é mencionado na linhagem de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иаред",
      "descriptions": [
        {
          "source": "acai",
          "description": "Предок патриарха Ноя, сын Малелеила и отец Еноха. Упоминается в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jared",
      "descriptions": [
        {
          "source": "acai",
          "description": "Antepasado del patriarca Noé, hijo de Mahalaleel y padre de Enoc. Se le menciona en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yaredi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babu wa babu wa mzee wa ukoo Nuhu, mwana wa Mahalaleli na baba wa Henoko. Ametajwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jaret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela tumbuna bilong patriak Noa, pikinini man bilong Mahalalel na papa bilong Enok. Baibel i kolim nem bilong en long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "يارد",
      "descriptions": [
        {
          "source": "acai",
          "description": "جد من أجداد نوح، ولد مهللئيل وأبو أخنوخ. ومذكور في شجرة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jared",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan olfala bubu blong Noa, pikinini boe blong Mahalalel mo papa blong Inok. Nem blong hem i stap long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jared",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nna nna nke onyeisi ezinụlọ bụ Noa, nwa Mahalalel na nna Enọk. A kpọtụrụ ya aha nʼusoro ọmụmụ nke Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "येरेद",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नूहका एक पुर्खा, महलालेलका छोरा र हनोकका पिता। येशूको वंशावलीमा उनको उल्लेख गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Gia-rết",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tổ phụ của tộc trưởng Nô-ê, con trai của Ma-ha-la-lê và là cha của Hê-nóc. Ông được kể trong gia phả của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "雅列",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖挪亞的先祖，瑪勒列的兒子，以諾的父親。他被列在耶穌的家譜中。"
        }
      ]
    }
  },
