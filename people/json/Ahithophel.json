  "localizations": {
    "eng": {
      "preferred_label": "Ahithophel",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ahithophel",
          "article": "person:Ahithophel",
          "description": "An advisor of King David and David's son Absalom. Ahithophel was from Giloh."
        }
      ]
    },
    "fra": {
      "preferred_label": "Achitophel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Conseiller du roi David et de son fils Absalom. Achitophel était originaire de Guilo."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ajitofel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Consejero del rey David y de su hijo Absalón. Ajitofel era de Guiló."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَخِيتُوفَل",
      "descriptions": [
        {
          "source": "acai",
          "description": "مشير للملك داود ولابنه أبشالوم. كان أخيتوفل من جيلوه."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚希多弗",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王及其子押沙龙的谋士。亚希多弗来自基罗。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ahitofel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mai ba wa Sarki Dawuda da ɗansa Absalom shawara. Ahitofel ya fito ne daga Gilo."
        }
      ]
    },
    "hin": {
      "preferred_label": "अहीतोपेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊद और दाऊद के पुत्र अबशालोम का एक सलाहकार। अहीतोपेल गीलो का रहनेवाला था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ahitofel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang penasihat Raja Daud dan Absalom, anak Daud. Ahitofel berasal dari Gilo."
        }
      ]
    },
    "por": {
      "preferred_label": "Aitofel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um conselheiro do rei Davi e de seu filho Absalão. Aitofel era natural de Gilo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ахитофел",
      "descriptions": [
        {
          "source": "acai",
          "description": "Советник царя Давида и его сына Авессалома. Ахитофел был родом из Гило."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ahithofeli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mshauri wa Mfalme Daudi na Absalomu mwana wa Daudi. Ahithofeli alitoka Gilo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ahitofel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong givim tingting long King Devit na long pikinini man bilong Devit, Apsalom. Ahitofel i bilong Gilo."
        }
      ]
    },
    "apd": {
      "preferred_label": "أخيتوفل",
      "descriptions": [
        {
          "source": "acai",
          "description": "مستشار حق الملك داود وولد داود أبشالوم. أخيتوفل كان من جيلوه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ahitofel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan advaesa blong King Deved mo pikinini boe blong Deved we nem blong hem Absalom. Ahitofel i man Gilo."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ahitofel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye ndụmọdụ Eze Devid na nwa Devid bụ Absalọm. Ahitofel bụ onye si Gailo."
        }
      ]
    },
    "nep": {
      "preferred_label": "अहीतोपेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊद र दाऊदका छोरा अब्शालोमका एक सल्लाहकार। अहीतोपेल गिलोका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-hi-tô-phe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một mưu sĩ của Vua Đa-vít và con trai Đa-vít là Áp-sa-lôm. A-hi-tô-phe quê ở Ghi-lô."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞希多弗 (亞瑪利雅之子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王與大衛之子押沙龍的謀士。亞希多弗來自基羅。"
        }
      ]
    }
  },
