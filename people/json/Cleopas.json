  ],
  "localizations": {
    "eng": {
      "preferred_label": "Cleopas",
      "alternate_labels": [
        "Cleophas",
        "Clopas"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Cleopas",
          "article": "person:Cleopas",
          "description": "One of the two disciples whom Jesus met on the road to Emmaus after his resurrection. He may have been the husband of Mary, one of the women who witnessed Jesus's death on the cross."
        }
      ]
    },
    "arb": {
      "preferred_label": "كِلْيُوبَاس",
      "descriptions": [
        {
          "source": "acai",
          "description": "أحد التلميذين اللذين التقاهما يسوع في طريق عمواس بعد قيامته. وربما كان زوج مريم، إحدى النساء اللواتي شهدن موت يسوع على الصليب."
        }
      ]
    },
    "zhs": {
      "preferred_label": "革流巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶稣复活后在去以马忤斯的路上遇见的两名门徒之一。他可能是目睹耶稣死在十字架上的妇女之一马利亚的丈夫。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Cléopas",
      "descriptions": [
        {
          "source": "acai",
          "description": "L’un des deux disciples que Jésus rencontra sur le chemin d’Emmaüs après sa résurrection. Il était peut-être l’époux de Marie, l’une des femmes qui furent témoins de la mort de Jésus sur la croix."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kiliyobas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗaya daga cikin almajirai biyu da Yesu ya haɗu da su a kan hanyar zuwa Imwas bayan tashinsa daga matattu. Wataƙila shi ne mijin Maryamu, ɗaya daga cikin matan da suka shaida mutuwar Yesu a kan gicciye."
        }
      ]
    },
    "hin": {
      "preferred_label": "क्लियुपास",
      "descriptions": [
        {
          "source": "acai",
          "description": "उन दो चेलों में से एक जिनसे यीशु अपने पुनरुत्थान के बाद इम्माऊस के मार्ग पर मिले। वह मरियम का पति रहा हो सकता है, जो उन स्त्रियों में से एक थी जिन्होंने क्रूस पर यीशु की मृत्यु को देखा था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kleopas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Salah satu dari dua murid yang ditemui Yesus di jalan menuju Emaus setelah kebangkitan-Nya. Ia mungkin adalah suami dari Maria, salah seorang perempuan yang menyaksikan kematian Yesus di kayu salib."
        }
      ]
    },
    "por": {
      "preferred_label": "Cleopas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um dos dois discípulos que Jesus encontrou no caminho de Emaús após a sua ressurreição. Ele pode ter sido o marido de Maria, uma das mulheres que testemunharam a morte de Jesus na cruz."
        }
      ]
    },
    "rus": {
      "preferred_label": "Клеопа",
      "descriptions": [
        {
          "source": "acai",
          "description": "Один из двух учеников, которых Иисус встретил по дороге в Эммаус после Своего воскресения. Возможно, он был мужем Марии, одной из женщин, бывших свидетельницами смерти Иисуса на кресте."
        }
      ]
    },
    "spa": {
      "preferred_label": "Cleofas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uno de los dos discípulos con quienes se encontró Jesús en el camino a Emaús después de su resurrección. Pudo haber sido el esposo de María, una de las mujeres que presenciaron la muerte de Jesús en la cruz."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kleopa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmoja wa wale wanafunzi wawili ambao Yesu alikutana nao njiani kuelekea Emau baada ya kufufuka kwake. Huenda alikuwa mume wa Maria, mmoja wa wanawake walioshuhudia kifo cha Yesu msalabani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kliopas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bilong tupela disaipel em Jisas i bin bungim long rot i go long Emeas bihain long em i kirap bek long matmat. Ating em i man bilong Maria, wanpela bilong ol meri i bin lukim Jisas i dai long diwai kros."
        }
      ]
    },
    "apd": {
      "preferred_label": "كليوباس",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحد من التلميذين اللقاهم عيسى في طريق عمواس بعد قيامته. ممكن يكون راجل مريم، واحدة من النسوان الشهدن موت عيسى في الصليب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kleopas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan long tufala disaepol we Jisas i mitim tufala long rod i go long Emeas biaen long laefwekep blong hem. Ating hem i hasban blong Meri, wan long ol woman we oli witnesem ded blong Jisas long kros."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kleopas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nʼime ndị na-eso ụzọ abụọ ahụ Jisọs zutere nʼụzọ na-aga Emeọs mgbe o bilitesịrị nʼọnwụ. O nwere ike ịbụ di Meri, otu nʼime ụmụ nwanyị ndị hụrụ ọnwụ Jisọs nʼobe."
        }
      ]
    },
    "nep": {
      "preferred_label": "क्लेओपास",
      "descriptions": [
        {
          "source": "acai",
          "description": "उहाँको पुनरुत्थानपछि इम्माउसको बाटोमा येशूले भेट्नुभएका दुई जना चेलाहरूमध्ये एक जना। तिनी क्रुसमा येशूको मृत्युका प्रत्यक्षदर्शी स्त्रीहरूमध्ये एक क्लोपासकी पत्‍नी मरियमका पति हुन सक्छन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Cơ-lê-ô-ba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một trong hai môn đồ mà Chúa Giê-xu đã gặp trên đường đi Em-ma-út sau khi Ngài phục sinh. Ông có thể là chồng của Ma-ri, một trong những phụ nữ chứng kiến cái chết của Chúa Giê-xu trên thập tự giá."
        }
      ]
    },
    "zht": {
      "preferred_label": "革流巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶穌復活後在往以馬忤斯的路上所遇見的兩位門徒之一。他可能是目睹耶穌死在十字架上的婦女之一馬利亞的丈夫。"
        }
      ]
    }
  },
