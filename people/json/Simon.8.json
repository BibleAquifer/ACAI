  "localizations": {
    "eng": {
      "preferred_label": "Simon (Acts 8:9)",
      "alternate_labels": [
        "Simon the Sorcerer"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Simon (Acts 8:9)",
          "article": "person:Simon.8",
          "description": "Simon, also known as Simon the Sorcerer, was a magician living in Samaria during the New Testament, first mentioned in Acts 8:9."
        }
      ]
    },
    "fra": {
      "preferred_label": "Simon (Actes 8.9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Simon, également connu sous le nom de Simon le Magicien, était un magicien vivant en Samarie à l’époque du Nouveau Testament, mentionné pour la première fois dans Actes 8:9."
        }
      ]
    },
    "spa": {
      "preferred_label": "Simón (Hechos 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Simón, también conocido como Simón el Mago, fue un mago que vivió en Samaria durante la época del Nuevo Testamento, mencionado por primera vez en Hechos 8:9."
        }
      ]
    },
    "arb": {
      "preferred_label": "سِيمُون (أعمال الرسل 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "سيمون، المعروف أيضاً باسم سيمون الساحر، كان ساحراً عاش في السامرة في عصر العهد الجديد، وذُكر لأول مرة في أعمال الرسل 8: 9."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西门 (使徒行传 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "西门，也被称为术士西门，是新约时期住在撒玛利亚的一位行邪术者，最早在使徒行传8:9中被提及。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Siman (Ayyukan Manzanni 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Siman, wanda aka fi sani da Siman Mai Sihiri, wani mai sihiri ne da ya zauna a Samariya a zamanin Sabon Alkawari, wanda aka fara ambatonsa a Ayyukan Manzanni 8:9."
        }
      ]
    },
    "hin": {
      "preferred_label": "शमौन (प्रेरितों के काम 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "शमौन, जिसे जादूगर शमौन के नाम से भी जाना जाता है, नए नियम के काल में सामरिया में रहने वाला एक जादूगर था, जिसका पहला उल्लेख प्रेरितों के काम 8:9 में है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Simon (Kisah Para Rasul 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Simon, yang juga dikenal sebagai Simon sang Penyihir, adalah seorang penyihir yang tinggal di Samaria pada zaman Perjanjian Baru, pertama kali disebutkan dalam Kisah Para Rasul 8:9."
        }
      ]
    },
    "por": {
      "preferred_label": "Simão (Atos 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Simão, também conhecido como Simão, o Mágico, foi um mágico que viveu em Samaria durante o período do Novo Testamento, mencionado pela primeira vez em Atos 8:9."
        }
      ]
    },
    "rus": {
      "preferred_label": "Симон (Деяния 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Симон, также известный как Симон Волхв, был чародеем, жившим в Самарии во времена Нового Завета; впервые упоминается в Деяниях 8:9."
        }
      ]
    },
    "swh": {
      "preferred_label": "Simoni (Matendo ya Mitume 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Simoni, anayejulikana pia kama Simoni Mchawi, alikuwa mchawi aliyeishi Samaria wakati wa Agano Jipya, anayetajwa kwa mara ya kwanza katika Matendo 8:9."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Saimon (Wok bilong Ol Aposel 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Saimon, em ol i save kolim tu olsem Saimon man bilong mekim marila, em i wanpela man bilong mekim marila i bin stap long Samaria long taim bilong Nupela Testamen, em Buk Wok 8:9 i stori pastaim long en."
        }
      ]
    },
    "apd": {
      "preferred_label": "سيمون (أعمال الرسل 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "سيمون، المعرّف برضو بي سيمون الساحر، كان ساحر عايش في السامرة في زمن العهد الجديد، وذكروهو أول مرة في أعمال الرسل 8:9."
        }
      ]
    },
    "bis": {
      "preferred_label": "Saemon (Wok blong ol Aposol 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Saemon, we oli save hem tu olsem Saemon we i mekem posen mo kleva, hem i wan man blong mekem majik we i laef long Sameria long taem blong Niutesteman, we Buk blong Ol Wok 8:9 i tokbaot hem fastaem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Saimọn (Ọrụ Ndị Ozi 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Saimọn, nke a makwaara dị ka Saimọn Onye Mgbaasị, bụ onye anwansi bibiri na Sameria nʼoge Agba Ọhụrụ, nke a buru ụzọ kpọtụ aha nʼỌrụ Ndị Ozi 8:9."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिमोन (प्रेरितहरूका काम 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिमोन, जसलाई जादुगर सिमोन पनि भनिन्छ, नयाँ नियमको समयमा सामरियामा बस्ने एक जादुगर थिए, जसको उल्लेख पहिलो पटक प्रेरित ८:९ मा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Si-môn (Công Vụ Các Sứ Đồ 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Si-môn, còn gọi là Si-môn phù thủy, là một thầy phù thủy sống ở Sa-ma-ri vào thời Tân Ước, được nhắc đến lần đầu trong Công Vụ 8:9."
        }
      ]
    },
    "zht": {
      "preferred_label": "西門 (使徒行傳 8:9)",
      "descriptions": [
        {
          "source": "acai",
          "description": "西門，又稱行邪術的西門，是新約時期住在撒馬利亞的術士，首次提及於使徒行傳8:9。"
        }
      ]
    }
  },
