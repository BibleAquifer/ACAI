  "localizations": {
    "eng": {
      "preferred_label": "Leah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Leah",
          "article": "person:Leah",
          "description": "A daughter of Laban and first wife of the patriarch Jacob, she was the older sister of the matriarch Rachel. Leah was mother to several of the patriarchs of the tribes of Israel, including Judah, the ancestor of Jesus."
        }
      ]
    },
    "fra": {
      "preferred_label": "Léa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fille de Laban et première épouse du patriarche Jacob, elle était la sœur aînée de la matriarche Rachel. Léa fut la mère de plusieurs des patriarches des tribus d'Israël, dont Juda, l'ancêtre de Jésus."
        }
      ]
    },
    "spa": {
      "preferred_label": "Lea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hija de Labán y primera esposa del patriarca Jacob, hermana mayor de la matriarca Raquel. Lea fue madre de varios patriarcas de las tribus de Israel, incluido Judá, antepasado de Jesús."
        }
      ]
    },
    "arb": {
      "preferred_label": "لَيْئَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابنة لابان والزوجة الأولى ليعقوب (إسرائيل)، وكانت الأخت الكبرى لراحيل. كانت أمًّا لعدد من رؤساء أسباط إسرائيل، ومنهم يهوذا، سلف يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "利亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "拉班的女儿，也是族长雅各的第一位妻子，她是女族长拉结的姐姐。利亚是生下以色列若干支派族长的母亲，其中包括耶稣的先祖犹大。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Liyatu",
      "descriptions": [
        {
          "source": "acai",
          "description": "’Yar Laban kuma matar farko ta uban iyali Yaƙub, ita ce babbar ’yar’uwar uwar iyali Rahila. Liyatu ita ce mahaifiyar da yawa daga cikin kakannin ƙabilun Isra’ila, har da Yahuda, kakan Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "लिआ",
      "descriptions": [
        {
          "source": "acai",
          "description": "लाबान की बेटी और कुलपिता याकूब की पहली पत्नी, वह कुलमाता राहेल की बड़ी बहन थी। लिआ इस्राएल के गोत्रों के कई कुलपिताओं की माँ थी, जिसमें यीशु का पूर्वज यहूदा भी शामिल था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Lea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak perempuan Laban dan istri pertama dari bapa leluhur Yakub, ia adalah kakak perempuan dari Rahel. Lea adalah ibu dari beberapa bapa leluhur suku-suku Israel, termasuk Yehuda, nenek moyang Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Lia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filha de Labão e primeira esposa do patriarca Jacó, era a irmã mais velha da matriarca Raquel. Lia foi mãe de vários patriarcas das tribos de Israel, incluindo Judá, ancestral de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Лия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дочь Лавана и первая жена патриарха Иакова, старшая сестра праматери Рахили. Лия была матерью нескольких родоначальников колен Израиля, включая Иуду, предка Иисуса."
        }
      ]
    },
    "swh": {
      "preferred_label": "Lea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Binti wa Labani na mke wa kwanza wa patriarki Yakobo, aliyekuwa dada mkubwa wa matriarki Raheli. Lea alikuwa mama wa baadhi ya wazee wakuu wa kabila za Israeli, akiwemo Yuda, babu yake Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini meri bilong Laban na namba wan meri bilong hetman Jekop, em i bikpela susa bilong Resel. Lea em i mama bilong sampela hetman bilong ol lain bilong Israel, wantaim Juda tu, em tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "ليئة",
      "descriptions": [
        {
          "source": "acai",
          "description": "بت لابان وزوجة يعقوب الأولى، وكانت الأخت الكبيرة لي راحيل. ليئة كانت أم لي عدد من رؤساء أسباط إسرائيل، ومنهم يهوذا، جد يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Lea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan dota blong Laban mo fas waef blong patriak ya Jekob, hem i bigsista blong matriak ya Rejel. Lea i mama blong sam long ol patriak blong ol laen blong Isrel, wetem Juda tu, we i bubu blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Lịa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ada Leban na nwunye mbụ nke nna ochie Jekọb, ọ bụ nwanne nwaanyị tọrọ nne ochie Rechel. Lịa mụrụ ọtụtụ nʼime ndị nna ochie nke ebo Izrel dị iche iche, gụnyere Juda, bụ́ nna nna Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "लेआ",
      "descriptions": [
        {
          "source": "acai",
          "description": "लाबानकी छोरी र कुलपिता याकूबकी जेठी पत्‍नी, जो कुलमाता राहेलकी जेठी दिदी थिइन्। लेआ इस्राएलका कुलहरूका थुप्रै कुलपिताहरूकी आमा थिइन्, जसमा येशूका पुर्खा यहूदा पनि समावेश थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Lê-a",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con gái của La-ban và là người vợ đầu tiên của tộc trưởng Gia-cốp, bà là chị gái của nữ tộc trưởng Ra-chên. Lê-a là mẹ của một số tộc trưởng các chi tộc Y-sơ-ra-ên, bao gồm Giu-đa, tổ phụ của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "利亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "拉班的女兒，也是族長雅各的第一位妻子，是女族長拉結的姐姐。利亞是以色列各支派多位先祖的母親，其中包括耶穌的祖先猶大。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
