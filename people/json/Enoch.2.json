  ],
  "roles": [
    "Patriarch"
  ],
  "tribe": "group:Earlypatriarchs",
  "localizations": {
    "eng": {
      "preferred_label": "Enoch (Son of Jared)",
      "alternate_labels": [
        "Henoch"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Enoch (Son of Jared)",
          "article": "person:Enoch.2",
          "description": "Son of Jared and father of Methuselah. Enoch pleased God, so He took him to heaven before he died."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَخْنُوخ (ابن يارد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن يارد وأبو متوشالح. أرضى أخنوخ الله فنقله إلى السماء قبل أن يموت."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以诺 (雅列的儿子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "雅列的儿子，玛土撒拉的父亲。以诺得上帝喜悦，因此上帝在他死前把他接到了天上。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Hénoc (fils de Jéred)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Jéred et père de Metuschélah. Hénoc plut à Dieu, si bien que Dieu le prit au ciel avant sa mort."
        }
      ]
    },
    "hau": {
      "preferred_label": "Enok (Ɗan Yared)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Yared kuma uban Metusela. Enok ya gamshi Allah, saboda haka Ya ɗauke shi zuwa sama kafin ya mutu."
        }
      ]
    },
    "hin": {
      "preferred_label": "हनोक (येरेद का पुत्र)",
      "descriptions": [
        {
          "source": "acai",
          "description": "येरेद का पुत्र और मतूशेलह का पिता। हनोक ने परमेश्वर को प्रसन्न किया, इसलिए वह मरने से पहले ही उसे स्वर्ग उठा ले गया।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Henokh (Anak Yared)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Yared dan ayah Metusalah. Henokh berkenan kepada Allah, sehingga Dia mengangkatnya ke surga sebelum dia mati."
        }
      ]
    },
    "por": {
      "preferred_label": "Enoque (filho de Jarede)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Jarede e pai de Metusalém. Enoque agradou a Deus, por isso Ele o levou para o céu antes que morresse."
        }
      ]
    },
    "rus": {
      "preferred_label": "Енох (сын Иареда)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Иареда и отец Мафусала. Енох угодил Богу, поэтому Бог взял его на небо до того, как он умер."
        }
      ]
    },
    "spa": {
      "preferred_label": "Enoc (hijo de Jared)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Jared y padre de Matusalén. Enoc agradó a Dios, por lo que Él se lo llevó al cielo antes de que muriera."
        }
      ]
    },
    "swh": {
      "preferred_label": "Enoki (Mwana wa Yaredi)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Yaredi na baba yake Methusela. Enoki alimpendeza Mungu, kwa hiyo akamchukua mbinguni kabla hajafa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Enok (pikinini bilong Jaret)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Jaret na papa bilong Metusela. Pasin bilong Enok i mekim God i belgut, olsem na God i kisim em i go long heven paslain long em i dai."
        }
      ]
    },
    "apd": {
      "preferred_label": "أخنوخ (ولد يارد)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد يارد وأبو متوشالح. أخنوخ أرضى الله، عشان كده الله رفعه للسماء قبل ما يموت."
        }
      ]
    },
    "bis": {
      "preferred_label": "Inok (Pikinini blong Jared)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Jared mo papa blong Metusela. Inok i mekem God i glad tumas long hem, taswe God i tekem hem i go long heven bifo we hem i ded."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Enọk (nwa Jared)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Jared na nna Metusela. Enọk mere ihe dị Chineke mma, ya mere O wepụrụ ya gaa eluigwe tupu ya anwụọ."
        }
      ]
    },
    "nep": {
      "preferred_label": "हनोक (येरेदका छोरा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "येरेदका छोरा र मतूशेलहका पिता। हनोकले परमेश्‍वरलाई प्रसन्‍न पारे, त्यसैले तिनी मर्नुभन्दा अघि उहाँले तिनलाई स्वर्गमा लैजानुभयो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hê-nóc (con của Gia-rết)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Gia-rết và cha của Mê-tu-sê-la. Hê-nóc sống đẹp lòng Đức Chúa Trời, nên Ngài đã cất ông lên thiên đàng trước khi ông qua đời."
        }
      ]
    },
    "zht": {
      "preferred_label": "以諾 (雅列之子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "雅列的兒子，瑪土撒拉的父親。以諾得神喜悅，因此神在他死前將他取到天上。"
        }
      ]
    }
  },
