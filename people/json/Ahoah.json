    },
    "ibo": {
      "preferred_label": "Ahoa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye ndu ebo nke sitere nʼebo Benjamin. A na-akpọ ụmụ ụmụ ya ndị Ahohi."
        }
      ]
    },
    "nep": {
