    },
    "spa": {
      "preferred_label": "Ahoa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Líder tribal que pertenecía a la tribu de Benjamín. Sus descendientes son llamados ahohítas."
        }
      ]
    },
