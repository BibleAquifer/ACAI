    "arb": {
      "preferred_label": "أَخُوخُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "زَعِيمٌ قَبَلِيٌّ ٱنْتَمَى إِلَى سِبْطِ بَنْيَامِينَ. يُدْعَى نَسْلُهُ ٱلْأَخُوخِيِّينَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚何亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "属于便雅悯支派的一位族长。他的后裔被称为亚哈希人。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Achoach",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un chef tribal qui appartenait à la tribu de Benjamin. Ses descendants sont appelés Achochites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ahowa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani shugaban kabila daga kabilar Benyamin. Zuriyarsa ana kiran su Ahowawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "अहोह",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिन्यामीन के गोत्र का एक गोत्रीय अगुवा। उसके वंशज अहोही कहलाते हैं।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ahoah",
      "descriptions": [
        {
          "source": "acai",
