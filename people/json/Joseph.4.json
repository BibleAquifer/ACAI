  "localizations": {
    "eng": {
      "preferred_label": "Joseph",
      "alternate_labels": [
        "parents",
        "father"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Joseph",
          "article": "person:Joseph.4",
          "description": "Mary the mother of Jesus's legal guardian (\"husband\") and the adopted father of Jesus Christ."
        }
      ]
    },
    "arb": {
      "preferred_label": "يوسُف",
      "descriptions": [
        {
          "source": "acai",
          "description": "الوليّ الشرعي («رجل») لمريم أم يسوع، والأب المربي ليسوع المسيح."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约瑟",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶稣的母亲马利亚的法定监护人（“丈夫”），也是耶稣基督的养父。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Joseph",
      "descriptions": [
        {
          "source": "acai",
          "description": "Le tuteur légal (« époux ») de Marie, mère de Jésus, et le père adoptif de Jésus-Christ."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yusuf",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mijin Maryamu mahaifiyar Yesu kuma uban riƙon Yesu Almasihu."
        }
      ]
    },
    "hin": {
      "preferred_label": "यूसुफ",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु की माता मरियम का कानूनी संरक्षक (\\\"पति\\\") और यीशु मसीह का दत्तक पिता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yusuf",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wali sah (\\\"suami\\\") Maria ibu Yesus dan ayah angkat Yesus Kristus."
        }
      ]
    },
    "por": {
      "preferred_label": "José",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tutor legal (\\\"marido\\\") de Maria, mãe de Jesus, e pai adotivo de Jesus Cristo."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иосиф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Законный опекун («муж») Марии, матери Иисуса, и приемный отец Иисуса Христа."
        }
      ]
    },
    "spa": {
      "preferred_label": "José",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tutor legal («esposo») de María, la madre de Jesús, y padre adoptivo de Jesucristo."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yusufu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Msimamizi wa kisheria (“mume”) wa Maria mama yake Yesu na baba mlezi wa Yesu Kristo."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Josep",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gadenman («man bilong en») bilong Maria mama bilong Jisas na papa bilong Jisas Krais long lo."
        }
      ]
    },
    "apd": {
      "preferred_label": "يوسف",
      "descriptions": [
        {
          "source": "acai",
          "description": "الولي الشرعي («رجل») مريم أم يسوع، والأب بالتبني ليسوع المسيح."
        }
      ]
    },
    "bis": {
      "preferred_label": "Josef",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man blong Meri mama blong Jisas we i lukaot long hem folem loa, mo papa we i adoptem Jisas Kraes."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Josef",
      "descriptions": [
        {
          "source": "acai",
          "description": "Di Meri nne Jisọs nʼụzọ iwu na nna kuchiri Jisọs Kraịst."
        }
      ]
    },
    "nep": {
      "preferred_label": "योसेफ",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूकी आमा मरियमका कानुनी अभिभावक (\\\"पति\\\") र येशू ख्रीष्टका धर्मपुत्र पिता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-sép",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người giám hộ hợp pháp (\\\"chồng\\\") của Ma-ri mẹ Chúa Giê-xu, và là dưỡng phụ của Chúa Cứu Thế Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "約瑟",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶穌母親馬利亞的法定監護人（「丈夫」），也是耶穌基督的養父。"
        }
      ]
    }
  },
