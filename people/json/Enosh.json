  "father": "person:Seth",
  "offspring": [
    "person:Kenan"
  ],
  "roles": [
    "Relative of Jesus",
    "Patriarch"
  ],
  "tribe": "group:Earlypatriarchs",
  "localizations": {
    "eng": {
      "preferred_label": "Enosh",
      "alternate_labels": [
        "Enos"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Enosh",
          "article": "person:Enosh",
          "description": "Grandson of Adam, son of Seth, and father of Kenan. He is mentioned in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَنُوش",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد آدم، وابن شيث، وأبو قينان. وهو مذكور في سلسلة نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以挪士",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚当的孙子，塞特的儿子，该南的父亲。他记载于耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Énosch",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit-fils d’Adam, fils de Seth et père de Kénan. Il est mentionné dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Enosh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jikan Adamu, ɗan Set, kuma uban Kenan. An ambace shi a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "एनोश",
      "descriptions": [
        {
          "source": "acai",
          "description": "आदम का पोता, शेत का पुत्र, और केनान का पिता। उसका उल्लेख यीशु की वंशावली में किया गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Enos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cucu Adam, anak Set, dan ayah Kenan. Dia disebutkan dalam garis keturunan Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Enos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neto de Adão, filho de Sete e pai de Cainã. Ele é mencionado na linhagem genealógica de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Енос",
      "descriptions": [
        {
          "source": "acai",
          "description": "Внук Адама, сын Сифа и отец Каинана. Он упоминается в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Enós",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nieto de Adán, hijo de Set y padre de Cainán. Es mencionado en la línea genealógica de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Enoshi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mjukuu wa Adamu, mwana wa Sethi, na baba yake Kenani. Anatajwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Enos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuna pikinini bilong Adam, pikinini man bilong Set, na papa bilong Kenan. Baibel i kolim nem bilong em long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "أنوش",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد آدم، ولد شيث، وأبو قينان. مذكور في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Enos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Smol bubu boe blong Adam, pikinini boe blong Set, mo papa blong Kenan. Oli tokbaot hem long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Enọsh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa Adam, nwa Set, na nna Kenan. A kpọtụrụ ya aha nʼakara ọmụmụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "एनोश",
      "descriptions": [
        {
          "source": "acai",
          "description": "आदमका नाति, शेतका छोरा र केनानका पिता। तिनको उल्लेख येशूको वंशावलीमा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-nót",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cháu nội của A-đam, con trai của Sết, và là cha của Kê-nan. Ông được đề cập trong gia phả của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "以挪士",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞當的孫子，塞特的兒子，該南的父親。他在耶穌的家譜中被提及。"
        }
      ]
    }
  },
