        }
      ]
    },
    "spa": {
      "preferred_label": "Abiezer",
      "descriptions": [
        {
          "source": "acai",
          "description": "Descendiente de Manasés y líder de uno de los clanes que se establecieron al oeste del río Jordán."
        }
      ]
    },
    "swh": {
      "preferred_label": "Abiezeri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mzao wa Manase, na kiongozi wa mojawapo ya koo zilizokaa upande wa magharibi wa Mto Yordani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Abieser",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuna pikinini bilong Manase, na lida bilong wanpela famili lain i bin kisim graun long hap san i go daun bilong wara Jordan."
        }
      ]
    },
    "apd": {
      "preferred_label": "أبيعزر",
      "descriptions": [
        {
          "source": "acai",
          "description": "من نسل منسى، وقائد واحدة من العشائر السكنت غرب نهر الأردن."
        }
      ]
    },
    "bis": {
      "preferred_label": "Abiesa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini biaen blong Manase, mo lida blong wan long ol laen we oli stap long wes saed blong Jodan Reva."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Abieza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa Manase, na onye ndú nke otu n'ime agbụrụ ndị biri n'ọdịda anyanwụ nke Osimiri Jọdan."
        }
      ]
    },
    "nep": {
      "preferred_label": "अबीएजेर",
      "descriptions": [
        {
          "source": "acai",
          "description": "मनश्शेका सन्तान, र यर्दन नदीको पश्चिमतिर बसोबास गर्ने कुलहरूमध्ये एकका अगुवा।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-bi-ê-xe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hậu tự của Ma-na-se, và là người lãnh đạo của một trong những thị tộc định cư ở phía tây sông Giô-đanh."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞比以謝",
      "descriptions": [
        {
          "source": "acai",
          "description": "瑪拿西的後裔，定居約旦河西的其中一個宗族的首領。"
        }
      ]
    }
