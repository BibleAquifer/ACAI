    },
    "bis": {
      "preferred_label": "Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong Edom long taem we kingdom blong Isrel i joen gud wanples mo i wan enemi blong King Solomon."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu eze ndị Edọm nʼoge alaeze dị nʼotu nke Izrel na onye iro Eze Solomọn."
        }
      ]
    },
    "nep": {
      "preferred_label": "हदद",
      "descriptions": [
        {
