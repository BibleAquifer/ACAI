  "localizations": {
    "eng": {
      "preferred_label": "Salome",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Salome",
          "article": "person:Salome",
          "description": "Galilean woman who followed Jesus. She was one of the women who witnessed Jesus's death on the cross."
        }
      ]
    },
    "fra": {
      "preferred_label": "Salomé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Femme galiléenne qui suivait Jésus. Elle était l'une des femmes témoins de la mort de Jésus sur la croix."
        }
      ]
    },
    "spa": {
      "preferred_label": "Salomé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mujer galilea que siguió a Jesús. Fue una de las mujeres que presenciaron la muerte de Jesús en la cruz."
        }
      ]
    },
    "arb": {
      "preferred_label": "سَالومَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "امرأة جليلية تبعت يسوع، وكانت إحدى النساء اللواتي شهدن موته على الصليب."
        }
      ]
    },
    "zhs": {
      "preferred_label": "撒罗米",
      "descriptions": [
        {
          "source": "acai",
          "description": "跟随耶稣的加利利妇女。她是见证耶稣在十字架上受难的妇女之一。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Salome",
      "descriptions": [
        {
          "source": "acai",
          "description": "Matar Galili wadda ta bi Yesu. Tana ɗaya daga cikin matan da suka shaida mutuwar Yesu a kan gicciye."
        }
      ]
    },
    "hin": {
      "preferred_label": "सलोमी",
      "descriptions": [
        {
          "source": "acai",
          "description": "गलील की एक स्त्री जो यीशु के पीछे हो ली थी। वह उन स्त्रियों में से एक थी जो क्रूस पर यीशु की मृत्यु की गवाह थीं।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Salome",
      "descriptions": [
        {
          "source": "acai",
          "description": "Perempuan Galilea yang mengikut Yesus. Ia adalah salah seorang perempuan yang menyaksikan kematian Yesus di kayu salib."
        }
      ]
    },
    "por": {
      "preferred_label": "Salomé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mulher galileia que seguiu a Jesus. Ela foi uma das mulheres que testemunharam a morte de Jesus na cruz."
        }
      ]
    },
    "rus": {
      "preferred_label": "Саломия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Галилеянка, последовательница Иисуса. Она была одной из женщин, ставших свидетельницами смерти Иисуса на кресте."
        }
      ]
    },
    "swh": {
      "preferred_label": "Salome",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamke Mgalilaya aliyemfuata Yesu. Alikuwa mmoja wa wanawake walioshuhudia kifo cha Yesu msalabani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Salome",
      "descriptions": [
        {
          "source": "acai",
          "description": "Meri bilong Galili em i bin bihainim Jisas. Em i wanpela bilong ol meri i bin lukim Jisas i dai long diwai kros."
        }
      ]
    },
    "apd": {
      "preferred_label": "سالومة",
      "descriptions": [
        {
          "source": "acai",
          "description": "مرأة جليلية تبعت يسوع. كانت واحدة من النسوان الشهدن موت يسوع على الصليب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Salome",
      "descriptions": [
        {
          "source": "acai",
          "description": "Woman Galili we i biaenem Jisas. Hem i wan long ol woman we oli luk we Jisas i ded long kros."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Salomi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwanyị Galili nke sooro Jisọs. Ọ bụ otu nʼime ụmụ nwanyị hụrụ ọnwụ Jisọs nʼobe."
        }
      ]
    },
    "nep": {
      "preferred_label": "सलोमी",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूलाई पछ्याउने एक गालीलकी स्त्री। उनी क्रूसमा येशूको मृत्युको प्रत्यक्षदर्शी स्त्रीहरूमध्ये एक थिइन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sa-lô-mê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một phụ nữ vùng Ga-li-lê đã đi theo Chúa Giê-xu. Bà là một trong những phụ nữ đã chứng kiến Chúa Giê-xu chết trên thập tự giá."
        }
      ]
    },
    "zht": {
      "preferred_label": "撒羅米",
      "descriptions": [
        {
          "source": "acai",
          "description": "跟隨耶穌的加利利婦女。她是目睹耶穌死在十字架上的婦女之一。"
        }
      ]
    }
  },
