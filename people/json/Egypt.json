  "localizations": {
    "eng": {
      "preferred_label": "Egypt",
      "alternate_labels": [
        "Mizraim"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Egypt",
          "article": "person:Egypt",
          "description": "Second son of Ham, the patriarch Noah's son. Egypt is regarded as the founder of the Egyptian nation."
        }
      ]
    },
    "fra": {
      "preferred_label": "Mitsraïm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Deuxième fils de Cham, le fils du patriarche Noé. Mitsraïm est considéré comme le fondateur de la nation égyptienne."
        }
      ]
    },
    "spa": {
      "preferred_label": "Mizraim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Segundo hijo de Cam, el hijo del patriarca Noé. A Egipto (Mizraim) se le considera el fundador de la nación egipcia."
        }
      ]
    },
    "arb": {
      "preferred_label": "مِصْرَايِم",
      "descriptions": [
        {
          "source": "acai",
          "description": "الابن الثاني لحام، ابن البطريرك نوح. ويُعتبر مصرايم مؤسس أمة المصريين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "麦西",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长挪亚的儿子含的次子。他被认为是埃及人的始祖。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Masar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗa na biyu na Ham, ɗan kakan nan Nuhu. Ana ɗaukar Masar a matsayin wanda ya kafa al’ummar Masar."
        }
      ]
    },
    "hin": {
      "preferred_label": "मिस्र",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नूह के पुत्र हाम का दूसरा पुत्र। मिस्र को मिस्री जाति का संस्थापक माना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Misraim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Putra kedua Ham, anak patriark Nuh. Misraim dianggap sebagai pendiri bangsa Mesir."
        }
      ]
    },
    "por": {
      "preferred_label": "Mizraim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Segundo filho de Cam, filho do patriarca Noé. É considerado o fundador da nação egípcia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мицраим",
      "descriptions": [
        {
          "source": "acai",
          "description": "Второй сын Хама, сына патриарха Ноя. Мицраим (Египет) считается родоначальником египетского народа."
        }
      ]
    },
    "swh": {
      "preferred_label": "Misraimu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa pili wa Hamu, mwana wa patriarki Nuhu. Misri (Misraimu) huhesabiwa kuwa mwanzilishi wa taifa la Misri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Isip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba 2 pikinini man bilong Ham, pikinini bilong hetman Noa. Ol i save tingim Isip olsem man i bin kamapim kantri Isip."
        }
      ]
    },
    "apd": {
      "preferred_label": "مصرايم",
      "descriptions": [
        {
          "source": "acai",
          "description": "الابن التاني لحام، ابن البطريرك نوح. مصرايم بيعتبر مؤسس الأمة المصرية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ijip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seken boe blong Ham, we i pikinini boe blong patriaka Noa. Ijip hem i stamba blong neson ya Ijip."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ijipt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke nke abụọ nke Ham, bụ nwa nna ochie Noa. A na-ewere Ijipt dịka onye guzobere mba Ijipt."
        }
      ]
    },
    "nep": {
      "preferred_label": "मिश्रइम",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता नूहका छोरा हामका दोस्रो छोरा। उनलाई मिश्री राष्ट्रका संस्थापक मानिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Mích-ra-im",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai thứ hai của Cham, con trai của tổ phụ Nô-ê. Mích-ra-im được coi là người sáng lập dân tộc Ai Cập."
        }
      ]
    },
    "zht": {
      "preferred_label": "麥西",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長挪亞之子含的次子。麥西被認為是埃及民族的始祖。"
        }
      ]
    }
  },
