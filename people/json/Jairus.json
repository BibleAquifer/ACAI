  "localizations": {
    "eng": {
      "preferred_label": "Jairus",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jairus",
          "article": "person:Jairus",
          "description": "Ruler of the synagogue, perhaps at Capernaum. Jesus raised Jarius's young daughter from the dead."
        }
      ]
    },
    "fra": {
      "preferred_label": "Jaïrus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chef de la synagogue, peut-être à Capernaüm. Jésus ressuscita sa jeune fille d'entre les morts."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jairo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jefe de la sinagoga, tal vez en Capernaúm. Jesús resucitó de los muertos a la joven hija de Jairo."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَايِرُس",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيس المجمع، ربما في كفرناحوم. أقام يسوع ابنته الصغيرة من الأموات."
        }
      ]
    },
    "zhs": {
      "preferred_label": "睚鲁",
      "descriptions": [
        {
          "source": "acai",
          "description": "管会堂的人，可能在迦百农。耶稣曾使睚鲁的小女儿从死里复活。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yayirus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mai mulkin majami’a, watakila a Kafarna’um. Yesu ya tā da ƙaramar ’yar Yayirus daga matattu."
        }
      ]
    },
    "hin": {
      "preferred_label": "याईर",
      "descriptions": [
        {
          "source": "acai",
          "description": "आराधनालय का एक सरदार, संभवतः कफरनहूम में। यीशु ने याईर की छोटी बेटी को मरे हुओं में से जिलाया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yairus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kepala rumah ibadat, mungkin di Kapernaum. Yesus membangkitkan anak perempuan Yairus yang masih muda dari kematian."
        }
      ]
    },
    "por": {
      "preferred_label": "Jairo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Líder da sinagoga, provavelmente em Cafarnaum. Jesus ressuscitou a filha jovem de Jairo dentre os mortos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иаир",
      "descriptions": [
        {
          "source": "acai",
          "description": "Начальник синагоги, вероятно, в Капернауме. Иисус воскресил из мёртвых юную дочь Иаира."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yairo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kiongozi wa sinagogi, huenda ikawa kule Kapernaumu. Yesu alimfufua binti yake mdogo kutoka kwa wafu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jairus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hetman bilong haus lotu, ating long Kaperneam. Jisas i bin kirapim bek yangpela pikinini meri bilong Jairus long matmat."
        }
      ]
    },
    "apd": {
      "preferred_label": "يايرس",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيس المجمع، يمكن في كفرناحوم. يسوع قَوَّم بتو الصغيرة من الموت."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jaeras",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lida long haos blong prea, maet long Kafaneom. Jisas i mekem pikinini gel blong Jaeras i laef bakegen long ded."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jairọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyeisi ụlọ ekpere, ma eleghị anya na Kapaniọm. Jisọs si nʼọnwụ kpọlite nwa ya nwaanyị."
        }
      ]
    },
    "nep": {
      "preferred_label": "याइरस",
      "descriptions": [
        {
          "source": "acai",
          "description": "सम्भवतः कफर्नहुमको यहूदी सभाघरका एक अगुवा। येशूले याइरसकी सानी छोरीलाई मरेकाहरूबाट जीवित पार्नुभयो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giai-ru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người cai quản nhà hội, có lẽ tại Ca-bê-na-um. Chúa Giê-xu đã khiến con gái nhỏ của Giai-ru sống lại từ cõi chết."
        }
      ]
    },
    "zht": {
      "preferred_label": "睚魯",
      "descriptions": [
        {
          "source": "acai",
          "description": "管會堂的人，可能是在迦百農。耶穌使睚魯的小女兒從死裏復活。"
        }
      ]
    }
  },
