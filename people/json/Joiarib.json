      "descriptions": [
        {
          "source": "acai",
          "gloss": "Joiarib",
          "article": "person:Joiarib",
          "description": "A priest living during the Israelite exile and return. He was father of Jedaiah."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُويَارِيب",
      "descriptions": [
        {
          "source": "acai",
          "description": "كاهن عاش خلال فترة سبي بني إسرائيل والرجوع منه. كان أبا يدايا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约雅立",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在以色列人流亡与回归时期的一位祭司。他是耶大雅的父亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jojarib",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un prêtre ayant vécu pendant l'exil et le retour des Israélites. Il était père de Jedaeja."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yohiyarib",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani firist da ya rayu a lokacin bauta da komowar Isra'ilawa. Shi ne mahaifin Yedahiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "योयारीब",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलियों के बंधुवाई और वापसी के समय जीवित एक याजक। वह यदायाह का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yoyarib",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang imam yang hidup pada masa pembuangan dan pemulangan Israel. Ia adalah ayah Yedaya."
        }
      ]
    },
    "por": {
      "preferred_label": "Joiaribe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um sacerdote que viveu durante o exílio e o retorno israelita. Ele era pai de Jedaías."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иоиарив",
      "descriptions": [
        {
          "source": "acai",
          "description": "Священник, живший во время вавилонского пленения и возвращения из него. Отец Иедаии."
        }
      ]
    },
    "spa": {
      "preferred_label": "Joyarib",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sacerdote que vivió durante el exilio y el retorno de los israelitas. Fue padre de Jedaías."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yoyaribu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhani aliyeishi wakati wa uhamisho wa Waisraeli na kurudi kwao. Alikuwa baba wa Yedaya."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Joiarip",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pris i bin stap long taim ol Israel i stap kalabus na taim ol i go bek. Em i papa bilong Jedaia."
        }
      ]
    },
    "apd": {
      "preferred_label": "يوياريب",
      "descriptions": [
        {
          "source": "acai",
          "description": "كاهن عاش وكت السبي والرجوع لبني إسرائيل. كان أبو يداعيا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Joearib",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pris we i laef long taem blong eksael mo kambak blong ol laen blong Isrel. Hem i papa blong Jedaea."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Joiarib",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye nchụaja biri ndụ nʼoge nchụpụ na nloghachi ndị Izrel. Ọ bụ nna Jedaya."
        }
      ]
    },
    "nep": {
      "preferred_label": "योयारीब",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएली निर्वासन र फिर्तीको समयका एक पुजारी। तिनी यदायाहका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-gia-ríp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thầy tế lễ sống trong thời kỳ dân Y-sơ-ra-ên bị lưu đày và hồi hương. Ông là cha của Giê-đa-gia."
        }
      ]
    },
    "zht": {
      "preferred_label": "約雅立",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在以色列人被擄與回歸時期的祭司，是耶大雅的父親。"
        }
      ]
    }
  },
