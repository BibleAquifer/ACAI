      "descriptions": [
        {
          "source": "acai",
          "gloss": "Korah",
          "article": "person:Korah",
          "description": "A son of the patriarch Esau by Oholibamah, and brother of Jeush and Jalam."
        }
      ]
    },
    "arb": {
      "preferred_label": "قورَحَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن بطريرك عيسو من أهوليبامة، وأخو يعوش ويعلام."
        }
      ]
    },
    "zhs": {
      "preferred_label": "可拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长以扫与阿何利巴玛所生的儿子，也是耶乌施和雅兰的兄弟。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Koré",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Ésaü et d'Oholibama, et frère de Jéusch et Jaelam."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan uban iyali Isuwa ta wurin Oholibama, kuma ɗan'uwan Yewush da Yalam."
        }
      ]
    },
    "hin": {
      "preferred_label": "कोरह",
      "descriptions": [
        {
          "source": "acai",
          "description": "ओहोलीबामा के द्वारा कुलपिता एसाव का एक पुत्र, और यूश तथा यालाम का भाई।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Korah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari bapa leluhur Esau melalui Oholibama, dan saudara laki-laki Yeush dan Yaelam."
        }
      ]
    },
    "por": {
      "preferred_label": "Corá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho do patriarca Esaú com Aolibama e irmão de Jeús e Jalão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Корей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Исава от Оливемы, брат Иеуша и Иеглома."
        }
      ]
    },
    "spa": {
      "preferred_label": "Coré",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Esaú con Aholibama, y hermano de Jeús y Jaalam."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa kiongozi wa ukoo Esau kupitia Oholibama, na ndugu yake Yeushi na Yalamu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong bikman Iso wantaim Oholibama, na brata bilong Jeus na Jalam."
        }
      ]
    },
    "apd": {
      "preferred_label": "قورح",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد من أولاد عيسو من أهوليبامة، وأخو يعوش ويعلام."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan boe blong patriak ya Esao wetem Oholibama, mo brata blong Jehus mo Jalam."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kora",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nke nna ochie bụ Ịsọ mụtara site n'aka Oholibama, na nwanne Jeush na Jalam."
        }
      ]
    },
    "nep": {
      "preferred_label": "कोरह",
      "descriptions": [
        {
          "source": "acai",
          "description": "ओहोलीबामाबाट कुलपिता एसावका एक छोरा, र येऊश र यालामका भाइ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Cô-ra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của tộc trưởng Ê-sau với Ô-hô-li-ba-ma, và là anh em của Giê-úc và Gia-lam."
        }
      ]
    },
    "zht": {
      "preferred_label": "可拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長以掃與阿何利巴瑪所生的兒子，是耶烏施和雅蘭的兄弟。"
        }
      ]
    }
  },
