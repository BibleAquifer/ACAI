  "localizations": {
    "eng": {
      "preferred_label": "Rizpah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rizpah",
          "article": "person:Rizpah",
          "description": "A daughter of Aiah and concubine of Saul. She was the mother of Armoni and Mephibosheth."
        }
      ]
    },
    "arb": {
      "preferred_label": "رِصْفَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابنة أَيَّة وسُرِّيَّة شاول. كانت أُمَّ أَرْمونِي ومَفِيبوشَث."
        }
      ]
    },
    "zhs": {
      "preferred_label": "利斯巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "爱亚的女儿，扫罗的妃嫔。她是亚摩尼和米非波设的母亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Ritspa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fille d'Ajja et concubine de Saül. Elle était la mère d'Armoni et de Mephiboscheth."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rizfa",
      "descriptions": [
        {
          "source": "acai",
          "description": "’Yar Aiya kuma ƙwarƙwarar Shawulu. Ita ce mahaifiyar Armoni da Mefiboshet."
        }
      ]
    },
    "hin": {
      "preferred_label": "रिस्पा",
      "descriptions": [
        {
          "source": "acai",
          "description": "अय्या की बेटी और शाऊल की रखैल। वह अर्मोनी और मपीबोशेत की माता थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Rizpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak perempuan Aya dan gundik Saul. Dia adalah ibu dari Armoni dan Mefiboset."
        }
      ]
    },
    "por": {
      "preferred_label": "Rispa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma filha de Aiá e concubina de Saul. Ela foi a mãe de Armoni e Mefibosete."
        }
      ]
    },
    "rus": {
      "preferred_label": "Рицпа",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дочь Айя и наложница Саула. Она была матерью Армония и Мемфивосфея."
        }
      ]
    },
    "spa": {
      "preferred_label": "Rizpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hija de Aja y concubina de Saúl. Fue la madre de Armoni y Mephi-boseth."
        }
      ]
    },
    "swh": {
      "preferred_label": "Rispa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Binti wa Aya na suria wa Sauli. Alikuwa mama ya Armoni na Mefiboshethi."
        }
      ]
    },
    "apd": {
      "preferred_label": "رزفة",
      "descriptions": [
        {
          "source": "acai",
          "description": "بت أيَّة وسرية شاول. وأم أرموني ومفيبوشث."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rispaha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan dota blong Aea mo wan narafala woman blong King Sol. Hem i mama blong Amoni mo Mefiboset."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Rizpa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwanyị Aịa na iko nwanyị Sọl. Ọ bụ nne Amoni na Mefiboshet."
        }
      ]
    },
    "nep": {
      "preferred_label": "रिश्‍पा",
      "descriptions": [
        {
          "source": "acai",
          "description": "अय्याकी छोरी र शाऊलकी उपपत्‍नी। तिनी आरमोनी र मपीबोशेतकी आमा थिइन्।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rispa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini meri bilong Aia na namba 2 meri bilong Sol. Em i mama bilong Armoni na Mefiboset."
        }
      ]
    },
    "vie": {
      "preferred_label": "Rít-ba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con gái của Ai-gia và là cung phi của Sau-lơ. Bà là mẹ của Ạt-mô-ni và Mê-phi-bô-sết."
        }
      ]
    },
    "zht": {
      "preferred_label": "利斯巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "愛亞的女兒，掃羅的妃嬪。她是亞摩尼和米非波設的母親。"
        }
      ]
    }
  },
