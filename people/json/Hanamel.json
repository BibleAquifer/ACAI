  "localizations": {
    "eng": {
      "preferred_label": "Hanamel",
      "alternate_labels": [
        "Hanameel"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hanamel",
          "article": "person:Hanamel",
          "description": "A son of Shallum and cousin of the Prophet Jeremiah, who requested him to buy land in Anathoth. "
        }
      ]
    },
    "fra": {
      "preferred_label": "Hanameel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Schallum et cousin du prophète Jérémie, qui lui demanda d’acheter un champ à Anathoth."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hanamel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Salum y primo del profeta Jeremías, a quien le pidió que comprara un campo en Anatot."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَنَمْئِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱبْنُ شَلُّومَ وَٱبْنُ عَمِّ ٱلنَّبِيِّ إِرْمِيَا، ٱلَّذِي طَلَبَ مِنْهُ أَنْ يَشْتَرِيَ حَقْلًا فِي عَنَاثُوثَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "哈拿篾",
      "descriptions": [
        {
          "source": "acai",
          "description": "沙龙的儿子，先知耶利米的堂兄弟，曾请求耶利米买下他在亚拿突的地。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hananel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Shallum kuma ɗan’uwan Annabi Irmiya, wanda ya roƙe shi yă sayi fili a Anatot."
        }
      ]
    },
    "hin": {
      "preferred_label": "हनमेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "शल्लूम का पुत्र और भविष्यद्वक्ता यिर्मयाह का चचेरा भाई, जिसने उससे अनातोत में भूमि मोल लेने का आग्रह किया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hanameel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari Salum dan sepupu nabi Yeremia, yang memintanya membeli sebidang ladang di Anatot."
        }
      ]
    },
    "por": {
      "preferred_label": "Hanameel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Salum e primo do profeta Jeremias, a quem pediu que comprasse um campo em Anatote."
        }
      ]
    },
    "rus": {
      "preferred_label": "Анамеил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Саллума и двоюродный брат пророка Иеремии, попросивший его купить землю в Анафофе."
        }
      ]
    },
    "swh": {
      "preferred_label": "Hanameli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Shalumu na binamu ya Nabii Yeremia, aliyemwomba anunue shamba huko Anathothi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hanamel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Salum na smolpapasun bilong profet Jeremaia, em man i bin askim Jeremaia long baim graun bilong en long Anatot."
        }
      ]
    },
    "apd": {
      "preferred_label": "حنمعيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد شلوم وود عم النبي إرميا، الطلب من إرميا يشتري الحقل في عناثوث."
        }
      ]
    },
    "bis": {
      "preferred_label": "Hanamel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Salum mo smol papa blong Profet Jeremaea, we i askem hem blong i pemaot graon long Anatot."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hanamel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Shalum na nwa nwanne nna nke Onye Amụma Jeremaya, onye rịọrọ ya ka ọ zụrụ ala nʼAnatot."
        }
      ]
    },
    "nep": {
      "preferred_label": "हनमेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "शल्लूमका छोरा र अगमवक्ता यर्मियाका काकाका छोरा, जसले यर्मियालाई अनातोतमा खेत किन्न अनुरोध गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ha-na-mê-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Sa-lum và là anh em họ của Tiên tri Giê-rê-mi, người đã đề nghị ông mua đất ở A-na-tốt."
        }
      ]
    },
    "zht": {
      "preferred_label": "哈拿篾",
      "descriptions": [
        {
          "source": "acai",
          "description": "沙龍的兒子，先知耶利米的堂兄（或表兄），曾請求耶利米買下自己在亞拿突的地。"
        }
      ]
    }
  },
