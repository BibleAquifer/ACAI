  "localizations": {
    "eng": {
      "preferred_label": "Ben-hadad",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ben-Hadad",
          "article": "person:Ben-hadad",
          "description": "King of Syria, son of Tabrimmon, grandson of Hezion. He ruled during the time of Israel’s divided kingdom."
        }
      ]
    },
    "fra": {
      "preferred_label": "Ben-Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi de Syrie, fils de Thabrimmon, petit-fils de Hezjon. Il régna à l'époque du royaume divisé d'Israël."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ben-adad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey de Siria, hijo de Tabrimón y nieto de Hezión. Gobernó durante el período del reino dividido de Israel."
        }
      ]
    },
    "zhs": {
      "preferred_label": "便·哈达",
      "descriptions": [
        {
          "source": "acai",
          "description": "叙利亚（亚兰）王，他伯利们的儿子，希旬的孙子。他在以色列分裂王国时期统治。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ben-Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Siriya, ɗan Tabrimmon, jikan Heziyon. Ya yi mulki a zamanin rabuwar masarautar Isra'ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "बेन्हदद",
      "descriptions": [
        {
          "source": "acai",
          "description": "अराम (सीरिया) का राजा, तब्रिम्मोन का पुत्र, हेज्योन का पोता। उसने इस्राएल के विभक्त राज्य के समय शासन किया।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Benhadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Raja Aram, anak Tabrimon, cucu Hezion. Ia memerintah pada masa kerajaan terpecah Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Ben-Hadade",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rei da Síria, filho de Tabrimom, neto de Heziom. Ele governou durante o tempo do reino dividido de Israel."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ben-Hadadi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Shamu, mwana wa Tabrimoni, mjukuu wa Hezioni. Alitawala wakati wa ufalme uliogawanyika wa Israeli."
        }
      ]
    },
    "apd": {
      "preferred_label": "بنهدد",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك آرام (سوريا)، ابن طبريمون حفيد حزيون. حكم في زمن انقسام مملكة إسرائيل."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَنْهَدَدُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك آرام، وابن طبريمون وحفيد حزيون. حكم خلال عهد المملكة المنقسمة لإسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Benadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "King blong Siria, pikinini boe blong Tabrimon, mo smolbubu blong Hesion. Hem i rulaot long taem we kingdom blong Isrel i seraot."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ben-Hadad",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze Siria, nwa nwoke Tabrimọn, nwa nwa Hezion. Ọ chịrị nʼoge alaeze kewara ekewa nke Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "बेन-हदद",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिरियाका राजा, तब्रिमोनका छोरा, हेज्योनका नाति। तिनले इस्राएलको विभाजित अधिराज्यको समयमा शासन गरेका थिए।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Венадад",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь Сирии, сын Тавримона, внук Хезиона. Правил во времена разделенного царства Израиля."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Benhadat",
      "descriptions": [
        {
          "source": "acai",
          "description": "King bilong Siria, pikinini man bilong Tabrimon, tumbuna pikinini bilong Hesion. Em i bin mekim wok king long taim bilong بروk بروk kingdom bilong Israel."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bên Ha-đát",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vua Sy-ri, con trai của Táp-ri-môn, cháu nội của Hê-xi-ôn. Ông trị vì vào thời vương quốc phân chia của Y-sơ-ra-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "便‧哈達",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞蘭王，他伯利們的兒子，希旬的孫子。他在以色列王國分裂時期統治。"
        }
      ]
    }
  },
