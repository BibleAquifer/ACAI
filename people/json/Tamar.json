  ],
  "localizations": {
    "eng": {
      "preferred_label": "Tamar",
      "alternate_labels": [
        "Thamar"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Tamar",
          "article": "person:Tamar",
          "description": "She was wife of Er, son of the patriarch Judah, and mother of Perez and Zerah. She is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "ثَامَار",
      "descriptions": [
        {
          "source": "acai",
          "description": "كانت زوجة عير بن بطريرك يهوذا، وأم فارص وزارح. وهي مذكورة في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "她玛",
      "descriptions": [
        {
          "source": "acai",
          "description": "她是先祖犹大的儿子珥的妻子，也是法勒斯和谢拉的母亲。她被列在耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elle était la femme d'Er, fils du patriarche Juda, et la mère de Perets et de Zérach. Elle figure dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ita ce matar Er, ɗan uban iyali Yahuda, kuma mahaifiyar Ferez da Zera. An jera ta a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "तामार",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह कुलपति यहूदा के पुत्र एर की पत्नी, और पेरेस तथा जेरह की माँ थी। वह यीशु की वंशावली में सूचीबद्ध है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ia adalah istri Er, putra bapa leluhur Yehuda, dan ibu dari Peres dan Zerah. Ia tercatat dalam garis keturunan Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ela foi esposa de Er, filho do patriarca Judá, e mãe de Perez e Zerá. Ela consta na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Фамарь",
      "descriptions": [
        {
          "source": "acai",
          "description": "Она была женой Ира, сына патриарха Иуды, и матерью Фареса и Зары (Зераха). Она упоминается в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fue esposa de Er, hijo del patriarca Judá, y madre de Fares y Zera. Está incluida en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tamari",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alikuwa mke wa Eri, mwana wa mzee wa ukoo Yuda, na mama yao Peresi na Zera. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tamar",
      "descriptions": [
        {
          "source": "acai",
          "description": "Em i bin meri bilong Er, pikinini man bilong hetman Juda, na mama bilong Peres wantaim Sera. Nem bilong em i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "ثامار",
      "descriptions": [
        {
          "source": "acai",
          "description": "كانت مرأة عير ولد يعقوب، وأم فارص وزارح، ومذكورة في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tamara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hem i waef blong Ere, pikinini boe blong patriak Juda, mo mama blong Peres mo Sera. Oli putum nem blong hem long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Tama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọ bụ nwunye Ịa, nwa onyeisi ezinụlọ bụ Juda, ma bụrụkwa nne Perez na Zera. E debere aha ya nʼusoro ọmụmụ nke Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "तामार",
      "descriptions": [
        {
          "source": "acai",
          "description": "तिनी कुलपिता यहूदाका छोरा एरकी पत्नी, तथा पेरेस र जेरहकी आमा थिइन्। तिनको नाउँ येशूको वंशावलीमा सूचीकृत छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ta-ma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bà là vợ của Ê-rơ, con trai của tổ phụ Giu-đa, và là mẹ của Pha-rê và Xê-ra. Bà được liệt kê trong gia phả của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "她瑪",
      "descriptions": [
        {
          "source": "acai",
          "description": "她是族長猶大的兒子珥的妻子，也是法勒斯和謝拉的母親。她被列入耶穌的家譜中。"
        }
      ]
    }
  },
