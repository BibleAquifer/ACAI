          "gloss": "Alphaeus",
          "article": "person:Alphaeus",
          "description": "A man living during the New Testament, father of the disciple James and perhaps Matthew Levi."
        }
      ]
    },
    "fra": {
      "preferred_label": "Alphée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Homme ayant vécu à l'époque du Nouveau Testament, père du disciple Jacques et peut-être de Matthieu Lévi."
        }
      ]
    },
    "spa": {
      "preferred_label": "Alfeo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre que vivió durante el Nuevo Testamento, padre del discípulo Jacobo y tal vez de Mateo Leví."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَلْفَى",
      "descriptions": [
        {
          "source": "acai",
          "description": "رَجُلٌ عَاشَ فِي عَهْدِ ٱلْعَهْدِ ٱلْجَدِيدِ، وَهُوَ أَبُو ٱلتِّلْمِيذِ يَعْقُوبَ، وَرُبَّمَا مَتَّى لَاوِي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚勒腓",
      "descriptions": [
        {
          "source": "acai",
          "description": "新约时代的人物，门徒雅各的父亲，可能也是税吏马太（利未）的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Alfayus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutum da ya rayu a zamanin Sabon Alkawari, mahaifin almajiri Yaƙub kuma wataƙila Mattiyu Lawi."
        }
      ]
    },
    "hin": {
      "preferred_label": "हलफईस",
      "descriptions": [
        {
          "source": "acai",
          "description": "नए नियम के समय का एक पुरुष, जो चेले याकूब और संभवतः मत्ती लेवी का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Alfeus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pria yang hidup pada zaman Perjanjian Baru, ayah dari murid Yesus yang bernama Yakobus dan mungkin dari Matius Lewi."
        }
      ]
    },
    "por": {
      "preferred_label": "Alfeu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem que viveu durante o Novo Testamento, pai do discípulo Tiago e talvez de Mateus Levi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Алфей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, живший во времена Нового Завета, отец ученика Иакова и, возможно, Матфея Левия."
        }
      ]
    },
    "swh": {
      "preferred_label": "Alfayo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamume aliyeishi wakati wa Agano Jipya, babaye mwanafunzi Yakobo na labda Mathayo Lawi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Alfius",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man i bin stap long taim bilong Nupela Testamen, papa bilong disaipel Jems na ating tu bilong Matyu Livai."
        }
      ]
    },
    "apd": {
      "preferred_label": "حلفى",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل عاش في زمن العهد الجديد، أبو التلميذ يعقوب ويمكن متى لاوي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Alfeas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i laef long taem blong Niutesteman, papa blong disaepol ya Jemes mo maet Matiu Livae tu."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Alfiọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke dịrị ndụ nʼoge Ọgbụgba Ndụ Ọhụrụ, nna nke onye na-eso ụzọ bụ Jemis na ikekwe Matiu Livayị."
        }
      ]
    },
    "nep": {
      "preferred_label": "अल्फयस",
      "descriptions": [
        {
          "source": "acai",
          "description": "नयाँ नियमको समयमा बाँचेका एक व्यक्ति, चेला याकूब र सम्भवतः मत्ती लेवीका पिता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "An-phê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người sống vào thời Tân Ước, là cha của sứ đồ Gia-cơ và có thể là của Ma-thi-ơ Lê-vi."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞勒腓",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在新約時代的一名男子，是門徒雅各的父親，可能也是馬太利未的父親。"
        }
      ]
    }
  },
