        }
      ]
    },
    "spa": {
      "preferred_label": "Barjesús",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre que vivió en los tiempos del Nuevo Testamento, también llamado Elimas, mencionado en Hechos 13:6."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Barjisas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man i bin stap long taim bilong Nupela Testamen, em ol i kolim tu long Elimas, Buk Aposel 13:6 i stori long em."
        }
      ]
    },
    "apd": {
      "preferred_label": "بار يشوع",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل عاش في زمن العهد الجديد، وكمان إتسمى عليم، ومذكور في أعمال الرسل 13: 6."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bajisas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i laef long taem blong Niutesteman, we nem blong hem tu Elimas, we oli tokbaot hem long Ol Wok 13:6."
        }
      ]
    },
    "hin": {
      "preferred_label": "बार-यीशु",
      "descriptions": [
        {
          "source": "acai",
          "description": "नए नियम के समय का एक पुरुष, जिसे एलीमास भी कहा गया है, जिसका उल्लेख प्रेरितों के काम 13:6 में है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ba-Jisọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke biri nʼoge Ọgbụgba Ndụ Ọhụrụ, nke a na-akpọkwa Elimas, nke a kpọtụrụ aha nʼakwụkwọ Ọrụ Ndị Ozi 13:6."
        }
      ]
    },
    "nep": {
      "preferred_label": "बार-येशू",
      "descriptions": [
        {
          "source": "acai",
          "description": "नयाँ करारको समयमा जीवित रहेका एक व्यक्ति, जसलाई इलुमास पनि भनिन्छ, प्रेरित १३:६ मा उल्लिखित छन्।"
        }
      ]
    },
    "swh": {
      "preferred_label": "Bar-Yesu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamume aliyeishi wakati wa Agano Jipya, anayeitwa pia Elima, aliyetajwa katika Matendo ya Mitume 13:6."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ba-giê-xu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người sống vào thời Tân Ước, còn được gọi là Ê-li-ma, được đề cập trong Công Vụ 13:6."
        }
      ]
    },
    "zht": {
      "preferred_label": "巴‧耶穌",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在新約時期的一名男子，又名以呂馬，記載於使徒行傳13:6。"
        }
      ]
    }
