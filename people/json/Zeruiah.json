  "localizations": {
    "eng": {
      "preferred_label": "Zeruiah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Zeruiah",
          "article": "person:Zeruiah",
          "description": "A daughter of Jesse, sister of King David, and mother of soldiers Joab, Abishai, and Asahel."
        }
      ]
    },
    "fra": {
      "preferred_label": "Tseruja",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fille d'Isaï, sœur du roi David et mère des soldats Joab, Abischaï et Asaël."
        }
      ]
    },
    "spa": {
      "preferred_label": "Sarvia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hija de Isaí, hermana del rey David y madre de los soldados Joab, Abisai y Asael."
        }
      ]
    },
    "arb": {
      "preferred_label": "صَرُويَةُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱبْنَةُ يَسَّى، وَأُخْتُ ٱلْمَلِكِ دَاوُدَ، وَأُمُّ ٱلْمُحَارِبِينَ يُوآبَ وَأَبِيشَايَ وَعَسَائِيلَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "洗鲁雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶西的女儿，大卫王的姊妹，勇士约押、亚比筛和亚撒黑的母亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Zeruhiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "'Yar Yesse, 'yar'uwar Sarki Dawuda, kuma mahaifiyar sojojin nan Yowab, Abishai, da Asahel."
        }
      ]
    },
    "hin": {
      "preferred_label": "सरूयाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "यिशै की एक पुत्री, राजा दाऊद की बहन, तथा योद्धाओं योआब, अबीशै और असाहेल की माता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Zeruya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak perempuan Isai, saudara perempuan Raja Daud, dan ibu dari para prajurit: Yoab, Abisai, dan Asael."
        }
      ]
    },
    "por": {
      "preferred_label": "Zeruia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filha de Jessé, irmã do rei Davi e mãe dos soldados Joabe, Abisai e Asael."
        }
      ]
    },
    "rus": {
      "preferred_label": "Саруия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дочь Иессея, сестра царя Давида и мать воинов Иоава, Авессы и Асаила."
        }
      ]
    },
    "swh": {
      "preferred_label": "Seruya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Binti wa Yese, dada yake Mfalme Daudi, na mama wa askari Yoabu, Abishai, na Asaheli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Seruia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini meri bilong Jesi, sista bilong King Devit, na mama bilong ol dispela soldia Joap, Abisai, na Asahel."
        }
      ]
    },
    "apd": {
      "preferred_label": "صروية",
      "descriptions": [
        {
          "source": "acai",
          "description": "بت يَسّى، أخت الملك داود، وأم الجنود يوآب وأبيشاي وعساهيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jeruia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan dota blong Jese, sista blong King Deved, mo mama blong ol soldia ya Joab, Abisae, mo Asahel."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Zeruaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwaanyị Jesi, nwanne Eze Devid, na nne ndị agha bụ Joab, Abishai, na Asahel."
        }
      ]
    },
    "nep": {
      "preferred_label": "सरूयाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "यिशैकी छोरी, राजा दाऊदकी दिदी/बहिनी, र सिपाहीहरू योआब, अबीशै र असाहेलकी आमा।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Xê-ru-gia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con gái của Gie-sê, chị em gái của Vua Đa-vít, và là mẹ của các chiến binh Giô-áp, A-bi-sai cùng A-sa-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "洗魯雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶西的女兒、大衛王的姊妹，也是勇士約押、亞比篩和亞撒黑的母親。"
        }
      ]
    }
  },
