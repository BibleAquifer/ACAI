  "localizations": {
    "eng": {
      "preferred_label": "Caleb",
      "alternate_labels": [
        "Carmi",
        "Chelubai",
        "Karmi"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Caleb",
          "article": "person:Caleb.2",
          "description": "A son of Hezron, an ancestor of King David. He is sometimes called Karmi, Carmi, or Chelubai."
        }
      ]
    },
    "arb": {
      "preferred_label": "كَالِب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن حَصْرونَ، وأحد أسلاف الملك داود. يُدعى أحيانًا كَرْمِي أو كَلوبَاي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "迦勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "希斯仑的儿子，大卫王的先祖。他有时也被称为迦米（Karmi、Carmi）或基路拜（Chelubai）。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Caleb",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Hetsron, ancêtre du roi David. Il est parfois appelé Carmi ou Kelubaï."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kaleb",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Hezron, kakan Sarki Dawuda. Wani lokaci ana kiransa Karmi ko Kelubai."
        }
      ]
    },
    "hin": {
      "preferred_label": "कालेब",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेस्रोन का एक पुत्र, जो राजा दाऊद का पूर्वज था। उसे कभी-कभी कर्मी या कलूबै भी कहा जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kaleb",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Hezron, nenek moyang Raja Daud. Ia kadang-kadang disebut Karmi atau Khelubai."
        }
      ]
    },
    "por": {
      "preferred_label": "Calebe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho de Hezrom, ancestral do rei Davi. Ele às vezes é chamado de Carmi ou Quelubai."
        }
      ]
    },
    "rus": {
      "preferred_label": "Халев",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Есрома, предок царя Давида. Иногда его называют Харми или Хелувай."
        }
      ]
    },
    "spa": {
      "preferred_label": "Caleb",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Hesrón y antepasado del rey David. A veces se le llama Carmi o Quelubai."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kalebu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Hesroni, babu wa Mfalme Daudi. Nyakati nyingine anaitwa Karmi au Kelubai."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kalep",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Hesron na tumbuna bilong King Devit. Sampela taim ol i save kolim em Karmi o Kelubai."
        }
      ]
    },
    "apd": {
      "preferred_label": "كالب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد لحصرون، وجد للملك داود. وبيتسمى أحياناً كرمي، أو كلوباي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Keleb",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Hesron, wan bubu blong King Deved. Samtaem oli kolem hem Kami, Carmi, o Selubae."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kaleb",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Hezrọn, nna nna Eze Devid. A na-akpọkwa ya Kami ma ọ bụ Kelubai mgbe ụfọdụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "कालेब",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेस्रोनका एक छोरा, जो राजा दाऊदका पुर्खा थिए। तिनलाई कहिलेकाहीँ कर्मी वा चेलूबै पनि भनिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ca-lép",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con trai của Hết-rôn, tổ phụ của Vua Đa-vít. Ông đôi khi được gọi là Cát-mi (Carmi) hoặc Kê-lu-bai (Chelubai)."
        }
      ]
    },
    "zht": {
      "preferred_label": "迦勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "希斯崙的兒子，大衛王的祖先。他有時也被稱為迦米或基路拜。"
        }
      ]
    }
  },
