        }
      ]
    },
    "hin": {
      "preferred_label": "दिदुमुस (थोमा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दिदुमुस, जिसे थोमा या जुड़वां भी कहा जाता है, नए नियम के समय का एक प्रेरित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Didimus (Tomas)",
      "descriptions": [
        {
          "source": "acai",
