        }
      ]
    },
    "por": {
      "preferred_label": "Dídimo (Tomé)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dídimo, também conhecido como Tomé ou o Gêmeo, foi um apóstolo que viveu durante a época do Novo Testamento."
        }
      ]
    },
    "rus": {
      "preferred_label": "Дидим (Фома)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дидим, также известный как Фома или Близнец, был апостолом, жившим в новозаветные времена."
        }
      ]
    },
    "swh": {
      "preferred_label": "Didimasi (Tomaso)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Didimasi, anayejulikana pia kama Tomaso au Pacha, alikuwa mtume aliyeishi wakati wa Agano Jipya."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Didimus (Tomas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Didimus, narapela nem bilong en Tomas o Kambang, em i bin wanpela apositol i stap long taim bilong Nupela Testamen."
        }
      ]
    },
    "apd": {
      "preferred_label": "ديديموس (توما)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ديديموس، المعروف كمان باسم توما أو التوأم، كان رسول عاش في أزمنة العهد الجديد."
        }
      ]
    },
    "bis": {
      "preferred_label": "Didimus (Tomas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Didimus, we oli kolem hem tu Tomas o Twin, hem i wan aposol we i laef long taem blong Niu Testeman."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Didimọs (Tọmọs)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Didimọs, onye a makwaara dị ka Tọmọs ma ọ bụ Ejima, bụ otu onye nʼime ndị ozi biri nʼoge Ọgbụgba Ndụ Ọhụrụ."
        }
      ]
    },
    "nep": {
      "preferred_label": "दिदुमस (थोमा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "थोमा वा जुम्ल्याहा भनेर पनि चिनिने दिदुमस नयाँ नियमको समयमा बाँचेका एक प्रेरित थिए ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Đi-đim (Thô-ma)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Đi-đim, cũng được gọi là Thô-ma hay Song Sinh, là một sứ đồ sống trong thời Tân Ước."
        }
      ]
    },
    "zht": {
      "preferred_label": "低土馬（多馬）",
      "descriptions": [
        {
          "source": "acai",
          "description": "又名多馬或「雙生子」，是生活在新約時期的使徒。"
        }
      ]
    }
