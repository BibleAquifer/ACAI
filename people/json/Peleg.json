  "tribe": "group:Earlypatriarchs",
  "localizations": {
    "eng": {
      "preferred_label": "Peleg",
      "alternate_labels": [
        "Phalec"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Peleg",
          "article": "person:Peleg",
          "description": "A son of the patriarch Eber, brother of Joktan, and father of Reu. He is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "فَالَج",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن رئيس الآباء عَابِر، وأخو يَقْطَان، وأبو رَعُو. وَرَدَ ذِكْرُهُ في نَسَب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "法勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖希伯的儿子，约坍的兄弟，拉吴的父亲。他被列在耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Péleg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Héber, frère de Jokthan et père de Rehu. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Feleg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan uban iyali Eber, ɗan’uwan Yoktan, kuma mahaifin Reyu. An lissafa shi a cikin layin iyalin Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "पेलेग",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता एबेर का एक पुत्र, योक्तान का भाई और रऊ का पिता। उसका नाम यीशु की वंशावली में दर्ज है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Peleg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak laki-laki dari bapa leluhur Eber, saudara laki-laki Yoktan, dan ayah dari Rehu. Ia terdaftar dalam garis keturunan Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Pelegue",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho do patriarca Eber, irmão de Joctã e pai de Reú. Ele é listado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Фалек",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Евера, брат Иоктана и отец Рагава. Упоминается в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Péleg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del patriarca Heber, hermano de Joctán y padre de Reu. Aparece en el linaje familiar de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Pelegi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa patriarki Eberi, nduguye Yoktani, na baba yake Reu. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pelek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong bikpela tumbuna Eber, brata bilong Joktan, na papa bilong Reu. Em i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "فالج",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد للبطريرك عابر، وأخو يقطان، وأبو رعو. ومذكور في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Peleg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Eba, brata blong Joktan, mo papa blong Reu. Nem blong hem i stap long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Peleg",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke nke nna ochie bụ Eba, nwanne Joktan, na nna Reu. E depụtara ya nʼusoro ọmụmụ nke Jizọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "पेलेग",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता एबेरका छोरा, योक्तानका भाइ र रऊका पिता। तिनको नाउँ येशूको वंशावलीमा सूचीकृत छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Bê-léc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của tổ phụ Hê-be, anh/em của Giốc-tan, và là cha của Rê-hu. Ông được liệt kê trong dòng dõi của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "法勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長希伯的兒子，約坍的兄弟，拉吳的父親。他被列在耶穌的家譜中。"
        }
      ]
    }
  },
