  "localizations": {
    "eng": {
      "preferred_label": "Goliath",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Goliath",
          "article": "person:Goliath",
          "description": "Goliath was a giant Philistine from Gath, the son of Rapha, who was killed by David before he became king of Israel."
        }
      ]
    },
    "fra": {
      "preferred_label": "Goliath",
      "descriptions": [
        {
          "source": "acai",
          "description": "Goliath était un géant philistin originaire de Gath, fils de Rapha, qui fut tué par David avant que celui-ci ne devienne roi d'Israël."
        }
      ]
    },
    "spa": {
      "preferred_label": "Goliat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Goliat fue un gigante filisteo de Gat, hijo de Rapha, a quien David mató antes de convertirse en rey de Israel."
        }
      ]
    },
    "arb": {
      "preferred_label": "جُلْيَات",
      "descriptions": [
        {
          "source": "acai",
          "description": "كان جليات جبارًا فلسطينيًا من جت، وهو ابن رافا، وقد قتله داود قبل أن يصبح ملكًا على إسرائيل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "歌利亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "歌利亚是来自迦特的非利士巨人，拉法的儿子，在以色列王大卫登基前被其杀死。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Goliyat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Goliyat wani ƙaton Bafilistin ne daga Gat, ɗan Rafa, wanda Dawuda ya kashe kafin ya zama sarkin Isra’ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "गोलियत",
      "descriptions": [
        {
          "source": "acai",
          "description": "गोलियत गत नगर का एक दानवाकार पलिश्ती था, जो रापा का पुत्र था, जिसे दाऊद ने इस्राएल का राजा बनने से पहले मार डाला था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Goliat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Goliat adalah seorang raksasa Filistin dari Gat, anak Rafa, yang dibunuh oleh Daud sebelum ia menjadi raja Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Golias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Golias foi um gigante filisteu de Gate, filho de Rafa, que foi morto por Davi antes de este se tornar rei de Israel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Голиаф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Голиаф был филистимским великаном из Гефа, сыном Рафы, убитым Давидом до того, как тот стал царем Израиля."
        }
      ]
    },
    "swh": {
      "preferred_label": "Goliathi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Goliathi alikuwa jitu la Kifilisti kutoka Gathi, mwana wa Mrefai, aliyeuawa na Daudi kabla hajawa mfalme wa Israeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Goliat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Goliat em i wanpela traipela man bilong lain Filistia bilong taun Get, pikinini man bilong Rafa, na Devit i kilim em i dai paslain long em i kamap king bilong Israel."
        }
      ]
    },
    "apd": {
      "preferred_label": "جليات",
      "descriptions": [
        {
          "source": "acai",
          "description": "جليات كان راجل فلسطيني عملاق من جت، ود رافا، وقتلو داود قبل ما يبقى ملك على إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Golaeat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Golaeat hem i wan jampion we i man Filistia blong Gat, we papa blong hem Rafa, we Deved i kilim hem i ded bifo we hem i kam king blong Isrel."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Golaịat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Golaịat bụ dike Filistia toro ogologo nke ukwuu sitere na Gat, nwa Rafa, onye Devid gburu tupu ya aghọọ eze Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "गोल्यत",
      "descriptions": [
        {
          "source": "acai",
          "description": "गोल्यत गातका एक विशालकाय पलिश्ती थिए, जो राफाका छोरा थिए, जसलाई दाऊद इस्राएलका राजा हुनुभन्दा अघि उनले मारेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Gô-li-át",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gô-li-át là một người Phi-li-tin khổng lồ đến từ Gát, con trai của Ra-pha, bị Đa-vít giết trước khi ông trở thành vua của Ít-ra-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "歌利亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "歌利亞是來自迦特的非利士巨人，拉法的兒子，在大衛成為以色列王之前被大衛所殺。"
        }
      ]
    }
  },
