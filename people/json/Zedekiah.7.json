        }
      ]
    },
    "swh": {
      "preferred_label": "Sedekia (Yeremia 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sedekia, mwana wa Hanania, alikuwa mtu aliyeishi wakati wa ufalme uliogawanyika, anayetajwa katika Yeremia 36:12."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sedekaia (Jeremia 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sedekaia, pikinini man bilong Hanania, em i wanpela man i bin stap long taim bilong kingdom i stap بروken long tupela hap, em Jeremaia 36:12 i kolim nem bilong em."
        }
      ]
    },
    "apd": {
      "preferred_label": "صدقيا (إرميا 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "صدقيا، ولد حننيا، كان راجل عاش في زمن المملكة المنقسمة، ومذكور في إرميا 36: 12."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jedekia (Jeremaea 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jedekia, boe blong Hanania, hem i wan man we i laef long taem blong dividet kingdom, we Jeremaea 36:12 i tokbaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Zedekaya (Jeremaia 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zedekaya, nwa Hananaya, bụ nwoke dịrị ndụ nʼoge alaeze kewara ekewa, nke a kpọtụrụ aha na Jeremaya 36:12."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिदकियाह (यर्मिया 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिदकियाह, हनन्याहका छोरा, विभाजित राज्यको समयमा बाँचेका एक पुरुष थिए, जसको उल्लेख यर्मिया ३६:१२ मा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-đê-kia (Giê-rê-mi 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sê-đê-kia, con trai của Ha-na-nia, là một người sống trong thời kỳ vương quốc phân chia, được đề cập trong Giê-rê-mi 36:12."
        }
      ]
    },
    "zht": {
      "preferred_label": "西底家 (耶利米書 36:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "西底家是哈拿尼雅的兒子，生活在王國分裂時期，見於耶利米書36:12。"
        }
      ]
    }
