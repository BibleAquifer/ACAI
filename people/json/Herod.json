  "localizations": {
    "eng": {
      "preferred_label": "Herod",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Herod",
          "article": "person:Herod",
          "description": "King of Judah during the birth of Jesus. He was the father of several rulers including: Herod Antipas and Herod Archelaus."
        }
      ]
    },
    "fra": {
      "preferred_label": "Hérode",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi de Judée lors de la naissance de Jésus. Il était le père de plusieurs dirigeants, dont Hérode Antipas et Hérode Archélaüs."
        }
      ]
    },
    "spa": {
      "preferred_label": "Herodes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey de Judea durante el nacimiento de Jesús. Fue padre de varios gobernantes, entre ellos Herodes Antipas y Herodes Arquelao."
        }
      ]
    },
    "arb": {
      "preferred_label": "هِيرودُس",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك يهوذا في زمن ولادة يسوع. وكان والد عدة حكام منهم: هيرودس أنتيباس وأرخيلاوس."
        }
      ]
    },
    "zhs": {
      "preferred_label": "希律",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶稣降生时期的犹太王。他是希律·安提帕和希律·亚基老等多位统治者的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hiridus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Yahudiya a lokacin haihuwar Yesu. Shi ne uban sarakuna da yawa, har da Hiridus Antifas da Hiridus Arkelawus."
        }
      ]
    },
    "hin": {
      "preferred_label": "हेरोदेस",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु के जन्म के समय यहूदिया का राजा। वह कई शासकों का पिता था, जिनमें हेरोदेस अन्तिपास और हेरोदेस अरखिलाउस शामिल हैं।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Herodes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Raja Yudea pada waktu kelahiran Yesus. Ia adalah ayah dari beberapa penguasa termasuk: Herodes Antipas dan Herodes Arkhelaus."
        }
      ]
    },
    "por": {
      "preferred_label": "Herodes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rei de Judá durante o nascimento de Jesus. Ele foi pai de vários governantes, incluindo Herodes Antipas e Herodes Arquelau."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ирод",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь Иудеи во время рождения Иисуса. Он был отцом нескольких правителей, включая Ирода Антипу и Ирода Архелая."
        }
      ]
    },
    "swh": {
      "preferred_label": "Herode",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Yuda wakati wa kuzaliwa kwa Yesu. Alikuwa baba wa watawala kadhaa wakiwemo: Herode Antipa na Herode Arkelao."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Herot",
      "descriptions": [
        {
          "source": "acai",
          "description": "King bilong Judia long taim Jisas i bon. Em i papa bilong sampela hetman olsem Herot Antipas na Herot Arkelaus."
        }
      ]
    },
    "apd": {
      "preferred_label": "هيرودس",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك اليهودية وكت ولادة يسوع. كان أبو كذا حاكم، منهم: هيرودس أنتيباس وهيرودس أرخيلاوس."
        }
      ]
    },
    "bis": {
      "preferred_label": "Herod",
      "descriptions": [
        {
          "source": "acai",
          "description": "King blong Judia long taem we Jisas i bon. Hem i papa blong sam rula we i kavremap Herod Antipas mo Herod Akelaos."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Herọd",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze Judịa nʼoge a mụrụ Jisọs. Ọ bụ nna ọtụtụ ndị ọchịchị gụnyere: Herọd Antipas na Herọd Akilaọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "हेरोद",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूको जन्मको समयमा यहूदियाका राजा। उनी हेरोद एन्टिपस र हेरोद अर्खिलाउस लगायत धेरै शासकहरूका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hê-rốt",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vua xứ Giu-đê vào thời điểm Chúa Giê-xu giáng sinh. Ông là cha của một số nhà cai trị gồm: Hê-rốt An-ti-pa và Hê-rốt A-chê-lao."
        }
      ]
    },
    "zht": {
      "preferred_label": "希律",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶穌降生時的猶太王。他是希律·安提帕和希律·亞基老等多位統治者的父親。"
        }
      ]
    }
  },
