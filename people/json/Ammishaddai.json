  "localizations": {
    "eng": {
      "preferred_label": "Ammishaddai",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ammishaddai",
          "article": "person:Ammishaddai",
          "description": "Father of Ahiezer, the chief of the tribe of Dan at the time of Israel’s wilderness wandering. "
        }
      ]
    },
    "arb": {
      "preferred_label": "عَمِّيشَدَّاي",
      "descriptions": [
        {
          "source": "acai",
          "description": "أبو أخيعزر، رئيس سبط دان في زمن تيه إسرائيل في البرية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚米沙代",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚希以谢的父亲；以色列人在旷野漂流时期，亚希以谢是但支派的首领。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Ammischaddaï",
      "descriptions": [
        {
          "source": "acai",
          "description": "Père d’Ahiézer, chef de la tribu de Dan à l’époque des pérégrinations d’Israël dans le désert."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ammishaddai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uban Ahiyezer, shugaban kabilar Dan a lokacin da Isra’ilawa suke yawo a daji."
        }
      ]
    },
    "hin": {
      "preferred_label": "अम्मीशद्दै",
      "descriptions": [
        {
          "source": "acai",
          "description": "अहीएजेर का पिता, जो इस्राएल के जंगल में भटकने के समय दान के गोत्र का प्रधान था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Amisyadai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ayah Ahiezer, pemimpin suku Dan pada masa pengembaraan Israel di padang gurun."
        }
      ]
    },
    "por": {
      "preferred_label": "Amisadai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pai de Aiezer, o líder da tribo de Dã na época da peregrinação de Israel pelo deserto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аммишаддай",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отец Ахиезера, начальника колена Дана во время странствования Израиля по пустыне."
        }
      ]
    },
    "spa": {
      "preferred_label": "Amisaday",
      "descriptions": [
        {
          "source": "acai",
          "description": "Padre de Ahiezer, jefe de la tribu de Dan durante el peregrinaje de Israel por el desierto."
        }
      ]
    },
    "swh": {
      "preferred_label": "Amishadai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Baba ya Ahiezeri, kiongozi wa kabila la Dani wakati wa Israeli kutangatanga jangwani."
        }
      ]
    },
    "apd": {
      "preferred_label": "عميشداي",
      "descriptions": [
        {
          "source": "acai",
          "description": "أبو أخيعزر، رئيس قبيلة دان في زمن تيهان بني إسرائيل في البرية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Amisadae",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa blong Ahiesa, we i lida blong laen blong Dan long taem we ol man Isrel oli stap wokbaot long despet."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Amishadai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nna Ahieza, onyeisi ebo Dan nʼoge njem Izrel nʼọzara."
        }
      ]
    },
    "nep": {
      "preferred_label": "अम्मीशद्दै",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलको उजाड-स्थानको यात्राको समयमा दान कुलका अगुवा अहिएजेरका पिता।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Amisadai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa bilong Ahieser, em hetman bilong lain Dan long taim ol Israel i bin wokabaut long ples drai nating."
        }
      ]
    },
    "vie": {
      "preferred_label": "A-mi-sa-đai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cha của A-hi-ê-xe, trưởng tộc Đan vào thời kỳ dân Y-sơ-ra-ên lưu lạc trong hoang mạc."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞米沙代",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞希以謝的父親；在以色列人曠野漂流時期，亞希以謝是但支派的首領。"
        }
      ]
    }
  },
