  "localizations": {
    "eng": {
      "preferred_label": "Memucan",
      "alternate_labels": [
        "Memukan"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Memucan",
          "article": "person:Memucan",
          "description": "An adviser to King Ahasuerus of Persia during the time of exile and return, first mentioned in Esther 1:14."
        }
      ]
    },
    "fra": {
      "preferred_label": "Memucan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Conseiller du roi Assuérus de Perse à l'époque de l'exil et du retour, mentionné pour la première fois dans Esther 1.14."
        }
      ]
    },
    "spa": {
      "preferred_label": "Memucán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Consejero del rey Asuero de Persia durante la época del exilio y el regreso, mencionado por primera vez en Ester 1:14."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَمُوكَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "مستشار للملك أحشويروش ملك فارس في زمن السبي والرجوع، ذُكر أول مرة في أستير 1: 14."
        }
      ]
    },
    "zhs": {
      "preferred_label": "米慕干",
      "descriptions": [
        {
          "source": "acai",
          "description": "流亡及回归时期波斯王亚哈随鲁的顾问，首次见于以斯帖记 1:14。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Memukan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mai ba da shawara ga Sarki Ahaswerus na Farisa a lokacin bauta da komowa, an fara ambatonsa a Istila 1:14."
        }
      ]
    },
    "hin": {
      "preferred_label": "ममूकान",
      "descriptions": [
        {
          "source": "acai",
          "description": "बंधुआई और वापसी के समय फारस के राजा क्षयर्ष का एक सलाहकार, जिसका उल्लेख पहली बार एस्तेर 1:14 में मिलता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Memukan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang penasihat Raja Ahasyweros dari Persia pada masa pembuangan dan pemulangan, pertama kali disebutkan dalam Ester 1:14."
        }
      ]
    },
    "por": {
      "preferred_label": "Memucã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um conselheiro do rei Assuero da Pérsia durante o período do exílio e retorno, mencionado pela primeira vez em Ester 1:14."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мемухан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Советник царя Персии Артаксеркса (Ахашвероша) во времена изгнания и возвращения, впервые упомянутый в Есфирь 1:14."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Memukan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong givim tingting long King Ahasuerus bilong Persia long taim bilong kalabus na go bek, ol i stori pastaim long en long Esta 1:14."
        }
      ]
    },
    "apd": {
      "preferred_label": "مموكان",
      "descriptions": [
        {
          "source": "acai",
          "description": "مستشار للملك أحشويروش ملك فارس في وكت السبي والرجوع، مذكور أول مرة في أستير 1: 14."
        }
      ]
    },
    "bis": {
      "preferred_label": "Memukan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man blong givim advaes long King Asuerus blong Pesia long taem we ol man Isrel oli stap long kalabus mo oli kambak, we Esta 1:14 i tokbaot hem fastaem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Memukan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye ndụmọdụ Eze Ahasuerus nke Peshịa n'oge a dọọrọ n'agha na nloghachi, nke e bu ụzọ kpọtụrụ aha na Esta 1:14."
        }
      ]
    },
    "nep": {
      "preferred_label": "ममूकान",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रवासन र फिर्तीको समयमा फारसका राजा अहासूरसका एक सल्लाहकार, जसको पहिलो उल्लेख एस्तर १:१४ मा गरिएको छ।"
        }
      ]
    },
    "swh": {
      "preferred_label": "Memukani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mshauri wa Mfalme Ahasuero wa Uajemi wakati wa uhamisho na kurudi, anayetajwa kwa mara ya kwanza katika Esta 1:14."
        }
      ]
    },
    "vie": {
      "preferred_label": "Mê-mu-can",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một mưu sĩ của Vua A-ha-suê-ru của Ba Tư trong thời kỳ lưu đày và hồi hương, được nhắc đến lần đầu trong Ê-xơ-tê 1:14."
        }
      ]
    },
    "zht": {
      "preferred_label": "米母干",
      "descriptions": [
        {
          "source": "acai",
          "description": "被擄及回歸時期波斯王亞哈隨魯的一位謀士，首次提及於以斯帖記1:14。"
        }
      ]
    }
  },
