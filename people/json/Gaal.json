  "localizations": {
    "eng": {
      "preferred_label": "Gaal",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Gaal",
          "article": "person:Gaal",
          "description": "A son of Ebed who lived during the time of the judges of Israel. He challenged Abimelech's claim to be king."
        }
      ]
    },
    "fra": {
      "preferred_label": "Gaal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d’Ébed ayant vécu à l’époque des juges d’Israël. Il contesta les prétentions de royauté d’Abimélec."
        }
      ]
    },
    "spa": {
      "preferred_label": "Gaal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Ebed que vivió durante la época de los jueces de Israel. Desafió la pretensión de Abimelec de ser rey."
        }
      ]
    },
    "arb": {
      "preferred_label": "جَعَل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن عابد الذي عاش في زمن قضاة إسرائيل، وتحدى دعوى أبيمالك بالملك."
        }
      ]
    },
    "zhs": {
      "preferred_label": "迦勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "以别的儿子，生活在以色列士师时代。他曾挑战亚比米勒作王的权柄。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ga’al",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Ebed wanda ya rayu a zamanin mahukuntan Isra’ila. Ya ƙalubalanci iƙirarin Abimelek na zama sarki."
        }
      ]
    },
    "hin": {
      "preferred_label": "गाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "एबेद का एक पुत्र जो इस्राएल के न्यायियों के समय में जीवित था। उसने राजा होने के अबीमेलेक के दावे को चुनौती दी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Gaal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki Ebed yang hidup pada zaman para hakim Israel. Ia menentang klaim Abimelekh sebagai raja."
        }
      ]
    },
    "por": {
      "preferred_label": "Gaal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Ebede que viveu durante a época dos juízes de Israel. Ele desafiou a pretensão de Abimeleque de ser rei."
        }
      ]
    },
    "rus": {
      "preferred_label": "Гаал",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Еведа, живший во времена израильских судей. Он оспорил притязания Авимелеха на царскую власть."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gaali",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Ebedi aliyeishi wakati wa waamuzi wa Israeli. Alipinga madai ya Abimeleki kuwa mfalme."
        }
      ]
    },
    "apd": {
      "preferred_label": "جعل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد عابد، عاش في زمن قضاة إسرائيل. وعارض ادعاء أبيمالك بالملك."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gahal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Ebed we i laef long taem blong ol jif jaj blong Isrel. Hem i agensem Abimelek we i talem se hem i king."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gaal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Ebed nke biri n'oge ndị ikpe Izrel. Ọ mara nkwupụta Abimelek na ọ bụ eze aka."
        }
      ]
    },
    "nep": {
      "preferred_label": "गाल",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलका न्यायकर्ताहरूको समयमा बाँचेका एबेदका छोरा। उनले राजा हुने अबीमेलेकको दाबीलाई चुनौती दिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gal",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Ebet husat i stap long taim bilong ol jas bilong Israel. Em i bin tok pait long tok bilong Abimelek olsem em i king."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ga-anh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Ê-bết, sống vào thời các quan xét của Y-sơ-ra-ên. Ông đã thách thức việc xưng vương của A-bi-mê-léc."
        }
      ]
    },
    "zht": {
      "preferred_label": "迦勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "以別的兒子，生活在以色列士師時代。他挑戰了亞比米勒作王的權柄。"
        }
      ]
    }
  },
