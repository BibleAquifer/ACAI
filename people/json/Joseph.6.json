  "localizations": {
    "eng": {
      "preferred_label": "Joseph",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Joseph",
          "article": "person:Joseph.6",
          "description": "A man from Arimathea who was a member of the Jewish council of the Sanhedrin. He buried Jesus."
        }
      ]
    },
    "fra": {
      "preferred_label": "Joseph",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un homme d'Arimathée qui était membre du conseil juif du sanhédrin. Il a enseveli Jésus."
        }
      ]
    },
    "spa": {
      "preferred_label": "José",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre de Arimatea que era miembro del concilio judío del Sanedrín. Sepultó a Jesús."
        }
      ]
    },
    "arb": {
      "preferred_label": "يوسُف",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل من الرامة كان عضواً في مجلس السَّنْهَدْرِيم اليهودي، وهو الذي دفن يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约瑟",
      "descriptions": [
        {
          "source": "acai",
          "description": "来自亚利马太的人，是犹太公会的成员。他安葬了耶稣。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yusuf",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutum daga Arimateya wanda yake ɗan Majalisar Sanhedrin ta Yahudawa. Shi ne ya binne Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "यूसुफ",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरिमतियाह का एक व्यक्ति जो यहूदी महासभा (सन्हेद्रिन) का सदस्य था। उसने यीशु को दफनाया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yusuf (Orang Arimatea)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang dari Arimatea yang merupakan anggota Sanhedrin (Majelis Besar) Yahudi. Ia memakamkan Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "José",
      "descriptions": [
        {
          "source": "acai",
          "description": "Homem de Arimateia que era membro do conselho judaico do Sinédrio. Ele sepultou Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иосиф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек из Аримафеи, член иудейского синедриона. Он похоронил Иисуса."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yusufu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu kutoka Arimathaya aliyekuwa mshiriki wa baraza la Kiyahudi la Sanhedrini. Alimzika Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Josep",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong Arimatea em i bin wanpela memba bilong kaunsil Sanhedrin bilong ol Juda. Em i bin planim Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "يوسف",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل من الرامة كان عضو في مجلس السنهدريم اليهودي. هو الدفن يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Josef",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man Aramatia we i wan memba blong Kaonsel blong ol Sanhedrin blong ol Ju. Hem i berem Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Josef",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nwoke si Arimatia onye so nʼotu ndịisi nzukọ Sanhedrin nke ndị Juu. O liri Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "योसेफ",
      "descriptions": [
        {
          "source": "acai",
          "description": "अरिमाथियाका एक मानिस जो यहूदी महासभा (सन्हेड्रिन) का सदस्य थिए। उनले येशूलाई गाडेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-sép",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người đến từ A-ri-ma-thê, là thành viên của Tòa Công Luận Do Thái. Ông đã an táng Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "約瑟",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位來自亞利馬太的猶太公會成員。他安葬了耶穌。"
        }
      ]
    }
  },
