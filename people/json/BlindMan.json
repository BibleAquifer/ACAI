{
  "id": "person:BlindMan",
  "primary_id": "person:BlindMan",
  "type": "person",
  "localizations": {
    "eng": {
      "preferred_label": "A Blind Man",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "A Blind Man",
          "description": "A man, blind from birth, healed by Jesus."
        }
      ]
    },
    "apd": {
      "preferred_label": "راجل أعمى",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل مولود أعمى، شفاه يسوع."
        }
      ]
    },
    "arb": {
      "preferred_label": "رجل أعمى",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل ولد أعمى، شفاه يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Wan blaenman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we ae blong hem i blaen stat taem we hem i bon, we Jisas i mekem i kam gud bakegen."
        }
      ]
    },
    "fra": {
      "preferred_label": "Un aveugle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un homme, aveugle de naissance, guéri par Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Wani Makaho",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutum makaho tun haihuwarsa, wanda Yesu ya warkar."
        }
      ]
    },
    "hin": {
      "preferred_label": "एक अंधा मनुष्य",
      "descriptions": [
        {
          "source": "acai",
          "description": "जन्म से अंधा एक मनुष्य, जिसे यीशु ने चंगा किया था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nwoke Kpuru Ìsì",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke kpuru ìsì site nʼọmụmụ, nke Jisọs gwọrọ."
        }
      ]
    },
    "ind": {
      "preferred_label": "Seorang yang buta sejak lahirnya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pria yang buta sejak lahirnya, disembuhkan oleh Yesus."
        }
      ]
    },
    "nep": {
      "preferred_label": "एक अन्धो मानिस",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशूद्वारा निको पारिएका, जन्मैदेखिका एक अन्धो मानिस।"
        }
      ]
    },
    "por": {
      "preferred_label": "Um homem cego",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem, cego de nascença, curado por Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Слепорожденный",
      "descriptions": [
        {
          "source": "acai",
          "description": "Слепорожденный человек, исцеленный Иисусом."
        }
      ]
    },
    "spa": {
      "preferred_label": "Un ciego",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre, ciego de nacimiento, sanado por Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mtu Kipofu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanaume aliyekuwa kipofu tangu kuzaliwa, aliyeponywa na Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Wanpela Man Ai Pas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man em i aipas long taim mama i karim em, na Jisas i oraitim em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người mù",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người đàn ông bị mù từ thuở mới sinh, được Chúa Giê-xu chữa lành."
        }
      ]
    },
    "zhs": {
      "preferred_label": "生来瞎眼的人",
      "descriptions": [
        {
          "source": "acai",
          "description": "一个生来瞎眼的人，被耶稣医治。"
        }
      ]
    },
    "zht": {
      "preferred_label": "生來瞎眼的人",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位生來瞎眼、被耶穌醫治的人。"
        }
      ]
    }
  },
