  "localizations": {
    "eng": {
      "preferred_label": "Maacah",
      "alternate_labels": [
        "Michaiah",
        "Maachah",
        "Micaiah",
        "Maakah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Maacah",
          "article": "person:Maacah.3",
          "description": "Daughter of King David's son Absalom, wife of King Rehoboam, and mother of King Abijam (Abijah), Attai, Ziza, and Shelomith."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَعْكَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱبْنَةُ أَبْشَالُومَ ٱبْنِ ٱلْمَلِكِ دَاوُدَ، وَزَوْجَةُ ٱلْمَلِكِ رَحُبْعَامَ، وَأُمُّ ٱلْمَلِكِ أَبِيَّا (أَبِيَّامَ) وَعَتَّايَ وَزِيزَا وَشَلُومِيثَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "玛迦",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王之子押沙龙的女儿，罗波安王的妻子，亚比央（亚比雅）、亚太、细撒和示罗密的母亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Maaca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fille d’Absalom, fils du roi David, épouse du roi Roboam et mère du roi Abijam (Abija), d’Attaï, de Ziza et de Schelomith."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ma’aka",
      "descriptions": [
        {
          "source": "acai",
          "description": "’Yar Absalom ɗan Sarki Dawuda, matar Sarki Rehobowam, kuma mahaifiyar Sarki Abiya, Attai, Ziza, da Shelomit."
        }
      ]
    },
    "hin": {
      "preferred_label": "माका",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊद के पुत्र अबशालोम की बेटी, राजा रहबाम की पत्नी, और राजा अबिय्याह (अबियाम), अत्तै, जीजा और शलोमीत की माता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Maakha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak perempuan Absalom anak Raja Daud, istri Raja Rehabeam, dan ibu dari Raja Abia (Abiyam), Atai, Ziza, dan Selomit."
        }
      ]
    },
    "por": {
      "preferred_label": "Maaca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filha de Absalão, filho do rei Davi, esposa do rei Roboão e mãe do rei Abias (Abijão), de Atai, de Ziza e de Selomite."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мааха",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дочь Авессалома, сына царя Давида, жена царя Ровоама и мать царя Авии (Авияма), Аттая, Зизы и Шеломифа."
        }
      ]
    },
    "spa": {
      "preferred_label": "Macá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hija de Absalón, hijo del rey David, esposa del rey Roboam y madre del rey Abías, Atai, Ziza y Selomit."
        }
      ]
    },
    "swh": {
      "preferred_label": "Maaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Binti wa mwana wa Mfalme Daudi, Absalomu, mke wa Mfalme Rehoboamu, na mama wa Mfalme Abiya, Atai, Ziza, na Shelomithi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Maka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini meri bilong Apsalom, pikinini man bilong King Devit, marit bilong King Rehoboam, na mama bilong King Abiya, Atai, Sisa, na Selomit."
        }
      ]
    },
    "apd": {
      "preferred_label": "معكة",
      "descriptions": [
        {
          "source": "acai",
          "description": "بت أبشالوم ولد الملك داود، وزوجة الملك رحبعام، وأم الملك أبيام (أبيا)، وعتاي، وزيزا، وشلوميث."
        }
      ]
    },
    "bis": {
      "preferred_label": "Mahaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dota blong pikinini boe blong King Deved ya Absalom, waef blong King Rehoboam, mo mama blong King Abiam (Abia), Atae, Sisaha, mo Selomit."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Maaka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwanyị nke Absalọm nwa Eze Devid, nwunye Eze Rehoboam, na nne Eze Abaijam (Abija), Atai, Ziza, na Shelomit."
        }
      ]
    },
    "nep": {
      "preferred_label": "माका",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊदका छोरा अब्शालोमकी छोरी, राजा रहबामकी पत्नी, र राजा अबियाम (अबिया), अत्तै, जीजा र शलोमीतकी आमा।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-a-ca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con gái của Áp-sa-lôm (con trai vua Đa-vít), vợ của vua Rô-bô-am, và là mẹ của vua A-bi-gia (A-bi-giam), Ạt-tai, Xi-xa, và Sê-lô-mít."
        }
      ]
    },
    "zht": {
      "preferred_label": "瑪迦",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王之子押沙龍的女兒，羅波安王的妻子，是亞比央（亞比雅）王、亞太、細撒和示羅密的母親。"
        }
      ]
    }
  },
