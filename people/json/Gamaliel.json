        }
      ]
    },
    "hin": {
      "preferred_label": "गमलीएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "गमलीएल, नए नियम के काल में यरूशलेम का एक प्रसिद्ध फरीसी था, जिसका पहला उल्लेख प्रेरितों के काम 5:34 में मिलता है।"
        }
      ]
    },
