        }
      ]
    },
    "rus": {
      "preferred_label": "Гамалиил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Гамалиил, известный фарисей в Иерусалиме в период Нового Завета, впервые упомянут в Деяниях 5:34."
        }
      ]
    },
    "swh": {
      "preferred_label": "Gamalieli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gamalieli, Farisayo maarufu huko Yerusalemu wakati wa kipindi cha Agano Jipya, anatajwa kwa mara ya kwanza katika Matendo ya Mitume 5:34."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Gamaliel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gamaliel, wanpela Farisi i gat biknem long Jerusalem long taim bilong Nupela Testamen, Baibel i kolim nem bilong en pastaim long Aposel 5:34."
        }
      ]
    },
    "apd": {
      "preferred_label": "غمالائيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "غمالائيل، فريسي مشهور في أورشليم في زمن العهد الجديد، ومذكور أول مرة في أعمال الرسل 5: 34."
        }
      ]
    },
    "bis": {
      "preferred_label": "Gamaliel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gamaliel, wan nambawan Farisi long Jerusalem long taem blong Niu Testeman, we Ol Wok 5:34 i fas tokbaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Gamaliel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gamaliel, onye Farisii ama ama na Jeruselem n'oge Agba Ọhụrụ, ka a kpọtụrụ aha na mbụ n'ime Ọrụ Ndị Ozi 5:34."
        }
      ]
    },
    "nep": {
      "preferred_label": "गमलिएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "गमलिएल, नयाँ नियमको अवधिमा यरूशलेमका एक प्रसिद्ध फरिसी थिए, जसको पहिलो पटक उल्लेख प्रेरित ५:३४ मा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ga-ma-li-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ga-ma-li-ên, một người Pha-ri-si nổi tiếng tại Giê-ru-sa-lem trong thời kỳ Tân Ước, được nhắc đến lần đầu trong Công Vụ 5:34."
        }
      ]
    },
    "zht": {
      "preferred_label": "迦瑪列",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦瑪列是新約時期耶路撒冷著名的法利賽人，首次記載於使徒行傳5:34。"
        }
      ]
    }
