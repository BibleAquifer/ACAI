  "localizations": {
    "eng": {
      "preferred_label": "Rahab",
      "alternate_labels": [
        "Rachab"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rahab",
          "article": "person:Rahab",
          "description": "A prostitute from Jericho during the time of the conquest of Canaan who helped Israelite spies. She was the mother of Boaz and ancestor of King David. She is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "رَاحَاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "امرأة زانية من أريحا في زمن غزو كنعان، ساعدت الجاسوسين الإسرائيليين. كانت أمّ بوعز وأحد أجداد الملك داود. وهي مذكورة في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "喇合",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦南征服时期耶利哥城的一名妓女，曾帮助过以色列的探子。她是波阿斯的母亲，大卫王的先祖，名列耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Rahab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prostituée de Jéricho à l'époque de la conquête de Canaan, qui a aidé les espions israélites. Elle était la mère de Boaz et l'ancêtre du roi David. Elle figure dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rahab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata karuwa daga Yeriko a zamanin da aka ci ƙasar Kan’ana wadda ta taimaki ’yan leƙen asirin Isra’ila. Ita ce mahaifiyar Bowaz kuma kakar Sarki Dawuda. An lissafa ta a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "राहाब",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनान की विजय के समय यरीहो की एक वेश्या जिसने इस्राएली भेदियों की सहायता की थी। वह बोअज की माता और राजा दाऊद की पूर्वज थी। उसे यीशु की वंशावली में गिना गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Rahab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang perempuan sundal dari Yerikho pada masa penaklukan Kanaan yang menolong para pengintai Israel. Ia adalah ibu dari Boas dan leluhur Raja Daud. Ia tercatat dalam silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Raabe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma prostituta de Jericó durante a época da conquista de Canaã que ajudou os espiões israelitas. Ela foi a mãe de Boaz e ancestral do rei Davi. Ela é mencionada na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Раав",
      "descriptions": [
        {
          "source": "acai",
          "description": "Блудница из Иерихона времен завоевания Ханаана, которая помогла израильским соглядатаям. Она была матерью Вооза и предком царя Давида. Она включена в родословие Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Rahab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Una prostituta de Jericó durante la época de la conquista de Canaán que ayudó a los espías israelitas. Fue la madre de Booz y antepasada del rey David. Está incluida en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Rahabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kahaba kutoka Yeriko wakati wa ushindi wa Kanaani aliyewasaidia wapelelezi Waisraeli. Alikuwa mama yake Boazi na babu wa Mfalme Daudi. Ametajwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Rahap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pamukmeri bilong Jeriko long taim ol Israel i pait bilong kisim Kenan, em i bin helpim ol man bilong lukstil bilong Israel. Em i mama bilong Boas na tumbuna meri bilong King Devit. Nem bilong em i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "راحاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحدة زانية من أريحا في زمن فتح كنعان ساعدت الجواسيس الإسرائيليين. هي كانت أم بوعز وجدة الملك داود. ومذكورة في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rehab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan woman blong rod blong Jeriko long taem we ol man Isrel oli tekem kantri Kenan, we i bin givhan long tufala spae blong Isrel. Hem i mama blong Boas mo wan tumbuna blong King Deved. Nem blong hem i stap long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Rehab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwanyị akwụna sitere na Jeriko nʼoge a na-emeri Kenan, onye nyeere ndị nledo Izrel aka. Ọ bụ nne Boaz na nna nna Eze Devid. E depụtara ya nʼagbụrụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "राहाब",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनान विजयको समयमा इस्राएली जासुसहरूलाई सहायता गर्ने यरीहोकी एक वेश्‍या। उनी बोअजकी आमा र राजा दाऊदकी पुर्खा थिइन्। उनको नाम येशूको वंशावलीमा सूचीकृत छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ra-háp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một kỹ nữ ở Giê-ri-cô vào thời kỳ chinh phục xứ Ca-na-an, người đã giúp đỡ các thám tử Y-sơ-ra-ên. Bà là mẹ của Bô-ô và là tổ mẫu của Vua Đa-vít. Bà được ghi trong gia phả của Chúa Cứu Thế Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "喇合",
      "descriptions": [
        {
          "source": "acai",
          "description": "征服迦南時期耶利哥的妓女，曾幫助以色列探子。她是波阿斯的母親和大衛王的祖先，被列在耶穌的家譜中。"
        }
      ]
    }
  },
