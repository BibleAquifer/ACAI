  "localizations": {
    "eng": {
      "preferred_label": "Shedeur",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shedeur",
          "article": "person:Shedeur",
          "description": "Chief of the tribe of Reubenite and father of Elizur who lived during the wilderness wandering of Israel."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَدَيْئُور",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيس من سبط رَأُوبَيْن ووالد أَلِيصُور، عاش أثناء تيه بني إسرائيل في البرية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "示丢珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "流便支派的首领，以利苏的父亲，生活在以色列人旷野流浪时期。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Schedéur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chef de la tribu de Ruben et père d’Élitsur, qui vécut pendant l’errance d’Israël dans le désert."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shedeyur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shugaban kabilar Ruben kuma mahaifin Elizur wanda ya rayu a lokacin da Isra’ilawa suke yawo a hamada."
        }
      ]
    },
    "hin": {
      "preferred_label": "शदेऊर",
      "descriptions": [
        {
          "source": "acai",
          "description": "रूबेन के गोत्र का प्रधान और एलीसूर का पिता, जो इस्राएल के जंगल में भटकने के समय जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Syedeur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pemimpin suku Ruben dan ayah dari Elizur yang hidup selama pengembaraan Israel di padang gurun."
        }
      ]
    },
    "por": {
      "preferred_label": "Sedeur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Líder da tribo de Rúben e pai de Elizur, que viveu durante a peregrinação de Israel pelo deserto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Шедеур",
      "descriptions": [
        {
          "source": "acai",
          "description": "Вождь колена Рувима и отец Елицура, живший во время странствования Израиля по пустыне."
        }
      ]
    },
    "spa": {
      "preferred_label": "Sedeur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Líder de la tribu de Rubén y padre de Elisur, que vivió durante la travesía de Israel por el desierto."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shedeuri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kiongozi wa kabila la Wareubeni na baba yake Elisuri aliyeishi wakati wa Waisraeli kutangatanga jangwani."
        }
      ]
    },
    "apd": {
      "preferred_label": "شديئور",
      "descriptions": [
        {
          "source": "acai",
          "description": "زعيم من قبيلة رأوبين وأبو أليصور، عاش في زمن تجوال بني إسرائيل في البرية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sedeuru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jif blong laen blong Ruben mo papa blong Elijuru we i laef long taem we ol man Isrel oli stap wokbaot long waelwis."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shedeua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye isi ebo Ruben na nna Elizọ onye dịrị ndụ nʼoge njem ndị Izrel nʼime ọzara."
        }
      ]
    },
    "nep": {
      "preferred_label": "शदेऊर",
      "descriptions": [
        {
          "source": "acai",
          "description": "रूबेन कुलका अगुवा र एलीसूरका पिता, जो इस्राएलको उजाड-स्थानको यात्राको समयमा बाँचेका थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sedeur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hetman bilong lain Ruben na papa bilong Elisur, em i bin stap long taim ol Israel i bin raun long ples drai nating."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-đêu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tộc trưởng thuộc bộ tộc Ru-bên và là cha của Ê-li-sua, sống trong thời kỳ dân Y-sơ-ra-ên lưu lạc trong hoang mạc."
        }
      ]
    },
    "zht": {
      "preferred_label": "示丟珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "呂便支派的首領，以利蓿之父，生活在以色列人曠野飄流時期。"
        }
      ]
    }
  },
