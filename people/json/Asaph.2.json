  "localizations": {
    "eng": {
      "preferred_label": "Asaph (Son of Berechiah)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Asaph (Son of Berechiah)",
          "article": "person:Asaph.2",
          "description": "A Levite choir leader and musician of liturgical worship during the reign of King David. A number of psalms are attributed to him."
        }
      ]
    },
    "fra": {
      "preferred_label": "Asaph (fils de Bérékia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chef de chœur lévite et musicien du culte liturgique sous le règne du roi David. Plusieurs psaumes lui sont attribués."
        }
      ]
    },
    "spa": {
      "preferred_label": "Asaf (hijo de Berequías)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Levita director de coro y músico de adoración litúrgica durante el reinado del rey David. Se le atribuyen varios salmos."
        }
      ]
    },
    "arb": {
      "preferred_label": "آسَاف (ابن بَرَخْيَا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوي وقائد جوقة وموسيقي للعبادة الطقسية في عهد الملك داود. يُنسب إليه عدد من المزامير."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚萨 (比利迦的儿子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王时期利未人的诗班长和礼拜音乐家。有许多诗篇被归在他名下。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Asaf (Ɗan Berekiya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shugaban mawaƙa na Ba-lawiye kuma makaɗin bauta a lokacin mulkin Sarki Dawuda. An jingina zabura da yawa a gare shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "आसाप (बेरेक्याह का पुत्र)",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊद के शासनकाल के दौरान आराधना का एक लेवीय गायक दल का मुखिया और संगीतकार। कई भजन उनसे संबद्ध किए गए हैं।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Asaf (anak Berekhya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pemimpin paduan suara dan pemusik Lewi dalam ibadah liturgis pada masa pemerintahan Raja Daud. Sejumlah mazmur dinisbatkan kepadanya."
        }
      ]
    },
    "por": {
      "preferred_label": "Asafe (filho de Berequias)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um líder de coral levita e músico de adoração litúrgica durante o reinado do rei Davi. Vários salmos são atribuídos a ele."
        }
      ]
    },
    "rus": {
      "preferred_label": "Асаф (сын Верехии)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левит, руководитель хора и музыкант богослужебного поклонения во время правления царя Давида. Ему приписывается ряд псалмов."
        }
      ]
    },
    "swh": {
      "preferred_label": "Asafu (Mwana wa Berekia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kiongozi wa kwaya na mwanamuziki Mlawi wa ibada ya kiliturujia wakati wa utawala wa Mfalme Daudi. Zaburi kadhaa zinahusishwa naye."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Asap (Pikinini bilong Berekia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela Livai lida bilong lain kwaya na man bilong musik long taim bilong lotu long taim King Devit i stap king. Sampela sam i gat nem bilong em long ol."
        }
      ]
    },
    "apd": {
      "preferred_label": "آساف (ولد برخيا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوي ورئيس كورس ومغني عبادة ليتورجية في زمن الملك داود. اتنسبت ليهو عدد من المزامير."
        }
      ]
    },
    "bis": {
      "preferred_label": "Asaf (boe blong Berekia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan Livaet we i lida blong kwaea mo man blong plei miusik long wosip long taem we King Deved i stap rul. Oli talem se sam sam long Buk blong Ol Sam oli kam long hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Asaf (nwa Berekaya)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye Livayị bụ onye ndú ukwe na onye na-agụ egwú ofufe nʼoge ọchịchị Eze Devid. A sịrị na ọ bụ ya dere ọtụtụ nʼime abụ ọma dị iche iche."
        }
      ]
    },
    "nep": {
      "preferred_label": "आसाप (बेरेक्याहका छोरा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊदको शासनकालमा आराधना सेवाका एक लेवी भजनमण्डलीका अगुवा तथा सङ्गीतकार। थुप्रै भजनहरू उहाँसँग सम्बन्धित छन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-sáp (con của Bê-rê-kia)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người Lê-vi phụ trách ca đoàn và là nhạc công trong sự thờ phượng phụng vụ dưới triều Vua Đa-vít. Nhiều thiên thi được quy cho ông."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞薩 (比利家的兒子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王統治時期的一位利未人詩班長及禮拜音樂家。有許多篇詩篇歸於他的名下。"
        }
      ]
    }
  },
