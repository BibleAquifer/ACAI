        }
      ]
    },
    "arb": {
      "preferred_label": "يَهُوشَعُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "رَئِيسُ كَهَنَةٍ عَاشَ فِي أَثْنَاءِ سَبْيِ بَنِي إِسْرَائِيلَ وَرُجُوعِهِمْ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约书亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在以色列人被掳与归回时期的大祭司。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Josué",
      "descriptions": [
        {
          "source": "acai",
          "description": "Souverain sacrificateur ayant vécu pendant l'exil et le retour d'Israël."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yoshuwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban firist da ya rayu a lokacin bautar Isra’ilawa da dawowarsu."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहोशू",
      "descriptions": [
        {
          "source": "acai",
          "description": "महायाजक जो इस्राएलियों के बंधुआई और वापसी के समय जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yosua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Imam besar yang hidup pada masa pembuangan dan pemulangan bangsa Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Josué",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sumo sacerdote que viveu durante o exílio e o retorno dos israelitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иисус",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первосвященник, живший во время вавилонского пленения и возвращения израильтян."
        }
      ]
    },
    "spa": {
      "preferred_label": "Josué",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sumo sacerdote que vivió durante el exilio y el regreso de los israelitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yoshua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhani mkuu aliyeishi wakati wa uhamisho na kurudi kwa Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Josua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hetpris i bin stap long taim ol Israel i stap long kalabus na i kam bek."
        }
      ]
    },
    "apd": {
      "preferred_label": "يشوع",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيس كهنة عاش في زمن سبي بني إسرائيل والرجوع منه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Josua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hae pris we i bin laef long taem we ol man Isrel oli stap long kalabus mo taem oli kambak."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Joshua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyeisi nchụaja nke biri nʼoge nchụpụ na nloghachi nke ndị Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "यहोशू",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलीहरूको निर्वासन र फिर्तीको समयमा रहेका प्रधान पूजाहारी।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-sua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thầy tế lễ thượng phẩm sống vào thời dân Y-sơ-ra-ên bị lưu đày và hồi hương."
        }
      ]
    },
    "zht": {
      "preferred_label": "約書亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在以色列人被擄及歸回時期的大祭司。"
        }
      ]
    }
  },
