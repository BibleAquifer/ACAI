  "localizations": {
    "eng": {
      "preferred_label": "Elkanah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Elkanah",
          "article": "person:Elkanah.2",
          "description": "Son of Jeroham, husband to Hannah, and father of Samuel the prophet and judge."
        }
      ]
    },
    "fra": {
      "preferred_label": "Elkana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Jeroham, mari d’Anne et père du prophète et juge Samuel."
        }
      ]
    },
    "spa": {
      "preferred_label": "Elcaná",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Jeroham, esposo de Ana y padre del profeta y juez Samuel."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَلْقَانَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن يروحام، وزوج حَنَّة، ووالد صموئيل النبي والقاضي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以利加拿",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶罗罕的儿子，哈拿的丈夫，先知兼士师撒母耳的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Elkana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Yeroham, mijin Hannatu, kuma mahaifin Sama’ila annabi kuma mahukunci."
        }
      ]
    },
    "hin": {
      "preferred_label": "एल्काना",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरोहाम का पुत्र, हन्ना का पति, तथा भविष्यद्वक्ता और न्यायी शमूएल का पिता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Elkana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Yeroham, suami Hana, dan ayah dari nabi sekaligus hakim Samuel."
        }
      ]
    },
    "por": {
      "preferred_label": "Elcana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Jeroão, marido de Ana e pai do profeta e juiz Samuel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Елкана",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Иерохама, муж Анны и отец пророка и судьи Самуила."
        }
      ]
    },
    "swh": {
      "preferred_label": "Elikana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Yerohamu, mume wa Hana, na baba ya Samweli nabii na mwamuzi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Elkana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Jeroham, man bilong Hana, na papa bilong Samuel em profet na hetman."
        }
      ]
    },
    "apd": {
      "preferred_label": "ألقانة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ود يروحام، وراجل حنة، وأبو صموئيل النبي والقاضي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Elkana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Jeroham, hasban blong Hana, mo papa blong Samuel we i profet mo jaj."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Elkena",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Jeroham, di Hana, na nna Samuel bụ onye amụma na onye ikpe."
        }
      ]
    },
    "nep": {
      "preferred_label": "एल्‍काना",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरोहामका छोरा, हन्‍नाहका पति, र अगमवक्ता एवं न्यायकर्ता शमूएलका पिता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ên-ca-na",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Giê-rô-ham, chồng của An-ne, và là cha của nhà tiên tri kiêm quan xét Sa-mu-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "以利加拿",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶羅罕的兒子，哈拿的丈夫，先知兼士師撒母耳的父親。"
        }
      ]
    }
  },
