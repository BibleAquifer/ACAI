  "localizations": {
    "eng": {
      "preferred_label": "Zadok",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Zadok",
          "article": "person:Zadok.2",
          "description": "A son of Ahitub and father of Ahimaaz, he was the high priest who anointed Solomon as king."
        }
      ]
    },
    "arb": {
      "preferred_label": "صادوق",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن أَخِيطوب وأبو أَخِيمَعَص، وكان رئيس الكهنة الذي مسح سليمان ملكاً."
        }
      ]
    },
    "zhs": {
      "preferred_label": "撒督",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚希突的儿子，亚希玛斯的父亲，他是膏立所罗门为王的大祭司。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Tsadok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d'Achithub et père d'Achimaats, il était le grand prêtre qui oignit Salomon comme roi."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zadok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Ahitub kuma mahaifin Ahimawaz, shi ne babban firist ɗin da ya shafe Solomon a matsayin sarki."
        }
      ]
    },
    "hin": {
      "preferred_label": "सादोक",
      "descriptions": [
        {
          "source": "acai",
          "description": "अहीतूब का पुत्र और अहीमास का पिता, वह महायाजक था जिसने सुलैमान का राजा के रूप में अभिषेक किया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Zadok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak laki-laki dari Ahitub dan ayah dari Ahimaas, ia adalah imam besar yang mengurapi Salomo sebagai raja."
        }
      ]
    },
    "por": {
      "preferred_label": "Zadoque",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Aitube e pai de Aimaás, ele foi o sumo sacerdote que ungiu Salomão como rei."
        }
      ]
    },
    "rus": {
      "preferred_label": "Садок",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Ахитува и отец Ахимааса, первосвященник, помазавший Соломона на царство."
        }
      ]
    },
    "spa": {
      "preferred_label": "Sadoc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Ahitud y padre de Ahimaas, fue el sumo sacerdote que ungió a Salomón como rey."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sadoki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Ahitubu na baba yake Ahimaasi, alikuwa kuhani mkuu aliyemtia mafuta Solomoni kuwa mfalme."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sadok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Em i pikinini man bilong Ahitup na papa bilong Ahimas, em i nambawan pris em i bin kapsaitim wel long Solomon bilong makim em i kamap king."
        }
      ]
    },
    "apd": {
      "preferred_label": "صادوق",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد أخيطوب وأبو أخيمعص، وكان هو رئيس الكهنة المسح سليمان ملك."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jadok",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hem i wan boe blong Ahitub mo papa blong Ahimaas, hem i hae pris we i anointem Solomon blong i kam king."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Zadọk",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Ahitub na nna Ahimaaz, ọ bụ nnukwu onye nchụaja nke tere Solomọn mmanụ ịbụ eze."
        }
      ]
    },
    "nep": {
      "preferred_label": "सादोक",
      "descriptions": [
        {
          "source": "acai",
          "description": "अहीतूबका छोरा र अहीमासका पिता, उनी महापुजारी थिए जसले सोलोमनलाई राजाको रूपमा अभिषेक गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Xa-đốc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của A-hi-túp và là cha của A-hi-ma-ách, ông là thầy tế lễ thượng phẩm đã xức dầu phong Sa-lô-môn làm vua."
        }
      ]
    },
    "zht": {
      "preferred_label": "撒督",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞希突的兒子、亞希瑪斯的父親，曾膏立所羅門為王的大祭司。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
