  "localizations": {
    "eng": {
      "preferred_label": "Tertullus",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Tertullus",
          "article": "person:Tertullus",
          "description": "Tertullus was a lawyer in the New Testament who accused Paul before Felix, first mentioned in Acts 24:1."
        }
      ]
    },
    "fra": {
      "preferred_label": "Tertulle",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tertulle était un juriste du Nouveau Testament qui a accusé Paul devant Félix, mentionné pour la première fois dans Actes 24:1."
        }
      ]
    },
    "spa": {
      "preferred_label": "Tértulo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tértulo fue un abogado en el Nuevo Testamento que acusó a Pablo ante Félix, mencionado por primera vez en Hechos 24:1."
        }
      ]
    },
    "arb": {
      "preferred_label": "تَرْتُلُّس",
      "descriptions": [
        {
          "source": "acai",
          "description": "تَرْتُلُّس كان خطيبًا (محاميًا) في العهد الجديد اتهم بولس أمام فيلكس، ومذكور لأول مرة في أعمال الرسل 24: 1."
        }
      ]
    },
    "zhs": {
      "preferred_label": "帖土罗",
      "descriptions": [
        {
          "source": "acai",
          "description": "帖土罗是新约时代的一名律师，曾在腓力斯面前控告保罗，首次见于使徒行传24:1。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Tertullus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tertullus wani lauya ne a Sabon Alkawari wanda ya yi ƙarar Bulus a gaban Felis, wanda aka fara ambata a Ayyukan Manzanni 24:1."
        }
      ]
    },
    "hin": {
      "preferred_label": "तिरतुल्लुस",
      "descriptions": [
        {
          "source": "acai",
          "description": "तिरतुल्लुस नए नियम में एक वकील था जिसने फेलिक्स के सामने पौलुस पर दोष लगाया था, जिसका पहला उल्लेख प्रेरितों के काम 24:1 में है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Tertulus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tertulus adalah seorang pengacara dalam Perjanjian Baru yang mendakwa Paulus di hadapan Feliks, pertama kali disebutkan dalam Kisah Para Rasul 24:1."
        }
      ]
    },
    "por": {
      "preferred_label": "Tértulo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tértulo foi um advogado no Novo Testamento que acusou Paulo perante Félix, mencionado pela primeira vez em Atos 24:1."
        }
      ]
    },
    "rus": {
      "preferred_label": "Тертулл",
      "descriptions": [
        {
          "source": "acai",
          "description": "Тертулл — ритор (законник) в Новом Завете, обвинявший Павла перед Феликсом, впервые упомянутый в Деяниях 24:1."
        }
      ]
    },
    "swh": {
      "preferred_label": "Tertulo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tertulo alikuwa mwanasheria katika Agano Jipya aliyemshtaki Paulo mbele ya Feliki, anayetajwa kwa mara ya kwanza katika Matendo ya Mitume 24:1."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Tertulus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tertulus em i wanpela saveman bilong lo long Nupela Testamen em i bin sutim tok long Pol long ai bilong Feliks, na Buk Aposel 24:1 i stori pastaim long em."
        }
      ]
    },
    "apd": {
      "preferred_label": "ترتلس",
      "descriptions": [
        {
          "source": "acai",
          "description": "ترتلس كان محامي في العهد الجديد اشتكى على بولس قدام فيلكس، ومذكور أول مرة في أعمال الرسل 24: 1."
        }
      ]
    },
    "bis": {
      "preferred_label": "Tetalas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tetalas hem i wan loea long Niutesteman we i putum poen agens long Pol long fes blong Filiks, we Buk blong Ol Wok 24:1 i fas tokbaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Tatulọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tatulọs bụ otu onye ọka iwu n'Agba Ọhụrụ nke boro Pọl ebubo n'ihu Feliks, nke e bu ụzọ kpọtụrụ aha n'Ọrụ Ndị Ozi 24:1."
        }
      ]
    },
    "nep": {
      "preferred_label": "तर्तुलस",
      "descriptions": [
        {
          "source": "acai",
          "description": "तर्तुलस नयाँ नियमका एक वकिल थिए जसले फेलिक्सको सामु पावलमाथि दोष लगाए, जसको पहिलो उल्लेख प्रेरित २४:१ मा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Tẹt-tu-lu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tẹt-tu-lu là một luật sư trong Tân Ước, người đã tố cáo Phao-lô trước mặt Phi-lít, được nhắc đến lần đầu trong Công Vụ 24:1."
        }
      ]
    },
    "zht": {
      "preferred_label": "帖土羅",
      "descriptions": [
        {
          "source": "acai",
          "description": "帖土羅是新約時期的一位辯士（律師），在腓力斯面前控告保羅，首次記載於使徒行傳24:1。"
        }
      ]
    }
  },
