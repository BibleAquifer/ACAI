  "localizations": {
    "eng": {
      "preferred_label": "Shebuel",
      "alternate_labels": [
        "Shubael"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shebuel",
          "article": "person:Shebuel",
          "description": "Moses' grandson, son of Gershom, and the father of Jehdeiah. He is called chief of the Gershomites."
        }
      ]
    },
    "arb": {
      "preferred_label": "شَبُوئِيلُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "حَفِيدُ مُوسَى، وَٱبْنُ جَرْشُومَ، وَأَبُو يَحَدْيَا. يُدْعَى رَأْسَ ٱلْجَرْشُومِيِّينَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "细布业",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩西的孙子、革舜的儿子、耶希底亚的父亲。他被称为革舜后裔的首领。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Schebuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit-fils de Moïse, fils de Guershom et père de Jechdia. Il est appelé chef des descendants de Guershom."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shebuwel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jikan Musa, ɗan Gershom, kuma mahaifin Yedehiya. Ana kiransa shugaban zuriyar Gershom."
        }
      ]
    },
    "hin": {
      "preferred_label": "शबूएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "मूसा का पोता, गेर्शोम का पुत्र और येहदयाह का पिता। उसे गेर्शोमियों का मुख्य कहा गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Sebuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cucu Musa, putra Gersom, dan ayah Yehdeya. Ia disebut kepala keturunan Gersom."
        }
      ]
    },
    "por": {
      "preferred_label": "Sebuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neto de Moisés, filho de Gérson e pai de Jedias. Ele é chamado de chefe dos gersonitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Шевуил",
      "descriptions": [
        {
          "source": "acai",
          "description": "Внук Моисея, сын Гирсона и отец Иехдии. Он назван главным среди потомков Гирсона."
        }
      ]
    },
    "spa": {
      "preferred_label": "Sebuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nieto de Moisés, hijo de Gersón y padre de Jedías. Es llamado jefe de los gersonitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shebueli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mjukuu wa Musa, mwana wa Gershomu, na babaye Yedeya. Anaitwa mkuu wa Wagershomu."
        }
      ]
    },
    "apd": {
      "preferred_label": "شبواييل",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد موسى، ولد جرشوم، وأبو يحديا. كان بيتسمى رئيس الجرشونيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sebuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Siposon blong Moses, pikinini boe blong Gesom, mo papa blong Jedea. Baebol i kolem hem se lida blong ol laen blong Gesom."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shubuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa Mosis, nwa Geshọm, na nna Jehdeia. A na-akpọ ya onyeisi ụmụ Geshọm."
        }
      ]
    },
    "nep": {
      "preferred_label": "शूबाएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "मोशाका नाति, गेर्शोमका छोरा र यहदयाहका पिता। तिनलाई गेर्शोमवंशीहरूका मुख्य मानिस भनिएको छ।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sebuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuna pikinini bilong Moses, pikinini man bilong Gersom, na papa bilong Jedea. Ol i kolim em hetman bilong lain Gersom."
        }
      ]
    },
    "vie": {
      "preferred_label": "Sê-bu-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cháu nội của Môi-se, con trai của Ghẹt-sôn, và là cha của Giê-đia. Ông được gọi là trưởng tộc của dòng dõi Ghẹt-sôn."
        }
      ]
    },
    "zht": {
      "preferred_label": "細布業",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩西的孫子，革舜的兒子，耶希底亞的父親。他被稱為革舜人的領袖。"
        }
      ]
    }
  },
