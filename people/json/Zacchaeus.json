        }
      ]
    },
    "hau": {
      "preferred_label": "Zakka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban mai karɓar haraji na Yariko wanda ya zama mabiyin Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "जक्कई",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरीहो का प्रधान कर संग्रहकर्ता जो यीशु का अनुयायी बन गया।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Zakheus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kepala pemungut cukai di Yerikho yang menjadi pengikut Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Zaqueu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chefe dos cobradores de impostos de Jericó que se tornou seguidor de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Закхей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Начальник мытарей в Иерихоне, ставший последователем Иисуса."
        }
      ]
    },
    "swh": {
      "preferred_label": "Zakayo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkuu wa watoza ushuru wa Yeriko aliyekuwa mfuasi wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sakius",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hetman bilong ol man bilong kisim takis long Jeriko em i bin kamap disaipel bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "زكا",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيس جباة الضرائب في أريحا البقى من أتباع يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sakias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jif blong ol man blong tekem mane blong takis long Jeriko we i kam wan man blong biaen long Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Zakịọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyeisi ndị ọna ụtụ nke Jeriko onye ghọrọ onye na-eso ụzọ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "जखायस",
      "descriptions": [
        {
          "source": "acai",
          "description": "यरीहोका मुख्य कर उठाउने, जो पछि येशूका चेला बने।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Xa-chê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Trưởng quan thu thuế tại Giê-ri-cô, người đã trở thành môn đồ của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "撒該",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶利哥的稅吏長，後來成為耶穌的跟隨者。"
        }
      ]
    }
