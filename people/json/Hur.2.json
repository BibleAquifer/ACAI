  "localizations": {
    "eng": {
      "preferred_label": "Hur",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hur",
          "article": "person:Hur.2",
          "description": "An assistant of Moses from the tribe of Judah. He was father of Uri and grandfather of Bezalel."
        }
      ]
    },
    "fra": {
      "preferred_label": "Hur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Assistant de Moïse issu de la tribu de Juda. Il était le père d'Uri et le grand-père de Betsaleel."
        }
      ]
    },
    "spa": {
      "preferred_label": "Hur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ayudante de Moisés de la tribu de Judá. Fue padre de Uri y abuelo de Bezalel."
        }
      ]
    },
    "arb": {
      "preferred_label": "حُور",
      "descriptions": [
        {
          "source": "acai",
          "description": "مُساعِدٌ لِمُوسَى مِنْ سِبْطِ يَهُوذَا، وَهُوَ أَبُو أُورِي وَجَدُّ بَصَلْئِيلَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "户珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩西的助手，出自犹大支派。他是乌利的父亲，比撒列的祖父。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mataimakin Musa daga kabilar Yahuda. Shi ne mahaifin Uri kuma kakan Bezalel."
        }
      ]
    },
    "hin": {
      "preferred_label": "हूर",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा के गोत्र से मूसा का एक सहायक। वह ऊरी का पिता और बसलेल का दादा था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pembantu Musa dari suku Yehuda. Ia adalah ayah dari Uri dan kakek dari Bezaleel."
        }
      ]
    },
    "por": {
      "preferred_label": "Hur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um auxiliar de Moisés da tribo de Judá. Ele era pai de Uri e avô de Bezalel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ор",
      "descriptions": [
        {
          "source": "acai",
          "description": "Помощник Моисея из колена Иудина. Он был отцом Урия и дедом Веселиила."
        }
      ]
    },
    "swh": {
      "preferred_label": "Huri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Msaidizi wa Musa kutoka kabila la Yuda. Alikuwa baba yake Uri na babu yake Bezaleli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Hur",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela helpim bilong Moses long lain bilong Juda. Em i papa bilong Uri na tumbuna papa bilong Besalel."
        }
      ]
    },
    "apd": {
      "preferred_label": "حور",
      "descriptions": [
        {
          "source": "acai",
          "description": "مساعد لموسى من سبط يهوذا. وهو أبو أوري وجد بصلئيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Huru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man blong givhan long Moses we i blong laen blong Juta. Hem i papa blong Uri mo bubu blong Besalel."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Hua",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye inyeaka Mosis nke si nʼebo Juda. Ọ bụ nna Uri na nna nna Bezalel."
        }
      ]
    },
    "nep": {
      "preferred_label": "हूर",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा कुलका मोशाका एक सहयोगी। तिनी ऊरीका पिता र बजलेलका हजुरबुबा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hu-rơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người phụ tá của Môi-se thuộc chi phái Giu-đa. Ông là cha của U-ri và là ông nội của Bết-sa-lê-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "戶珥",
      "descriptions": [
        {
          "source": "acai",
          "description": "摩西的助手，出自猶大支派。他是烏利的父親，比撒列的祖父。"
        }
      ]
    }
  },
