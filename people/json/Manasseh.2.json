  "localizations": {
    "eng": {
      "preferred_label": "Manasseh (King of Judah)",
      "alternate_labels": [
        "Manasses"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Manasseh (King of Judah)",
          "article": "person:Manasseh.2",
          "description": "A king of Judah during the divided kingdom. He was a son of Hezekiah by Hephzibah, husband of Meshullemeth, and father of Amon."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَنَسَّى (ملك يهوذا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك يهوذا في أثناء عصر المملكة المنقسمة. كان ابنًا لحزقيا من حفصيبة، وزوجًا لمشلمة، وأبًا لآمون."
        }
      ]
    },
    "zhs": {
      "preferred_label": "玛拿西（犹大王）",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期的一位犹大王。他是希西家和协西巴的儿子，米舒利密的丈夫，亚们的父亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Manassé (roi de Juda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un roi de Juda à l’époque du royaume divisé. Il était fils d’Ézéchias et d’Hephzibah, époux de Meschullémeth et père d’Amon."
        }
      ]
    },
    "hau": {
      "preferred_label": "Manasse (Sarkin Yahuda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Yahuda a lokacin rabuwar mulki. Shi ɗan Hezekiya ne ta wurin Hefziba, mijin Meshullemet, kuma mahaifin Amon."
        }
      ]
    },
    "hin": {
      "preferred_label": "मनश्शे (यहूदा का राजा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के समय यहूदा का एक राजा। वह हेप्सीबा से उत्पन्न हिजकिय्याह का पुत्र, मशुल्लेमेत का पति और आमोन का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Manasye (Raja Yehuda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Raja Yehuda pada masa kerajaan terpecah. Ia adalah anak dari Hizkia dan Hefzibah, suami dari Mesulemet, dan ayah dari Amon."
        }
      ]
    },
    "por": {
      "preferred_label": "Manassés (rei de Judá)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um rei de Judá durante o reino dividido. Ele era filho de Ezequias com Hefzibá, esposo de Mesulemete e pai de Amon."
        }
      ]
    },
    "rus": {
      "preferred_label": "Манассия (царь Иудеи)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь Иудеи во времена разделенного царства. Он был сыном Езекии от Хефцибы, мужем Мешуллемеф и отцом Амона."
        }
      ]
    },
    "spa": {
      "preferred_label": "Manasés (rey de Judá)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey de Judá durante el reino dividido. Fue hijo de Ezequías y Hepsiba, esposo de Mesulemet y padre de Amón."
        }
      ]
    },
    "swh": {
      "preferred_label": "Manase (Mfalme wa Yuda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Yuda wakati wa ufalme uliogawanyika. Alikuwa mwana wa Hezekia kwa Hefziba, mume wa Meshulemethi, na baba wa Amoni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Manase (King bilong Juda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela king bilong Juda long taim bilong hap lain kantri i bruk. Em i pikinini man bilong Hesekia na Hepsiba, em i man bilong Mesulemet, na em i papa bilong Emon."
        }
      ]
    },
    "apd": {
      "preferred_label": "منسى (ملك يهوذا)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك على يهوذا في زمن المملكة المنقسمة. كان ود حزقيا من حفصيبة، راجل مشلمة، وأبو آمون."
        }
      ]
    },
    "bis": {
      "preferred_label": "Manase (King blong Juda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong Juda long taem blong dividet kingdom. Hem i pikinini boe blong Hesekia wetem Hefsiba, hasban blong Mesulemet, mo papa blong Amon."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Manase (Eze Juda)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze Juda nʼoge alaeze kewara ekewa. Ọ bụ nwa Hezekaya site nʼaka Hefziba, di Meshulemet, na nna Amọn."
        }
      ]
    },
    "nep": {
      "preferred_label": "मनश्शे (यहूदाका राजा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा यहूदाका एक राजा। तिनी हेप्सीबाद्वारा जन्मेका हिजकियाका छोरा, मशुल्लेमेतका पति र आमोनका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-na-se (Vua Giu-đa)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vua của Giu-đa trong thời kỳ vương quốc phân chia. Ông là con trai của Ê-xê-chia với Hép-si-ba, chồng của Mê-su-lê-mết, và là cha của A-môn."
        }
      ]
    },
    "zht": {
      "preferred_label": "瑪拿西（猶大王）",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期的一位猶大王。他是希西家和協西巴的兒子，米舒利密的丈夫，亞們的父親。"
        }
      ]
    }
  },
