      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jonadab",
          "article": "person:Jonadab",
          "description": "A son of Rechab who lived during the time of Jehu, son of Nimshi."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُونَادَاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن رَكَاب الذي عاش في زمن ياهو بن نِمْشِي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约拿达",
      "descriptions": [
        {
          "source": "acai",
          "description": "利甲的儿子，生活在宁示的孙子耶户时代。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Récab qui vécut à l'époque de Jéhu, fils de Nimschi."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Rekab wanda ya rayu a zamanin Yehu ɗan Nimshi."
        }
      ]
    },
    "hin": {
      "preferred_label": "योनादाब",
      "descriptions": [
        {
          "source": "acai",
          "description": "रेकाब का एक पुत्र जो निमशी के पुत्र येहू के समय में जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki Rekhab yang hidup pada masa Yehu bin Nimsi."
        }
      ]
    },
    "por": {
      "preferred_label": "Jonadabe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho de Recabe que viveu durante a época de Jeú, filho de Ninsi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ионадав",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Рихава, живший во времена Ииуя, сына Намсиева."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Recab que vivió durante la época de Jehú, hijo de Nimsí."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yonadabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Rekabu aliyeishi wakati wa Yehu mwana wa Nimshi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jonadap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Rekap em i bin stap long taim bilong Jehu, pikinini man bilong Nimsi."
        }
      ]
    },
    "apd": {
      "preferred_label": "يوناداب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد ركاب العاش في زمن ياهو بن نمشي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini man blong Rekab we i laef long taem blong King Jehu, we i pikinini blong Nimsi."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jehonadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Rekab nke biri ndụ nʼoge Jehu, nwa Nimshi."
        }
      ]
    },
    "nep": {
      "preferred_label": "योनादाब",
      "descriptions": [
        {
          "source": "acai",
          "description": "रेकाबका एक छोरा जो निमसीका छोरा येहूको समयमा बाँचेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-na-đáp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Rê-cáp, sống vào thời Giê-hu, con của Nim-si."
        }
      ]
    },
    "zht": {
      "preferred_label": "約拿達",
      "descriptions": [
        {
          "source": "acai",
          "description": "利甲的兒子，生活於寧示的孫子（或兒子）耶戶的時代。"
        }
      ]
    }
  },
