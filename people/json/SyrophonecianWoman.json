  "type": "person",
  "localizations": {
    "eng": {
      "preferred_label": "Syrophonecian Woman",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Syrophonecian Woman",
          "description": "A woman who asks Jesus to deliver her daughter from demon possession."
        }
      ]
    },
    "apd": {
      "preferred_label": "المرا السيروفينيقية",
      "descriptions": [
        {
          "source": "acai",
          "description": "مرا طلبت من يسوع يحرر بتها من روح نجس."
        }
      ]
    },
    "arb": {
      "preferred_label": "ٱلْمَرْأَةُ ٱلسُّورُوفِينِيقِيَّةُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱمْرَأَةٌ طَلَبَتْ مِنْ يَسُوعَ أَنْ يُخَلِّصَ ٱبْنَتَهَا مِنْ مَسِّ الشَّيَاطِينِ."
        }
      ]
    },
    "bis": {
      "preferred_label": "Woman Sirofenisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan woman we i askem Jisas blong pemaot gel blong hem we dimon i stap spolem hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "Femme syro-phénicienne",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une femme qui demande à Jésus de délivrer sa fille d'une possession démoniaque."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bafinisiyen Siriya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata mata da ta roƙi Yesu ya ceci ’yarta daga shaidanun da suka kama ta."
        }
      ]
    },
    "hin": {
      "preferred_label": "सूरुफिनीकी स्त्री",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक स्त्री जिसने यीशु से अपनी बेटी को दुष्टात्मा से छुड़ाने की विनती की।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nwaanyị Saịrofenisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwaanyị rịọrọ Jisọs ka o napụta nwa ya nwaanyị nʼaka mmụọ ọjọọ ji ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "Perempuan Siro-Fenisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang perempuan yang memohon kepada Yesus untuk membebaskan anak perempuannya dari kerasukan setan."
        }
      ]
    },
    "nep": {
      "preferred_label": "सुरोफिनिसियाली महिला",
      "descriptions": [
        {
          "source": "acai",
          "description": "आफ्नी छोरीलाई दुष्टात्माको वशबाट छुटकारा दिन येशूसँग बिन्ती गर्ने एक महिला।"
        }
      ]
    },
    "por": {
      "preferred_label": "Mulher siro-fenícia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma mulher que pede a Jesus para libertar sua filha da possessão demoníaca."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сирофиникиянка",
      "descriptions": [
        {
          "source": "acai",
          "description": "Женщина, которая просит Иисуса избавить её дочь от одержимости бесом."
        }
      ]
    },
    "spa": {
      "preferred_label": "mujer sirofenicia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mujer que le pide a Jesús que libere a su hija de la posesión demoníaca."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mwanamke Msirofoinike",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamke aliyemwomba Yesu amponye binti yake aliyekuwa amepagawa na pepo mchafu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Meri bilong Sirofenisia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela meri i bin askim Jisas long rausim spirit nogut i stap long pikinini meri bilong em."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người phụ nữ Si-rô-phê-ni-xi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người phụ nữ cầu xin Chúa Giê-xu giải cứu con gái mình khỏi bị quỷ ám."
        }
      ]
    },
    "zhs": {
      "preferred_label": "叙利腓尼基妇人",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位请求耶稣将她女儿从鬼附中释放出来的妇人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "敘利亞腓尼基婦人",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位祈求耶穌將她的女兒從被鬼附中拯救出來的婦人。"
        }
      ]
    }
  },
