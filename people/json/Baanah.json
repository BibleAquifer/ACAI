          "description": "A man, son of Rimmon, who murdered Saul's son Ish-Bosheth."
        }
      ]
    },
    "fra": {
      "preferred_label": "Baana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Homme, fils de Rimmon, qui assassina Isch-Boscheth, fils de Saül."
        }
      ]
    },
    "spa": {
      "preferred_label": "Baana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre, hijo de Rimón, que asesinó a Is-boset, hijo de Saúl."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَعْنَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل، ابن رمون، قتل إيشبوشث ابن شاول."
        }
      ]
    },
    "zhs": {
      "preferred_label": "巴拿",
      "descriptions": [
        {
          "source": "acai",
          "description": "一名男子，临门（利门）的儿子，曾谋杀扫罗的儿子伊施·波设。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ba’ana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutum, ɗan Rimmon, wanda ya kashe ɗan Shawulu mai suna Ish-Boshet."
        }
      ]
    },
    "hin": {
      "preferred_label": "बानाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "रिम्मोन का पुत्र एक पुरुष, जिसने शाऊल के पुत्र ईशबोशेत की हत्या की थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Baana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pria, anak Rimon, yang membunuh anak Saul, Isyboset."
        }
      ]
    },
    "por": {
      "preferred_label": "Baaná",
      "descriptions": [
        {
          "source": "acai",
          "description": "Homem, filho de Rimom, que assassinou Isbosete, filho de Saul."
        }
      ]
    },
    "rus": {
      "preferred_label": "Баана",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек, сын Реммона, убивший сына Саула Иевосфея."
        }
      ]
    },
    "swh": {
      "preferred_label": "Baana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamume, mwana wa Rimoni, aliyemuua Ish-boshethi mwana wa Sauli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Bana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man, pikinini man bilong Rimon, em i bin kilim i dai Isboset, pikinini man bilong Sol."
        }
      ]
    },
    "apd": {
      "preferred_label": "بعنة",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل، ابن رمون، قتل إيشبوشث ابن شاول."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bahanaha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man, we papa blong hem Rimon, we i kilim i ded pikinini boe blong Sol ya Isboset."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Baana",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nwoke, nwa Rimọn, nke gburu nwa Sọl bụ Ish-Boshet."
        }
      ]
    },
    "nep": {
      "preferred_label": "बानाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "शाऊलका छोरा ईश्‍बोशेतको हत्या गर्ने एक व्यक्ति, रिम्‍मोनका छोरा।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ba-a-na",
      "descriptions": [
        {
          "source": "acai",
          "description": "Người con trai của Rim-môn, kẻ đã ám sát Ích-bô-sết, con trai của Sau-lơ."
        }
      ]
    },
    "zht": {
      "preferred_label": "巴拿",
      "descriptions": [
        {
          "source": "acai",
          "description": "臨門的兒子，殺害了掃羅的兒子伊施波設。"
        }
      ]
    }
  },
