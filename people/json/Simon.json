  "localizations": {
    "eng": {
      "preferred_label": "Simon (Peter)",
      "alternate_labels": [
        "Simon Peter",
        "Peter"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Peter",
          "article": "person:Simon",
          "description": "He was chief of the twelve apostles of Jesus. Peter was the son of John and brother of Andrew the first-called apostle of Jesus."
        }
      ]
    },
    "fra": {
      "preferred_label": "Simon (Pierre)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Il était le chef des douze apôtres de Jésus. Pierre était le fils de Jean et le frère d'André, le premier apôtre appelé par Jésus."
        }
      ]
    },
    "spa": {
      "preferred_label": "Simón (Pedro)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fue el líder de los doce apóstoles de Jesús. Pedro era hijo de Juan y hermano de Andrés, el primer apóstol llamado por Jesús."
        }
      ]
    },
    "arb": {
      "preferred_label": "سِمْعَان (بُطْرُس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كان رئيس الرسل الاثني عشر ليسوع. وكان بطرس ابن يوحنا وأخا أندراوس أول رسول دُعي من قِبل يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西门 (彼得)",
      "descriptions": [
        {
          "source": "acai",
          "description": "他是耶稣十二使徒之首。彼得是约翰的儿子，也是耶稣最早呼召的使徒安得烈的兄弟。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Siman (Bitrus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shi ne shugaban manzannin Yesu goma sha biyu. Bitrus ɗan Yohanna ne kuma ɗan’uwan Andarawus manzon Yesu na farko da aka kira."
        }
      ]
    },
    "hin": {
      "preferred_label": "शमौन (पतरस)",
      "descriptions": [
        {
          "source": "acai",
          "description": "वह यीशु के बारह प्रेरितों में मुख्य था। पतरस यूहन्ना का पुत्र और यीशु के पहले बुलाए गए प्रेरित अन्द्रियास का भाई था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Simon (Petrus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ia adalah pemimpin dari kedua belas rasul Yesus. Petrus adalah anak Yohanes dan saudara Andreas, rasul Yesus yang pertama kali dipanggil."
        }
      ]
    },
    "por": {
      "preferred_label": "Simão (Pedro)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ele foi o líder dos doze apóstolos de Jesus. Pedro era filho de João e irmão de André, o primeiro apóstolo chamado por Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Симон (Пётр)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Был главой двенадцати апостолов Иисуса. Пётр был сыном Иоанна (Ионы) и братом Андрея, первозванного апостола Иисуса."
        }
      ]
    },
    "swh": {
      "preferred_label": "Simoni (Petro)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Alikuwa kiongozi wa mitume kumi na wawili wa Yesu. Petro alikuwa mwana wa Yohana na ndugu wa Andrea, mtume wa kwanza kuitwa na Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Saimon (Pita)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Em i namba wan hetman bilong ol 12-pela aposel bilong Jisas. Pita em i pikinini man bilong Jon na brata bilong Andru, em namba wan aposel Jisas i bin singautim."
        }
      ]
    },
    "apd": {
      "preferred_label": "سيمون (بطرس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "هو كان رئيس الرسل الاتناشر ليسوع. بطرس كان ابن يوحنا وأخو أندراوس، أول رسول ناداهو يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Saemon (Pita)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hem i lida blong ol twelef aposol blong Jisas. Pita i pikinini man blong Jon mo brata blong Andru, faswan aposol we Jisas i bin singaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Saimọn (Pita)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọ bụ onyeisi ndị ozi iri na abụọ nke Jisọs. Pita bụ nwa Jọn na nwanne Andru, onye mbụ a kpọrọ nʼime ndị ozi Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिमोन (पत्रुस)",
      "descriptions": [
        {
          "source": "acai",
          "description": "उनी येशूका बाह्र प्रेरितहरूका प्रमुख थिए। पत्रुस यूहन्नाका छोरा र येशूका पहिले बोलाइएका प्रेरित अन्द्रियासका भाइ थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Si-môn (Phi-e-rơ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ông là người đứng đầu trong số mười hai sứ đồ của Chúa Giê-xu. Phi-e-rơ là con trai của Giăng và là anh em của Anh-rê, sứ đồ đầu tiên được Chúa Giê-xu kêu gọi."
        }
      ]
    },
    "zht": {
      "preferred_label": "西門（彼得）",
      "descriptions": [
        {
          "source": "acai",
          "description": "他是耶穌十二使徒之首。彼得是約翰的兒子，也是耶穌首先呼召的使徒安得烈的兄弟。"
        }
      ]
    }
  },
