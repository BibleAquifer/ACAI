  "localizations": {
    "eng": {
      "preferred_label": "Rachel",
      "alternate_labels": [
        "Rahel",
        "she"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rachel",
          "article": "person:Rachel",
          "description": "Daughter of Laban, and the second and favorite wife of Jacob. She was the mother of Joseph and Benjamin. Her slave Bilhah was the mother of Dan and Naphtali."
        }
      ]
    },
    "arb": {
      "preferred_label": "رَاحِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابنة لابان، والزوجة الثانية والأحب إلى يعقوب. كانت أمّ يوسف وبنيامين. وكانت جاريتها بلهة أمّ دان ونفتالي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拉结",
      "descriptions": [
        {
          "source": "acai",
          "description": "拉班的女儿，也是雅各深爱的第二位妻子。她是约瑟和便雅悯的母亲。她的使女辟拉是但和拿弗他利的母亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Rachel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fille de Laban, seconde épouse et préférée de Jacob. Elle fut la mère de Joseph et Benjamin. Sa servante Bilha fut la mère de Dan et Nephthali."
        }
      ]
    },
    "hau": {
      "preferred_label": "Rahila",
      "descriptions": [
        {
          "source": "acai",
          "description": "’Yar Laban, kuma mata ta biyu kuma wadda Yaƙub ya fi ƙauna. Ita ce mahaifiyar Yusuf da Benyamin. Kuyangarta Bilha ita ce mahaifiyar Dan da Naftali."
        }
      ]
    },
    "hin": {
      "preferred_label": "राहेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "लाबान की बेटी, और याकूब की दूसरी तथा प्रिय पत्नी। वह यूसुफ और बिन्यामीन की माता थी। उसकी दासी बिल्हा दान और नप्ताली की माता थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Rahel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Putri Laban, serta istri kedua dan yang paling dicintai Yakub. Ia adalah ibu dari Yusuf dan Benyamin. Budak perempuannya, Bilha, adalah ibu dari Dan dan Naftali."
        }
      ]
    },
    "por": {
      "preferred_label": "Raquel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filha de Labão, e a segunda e favorita esposa de Jacó. Ela foi a mãe de José e Benjamim. Sua serva Bila foi mãe de Dã e Naftali."
        }
      ]
    },
    "rus": {
      "preferred_label": "Рахиль",
      "descriptions": [
        {
          "source": "acai",
          "description": "Дочь Лавана, а также вторая и любимая жена Иакова. Она была матерью Иосифа и Вениамина. Ее служанка Валла была матерью Дана и Неффалима."
        }
      ]
    },
    "spa": {
      "preferred_label": "Raquel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hija de Labán, y segunda y predilecta esposa de Jacob. Fue la madre de José y Benjamín. Su sierva Bilha fue la madre de Dan y Neftalí."
        }
      ]
    },
    "swh": {
      "preferred_label": "Raheli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Binti wa Labani, na mke wa pili na aliyependwa zaidi na Yakobo. Alikuwa mama wa Yusufu na Benyamini. Mjakazi wake Bilha alikuwa mama wa Dani na Naftali."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Resel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini meri bilong Laban, na namba 2 meri na meri Jekop i laikim tumas. Em i mama bilong Josep na Benjamin. Wokmeri bilong em Bilha em i mama bilong Dan na Naftali."
        }
      ]
    },
    "apd": {
      "preferred_label": "راحيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "بت لابان، والزوجة التانية والمفضلة لي يعقوب. هي كانت أم يوسف وبنيامين. وجاريتها بلهة كانت أم دان ونفتالي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Rejel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dota blong Laban, mo seken woman blong Jekob we hem i laekem hem tumas. Hem i mama blong Josef mo Benjamin. Slefvuman blong hem Bilha i mama blong Dan mo Naftali."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Rechel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwanyị Leban, na nwunye nke abụọ nke Jekọb kacha hụ nʼanya. Ọ bụ nne Josef na Benjamin. Odibo ya nwaanyị bụ Bilha bụ nne Dan na Naftali."
        }
      ]
    },
    "nep": {
      "preferred_label": "राहेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "लाबानकी छोरी, र याकूबकी दोस्रो तथा प्रिय पत्‍नी। उनी योसेफ र बेन्यामिनकी आमा थिइन्। उनकी दासी बिल्‍हा दान र नप्‍तालीकी आमा थिइन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ra-chên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con gái của La-ban, người vợ thứ hai và được yêu thương nhất của Gia-cốp. Bà là mẹ của Giô-sép và Bê-gia-min. Nữ tì của bà là Bi-la, mẹ của Đan và Nép-ta-li."
        }
      ]
    },
    "zht": {
      "preferred_label": "拉結",
      "descriptions": [
        {
          "source": "acai",
          "description": "拉班的女兒，雅各的第二位妻子也是他最心愛的妻子。她是約瑟和便雅憫的母親。她的婢女辟拉是但和拿弗他利的母親。"
        }
      ]
    }
  },
