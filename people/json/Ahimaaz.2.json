  "localizations": {
    "eng": {
      "preferred_label": "Ahimaaz (Son of Zadok)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ahimaaz (Son of Zadok)",
          "article": "person:Ahimaaz.2",
          "description": "A Levite and son of the high priest Zadok. Ahimaaz joined Jonathan, son of Abiathar, in spying on Absalom."
        }
      ]
    },
    "fra": {
      "preferred_label": "Achimaats (fils de Tsadok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un Lévite et fils du grand prêtre Tsadok. Achimaats se joignit à Jonathan, fils d'Abiathar, pour espionner Absalom."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ajimaz (hijo de Sadoc)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Levita e hijo del sumo sacerdote Sadoc. Ajimaz se unió a Jonatán, hijo de Abiatar, para espiar a Absalón."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَخِيمَعَص (ابن صادوق)",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوي وابن رئيس الكهنة صادوق. انضم أخيمعص إلى يوناثان بن أبياثار في التجسس على أبشالوم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚希玛斯 (撒督之子)",
      "descriptions": [
        {
          "source": "acai",
          "description": "利未人，是大祭司撒督的儿子。亚希玛斯曾与亚比亚他的儿子约拿单一同做侦察，打探押沙龙的消息。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ahimawaz (Ɗan Zadok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Balawe ne kuma ɗan babban firist Zadok. Ahimawaz ya haɗa kai da Yonatan ɗan Abiyatar wajen yi wa Absalom leƙen asiri."
        }
      ]
    },
    "hin": {
      "preferred_label": "अहीमास (सादोक का पुत्र)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक लेवी और महायाजक सादोक का पुत्र। अहीमास, एब्यातार के पुत्र योनातान के साथ मिलकर अबशालोम की जासूसी करने में शामिल हुआ।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ahimaas (anak Zadok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang Lewi dan anak dari imam besar Zadok. Ahimaas bersama Yonatan, anak Abyatar, menjadi mata-mata untuk mengawasi Absalom."
        }
      ]
    },
    "por": {
      "preferred_label": "Aimaás (filho de Zadoque)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um levita e filho do sumo sacerdote Zadoque. Aimaás juntou-se a Jônatas, filho de Abiatar, para espionar Absalão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ахимаас (сын Садока)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левит и сын первосвященника Садока. Ахимаас вместе с Ионафаном, сыном Авиафара, следил за Авессаломом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ahimaasi (Mwana wa Sadoki)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mlawi na mwana wa kuhani mkuu Sadoki. Ahimaasi alijiunga na Yonathani mwana wa Abiathari katika kumpeleleza Absalomu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ahimas (Pikinini bilong Sadok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela Livai na pikinini man bilong nambawan pris Sadok. Ahimas i bin poroman wantaim Jonatan, pikinini man bilong Abiatar, long spai long Apsalom."
        }
      ]
    },
    "apd": {
      "preferred_label": "أخيعمص (ولد صادوق)",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوي وولد رئيس الكهنة صادوق. أخيعمص شارك يوناثان ولد أبياثار في التجسس على أبشالوم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ahimahaj (Pikinini blong Jadok)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan Livaet mo pikinini blong hae pris ya Jadok. Ahimahaj i joen wetem Jonatan we i pikinini blong Abiata blong spae long Absalom."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ahimaaz (nwa Zadọk)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye Livaị na nwa Zadọk bụ nnukwu onye nchụaja. Ahimaaz so Jonatan nwa Abịata nledo Absalọm anya."
        }
      ]
    },
    "nep": {
      "preferred_label": "अहीमास (सादोकका छोरा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक जना लेवी र प्रधान पुजारी सादोकका छोरा। अहीमास अबियाथारका छोरा जोनाथनसँग मिलेर अब्सालोमको जासुसी गर्न सामेल भएका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-hi-mát (Con của Xa-đốc)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người Lê-vi và là con trai của thầy tế lễ thượng phẩm Xa-đốc. A-hi-mát đã cùng với Giô-na-than, con trai của A-bia-tha, do thám Áp-sa-lôm."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞希瑪斯（撒督的兒子）",
      "descriptions": [
        {
          "source": "acai",
          "description": "利未人，大祭司撒督的兒子。亞希瑪斯曾與亞比亞他的兒子約拿單一同暗中窺探押沙龍。"
        }
      ]
    }
  },
