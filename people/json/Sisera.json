  "localizations": {
    "eng": {
      "preferred_label": "Sisera",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Sisera",
          "article": "person:Sisera",
          "description": "Leader of the army of the Canaanite king Jabin who was killed by the woman Jael during the time of the judge and prophetess Deborah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Sisera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chef de l’armée du roi cananéen Jabin, tué par une femme nommée Jaël à l’époque de Débora, juge et prophétesse."
        }
      ]
    },
    "spa": {
      "preferred_label": "Sísara",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jefe del ejército del rey cananeo Jabín, a quien mató la mujer Jael durante la época de la jueza y profetisa Débora."
        }
      ]
    },
    "arb": {
      "preferred_label": "سِيسَرَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "قائد جيش يابين ملك كنعان الذي قتلته امرأة تدعى ياعيل في عهد دبورة القاضية والنبيّة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "西西拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦南王耶宾的军队统帅，在士师兼女先知底波拉时期被妇人雅亿所杀。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Sisera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kwamandan rundunar Yabin sarkin Kan’ana wanda matar nan Yayel ta kashe shi a zamanin Deborah mai shari’a kuma annabiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "सीसरा",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनानी राजा याबीन की सेना का प्रधान, जिसे दबोरा न्यायियों और नबिया के समय में याएल नामक स्त्री ने मार डाला था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Sisera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Panglima tentara Yabin, raja Kanaan, yang dibunuh oleh seorang perempuan bernama Yael pada zaman hakim dan nabiah Debora."
        }
      ]
    },
    "por": {
      "preferred_label": "Sísera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Líder do exército do rei cananeu Jabim que foi morto pela mulher Jael durante o tempo da juíza e profetisa Débora."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сисара",
      "descriptions": [
        {
          "source": "acai",
          "description": "Военачальник ханаанского царя Иавина, убитый женщиной Иаилью во времена судьи и пророчицы Деворы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sisera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kiongozi wa jeshi la mfalme Yabini wa Kanaani aliyeuawa na mwanamke Yaelikati ya wakati wa mwamuzi na nabii wa kike Debora."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sisera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hetman bilong ami bilong King Jabin bilong Kenan, em meri Jael i bin kilim em i dai long taim bilong jas na profet meri Debora."
        }
      ]
    },
    "apd": {
      "preferred_label": "سيسرا",
      "descriptions": [
        {
          "source": "acai",
          "description": "قائد جيش يابين ملك كنعان، والكتلتو المرة ياعيل في زمن دبورة القاضية والنبيّة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Siseraha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lida blong ami blong King Jabin blong Kenan, we woman ya Jael i bin kilim hem i ded long taem blong jaj mo profet woman ya Debora."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sisera",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyeisi ndị agha nke Jabin bụ eze ndị Kenan, onye nwanyị aha ya bụ Jael gburu nʼoge Debora onye ikpe na onye amụma nwanyị."
        }
      ]
    },
    "nep": {
      "preferred_label": "सीसरा",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनानी राजा याबीनका सेनापति जसलाई न्यायकर्ता र अगमवादिनी दबोराको समयमा याएल नाउँकी स्त्रीले मारेकी थिइन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Si-sê-ra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thống lĩnh quân đội của vua Ca-na-an là Gia-bin, người đã bị nàng Gia-ên giết chết trong thời quan xét và nữ tiên tri Đê-bô-ra."
        }
      ]
    },
    "zht": {
      "preferred_label": "西西拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦南王耶賓軍隊的統帥，在士師兼女先知底波拉時期被婦人雅億所殺。"
        }
      ]
    }
  },
