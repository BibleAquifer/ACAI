      "descriptions": [
        {
          "source": "acai",
          "gloss": "Kish",
          "article": "person:Kish",
          "description": "Father of King Saul from the tribe of Benjamin who lived during Israel’s united kingdom."
        }
      ]
    },
    "arb": {
      "preferred_label": "قَيْس",
      "descriptions": [
        {
          "source": "acai",
          "description": "أبو الملك شاول من سبط بنيامين، عاش في عهد المملكة الموحدة لإسرائيل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "基士",
      "descriptions": [
        {
          "source": "acai",
          "description": "扫罗王的父亲，出自便雅悯支派，生活在以色列联合王国时期。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Kis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Père du roi Saül, issu de la tribu de Benjamin, qui vivait à l'époque de la monarchie unie d'Israël."
        }
      ]
    },
    "hau": {
      "preferred_label": "Kish",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahaifin Sarki Shawulu daga kabilar Benyamin wanda ya rayu a lokacin haɗaɗɗiyar masarautar Isra’ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "कीश",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिन्यामीन के गोत्र का राजा शाऊल का पिता, जो इस्राएल के संयुक्त राजतंत्र के समय जीवित था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Kish",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ayah dari Raja Saul dari suku Benyamin yang hidup pada masa kerajaan bersatu Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Quis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pai do rei Saul, da tribo de Benjamim, que viveu durante o reino unificado de Israel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Кис",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отец царя Саула из колена Вениамина, живший во времена объединенного царства Израиля."
        }
      ]
    },
    "spa": {
      "preferred_label": "Cis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Padre del rey Saúl, de la tribu de Benjamín, que vivió durante el reino unido de Israel."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kishi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Baba yake Mfalme Sauli kutoka kabila la Benyamini aliyeishi wakati wa ufalme wa umoja wa Israeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa bilong King Sol bilong lain Benjamin em i bin stap laip long taim Israel i stap wanpela kingdom tasol."
        }
      ]
    },
    "apd": {
      "preferred_label": "قيس",
      "descriptions": [
        {
          "source": "acai",
          "description": "أبو الملك شاول من سبط بنيامين، عاش وكت المملكة الموحدة في إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa blong King Sol we i laen blong Benjamin, we i laef long taem we ol laen blong Isrel oli joen wanples olsem wan neson."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Kish",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nna Eze Sọl onye si n'agbụrụ Benjamin, onye dịrị ndụ n'oge alaeze dị n'otu nke Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "कीश",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलको संयुक्त राज्यको समयमा बाँचेका बेन्यामीन कुलका राजा शाऊलका पिता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Kích",
      "descriptions": [
        {
          "source": "acai",
          "description": "Thân phụ của Vua Sau-lơ, thuộc bộ tộc Bên-gia-min, sống trong thời kỳ vương quốc thống nhất của Y-sơ-ra-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "基士",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列聯合王國時期的便雅憫支派人，掃羅王的父親。"
        }
      ]
    }
  },
