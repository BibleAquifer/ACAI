        }
      ]
    },
    "swh": {
      "preferred_label": "Yehonadabu (Yonadabu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu aliyeishi wakati wa ufalme uliogawanyika, mwana wa Rekabu, na babu wa Warekabu, anayetajwa katika 2 Wafalme 10:15."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jehonadap (Jonadap)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man long taim bilong kingdom i brukbruk, pikinini man bilong Rekap, na tumbuna papa bilong ol Rekap, em 2 King 10:15 i stori long en."
        }
      ]
    },
    "apd": {
      "preferred_label": "يهوناداب (يوناداب)",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل من فترة المملكة المنقسمة، ولد ركاب وجد الركابيين، ومذكور في ملوك التاني 10: 15."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jehonadab (Jonadab)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man long taem we kingdom i seraot, pikinini boe blong Rekab, mo olfala bubu blong ol Rekabaet, we 2 King 10:15 i tokbaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jehonadab (Jonadab)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke si n'oge alaeze kewara ekewa, nwa nwoke Rekab, na nna nna ndị Rekab, nke a kpọtụrụ aha na 2 Ndị Eze 10:15."
        }
      ]
    },
    "nep": {
      "preferred_label": "यहोनादाब (योनादाब)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य कालका एक व्यक्ति, रेकाबका छोरा र रेकाबीहरूका पूर्वज, जसको उल्लेख २ राजा १०:१५ मा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giê-hô-na-đáp (Giô-na-đáp)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người sống vào thời kỳ vương quốc phân chia, con trai của Rê-cáp, và là tổ phụ của người Rê-cáp, được đề cập trong 2 Các Vua 10:15."
        }
      ]
    },
    "zht": {
      "preferred_label": "約拿達",
      "descriptions": [
        {
          "source": "acai",
          "description": "分裂王國時期的人物，利甲的兒子，利甲族的先祖，記載於列王紀下 10:15。"
        }
      ]
    }
