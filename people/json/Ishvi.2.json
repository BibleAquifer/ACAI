          "description": "حفيد البطريرك يعقوب وابن أشير. وكان مؤسس عشيرة اليشويين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亦施韦 (创世记 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长雅各的孙子，亚设的儿子。他是亦施韦族的建立者。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jischvi (Genèse 46.17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Petit-fils du patriarche Jacob et fils d'Aser. Il fut le fondateur du clan des Jischvites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ishbi (Farawa 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jikan kakan nan Yakubu kuma ɗan Asher. Shi ne ya kafa kabilar Ishbiyawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "यिश्वी (उत्पत्ति 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता याकूब का पोता और आशेर का पुत्र। वह यिश्वियों के कुल का संस्थापक था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yiswi (Kejadian 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cucu dari bapa leluhur Yakub dan putra Asyer. Ia adalah pendiri kaum orang Yiswi."
        }
      ]
    },
    "por": {
      "preferred_label": "Isvi (Gênesis 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Neto do patriarca Jacó e filho de Aser. Ele foi o fundador do clã dos isvitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ишви (Бытие 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Внук патриарха Иакова и сын Асира. Он был родоначальником клана ишвитян."
        }
      ]
    },
    "spa": {
      "preferred_label": "Isví (Génesis 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nieto del patriarca Jacob e hijo de Aser. Fue fundador del clan de los isvitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ishvi (Mwanzo 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mjukuu wa mzee wa ukoo Yakobo na mwana wa Asheri. Alikuwa mwanzilishi wa ukoo wa Waishvi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Isvi (Stat 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tumbuna pikinini man bilong Jekop na pikinini man bilong Aser. Em i tumbuna papa bilong femili o lain bilong ol Isvi."
        }
      ]
    },
    "apd": {
      "preferred_label": "يشوي (التكوين 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "حفيد يعقوب وولد أشير. وهو مؤسس عشيرة اليشويين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jisvi (Jenesis 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Smalbubu blong Jekob mo pikinini boe blong Asere. Hem i stamba blong laen blong ol man Jisvi."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ishvi (Mmalite 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa nna ochie bụ Jekọb na nwa Asha. Ọ bụ onye guzobere ikwu ndị Ishvi."
        }
      ]
    },
    "nep": {
      "preferred_label": "यिश्बी (उत्पत्ति 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता याकूबका नाति र आशेरका छोरा। तिनी यिश्बीहरूका कुलका संस्थापक थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ích-vi (Sáng Thế Ký 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cháu nội của tổ phụ Gia-cốp và là con trai của A-se. Ông là người sáng lập thị tộc người Ích-vi."
        }
      ]
    },
    "zht": {
      "preferred_label": "亦施韋 (創世記 46:17)",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長雅各的孫子，亞設的兒子。他是亦施韋族的創始人。"
        }
      ]
    }
  },
