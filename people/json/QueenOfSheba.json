{
  "id": "person:QueenOfSheba",
  "primary_id": "person:QueenOfSheba",
  "alternate_sources": {
    "tipnr": [
      "Queen_of_Sheba@1Ki.10.1-Luk"
    ],
    "vizbible": [
      "recukYvuhVi3jljKz"
    ]
  },
  "type": "person",
  "gender": "female",
  "roles": [
    "Queen"
  ],
  "localizations": {
    "eng": {
      "preferred_label": "Queen of Sheba",
      "alternate_labels": [
        "Queen of the South"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Queen of Sheba",
          "article": "person:QueenOfSheba",
          "description": "A queen from the south who heard of King Solomon’s wisdom and visited him in Jerusalem."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَلِكَةُ سَبَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَلِكَةٌ مِنَ ٱلْجَنُوبِ سَمِعَتْ بِحِكْمَةِ ٱلْمَلِكِ سُلَيْمَانَ وَزَارَتْهُ فِي أُورُشَلِيمَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "示巴女王",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位来自南方的女王，她听闻所罗门王的智慧，便前往耶路撒冷拜访他。"
        }
      ]
    },
    "fra": {
      "preferred_label": "reine de Séba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Une reine du sud qui entendit parler de la sagesse du roi Salomon et lui rendit visite à Jérusalem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sarauniyar Sheba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarauniya daga kudu wadda ta ji labarin hikimar Sarki Solomon ta kuma ziyarce shi a Urushalima."
        }
      ]
    },
    "ind": {
      "preferred_label": "Ratu Syeba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang ratu dari selatan yang mendengar tentang hikmat Raja Salomo dan mengunjunginya di Yerusalem."
        }
      ]
    },
    "por": {
      "preferred_label": "Rainha de Sabá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma rainha do sul que ouviu falar da sabedoria do rei Salomão e o visitou em Jerusalém."
        }
      ]
    },
    "rus": {
      "preferred_label": "Царица Савская",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царица с юга, которая услышала о мудрости царя Соломона и посетила его в Иерусалиме."
        }
      ]
    },
    "spa": {
      "preferred_label": "Reina de Sabá",
      "descriptions": [
        {
          "source": "acai",
          "description": "Reina del sur que oyó de la sabiduría del rey Salomón y lo visitó en Jerusalén."
        }
      ]
    },
    "swh": {
      "preferred_label": "Malkia wa Sheba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Malkia kutoka kusini aliyesikia kuhusu hekima ya Mfalme Solomoni na kumtembelea huko Yerusalemu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Kwin bilong Seba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela kwin bilong hap bilong saut husat i bin harim tok long bikpela save bilong King Solomon na i kam lukim em long Jerusalem."
        }
      ]
    },
    "apd": {
      "preferred_label": "ملكة سبأ",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملكة من الجنوب سمعت بحكمة الملك سليمان وزارتُو في أورشليم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Kwin blong Seba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan kwin we i aot long saot we i harem nius blong waes blong King Solomon mo i go luk hem long Jerusalem."
        }
      ]
    },
    "hin": {
      "preferred_label": "शेबा की रानी",
      "descriptions": [
        {
          "source": "acai",
          "description": "दक्षिण की एक रानी जिसने राजा सुलैमान की बुद्धि की कीर्ति सुनी और यरूशलेम में उससे भेंट करने आई।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Eze nwanyị Sheba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze nwanyị si nʼakụkụ ndịda nke nụrụ banyere amamihe Eze Solomọn ma bịa leta ya na Jerusalem."
        }
      ]
    },
    "nep": {
      "preferred_label": "शेबाकी रानी",
      "descriptions": [
        {
          "source": "acai",
          "description": "दक्षिण देशकी एक रानी जसले राजा सोलोमनको बुद्धिको बारेमा सुनेकी थिइन् र यरूशलेममा तिनलाई भेट्न आइन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Nữ hoàng Sê-ba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nữ hoàng đến từ phương nam, người đã nghe biết về sự khôn ngoan của Vua Sa-lô-môn và đến thăm ông tại Giê-ru-sa-lem."
        }
      ]
    },
    "zht": {
      "preferred_label": "示巴女王",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位來自南方的女王，她聽見所羅門王的智慧，便前往耶路撒冷拜訪他。"
        }
      ]
    }
  },
