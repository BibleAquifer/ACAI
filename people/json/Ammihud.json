  "localizations": {
    "eng": {
      "preferred_label": "Ammihud",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ammihud",
          "article": "person:Ammihud",
          "description": "A son of Ladan, from the tribe of Ephraim, and the great-grandfather of the Israelite leader Joshua, son of Nun."
        }
      ]
    },
    "fra": {
      "preferred_label": "Ammihud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Laedan, de la tribu d'Éphraïm, et arrière-grand-père du chef israélite Josué, fils de Nun."
        }
      ]
    },
    "spa": {
      "preferred_label": "Amiud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Ladán, de la tribu de Efraín, y bisabuelo del líder israelita Josué, hijo de Nun."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَمِّيهود",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن لعدان، من سبط أفرايم، وهو الجد الأكبر للقائد الإسرائيلي يشوع بن نون."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚米忽",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法莲支派拉但的儿子，以色列领袖嫩的儿子约书亚的曾祖父。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ammihud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Ladan, daga kabilar Efraim, kuma kakan kakan shugaban Isra'ilawa Joshua ɗan Nun."
        }
      ]
    },
    "hin": {
      "preferred_label": "अम्मीहूद",
      "descriptions": [
        {
          "source": "acai",
          "description": "एप्रैम के गोत्र से लादान का एक पुत्र, और इस्राएली अगुवे नून के पुत्र यहोशू का परदादा।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Amihud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak dari Ladan, dari suku Efraim, dan kakek buyut dari pemimpin Israel, Yosua bin Nun."
        }
      ]
    },
    "por": {
      "preferred_label": "Amiúde",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um filho de Ladã, da tribo de Efraim, e bisavô do líder israelita Josué, filho de Num."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аммиуд",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Лаедана из колена Ефремова и прадед израильского вождя Иисуса Навина."
        }
      ]
    },
    "swh": {
      "preferred_label": "Amihudi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Ladani, kutoka kabila la Efraimu, na babu mkuu wa kiongozi wa Israeli Yoshua mwana wa Nuni."
        }
      ]
    },
    "apd": {
      "preferred_label": "عميهود",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن لعدان، من سبط أفرایم، وهو الجد الأكبر للقائد الإسرائيلي يشوع بن نون."
        }
      ]
    },
    "bis": {
      "preferred_label": "Amihud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan boe blong Ladan, we i kamaot long laen blong Efrem, mo hem i olfala bubu man blong lida blong ol man Israel ya Josua we i boe blong Nun."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Amihud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Ladan, onye si nʼebo Ifrem, na nna nna nna nke onye ndu Izrel bụ Joshụa, nwa Nọn."
        }
      ]
    },
    "nep": {
      "preferred_label": "अम्मीहूद",
      "descriptions": [
        {
          "source": "acai",
          "description": "एफ्राइम कुलका लादानका छोरा, र इस्राएली अगुवा नूनका छोरा यहोशूका जिजुबुबा।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Amihut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Ladan, bilong lain Efraim, na tumbuna papa bilong lida bilong Israel Josua, pikinini man bilong Nun."
        }
      ]
    },
    "vie": {
      "preferred_label": "A-mi-hút",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của La-đan, thuộc bộ tộc Ép-ra-im, và là cụ nội của nhà lãnh đạo Y-sơ-ra-ên Giô-suê con trai Nun."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞米忽",
      "descriptions": [
        {
          "source": "acai",
          "description": "拉但的兒子，屬以法蓮支派，是以色列人領袖嫩的兒子約書亞的曾祖父。"
        }
      ]
    }
  },
