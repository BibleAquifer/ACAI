  "localizations": {
    "eng": {
      "preferred_label": "Ehud",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ehud",
          "article": "person:Ehud",
          "description": "A son of Gera from the tribe of Benjamin who was judge of Israel when Eglon was king of Moab."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِهُود",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن لجيرا من سبط بنيامين وكان قاضيًا لإسرائيل حين كان عجلون ملكًا لموآب."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以笏",
      "descriptions": [
        {
          "source": "acai",
          "description": "便雅悯支派基拉的儿子，当伊矶伦作摩押王时担任以色列的士师。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Éhud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Guéra de la tribu de Benjamin, qui fut juge d'Israël lorsque Églon était roi de Moab."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ehud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Gera daga kabilar Benyamin wanda ya kasance alƙalin Isra’ila sa’ad da Eglon yake sarkin Mowab."
        }
      ]
    },
    "hin": {
      "preferred_label": "एहूद",
      "descriptions": [
        {
          "source": "acai",
          "description": "बिन्यामीन के गोत्र से गेरा का एक पुत्र, जो उस समय इस्राएल का न्यायी था जब एग्लोन मोआब का राजा था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ehud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Putra Gera dari suku Benyamin yang menjadi hakim Israel ketika Eglon menjadi raja Moab."
        }
      ]
    },
    "por": {
      "preferred_label": "Eúde",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Gera, da tribo de Benjamim, que foi juiz de Israel quando Eglom era rei de Moabe."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аод",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Геры из колена Вениамина, который был судьей Израиля, когда Еглон был царем Моава."
        }
      ]
    },
    "spa": {
      "preferred_label": "Aod",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Gera de la tribu de Benjamín que fue juez de Israel cuando Eglón era rey de Moab."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ehudi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Gera kutoka kabila la Benyamini aliyekuwa mwamuzi wa Israeli wakati Egloni alipokuwa mfalme wa Moabu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ehut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Gera bilong lain bilong Benjamin em i bin jas bilong Israel long taim Eklon i stap king bilong Moap."
        }
      ]
    },
    "apd": {
      "preferred_label": "إهود",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن جيرا من سبط بنيامين، كان قاضي لإسرائيل لما كان عجلون ملك على موآب."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ehud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Geraha blong laen blong Benjamin we i bin jas blong Isrel long taem we Eglon i king blong Moab."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ehud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Gera sitere n'agbụrụ Benjamin nke bụ onye ikpe nke Izrel mgbe Eglọn bụ eze Moab."
        }
      ]
    },
    "nep": {
      "preferred_label": "एहूद",
      "descriptions": [
        {
          "source": "acai",
          "description": "बेन्यामीन कुलका गेराका छोरा जो एग्लोन मोआबका राजा हुँदा इस्राएलका न्यायकर्ता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-hút",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người con trai của Ghê-ra thuộc bộ tộc Bên-gia-min, là quan xét của Y-sơ-ra-ên khi Éc-lôn làm vua Mô-áp."
        }
      ]
    },
    "zht": {
      "preferred_label": "以笏",
      "descriptions": [
        {
          "source": "acai",
          "description": "便雅憫支派基拉的兒子，在摩押王伊磯倫統治時期擔任以色列的士師。"
        }
      ]
    }
  },
