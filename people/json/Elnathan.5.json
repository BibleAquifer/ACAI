  "localizations": {
    "eng": {
      "preferred_label": "Elnathan (Jeremiah 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Elnathan (Jeremiah 26:22)",
          "article": "person:Elnathan.5",
          "description": "Elnathan, son of Achbor, was an official serving King Jehoiakim during the time of the divided kingdom, first mentioned in Jeremiah 26:22."
        }
      ]
    },
    "fra": {
      "preferred_label": "Elnathan (Jérémie 26.22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elnathan, fils d’Acbor, était un haut fonctionnaire au service du roi Jojakim à l’époque du royaume divisé, mentionné pour la première fois dans Jérémie 26:22."
        }
      ]
    },
    "spa": {
      "preferred_label": "Elnatán (Jeremías 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elnatán, hijo de Acbor, fue un oficial que sirvió al rey Joacim durante la época del reino dividido, mencionado por primera vez en Jeremías 26:22."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَلْنَاثَان (إرميا 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ألناثان بن عكبور، كان مسؤولاً في خدمة الملك يهوياقيم خلال عصر المملكة المنقسمة، وذُكر أول مرة في إرميا 26: 22."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以利拿单 (耶利米书 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以利拿单是亚革波的儿子，在王国分裂时期服侍约雅敬王的一名官员，首次记载于耶利米书26:22。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Elnatan (Irmiya 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elnatan, ɗan Akbor, wani babban jami’i ne da ya yi wa Sarki Yehohiyakim hidima a lokacin rabuwar mulki, wanda aka fara ambatonsa a Irmiya 26:22."
        }
      ]
    },
    "hin": {
      "preferred_label": "एलनातान (यिर्मयाह 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एलनातान, अकबोर का पुत्र, विभाजित राज्य के समय राजा यहोयाकीम की सेवा करने वाला एक अधिकारी था, जिसका पहला उल्लेख यिर्मयाह 26:22 में मिलता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Elnatan (Yeremia 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elnatan bin Akhbor adalah seorang pembesar yang melayani Raja Yoyakim pada zaman kerajaan terpecah, pertama kali disebutkan dalam Yeremia 26:22."
        }
      ]
    },
    "por": {
      "preferred_label": "Elnatã (Jeremias 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elnatã, filho de Acbor, foi um oficial a serviço do rei Jeoaquim durante o período do reino dividido, mencionado pela primeira vez em Jeremias 26:22."
        }
      ]
    },
    "rus": {
      "preferred_label": "Елнафан (Иеремия 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Елнафан, сын Ахбора, был сановником на службе у царя Иоакима во времена разделенного царства; впервые упоминается в Иеремии 26:22."
        }
      ]
    },
    "swh": {
      "preferred_label": "Elnathani (Yeremia 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elnathani, mwana wa Akbori, alikuwa afisa aliyemtumikia Mfalme Yehoyakimu wakati wa ufalme uliogawanyika, anayetajwa kwa mara ya kwanza katika Yeremia 26:22."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Elnatan (Jeremia 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elnatan, pikinini man bilong Akbor, em i wanpela ofisa i bin mekim wok bilong King Jehoiakim long taim kingdom i bin bruh, na Baibel i stori pastaim long em long Jeremaia 26:22."
        }
      ]
    },
    "apd": {
      "preferred_label": "ألناثان (إرميا 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ألناثان، ابن عكبور، كان مسؤولاً خدم الملك يهوياقيم في زمن المملكة المنقسمة، ومذكور لأول مرة في إرميا 26: 22."
        }
      ]
    },
    "bis": {
      "preferred_label": "Elnatan (Jeremaea 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elnatan, boe blong Akboro, hem i wan ofisel we i givhan long King Jehoeakim long taem we kingdom i seraot, we Baebol i tokbaot hem fastaem long Jeremaea 26:22."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Elnatan (Jeremaia 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Elnatan, nwa Akboa, bụ onyeisi jere ozi n'okpuru Eze Jehoiakim n'oge alaeze kewara ekewa, nke a kpọtụrụ aha nke mbụ na Jeremaya 26:22."
        }
      ]
    },
    "nep": {
      "preferred_label": "एल्नातान (यर्मिया 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा राजा यहोयाकीमको सेवा गर्ने अक्बोरका छोरा एल्नातान एक अधिकारी थिए, जसको पहिलो उल्लेख यर्मिया २६:२२ मा पाइन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ên-na-than (Giê-rê-mi 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ên-na-than, con trai của Ạc-bồ, là một quan chức phục vụ Vua Giê-hô-gia-kim trong thời kỳ vương quốc phân chia, được nhắc đến lần đầu trong Giê-rê-mi 26:22."
        }
      ]
    },
    "zht": {
      "preferred_label": "以利拿單 (耶利米書 26:22)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以利拿單是亞革波的兒子，在王國分裂時期事奉約雅敬王為臣宰，首次記載於耶利米書26:22。"
        }
      ]
    }
  },
