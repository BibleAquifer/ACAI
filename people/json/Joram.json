  "localizations": {
    "eng": {
      "preferred_label": "Joram (Jehoram)",
      "alternate_labels": [
        "Jehoram"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jehoram",
          "article": "person:Joram",
          "description": "A king of Judah during the divided kingdom, son of Jehoshaphat and husband of Athaliah. He is listed in the family line of Jesus."
        }
      ]
    },
    "fra": {
      "preferred_label": "Joram (Jéhoram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi de Juda à l’époque du royaume divisé, fils de Josaphat et époux d’Athalie. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "spa": {
      "preferred_label": "Joram (Joram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey de Judá durante el reino dividido, hijo de Josafat y esposo de Atalía. Aparece en la genealogía de Jesús."
        }
      ]
    },
    "arb": {
      "preferred_label": "يورَام (يَهورَام)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك على يهوذا في عهد المملكة المنقسمة، وهو ابن يهوشافاط وزوج عثليا. ورد اسمه في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约兰 (约兰)",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期的一位犹大王，约沙法的儿子，亚他利雅的丈夫。他被列在耶稣的家谱中。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yoram (Yehoram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Yahuda a lokacin rarrabuwar masarauta, ɗan Yehoshafat kuma mijin Ataliya. An lissafa shi a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "योराम (यहोराम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राजतंत्र के दौरान यहूदा का एक राजा, यहोशापात का पुत्र और अतल्याह का पति। वह यीशु की वंशावली में सूचीबद्ध है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yoram (Yehoram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang raja Yehuda pada masa kerajaan terpecah, anak Yosafat dan suami Atalya. Ia terdaftar dalam silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Jorão (Jeorão)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rei de Judá durante o reino dividido, filho de Josafá e marido de Atalia. Está listado na linhagem genealógica de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иорам (Иорам)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь Иудеи в период разделенного царства, сын Иосафата и муж Афалии. Упомянут в родословии Иисуса."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yoramu (Yehoramu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Yuda wakati wa ufalme uliogawanyika, mwana wa Yehoshafati na mume wa Athalia. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Joram (Jehoram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela king bilong Juda long taim kantri i brukbruk, pikinini man bilong Jehosafat na man bilong Atalia. Nem bilong en i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "يورام (يهورام)",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك على يهوذا زمن المملكة المنقسمة، ولد يهوشافاط وراجل عثليا. مذكور في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Joram (Jehoram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong Juda long taem we kingdom i seraot, pikinini blong Jehosafat mo man blong Atalia. Nem blong hem i stap long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Joram (Jehoram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze Juda n'oge alaeze kewara ekewa, nwa Jehoshafat na di Atalaya. E depụtara ya n'usoro ọmụmụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "योराम (यहोराम)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा यहूदाका एक राजा, यहोशापातका छोरा र अतल्याहका पति। तिनको नाउँ येशूको वंशावलीमा सूचीकृत छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-ram (Giê-hô-ram)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vua của Giu-đa trong thời kỳ vương quốc phân chia, con trai của Giô-sa-phát và chồng của A-tha-li. Ông được liệt kê trong gia phả của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "約蘭 (約蘭)",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期的猶大王，約沙法的兒子，亞她利雅的丈夫。他被列於耶穌的家譜中。"
        }
      ]
    }
  },
