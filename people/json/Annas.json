  "localizations": {
    "eng": {
      "preferred_label": "Annas",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Annas",
          "article": "person:Annas",
          "description": "A Jewish high priest during the New Testament period. He was the father-in-law of Caiaphas, who was the high priest during the trial of Jesus."
        }
      ]
    },
    "fra": {
      "preferred_label": "Anne",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grand prêtre juif de l'époque du Nouveau Testament. Il était le beau-père de Caïphe, qui était grand prêtre lors du procès de Jésus."
        }
      ]
    },
    "spa": {
      "preferred_label": "Anás",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sumo sacerdote judío durante la época del Nuevo Testamento. Fue suegro de Caifás, quien era el sumo sacerdote durante el juicio de Jesús."
        }
      ]
    },
    "arb": {
      "preferred_label": "حَنَّان",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيس كهنة يهودي في عصر العهد الجديد، وهو حمو قيافا الذي كان رئيس الكهنة أثناء محاكمة يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚那",
      "descriptions": [
        {
          "source": "acai",
          "description": "新约时期的犹太大祭司。他是该亚法的岳父，该亚法是在耶稣受审期间担任大祭司。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Annas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban firist na Yahudawa a zamanin Sabon Alkawari. Shi ne surukin Kayifas, wanda shi ne babban firist a lokacin shari’ar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "हन्ना",
      "descriptions": [
        {
          "source": "acai",
          "description": "नए नियम के काल का एक यहूदी महायाजक। वह कैफा का ससुर था, जो यीशु के मुकदमे के समय महायाजक था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Hanas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang Imam Besar Yahudi pada zaman Perjanjian Baru. Ia adalah mertua Kayafas, yang menjabat sebagai Imam Besar selama pengadilan Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Anás",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um sumo sacerdote judeu durante o período do Novo Testamento. Ele era sogro de Caifás, que era o sumo sacerdote durante o julgamento de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Анна",
      "descriptions": [
        {
          "source": "acai",
          "description": "Иудейский первосвященник времен Нового Завета. Тесть Каиафы, бывшего первосвященником во время суда над Иисусом."
        }
      ]
    },
    "swh": {
      "preferred_label": "Anasi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kuhani mkuu wa Kiyahudi wakati wa Agano Jipya. Alikuwa mkwewe Kayafa, aliyekuwa kuhani mkuu wakati wa kesi ya Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Anas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hetpris bilong lain Juda long taim bilong Nupela Testamen. Em i tambu man bilong Kaiafas, em man i bin i stap hetpris long taim ol i kotim Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "حنان",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيس كهنة يهودي في زمن العهد الجديد. كان حما قيافا، الكان رئيس الكهنة وكت محاكمة يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Anas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man Jiu we i hae pris long taem blong Niutesteman. Hem i papa blong woman blong Kaeafas, we hem i hae pris long taem we oli jajem Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Anas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyeisi nchụaja ndị Juu nʼoge Agba Ọhụrụ. Ọ bụ nna di Kaịfas, onye bụ onyeisi nchụaja nʼoge ikpe Jizọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "हन्‍नास",
      "descriptions": [
        {
          "source": "acai",
          "description": "नयाँ नियमको अवधिमा एक यहूदी प्रधान पूजाहारी। तिनी कैयाफाका ससुरा थिए, जो येशूको न्यायको समयमा प्रधान पूजाहारी थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "An-ne",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thầy thượng tế Do Thái trong thời Tân Ước. Ông là cha vợ của Cai-phe, người giữ chức thượng tế trong phiên xét xử Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞那",
      "descriptions": [
        {
          "source": "acai",
          "description": "新約時期的一位猶太人大祭司。他是該亞法的岳父，該亞法是在耶穌受審時的大祭司。"
        }
      ]
    }
  },
