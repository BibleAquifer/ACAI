  "localizations": {
    "eng": {
      "preferred_label": "Ezekiel",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ezekiel",
          "article": "person:Ezekiel",
          "description": "Ezekiel was a priest and prophet, son of Buzi, who lived during the time of exile and return, first mentioned in Ezekiel 1:3."
        }
      ]
    },
    "fra": {
      "preferred_label": "Ézéchiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ézéchiel était un prêtre et prophète, fils de Buzi, qui vivait à l’époque de l’exil et du retour, mentionné pour la première fois dans Ézéchiel 1:3."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ezequiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ezequiel fue un sacerdote y profeta, hijo de Buzi, que vivió durante la época del exilio y el regreso, mencionado por primera vez en Ezequiel 1:3."
        }
      ]
    },
    "arb": {
      "preferred_label": "حِزْقِيَال",
      "descriptions": [
        {
          "source": "acai",
          "description": "حزقيال كان كاهنًا ونبيًّا، وهو ابن بوزي، عاش في زمن السبي والرجوع، وذُكر أول مرة في حزقيال 1: 3."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以西结",
      "descriptions": [
        {
          "source": "acai",
          "description": "以西结是一位祭司和先知，布西的儿子，生活在被掳与回归时期，最早记载于以西结书1:3。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ezekiyel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ezekiyel firist ne kuma annabi, ɗan Buzi, wanda ya rayu a lokacin zaman bauta da dawowa, wanda aka fara ambatonsa a Ezekiyel 1:3."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहेजकेल",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहेजकेल एक याजक और नबी था, जो बूजी का पुत्र था और बँधुआई तथा वापसी के समय में जीवित था; उसका पहला उल्लेख यहेजकेल 1:3 में मिलता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yehezkiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Yehezkiel adalah seorang imam dan nabi, putra Busi, yang hidup pada masa pembuangan dan pemulangan, pertama kali disebutkan dalam Yehezkiel 1:3."
        }
      ]
    },
    "por": {
      "preferred_label": "Ezequiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ezequiel foi um sacerdote e profeta, filho de Buzi, que viveu durante o período do exílio e retorno, mencionado pela primeira vez em Ezequiel 1:3."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иезекииль",
      "descriptions": [
        {
          "source": "acai",
          "description": "Иезекииль был священником и пророком, сыном Вузия, жившим во времена пленения и возвращения; впервые упомянут в Иезекииля 1:3."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ezekieli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ezekieli alikuwa kuhani na nabii, mwana wa Buzi, aliyeishi wakati wa uhamisho na kurudi, anayetajwa mara ya kwanza katika Ezekieli 1:3."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Esekiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esekiel em i wanpela pris na profet, pikinini man bilong Busi, em i bin stap long taim bilong i go kalabus na i kam bek, na Baibel i kolim nem bilong en pastaim long Esekiel 1:3."
        }
      ]
    },
    "apd": {
      "preferred_label": "حزقيال",
      "descriptions": [
        {
          "source": "acai",
          "description": "حزقيال كان كاهن ونبي، ولد بوزي، عاش في زمن السبي والرجوع، وأول ذكر ليه في حزقيال 1: 3."
        }
      ]
    },
    "bis": {
      "preferred_label": "Esikiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esikiel hem i wan pris mo profet, pikinini boe blong Busi, we i laef long taem blong kalabus mo taem blong gobak, mo Buk blong Esikiel 1:3 i fas tokbaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Izikiel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Izikiel bụ onye nchụaja na onye amụma, nwa Buzi, onye biri nʼoge a dọtara nʼagha na nloghachi, onye mbụ a kpọtụrụ aha nʼIzikiel 1:3."
        }
      ]
    },
    "nep": {
      "preferred_label": "इजकिएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "इजकिएल एक पूजाहारी तथा अगमवक्ता र बूजीका छोरा थिए, जो निर्वासन र फिर्तीको समयमा बाँचेका थिए र जसको पहिलो उल्लेख इजकिएल १:३ मा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-xê-chi-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ê-xê-chi-ên là một thầy tế lễ và nhà tiên tri, con trai của Bu-xi, sống vào thời kỳ lưu đày và hồi hương, lần đầu tiên được nhắc đến trong Ê-xê-chi-ên 1:3."
        }
      ]
    },
    "zht": {
      "preferred_label": "以西結",
      "descriptions": [
        {
          "source": "acai",
          "description": "以西結是一位祭司和先知，布西的兒子，生活在被擄與回歸時期，首次記載於以西結書1:3。"
        }
      ]
    }
  },
