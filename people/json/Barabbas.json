  "localizations": {
    "eng": {
      "preferred_label": "Barabbas",
      "alternate_labels": [
        "Jesus"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Barabbas",
          "article": "person:Barabbas",
          "description": "A rebel and murderer living during the time of the New Testament. He was released from prison in place of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَارَابَاس",
      "descriptions": [
        {
          "source": "acai",
          "description": "متمرد وقاتل عاش في زمن العهد الجديد. أُطلق سراحه من السجن عوضاً عن يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "巴拉巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在新约时代的一个叛乱分子和杀人犯。他代替耶稣从监狱中被释放。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Barabbas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un rebelle et meurtrier vivant à l'époque du Nouveau Testament. Il fut libéré de prison à la place de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Barabbas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani ɗan tawaye kuma mai kisankai da ya rayu a lokacin Sabon Alkawari. An sake shi daga kurkuku a madadin Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "बरअब्बा",
      "descriptions": [
        {
          "source": "acai",
          "description": "नए नियम के समय का एक विद्रोही और हत्यारा। उसे यीशु के स्थान पर बन्दीगृह से छोड़ा गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Barabas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pemberontak dan pembunuh yang hidup pada zaman Perjanjian Baru. Ia dibebaskan dari penjara sebagai ganti Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Barrabás",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um rebelde e assassino que viveu na época do Novo Testamento. Ele foi solto da prisão no lugar de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Варавва",
      "descriptions": [
        {
          "source": "acai",
          "description": "Мятежник и убийца, живший во времена Нового Завета. Был освобождён из тюрьмы вместо Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Barrabás",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rebelde y homicida que vivió durante los tiempos del Nuevo Testamento. Fue liberado de la prisión en lugar de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Baraba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwasi na mwuaji aliyeishi wakati wa Agano Jipya. Alifunguliwa kutoka gerezani badala ya Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Barabas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong bikhet na kilim man i dai em i bin stap long taim bilong Nupela Testamen. Ol i bin lusim em long kalabus na senisim Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "باراباس",
      "descriptions": [
        {
          "source": "acai",
          "description": "متمرد وقاتل عاش في زمن العهد الجديد. أطلقوا سراحه من السجن بدل يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Barabas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man blong girap agens long gavman mo man blong kilim man i ded we i laef long taem blong Niutesteman. Oli bin letem hem i go fri aot long kalabus long ples blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Barabas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye nnupụisi na onye ogbu mmadụ biri nʼoge Ọgbụgba Ndụ Ọhụrụ. A tọhapụrụ ya nʼụlọ mkpọrọ nʼọnọdụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "बारब्बा",
      "descriptions": [
        {
          "source": "acai",
          "description": "नयाँ करारको समयमा जीवित रहेका एक विद्रोही र हत्यारा। उनी येशूको सट्टामा झ्यालखानाबाट रिहा गरिएका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ba-ra-ba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một kẻ phiến loạn và giết người sống vào thời Tân Ước. Người này được phóng thích khỏi tù thay cho Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "巴拉巴",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在新約時期的叛亂者和殺人犯。他獲釋代替了耶穌。"
        }
      ]
    }
  },
