        }
      ]
    },
    "fra": {
      "preferred_label": "Schimron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du patriarche Issacar. Il fut le fondateur du clan des Schimronites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shimron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan gaba-shugaba Issakar. Shi ne wanda ya kafa dangin Shimronawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "शिम्रोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता इस्साकार का एक पुत्र। वह शिम्रोनियों के कुल का संस्थापक था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Simron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang putra dari bapa leluhur Isakhar. Ia adalah pendiri kaum orang Simron."
        }
      ]
    },
    "por": {
      "preferred_label": "Sinrom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho do patriarca Issacar. Ele foi o fundador do clã dos sinromitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Шимрон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын патриарха Иссахара. Он был родоначальником клана шимронитов."
        }
      ]
    },
    "spa": {
      "preferred_label": "Simrón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un hijo del patriarca Isacar. Fue fundador del clan de los simronitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Shimroni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa mzee wa ukoo Isakari. Alikuwa mwanzilishi wa ukoo wa Washimroni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Simron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong hetman Isakar. Em i tumbuna bilong lain Simron."
        }
      ]
    },
    "apd": {
      "preferred_label": "شمرون",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد من أولاد رئيس الآباء يساكر. كان مؤسس عشيرة الشمرونيين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Simron",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan boe blong patriaka ya Isakara. Hem nao i stamba blong laen blong ol man Simron."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Shịmrọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke nke nna ochie bụ Isaka. Ọ bụ onye guzobere ikwu ndị Shịmrọn."
        }
      ]
    },
    "nep": {
      "preferred_label": "शिम्रोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता इस्साखारका एक छोरा। उनी शिम्रनीहरूको कुलका संस्थापक थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sim-rôn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con trai của tổ phụ Y-sa-ca. Ông là người sáng lập thị tộc người Sim-rôn."
        }
      ]
    },
    "zht": {
      "preferred_label": "伸崙",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長以薩迦的兒子。他是伸崙族人的始祖。"
        }
      ]
    }
