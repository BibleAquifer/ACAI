  "localizations": {
    "eng": {
      "preferred_label": "Jehizkiah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jehizkiah",
          "article": "person:Jehizkiah",
          "description": "A chief from the tribe of Ephraim, son of Shallum, living during the time of King Ahaz and mentioned in 2 Chronicles 28:12."
        }
      ]
    },
    "fra": {
      "preferred_label": "Ézéchias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chef de la tribu d’Éphraïm, fils de Schallum, qui vivait à l’époque du roi Achaz et mentionné en 2 Chroniques 28.12."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ezequías",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jefe de la tribu de Efraín, hijo de Salum, que vivió durante la época del rey Acaz y es mencionado en 2 Crónicas 28:12."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَحَزْقِيَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "رئيسٌ من سبط أفرايم، ابن شلوم، عاش في عهد الملك آحاز وذُكر في أخبار الأيام الثاني 28: 12."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耶希西迦",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法莲支派的一位首领，沙龙的儿子，生活在亚哈斯王时期，见于历代志下28:12。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Hezekiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani shugaba daga kabilar Efraim, ɗan Shallum, da ya rayu a lokacin Sarki Ahaz kuma aka ambata a 2 Labarbaru 28:12."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहिजकिय्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "एप्रैम के गोत्र का एक मुख्य पुरुष और शल्लूम का पुत्र, जो राजा आहाज के समय जीवित था और जिसका उल्लेख 2 इतिहास 28:12 में हुआ है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yehizkia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pemimpin dari suku Efraim, putra Salum, yang hidup pada zaman Raja Ahas dan disebutkan dalam 2 Tawarikh 28:12."
        }
      ]
    },
    "por": {
      "preferred_label": "Jeizquias",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um líder da tribo de Efraim, filho de Salum, que viveu durante a época do rei Acaz e é mencionado em 2 Crônicas 28:12."
        }
      ]
    },
    "rus": {
      "preferred_label": "Езекия",
      "descriptions": [
        {
          "source": "acai",
          "description": "Начальник из колена Ефремова, сын Шаллума, живший во времена царя Ахаза и упомянутый во 2 Паралипоменон 28:12."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yehizkia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kiongozi kutoka kabila la Efraimu, mwana wa Shalumu, aliyeishi wakati wa Mfalme Ahazi na anayetajwa katika 2 Mambo ya Nyakati 28:12."
        }
      ]
    },
    "apd": {
      "preferred_label": "يحزقيا",
      "descriptions": [
        {
          "source": "acai",
          "description": "قائد من سبط أفرايم، ابن شلوم، عاش في وكت الملك آحاز ومذكور في أخبار الأيام الثاني 28: 12."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jehisekia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan lida blong laen blong Efraem, pikinini boe blong Salum, we i laef long taem blong King Ahas mo 2 Kronikel 28:12 i tokbaot hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jehizkaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyeisi sitere nʼebo Ifrem, nwa Shalum, nke biri nʼoge Eze Ehaz ma bụrụ onye a kpọtụrụ aha nʼime 2 Ihe E Mere 28:12."
        }
      ]
    },
    "nep": {
      "preferred_label": "येहिजक्याह",
      "descriptions": [
        {
          "source": "acai",
          "description": "एफ्राइमको कुलका एक अगुवा, शल्लूमका छोरा, जो राजा आहाजको समयमा बाँचेका थिए र २ इतिहास २८:१२ मा उल्लेख गरिएका छन्।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jehiskia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela hetman bilong lain bilong Efraim, pikinini man bilong Salum, i bin stap long taim bilong King Ahas na Baibel i kolim long 2 Stori 28:12."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-xê-chia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vị thủ lĩnh thuộc bộ tộc Ép-ra-im, con trai của Sa-lum, sống vào thời Vua A-cha và được đề cập trong 2 Sử ký 28:12."
        }
      ]
    },
    "zht": {
      "preferred_label": "耶希西家",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法蓮支派的一位族長，沙龍的兒子，生活在亞哈斯王時期，提及於歷代志下28:12。"
        }
      ]
    }
  },
