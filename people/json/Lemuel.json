    "bis": {
      "preferred_label": "Lemuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king we ol waes tok blong hem i stap long Ol Proveb, we i bin laef long taem blong wan neson blong Isrel bifo kingdom i seraot."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Lemuel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu eze nke e tinyere ilu ya nʼakwụkwọ Ilu, onye biri nʼoge alaeze Izrel jikọrọ ọnụ."
        }
      ]
    },
