  "localizations": {
    "eng": {
      "preferred_label": "Cyrus",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Cyrus",
          "article": "person:Cyrus",
          "description": "The emperor of Persia who allowed the Israelite exiles from Judah to return to their land."
        }
      ]
    },
    "arb": {
      "preferred_label": "كورَش",
      "descriptions": [
        {
          "source": "acai",
          "description": "إمبراطور فارس الذي سمح للمنفيين من بني إسرائيل من يهوذا بالعودة إلى أرضهم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "塞鲁士",
      "descriptions": [
        {
          "source": "acai",
          "description": "准许被流放的犹大以色列人回归本乡的波斯帝国皇帝。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Cyrus",
      "descriptions": [
        {
          "source": "acai",
          "description": "L'empereur de Perse qui a permis aux exilés israélites de Juda de retourner dans leur pays."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sairus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin sarakunan Farisa wanda ya yarda wa ’yan gudun hijira na Isra’ila daga Yahuda su koma ƙasarsu."
        }
      ]
    },
    "hin": {
      "preferred_label": "कुस्रू",
      "descriptions": [
        {
          "source": "acai",
          "description": "फारस का सम्राट जिसने यहूदा के इस्राएली निर्वासितों को अपने देश लौटने की अनुमति दी थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Koresh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kaisar Persia yang mengizinkan orang-orang buangan Israel dari Yehuda untuk kembali ke tanah air mereka."
        }
      ]
    },
    "por": {
      "preferred_label": "Ciro",
      "descriptions": [
        {
          "source": "acai",
          "description": "O imperador da Pérsia que permitiu que os exilados israelitas de Judá retornassem à sua terra."
        }
      ]
    },
    "rus": {
      "preferred_label": "Кир",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь Персии, позволивший иудейским изгнанникам вернуться на родину."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ciro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Emperador de Persia que permitió a los exiliados israelitas de Judá regresar a su tierra."
        }
      ]
    },
    "swh": {
      "preferred_label": "Koreshi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme mkuu wa Uajemi aliyewaruhusu wahamishwa Waisraeli kutoka Yuda kurudi katika nchi yao."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sairus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Emperer bilong Persia em i bin larim ol kalabusman bilong Juda long go bek long graun bilong ol."
        }
      ]
    },
    "apd": {
      "preferred_label": "كورش",
      "descriptions": [
        {
          "source": "acai",
          "description": "إمبراطور فارس السمح لِلمسبيين الإسرائيليين من يهوذا يرجعوا لِبلدهم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sirus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hae king blong Pesia we i letem ol man Isrel we oli stap kalabus long Juda blong oli gobak long graon blong olgeta."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sairọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze ukwu Peshịa nke kwere ka ndị dọrọ nʼagha ndị Izrel si na Juda laghachi nʼala ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "कोरेस",
      "descriptions": [
        {
          "source": "acai",
          "description": "फारसका सम्राट जसले यहूदाबाट निर्वासित भएका इस्राएलीहरूलाई आफ्नो देश फर्कन अनुमति दिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Si-ru",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hoàng đế Ba Tư đã cho phép những người Y-sơ-ra-ên lưu đày từ Giu-đa được trở về xứ của họ."
        }
      ]
    },
    "zht": {
      "preferred_label": "塞魯士",
      "descriptions": [
        {
          "source": "acai",
          "description": "波斯帝國的統治者，他准許流亡的猶大以色列人返回故土。"
        }
      ]
    }
  },
