  "localizations": {
    "eng": {
      "preferred_label": "Azariah (Friend of Daniel)",
      "alternate_labels": [
        "Abed-Nego"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Azariah (Friend of Daniel)",
          "article": "person:Azariah.20",
          "description": "One of Daniel’s three friends who was thrown into a fiery furnace by the Babylonian king Nebuchadnezzar. An angel sent from God protected the three friends and they did not die."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَزَرْيَا (صديق دانيال)",
      "descriptions": [
        {
          "source": "acai",
          "description": "أحد أصحاب دانيال الثلاثة الذين أُلقوا في أتون النار بأمر الملك البابلي نبوخذنصر. وقد حماهم ملاك أرسله الله فلم يموتوا."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚撒利雅（但以理的朋友）",
      "descriptions": [
        {
          "source": "acai",
          "description": "但以理的三个朋友之一，曾被巴比伦王尼布甲尼撒扔进烈火的窑中。上帝差遣使者保护了这三人，他们并未丧命。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Azaria (ami de Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "L'un des trois compagnons de Daniel qui fut jeté dans une fournaise ardente par le roi babylonien Nebucadnetsar. Un ange envoyé par Dieu protégea les trois compagnons et ils ne moururent point."
        }
      ]
    },
    "hau": {
      "preferred_label": "Azariya (Abokin Daniyel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗaya daga cikin abokan Daniyel uku da sarkin Babila Nebukadnezzar ya jefa a cikin tanderun wuta. Wani mala’ika da Allah ya aiko ya kāre abokan nan uku ba su mutu ba."
        }
      ]
    },
    "hin": {
      "preferred_label": "अजर्याह (दानिय्येल का मित्र)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दानिय्येल के तीन मित्रों में से एक, जिसे बाबेल के राजा नबूकदनेस्सर द्वारा आग के धधकते भट्ठे में फेंका गया था। परमेश्वर द्वारा भेजे गए एक स्वर्गदूत ने इन तीनों मित्रों की रक्षा की और वे नहीं मरे।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Azarya (Sahabat Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Salah satu dari tiga sahabat Daniel yang dilemparkan ke dalam perapian yang menyala-nyala oleh raja Babel, Nebukadnezar. Seorang malaikat yang diutus oleh Allah melindungi ketiga sahabat itu dan mereka tidak mati."
        }
      ]
    },
    "por": {
      "preferred_label": "Azarias (amigo de Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um dos três amigos de Daniel que foi lançado numa fornalha ardente pelo rei babilônio Nabucodonosor. Um anjo enviado por Deus protegeu os três amigos, e eles não morreram."
        }
      ]
    },
    "rus": {
      "preferred_label": "Азария (друг Даниила)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Один из трех друзей Даниила, брошенный в раскаленную печь вавилонским царем Навуходоносором. Ангел, посланный Богом, защитил трех друзей, и они не погибли."
        }
      ]
    },
    "spa": {
      "preferred_label": "Azarías (amigo de Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uno de los tres amigos de Daniel que fue arrojado a un horno ardiente por el rey babilónico Nabucodonosor. Un ángel enviado por Dios protegió a los tres amigos y no murieron."
        }
      ]
    },
    "swh": {
      "preferred_label": "Azaria (Rafiki ya Danieli)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mmoja wa marafiki watatu wa Danieli aliyetupwa kwenye tanuru ya moto na Mfalme Nebukadreza wa Babeli. Malaika aliyetumwa na Mungu aliwalinda wale marafiki watatu nao hawakufa."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Asaria (Pren bilong Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bilong tripela pren bilong Daniel em Nebukatnesar, king bilong Babilon, i bin tromoi ol i go insait long bikpela paia. Wanpela ensel God i salim i bin lukautim tripela pren na ol i no dai."
        }
      ]
    },
    "apd": {
      "preferred_label": "عزريا (صاحب دانيال)",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحد من أصحاب دانيال التلاتة اللي رماهم نبوخذنصر ملك بابل في أتون النار. وملاك مرسل من الله حما الأصحاب التلاتة وما ماتوا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Asaria (Fren blong Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan long trifala fren blong Daniel we King Nebukadnesar blong Babilonia i sakem trifala i go long bigfala faea. Wan enjel we God i sanem i protektem trifala fren ya mo trifala i no ded."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Azaraya (Enyi Daniel)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu nʼime ndị enyi atọ Daniel nwere nke eze Babilọn bụ Nebukadneza tụbara nʼime oké ọkụ dị ọkụ. Otu mmụọ ozi sitere na Chineke chebere ndị enyi atọ ahụ ma ha anwụghị."
        }
      ]
    },
    "nep": {
      "preferred_label": "अजर्याह (दानिएलका साथी)",
      "descriptions": [
        {
          "source": "acai",
          "description": "दानिएलका तीन साथीहरूमध्ये एक, जसलाई बेबिलोनी राजा नबूकदनेसरले दन्किरहेको आगोको भट्टीमा फ्याँकिदिएका थिए। परमेश्वरले पठाउनुभएको स्वर्गदूतले ती तीन साथीहरूको रक्षा गर्नुभयो र तिनीहरू मरेनन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-xa-ria (Bạn của Đa-ni-ên)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một trong ba người bạn của Đa-ni-ên bị vua Ba-by-lôn Nê-bu-cát-nê-xa quăng vào lò lửa hừng. Một thiên sứ do Đức Chúa Trời sai đến đã bảo vệ ba người bạn và họ không chết."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞撒利雅（但以理的朋友）",
      "descriptions": [
        {
          "source": "acai",
          "description": "但以理的三個朋友之一，被巴比倫王尼布甲尼撒扔進烈火的窯中。神差遣天使保護了這三個朋友，他們沒有死。"
        }
      ]
    }
  },
