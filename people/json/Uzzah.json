      "descriptions": [
        {
          "source": "acai",
          "gloss": "Uzzah",
          "article": "person:Uzzah",
          "description": "The son of Abinadab from Kiriath-Jearim known for being killed by God for touching the ark of the covenant."
        }
      ]
    },
    "arb": {
      "preferred_label": "عُزَّة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن أبيناداب من قرية يعاريم، عُرف بموته بضربة من الله لأنه لمس تابوت العهد."
        }
      ]
    },
    "zhs": {
      "preferred_label": "乌撒",
      "descriptions": [
        {
          "source": "acai",
          "description": "基列·耶琳人亚比拿达的儿子，因触碰约柜而被上帝击杀。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Uzza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils d'Abinadab de Kirjath-Jearim, connu pour avoir été frappé à mort par Dieu pour avoir touché l'arche de l'alliance."
        }
      ]
    },
    "hau": {
      "preferred_label": "Uzza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Abinadab daga Kiriye-yeyarim wanda aka sani da cewa Allah ya kashe shi saboda ya taɓa akwatin alkawari."
        }
      ]
    },
    "hin": {
      "preferred_label": "उज्जा",
      "descriptions": [
        {
          "source": "acai",
          "description": "किर्यत-यारीम के अबीनादाब का पुत्र, जो वाचा के सन्दूक को छूने के कारण परमेश्वर द्वारा मारे जाने के लिए जाना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Uza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak laki-laki Abinadab dari Kiryat-Yearim yang dikenal karena dihukum mati oleh Allah karena menyentuh tabut perjanjian."
        }
      ]
    },
    "por": {
      "preferred_label": "Uzá",
      "descriptions": [
        {
          "source": "acai",
          "description": "O filho de Abinadabe, de Quiriate-Jearim, conhecido por ter sido morto por Deus por tocar na arca da aliança."
        }
      ]
    },
    "rus": {
      "preferred_label": "Оза",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Авинадава из Кириаф-Иарима, известный тем, что был поражен Богом насмерть за прикосновение к ковчегу завета."
        }
      ]
    },
    "spa": {
      "preferred_label": "Uza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Abinadab de Quiriat-jearim, conocido por haber muerto a manos de Dios por tocar el arca del pacto."
        }
      ]
    },
    "swh": {
      "preferred_label": "Uza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Abinadabu kutoka Kiriath-yearimu anayejulikana kwa kuuawa na Mungu kwa kuligusa sanduku la agano."
        }
      ]
    },
    "apd": {
      "preferred_label": "عُزّة",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد أبيناداب من قرية يعاريم، المعروف بإنه الله موّته عشانه لمس تابوت العهد."
        }
      ]
    },
    "bis": {
      "preferred_label": "Usaha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Abinadab we i kamaot long Kiriat-jearim we God i kilim hem i ded from we hem i tajem bokis blong kontrak."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ụza",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Abinadab si Kiriath-Jiarim nke a maara maka Chineke igbu ya nʼihi imetụ igbe ọgbụgba ndụ ahụ aka."
        }
      ]
    },
    "nep": {
      "preferred_label": "उज्जाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "किर्यत-यारीमका अबीनादाबका छोरा, जो करारको सन्दुक छोएको कारण परमेश्वरद्वारा मारिएका थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Usa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Abinadap bilong Kiriati-Jearim em ol i save long em long wanem God i kilim em i dai long em i bin tatsim bokis kontrak."
        }
      ]
    },
    "vie": {
      "preferred_label": "U-xa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của A-bi-na-đáp từ Ki-ri-át Giê-a-rim, được biết đến vì bị Đức Chúa Trời đánh chết do chạm vào Hòm Giao Ước."
        }
      ]
    },
    "zht": {
      "preferred_label": "烏撒",
      "descriptions": [
        {
          "source": "acai",
          "description": "基列·耶琳人亞比拿達的兒子，因用手扶約櫃而被上帝擊殺。"
        }
      ]
    }
