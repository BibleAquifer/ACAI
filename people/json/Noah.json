  ],
  "tribe": "group:Earlypatriarchs",
  "localizations": {
    "eng": {
      "preferred_label": "Noah",
      "alternate_labels": [
        "Noe",
        "his"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Noah",
          "article": "person:Noah",
          "description": "Patriarch and father of Shem, Ham, and Japheth with whom God made a covenant and chose his family to repopulate the Earth after the Flood."
        }
      ]
    },
    "arb": {
      "preferred_label": "نُوح",
      "descriptions": [
        {
          "source": "acai",
          "description": "أَبُ ٱلْآبَاءِ وَأَبُو سَامٍ وَحَامٍ وَيَافَثَ، قَطَعَ ٱللهُ مَعَهُ عَهْدًا وَٱخْتَارَ عَائِلَتَهُ لِإِعَادَةِ عِمَارَةِ ٱلْأَرْضِ بَعْدَ ٱلطُّوفَانِ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "挪亚",
      "descriptions": [
        {
          "source": "acai",
          "description": "先祖，闪、含和雅弗的父亲；上帝与他立约，并拣选他的家庭在洪水之后使全地重新繁衍人口。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Nuhu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uban iyali kuma mahaifin Shem, Ham, da Yafet, wanda Allah ya yi alkawari da shi, ya kuma zaɓi iyalinsa su sāke cika duniya bayan Rigyawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "नूह",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता तथा शेम, हाम और येपेत का पिता, जिसके साथ परमेश्वर ने वाचा बांधी और जलप्रलय के बाद पृथ्वी को फिर से बसाने के लिए उसके घराने को चुना।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Nuh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Patriark dan ayah dari Sem, Ham, dan Yafet, yang dengannya Allah mengadakan perjanjian dan memilih keluarganya untuk mendiami kembali bumi setelah Air Bah."
        }
      ]
    },
    "por": {
      "preferred_label": "Noé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Patriarca e pai de Sem, Cam e Jafé com quem Deus fez uma aliança e escolheu sua família para repovoar a Terra após o Dilúvio."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ной",
      "descriptions": [
        {
          "source": "acai",
          "description": "Патриарх и отец Сима, Хама и Иафета, с которым Бог заключил завет и чью семью избрал, чтобы вновь населить Землю после потопа."
        }
      ]
    },
    "spa": {
      "preferred_label": "Noé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Patriarca y padre de Sem, Cam y Jafet, con quien Dios hizo un pacto y cuya familia eligió para repoblar la Tierra después del diluvio."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nuhu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mzee wa ukoo na baba yao Shemu, Hamu, na Yafethi ambaye Mungu alifanya naye agano na kuchagua familia yake ili kuijaza tena dunia baada ya Gharika."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Noa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela bikpela tumbuna papa na papa bilong Siem, Ham, na Jafet. God i bin mekim wanpela kontrak wantaim em na makim famili bilong em long pulapim graun gen bihain long Bikpela Tait."
        }
      ]
    },
    "apd": {
      "preferred_label": "نوح",
      "descriptions": [
        {
          "source": "acai",
          "description": "أب الآباء وأبو سام وحام ويافث، الله قطع معاه عهد واختار عيلته عشان تعمّر الأرض تاني بعد الطوفان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Noa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Patriak mo papa blong Sem, Kam, mo Jafet, we God i bin mekem wan kavenan wetem hem mo i bin jusumaot famle blong hem blong mekem wol i fulap bakegen wetem ol man afta long Bigfala Wota."
        }
      ]
    },
    "fra": {
      "preferred_label": "Noé",
      "descriptions": [
        {
          "source": "acai",
          "description": "Patriarche et père de Sem, Cham et Japhet, avec qui Dieu fit alliance et dont il choisit la famille pour repeupler la terre après le Déluge."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Noa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyeisi ezinụlọ na nna Shem, Ham, na Jafet, onye Chineke na ya gbara ndụ ma họrọ ezinaụlọ ya ka ha mụbaa nʼụwa ọzọ mgbe Iju Mmiri gasịrị."
        }
      ]
    },
    "nep": {
      "preferred_label": "नोआ",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक धर्मपिता र शेम, हाम र येपेतका बुबा, जससँग परमेश्‍वरले करार बाँध्नुभयो र जलप्रलयपछि पृथ्वीलाई फेरि मानिसहरूले भर्नको लागि उहाँले तिनको परिवारलाई रोज्नुभयो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Nô-ê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tổ phụ và là cha của Sem, Cham và Gia-phết, người mà Đức Chúa Trời đã lập giao ước và chọn gia đình ông để làm cho loài người đông đúc trở lại trên đất sau trận Nước Lụt."
        }
      ]
    },
    "zht": {
      "preferred_label": "挪亞",
      "descriptions": [
        {
          "source": "acai",
          "description": "挪亞是族長，也是閃、含和雅弗的父親；上帝與他立約，並揀選他的家族在洪水之後使大地重新繁衍人口。"
        }
      ]
    }
  },
