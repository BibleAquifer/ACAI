  "localizations": {
    "eng": {
      "preferred_label": "Felix",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Felix",
          "article": "person:Felix",
          "description": "A governor of Judaea and husband of Drusilla, who conducted a trial of the apostle Paul and kept him under house arrest at Caesarea."
        }
      ]
    },
    "fra": {
      "preferred_label": "Félix",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gouverneur de Judée et époux de Drusille, qui instruisit le procès de l’apôtre Paul et le maintint en résidence surveillée à Césarée."
        }
      ]
    },
    "spa": {
      "preferred_label": "Félix",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gobernador de Judea y esposo de Drusila, quien dirigió el juicio del apóstol Pablo y lo mantuvo bajo arresto domiciliario en Cesarea."
        }
      ]
    },
    "arb": {
      "preferred_label": "فِيلِكْس",
      "descriptions": [
        {
          "source": "acai",
          "description": "والٍ على اليهودية وزوج دروسِّلَا، حاكم الرسول بولس وأبقاه قيد الإقامة الجبرية في قيصرية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "腓力斯",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹太行省的总督，土西拉的丈夫，曾审讯使徒保罗，并将他软禁在凯撒利亚。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Felis",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani gwamnan Yahudiya kuma mijin Durusilla, wanda ya gudanar da shari’ar manzo Bulus ya kuma tsare shi a Kaisariya."
        }
      ]
    },
    "hin": {
      "preferred_label": "फेलिक्स",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदिया का एक राज्यपाल और द्रुसिल्ला का पति, जिसने प्रेरित पौलुस का मुकदमा चलाया और उसे कैसरिया में नज़रबंद रखा।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Feliks",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang wali negeri Yudea dan suami dari Drusila, yang mengadili rasul Paulus dan menahannya di bawah tahanan rumah di Kaisarea."
        }
      ]
    },
    "por": {
      "preferred_label": "Félix",
      "descriptions": [
        {
          "source": "acai",
          "description": "Governador da Judeia e marido de Drusila, que realizou o julgamento do apóstolo Paulo e o manteve sob prisão domiciliar em Cesareia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Феликс",
      "descriptions": [
        {
          "source": "acai",
          "description": "Правитель Иудеи и муж Друзиллы, который вел суд над апостолом Павлом и держал его под домашним арестом в Кесарии."
        }
      ]
    },
    "swh": {
      "preferred_label": "Feliksi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Liwali wa Yudea na mume wa Drusila, aliyeendesha kesi ya mtume Paulo na kumweka chini ya ulinzi wa nyumbani huko Kaisaria."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Feliks",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela gavman bilong Judia na man bilong Drusila, em i bin harim kot bilong aposel Pol na mekim em i stap kalabus long haus long Sisaria."
        }
      ]
    },
    "apd": {
      "preferred_label": "فيليكس",
      "descriptions": [
        {
          "source": "acai",
          "description": "حاكم لليهودية وزوج دروسلا، حاكم الرسول بولس وحبسو تحت الإقامة الجبرية في قيصرية."
        }
      ]
    },
    "bis": {
      "preferred_label": "Filiks",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan hed gavman blong Judia mo hasban blong Drusila, we i jajem apositol Pol mo putum hem i stap long haos kalabus long Sisaria."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Feliks",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gọvanọ Judia na di Drusila, onye kpere ikpe nke Pọl onye ozi ma debe ya nʼụlọ mkpọrọ nʼobodo Sizaria."
        }
      ]
    },
    "nep": {
      "preferred_label": "फेलिक्स",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदियाका एक प्रान्तीय शासक (गभर्नर) र द्रुसिल्लाका पति, जसले प्रेरित पावलको पुर्पक्ष गरे र उनलाई कैसरियामा नजरबन्दमा राखे।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Phê-lít",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một quan tổng đốc xứ Giu-đê và là chồng của Đơ-ru-si-la, người đã xét xử sứ đồ Phao-lô và giam lỏng ông tại Sê-sa-rê."
        }
      ]
    },
    "zht": {
      "preferred_label": "腓力斯",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶太的巡撫，土西拉的丈夫，曾審訊使徒保羅，並將他軟禁在凱撒利亞。"
        }
      ]
    }
  },
