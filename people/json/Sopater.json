  "localizations": {
    "eng": {
      "preferred_label": "Sopater",
      "alternate_labels": [
        "Sosipater"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Sopater",
          "article": "person:Sopater",
          "description": "Sopater, also known as Sosipater, was a New Testament figure mentioned in Acts 20:4 and Romans 16:21, and was the son of Pyrrhus."
        }
      ]
    },
    "arb": {
      "preferred_label": "سوباترس",
      "descriptions": [
        {
          "source": "acai",
          "description": "سوباترس، المعروف أيضاً بسوسيباترس، هو شخصية في العهد الجديد ورد ذكره في أعمال الرسل 20: 4 ورومية 16: 21، وكان ابن بيرس."
        }
      ]
    },
    "zhs": {
      "preferred_label": "所巴特",
      "descriptions": [
        {
          "source": "acai",
          "description": "所巴特，又名所西巴德，是使徒行传20:4和罗马书16:21中提及的新约人物，是毕罗斯的儿子。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Sopater",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sopater, également connu sous le nom de Sosipater, était un personnage du Nouveau Testament mentionné dans Actes 20:4 et Romains 16:21, et était le fils de Pyrrhus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sofater",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sofater, wanda kuma aka sani da Sosifater, wani mutum ne a Sabon Alkawari da aka ambata a Ayyukan Manzanni 20:4 da Romawa 16:21, kuma ɗan Fairrus ne."
        }
      ]
    },
    "hin": {
      "preferred_label": "सोपत्रुस",
      "descriptions": [
        {
          "source": "acai",
          "description": "सोपत्रुस, जिसे सोसिपत्रुस भी कहा जाता है, नया नियम का एक व्यक्ति था जिसका उल्लेख प्रेरितों के काम 20:4 और रोमियों 16:21 में मिलता है, और वह पुरूर्स का पुत्र था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Sopater",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sopater, yang juga dikenal sebagai Sosipater, adalah seorang tokoh Perjanjian Baru yang disebutkan dalam Kisah Para Rasul 20:4 dan Roma 16:21, serta merupakan anak Pirus."
        }
      ]
    },
    "por": {
      "preferred_label": "Sópatro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sópatro, também conhecido como Sosípatro, foi uma figura do Novo Testamento mencionada em Atos 20:4 e Romanos 16:21, e era filho de Pirro."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сопатр",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сопатр, также известный как Сосипатр, был новозаветным деятелем, упомянутым в Деяниях 20:4 и Римлянам 16:21, и сыном Пирра."
        }
      ]
    },
    "spa": {
      "preferred_label": "Sópater",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sópater, también conocido como Sosípater, fue un personaje del Nuevo Testamento mencionado en Hechos 20:4 y Romanos 16:21, y era hijo de Pirro."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sopatro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sopatro, anayejulikana pia kama Sosipatro, alikuwa mtu wa Agano Jipya aliyetajwa katika Matendo 20:4 na Warumi 16:21, naye alikuwa mwana wa Piro."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sopater",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sopater, ol i save kolim tu Sosipater, em i wanpela man long Nupela Testamen em Buk Kamapim Tok Hait o Wok Pris i no kolim tasol Wok Bilong Ol Aposel 20:4 na Rom 16:21 i kolim, na em i pikinini man bilong Pirus."
        }
      ]
    },
    "apd": {
      "preferred_label": "سوباترس",
      "descriptions": [
        {
          "source": "acai",
          "description": "سوباترس، المعروف كمان باسم سوسيباترس، كان شخصية في العهد الجديد مذكور في أعمال الرسل 20: 4 ورومية 16: 21، وكان ولد بيرس."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sopata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sopata, we oli singaot hem tu se Sosipata, i wan man long Niutesteman we Ol Wok 20:4 mo Rom 16:21 i tokbaot hem, mo hem i pikinini man blong Piras."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Sopata",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sopata, nke a makwaara dịka Sosipata, bụ onye a kpọtụrụ aha nʼAgba Ọhụrụ nʼỌrụ Ndị Ozi 20:4 na Ndị Rom 16:21, ọ bụkwa nwa Pirọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "सोपात्रोस",
      "descriptions": [
        {
          "source": "acai",
          "description": "सोपात्रोस, जसलाई सोसिपात्रोस पनि भनिन्छ, नयाँ नियमका एक पात्र थिए जसको उल्लेख प्रेरित २०:४ र रोमी १६:२१ मा गरिएको छ, र उनी पुरोसका छोरा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sô-ba-tê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sô-ba-tê, còn gọi là Sô-xi-ba-tê, là một nhân vật Tân Ước được đề cập trong Công vụ 20:4 và Rô-ma 16:21, và là con trai của By-ru."
        }
      ]
    },
    "zht": {
      "preferred_label": "所巴特",
      "descriptions": [
        {
          "source": "acai",
          "description": "所巴特，又名所西巴德，是新約人物，記載於使徒行傳20:4及羅馬書16:21，是畢羅斯的兒子。"
        }
      ]
    }
  },
