  "localizations": {
    "eng": {
      "preferred_label": "Ahilud",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ahilud",
          "article": "person:Ahilud",
          "description": "An official (and perhaps a recorder) during the reign of King David. He was the father of Jehoshaphat."
        }
      ]
    },
    "fra": {
      "preferred_label": "Achilud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Haut fonctionnaire (et peut-être archiviste) sous le règne du roi David. Il était le père de Josaphat."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ahilud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un funcionario (y tal vez cronista) durante el reinado del rey David. Era el padre de Josafat."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَخِيلُود",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسؤول (وربما مسجل) في عهد الملك داود، وهو والد يهوشافاط."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚希律",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王统治时期的一位官员（可能曾任史官）。他是约沙法的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ahilud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani ma'aikaci (kuma mai yiwuwa marubucin tarihi) a lokacin mulkin Sarki Dawuda. Shi ne mahaifin Yehoshafat."
        }
      ]
    },
    "hin": {
      "preferred_label": "अहीलूद",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊद के शासनकाल के दौरान एक अधिकारी (और संभवतः एक इतिहास लेखक)। वह यहोशापात का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ahilud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pejabat (dan mungkin bendahara negara) pada masa pemerintahan Raja Daud. Ia adalah ayah Yosafat."
        }
      ]
    },
    "por": {
      "preferred_label": "Ailude",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um oficial (e talvez um cronista) durante o reinado do rei Davi. Ele era o pai de Josafá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ахилуд",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сановник (и, возможно, дееписатель) во время правления царя Давида. Отец Иосафата."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ahiludi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Afisa (na labda mweka kumbukumbu) wakati wa utawala wa Mfalme Daudi. Alikuwa baba yake Yehoshafati."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ahilut",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela ofisa (na ating man bilong raitim stori) long taim King Devit i stap king. Em i papa bilong Jehosafat."
        }
      ]
    },
    "apd": {
      "preferred_label": "أخيلود",
      "descriptions": [
        {
          "source": "acai",
          "description": "مسؤول (ويمكن مسجل) في فترة حكم الملك داود، وهو أبو يهوشافاط."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ahilud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan ofisel (mo maet wan man blong lukaot long ol ripot) long taem we King Deved i stap rula. Hem i papa blong Jehosafat."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ahilud",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye isi (ma eleghị anya onye odeakụkọ) nʼoge ọchịchị Eze Devid. Ọ bụ nna Jehoshafat."
        }
      ]
    },
    "nep": {
      "preferred_label": "अहीलूद",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊदको शासनकालका एक अधिकारी (र सम्भवतः एक लेखापाल)। तिनी यहोशापातका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-hi-lút",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một quan chức (và có lẽ là một quan ngự sử) dưới triều Vua Đa-vít. Ông là cha của Giê-hô-sa-phát."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞希律",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王統治時期的一名官員（可能也是史官）。他是約沙法的父親。"
        }
      ]
    }
  },
