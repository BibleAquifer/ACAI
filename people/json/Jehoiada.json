          "description": "Father of the military commander Benaiah, who served under the kings David and Solomon."
        }
      ]
    },
    "fra": {
      "preferred_label": "Jehojada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Père du chef militaire Benaja, qui servit sous les rois David et Salomon."
        }
      ]
    },
    "spa": {
      "preferred_label": "Joiada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Padre del comandante militar Benaías, quien sirvió bajo los reyes David y Salomón."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَهُويَادَاع",
      "descriptions": [
        {
          "source": "acai",
          "description": "والِدُ القائد العسكري بَنَايَا الذي خَدَمَ في عَهْدِ المَلِكَيْن داوُد وسُلَيْمان."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耶何耶大",
      "descriptions": [
        {
          "source": "acai",
          "description": "军长比拿雅的父亲，比拿雅曾在大卫王和所罗门王手下服役。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yehohiyada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahaifin kwamandan sojoji Benahiya, wanda ya yi aiki a ƙarƙashin sarakuna Dawuda da Sulemanu."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहोयादा",
      "descriptions": [
        {
          "source": "acai",
          "description": "सैन्य सेनापति बनायाह का पिता, जिसने राजा दाऊद और सुलैमान के अधीन सेवा की।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yoyada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ayah dari panglima militer Benaya, yang melayani di bawah raja Daud dan Salomo."
        }
      ]
    },
    "por": {
      "preferred_label": "Joiada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pai do comandante militar Benaia, que serviu sob os reis Davi e Salomão."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иодай",
      "descriptions": [
        {
          "source": "acai",
          "description": "Отец военачальника Ванеи, служившего при царях Давиде и Соломоне."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yehoyada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Baba wa jemadari wa jeshi Benaya, aliyetumikia chini ya wafalme Daudi na Sulemani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jehoiada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa bilong Benaia, em ofisa bilong ami husat i bin mekim wok aninit long King Devit na King Solomon."
        }
      ]
    },
    "apd": {
      "preferred_label": "يهوياداع",
      "descriptions": [
        {
          "source": "acai",
          "description": "أبو القائد العسكري بنايا، الِخدم تحت إمرة الملك داود والملك سليمان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jehoeada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Papa blong Benaea we i komanda blong ol soldia we i wok aninit long King Deved mo King Solomon."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jehoiada",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nna onyeisi ndị agha bụ Benaya, onye jere ozi n'okpuru eze Devid na eze Solomọn."
        }
      ]
    },
    "nep": {
      "preferred_label": "यहोयादा",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊद र सुलेमानको अधीनमा सेवा गर्ने सेनापति बनायाहका पिता।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giê-hô-gia-đa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cha của vị chỉ huy quân đội Bê-na-gia, người phục vụ dưới thời các vua Đa-vít và Sa-lô-môn."
        }
      ]
    },
    "zht": {
      "preferred_label": "耶何耶大",
      "descriptions": [
        {
          "source": "acai",
          "description": "軍事指揮官比拿雅的父親，比拿雅曾在重大衛王和所羅門王手下服事。"
        }
      ]
    }
  },
