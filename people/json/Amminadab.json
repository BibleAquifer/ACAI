  "localizations": {
    "eng": {
      "preferred_label": "Amminadab",
      "alternate_labels": [
        "Aminadab"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Amminadab",
          "article": "person:Amminadab",
          "description": "The son of Ram, and the father of Nahshon. He was an ancestor of King David and is listed as part of Jesus’s lineage."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَمِّينَادَاب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن رام وأبو نحشون. كان أحد أجداد الملك داود ومذكور في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚米拿达",
      "descriptions": [
        {
          "source": "acai",
          "description": "兰的儿子，拿顺的父亲。他是大卫王的先祖，也被列在耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Amminadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Ram et père de Nachschon. Il était un ancêtre du roi David et figure dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Amminadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Ram, kuma uban Nashon. Shi kakan Sarki Dawuda ne kuma yana cikin jerin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "अम्मीनादाब",
      "descriptions": [
        {
          "source": "acai",
          "description": "राम का पुत्र और नहशोन का पिता। वह राजा दाऊद का पूर्वज था और यीशु की वंशावली में शामिल है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Aminadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Ram, dan ayah Nahason. Ia adalah leluhur Raja Daud dan tercatat sebagai bagian dari silsilah Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Aminadabe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Ram e pai de Naassom. Ele foi um antepassado do rei Davi e é mencionado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аминадав",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Рама и отец Наассона. Он был предком царя Давида и входит в родословие Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Aminadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Ram y padre de Naasón. Fue antepasado del rey David y figura en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Aminadabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Ramu, na baba ya Nashoni. Alikuwa babu wa Mfalme Daudi na ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Aminadap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong Ram, na papa bilong Nason. Em i wanpela tumbuna bilong King Devit na nem bilong en i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "عميناداب",
      "descriptions": [
        {
          "source": "acai",
          "description": "ولد رام، وأبو نحشون. كان من أجداد الملك داود ومذكور في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Aminadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong Ram, mo papa blong Nason. Hem i wan bubu blong King Deved mo i stap long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Aminadab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Ram, na nna Nashọn. Ọ bụ nna nna Eze Devid ma depụtakwa ya dịka akụkụ nke usoro ọmụmụ Jizọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "अम्मीनादाब",
      "descriptions": [
        {
          "source": "acai",
          "description": "रामका छोरा र नहशोनका पिता। उनी राजा दाऊदका पुर्खा थिए र येशूको वंशावलीमा सूचीकृत छन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-mi-na-đáp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Ram và là cha của Na-ha-sôn. Ông là tổ phụ của Vua Đa-vít và được liệt kê trong gia phả của Chúa Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞米拿達",
      "descriptions": [
        {
          "source": "acai",
          "description": "蘭的兒子，拿順的父親。他是大衛王的先祖，並列於耶穌的家譜中。"
        }
      ]
    }
  },
