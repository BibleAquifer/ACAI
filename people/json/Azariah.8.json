  "localizations": {
    "eng": {
      "preferred_label": "Azariah (2 Chronicles 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Azariah (2 Chronicles 15:1)",
          "article": "person:Azariah.8",
          "description": "A prophet during the divided kingdom, son of Oded, mentioned only in 2 Chronicles 15:1."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَزَرْيَا (أخبار الأيام الثاني 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبي في عهد المملكة المنقسمة، وهو ابن عوديد، ولم يُذكر إلا في أخبار الأيام الثاني 15: 1."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚撒利雅 (历代志下 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期的一位先知，俄德的儿子，仅见于历代志下15:1。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Azaria (2 Chroniques 15.1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un prophète pendant la monarchie divisée, fils d'Oded, mentionné seulement dans 2 Chroniques 15.1."
        }
      ]
    },
    "hau": {
      "preferred_label": "Azariya (2 Tarihi 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani annabi a lokacin rabuwar mulki, ɗan Oded, wanda aka ambata a 2 Labarbaru 15:1 kaɗai."
        }
      ]
    },
    "hin": {
      "preferred_label": "अजर्याह (2 इतिहास 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के समय का एक भविष्यद्वक्ता, ओदेद का पुत्र, जिसका उल्लेख केवल 2 इतिहास 15:1 में मिलता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Azarya (2 Tawarikh 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang nabi pada masa kerajaan terpecah, putra Oded, yang hanya disebutkan dalam 2 Tawarikh 15:1."
        }
      ]
    },
    "por": {
      "preferred_label": "Azarias (2 Crônicas 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Profeta durante o reino dividido, filho de Odede, mencionado apenas em 2 Crônicas 15:1."
        }
      ]
    },
    "rus": {
      "preferred_label": "Азария (2-я Паралипоменон 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Пророк времен разделенного царства, сын Одеда, упомянутый только во 2 Паралипоменон 15:1."
        }
      ]
    },
    "spa": {
      "preferred_label": "Azarías (2 Crónicas 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Profeta durante el reino dividido, hijo de Obed, mencionado únicamente en 2 Crónicas 15:1."
        }
      ]
    },
    "swh": {
      "preferred_label": "Azaria (2 Mambo ya Nyakati 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nabii aliyeishi wakati wa ufalme uliogawanyika, mwana wa Odedi, anayetajwa tu katika 2 Mambo ya Nyakati 15:1."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Asaria (2 Kronikel 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela profet long taim bilong kingdom i stap tupela hap, em i pikinini man bilong Odet, 2 Stori 15:1 tasol i kolim nem bilong em."
        }
      ]
    },
    "apd": {
      "preferred_label": "عزريا (أخبار الأيام الثاني 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "نبي في فترة المملكة المنقسمة، ابن عوديد، اتذكر بس في أخبار الأيام التاني 15: 1."
        }
      ]
    },
    "bis": {
      "preferred_label": "Asaria (2 Kronikol 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan profet long taem blong dividet kingdom, pikinini man blong Oded, we Baebol i tokbaot hem long 2 Kronikel 15:1 nomo."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Azaraya (2 Akụkọ Ihe Gara Aga 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu onye amụma nʼoge alaeze kewara ekewa, nwa Oded, nke a kpọtụrụ aha naanị nʼime 2 Ihe E Mere 15:1."
        }
      ]
    },
    "nep": {
      "preferred_label": "अजर्याह (2 इतिहास 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयका एक अगमवक्ता, ओदेदका छोरा, जसको उल्लेख २ इतिहास १५:१ मा मात्र गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-xa-ria (2 Sử Ký 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nhà tiên tri trong thời kỳ vương quốc phân chia, con trai của Ô-đết, chỉ được đề cập trong 2 Sử Ký 15:1."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞撒利雅 (歷代志下 15:1)",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期的一位先知，俄德的兒子，僅記載於歷代志下 15:1。"
        }
      ]
    }
  },
