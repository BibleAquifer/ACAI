  "localizations": {
    "eng": {
      "preferred_label": "Jotham",
      "alternate_labels": [
        "Joatham"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jotham",
          "article": "person:Jotham.2",
          "description": "A king of Judah during the divided kingdom. He was a son of Uzziah by Jerusha."
        }
      ]
    },
    "arb": {
      "preferred_label": "يوثَام",
      "descriptions": [
        {
          "source": "acai",
          "description": "مَلِكٌ لِيَهُوذَا فِي أَثْنَاءِ عَصْرِ ٱلْمَمْلَكَةِ ٱلْمُنْقَسِمَةِ. كَانَ ٱبْنًا لِعُزِّيَّا مِنْ يَرُوشَةَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约坦",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期的犹大王。他是乌西雅与耶路沙的儿子。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Jotham",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi de Juda à l'époque du royaume divisé. Il était le fils d'Ozias et de Jeruscha."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yotam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Yahuda a lokacin rarrabuwar masarauta. Shi ɗan Uzziya ne ta wurin Yerusha."
        }
      ]
    },
    "hin": {
      "preferred_label": "योताम",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के समय यहूदा का एक राजा। वह यरूशा के द्वारा उज्जियाह का पुत्र था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yotam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang raja Yehuda pada masa kerajaan terpecah. Ia adalah putra Uzia dari Yerusa."
        }
      ]
    },
    "por": {
      "preferred_label": "Jotão",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um rei de Judá durante o reino dividido. Ele era filho de Uzias com Jerusa."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иоафам",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь Иудеи во времена разделенного царства, сын Озии от Иеруши."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jotán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey de Judá durante el reino dividido. Era hijo de Uzías y Jerusa."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yothamu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Yuda wakati wa ufalme uliogawanyika. Alikuwa mwana wa Uzia kwa njia ya Yerusha."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jotam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela king bilong Juda long taim kingdom i stap brukbruk. Em i pikinini man bilong Usia na Jerusa."
        }
      ]
    },
    "apd": {
      "preferred_label": "يوثام",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك في يهوذا وكت المملكة المنقسمة. كان ولد عزيا من يروشا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jotam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong Juda long taem we kingdom i seraot. Hem i pikinini boe blong Usia wetem Jerusa."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jotam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu eze Juda nʼoge alaeze kewara ekewa. Ọ bụ nwa nwoke Ụzaya mụtara site na Jerusha."
        }
      ]
    },
    "nep": {
      "preferred_label": "योताम",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयका यहूदाका एक राजा। उनी यरूशाद्वारा जन्मेका उज्‍जियाहका छोरा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-tham",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vị vua của Giu-đa trong thời kỳ vương quốc phân chia. Ông là con trai của Ô-xia với Giê-ru-sa."
        }
      ]
    },
    "zht": {
      "preferred_label": "約坦",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期的猶大王。他是烏西雅與耶路沙的兒子。"
        }
      ]
    }
  },
