    },
    "bis": {
      "preferred_label": "Jonatan (Jeremaea 40:8)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i laef long taem blong kingdom we i seraot, pikinini man blong Karea mo brata blong Johanan, we Baebol i tokbaot hem long Jeremaea 40:8."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jonatan (Jeremaia 40:8)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke biri ndụ nʼoge alaeze ahụ kewara ekewa, nwa Kariya na nwanne Johanan, nke a kpọtụrụ aha na Jeremaya 40:8."
        }
      ]
    },
    "nep": {
      "preferred_label": "जोनाथन (यर्मिया 40:8)",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा बाँचेका एक व्यक्ति, कारेहका छोरा र योहानानका भाइ, यर्मिया ४०:८ मा उल्लेख गरिएको।"
        }
      ]
    },
    "vie": {
