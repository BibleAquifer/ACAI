    },
    "tpi": {
      "preferred_label": "Jonatan (Jeremia 40:8)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man i bin stap long taim bilong kingdom i brukbruk, pikinini man bilong Karea na brata bilong Johanan, em Jeremaia 40:8 i kolim nem bilong en."
        }
      ]
    },
    "apd": {
      "preferred_label": "يوناثان (إرميا 40:8)",
      "descriptions": [
        {
