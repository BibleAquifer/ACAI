      "descriptions": [
        {
          "source": "acai",
          "gloss": "Elimelech",
          "article": "person:Elimelech",
          "description": "Husband of Naomi and father-in-law of Ruth the Moabitess. He was the father of Mahlon and Chilion."
        }
      ]
    },
    "fra": {
      "preferred_label": "Élimélec",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mari de Naomi et beau-père de Ruth la Moabite. Il était le père de Machlon et de Kiljon."
        }
      ]
    },
    "spa": {
      "preferred_label": "Elimelec",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esposo de Noemí y suegro de Rut la moabita. Fue padre de Majlón y Quelión."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَلِيمَالِك",
      "descriptions": [
        {
          "source": "acai",
          "description": "زوج نُعْمِي وحمو راعوث الموآبية. وكان والد مَحْلون وكِلْيون."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以利米勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "拿俄米的丈夫，摩押女子路得的公公。他是玛伦和基连的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Elimelek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mijin Na'omi kuma surukin Ruth Ba-mowabiya. Shi ne mahaifin Malon da Kiliyon."
        }
      ]
    },
    "hin": {
      "preferred_label": "एलीमेलेक",
      "descriptions": [
        {
          "source": "acai",
          "description": "नाओमी का पति और मोआबी रूत का ससुर। वह महलोन और किल्योन का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Elimelekh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suami Naomi dan ayah mertua Rut, perempuan Moab itu. Ia adalah ayah dari Mahlon dan Kilyon."
        }
      ]
    },
    "por": {
      "preferred_label": "Elimeleque",
      "descriptions": [
        {
          "source": "acai",
          "description": "Marido de Noemi e sogro de Rute, a moabita. Ele foi pai de Malom e Quiliom."
        }
      ]
    },
    "rus": {
      "preferred_label": "Елимелех",
      "descriptions": [
        {
          "source": "acai",
          "description": "Муж Ноемини и свекор моавитянки Руфи. Отец Махлона и Хилеона."
        }
      ]
    },
    "swh": {
      "preferred_label": "Elimeleki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mume wa Naomi na baba mkwe wa Ruthu Mmoabi. Alikuwa baba wa Maloni na Kilioni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Elimelek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man bilong Naomi na tambu papa bilong Rut, meri Moap. Em i papa bilong Malon wantaim Kilion."
        }
      ]
    },
    "apd": {
      "preferred_label": "أليمالك",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل نعمي وحما راعوث الموآبية. وكان أبو محلون وكليون."
        }
      ]
    },
    "bis": {
      "preferred_label": "Elimelek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Man blong Nomi mo papa blong man blong Rut we i woman Moab. Hem i papa blong Malon mo Kilion."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Elimelek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Di Neomị na nna di Rut onye Moab. Ọ bụ nna Malọn na Kilịọn."
        }
      ]
    },
    "nep": {
      "preferred_label": "एलीमेलेक",
      "descriptions": [
        {
          "source": "acai",
          "description": "नाओमीका पति र मोआबी रूथका ससुरा। उनी महलोन र किल्‍योनका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-li-mê-léc",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chồng của Na-ô-mi và là cha chồng của Ru-tơ người Mô-áp. Ông là cha của Mát-lôn và Ki-li-ôn."
        }
      ]
    },
    "zht": {
      "preferred_label": "以利米勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "拿俄米的丈夫，摩押女子路得的公公，是瑪倫和基連的父親。"
        }
      ]
    }
