  "localizations": {
    "eng": {
      "preferred_label": "Pekah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Pekah",
          "article": "person:Pekah",
          "description": "A son of Remaliah and military captain who assasinated King Pekahiah of the northern kingdom and took his throne."
        }
      ]
    },
    "arb": {
      "preferred_label": "فَقْح",
      "descriptions": [
        {
          "source": "acai",
          "description": "ٱبْنُ رَمَلْيَا وَقَائِدٌ عَسْكَرِيٌّ ٱغْتَالَ ٱلْمَلِكَ فَقَحْيَا مَلِكَ ٱلْمَمْلَكَةِ ٱلشَّمَالِيَّةِ وَٱسْتَوْلَى عَلَى عَرْشِهِ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "比加",
      "descriptions": [
        {
          "source": "acai",
          "description": "利玛利的儿子，曾任军官，刺杀了北国国王比加辖并篡夺王位。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Pékach",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Remalia et capitaine militaire qui a assassiné le roi Pekachia du royaume du Nord et pris son trône."
        }
      ]
    },
    "hau": {
      "preferred_label": "Feka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Remaliya kuma kwamandan soja wanda ya kashe Sarki Fekahiya na masarautar arewa ya kuma ƙwace kursiyinsa."
        }
      ]
    },
    "hin": {
      "preferred_label": "पेकह",
      "descriptions": [
        {
          "source": "acai",
          "description": "रमल्याह का पुत्र और सैन्य अधिकारी जिसने उत्तरी राज्य के राजा पकह्याह की हत्या की और उसका सिंहासन छीन लिया।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Pekah",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anak Remalya dan panglima militer yang membunuh Raja Pekahya dari kerajaan utara lalu merebut takhtanya."
        }
      ]
    },
    "por": {
      "preferred_label": "Peca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho de Remalias e comandante militar que assassinou o rei Pecaías do reino do norte e assumiu o seu trono."
        }
      ]
    },
    "rus": {
      "preferred_label": "Факей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Ремалии и военачальник, который составил заговор против царя Северного царства Факии, убил его и занял его престол."
        }
      ]
    },
    "spa": {
      "preferred_label": "Pécaj",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo de Remalías y capitán del ejército que asesinó al rey Pecajías del reino del norte y ocupó su trono."
        }
      ]
    },
    "swh": {
      "preferred_label": "Peka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Remalia na jemadari wa kijeshi aliyemuua Mfalme Pekahia wa ufalme wa kaskazini na kuchukua kiti chake cha ufalme."
        }
      ]
    },
    "apd": {
      "preferred_label": "فقح",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن رمليا وقائد جيش اغتال الملك فقحيا ملك المملكة الشمالية وأخد عرشه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Peka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan pikinini boe blong Remalia mo kapten blong ol soldia we i kilim King Pekahia blong not kingdom mo i tekem ples blong hem long jea blong king."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Peka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Remalaya na ọchịagha nke gburu Eze Pekahaya nke alaeze ugwu wee weghara ocheeze ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "पेकह",
      "descriptions": [
        {
          "source": "acai",
          "description": "रमल्याहका छोरा तथा सेनापति, जसले उत्तरी राज्यका राजा पकहीयाको हत्या गरी तिनको सिंहासन हात पारे।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Peka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pikinini man bilong Remalia na kepten bilong ami em i bin kilim i dai King Pekahia bilong kingdom bilong not na kisim sia king bilong en."
        }
      ]
    },
    "vie": {
      "preferred_label": "Phê-ca",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một con trai của Rê-ma-lia và là tướng chỉ huy quân đội, người đã ám sát Vua Phê-ca-hia của vương quốc phía bắc rồi chiếm lấy ngai vàng."
        }
      ]
    },
    "zht": {
      "preferred_label": "比加",
      "descriptions": [
        {
          "source": "acai",
          "description": "利瑪利的兒子、北國將軍，他刺殺了北國國王比加轄並篡奪王位。"
        }
      ]
    }
  },
