  "localizations": {
    "eng": {
      "preferred_label": "Jehoahaz",
      "alternate_labels": [
        "Joahaz"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jehoahaz",
          "article": "person:Jehoahaz.2",
          "description": "A king of the northern kingdom of Israel during the divided kingdom. He was a son of Jehu and father of Joash."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَهُوأَحَاز",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملكٌ على مملكة إسرائيل الشمالية في عهد المملكة المنقسمة. كان ابنًا لياهو وأبًا ليوآش."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约哈斯",
      "descriptions": [
        {
          "source": "acai",
          "description": "王国分裂时期北国以色列的一位国王。他是耶户的儿子，约阿施的父亲。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Joachaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi du royaume du Nord (Israël) à l’époque du royaume divisé. Il était fils de Jéhu et père de Joas."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yehoyahaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin masarautar arewa ta Isra’ila a lokacin mulkin da ya rabu. Shi ɗan Yehu ne kuma mahaifin Yowash."
        }
      ]
    },
    "hin": {
      "preferred_label": "यहोआहाज",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्य के समय इस्राएल के उत्तरी राज्य का एक राजा। वह येहू का पुत्र और योआश का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yoahas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Raja kerajaan utara Israel pada masa kerajaan terpecah. Ia adalah putra Yehu dan ayah Yoas."
        }
      ]
    },
    "por": {
      "preferred_label": "Jeoacaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rei do reino do norte de Israel durante o período da monarquia dividida. Era filho de Jeú e pai de Joás."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иоахаз",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь северного царства Израиля во времена разделенного царства. Сын Ииуя и отец Иоаса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Joacaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey del reino del norte de Israel durante el reino dividido. Fue hijo de Jehú y padre de Joás."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yehoahazi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa ufalme wa kaskazini wa Israeli wakati wa ufalme uliogawanyika. Alikuwa mwana wa Yehu na baba yake Yoashi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Joahas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela king bilong not hap kantri Israel long taim kantri i bruk long tupela. Em i pikinini man bilong Jehu na papa bilong Joas."
        }
      ]
    },
    "apd": {
      "preferred_label": "يهوآحاز",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك على مملكة إسرائيل الشمالية في وكت المملكة المنقسمة. كان ابن ياهو وأبو يوآش."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jehoahas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan king blong not kingdom blong Isrel long taem we kingdom i seraot. Hem i wan pikinini boe blong Jehu mo papa blong Joas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jehoahaz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze nke alaeze ugwu nke Izrel nʼoge alaeze kewara ekewa. Ọ bụ nwa Jehu na nna Joash."
        }
      ]
    },
    "nep": {
      "preferred_label": "यहोआहाज",
      "descriptions": [
        {
          "source": "acai",
          "description": "विभाजित राज्यको समयमा इस्राएलको उत्तरी राज्यका एक राजा। तिनी येहूका छोरा र योआशका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giô-a-cha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một vị vua của vương quốc phía bắc Y-sơ-ra-ên trong thời kỳ vương quốc phân chia. Ông là con trai của Giê-hu và là cha của Giô-ách."
        }
      ]
    },
    "zht": {
      "preferred_label": "約哈斯",
      "descriptions": [
        {
          "source": "acai",
          "description": "王國分裂時期北國以色列的一位王。他是耶戶的兒子、約阿施的父親。"
        }
      ]
    }
  },
