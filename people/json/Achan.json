  "type": "person",
  "gender": "male",
  "father": "person:Carmi.3",
  "tribe": "group:Judah",
  "localizations": {
    "eng": {
      "preferred_label": "Achan",
      "alternate_labels": [
        "Achar"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Achan",
          "article": "person:Achan",
          "description": "A member of the tribe of Judah who caused trouble for Israel by stealing from the items Israel had captured after the battle of Jericho."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَخَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل من سبط يهوذا جلب المتاعب على إسرائيل بسرقته من الأشياء المأخوذة بعد معركة أريحا والمخصصة للتحريم."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚干",
      "descriptions": [
        {
          "source": "acai",
          "description": "犹大支派的一员，在耶利哥战役后因私拿以色列当毁灭之物而给以色列带来灾祸。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Acan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membre de la tribu de Juda qui causa des malheurs à Israël en dérobant des objets du butin pris par Israël après la bataille de Jéricho."
        }
      ]
    },
    "hau": {
      "preferred_label": "Akan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutumin kabilan Yahuda wanda ya jawo wa Isra’ila matsala ta wurin yin sata daga cikin abubuwan da Isra’ila ta ƙwace bayan yaƙin Yariko."
        }
      ]
    },
    "hin": {
      "preferred_label": "आकान",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा गोत्र का एक व्यक्ति जिसने यरीहो के युद्ध के बाद इस्राएल द्वारा जीती गई वस्तुओं में से चोरी करके इस्राएल के लिए विपत्ति उत्पन्न की।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Akhan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang anggota suku Yehuda yang mendatangkan malapetaka bagi Israel karena mencuri barang-barang yang direbut Israel setelah pertempuran Yerikho."
        }
      ]
    },
    "por": {
      "preferred_label": "Acã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membro da tribo de Judá que causou problemas para Israel ao roubar parte dos itens que Israel havia conquistado após a batalha de Jericó."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ахан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек из колена Иудина, навлекший беду на Израиль тем, что похитил часть добычи, захваченной израильтянами после битвы за Иерихон."
        }
      ]
    },
    "spa": {
      "preferred_label": "Acán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Miembro de la tribu de Judá que causó problemas a Israel al robar de los objetos que Israel había capturado tras la batalla de Jericó."
        }
      ]
    },
    "swh": {
      "preferred_label": "Akani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu wa kabila la Yuda aliyesababisha matatizo kwa Israeli kwa kuiba baadhi ya vitu ambavyo Israeli iliteka baada ya vita vya Yeriko."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Akan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong lain bilong Juda em i bin bringim hevi long Israel taim em i stilim sampela samting ol Israel i bin kisim bihain long pait long Jeriko."
        }
      ]
    },
    "apd": {
      "preferred_label": "عخان",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحد من سبط يهوذا جاب المشاكل لإسرائيل لما سرق من الحاجات الحرموها بعد معركة أريحا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Akan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan memba blong laen blong Juda we i mekem trabol i kamaot long Isrel from we hem i stilim sam long ol samting we Isrel i tekem afta long faet long Jeriko."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ekan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye si nʼebo Juda nke kpatara Izrel nsogbu site nʼizu ohi nʼime ihe ndị Izrel kwatara mgbe a lụchara agha Jeriko."
        }
      ]
    },
    "nep": {
      "preferred_label": "आकान",
      "descriptions": [
        {
          "source": "acai",
          "description": "यहूदा कुलका एक सदस्य, जसले यरीहोको लडाइँपछि इस्राएलले कब्जा गरेका थोकहरूबाट चोरेर इस्राएलमाथि विपत्ति ल्याएका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "A-can",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người thuộc chi tộc Giu-đa đã gây tai họa cho Ít-ra-ên vì lấy trộm các chiến lợi phẩm sau trận chiến Giê-ri-cô."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞干",
      "descriptions": [
        {
          "source": "acai",
          "description": "猶大支派的一員，因在耶利哥戰役後偷取了以色列人所擄獲的當滅之物，而給以色列帶來了災禍。"
        }
      ]
    }
  },
