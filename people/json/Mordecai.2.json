  "localizations": {
    "eng": {
      "preferred_label": "Mordecai",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Mordecai",
          "article": "person:Mordecai.2",
          "description": "Cousin and guardian of Queen Esther, son of Jair and prominent Jew, who lived during the time of the Israelite exile and return in Persia during the reign of King Ahauserus."
        }
      ]
    },
    "arb": {
      "preferred_label": "مُرْدَخَاي",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن عم الملكة أستير ووليها، وابن يائير، وهو رجل يهودي بارز عاش أثناء سبي إسرائيل والرجوع في بلاد فارس خلال حكم الملك أحشويروش."
        }
      ]
    },
    "zhs": {
      "preferred_label": "末底改",
      "descriptions": [
        {
          "source": "acai",
          "description": "以斯帖王后的堂兄兼监护人，睚珥的儿子，显要的犹太人，生活在以色列人被流放并在亚哈随鲁王统治时期的波斯归回时代。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Mardochée",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cousin et tuteur de la reine Esther, fils de Jaïr et Juif éminent, qui vécut à l'époque de l'exil et du retour des Israélites en Perse sous le règne du roi Assuérus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mordekai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan’uwan mahaifin Sarauniya Esta kuma mai renonta, ɗan Yayir, wani babban Bayahude ne da ya rayu a zamanin bautar Isra’ilawa da kuma komowarsu a Farisa a lokacin sarautar Sarki Ahasweros."
        }
      ]
    },
    "hin": {
      "preferred_label": "मोर्दकै",
      "descriptions": [
        {
          "source": "acai",
          "description": "रानी एस्तेर के चचेरे भाई और संरक्षक, याईर के पुत्र तथा एक प्रमुख यहूदी, जो राजा क्षयर्ष के शासनकाल के दौरान फ़ारस में इस्राएलियों के निर्वासन और वापसी के समय रहते थे।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Mordekhai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Saudara sepupu dan pengasuh Ratu Ester, anak Yair dan seorang tokoh Yahudi terkemuka, yang hidup pada masa pembuangan dan pemulangan orang Israel di Persia pada masa pemerintahan Raja Ahasyweros."
        }
      ]
    },
    "por": {
      "preferred_label": "Mardoqueu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Primo e guardião da rainha Ester, filho de Jair e judeu proeminente, que viveu durante a época do exílio israelita e do retorno na Pérsia durante o reinado do rei Assuero."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мардохей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Двоюродный брат и воспитатель царицы Есфири, сын Иаира и знатный иудей, живший во время изгнания и возвращения израильтян в Персии в царствование царя Артаксеркса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Mardoqueo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Primo y tutor de la reina Ester, hijo de Jair y prominente judío, que vivió durante la época del exilio y retorno de los israelitas en Persia durante el reinado del rey Asuero."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mordekai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Binamu na mlezi wa Malkia Esta, mwana wa Yairi na Myahudi mashuhuri, aliyeishi wakati wa uhamisho na kurejea kwa Waisraeli huko Uajemi wakati wa utawala wa Mfalme Ahasuero."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Mordekai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kasin brata na man bilong lukautim Kwin Esta, pikinini man bilong Jair na wanpela bikpela man bilong ol Juda, em i bin stap long taim ol Israel i stap kalabus na taim ol i go bek long Persia long taim bilong King Ahasuerus."
        }
      ]
    },
    "apd": {
      "preferred_label": "مردخاي",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن عم الملكة أستير وولي أمرها، وهو ابن يائير ويهودي بارز، عاش في زمن سبي بني إسرائيل والرجوع في بلاد فارس في عهد الملك أحشويروش."
        }
      ]
    },
    "bis": {
      "preferred_label": "Modekae",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan famle mo gardian blong Kwin Esta, we hem i pikinini man blong Jaere mo wan man Jiu we i gat nem, we i laef long taem we ol man Isrel oli aot long kantri blong olgeta i go long Babilonia mo oli stap long Pesia long taem we King Ahasuerus i stap rula."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Mọdekai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwanne nna na onye nlekọta nke Eze Nwanyị Esta, nwa Jaịa na onye Juu a ma ama, onye biri nʼoge ndọkpụ nʼagha na nlọghachi nke ndị Izrel na Peshia nʼoge ọchịchị Eze Ahazuẹrọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "मोर्दकै",
      "descriptions": [
        {
          "source": "acai",
          "description": "रानी एस्तरका काकाका छोरा र अभिभावक, याईरका छोरा र एक प्रमुख यहूदी, जो राजा अहासूरसको शासनकालमा पर्सियामा इस्राएलीहरूको निर्वासन र फिर्तीको समयमा बसेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Mạc-đô-chê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anh họ và người giám hộ của Hoàng hậu Ê-xơ-tê, con trai của Giai-rơ và là một người Do Thái có thế lực, sống vào thời kỳ dân Y-sơ-ra-ên bị lưu đày và hồi hương tại Ba Tư dưới triều vua A-ha-suê-ru."
        }
      ]
    },
    "zht": {
      "preferred_label": "末底改",
      "descriptions": [
        {
          "source": "acai",
          "description": "以斯帖王后的堂兄兼監護人，睚珥的兒子，傑出的猶太人。他生活在以色列人被擄及歸回時期的波斯，時值亞哈隨魯王在位。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
