  "tribe": "group:Levi",
  "localizations": {
    "eng": {
      "preferred_label": "Ezra",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ezra",
          "article": "person:Ezra",
          "description": "A Levite who served as both a priest and a scribe after the Israelite exile. He was the son of Seraiah. A book of the Old Testament is named for him."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَزْرَا",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوي خدم ككاهن وكاتب بعد سبي بني إسرائيل. وهو ابن سرايا، وسُمي سفر من أسفار العهد القديم باسمه."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以斯拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位利未人，以色列人被掳后兼任祭司和文士。他是西莱雅的儿子。旧约圣经中有一卷书以他命名。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Esdras",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lévite qui a exercé comme sacrificateur et scribe après l’exil d’Israël. Il était le fils de Seraja. Un livre de l’Ancien Testament porte son nom."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ezra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Balawe wanda ya yi hidima a matsayin firist da kuma marubuci bayan bautar Isra’ilawa. Shi ɗan Serahiya ne. An ba da sunan wani littafi na Tsohon Alkawari da sunansa."
        }
      ]
    },
    "hin": {
      "preferred_label": "एज्रा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक लेवीय जिसने इस्राएलियों की बंधुवाई के बाद याजक और शास्त्री दोनों के रूप में सेवा की। वह सरायाह का पुत्र था। पुराने नियम की एक पुस्तक का नाम उसके नाम पर रखा गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ezra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang Lewi yang melayani sebagai imam dan ahli kitab setelah pembuangan bangsa Israel. Ia adalah anak Seraya. Salah satu kitab Perjanjian Lama dinamai menurut namanya."
        }
      ]
    },
    "por": {
      "preferred_label": "Esdras",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um levita que serviu como sacerdote e escriba após o exílio israelita. Ele era filho de Seraías. Um livro do Antigo Testamento leva o seu nome."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ездра",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левит, служивший священником и книжником после израильского изгнания. Сын Сераии. Его именем названа книга Ветхого Завета."
        }
      ]
    },
    "spa": {
      "preferred_label": "Esdras",
      "descriptions": [
        {
          "source": "acai",
          "description": "Levita que se desempeñó como sacerdote y escriba después del exilio israelita. Era hijo de Seraías. Un libro del Antiguo Testamento lleva su nombre."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ezra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mlawi aliyetumika kama kuhani na mwandishi baada ya uhamisho wa Waisraeli. Alikuwa mwana wa Seraya. Kitabu kimoja cha Agano la Kale kimepewa jina lake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Esra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong lain Livai em i bin mekim wok olsem pris na saveman bilong lo bihain long ol Israel i lusim kalabus. Em i pikinini man bilong Seraia. Wanpela buk bilong Olpela Testamen i kisim nem bilong em."
        }
      ]
    },
    "apd": {
      "preferred_label": "عزرا",
      "descriptions": [
        {
          "source": "acai",
          "description": "لاوي خدم ككاهن وكاتب بعد سبي بني إسرائيل. كان ولد سرايا. في سفر في العهد القديم مسمى باسمه."
        }
      ]
    },
    "bis": {
      "preferred_label": "Esra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan Livaet we i mekem wok olsem wan pris mo wan tija blong Loa afta we ol man Isrel oli aot long kalabus. Hem i pikinini boe blong Seraea. Wan buk long Oltesteman i karem nem blong hem."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ezra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye Livayị nke jere ozi dị ka onye nchụaja na odeakwụkwọ mgbe a dọọrọ ndị Izrel nʼagha gasịrị. Ọ bụ nwa Seraya. E jikwa aha ya gụọ otu akwụkwọ dị nʼAgba Ochie."
        }
      ]
    },
    "nep": {
      "preferred_label": "एज्रा",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलीहरूको निर्वासनपछि पूजाहारी र शास्त्री दुवैको रूपमा सेवा गर्ने एक लेवी। तिनी सरायाहका छोरा थिए। पुरानो नियमको एउटा पुस्तकको नाउँ तिनकै नाउँबाट राखिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "E-xơ-ra",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người Lê-vi phục vụ với tư cách là thầy tế lễ và học giả sau thời kỳ lưu đày của dân Y-sơ-ra-ên. Ông là con trai của Sê-ra-gia. Một sách trong Cựu Ước được đặt tên theo ông."
        }
      ]
    },
    "zht": {
      "preferred_label": "以斯拉",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位利未人，在以色列人被虜歸回後兼任祭司和文士。他是西萊雅的兒子。舊約聖經有一卷書以他命名。"
        }
      ]
    }
  },
