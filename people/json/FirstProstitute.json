{
  "id": "person:FirstProstitute",
  "primary_id": "person:FirstProstitute",
  "type": "person",
  "localizations": {
    "eng": {
      "preferred_label": "Prostitute (Mother of Living Baby)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Prostitute (Mother of Living Baby)",
          "description": "A prostitute and mother of living baby who brought her case to Solomon (1 Kings 3)."
        }
      ]
    },
    "apd": {
      "preferred_label": "المرأة الزانية (أم الجنا الحي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "مرأة زانية وأم الجنا الحي جابت قضيتها للملك سليمان (1 ملوك 3)."
        }
      ]
    },
    "arb": {
      "preferred_label": "زانية (أم الطفل الحي)",
      "descriptions": [
        {
          "source": "acai",
          "description": "امرأة زانية وأم الطفل الحي التي رفعت دعواها إلى سليمان (١ ملوك ٣)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Woman rod (Mama blong pikinini we i laef)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan woman rod we i mama blong pikinini we i laef, we i karem kes blong hem i go long Solomon (1 King 3)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Prostituée (mère du bébé vivant)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prostituée et mère du bébé vivant qui porta son cas devant Salomon (1 Rois 3)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Karuwa (Uwar Jariri Mai Rai)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Karuwa kuma uwar jariri mai rai wadda ta kawo ƙararta wurin Sulemanu (1 Sarakuna 3)."
        }
      ]
    },
    "hin": {
      "preferred_label": "वेश्या (जीवित बच्चे की माँ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक वेश्या और जीवित बच्चे की माँ, जो अपना मामला सुलैमान के पास ले आई (1 राजा 3)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nwanyị akwụna (Nne Nwa Dị Ndụ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwanyị akwụna na nne nwa dị ndụ nke wetara okwu ya nʼihu Solomọn (1 Ndị Eze 3)."
        }
      ]
    },
    "ind": {
      "preferred_label": "Perempuan sundal (Ibu dari Bayi yang Hidup)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang perempuan sundal dan ibu dari bayi yang masih hidup yang membawa perkaranya kepada Salomo (1 Raja-raja 3)."
        }
      ]
    },
    "nep": {
      "preferred_label": "वेश्या (जीवित बालककी आमा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक वेश्या र जीवित बालककी आमा, जसले आफ्नो मुद्दा सोलोमनकहाँ ल्याइन् (१ राजा ३)।"
        }
      ]
    },
    "por": {
      "preferred_label": "Prostituta (Mãe do Bebê Vivo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma prostituta e mãe da criança viva que levou seu caso a Salomão (1 Reis 3)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Блудница (мать живого младенца)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Блудница и мать живого младенца, которая обратилась за судом к Соломону (3 Царств 3)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Prostituta (madre del bebé vivo)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Prostituta y madre del bebé vivo que presentó su caso ante Salomón (1 Reyes 3)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Kahaba (Mama wa Mtoto Aliye Hai)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kahaba na mama wa mtoto aliye hai aliyeleta shauri lake mbele ya Sulemani (1 Wafalme 3)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Pamukmeri (Mama bilong pikinini i stap laip)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela pamukmeri na mama bilong pikinini i stap laip em i bin bringim kot bilong em i go long Solomon (1 King 3)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Kỹ nữ (Mẹ của đứa trẻ còn sống)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một kỹ nữ và là mẹ của đứa trẻ còn sống, người đã đem vụ việc của mình đến trước vua Sa-lô-môn (1 Các Vua 3)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "妓女（活孩子的母亲）",
      "descriptions": [
        {
          "source": "acai",
          "description": "一名妓女，活孩子的母亲，曾将案件呈交所罗门审理（列王纪上3章）。"
        }
      ]
    },
    "zht": {
      "preferred_label": "妓女（活孩子的母親）",
      "descriptions": [
        {
          "source": "acai",
          "description": "一名妓女，也是活孩子的母親，她將訴訟帶到所羅門面前（列王紀上第3章）。"
        }
      ]
    }
  },
