  "localizations": {
    "eng": {
      "preferred_label": "Ebed-melech",
      "alternate_labels": [
        "Ebed-Melek"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ebed-Melech",
          "article": "person:Ebed-melech",
          "description": "An Ethiopian eunuch who served as an official to King Zedekiah during the divided kingdom of Israel. He advocated for the prophet Jeremiah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Ébed-Mélec",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eunuque éthiopien qui servit comme fonctionnaire auprès du roi Sédécias durant la période du royaume divisé d’Israël. Il intervint en faveur du prophète Jérémie."
        }
      ]
    },
    "spa": {
      "preferred_label": "Ebed-melec",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eunuco etíope que sirvió como funcionario del rey Sedequías durante el reino dividido de Israel. Intercedió por el profeta Jeremías."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以伯·米勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "一名埃塞俄比亚（古实）太监，在以色列王国分裂时期担任西底家王的官员。他曾为先知耶利米求情辩护。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ebed-Melek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani bābā ɗan ƙasar Habasha wanda ya yi aiki a matsayin hafsa ga Sarki Zedekiya a lokacin rarrabuwar masarautar Isra'ila. Ya tsaya wa annabi Irmiya."
        }
      ]
    },
    "hin": {
      "preferred_label": "एबेदमेलेक",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक कूशी (इथियोपियाई) खोजा जिसने इस्राएल के विभाजित राज्य के दौरान राजा सिदकिय्याह के अधिकारी के रूप में सेवा की। उसने यिर्मयाह भविष्यद्वक्ता की पैरवी की।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Ebed-Melekh",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang sida-sida Etiopia yang melayani sebagai pejabat istana Raja Zedekia selama masa kerajaan terpecah Israel. Ia membela nabi Yeremia."
        }
      ]
    },
    "por": {
      "preferred_label": "Ebede-Meleque",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um eunuco etíope que serviu como oficial do rei Zedequias durante o reino dividido de Israel. Ele intercedeu pelo profeta Jeremias."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ebed-Meleki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Towashi Mkushi aliyetumikia akiwa afisa wa Mfalme Sedekia wakati wa ufalme uliogawanyika wa Israeli. Alimtetea nabii Yeremia."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ebetmelek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela eunuk bilong Itiopia (Kus) em i bin mekim wok ofisa bilong King Sedekaia long taim bilong kingdom bilong Israel i brukbruk. Em i bin helpim profet Jeremaia."
        }
      ]
    },
    "apd": {
      "preferred_label": "عَبْدَمَلِك",
      "descriptions": [
        {
          "source": "acai",
          "description": "خصي إثيوبي (كوشي) كان شغال مسؤول عند الملك صدقيا في زمن المملكة المنقسمة لبني إسرائيل. دافع عن النبي إرميا."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَبْدُ مَلِكَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "خَصِيٌّ كُوشِيٌّ خَدَمَ مَسْؤُولًا لَدَى المَلِكِ صِدْقِيَّا أَثْنَاءَ عَهْدِ المَمْلَكَةِ المُنْقَسِمَةِ فِي إِسْرَائِيلَ. وَقَدْ دَافَعَ عَنِ النَّبِيِّ إِرْمِيَا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ebedmelek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man Itiopia we oli spolem hem blong i no moa save gat pikinini, we i man blong wok blong King Sedekea long taem we kingdom blong Isrel i seraot. Hem i bin toktok blong givhan long profet Jeremaea."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ebed-Melek",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye ọnaozi Etiopia nke jere ozi dị ka onyeisi ozi nʼebe Eze Zedekaya nọ nʼoge alaeze kewara ekewa nke Izrel. Ọ gbachitere Jeremaya onye amụma."
        }
      ]
    },
    "nep": {
      "preferred_label": "एबेद-मेलेक",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक कूशी नपुंसक जसले इस्राएलको विभाजित राज्यको समयमा राजा सिदकियाहका एक अधिकारीको रूपमा काम गरे। तिनले अगमवक्ता यर्मियाको पक्षमा बोले।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Авдемелех",
      "descriptions": [
        {
          "source": "acai",
          "description": "Эфиопский евнух, служивший сановником при царе Седекии в период разделенного царства Израиля. Он вступился за пророка Иеремию."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-bết Mê-lết",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thái giám người Ê-thi-ô-pi làm quan chức cho Vua Sê-đê-kia trong thời kỳ vương quốc Ít-ra-ên phân chia. Ông đã can thiệp bênh vực nhà tiên tri Giê-rê-mi."
        }
      ]
    },
    "zht": {
      "preferred_label": "以伯‧米勒",
      "descriptions": [
        {
          "source": "acai",
          "description": "一名古實人太監，在以色列王國分裂時期擔任西底家王的官員。他曾為先知耶利米求情。"
        }
      ]
    }
  },
