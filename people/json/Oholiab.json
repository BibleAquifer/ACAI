  "localizations": {
    "eng": {
      "preferred_label": "Oholiab",
      "alternate_labels": [
        "Aholiab"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Oholiab",
          "article": "person:Oholiab",
          "description": "A skilled craftsman from the tribe of Dan who worked on the Tabernacle during the time of the wilderness wandering of the Israelites."
        }
      ]
    },
    "fra": {
      "preferred_label": "Oholiab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Artisan habile de la tribu de Dan qui a travaillé au tabernacle pendant la période de l’errance des Israélites dans le désert."
        }
      ]
    },
    "spa": {
      "preferred_label": "Aholiab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Artesano experto de la tribu de Dan que trabajó en el tabernáculo durante el tiempo en que los israelitas deambulaban por el desierto."
        }
      ]
    },
    "arb": {
      "preferred_label": "أُهُولِيآبُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "حرفيّ ماهر من سبط دان عمل في خيمة الاجتماع أثناء فترة تيه بني إسرائيل في البرية."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚何利亚伯",
      "descriptions": [
        {
          "source": "acai",
          "description": "一位来自但支派的巧匠，在以色列人旷野漂流时期参与建造会幕。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Oholiyab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Gwani mai sana'ar hannu daga kabilar Dan wanda ya yi aiki a kan Mazaunin a lokacin yawon Isra'ilawa a cikin daji."
        }
      ]
    },
    "hin": {
      "preferred_label": "ओहोलीआब",
      "descriptions": [
        {
          "source": "acai",
          "description": "दान के गोत्र से एक कुशल कारीगर जिसने इस्राएलियों के जंगल में भटकने के समय निवास-स्थान (तम्बू) पर काम किया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Aholiab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pengrajin terampil dari suku Dan yang mengerjakan Kemah Suci selama masa pengembaraan bangsa Israel di padang gurun."
        }
      ]
    },
    "por": {
      "preferred_label": "Aoliabe",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um artesão habilidoso da tribo de Dã que trabalhou no Tabernáculo durante o tempo da peregrinação dos israelitas no deserto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аголиав",
      "descriptions": [
        {
          "source": "acai",
          "description": "Искусный ремесленник из колена Данова, работавший над Скинией во время странствования израильтян по пустыне."
        }
      ]
    },
    "swh": {
      "preferred_label": "Oholiabu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fundi stadi kutoka kabila la Dani aliyefanya kazi kwenye Hema la Kukutania wakati wa safari ya Waisraeli nyikani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Oholiap",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela saveman bilong wokim olkain samting bilong lain bilong Dan, em i bin wok long Haus Lotu Sel long taim ol Israel i bin raun long ples let bilong drai."
        }
      ]
    },
    "apd": {
      "preferred_label": "أَهُولِيآب",
      "descriptions": [
        {
          "source": "acai",
          "description": "حِرَفِي شاطِر مِن قَبِيلَة دان، اِشْتَغَل فِي خَيْمَة الاِجْتِماع فِي وَقْت تَوَهان بَنِي إسْرَائِيل فِي الصَّحْرا."
        }
      ]
    },
    "bis": {
      "preferred_label": "Oholiab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i gat gudhan blong wok we i blong laen blong Dan, we i wok long Tabnakel long taem we ol man Isrel oli stap wokbaot long draeples."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Oholiab",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye ọka nka nwere nkà si nʼebo Dan nke rụrụ ọrụ nʼỤlọ Nzute nʼoge ụmụ Izrel na-awagharị nʼọzara."
        }
      ]
    },
    "nep": {
      "preferred_label": "ओहोलीआब",
      "descriptions": [
        {
          "source": "acai",
          "description": "दान कुलका एक कुशल शिल्पकार, जसले इस्राएलीहरूको उजाडस्थानको यात्राको समयमा भेट हुने पाल (बासस्थान) मा काम गरेका थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ô-hô-li-áp",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một thợ thủ công khéo léo thuộc bộ tộc Đan, người đã làm việc xây dựng Đền Tạm trong thời gian dân Y-sơ-ra-ên lưu lạc trong hoang mạc."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞何利亞伯",
      "descriptions": [
        {
          "source": "acai",
          "description": "但支派中一位技藝精湛的工匠，在以色列人曠野飄流期間參與建造會幕。"
        }
      ]
    }
  },
