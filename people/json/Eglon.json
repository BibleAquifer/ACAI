  "localizations": {
    "eng": {
      "preferred_label": "Eglon",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Eglon",
          "article": "person:Eglon",
          "description": "King of Moab during the time of the judges of Israel. He oppressed Israel and was killed by the judge Ehud."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِجْلون",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك موآب في زمن قضاة إسرائيل. ضايق بني إسرائيل وقتله القاضي إهود."
        }
      ]
    },
    "zhs": {
      "preferred_label": "伊矶伦",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列士师时代的摩押王。他压迫以色列人，后被士师以笏刺杀。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Églon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Roi de Moab à l'époque des juges d'Israël. Il opprima Israël et fut tué par le juge Éhud."
        }
      ]
    },
    "hau": {
      "preferred_label": "Eglon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sarkin Mowab a lokacin mahukuntan Isra’ila. Ya zalunci Isra’ila kuma alkali Ehud ya kashe shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "एग्लोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएल के न्यायियों के समय मोआब का राजा। उसने इस्राएल पर अत्याचार किया और न्यायी एहूद द्वारा मारा गया।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Eglon",
      "descriptions": [
        {
          "source": "acai",
          "description": "Raja Moab pada zaman para hakim Israel. Ia menindas Israel dan dibunuh oleh hakim Ehud."
        }
      ]
    },
    "por": {
      "preferred_label": "Eglom",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rei de Moabe durante a época dos juízes de Israel. Ele oprimiu Israel e foi morto pelo juiz Eúde."
        }
      ]
    },
    "rus": {
      "preferred_label": "Еглон",
      "descriptions": [
        {
          "source": "acai",
          "description": "Царь Моава во времена судей израильских. Он угнетал Израиль и был убит судьей Аодом."
        }
      ]
    },
    "spa": {
      "preferred_label": "Eglón",
      "descriptions": [
        {
          "source": "acai",
          "description": "Rey de Moab durante la época de los jueces de Israel. Oprimió a Israel y fue muerto por el juez Aod."
        }
      ]
    },
    "swh": {
      "preferred_label": "Egloni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mfalme wa Moabu wakati wa waamuzi wa Israeli. Aliwakandamiza Israeli na akauawa na mwamuzi Ehudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Eklon",
      "descriptions": [
        {
          "source": "acai",
          "description": "King bilong Moap long taim bilong ol jas bilong Israel. Em i bin daunim ol Israel na jas Ehut i bin kilim em i dai."
        }
      ]
    },
    "apd": {
      "preferred_label": "عجلون",
      "descriptions": [
        {
          "source": "acai",
          "description": "ملك موآب في زمن قضاة إسرائيل. ظلم إسرائيل وقتلو القاضي إهود."
        }
      ]
    },
    "bis": {
      "preferred_label": "Eglon",
      "descriptions": [
        {
          "source": "acai",
          "description": "King blong Moab long taem blong ol jas blong Isrel. Hem i spolem ol man Isrel mo jas Ehud i kilim hem i ded."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Eglọn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Eze Moab n'oge ndị ikpe Izrel. Ọ kpagburu Izrel ma Ehud onye ikpe gburu ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "एग्लोन",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलका न्यायकर्ताहरूको समयमा मोआबका राजा। उनले इस्राएलमाथि अत्याचार गरे र न्यायकर्ता एहूदद्वारा मारिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Éc-lôn",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vua Mô-áp vào thời các quan xét của Y-sơ-ra-ên. Ông đã áp bức Y-sơ-ra-ên và bị quan xét Ê-hút giết chết."
        }
      ]
    },
    "zht": {
      "preferred_label": "伊磯倫",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列士師時期的摩押王。他壓迫以色列人，後被士師以笏所殺。"
        }
      ]
    }
  },
