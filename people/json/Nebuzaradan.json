  "localizations": {
    "eng": {
      "preferred_label": "Nebuzaradan",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Nebuzaradan",
          "article": "person:Nebuzaradan",
          "description": "Chief commander of Nebuchadnezzar who was responsible for capturing Jerusalem and taking the Israelite nation captive."
        }
      ]
    },
    "arb": {
      "preferred_label": "نَبوزَرَادَان",
      "descriptions": [
        {
          "source": "acai",
          "description": "قائد حرس نبوخذنصر الذي كان مسؤولاً عن الاستيلاء على أورشليم وسبي أمة إسرائيل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "尼布撒拉旦",
      "descriptions": [
        {
          "source": "acai",
          "description": "尼布甲尼撒的军队统帅，负责攻陷耶路撒冷并将以色列民族掳去。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Nebuzaradan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Chef de la garde de Nebucadnetsar, qui fut chargé de la prise de Jérusalem et de la déportation du peuple d'Israël."
        }
      ]
    },
    "hau": {
      "preferred_label": "Nebuzaradan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Babban hafsan Nebukadnezzar wanda ya ɗauki alhakin kama Urushalima da kuma kwashe al’ummar Isra’ila zuwa bauta."
        }
      ]
    },
    "hin": {
      "preferred_label": "नबूजरदान",
      "descriptions": [
        {
          "source": "acai",
          "description": "नबूकदनेस्सर का प्रधान सेनापति जो यरूशलेम पर अधिकार करने और इस्राएल जाति को बंदी बना ले जाने के लिए उत्तरदायी था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Nebuzaradan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Panglima utama Nebukadnezar yang bertanggung jawab merebut Yerusalem dan menawan bangsa Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Nebuzaradã",
      "descriptions": [
        {
          "source": "acai",
          "description": "Comandante-chefe de Nabucodonosor que foi responsável por capturar Jerusalém e levar a nação israelita cativa."
        }
      ]
    },
    "rus": {
      "preferred_label": "Навузардан",
      "descriptions": [
        {
          "source": "acai",
          "description": "Главный военачальник Навуходоносора, отвечавший за захват Иерусалима и пленение израильского народа."
        }
      ]
    },
    "spa": {
      "preferred_label": "Nabuzaradán",
      "descriptions": [
        {
          "source": "acai",
          "description": "Comandante en jefe de Nabucodonosor que fue responsable de capturar Jerusalén y llevar cautiva a la nación israelita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Nebuzaradani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jemadari mkuu wa Nebukadneza aliyekuwa na jukumu la kuteka Yerusalemu na kuwapeleka Waisraeli uhamishoni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Nebusaradan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba wan ofisa bilong Nebukatnesar em i bin kisim taun Jerusalem na kisim lain Israel i go kalabus."
        }
      ]
    },
    "apd": {
      "preferred_label": "نبوزرادان",
      "descriptions": [
        {
          "source": "acai",
          "description": "قائد جيش نبوخذنصر الكان مسؤول عن الاستيلاء على أورشليم وأسر أمة بني إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Nebusaradan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hae komanda blong Nebukadnesa we i bin lukaot long wok blong tekem Jerusalem mo tekem ol neson blong Isrel i go kalabus."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Nebuzaradan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onyeisi ndị agha Nebukadneza nke nwere ibu ọrụ ijide Jerusalem na dọrọ mba Izrel nʼagha."
        }
      ]
    },
    "nep": {
      "preferred_label": "नबूजरदान",
      "descriptions": [
        {
          "source": "acai",
          "description": "नबूकदनेसरका मुख्य सेनापति जो यरूशलेमलाई कब्जा गर्न र इस्राएली जातिलाई बन्दी बनाएर लैजान जिम्मेवार थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Nê-bu-xa-ra-đan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Quan chỉ huy trưởng của Nê-bu-cát-nết-sa, người chịu trách nhiệm chiếm thành Giê-ru-sa-lem và bắt dân tộc Y-sơ-ra-ên đi lưu đày."
        }
      ]
    },
    "zht": {
      "preferred_label": "尼布撒拉旦",
      "descriptions": [
        {
          "source": "acai",
          "description": "尼布甲尼撒的護衛長，負責攻陷耶路撒冷並將以色列民擄去。"
        }
      ]
    }
  },
