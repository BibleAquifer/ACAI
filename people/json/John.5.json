      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Mark",
          "article": "person:John.5",
          "description": "A companion of the apostle Paul, also called Mark. Traditionally considered to be the author of the Gospel of Mark."
        }
      ]
    },
    "fra": {
      "preferred_label": "Jean (Marc)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Compagnon de l'apôtre Paul, également appelé Marc. Traditionnellement considéré comme l'auteur de l'Évangile selon Marc."
        }
      ]
    },
    "spa": {
      "preferred_label": "Juan (Marcos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Compañero del apóstol Pablo, también llamado Marcos. Considerado tradicionalmente como el autor del Evangelio de Marcos."
        }
      ]
    },
    "arb": {
      "preferred_label": "يُوحَنَّا (مَرْقُسُ)",
      "descriptions": [
        {
          "source": "acai",
          "description": "رَفِيقٌ لِلرَّسُولِ بُولُسَ، يُدْعَى أَيْضًا مَرْقُسَ. يُعْتَبَرُ تَقْلِيدِيًّا كَاتِبَ إِنْجِيلِ مَرْقُسَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "约翰 (马可)",
      "descriptions": [
        {
          "source": "acai",
          "description": "使徒保罗的同工，又名马可。传统上被认为是马可福音的作者。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yohanna (Markus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Abokin tafiyar manzo Bulus, wanda ake kuma kira Markus. Bisa ga al’ada ana ɗaukarsa shi ne marubucin Linjilar Markus."
        }
      ]
    },
    "hin": {
      "preferred_label": "यूहन्ना (मरकुस)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रेरित पौलुस का एक साथी, जिसे मरकुस भी कहा जाता है। परंपरा के अनुसार उसे मरकुस के सुसमाचार का लेखक माना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yohanes (Markus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Teman seperjalanan rasul Paulus, yang juga disebut Markus. Secara tradisional dianggap sebagai penulis Injil Markus."
        }
      ]
    },
    "por": {
      "preferred_label": "João (Marcos)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um companheiro do apóstolo Paulo, também chamado Marcos. Tradicionalmente considerado o autor do Evangelho de Marcos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иоанн (Марк)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Спутник апостола Павла, также называемый Марком. Традиционно считается автором Евангелия от Марка."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yohana (Marko)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwandamani wa mtume Paulo, aitwaye pia Marko. Kijadi anachukuliwa kuwa mwandishi wa Injili ya Marko."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jon (Mak)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela poroman bilong aposel Pol, narapela nem bilong en em Mak. Pasin bilong bipo i tok em i man i bin raitim Gutnius bilong Mak."
        }
      ]
    },
    "apd": {
      "preferred_label": "يوحنا (مرقس)",
      "descriptions": [
        {
          "source": "acai",
          "description": "رفيق الرسول بولس، المسمى كمان مرقس. بحسب التقليد بيعتبر كاتب إنجيل مرقس."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jon (Mak)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man we i stap wokbaot wetem aposol Pol, we oli kolem tu se Mak. Folem kastom oli tingbaot hem se i man we i raetem Gospel blong Mak."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jọn (Mak)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye ya na onye ozi Pọl sojegharị, nke a na-akpọkwa Mak. Omenala weere ya dị ka onye dere Oziọma Mak."
        }
      ]
    },
    "nep": {
      "preferred_label": "यूहन्‍ना (मर्कूस)",
      "descriptions": [
        {
          "source": "acai",
          "description": "प्रेरित पावलका एक सहकर्मी, जसलाई मर्कूस पनि भनिन्छ। परम्परागत रूपमा मर्कूसको सुसमाचारका लेखक मानिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Giăng (Mác)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bạn đồng hành của sứ đồ Phao-lô, cũng được gọi là Mác. Theo truyền thống được coi là tác giả của Phúc Âm Mác."
        }
      ]
    },
    "zht": {
      "preferred_label": "約翰（馬可）",
      "descriptions": [
        {
          "source": "acai",
          "description": "使徒保羅的同工，又稱馬可。傳統上認為他是馬可福音的作者。"
        }
      ]
    }
  },
