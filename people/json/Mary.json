  "localizations": {
    "eng": {
      "preferred_label": "Mary (Mother of Jesus)",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Mary (Mother of Jesus)",
          "article": "person:Mary",
          "description": "Mother of Jesus and God the Son incarnate. She was a young Jewish woman chosen by God to conceive and give birth to Jesus through the power of the Holy Spirit while remaining a virgin."
        }
      ]
    },
    "fra": {
      "preferred_label": "Marie (mère de Jésus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mère de Jésus et de Dieu le Fils incarné. C'était une jeune femme juive choisie par Dieu pour concevoir et mettre au monde Jésus par la puissance du Saint-Esprit tout en restant vierge."
        }
      ]
    },
    "spa": {
      "preferred_label": "María (madre de Jesús)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Madre de Jesús y Dios el Hijo encarnado. Fue una joven judía elegida por Dios para concebir y dar a luz a Jesús por obra del Espíritu Santo siendo virgen."
        }
      ]
    },
    "arb": {
      "preferred_label": "مَرْيَم (أُمّ يَسُوع)",
      "descriptions": [
        {
          "source": "acai",
          "description": "أُمُّ يَسُوعَ وَاللهِ الابْنِ المُتَجَسِّدِ. كَانَتْ فَتَاةً يَهُودِيَّةً شَابَّةً اخْتَارَهَا اللهُ لِتَحْبَلَ وَتَلِدَ يَسُوعَ بِقُدْرَةِ الرُّوحِ القُدُسِ وَهِيَ عَذْرَاءُ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "马利亚（耶稣之母）",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶稣与道成肉身之神子的母亲。她是一位年轻的犹太女子，蒙神拣选，在仍为处女之身时藉着圣灵的大能怀孕并生下耶稣。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Maryamu (Mahaifiyar Yesu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mahaifiyar Yesu da Allah Ɗan mai ɗaukar surar mutum. Ita budurwa ce Bayahudiya da Allah ya zaɓa domin ta ɗauki ciki ta kuma haifi Yesu ta wurin ikon Ruhu Mai Tsarki tana budurwa."
        }
      ]
    },
    "hin": {
      "preferred_label": "मरियम (यीशु की माता)",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु और देहधारी परमेश्वर-पुत्र की माता। वह एक युवा यहूदी स्त्री थी जिसे परमेश्वर ने कुँवारी रहते हुए पवित्र आत्मा के सामर्थ्य से यीशु को गर्भ में धारण करने और जन्म देने के लिए चुना था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Maria (ibu Yesus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ibu Yesus dan Allah Anak yang berinkarnasi. Ia adalah seorang perempuan muda Yahudi yang dipilih oleh Allah untuk mengandung dan melahirkan Yesus melalui kuasa Roh Kudus saat masih perawan."
        }
      ]
    },
    "por": {
      "preferred_label": "Maria (mãe de Jesus)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mãe de Jesus e de Deus Filho encarnado. Era uma jovem judia escolhida por Deus para conceber e dar à luz Jesus pelo poder do Espírito Santo, permanecendo virgem."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мария (мать Иисуса)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Мать Иисуса и воплощенного Бога Сына. Она была молодой еврейской женщиной, избранной Богом зачать и родить Иисуса силой Святого Духа, оставаясь девой."
        }
      ]
    },
    "swh": {
      "preferred_label": "Mariamu (Mama yake Yesu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mama yake Yesu na Mungu Mwana aliyetwaa mwili. Alikuwa msichana wa Kiyahudi aliyechaguliwa na Mungu ili apate mimba na kumzaa Yesu kwa uwezo wa Roho Mtakatifu akiwa bado bikira."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Maria (mama bilong Jisas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mama bilong Jisas na God Pikinini i kamap man. Em i wanpela yangpela meri Juda em God i bin makim bilong kisim bel na karim Jisas long strong bilong Holi Spirit yet em i stap olsem wanpela virjin."
        }
      ]
    },
    "apd": {
      "preferred_label": "مريم (أم يسوع)",
      "descriptions": [
        {
          "source": "acai",
          "description": "أم يسوع والله الابن المتجسد. كانت شابة يهودية اختارها الله عشان تحبل وتلد يسوع بقدرة الروح القدس وهي عذراء."
        }
      ]
    },
    "bis": {
      "preferred_label": "Meri (Mama blong Jisas)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mama blong Jisas mo God Pikinini we i kamap man. Hem i wan yangfala woman Jiu we God i jusumaot hem blong i gat bel mo bonem Jisas tru long paoa blong Tabu Spirit taem hem i no save man yet."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Meri (nne Jisọs)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nne Jisọs na Chineke Ọkpara ahụ ghọrọ mmadụ. Ọ bụ nwaagbọghọ Juu nke Chineke họọrọ ịtụrụ ime na ịmụta Jisọs site nʼike nke Mmụọ Nsọ ma ka na-amaghị nwoke."
        }
      ]
    },
    "nep": {
      "preferred_label": "मरियम (येशूकी आमा)",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशू र देहधारी पुत्र परमेश्वरकी आमा। उनी कन्या छँदै पवित्र आत्माको सामर्थ्यद्वारा येशूलाई गर्भधारण गर्न र जन्म दिन परमेश्वरद्वारा चुनिएकी एक यहूदी युवती थिइन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ma-ri (mẹ Chúa Giê-xu)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mẹ của Chúa Giê-xu và Đức Chúa Con nhập thể. Bà là một thiếu nữ Do Thái được Đức Chúa Trời chọn để thụ thai và sinh Chúa Giê-xu bởi quyền năng của Đức Thánh Linh khi vẫn còn là một trinh nữ."
        }
      ]
    },
    "zht": {
      "preferred_label": "馬利亞（耶穌的母親）",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶穌（道成肉身之神子）的母親。她是蒙神揀選的年輕猶太女子，在仍為童女之時藉聖靈的能力懷孕生下耶穌。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
