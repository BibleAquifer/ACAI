  "localizations": {
    "eng": {
      "preferred_label": "Benaiah",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Benaiah",
          "article": "person:Benaiah",
          "description": "A warrior and military commander and priest during the reigns of King David and Solomon. He was the son of Jehoiada, the high priest."
        }
      ]
    },
    "fra": {
      "preferred_label": "Benaja",
      "descriptions": [
        {
          "source": "acai",
          "description": "Guerrier, commandant militaire et prêtre sous les règnes des rois David et Salomon. Il était le fils de Jehojada, le grand prêtre."
        }
      ]
    },
    "spa": {
      "preferred_label": "Benaías",
      "descriptions": [
        {
          "source": "acai",
          "description": "Guerrero, comandante militar y sacerdote durante los reinados de los reyes David y Salomón. Era hijo de Joiada, el sumo sacerdote."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَنَايَاهُو",
      "descriptions": [
        {
          "source": "acai",
          "description": "محارب وقائد جيش وكاهن في عهد الملكين داود وسليمان. وكان ابن يهوياداع، رئيس الكهنة."
        }
      ]
    },
    "zhs": {
      "preferred_label": "比拿雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "大卫王和所罗门统治时期的勇士、军事统帅兼祭司。他是大祭司耶何耶大的儿子。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Benahiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Jarumi, kwamandan soja, kuma firist a lokacin sarautar Sarki Dawuda da Solomon. Shi ɗan Yehohiyada ne, babban firist."
        }
      ]
    },
    "hin": {
      "preferred_label": "बनायाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊद और सुलैमान के शासनकाल के दौरान एक योद्धा, सैन्य कमांडर और याजक। वह महायाजक यहोयादा का पुत्र था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Benaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pahlawan, panglima militer, dan imam pada masa pemerintahan Raja Daud dan Salomo. Ia adalah putra dari Yoyada, sang imam besar."
        }
      ]
    },
    "por": {
      "preferred_label": "Benaia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Guerreiro, comandante militar e sacerdote durante os reinados dos reis Davi e Salomão. Ele era filho de Jeoiada, o sumo sacerdote."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ванея",
      "descriptions": [
        {
          "source": "acai",
          "description": "Воин, военачальник и священник во времена правления царей Давида и Соломона. Он был сыном первосвященника Иодая."
        }
      ]
    },
    "swh": {
      "preferred_label": "Benaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Shujaa, jemadari wa jeshi na kuhani wakati wa utawala wa Mfalme Daudi na Solomoni. Alikuwa mwana wa Yehoyada, kuhani mkuu."
        }
      ]
    },
    "apd": {
      "preferred_label": "بنايا",
      "descriptions": [
        {
          "source": "acai",
          "description": "محارب وقائد جيش وكاهن في عهد الملك داود وسليمان. كان ولد يهوياداع الكاهن العظيم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Benaea",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan soldia, komanda blong ami, mo pris long taem blong King Deved mo Solomon. Hem i pikinini boe blong Jehoeada, we i hae pris."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Benaya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dike nʼagha, ọchịagha, na onye nchụaja nʼoge ọchịchị Eze Devid na Solomọn. Ọ bụ nwa Jehoiada, bụ́ nnukwu onye nchụaja."
        }
      ]
    },
    "nep": {
      "preferred_label": "बनायाह",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा दाऊद र सोलोमनको शासनकालका एक योद्धा, सेनापति र पुजारी। उनी प्रधान पुजारी यहोयादाका छोरा थिए।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Benaia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela strongpela soldia na hetman bilong ami na pris long taim King Devit na Solomon i stap king. Em i pikinini man bilong Jehoiada, em hetpris."
        }
      ]
    },
    "vie": {
      "preferred_label": "Bê-na-gia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một chiến sĩ, chỉ huy quân đội và thầy tế lễ trong các triều đại của Vua Đa-vít và Sa-lô-môn. Ông là con trai của Giê-hô-gia-đa, vị thầy tế lễ thượng phẩm."
        }
      ]
    },
    "zht": {
      "preferred_label": "比拿雅",
      "descriptions": [
        {
          "source": "acai",
          "description": "大衛王與所羅門統治時期的勇士、軍隊統帥兼祭司。他是大祭司耶何耶大的兒子。"
        }
      ]
    }
  },
