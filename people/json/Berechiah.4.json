          "article": "person:Berechiah.4",
          "description": "A man from the tribe of Ephraim, mentioned in 2 Chronicles 28:12 as the son of Meshillemoth and a chief during the time of Ahaz."
        }
      ]
    },
    "fra": {
      "preferred_label": "Bérékia (2 Chroniques 28.12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Homme de la tribu d’Éphraïm, mentionné dans 2 Chroniques 28.12 comme fils de Meschillémoth et chef à l’époque d’Achaz."
        }
      ]
    },
    "spa": {
      "preferred_label": "Berequías (2 Crónicas 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre de la tribu de Efraín, mencionado en 2 Crónicas 28:12 como hijo de Mesillemoth y jefe durante el tiempo de Acaz."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَرَخْيَا (أخبار الأيام الثاني 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "رجل من سبط أفرايم، ذُكر في أخبار الأيام الثاني 28: 12 أنه ابن مَشُلِّيموت وكان رأسًا في عهد آحاز."
        }
      ]
    },
    "zhs": {
      "preferred_label": "比利迦 (历代志下 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法莲支派的一名男子，历代志下28:12中提及他是米实利末的儿子，是亚哈斯时期的首领。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Berekiya (2 Tarihi 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutum daga kabilar Efraim, wanda aka ambata a 2 Labarbaru 28:12 a matsayin ɗan Meshillemot kuma shugaba a zamanin Ahaz."
        }
      ]
    },
    "hin": {
      "preferred_label": "बेरेक्याह (2 इतिहास 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एप्रैम के गोत्र का एक पुरुष, जिसका उल्लेख 2 इतिहास 28:12 में मशिल्लेमोत के पुत्र और आहाज के समय के एक मुख्य पुरुष के रूप में किया गया है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Berekhya (2 Tawarikh 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang laki-laki dari suku Efraim, yang disebutkan dalam 2 Tawarikh 28:12 sebagai anak Mesilemot dan seorang pemimpin pada zaman Ahas."
        }
      ]
    },
    "por": {
      "preferred_label": "Berequias (2 Crônicas 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem da tribo de Efraim, mencionado em 2 Crônicas 28:12 como filho de Mesilemote e um líder durante o tempo de Acaz."
        }
      ]
    },
    "rus": {
      "preferred_label": "Берехия (2-я Паралипоменон 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Человек из колена Ефрема, упомянутый во 2 Паралипоменон 28:12 как сын Мешиллемофа и начальник во времена Ахаза."
        }
      ]
    },
    "swh": {
      "preferred_label": "Berekia (2 Mambo ya Nyakati 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mtu wa kabila la Efraimu, anayetajwa katika 2 Mambo ya Nyakati 28:12 kama mwana wa Meshilemothi na kiongozi wakati wa Ahazi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Berekia (2 Kronikel 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man bilong traip bilong Efraim, em 2 Stori 28:12 i tok em i pikinini bilong Mesilemot na em i wanpela bikman long taim bilong Ahas."
        }
      ]
    },
    "apd": {
      "preferred_label": "برخيا (أخبار الأيام الثاني 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل من قبيلة إفرايم، مذكور في أخبار الأيام التاني 28: 12 كابن لمشليموت ورئيس في زمن آحاز."
        }
      ]
    },
    "bis": {
      "preferred_label": "Berekia (2 Kronikol 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man blong laen blong Efrem, we 2 Kronikel 28:12 i tokbaot hem se hem i pikinini boe blong Mesilemot mo wan jif long taem blong Ahas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Berekaya (2 Akụkọ Ihe Gara Aga 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke sitere nʼebo Ifrem, nke a kpọtụrụ aha na 2 Ihe E Mere 28:12 dị ka nwa Meshilemot na onyeisi nʼoge Ahaz."
        }
      ]
    },
    "nep": {
      "preferred_label": "बेरेक्याह (2 इतिहास 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "एफ्राइमको कुलका एक पुरुष, जसलाई २ इतिहास २८:१२ मा मशिल्लेमोतका छोरा र आहाजको समयका एक अगुवा भनी उल्लेख गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Bê-rê-kia (2 Sử Ký 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người thuộc bộ tộc Ép-ra-im, được đề cập trong 2 Sử ký 28:12 là con trai của Mê-si-lê-mốt và là một thủ lĩnh vào thời A-cha."
        }
      ]
    },
    "zht": {
      "preferred_label": "比利家 (歷代志下 28:12)",
      "descriptions": [
        {
          "source": "acai",
          "description": "以法蓮支派的一名男子，歷代志下 28:12 提及他是米實利末的兒子，是亞哈斯在位時的一位族長。"
        }
      ]
    }
  },
