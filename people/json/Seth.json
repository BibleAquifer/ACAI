  "localizations": {
    "eng": {
      "preferred_label": "Seth",
      "alternate_labels": [
        "Sheth",
        "buttock"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Seth",
          "article": "person:Seth",
          "description": "Third son of Adam and Eve, the younger brother of Abel. He is listed in the family line of Jesus."
        }
      ]
    },
    "arb": {
      "preferred_label": "شِيث",
      "descriptions": [
        {
          "source": "acai",
          "description": "الابن الثالث لآدم وحواء، والأخ الأصغر لهابيل. ورد اسمه في نسب يسوع."
        }
      ]
    },
    "zhs": {
      "preferred_label": "塞特",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚当和夏娃的第三个儿子，亚伯的弟弟。他被列在耶稣的家谱中。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Seth",
      "descriptions": [
        {
          "source": "acai",
          "description": "Troisième fils d'Adam et Ève, frère cadet d'Abel. Il figure dans la généalogie de Jésus."
        }
      ]
    },
    "hau": {
      "preferred_label": "Set",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗa na uku na Adamu da Hawwa’u, ƙaramin ƙanin Habila. An jera shi a cikin layin zuriyar Yesu."
        }
      ]
    },
    "hin": {
      "preferred_label": "शेत",
      "descriptions": [
        {
          "source": "acai",
          "description": "आदम और हव्वा का तीसरा पुत्र, हाबिल का छोटा भाई। वह यीशु की वंशावली में सूचीबद्ध है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Set",
      "descriptions": [
        {
          "source": "acai",
          "description": "Putra ketiga Adam dan Hawa, adik laki-laki Habel. Ia terdaftar dalam garis keturunan Yesus."
        }
      ]
    },
    "por": {
      "preferred_label": "Sete",
      "descriptions": [
        {
          "source": "acai",
          "description": "Terceiro filho de Adão e Eva, irmão mais novo de Abel. Ele está listado na genealogia de Jesus."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сиф",
      "descriptions": [
        {
          "source": "acai",
          "description": "Третий сын Адама и Евы, младший брат Авеля. Он числится в родословии Иисуса."
        }
      ]
    },
    "spa": {
      "preferred_label": "Set",
      "descriptions": [
        {
          "source": "acai",
          "description": "Tercer hijo de Adán y Eva, hermano menor de Abel. Figura en la genealogía de Jesús."
        }
      ]
    },
    "swh": {
      "preferred_label": "Sethi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa tatu wa Adamu na Hawa, ndugu mdogo wa Habili. Ameorodheshwa katika ukoo wa Yesu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Set",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba 3 pikinini man bilong Adam wantaim Iv, na em i liklik brata bilong Abel. Em i stap long lain tumbuna bilong Jisas."
        }
      ]
    },
    "apd": {
      "preferred_label": "شيث",
      "descriptions": [
        {
          "source": "acai",
          "description": "الولد التالت لآدم وحواء، والأخو الأصغر لهابيل. ومذكور في سلسلة نسب يسوع."
        }
      ]
    },
    "bis": {
      "preferred_label": "Set",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba tri pikinini boe blong Adam mo Iv, smol brata blong Ebel. Nem blong hem i stap long laen blong Jisas."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Set",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwoke nke atọ nke Adam na Iiv mụtara, nwanne Ebel nke nta. E depụtara ya nʼagbụrụ Jisọs."
        }
      ]
    },
    "nep": {
      "preferred_label": "शेत",
      "descriptions": [
        {
          "source": "acai",
          "description": "आदम र हव्वाका तेस्रो छोरा, हाबिलका कान्छा भाइ। येशूको वंशावलीमा उहाँको नाम उल्लेख गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Sết",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai thứ ba của A-đam và Ê-va, em trai của A-bên. Ông được liệt kê trong dòng dõi của Chúa Cứu Thế Giê-xu."
        }
      ]
    },
    "zht": {
      "preferred_label": "塞特",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞當和夏娃的第三個兒子，亞伯的弟弟。他被列在耶穌的家譜中。"
        }
      ]
    }
  },
