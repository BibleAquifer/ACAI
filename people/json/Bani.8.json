  "localizations": {
    "eng": {
      "preferred_label": "Bani",
      "alternate_labels": [
        "Binnui"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Bani",
          "article": "person:Bani.8",
          "description": "A Levite living at the time of exile and return of the the Israelites. He was also called Binnui."
        }
      ]
    },
    "arb": {
      "preferred_label": "بَانِي",
      "descriptions": [
        {
          "source": "acai",
          "description": "لَاوِيٌّ عَاشَ فِي زَمَنِ سَبْيِ ٱلْإِسْرَائِيلِيِّينَ وَرُجُوعِهِمْ. كَانَ يُدْعَى أَيْضًا بَنّوي."
        }
      ]
    },
    "zhs": {
      "preferred_label": "巴尼",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人被掳与归回时期的一名利未人。他也称为宾内。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Bani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Lévite vivant à l'époque de l'exil et du retour des Israélites. Il était également appelé Binnuï."
        }
      ]
    },
    "hau": {
      "preferred_label": "Bani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani Balarawi da ya rayu a lokacin ƙaura da dawowar Isra'ilawa. An kuma kira shi Binnuyi."
        }
      ]
    },
    "hin": {
      "preferred_label": "बानी",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलियों की बंधुवाई और वापसी के समय रहने वाला एक लेवीय पुरुष। उसे बिन्नूई भी कहा गया था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Bani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang Lewi yang hidup pada masa pembuangan dan pemulangan orang Israel. Dia juga disebut Binui."
        }
      ]
    },
    "por": {
      "preferred_label": "Bani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um levita que viveu na época do exílio e retorno dos israelitas. Ele também era chamado de Binui."
        }
      ]
    },
    "rus": {
      "preferred_label": "Вания",
      "descriptions": [
        {
          "source": "acai",
          "description": "Левит, живший во времена изгнания и возвращения израильтян. Его также называли Биннуй."
        }
      ]
    },
    "spa": {
      "preferred_label": "Baní",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un levita que vivió en la época del exilio y el retorno de los israelitas. También era llamado Binuy."
        }
      ]
    },
    "swh": {
      "preferred_label": "Bani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mlawi aliyeishi wakati wa uhamisho na kurejea kwa Waisraeli. Pia aliitwa Binui."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Bani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man Livai i bin stap long taim bilong ol Israel i go kalabus na kam bek. Ol i bin kolim em tu olsem Binui."
        }
      ]
    },
    "apd": {
      "preferred_label": "باني",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل لاوي عاش في زمن سبي ورجوع بني إسرائيل. وكان بيتسمى كمان بنوي."
        }
      ]
    },
    "bis": {
      "preferred_label": "Bani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan Livaet we i laef long taem we ol man Isrel oli stap long kalabus mo oli kambak. Nem blong hem Binui tu."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Bani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye Livayị dịrị ndụ nʼoge a dọọrọ ndị Izrel nʼagha na nloghachi ha. A na-akpọkwa ya Binui."
        }
      ]
    },
    "nep": {
      "preferred_label": "बानी",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलीहरूको निर्वासन र पुनर्स्थापनाको समयमा बस्ने एक लेवी। तिनलाई बिन्नूई पनि भनिन्थ्यो।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ba-ni",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người Lê-vi sống vào thời kỳ lưu đày và hồi hương của người Y-sơ-ra-ên. Ông cũng được gọi là Bin-nui."
        }
      ]
    },
    "zht": {
      "preferred_label": "巴尼",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人流亡與回歸時期的一位利未人。他又名為賓內。"
        }
      ]
    }
  },
