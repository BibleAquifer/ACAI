  "localizations": {
    "eng": {
      "preferred_label": "Adrammelech (2 Kings 19:37)",
      "alternate_labels": [
        "Adrammelek"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Adrammelech (2 Kings 19:37)",
          "article": "person:Adrammelech.2",
          "description": "A man and son of Sennacherib, king of Assyria, who, together with his brother Sharezer, killed their father."
        }
      ]
    },
    "fra": {
      "preferred_label": "Adrammélec (2 Rois 19.37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils de Sanchérib, roi d’Assyrie, qui, avec son frère Scharetser, tua son père."
        }
      ]
    },
    "spa": {
      "preferred_label": "Adramelec (2 Reyes 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hombre e hijo de Senaquerib, rey de Asiria, que junto con su hermano Sarezer mató a su padre."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَدْرَمَّلَكُ (الملوك الثاني 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "رَجُلٌ وَابْنُ سَنْحَارِيبَ مَلِكِ أَشُورَ، قَتَلَ أَبَاهُ بِالسَّيْفِ مَعَ أَخِيهِ شَرَآصَرَ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚得米勒 (列王纪下 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "亚述王西拿基立的儿子，与兄弟沙利色一同弑父。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Adrammelek (2 Sarakuna 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wani mutum kuma ɗan Sennakerib sarkin Assuriya, wanda tare da ɗan’uwansa Sharezer, suka kashe mahaifinsu."
        }
      ]
    },
    "hin": {
      "preferred_label": "अद्रम्मेलेक (2 राजाओं 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अशूर के राजा सन्हेरीब का एक पुत्र, जिसने अपने भाई शरेसेर के साथ मिलकर अपने पिता की हत्या कर दी थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Adramelekh (2 Raja-raja 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang pria dan putra Sanherib, raja Asyur, yang bersama saudaranya, Sarezer, membunuh ayah mereka."
        }
      ]
    },
    "por": {
      "preferred_label": "Adrameleque (2 Reis 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um homem e filho de Senaqueribe, rei da Assíria, que, juntamente com seu irmão Sarezer, matou seu pai."
        }
      ]
    },
    "rus": {
      "preferred_label": "Адрамелех (4-я Царств 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын Сеннахирима, царя Ассирии, который вместе со своим братом Шарецером убил своего отца."
        }
      ]
    },
    "swh": {
      "preferred_label": "Adrameleki (2 Wafalme 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwanamume na mwana wa Senakeribu, mfalme wa Ashuru, ambaye pamoja na nduguye Shareza, walimuua baba yao."
        }
      ]
    },
    "apd": {
      "preferred_label": "أدرملك (الملوك الثاني 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "راجل وولد سنحاريب ملك أشور، مع أخوه شراصر كتلو أبوهم."
        }
      ]
    },
    "bis": {
      "preferred_label": "Adramelek (2 Kings 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan man mo pikinini boe blong Senakerib, king blong Asiria, we wetem brata blong hem Sareja, tufala i kilim papa blong tufala i ded."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Adramelek (2 Ndị Eze 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwoke na nwa Senakerib, eze Asiria, nke ya na nwanne ya nwoke Shareza gburu nna ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "अद्रम्मलेक (2 राजा 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "अश्शूरका राजा सन्हेरीबका एक छोरा, जसले आफ्ना भाइ शरेसेरसँग मिलेर आफ्ना बुबाको हत्या गरे।"
        }
      ]
    },
    "tpi": {
      "preferred_label": "Adramelek (2 King 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela man na pikinini man bilong Senakerip, king bilong Asiria, em wantaim brata bilong en Sareser tupela i kilim i dai papa bilong tupela."
        }
      ]
    },
    "vie": {
      "preferred_label": "A-tra-mê-léc (2 Các Vua 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của San-kê-ríp, vua A-sy-ri, người cùng với em/anh trai là Sa-rết-sê đã giết cha mình."
        }
      ]
    },
    "zht": {
      "preferred_label": "亞得米勒 (列王紀下 19:37)",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞述王西拿基立的兒子，與兄弟沙利色一同弒父。"
        }
      ]
    }
  },
