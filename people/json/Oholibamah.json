        "Aholibamah"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Oholibamah",
          "article": "person:Oholibamah",
          "description": "A Canaanite and daughter of Anah, wife of Esau, and mother of Jeush, Jalam, and Korah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Oholibama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cananéenne, fille d’Ana, femme d’Ésaü et mère de Jéusch, Jaelam et Koré."
        }
      ]
    },
    "spa": {
      "preferred_label": "Aholibama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Cananea e hija de Aná, esposa de Esaú y madre de Jeús, Jalán y Coré."
        }
      ]
    },
    "arb": {
      "preferred_label": "أُهُولِيبَامَةُ",
      "descriptions": [
        {
          "source": "acai",
          "description": "كنعانية وابنة عنى، وزوجة عيسو، وأم يعوش ويعلام وقورح."
        }
      ]
    },
    "zhs": {
      "preferred_label": "阿何利巴玛",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦南女子，亚拿的女儿，以扫的妻子，也是耶乌施、雅兰和可拉的母亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Oholibama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bakan'aniyya kuma 'yar Ana, matar Isuwa, da kuma uwar Yewush, Yalam, da Kora."
        }
      ]
    },
    "hin": {
      "preferred_label": "ओहोलीबामा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक कनानी स्त्री और अना की बेटी, एसाव की पत्नी, और यूश, यालाम तथा कोरह की माता।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Oholibama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Seorang perempuan Kanaan dan anak perempuan Ana, istri Esau, serta ibu dari Yeush, Yaelam, dan Korah."
        }
      ]
    },
    "por": {
      "preferred_label": "Oolibama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Uma cananeia e filha de Aná, esposa de Esaú e mãe de Jeús, Jalão e Corá."
        }
      ]
    },
    "rus": {
      "preferred_label": "Оливема",
      "descriptions": [
        {
          "source": "acai",
          "description": "Хананеянка, дочь Аны, жена Исава и мать Иеуса (Иеуша), Иеглома и Корея."
        }
      ]
    },
    "swh": {
      "preferred_label": "Oholibama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mkananayo na binti wa Ana, mke wa Esau, na mama wa Yeushi, Yalamu, na Kora."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Oholibama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela meri Kenan na pikinini meri bilong Ana, meri bilong Iso, na mama bilong Jeus, Jalam, na Kora."
        }
      ]
    },
    "apd": {
      "preferred_label": "أُهُولِيبامَة",
      "descriptions": [
        {
          "source": "acai",
          "description": "كَنْعانِيَّة وبِنْت عَنَى، زَوْجَة عِيسو، وأُمّ يَعُوش ويَعْلام وقُورَح."
        }
      ]
    },
    "bis": {
      "preferred_label": "Oholibama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan woman Kenan mo dota blong Anaha, waef blong Esao, mo mama blong Jehus, Jalam, mo Kora."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Oholibama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Onye Kenan na nwa nwanyị Ana, nwunye Ịsọ, na nne Jeush, Jalam, na Kora."
        }
      ]
    },
    "nep": {
      "preferred_label": "ओहोलीबामा",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक कनानी स्त्री, जो अनाकी छोरी, एसावकी पत्नी, र येऊश, यालाम तथा कोरहकी आमा थिइन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ô-hô-li-ba-ma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một người phụ nữ Ca-na-an và là con gái của A-na, vợ của Ê-sau, và là mẹ của Giê-úc, Gia-lam và Cô-ra."
        }
      ]
    },
    "zht": {
      "preferred_label": "阿何利巴瑪",
      "descriptions": [
        {
          "source": "acai",
          "description": "迦南人，亞拿的女兒，以掃的妻子，耶烏施、雅蘭和可拉的母親。"
        }
      ]
    }
  },
