  "localizations": {
    "eng": {
      "preferred_label": "Esau",
      "alternate_labels": [
        "Edom"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Esau",
          "article": "person:Esau",
          "description": "First-born son of the patriarch Isaac and Rebekah, and the older twin brother of Jacob. Esau sold his birthright for a bowl of lentil stew. He is considered the ancestor of the Edomites."
        }
      ]
    },
    "arb": {
      "preferred_label": "عِيسُو",
      "descriptions": [
        {
          "source": "acai",
          "description": "الابن البكر لإسحاق ورفقة، والأخ التوأم الأكبر ليعقوب. باع عيسو بكوريته مقابل حساء عدس، ويُعتبر جد الأدوميين."
        }
      ]
    },
    "zhs": {
      "preferred_label": "以扫",
      "descriptions": [
        {
          "source": "acai",
          "description": "族长以撒和利百加的长子，雅各的双胞胎哥哥。以扫为了一碗红豆汤卖掉了长子的名分。他被视为以东人的祖先。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Ésaü",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils premier-né du patriarche Isaac et de Rebecca, et frère jumeau aîné de Jacob. Ésaü vendit son droit d’aînesse pour un plat de lentilles. Il est considéré comme l’ancêtre des Édomites."
        }
      ]
    },
    "hau": {
      "preferred_label": "Isuwa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan fari na uban iyali Ishaku da Rebeka, kuma ɗan’uwan tagwayen Yaƙub wanda ya girme shi. Isuwa ya sayar da matsayinsa na ɗan fari domin kwanon dafen lenti. Ana ɗaukarsa a matsayin kakan Edomawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "एसाव",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता इसहाक और रिबका का पहलौठा पुत्र, और याकूब का जुड़वाँ बड़ा भाई। एसाव ने मसूर के दाल के एक कटोरे के बदले अपना पहलौठे का अधिकार बेच दिया था। वह एदोमियों का पूर्वज माना जाता है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Esau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak sulung dari bapa leluhur Ishak dan Ribka, serta saudara kembar Yakub yang lebih tua. Esau menjual hak kesulungannya demi semangkuk sup kacang merah. Ia dianggap sebagai nenek moyang orang Edom."
        }
      ]
    },
    "por": {
      "preferred_label": "Esaú",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho primogênito do patriarca Isaque e de Rebeca, e irmão gêmeo mais velho de Jacó. Esaú vendeu seu direito de primogenitura por um prato de ensopado de lentilhas. Ele é considerado o antepassado dos edomitas."
        }
      ]
    },
    "rus": {
      "preferred_label": "Исав",
      "descriptions": [
        {
          "source": "acai",
          "description": "Первенец патриарха Исаака и Ревекки, старший брат-близнец Иакова. Исав продал свое первородство за чечевичную похлебку. Он считается предком идумеев (едомлян)."
        }
      ]
    },
    "spa": {
      "preferred_label": "Esaú",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo primogénito del patriarca Isaac y Rebeca, y hermano gemelo mayor de Jacob. Esaú vendió su primogenitura por un plato de guisado de lentejas. Es considerado el antepasado de los edomitas."
        }
      ]
    },
    "swh": {
      "preferred_label": "Esau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa kwanza wa patriarki Isaka na Rebeka, na ndugu pacha mkubwa wa Yakobo. Esau aliuza haki yake ya mzaliwa wa kwanza kwa bakuli la mchuzi wa dengu. Anachukuliwa kuwa babu wa Waedomu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Iso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Namba wan pikinini man bilong hetman Aisak wantaim Rebeka, na bikpela kambang brata bilong Jekop. Iso i bin salim namba bilong em olsem namba wan pikinini bilong kisim wanpela plet supsup. Ol i tingim em olsem tumbuna bilong ol Idom."
        }
      ]
    },
    "apd": {
      "preferred_label": "عِيسُو",
      "descriptions": [
        {
          "source": "acai",
          "description": "الولد البكر للبطريرك إسحاق ورفقة، والأخ التوأم الأكبر ليعقوب. عيسو باع بكوريته بصحن عدس. وبيعتبر جد الأدوميين."
        }
      ]
    },
    "bis": {
      "preferred_label": "Esao",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fasbon pikinini boe blong patriaka Aesak wetem Rebeka, mo brata blong Jekob we tufala i kamaot tugeta (twin). Esao i salem raet blong hem olsem fasbon from wan plet supsup. Hem i olfala blong ol man Edom."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ịsọ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ọkpara nna ochie bụ Aịzik na Ribeka, na nwanne ejima Jacob nke tọrọ ya. Ịsọ rere ọnọdụ ọkpara ya nʼihi efere ofe lentil. A na-ewere ya dị ka nna nna ndị Idọm."
        }
      ]
    },
    "nep": {
      "preferred_label": "एसाव",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिता इसहाक र रिबकाका जेठा छोरा तथा याकूबका जुम्ल्याहा दाजु। एसावले एक कचौरा दालको झोलका लागि आफ्नो ज्येष्ठ-अधिकार बेचेका थिए। उनलाई एदोमीहरूका पुर्खा मानिन्छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Ê-sau",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai trưởng của tổ phụ Y-sác và Rê-bê-ca, và là anh song sinh của Gia-cốp. Ê-sau đã bán quyền trưởng nam của mình để đổi lấy một bát canh đậu đỏ. Ông được coi là tổ phụ của dân Ê-đôm."
        }
      ]
    },
    "zht": {
      "preferred_label": "以掃",
      "descriptions": [
        {
          "source": "acai",
          "description": "族長以撒與利百加的長子，也是雅各的雙胞胎哥哥。以掃為了一碗紅豆湯賣掉了長子的名分。他被認為是以東人的先祖。"
        }
      ]
    }
  },
