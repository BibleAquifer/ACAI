  "localizations": {
    "eng": {
      "preferred_label": "Zechariah (2 Chronicles 24:20)",
      "alternate_labels": [
        "Zacharias"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Zechariah (2 Chronicles 24:20)",
          "article": "person:Zechariah.12",
          "description": "Zechariah, also known as Zacharias, was a priest and son of Jehoiada living during the divided kingdom, mentioned in 2 Chronicles 24:20."
        }
      ]
    },
    "arb": {
      "preferred_label": "زَكَرِيَّا (أخبار الأيام الثاني 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "كان زَكَرِيَّا كاهِنًا وابنًا لِيَهويَادَاعَ عاشَ في عَهدِ المَملَكَةِ المُنقَسِمَةِ، مَذكورًا في أَخبارِ الأَيّامِ الثّاني 24: 20."
        }
      ]
    },
    "zhs": {
      "preferred_label": "撒迦利亚 (历代志下 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "撒迦利亚（又作撒迦利雅）是一位祭司，耶何耶大的儿子，生活在分裂王国时期，见于历代志下24:20。"
        }
      ]
    },
    "fra": {
      "preferred_label": "Zacharie (2 Chroniques 24.20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zacharie, également appelé Zacharias, était un prêtre et fils de Jehojada ayant vécu à l'époque du royaume divisé, mentionné dans 2 Chroniques 24:20."
        }
      ]
    },
    "hau": {
      "preferred_label": "Zakariya (2 Tarihi 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zakariya, wanda kuma aka sani da Zakariyas, firist ne kuma ɗan Yehohiyada da ya rayu a lokacin rabuwar mulki, wanda aka ambata a 2 Labarbaru 24:20."
        }
      ]
    },
    "hin": {
      "preferred_label": "जकर्याह (2 इतिहास 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "जकर्याह, जिसे जकरियास भी कहा जाता है, एक याजक और यहोयादा का पुत्र था जो विभाजित राज्य के काल में रहता था; उसका उल्लेख 2 इतिहास 24:20 में है।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Zakharia (2 Tawarikh 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zakharia, yang juga dikenal sebagai Zakharias, adalah seorang imam dan anak Yoyada yang hidup pada masa kerajaan terpecah, disebutkan dalam 2 Tawarikh 24:20."
        }
      ]
    },
    "por": {
      "preferred_label": "Zacarias (2 Crônicas 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zacarias foi um sacerdote e filho de Jeoiada que viveu durante o reino dividido, mencionado em 2 Crônicas 24:20."
        }
      ]
    },
    "rus": {
      "preferred_label": "Захария (2-я Паралипоменон 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Захария — священник и сын Иодая, живший в период разделенного царства, упомянутый во 2 Паралипоменон 24:20."
        }
      ]
    },
    "spa": {
      "preferred_label": "Zacarías (2 Crónicas 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zacarías fue un sacerdote e hijo de Joiada que vivió durante el reino dividido, mencionado en 2 Crónicas 24:20."
        }
      ]
    },
    "swh": {
      "preferred_label": "Zekaria (2 Mambo ya Nyakati 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zekaria, anayejulikana pia kama Zakaria, alikuwa kuhani na mwana wa Yehoyada aliyeishi wakati wa ufalme uliogawanyika, anayetajwa katika 2 Mambo ya Nyakati 24:20."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Sekaraia (2 Kronikel 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sekaraia em i wanpela pris na pikinini man bilong Jehoiada em i bin stap long taim bilong kingdom i bruhinaiti, em 2 Stori 24:20 i kolim nem bilong em."
        }
      ]
    },
    "apd": {
      "preferred_label": "زكريا (أخبار الأيام الثاني 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "زكريا، المعروف كمان بزخرياس، كان كاهن وولد يهوياداع عاش وكت انقسام المملكة، ومذكور في أخبار الأيام التاني 24: 20."
        }
      ]
    },
    "bis": {
      "preferred_label": "Sekaraea (2 Kronikol 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Sekaraea (we nem blong hem Zakarias tu) hem i wan pris mo pikinini man blong Jehoeada we i laef long taem we kingdom i seraot, we Baebol i tokbaot hem long 2 Kronikel 24:20."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Zekaraya (2 Akụkọ Ihe Gara Aga 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Zekaraya, nke a makwaara dị ka Zakarias, bụ onye nchụaja na nwa Jehoiada nke dịrị ndụ nʼoge alaeze ahụ kewara ekewa, nke a kpọtụrụ aha na 2 Ihe E Mere 24:20."
        }
      ]
    },
    "nep": {
      "preferred_label": "जकरिया (2 इतिहास 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "जकरिया (जकरियास पनि भनिने) विभाजित राज्यको समयमा बस्ने यहोयादाका छोरा र पुजारी थिए, जसको उल्लेख २ इतिहास २४:२० मा गरिएको छ।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Xa-cha-ri (2 Sử Ký 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Xa-cha-ri, cũng gọi là Zacharias, là một thầy tế lễ và là con trai của Giê-hô-gia-đa, sống trong thời kỳ vương quốc phân chia, được nhắc đến trong 2 Sử Ký 24:20."
        }
      ]
    },
    "zht": {
      "preferred_label": "撒迦利亞 (歷代志下 24:20)",
      "descriptions": [
        {
          "source": "acai",
          "description": "撒迦利亞（又作撒迦利亞斯）是一位祭司，也是耶何耶大的兒子，生活於王國分裂時期，記載於歷代志下 24:20。"
        }
      ]
    }
  },
