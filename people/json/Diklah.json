        }
      ]
    },
    "hin": {
      "preferred_label": "दिक्ला",
      "descriptions": [
        {
          "source": "acai",
          "description": "कुलपिताओं के समय का एक पुरुष दिक्ला, योक्तान का पुत्र और शेम का वंशज था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Dikla",
      "descriptions": [
        {
          "source": "acai",
