        }
      ]
    },
    "vie": {
      "preferred_label": "Xê-rết",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vợ của Ha-man, một quan chức dưới thời Vua A-ha-suê-ru vào thời Hoàng hậu Ê-xơ-tê."
        }
      ]
    },
    "zht": {
      "preferred_label": "細利斯",
