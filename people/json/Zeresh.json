        }
      ]
    },
    "nep": {
      "preferred_label": "जेरेश",
      "descriptions": [
        {
          "source": "acai",
          "description": "रानी एस्तरको समयमा राजा अहासूरसका अधिकारी हामानकी पत्नी।"
        }
      ]
    },
    "swh": {
      "preferred_label": "Zereshi",
      "descriptions": [
        {
          "source": "acai",
