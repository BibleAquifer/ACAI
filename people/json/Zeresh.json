        }
      ]
    },
    "tpi": {
      "preferred_label": "Seres",
      "descriptions": [
        {
          "source": "acai",
          "description": "Meri bilong Haman, wanpela bikman bilong King Ahasuerus, long taim bilong Kwin Esta."
        }
      ]
    },
    "apd": {
      "preferred_label": "زرش",
      "descriptions": [
        {
          "source": "acai",
          "description": "مرت هامان، مسؤول الملك أحشويروش، في زمن الملكة أستير."
