      ]
    },
    "bis": {
      "preferred_label": "Seres",
      "descriptions": [
        {
          "source": "acai",
          "description": "Woman blong ofisel blong King Ahasweros we nem blong hem Haman long taem blong Kwin Ester."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Zeresh",
      "descriptions": [
        {
          "source": "acai",
