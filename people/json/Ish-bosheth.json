  "localizations": {
    "eng": {
      "preferred_label": "Ish-bosheth",
      "alternate_labels": [
        "Eshbaal"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ish-Bosheth",
          "article": "person:Ish-bosheth",
          "description": "Son of King Saul who reigned two years over Israel, while David was king at Hebron over Judah. He was assassinated by Rechab and Baanah."
        }
      ]
    },
    "zhs": {
      "preferred_label": "伊施‧波设",
      "descriptions": [
        {
          "source": "acai",
          "description": "扫罗王的儿子。大卫在希伯仑作犹大王期间，他作以色列王两年。他被利甲和巴拿暗杀。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Ish-Boshet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan Sarki Shawulu wanda ya yi mulki shekara biyu a kan Isra’ila, yayin da Dawuda yake sarki a Hebron a kan Yahuda. Rekab da Ba’ana suka kashe shi."
        }
      ]
    },
    "hin": {
      "preferred_label": "ईशबोशेत",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा शाऊल का पुत्र जिसने इस्राएल पर दो वर्ष राज्य किया, जबकि दाऊद हेब्रोन में यहूदा पर राजा था। रेकाब और बाना ने उसकी हत्या कर दी थी।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Isyboset",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anak Raja Saul yang memerintah selama dua tahun atas Israel, sementara Daud menjadi raja di Hebron atas Yehuda. Ia dibunuh oleh Rekhab dan Baana."
        }
      ]
    },
    "por": {
      "preferred_label": "Isbosete",
      "descriptions": [
        {
          "source": "acai",
          "description": "Filho do rei Saul que reinou dois anos sobre Israel, enquanto Davi era rei em Hebrom sobre Judá. Ele foi assassinado por Recabe e Baaná."
        }
      ]
    },
    "spa": {
      "preferred_label": "Isboset",
      "descriptions": [
        {
          "source": "acai",
          "description": "Hijo del rey Saúl que reinó dos años sobre Israel, mientras David era rey en Hebrón sobre Judá. Fue asesinado por Recab y Baana."
        }
      ]
    },
    "swh": {
      "preferred_label": "Ish-boshethi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mwana wa Mfalme Sauli aliyetawala miaka miwili juu ya Israeli, Daudi alipokuwa mfalme huko Hebroni juu ya Yuda. Aliuawa na Rekabu na Baana."
        }
      ]
    },
    "apd": {
      "preferred_label": "إيشبوشث",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن الملك شاول الملك لمدة سنتين على إسرائيل، وكت ما كان داود ملك في حبرون على يهوذا. اغتالوه ركاب وبعنة."
        }
      ]
    },
    "arb": {
      "preferred_label": "إِيشْبُوشَث",
      "descriptions": [
        {
          "source": "acai",
          "description": "ابن الملك شاول الذي ملك سنتين على إسرائيل، بينما كان داود ملكًا في حبرون على يهوذا. اغتاله ركاب وبعنة."
        }
      ]
    },
    "bis": {
      "preferred_label": "Isboset",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini boe blong King Sol we i rula tu yia long Isrel, taem Deved i stap king long Hebron long saed blong Juda. Rekab mo Baana tufala i kilim hem i ded."
        }
      ]
    },
    "fra": {
      "preferred_label": "Isch-Boscheth",
      "descriptions": [
        {
          "source": "acai",
          "description": "Fils du roi Saül qui régna deux ans sur Israël, tandis que David était roi sur Juda à Hébron. Il fut assassiné par Récab et Baana."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ishboshet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa Eze Sọl nke chịrị Izrel afọ abụọ, mgbe Devid bụ eze na Hebrọn nʼelu Juda. Rekab na Baana gburu ya."
        }
      ]
    },
    "nep": {
      "preferred_label": "ईश्‍बोशेत",
      "descriptions": [
        {
          "source": "acai",
          "description": "राजा शाऊलका छोरा जसले इस्राएलमाथि दुई वर्ष शासन गरे, जतिबेला दाऊद हेब्रोनमा यहूदामाथि राजा थिए। रेकाब र बानाहद्वारा उनको हत्या गरिएको थियो।"
        }
      ]
    },
    "rus": {
      "preferred_label": "Иевосфей",
      "descriptions": [
        {
          "source": "acai",
          "description": "Сын царя Саула, царствовавший два года над Израилем, в то время как Давид был царём в Хевроне над Иудеей. Был убит Рихавом и Бааной."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Isboset",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pikinini man bilong King Sol em i bin stap king bilong Israel inap long tupela yia, long taim Devit i stap king long Hebron bilong lain Juda. Rekap na Baana i bin kilim em i dai."
        }
      ]
    },
    "vie": {
      "preferred_label": "Ích-bô-sết",
      "descriptions": [
        {
          "source": "acai",
          "description": "Con trai của Vua Sau-lơ, trị vì hai năm trên Y-sơ-ra-ên trong khi Đa-vít làm vua tại Hếp-rôn trên Giu-đa. Ông bị Rê-cáp và Ba-a-na ám sát."
        }
      ]
    },
    "zht": {
      "preferred_label": "伊施波設",
      "descriptions": [
        {
          "source": "acai",
          "description": "掃羅王的兒子，在大衛於希伯崙作猶大王時，作以色列王二年。他被利甲和巴拿刺殺。"
        }
      ]
    }
  },
