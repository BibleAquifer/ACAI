  "localizations": {
    "eng": {
      "preferred_label": "Jael",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jael",
          "article": "person:Jael",
          "description": "The wife of Heber the Kenite who killed Sisera the commander of King Jabin's forces during the time of Israel's judge Deborah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Jaël",
      "descriptions": [
        {
          "source": "acai",
          "description": "Femme de Héber le Kénien, qui tua Sisera, chef de l'armée du roi Jabin, à l'époque de la juge Débora en Israël."
        }
      ]
    },
    "spa": {
      "preferred_label": "Jael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Esposa de Héber el quenita que mató a Sísara, el comandante de las fuerzas del rey Jabín, durante la época de la jueza israelita Débora."
        }
      ]
    },
    "arb": {
      "preferred_label": "يَاعِيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "زوجة حابر القيني التي قتلت سيسرا قائد جيش الملك يابين في زمن دبورة قاضية إسرائيل."
        }
      ]
    },
    "zhs": {
      "preferred_label": "雅亿",
      "descriptions": [
        {
          "source": "acai",
          "description": "基尼人希伯的妻子。在以色列士师底波拉时代，她杀死了耶宾王军队的指挥官西西拉。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Yayel",
      "descriptions": [
        {
          "source": "acai",
          "description": "Matar Heber Bakene wadda ta kashe Sisera kwamandan rundunar Sarki Yabin a zamanin Deborah alƙalin Isra’ila."
        }
      ]
    },
    "hin": {
      "preferred_label": "याएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेबेर केनी की पत्नी जिसने इस्राएल की नबीया दबोरा के समय राजा याबीन की सेना के सेनापति सीसरा को मार डाला था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Yael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Istri Heber, orang Keni itu, yang membunuh Sisera, panglima tentara Raja Yabin, pada zaman Debora, hakim Israel."
        }
      ]
    },
    "por": {
      "preferred_label": "Jael",
      "descriptions": [
        {
          "source": "acai",
          "description": "A esposa de Héber, o queneu, que matou Sísera, o comandante das forças do rei Jabim, durante o tempo da juíza Débora de Israel."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иаиль",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жена Хевера Кенеянина, убившая Сисару, военачальника царя Иавина, во времена израильской судьи Деворы."
        }
      ]
    },
    "swh": {
      "preferred_label": "Yaeli",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mke wa Heberi Mkeni aliyemuua Sisera kamanda wa majeshi ya Mfalme Yabini wakati wa mwamuzi wa Israeli Debora."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Jael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Meri bilong Heber, dispela man bilong lain bilong Kin. Em i kilim i dai Sisera, koman bilong ol ami bilong King Jabin, long taim bilong Debora em jas bilong Israel."
        }
      ]
    },
    "apd": {
      "preferred_label": "ياعيل",
      "descriptions": [
        {
          "source": "acai",
          "description": "مرت حابر القيني الكتلت سيسرا قائد جيش الملك يابين في زمن دبورة قاضية إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Jael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Woman blong Heba we i man Ken, we i kilim Sisera we i komanda blong ol ami blong King Jabin long taem we Deborah i jaj blong Isrel."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Jael",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwunye Heba onye Ken nke gburu Sisera bụ onyeisi ndị agha eze Jabin n'oge Debora bụ ọkàikpe Izrel."
        }
      ]
    },
    "nep": {
      "preferred_label": "याएल",
      "descriptions": [
        {
          "source": "acai",
          "description": "केनी हेबेरकी पत्‍नी जसले इस्राएलकी न्यायकर्ता दबोराको समयमा राजा याबीनको सेनाका सेनापति सीसरालाई मारिन्।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Gia-ên",
      "descriptions": [
        {
          "source": "acai",
          "description": "Vợ của Hê-be người Kê-nít, người đã giết Si-sê-ra là tướng chỉ huy đạo quân của Vua Gia-bin vào thời nữ quan xét Đê-bô-ra của Y-sơ-ra-ên."
        }
      ]
    },
    "zht": {
      "preferred_label": "雅億",
      "descriptions": [
        {
          "source": "acai",
          "description": "基尼人希百的妻子，在以色列士師底波拉的時代殺死了耶賓王軍隊的元帥西西拉。"
        }
      ]
    }
  },
