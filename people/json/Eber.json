  "localizations": {
    "eng": {
      "preferred_label": "Eber",
      "alternate_labels": [
        "Heber"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Eber",
          "article": "person:Eber",
          "description": "A descendant of Noah's son Shem, and ancestor of the Hebrew people. He was a son of Shelah and the father of Peleg and Joktan."
        }
      ]
    },
    "arb": {
      "preferred_label": "عَابِر",
      "descriptions": [
        {
          "source": "acai",
          "description": "من نسل سام بن نوح، وأحد أسلاف العبرانيين. كان ابن شالح وأبا فالج ويقطان."
        }
      ]
    },
    "zhs": {
      "preferred_label": "希伯",
      "descriptions": [
        {
          "source": "acai",
          "description": "挪亚之子闪的后裔，希伯来人的祖先。他是沙拉的儿子，法勒和约坍的父亲。"
        }
      ]
    },
    "hau": {
      "preferred_label": "Eber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ɗan zuriyar Shem ɗan Nuhu, kuma kakan mutanen Ibraniyawa. Shi ɗan Shela ne kuma uban Feleg da Yoktan."
        }
      ]
    },
    "hin": {
      "preferred_label": "एबेर",
      "descriptions": [
        {
          "source": "acai",
          "description": "नूह के पुत्र शेम का एक वंशज, और इब्रानी लोगों का पूर्वज। वह शेला का पुत्र तथा पेलेग और योक्तान का पिता था।"
        }
      ]
    },
    "ind": {
      "preferred_label": "Eber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Keturunan Sem anak Nuh, dan leluhur bangsa Ibrani. Ia adalah anak Syela dan ayah dari Peleg serta Yoktan."
        }
      ]
    },
    "por": {
      "preferred_label": "Héber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Descendente de Sem, filho de Noé, e antepassado do povo hebreu. Era filho de Selá e pai de Pelegue e Joctã."
        }
      ]
    },
    "rus": {
      "preferred_label": "Евер",
      "descriptions": [
        {
          "source": "acai",
          "description": "Потомок Сима, сына Ноя, и предок еврейского народа. Он был сыном Салы и отцом Фалека и Иоктана."
        }
      ]
    },
    "spa": {
      "preferred_label": "Éber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Descendiente de Sem, hijo de Noé, y antepasado del pueblo hebreo. Fue hijo de Sela y padre de Peleg y Joctán."
        }
      ]
    },
    "swh": {
      "preferred_label": "Eberi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mzao wa Shemu mwana wa Nuhu, na babu wa Waebrania. Alikuwa mwana wa Sala na baba wa Pelegi na Yoktani."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Eber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela tumbuna pikinini bilong Siem, pikinini man bilong Noa, na tumbuna bilong ol Hibru. Em i pikinini man bilong Sela na papa bilong Pelek na Joktan."
        }
      ]
    },
    "apd": {
      "preferred_label": "عابر",
      "descriptions": [
        {
          "source": "acai",
          "description": "واحد من نسل سام ولد نوح، وجد العبرانيين. هو كان ولد شالح وأبو فالج ويقطان."
        }
      ]
    },
    "bis": {
      "preferred_label": "Eba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan laen blong Sem we i pikinini blong Noa, mo bubu blong ol Hibru man. Hem i pikinini boe blong Sela mo papa blong Peleg mo Joktan."
        }
      ]
    },
    "fra": {
      "preferred_label": "Héber",
      "descriptions": [
        {
          "source": "acai",
          "description": "Descendant de Sem, fils de Noé, et ancêtre du peuple hébreu. Il était fils de Schélach et père de Péleg et Jokthan."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Eba",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nwa nwa Shem nwa Noa, na nna nna ochie nke ndị Hibru. Ọ bụ nwa Shela ma bụrụkwa nna Peleg na Joktan."
        }
      ]
    },
    "nep": {
      "preferred_label": "एबेर",
      "descriptions": [
        {
          "source": "acai",
          "description": "नोआका छोरा शेमका एक वंशज र हिब्रू जातिका पुर्खा। उनी शेलहका छोरा तथा पेलेग र योक्तानका पिता थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "Hê-be",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một hậu duệ của Sem, con trai của Nô-ê, và là tổ phụ của dân Hê-bơ-rơ. Ông là con trai của Sa-la và là cha của Bê-léc cùng Giốc-tan."
        }
      ]
    },
    "zht": {
      "preferred_label": "希伯",
      "descriptions": [
        {
          "source": "acai",
          "description": "挪亞之子閃的後裔，希伯來人的先祖。他是沙拉的兒子，法勒和約坍的父親。"
        }
      ]
    }
  },
