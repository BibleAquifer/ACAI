  "localizations": {
    "eng": {
      "preferred_label": "Amorites",
      "alternate_labels": [
        "Amorite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Amorites",
          "article": "group:Amorites",
          "description": "People from one of the nations that inhabited the land of Canaan before the Israelite conquest."
        }
      ]
    },
    "apd": {
      "preferred_label": "أموريين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس من واحدة من الشعوب السكنت أرض كنعان قبل فتح بني إسرائيل."
        }
      ]
    },
    "arb": {
      "preferred_label": "الأموريون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب من إحدى الأمم التي سكنت أرض كنعان قبل الغزو الإسرائيلي."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol laen blong Amoro",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man blong wan long ol neson we oli bin stap laef long graon blong Kenan bifo we ol man Isrel oli tekem."
        }
      ]
    },
    "fra": {
      "preferred_label": "Amoréens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Peuple appartenant à l'une des nations qui habitaient le pays de Canaan avant la conquête israélite."
        }
      ]
    },
    "hau": {
      "preferred_label": "Amoriyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutane daga ɗaya daga cikin al’umman da suka zauna a ƙasar Kan’ana kafin cin nasarar Isra’ilawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "एमोरी",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएली विजय से पहले कनान देश में बसने वाली जातियों में से एक के लोग।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Amọrait",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị sitere nʼotu nʼime mba ndị bi na Kenan tutu ndị Izrel erute ma merie ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Amori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang dari salah satu bangsa yang mendiami tanah Kanaan sebelum penaklukan oleh bangsa Israel."
        }
      ]
    },
    "nep": {
      "preferred_label": "एमोरीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएली विजयभन्दा पहिले कनान देशमा बसोबास गर्ने जातिहरूमध्ये एकका मानिसहरू।"
        }
      ]
    },
    "por": {
      "preferred_label": "amorreus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas de uma das nações que habitavam a terra de Canaã antes da conquista israelita."
        }
      ]
    },
    "rus": {
      "preferred_label": "Аморреи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Представители одного из народов, населявших землю Ханаанскую до завоевания её израильтянами."
        }
      ]
    },
    "spa": {
      "preferred_label": "amorreo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo de una de las naciones que habitaban la tierra de Canaán antes de la conquista israelita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Waamori",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu kutoka mojawapo ya mataifa yaliyoishi katika nchi ya Kanaani kabla ya ushindi wa Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Amor",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri bilong wanpela kantri i bin stap long graun Kenan bipo ol Israel i kisim dispela graun."
        }
      ]
    },
    "vie": {
      "preferred_label": "người A-mô-rít",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dân tộc thuộc một trong những nước từng cư trú tại xứ Ca-na-an trước cuộc chinh phục của dân Y-sơ-ra-ên."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚摩利人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在以色列人征服之前居住在迦南地的民族之一。"
        }
      ]
    },
    "zht": {
      "preferred_label": "亞摩利人",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人征服迦南前居住在迦南地的民族之一。"
        }
      ]
    }
  },
