      "preferred_label": "मिद्यानी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिद्यान में रहने वाले लोग; यह क्षेत्र कतूरा से उत्पन्न अब्राहम के पुत्र मिद्यान से जुड़ा हुआ है।"
        }
      ]
    },
    "apd": {
      "preferred_label": "المديانيين",
      "descriptions": [
        {
          "source": "acai",
