        }
      ]
    },
    "rus": {
      "preferred_label": "Мадианитяне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жители Мадиана, области, связанной с Мадианом, сыном Авраама от Хеттуры."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wamidiani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wanaoishi Midiani, eneo linalohusishwa na Midiani, mwana wa Abrahamu kwa Ketura."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ol Midian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i save stap long Midian, wanpela hap graun i kisim nem long Midian, wanpela pikinini man bilong Abraham wantaim Ketura."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Ma-đi-an",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người sống ở Ma-đi-an, một vùng đất gắn liền với Ma-đi-an, con trai của Áp-ra-ham với Kê-tu-ra."
        }
      ]
    },
