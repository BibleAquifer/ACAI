        }
      ]
    },
    "arb": {
      "preferred_label": "المديانيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "أشخاص يعيشون في مديان، وهي منطقة ترتبط بمديان، ابن إبراهيم من قطورة."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Midian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli stap laef long Midian, wan rijin we nem blong hem i kamaot long Midian, we i wan boe blong Ebraham wetem Ketura."
        }
      ]
    },
    "hau": {
      "preferred_label": "Midiyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suke zaune a Midiyan, wani yanki da ke da alaƙa da Midiyan, ɗan Ibrahim ta wurin Ketura."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Midia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị bi na Midian, ógbè e jikọtara ya na Midian, nwa Abraham site nʼaka Ketura."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Midian",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang tinggal di Midian, suatu wilayah yang dihubungkan dengan Midian, putra Abraham dari Ketura."
        }
      ]
    },
    "nep": {
      "preferred_label": "मिद्यानीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "मिद्यानमा बस्ने मानिसहरू, जुन कतूराद्वारा जन्मिएको अब्राहामको छोरा मिद्यानसँग सम्बन्धित क्षेत्र हो।"
        }
      ]
    },
    "por": {
      "preferred_label": "midianitas",
      "descriptions": [
        {
          "source": "acai",
