        }
      ],
      "alternate_labels": [
        "Emites"
      ]
    },
    "hin": {
      "preferred_label": "एमी",
      "descriptions": [
        {
          "source": "acai",
          "description": "लोग जो मोआब में बसते थे। वे दानवों के रूप में जाने जाते थे।"
        }
      ]
    },
    "apd": {
      "preferred_label": "الإيميين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس سكنوا موآب، وكانوا معروفين بأنهم عمالقة."
        }
      ]
    },
    "arb": {
      "preferred_label": "الإيميون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب سكن موآب وكانوا معروفين كجبابرة."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol Emim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli bin stap laef long Moab. Ol man oli save olgeta olsem ol lariken man."
        }
      ]
    },
    "fra": {
      "preferred_label": "Émim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Peuple qui habitait Moab. Ils étaient connus comme des géants."
        }
      ]
    },
    "hau": {
      "preferred_label": "Emawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suka zauna a Mowab. An san su a matsayin ƙatta."
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Emim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị biri nʼala Moab. A maara ha dịka ndị dimkpa."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Emim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bangsa yang mendiami Moab. Mereka dikenal sebagai orang raksasa."
        }
      ]
    },
    "nep": {
      "preferred_label": "एमीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "मोआबमा बसोबास गर्ने मानिसहरू। तिनीहरू भीमकाय (दैत्य) मानिसहरू भनेर चिनिन्थे।"
        }
      ]
    },
    "por": {
      "preferred_label": "emins",
      "descriptions": [
        {
          "source": "acai",
          "description": "Povo que habitava em Moabe. Eram conhecidos como gigantes."
        }
      ]
    },
    "rus": {
      "preferred_label": "Емимы",
      "descriptions": [
        {
          "source": "acai",
          "description": "Народ, населявший Моав. Они были известны как великаны."
        }
      ]
    },
    "spa": {
      "preferred_label": "emita",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo que habitaba en Moab. Eran conocidos como gigantes."
        }
      ]
    },
    "swh": {
      "preferred_label": "Waemi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu walioishi Moabu. Walijulikana kama majitu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lain Em",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri bipo i bin stap long Moap. Ol i bin save long ol olsem ol bikpela longpela manmeri tru."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Ê-mim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dân tộc cư trú ở Mô-áp. Họ được biết đến như những người khổng lồ."
        }
      ]
    },
    "zhs": {
