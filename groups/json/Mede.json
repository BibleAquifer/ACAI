        {
          "source": "acai",
          "gloss": "Medes",
          "article": "group:Mede",
          "description": "People who live in the region of Media. The home of Darius (Daniel 11:1) who conquered Babylon."
        }
      ]
    },
    "fra": {
      "preferred_label": "Mèdes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Peuple vivant dans la région de Médie. Patrie de Darius (Daniel 11:1) qui conquit Babylone."
        }
      ]
    },
    "spa": {
      "preferred_label": "medos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas que viven en la región de Media. La patria de Darío (Daniel 11:1), quien conquistó Babilonia."
        }
      ]
    },
    "hin": {
      "preferred_label": "मादी",
      "descriptions": [
        {
          "source": "acai",
          "description": "मादै क्षेत्र में रहने वाले लोग। दारा का मूल स्थान (दानिय्येल 11:1), जिसने बाबुल पर विजय प्राप्त की थी।"
        }
      ]
    },
    "apd": {
      "preferred_label": "الماديين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس ساكنين في إقليم ميديا. موطن داريوس (دانيال 11: 1) الغلب بابل."
        }
      ]
    },
    "arb": {
      "preferred_label": "المَادِيّون",
      "descriptions": [
        {
          "source": "acai",
          "description": "الذين يسكنون في بلاد مَادِي. موطن داريوس (دانيال 11: 1) الذي فتح بابل."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Media",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli stap laef long eria blong Media. Ples ya we Darias i kamaot long hem (Daniel 11:1) we i bin winim Babilon."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mutanen Medes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da ke zaune a yankin Medes. Garin Dariyus (Daniyel 11:1) wanda ya ci Babila da yaƙi."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Midia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị bi na mpaghara Midia. Ebe obibi Daraiọs (Daniel 11:1) onye meriri Babilọn."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Madai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang tinggal di wilayah Media. Tempat asal Darius (Daniel 11:1) yang menaklukkan Babel."
        }
      ]
    },
    "nep": {
      "preferred_label": "मादीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "मादी क्षेत्रमा बस्ने मानिसहरू। बेबिलोन विजय गर्ने दाराको गृहभूमि (दानिएल ११:१)।"
        }
      ]
    },
    "por": {
      "preferred_label": "medos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas que vivem na região da Média. A terra natal de Dario (Daniel 11:1), que conquistou a Babilônia."
        }
      ]
    },
    "rus": {
      "preferred_label": "Мидяне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жители Мидии; родина Дария (Даниил 11:1), покорившего Вавилон."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wamedi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wanaoishi katika eneo la Umedi. Makao ya Dario (Danieli 11:1) aliyeiteka Babeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ol Midia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i stap long hap graun Midia. Dispela em ples bilong Darius (Daniel 11:1) em man i winim Babilon."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người Mê-đi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người sống ở vùng Mê-đi. Quê hương của Đa-ri-út (Đa-ni-ên 11:1), người đã chinh phục Ba-by-lôn."
        }
      ]
    },
    "zhs": {
      "preferred_label": "玛代人",
      "descriptions": [
        {
          "source": "acai",
          "description": "居住在玛代地区的人。攻占巴比伦的大流士（但以理书 11:1）的家乡。"
        }
      ]
    },
    "zht": {
      "preferred_label": "米底亞人",
      "descriptions": [
        {
          "source": "acai",
          "description": "居住在米底亞地區的人。征服巴比倫的大流士（但以理書 11:1）的故鄉。"
        }
      ]
    }
  },
