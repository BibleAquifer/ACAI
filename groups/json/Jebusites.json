  "localizations": {
    "eng": {
      "preferred_label": "Jebusites",
      "alternate_labels": [
        "Jebusite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Jebusites",
          "article": "group:Jebusites",
          "description": "People from one of the nations that inhabited the land of Canaan before the Israelite conquest."
        }
      ]
    },
    "fra": {
      "preferred_label": "Jébusiens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Peuple issu de l'une des nations qui habitaient le pays de Canaan avant la conquête israélite."
        }
      ]
    },
    "apd": {
      "preferred_label": "اليبوسيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس من واحدة من الأمم الكانت ساكنة في أرض كنعان قبل ما يستولوا عليها بني إسرائيل."
        }
      ]
    },
    "arb": {
      "preferred_label": "اليَبُوسِيُّون",
      "descriptions": [
        {
          "source": "acai",
          "description": "قوم من إحدى الأمم التي سكنت أرض كنعان قبل غزو بني إسرائيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol laen blong Jebus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man blong wan long ol neson we oli bin stap laef long graon blong Kenan bifo we ol man Isrel oli tekem ol ples ya."
        }
      ]
    },
    "hau": {
      "preferred_label": "Yebusiyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suka fito daga ɗaya daga cikin al'umman da suka zauna a ƙasar Kan'ana kafin cin nasarar Isra'ilawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "यबूसी",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलियों की विजय से पहले कनान देश में रहनेवाली जातियों में से एक जाति के लोग।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Jebus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị sitere nʼotu nʼime mba ndị bi na Kenan tupu ụmụ Izrel emerie ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Yebusi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bangsa dari salah satu suku bangsa yang mendiami tanah Kanaan sebelum penaklukan oleh bangsa Israel."
        }
      ]
    },
    "nep": {
      "preferred_label": "यबूसीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएली विजयभन्दा पहिले कनान देशमा बसोबास गर्ने जातिहरूमध्ये एकका मानिसहरू।"
        }
      ]
    },
    "por": {
      "preferred_label": "jebuseus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas de uma das nações que habitavam a terra de Canaã antes da conquista israelita."
        }
      ]
    },
    "rus": {
      "preferred_label": "Иевусеи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Представители одного из народов, населявших землю Ханаан до израильского завоевания."
        }
      ]
    },
    "spa": {
      "preferred_label": "jebuseo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo perteneciente a una de las naciones que habitaban la tierra de Canaán antes de la conquista israelita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wayebusi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu kutoka moja ya mataifa yaliyoishi katika nchi ya Kanaani kabla ya ushindi wa Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ol Jebus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol lain manmeri bilong wanpela kantri i bin stap long graun bilong Kenan paslain long taim ol Israel i winim ol long pait."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Giê-bu-sít",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người thuộc một trong các dân tộc từng cư ngụ tại xứ Ca-na-an trước khi dân Y-sơ-ra-ên chinh phục xứ này."
        }
      ]
    },
    "zhs": {
      "preferred_label": "耶布斯人",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人征服之前居住在迦南地的民族之一。"
        }
      ]
    },
    "zht": {
      "preferred_label": "耶布斯人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在以色列人征服迦南之前居住在迦南地的民族之一。"
        }
      ]
    }
  },
