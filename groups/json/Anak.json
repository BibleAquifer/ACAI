  "localizations": {
    "eng": {
      "preferred_label": "Anakim",
      "alternate_labels": [
        "Anak",
        "Anakites"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Anakim",
          "article": "group:Anak",
          "description": "People descended from Anak who lived in pre-conquest Canaan. The Anakim were a race of giants."
        }
      ]
    },
    "fra": {
      "preferred_label": "Anakim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes descendant d'Anak qui vivaient en Canaan avant la conquête. Les Anakim étaient une race de géants."
        }
      ]
    },
    "spa": {
      "preferred_label": "anaceo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo descendiente de Anac que habitaba en Canaán antes de la conquista. Los anaceos eran una raza de gigantes."
        }
      ]
    },
    "hin": {
      "preferred_label": "अनाकवंशी",
      "descriptions": [
        {
          "source": "acai",
          "description": "अनाक के वंशज जो इस्राएलियों की विजय से पूर्व कनान में रहते थे। अनाकवंशी विशालकाय लोगों की एक जाति थे।"
        }
      ]
    },
    "apd": {
      "preferred_label": "عناقيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس من نسل عناق عاشوا في كنعان قبل الفتح، وكانوا جنس من العماليق الطوال شديد."
        }
      ]
    },
    "arb": {
      "preferred_label": "العناقيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب ينحدر من عناق عاشوا في كنعان قبل الغزو الإسرائيلي. وكان العناقيون سلالة من الجبابرة."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol laen blong Anak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli kamaot long laen blong Anak we oli bin stap laef long Kenan bifo long taem blong faet blong tekem graon. Ol Anakim oli wan laen blong ol dabolbun."
        }
      ]
    },
    "hau": {
      "preferred_label": "Anakawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suka fito daga zuriyar Anak waɗanda suka zauna a Kan’ana kafin cin nasarar ƙasar. Anakawa jinsin ƙattai ne."
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Anak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị sitere nʼagbụrụ Anak bụ ndị biri na Kenan tutu a lụso ya agha merie ya. Ndị Anak bụ agbụrụ ndị gbara dimkpa too ogologo."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Enak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Keturunan dari Enak yang tinggal di Kanaan sebelum penaklukan. Orang Enak adalah ras raksasa."
        }
      ]
    },
    "nep": {
      "preferred_label": "अनाकीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनान विजय हुनुभन्दा अघि त्यहाँ बस्ने अनाकका सन्तानहरू, जो भीमकाय मानिसहरूको एक जाति थिए।"
        }
      ]
    },
    "por": {
      "preferred_label": "enaquins",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas descendentes de Anaque que viviam em Canaã antes da conquista. Os enaquins eram uma raça de gigantes."
        }
      ]
    },
    "rus": {
      "preferred_label": "Енакимы",
      "descriptions": [
        {
          "source": "acai",
          "description": "Потомки Енака, жившие в Ханаане до завоевания его израильтянами. Енакимы были народом великанов."
        }
      ]
    },
    "swh": {
      "preferred_label": "Waanaki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu waliotokana na Anaki walioishi Kanaani kabla ya kutekwa. Waanaki walikuwa jamii ya majitu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Anak",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i bilong lain tumbuna bilong Anak em ol i bin stap long Kenan bipo ol Israel i winim dispela graun. Lain Anak em lain traipela manmeri."
        }
      ]
    },
    "vie": {
      "preferred_label": "dân A-na-kim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người hậu tự của A-nác từng sống ở Ca-na-an trước cuộc chinh phạt. Dân A-na-kim là một chủng tộc người khổng lồ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚衲人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在征服前居住在迦南地的亚衲后代。亚衲人身材高大。"
        }
      ]
    },
    "zht": {
      "preferred_label": "亞衲人",
      "descriptions": [
        {
          "source": "acai",
          "description": "亞衲的後裔，在以色列人征服迦南前居住在當地。亞衲人是身材高大的族類。"
        }
      ]
    }
  },
