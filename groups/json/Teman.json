    "spa": {
      "preferred_label": "temanitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas que viven en Temán, la región de Elifaz, uno de los consejeros de Job."
        }
      ]
    },
    "hin": {
      "preferred_label": "तेमानी",
      "descriptions": [
        {
          "source": "acai",
          "description": "तेमान में रहने वाले लोग, जो अय्यूब के मित्रों में से एक, एलीपज का क्षेत्र था।"
        }
      ]
    },
    "apd": {
      "preferred_label": "التيمانيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس عايشين في تيمان، وهي المنطقة بتاعة أليفاز، واحد من أصحاب أيوب النصحوهو."
        }
      ]
    },
    "arb": {
      "preferred_label": "التَّيْمَانِيُّون",
      "descriptions": [
        {
          "source": "acai",
          "description": "أهل تَيْمان، وهي موطن أليفاز أحد أصحاب أيوب."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli stap laef long Teman, we hem i eria blong Elifas, wan long ol fren blong Job we i givim advaes long hem."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mutanen Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suke zaune a Teman, yankin Elifaz, ɗaya daga cikin masu ba Ayuba shawara."
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị bi na Teman, bụ́ mpaghara Elifaz, otu nʼime ndị ndụmọdụ Job."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Téman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang tinggal di Téman, wilayah asal Elifas, salah seorang sahabat Ayub."
        }
      ]
    },
    "nep": {
      "preferred_label": "तेमानीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "तेमानमा बस्ने मानिसहरू, जो अय्यूबका एक सल्लाहकार एलीपजको क्षेत्र हो।"
        }
      ]
    },
    "por": {
      "preferred_label": "temanitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas que habitam em Temã, região de Elifaz, um dos conselheiros de Jó."
        }
      ]
    },
    "rus": {
      "preferred_label": "Феманитяне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жители Фемана, местности Елифаза, одного из друзей Иова."
        }
      ]
    },
    "swh": {
      "preferred_label": "Watemani",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wanaoishi Temani, eneo la Elifazi, mmoja wa washauri wa Ayubu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ol man bilong Teman",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i save stap long Teman, em hap bilong Elifas, wanpela bilong ol man i bin givim tingting long Jop."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Thê-man",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người sống ở Thê-man, vùng đất của Ê-li-pha, một trong những người bạn khuyên nhủ Gióp."
        }
      ]
    },
    "zhs": {
      "preferred_label": "提幔人",
      "descriptions": [
        {
          "source": "acai",
          "description": "居住在提幔的人，约伯的安慰者之一以利法来自该地区。"
        }
      ]
    },
    "zht": {
      "preferred_label": "提幔人",
      "descriptions": [
        {
          "source": "acai",
          "description": "住在提幔的人，約伯的策士之一以利法來自該地。"
        }
      ]
    }
  },
