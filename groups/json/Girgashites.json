    "eng": {
      "preferred_label": "Girgashites",
      "alternate_labels": [
        "Girgashite",
        "Girgasite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Girgashites",
          "article": "group:Girgashites",
          "description": "People from one of the nations that inhabited the land of Canaan before the Israelite conquest."
        }
      ]
    },
    "apd": {
      "preferred_label": "الجرجاشيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس من واحدة من الأمم الكانت ساكنة أرض كنعان قبل ما يستولوا عليها بني إسرائيل."
        }
      ]
    },
    "arb": {
      "preferred_label": "الجِرْجاشيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب من إحدى الأمم التي سكنت أرض كنعان قبل الغزو الإسرائيلي."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol laen blong Gigas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man blong wan long ol neson we oli bin stap laef long graon blong Kenan bifo we ol man Isrel oli tekem kantri ya."
        }
      ]
    },
    "fra": {
      "preferred_label": "Guirgasiens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membres de l'une des nations qui habitaient le pays de Canaan avant la conquête israélite."
        }
      ]
    },
    "hau": {
      "preferred_label": "Girgashiyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutane daga ɗaya daga cikin al’umman da suka zauna a ƙasar Kan’ana kafin cin nasarar Isra’ilawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "गिर्गाशी",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलियों की विजय से पहले कनान देश में रहने वाली जातियों में से एक के लोग।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Gigash",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị sitere nʼotu nʼime mba ndị biri nʼala Kenan tupu ndị Izrel emerie ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Girgasi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang dari salah satu bangsa yang mendiami tanah Kanaan sebelum penaklukan oleh Israel."
        }
      ]
    },
    "nep": {
      "preferred_label": "गिर्गाशीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलीहरूको विजयभन्दा पहिले कनान देशमा बसोबास गर्ने जातिहरूमध्ये एकका मानिसहरू।"
        }
      ]
    },
    "por": {
      "preferred_label": "girgaseus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas de uma das nações que habitavam a terra de Canaã antes da conquista israelita."
        }
      ]
    },
    "rus": {
      "preferred_label": "гергесеи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Один из народов, населявших землю Ханаанскую до завоевания её израильтянами."
        }
      ]
    },
    "spa": {
      "preferred_label": "gergeseo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo perteneciente a una de las naciones que habitaban la tierra de Canaán antes de la conquista israelita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wagirgashi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu kutoka moja ya mataifa yaliyoishi katika nchi ya Kanaani kabla ya kutekwa na Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "lain Girgas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri bilong wanpela lain bilong bipo em ol i bin stap long graun Kenan paslain long ol Israel i kam kisim dispela graun."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người Ghi-rê-ga",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người thuộc một trong các dân tộc từng cư ngụ trong xứ Ca-na-an trước cuộc chinh phục của người Y-sơ-ra-ên."
        }
      ]
    },
    "zhs": {
      "preferred_label": "革迦撒人",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人征服迦南前居住在迦南地的民族之一。"
        }
      ]
    },
    "zht": {
      "preferred_label": "革迦撒人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在以色列人征服之前居住在迦南地的民族之一。"
        }
      ]
    }
  },
