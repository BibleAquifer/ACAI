  "localizations": {
    "eng": {
      "preferred_label": "Perizzites",
      "alternate_labels": [
        "Perizzite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Perizzites",
          "article": "group:Perizzites",
          "description": "People from one of the nations that inhabited the land of Canaan before the Israelite conquest."
        }
      ]
    },
    "apd": {
      "preferred_label": "الفرزيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس من واحدة من الشعوب السكنت أرض كنعان قبل فتح بني إسرائيل ليها."
        }
      ]
    },
    "arb": {
      "preferred_label": "الفِرِزِّيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب من إحدى الأمم التي سكنت أرض كنعان قبل الغزو الإسرائيلي."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol laen blong Perij",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man blong wan long ol neson we oli bin stap laef long graon blong Kenan bifo we ol man Isrel oli tekem kantri ya."
        }
      ]
    },
    "fra": {
      "preferred_label": "Phéréziens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes de l'une des nations qui habitaient le pays de Canaan avant la conquête israélite."
        }
      ]
    },
    "hau": {
      "preferred_label": "Ferizziyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutane daga ɗaya daga cikin al’umman da suka zauna a ƙasar Kan’ana kafin ci na Isra’ilawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "परिज्जी",
      "descriptions": [
        {
          "source": "acai",
          "description": "उन जातियों में से एक के लोग जो इस्राएलियों की विजय से पहले कनान देश में रहते थे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Periz",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị sitere nʼotu nʼime mba ndị biri nʼala Kenan tupu ndị Izrel anapụ ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Feris",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bangsa dari salah satu suku bangsa yang mendiami tanah Kanaan sebelum penaklukan oleh bangsa Israel."
        }
      ]
    },
    "nep": {
      "preferred_label": "परिज्‍जीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएली विजयभन्दा अगाडि कनान देशमा बसोबास गर्ने जातिहरूमध्ये एकका मानिसहरू।"
        }
      ]
    },
    "por": {
      "preferred_label": "ferezeus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Povo de uma das nações que habitavam a terra de Canaã antes da conquista israelita."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ферезеи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Люди из одного из народов, населявших землю Ханаан до завоевания ее израильтянами."
        }
      ]
    },
    "spa": {
      "preferred_label": "ferezeos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas de una de las naciones que habitaban la tierra de Canaán antes de la conquista israelita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Waperizi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wa mojawapo ya mataifa yaliyoishi katika nchi ya Kanaani kabla ya kutekwa na Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Peres",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri bilong wanpela lain bilong ol kantri i bin i stap long graun Kenan paslain long ol Israel i winim ol."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Phê-rê-sít",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người thuộc một trong các dân tộc từng cư trú tại xứ Ca-na-an trước khi dân Y-sơ-ra-ên chinh phục xứ này."
        }
      ]
    },
    "zhs": {
      "preferred_label": "比利洗人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在以色列人征服迦南之前居住在该地的民族之一。"
        }
      ]
    },
    "zht": {
      "preferred_label": "比利洗人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在以色列人征服迦南之前居住在迦南地的民族之一。"
        }
      ]
    }
  },
