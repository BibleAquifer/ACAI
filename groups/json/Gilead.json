  "localizations": {
    "eng": {
      "preferred_label": "Gileadites",
      "alternate_labels": [
        "Gilead"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Gileadites",
          "article": "group:Gilead",
          "description": "People who live in Gilead, a region east of the Jordan river, traditionally the territory of the tribes of Gad, Manasseh, and Reuben."
        }
      ]
    },
    "fra": {
      "preferred_label": "Galaadites",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes qui vivent en Galaad, une région située à l'est du Jourdain, traditionnellement le territoire des tribus de Gad, Manassé et Ruben."
        }
      ]
    },
    "spa": {
      "preferred_label": "galaadita",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo que vive en Galaad, una región al este del río Jordán, tradicionalmente el territorio de las tribus de Gad, Manasés y Rubén."
        }
      ]
    },
    "apd": {
      "preferred_label": "الجلعاديين",
      "descriptions": [
        {
          "source": "acai",
          "description": "الناس العايشين في جلعاد، وهي منطقة شرق نهر الأردن، وتقليدياً كانت أراضي قبايل جاد ومنسّى ورأوبين."
        }
      ]
    },
    "arb": {
      "preferred_label": "الجِلْعاديون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب يعيش في جِلْعَادَ، وهي منطقة شرقي نهر الأردن، وتُعدّ تقليديًا أرض أسباط جاد ومَنَسَّى ورَأُوبَيْن."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Gilead",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli stap laef long Gilead, wan distrik long is saed blong reva Jaodan, we i graon blong ol laen blong Gad, Manase, mo Ruben."
        }
      ]
    },
    "hau": {
      "preferred_label": "Gileyadawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suke zaune a Gileyad, wani yanki a gabashin Kogin Urdun, a al’adance yankin kabilun Gad, Manasse, da辰 Ruben."
        }
      ]
    },
    "hin": {
      "preferred_label": "गिलादी",
      "descriptions": [
        {
          "source": "acai",
          "description": "वे लोग जो यरदन नदी के पूर्व के एक क्षेत्र गिलाद में रहते हैं, जो पारंपरिक रूप से गाद, मनश्शे और रूबेन के गोत्रों का क्षेत्र है।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Gilead",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị bi na Gilead, mpaghara dị nʼọwụwa anyanwụ osimiri Jọdan, nke bụbu ókèala ebo Gad, Manase, na Ruben site nʼọdịnala."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Gilead",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang tinggal di Gilead, suatu daerah di sebelah timur sungai Yordan, yang menurut tradisi merupakan wilayah suku Gad, Manasye, dan Ruben."
        }
      ]
    },
    "nep": {
      "preferred_label": "गिलादीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "यर्दन नदीको पूर्वतर्फको क्षेत्र गिलादमा बस्ने मानिसहरू, जो परम्परागत रूपमा गाद, मनश्शे र रूबेनका कुलहरूको इलाका थियो।"
        }
      ]
    },
    "por": {
      "preferred_label": "gileaditas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas que vivem em Gileade, uma região a leste do rio Jordão, tradicionalmente o território das tribos de Gade, Manassés e Rúben."
        }
      ]
    },
    "rus": {
      "preferred_label": "галаадитяне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жители Галаада, области к востоку от реки Иордан, традиционно территории колен Гада, Манассии и Рувима."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wagileadi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wanaoishi Gileadi, eneo lililoko mashariki mwa Mto Yordani, ambalo kijadi lilikuwa eneo la makabila ya Gadi, Manase, na Reubeni."
        }
      ]
    },
    "tpi": {
      "preferred_label": "lain Gileat",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i save stap long Gileat, wanpela hap i stap long ist bilong wara Jordan, em bipo em i graun bilong ol traip bilong Gat, Manase, na Ruben."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người Ga-la-át",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người sống ở Ga-la-át, một vùng đất ở phía đông sông Giô-đanh, theo truyền thống là lãnh thổ của các bộ tộc Gát, Ma-na-se và Ru-bên."
        }
      ]
    },
    "zhs": {
      "preferred_label": "基列人",
      "descriptions": [
        {
          "source": "acai",
          "description": "居住在基列的人。基列是约旦河以东的地区，传统上是迦得、玛拿西和流便支派的领地。"
        }
      ]
    },
    "zht": {
      "preferred_label": "基列人",
      "descriptions": [
        {
          "source": "acai",
          "description": "住在基列的人，基列是約旦河以東的一個地區，傳統上是迦得、瑪拿西和流便支派的領地。"
        }
      ]
    }
  },
