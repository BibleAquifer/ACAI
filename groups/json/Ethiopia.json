  "localizations": {
    "eng": {
      "preferred_label": "Ethiopians",
      "alternate_labels": [
        "Ethiopia"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Ethiopians",
          "article": "group:Ethiopia",
          "description": "People who live in the region of Ethiopia. These people are also associated with Cush, descendants of the son of Ham."
        }
      ]
    },
    "fra": {
      "preferred_label": "Éthiopiens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes qui vivent dans la région d’Éthiopie. Ces personnes sont aussi associées à Cush, descendants du fils de Cham."
        }
      ]
    },
    "spa": {
      "preferred_label": "etíope",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas que viven en la región de Etiopía. Este pueblo también se asocia con Cus, descendientes del hijo de Cam."
        }
      ]
    },
    "hin": {
      "preferred_label": "कूशी",
      "descriptions": [
        {
          "source": "acai",
          "description": "इथियोपिया (कूश) क्षेत्र में रहने वाले लोग। ये लोग हाम के पुत्र कूश के वंशज माने जाते हैं।"
        }
      ]
    },
    "apd": {
      "preferred_label": "الإثيوبيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس عايشين في بلاد إثيوبيا. والناس ديل كمان مرتبطين بكوش، من نسل حام."
        }
      ]
    },
    "arb": {
      "preferred_label": "الحبشيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "أشخاص يعيشون في إقليم الحبشة (إثيوبيا). ويرتبط هؤلاء الناس أيضًا بكوش، من نسل حام."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Itiopia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli stap laef long eria blong Itiopia. Ol man ya oli joen tu wetem ol man Kus, we oli ol laen blong pikinini boe blong Ham."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mutanen Itiyofiya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suke zama a yankin Itiyofiya. Ana kuma danganta waɗannan mutane da Kush, zuriya daga ɗan Ham."
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Itiopia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị bi na mpaghara Itiopia. A na-ejikọkwa ndị a na Kush, bụ́ ụmụ ụmụ nwa Ham."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Etiopia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang tinggal di wilayah Etiopia. Orang-orang ini juga dikaitkan dengan orang Kusy, keturunan putra Ham."
        }
      ]
    },
    "nep": {
      "preferred_label": "इथियोपियालीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "इथियोपिया क्षेत्रमा बसोबास गर्ने मानिसहरू। यी मानिसहरू हामका छोरा कूशका सन्तानसँग पनि सम्बन्धित छन्।"
        }
      ]
    },
    "por": {
      "preferred_label": "etíopes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas que vivem na região da Etiópia. Esse povo também está associado a Cuxe, descendentes do filho de Cam."
        }
      ]
    },
    "rus": {
      "preferred_label": "Ефиопляне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жители области Ефиопия. Эти люди также связываются с кушитами, потомками сына Хама."
        }
      ]
    },
    "swh": {
      "preferred_label": "Waethiopia",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wanaoishi katika eneo la Kushi (au Uhabeshi). Watu hawa pia wanahusishwa na Kushi, wazao wa mwana wa Hamu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ol manmeri bilong Afrika",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i save stap long hap bilong Itiopia (Afrika). Ol dispela manmeri i gat pasin bilong ol tu wantaim lain Kus, em ol tumbuna pikinini bilong pikinini man bilong Ham."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Ê-thi-ô-pi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người sống ở vùng Ê-thi-ô-pi. Những người này cũng gắn liền với Cút, hậu duệ của con trai Cham."
        }
      ]
    },
    "zhs": {
      "preferred_label": "埃塞俄比亚人",
      "descriptions": [
        {
          "source": "acai",
          "description": "住在埃塞俄比亚地区的人。这些人也与含的儿子古实的后代有关联。"
        }
      ]
    },
    "zht": {
      "preferred_label": "衣索匹亞人",
      "descriptions": [
        {
          "source": "acai",
          "description": "住在衣索匹亞地區的人。這些人也與含的兒子古實的後裔相關聯。"
        }
      ]
    }
  },
