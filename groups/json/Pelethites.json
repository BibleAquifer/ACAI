  "localizations": {
    "eng": {
      "preferred_label": "Pelethites",
      "alternate_labels": [
        "Pelethite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Pelethites",
          "article": "group:Pelethites",
          "description": "People associated with Philistines, a group of whom served as mercenaries under King David."
        }
      ]
    },
    "apd": {
      "preferred_label": "الفلتيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس مرتبطين بالفلسطينيين، مجموعة منهم اشتغلو كمرتزقة تحت الملك داود."
        }
      ]
    },
    "arb": {
      "preferred_label": "السُّعَاة",
      "descriptions": [
        {
          "source": "acai",
          "description": "قوم مرتبطون بالفلسطينيين، خدمت مجموعة منهم كمرتزقة تحت قيادة الملك داود."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol Peletet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli joen wetem ol man Filistia, we wan grup long olgeta oli bin mekem wok olsem ol soldia we King Deved i pekem olgeta blong oli faet."
        }
      ]
    },
    "fra": {
      "preferred_label": "Péléthiens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes associées aux Philistins, dont un groupe servait comme mercenaires sous le roi David."
        }
      ]
    },
    "hau": {
      "preferred_label": "Feletiyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da ke da alaƙa da Filistiyawa, waɗanda wani rukuni daga cikinsu suka yi aiki a matsayin sojojin haya a ƙarƙashin Sarki Dawuda."
        }
      ]
    },
    "hin": {
      "preferred_label": "पलेती",
      "descriptions": [
        {
          "source": "acai",
          "description": "पलिश्तियों से संबंधित लोग, जिनका एक समूह राजा दाऊद के अधीन भाड़े के सैनिकों के रूप में सेवा करता था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Pelet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị nwere njikọ na ndị Filistia, nke otu ìgwè nʼime ha jere ozi dị ka ndị agha a goro ego nʼokpuru Eze Devid."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Pleti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang berkerabat dengan orang Filistin, sekelompok di antaranya bertugas sebagai tentara bayaran di bawah kepemimpinan Raja Daud."
        }
      ]
    },
    "nep": {
      "preferred_label": "पलेथीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "पलिश्तीहरूसँग सम्बन्धित मानिसहरू, जसमध्येको एक समूहले राजा दाऊदको मातहतमा भाडाका सिपाहीका रूपमा सेवा गरेका थिए।"
        }
      ]
    },
    "por": {
      "preferred_label": "peletitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Povo associado aos filisteus, um grupo dos quais serviu como mercenários sob o rei Davi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Фелефеи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Народ, связываемый с филистимлянами, часть которого служила наёмниками у царя Давида."
        }
      ]
    },
    "spa": {
      "preferred_label": "peleteos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo asociado con los filisteos, un grupo de los cuales sirvió como mercenarios bajo el rey David."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wapelethi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wanaohusishwa na Wafilisti, ambao kikundi chao kilitumika kama mamluki chini ya Mfalme Daudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ol Pelet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i stap wantaim ol Filistia, na wanpela lain bilong ol i bin mekim wok soldia aninit long King Devit."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người Phê-lết",
      "descriptions": [
        {
          "source": "acai",
          "description": "Nhóm người liên hệ với người Phi-li-tin, một nhóm trong số họ làm lính đánh thuê dưới thời Vua Đa-vít."
        }
      ]
    },
    "zhs": {
      "preferred_label": "比利提人",
      "descriptions": [
        {
          "source": "acai",
          "description": "与非利士人相关的人群，其中一部分在大卫王手下作雇佣兵。"
        }
      ]
    },
    "zht": {
      "preferred_label": "比利提人",
      "descriptions": [
        {
          "source": "acai",
          "description": "與非利士人有關的一群人，其中一部分在大衛王手下擔任雇傭兵。"
        }
      ]
    }
  },
