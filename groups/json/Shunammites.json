{
  "id": "group:Shunammites",
  "primary_id": "group:Shunammites",
  "alternate_sources": {
    "tipnr": [
      "Shunammites@1Ki.1.3-2Ki"
    ]
  },
  "type": "group",
  "group_type": "residence",
  "group_origin": "place:Shunem",
  "localizations": {
    "eng": {
      "preferred_label": "Shunammites",
      "alternate_labels": [
        "Shunammite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shunammites",
          "article": "group:Shunammites",
          "description": "People who live in Shunem, the town of Abishag, who served King David in his old age."
        }
      ]
    },
    "apd": {
      "preferred_label": "الشونميين",
      "descriptions": [
        {
          "source": "acai",
          "description": "الناس الساكنين في شونم، بلدة أبيشج الكانت بتخدم الملك داود في كبر سنو."
        }
      ]
    },
    "arb": {
      "preferred_label": "الشونميون",
      "descriptions": [
        {
          "source": "acai",
          "description": "أشخاص يعيشون في شونم، بلدة أبيشج التي خدمت الملك داود في شيخوخته."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Sunem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli stap laef long Sunem, taon blong Abisag, we i bin mekem wok blong King Deved taem hem i kam olfala."
        }
      ]
    },
    "fra": {
      "preferred_label": "Sunamites",
      "descriptions": [
        {
          "source": "acai",
          "description": "Habitants de Sunem, la ville d’Abischag, qui servit le roi David dans sa vieillesse."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shunamawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suke zaune a Shunam, garin Abishag, wadda ta yi wa Sarki Dawuda hidima sa'ad da ya tsufa."
        }
      ]
    },
    "hin": {
      "preferred_label": "शूनेमी",
      "descriptions": [
        {
          "source": "acai",
          "description": "शूनेम में रहने वाले लोग, जो अबीशग का नगर था, जिसने राजा दाऊद के बुढ़ापे में उसकी सेवा टहल की थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Shunem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị bi na Shunem, bụ́ obodo Abishag, onye jeweere Eze Devid ozi nʼagadi ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Sunem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang tinggal di Sunem, kota asal Abisag, yang melayani Raja Daud di masa tuanya."
        }
      ]
    },
    "nep": {
      "preferred_label": "शूनम्मीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "शूनेममा बस्ने मानिसहरू, जहाँकी अबीशगले राजा दाऊदको वृद्धावस्थामा तिनको सेवा गरेकी थिइन्।"
        }
      ]
    },
    "por": {
      "preferred_label": "sunamitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas que viviam em Suném, a cidade de Abisague, que serviu ao rei Davi em sua velhice."
        }
      ]
    },
    "rus": {
      "preferred_label": "сунамитяне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жители Сунема, родного города Ависаги, которая прислуживала царю Давиду в его старости."
        }
      ]
    },
    "spa": {
      "preferred_label": "sunamitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas que viven en Sunem, la ciudad de Abisag, quien sirvió al rey David en su vejez."
        }
      ]
    },
    "swh": {
      "preferred_label": "Washunami",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wanaoishi Shunemu, mji wa Abishagi, aliyemhudumia Mfalme Daudi katika uzee wake."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ol manmeri bilong Sunem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i save stap long Sunem, em taun bilong Abisak, em meri i bin mekim wok bilong King Devit long taim em i lapun."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người Su-nem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người sống ở Su-nem, là quê hương của A-bi-sác, người đã phục vụ Vua Đa-vít lúc tuổi già."
        }
      ]
    },
    "zhs": {
      "preferred_label": "书念人",
      "descriptions": [
        {
          "source": "acai",
          "description": "居住在书念的人；书念是亚比莎的城镇，亚比莎曾在大卫王年老时伺候他。"
        }
      ]
    },
    "zht": {
      "preferred_label": "書念人",
      "descriptions": [
        {
          "source": "acai",
          "description": "居住在書念的人；書念是在大衛王年老時伺候他的亞比煞之家鄉。"
        }
      ]
    }
  },
  "only_mentioned_in_apocrypha": false,
