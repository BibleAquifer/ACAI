  "localizations": {
    "eng": {
      "preferred_label": "Cherethites",
      "alternate_labels": [
        "Kerethite",
        "Carite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Cherethites",
          "article": "group:Cherethite",
          "description": "People associated with Philistines, a group of whom served as mercenaries under King David."
        }
      ]
    },
    "hin": {
      "preferred_label": "करेती",
      "descriptions": [
        {
          "source": "acai",
          "description": "पलिश्तियों से जुड़े लोग, जिनमें से एक दल राजा दाऊद के अधीन भाड़े के सैनिकों के रूप में सेवा करता था।"
        }
      ]
    },
    "apd": {
      "preferred_label": "الجلادين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس مرتبطين بالفلسطينيين، مجموعة منهم اشتغلوا كعساكر مرتزقة تحت قيادة الملك داود."
        }
      ]
    },
    "arb": {
      "preferred_label": "الكريتيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب يرتبط بالفلسطينيين، خدمت مجموعة منهم كمرتزقة تحت قيادة الملك داود."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Keret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli joen wetem ol Filistaea, we wan grup blong olgeta i bin mekem wok olsem ol soldia aninit long King Deved."
        }
      ]
    },
    "fra": {
      "preferred_label": "Kéréthiens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Peuple associé aux Philistins, dont un groupe servit comme mercenaires sous le roi David."
        }
      ]
    },
    "hau": {
      "preferred_label": "Keretawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da ke da dangantaka da Filistiyawa, waɗanda ƙungiya ɗaya daga cikinsu suka yi aiki a matsayin sojojin haya a ƙarƙashin Sarki Dawuda."
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Keret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị nwere njikọ na ndị Filistia, nke otu ìgwè nʼime ha jere ozi dị ka ndị agha a goro ego nʼokpuru Eze Devid."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Kreti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Bangsa yang berkerabat dengan orang Filistin, sekelompok di antaranya bekerja sebagai tentara bayaran di bawah Raja Daud."
        }
      ]
    },
    "nep": {
      "preferred_label": "करेतीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "पलिश्‍तीहरूसँग सम्बन्धित मानिसहरू, जसमध्ये एक समूहले राजा दाऊदको मातहतमा भाडाका सिपाहीको रूपमा सेवा गर्थे।"
        }
      ]
    },
    "por": {
      "preferred_label": "queretitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Povo associado aos filisteus, um grupo do qual serviu como mercenários sob o rei Davi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хелефеи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Народ, связанный с филистимлянами, часть которого служила наемниками при царе Давиде."
        }
      ]
    },
    "spa": {
      "preferred_label": "quereteos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo asociado con los filisteos, un grupo de los cuales sirvió como mercenarios bajo el rey David."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wakerethi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu waliohusishwa na Wafilisti, ambao kundi lao lilitumikia kama mamluki chini ya Mfalme Daudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ol Keret",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i poroman wantaim ol Filisitia, na wanpela lain bilong ol i bin mekim wok soldia aninit long King Devit."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người Kê-rê-thít",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dân tộc liên hệ với người Phi-li-tin, một nhóm trong số họ phục vụ như lính đánh thuê dưới thời Vua Đa-vít."
        }
      ]
    },
    "zhs": {
      "preferred_label": "基利提人",
      "descriptions": [
        {
          "source": "acai",
          "description": "与非利士人有关联的人群，其中一部分人在大卫王手下担任雇佣军。"
        }
      ]
    },
    "zht": {
      "preferred_label": "基利提人",
      "descriptions": [
        {
          "source": "acai",
          "description": "與非利士人有關聯的一群人，其中一部分在大衛王手下擔任僱傭兵。"
        }
      ]
    }
  },
