  "localizations": {
    "eng": {
      "preferred_label": "Archites",
      "alternate_labels": [
        "Archite",
        "Arkite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Archites",
          "article": "group:Archites",
          "description": "People descended from Benjamin, the son of Jacob, living in southwest of Bethel."
        }
      ]
    },
    "apd": {
      "preferred_label": "الأركيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس من نسل بنيامين بن يعقوب، ساكنين جنوب غرب بيت إيل."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَرَكِيُّونَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "أشخاص ينحدرون من بنيامين بن يعقوب، وكانوا يعيشون جنوب غربي بيت إيل."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Aki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol pipol we oli kamaot long laen blong Benjamin, pikinini boe blong Jekob, we oli laef long saotwes blong Betel."
        }
      ]
    },
    "fra": {
      "preferred_label": "Arkiens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes descendant de Benjamin, fils de Jacob, vivant au sud-ouest de Béthel."
        }
      ]
    },
    "hau": {
      "preferred_label": "Arkitawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suka fito daga zuriyar Banyamin, ɗan Yaƙub, da suke zama a kudu maso yammacin Betel."
        }
      ]
    },
    "hin": {
      "preferred_label": "एरेकी",
      "descriptions": [
        {
          "source": "acai",
          "description": "याकूब के पुत्र बिन्यामीन के वंशज, जो बेतेल के दक्षिण-पश्चिम में रहते थे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Akai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị si n'agbụrụ Benjamin, nwa Jekọb, ndị bi na ndịda ọdịda anyanwụ Betel."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Arki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Keturunan Benyamin, anak Yakub, yang tinggal di sebelah barat daya Betel."
        }
      ]
    },
    "nep": {
      "preferred_label": "अरकीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "याकूबका छोरा बिन्यामिनका सन्‍तानहरू, जो बेथेलको दक्षिण-पश्‍चिममा बस्‍थे ।"
        }
      ]
    },
    "por": {
      "preferred_label": "arquitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas descendentes de Benjamim, filho de Jacó, que viviam a sudoeste de Betel."
        }
      ]
    },
    "rus": {
      "preferred_label": "архитяне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Потомки Вениамина, сына Иакова, жившие к юго-западу от Вефиля."
        }
      ]
    },
    "spa": {
      "preferred_label": "arquita",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas descendientes de Benjamín, hijo de Jacob, que vivían al suroeste de Betel."
        }
      ]
    },
    "swh": {
      "preferred_label": "Waariki (wa Benyamini)",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu waliotokana na Benyamini, mwana wa Yakobo, walioishi kusini-magharibi mwa Betheli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ol Arka",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol tumbuna pikinini bilong Benjamin, em pikinini man bilong Jekop, na ol i bin i stap long hap sautwes bilong Betel."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Ạt-kít",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người là hậu duệ của Bên-gia-min, con trai Gia-cốp, sống ở phía tây nam Bê-tên."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚基人",
      "descriptions": [
        {
          "source": "acai",
          "description": "雅各之子便雅悯的后裔，居住在伯特利西南。"
        }
      ]
    },
    "zht": {
      "preferred_label": "亞基人",
      "descriptions": [
        {
          "source": "acai",
          "description": "雅各之子便雅憫的後裔，住在伯特利西南方。"
        }
      ]
    }
  },
