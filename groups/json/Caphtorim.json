    "hin": {
      "preferred_label": "कप्तोरी",
      "descriptions": [
        {
          "source": "acai",
          "description": "वे लोग जो कप्तोर में रहते हैं, जिसे नए नियम में क्रीट द्वीप के रूप में जाना जाता है।"
        }
      ]
    },
    "apd": {
      "preferred_label": "الكفتوريين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس كانو عايشين في كفتور، المعرفة في العهد الجديد بجزيرة كريت."
        }
      ]
    },
    "arb": {
      "preferred_label": "الكفتوريون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب يسكن في كفتور، المعروفة في العهد الجديد بجزيرة كريت."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Krit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli stap laef long Kafto (we long Niutesteman oli singaot se aelan blong Krit)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Caphtorim",
      "descriptions": [
        {
