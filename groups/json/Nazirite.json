  "localizations": {
    "eng": {
      "preferred_label": "Nazirites",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Nazirites",
          "article": "group:Nazirite",
          "description": "People who were consecrated to God for a set period of time to complete a vow."
        }
      ]
    },
    "apd": {
      "preferred_label": "نذيرين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس كرسوا أرواحهم لله لفترة زمنية محددة لإتمام نذر."
        }
      ]
    },
    "arb": {
      "preferred_label": "النذيرون",
      "descriptions": [
        {
          "source": "acai",
          "description": "أشخاص كُرِّسوا لله لفترة زمنية محددة لإتمام نذر."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ol Nasiraet",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli givim laef blong olgeta i go long God blong wan taem we oli putum blong mekem wan promes blong olgeta i kamtru."
        }
      ]
    },
    "fra": {
      "preferred_label": "Naziréens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes qui étaient consacrées à Dieu pour une période déterminée afin d'accomplir un vœu."
        }
      ]
    },
    "hau": {
      "preferred_label": "Nazirawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da aka keɓe wa Allah domin wani ƙayyadadden lokaci don cika wani alkawari."
        }
      ]
    },
    "hin": {
      "preferred_label": "नाज़ीर",
      "descriptions": [
        {
          "source": "acai",
          "description": "वे लोग जो मन्नत पूरी करने के लिए एक निश्चित समय तक परमेश्वर के लिए समर्पित रहते थे।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Nazirait",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị e doro nsọ nye Chineke maka otu oge iji mezuo nkwa ha kwere."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang nazir",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang ditahbiskan bagi Allah untuk jangka waktu tertentu demi menggenapi suatu nazar."
        }
      ]
    },
    "nep": {
      "preferred_label": "नाजिरीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "भाकल पूरा गर्नका लागि निश्चित समयसम्म परमेश्‍वरमा समर्पित गरिएका मानिसहरू।"
        }
      ]
    },
    "por": {
      "preferred_label": "nazireus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas que eram consagradas a Deus por um período determinado para cumprir um voto."
        }
      ]
    },
    "rus": {
      "preferred_label": "Назореи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Люди, посвятившие себя Богу на определенный период времени для исполнения обета."
        }
      ]
    },
    "spa": {
      "preferred_label": "nazareo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas consagradas a Dios durante un período de tiempo determinado para cumplir un voto."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wanadhiri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu waliowekwa wakfu kwa Mungu kwa kipindi maalum cha wakati ili kutimiza nadhiri."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ol Nasirai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i bin makim ol yet i go long God bilong wanpela makim taim bilong inapim wanpela promis."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Na-xi-rê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người được biệt riêng cho Đức Chúa Trời trong một khoảng thời gian nhất định để hoàn thành một lời thề nguyện."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拿细耳人",
      "descriptions": [
        {
          "source": "acai",
          "description": "为还愿而分别出来、在特定时期内归上帝为圣的人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "拿細耳人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在特定時期內為許願而奉獻歸給上帝的人。"
        }
      ]
    }
  },
