    "eng": {
      "preferred_label": "Naamathites",
      "alternate_labels": [
        "Naamathite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Naamathites",
          "article": "group:Naamathites",
          "description": "People who live in Naamah, the home region of Zophar, one of Job's counselors."
        }
      ]
    },
    "apd": {
      "preferred_label": "النعَماتيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "الناس الساكنين في نعمات، موطن صوفر، واحد من أصحاب أيوب اللي نصحوه."
        }
      ]
    },
    "arb": {
      "preferred_label": "النعمانيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "سكان نعمة، وهي الموطن الأصلي لصوفر، أحد أصحاب أيوب ومستشاريه."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Nahama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli stap long Nahama, we hem i ples blong Jofara, wan long ol fren blong Job we i givim advaes long hem."
        }
      ]
    },
    "fra": {
      "preferred_label": "Naamatites",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes qui vivent à Naama, la région d'origine de Tsophar, l'un des conseillers de Job."
        }
      ]
    },
    "hau": {
      "preferred_label": "Na’amatiyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suke zaune a Na’ama, yankin asalin Zofar, ɗaya daga cikin masu ba Ayuba shawara."
        }
      ]
    },
    "hin": {
      "preferred_label": "नामाती",
      "descriptions": [
        {
          "source": "acai",
          "description": "नामा के निवासी, जो अय्यूब के परामर्शदाताओं में से एक, सोपर का गृह क्षेत्र था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Neama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị bi na Neama, ebe obibi Zofa, otu nʼime ndị ndụmọdụ Job."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Naama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang tinggal di Naama, daerah asal Zofar, salah seorang sahabat Ayub."
        }
      ]
    },
    "nep": {
      "preferred_label": "नमातीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "नमाहका बासिन्दाहरू, जुन अय्यूबका सल्लाहकारहरूमध्येका एक सोपरको गृह-क्षेत्र थियो।"
        }
      ]
    },
    "por": {
      "preferred_label": "naamatitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas que vivem em Naamá, a região de origem de Zofar, um dos conselheiros de Jó."
        }
      ]
    },
    "rus": {
      "preferred_label": "Наамитяне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жители Наамы — родной местности Софара, одного из советников Иова."
        }
      ]
    },
    "spa": {
      "preferred_label": "naamatita",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas que viven en Naamat, la región natal de Zofar, uno de los consejeros de Job."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wanaamathi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wanaoishi Naamathi, eneo la nyumbani kwa Sofari, mmoja wa washauri wa Ayubu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "lain Nama",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i save stap long Nama, em asples bilong Sofar, wanpela bilong ol pren i givim tok long Jop."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Na-a-ma",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người sống ở Na-a-ma, quê hương của Sô-pha, một trong những người bạn khuyên nhủ Gióp."
        }
      ]
    },
    "zhs": {
      "preferred_label": "拿玛人",
      "descriptions": [
        {
          "source": "acai",
          "description": "住在拿玛的人；约伯的谋友之一琐法就是拿玛人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "拿瑪人",
      "descriptions": [
        {
          "source": "acai",
          "description": "居住在拿瑪的人，拿瑪是約伯的三友之一瑣法的家鄉。"
        }
      ]
    }
  },
