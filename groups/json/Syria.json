  "localizations": {
    "eng": {
      "preferred_label": "Syrians",
      "alternate_labels": [
        "Syria",
        "Syrian"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Syrians",
          "article": "group:Syria",
          "description": "People who live in Syria, or people descended from Aram, the son of Shem, the son of Noah."
        }
      ]
    },
    "fra": {
      "preferred_label": "Syriens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes qui vivent en Syrie, ou personnes descendant d'Aram, fils de Sem, fils de Noé."
        }
      ]
    },
    "spa": {
      "preferred_label": "sirios",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas que viven en Siria o descendientes de Aram, hijo de Sem, hijo de Noé."
        }
      ]
    },
    "apd": {
      "preferred_label": "السوريين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس عايشين في سوريا، أو ناس من نسل أرام، ولد سام، ولد نوح."
        }
      ]
    },
    "arb": {
      "preferred_label": "السريانيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "أناس يعيشون في سورية، أو ينحدرون من أرام بن سام بن نوح."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ol man Siria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli stap long Siria, o ol pipol we oli kamaot long laen blong Aram, pikinini boe blong Sem, pikinini boe blong Noa."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mutanen Siriya",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suke zaune a Siriya, ko kuma mutanen da suka fito daga zuriyar Aram, ɗan Shem, ɗan Nuhu."
        }
      ]
    },
    "hin": {
      "preferred_label": "सीरियाई",
      "descriptions": [
        {
          "source": "acai",
          "description": "सीरिया में रहने वाले लोग, या नूह के पुत्र शेम के पुत्र अराम के वंशज।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Siria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị bi na Siria, ma ọ bụ ndị sitere n'agbụrụ Aram, nwa Shem, nwa Noa."
        }
      ]
    },
    "ind": {
      "preferred_label": "Orang Siria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang tinggal di Siria, atau orang-orang keturunan Aram, putra Sem, putra Nuh."
        }
      ]
    },
    "nep": {
      "preferred_label": "सिरियालीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिरियामा बस्ने मानिसहरू, वा नूहका छोरा शेमका छोरा अरामका सन्तानहरू।"
        }
      ]
    },
    "por": {
      "preferred_label": "Sírios",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas que vivem na Síria, ou pessoas descendentes de Arã, filho de Sem, filho de Noé."
        }
      ]
    },
    "rus": {
      "preferred_label": "Сирийцы",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жители Сирии или потомки Арама, сына Сима, сына Ноя."
        }
      ]
    },
    "swh": {
      "preferred_label": "Washami",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wanaoishi Shamu (Siria), au watu waliotokana na Aramu, mwana wa Shemu, mwana wa Nuhu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ol Siria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri bilong kantri Siria, o ol tumbuna pikinini bilong Aram, pikinini man bilong Sem, pikinini man bilong Noa."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Sy-ri",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người sống tại Sy-ri, hoặc những người thuộc dòng dõi của A-ram, con trai của Sem, con trai của Nô-ê."
        }
      ]
    },
    "zhs": {
      "preferred_label": "叙利亚人",
      "descriptions": [
        {
          "source": "acai",
          "description": "居住在叙利亚的人，或是挪亚之子闪的儿子亚兰的后裔。"
        }
      ]
    },
    "zht": {
      "preferred_label": "敘利亞人",
      "descriptions": [
        {
          "source": "acai",
          "description": "居住在敘利亞的人，或是挪亞之子閃的兒子亞蘭的後裔。"
        }
      ]
    }
  },
