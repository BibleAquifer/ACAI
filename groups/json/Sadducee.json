  "localizations": {
    "eng": {
      "preferred_label": "Sadducees",
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Sadducees",
          "article": "group:Sadducee",
          "description": "Members of a politically influential Jewish party in Jerusalem at the time of Jesus and the apostles."
        }
      ],
      "alternate_labels": [
        "Sadducees"
      ]
    },
    "fra": {
      "preferred_label": "Sadducéens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membres d'un parti juif influent sur le plan politique à Jérusalem à l'époque de Jésus et des apôtres."
        }
      ]
    },
    "spa": {
      "preferred_label": "saduceos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Miembros de un partido judío de gran influencia política en Jerusalén en la época de Jesús y los apóstoles."
        }
      ]
    },
    "hin": {
      "preferred_label": "सदूकी",
      "descriptions": [
        {
          "source": "acai",
          "description": "यीशु और प्रेरितों के समय यरूशलेम में राजनीतिक रूप से प्रभावशाली यहूदी दल के सदस्य।"
        }
      ]
    },
    "apd": {
      "preferred_label": "صدوقيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "أعضاء حزب يهودي كان عندو نفوذ سياسي في أورشليم في زمن عيسى والرسل."
        }
      ]
    },
    "arb": {
      "preferred_label": "الصدوقيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "أعضاء حزب يهودي ذي نفوذ سياسي في أورشليم في زمن يسوع والرسل."
        }
      ]
    },
    "bis": {
      "preferred_label": "Ol Sadusi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol memba blong wan grup blong ol man Jiu long Jerusalem we oli gat bigfala paoa long gavman long taem blong Jisas mo ol aposol."
        }
      ]
    },
    "hau": {
      "preferred_label": "Sadukiyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mambobin wata ƙungiyar Yahudawa mai tasiri a harkokin siyasa a Urushalima a zamanin Yesu da manzanni."
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Sadusii",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị otu ndọrọ ndọrọ ọchịchị ndị Juu nwere mmetụta na Jerusalem n'oge Jisọs na ndị ozi."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Saduki",
      "descriptions": [
        {
          "source": "acai",
          "description": "Anggota kelompok Yahudi yang berpengaruh secara politik di Yerusalem pada zaman Yesus dan para rasul."
        }
      ]
    },
    "nep": {
      "preferred_label": "सदूकीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "येशू र प्रेरितहरूका समयमा यरूशलेममा राजनीतिक रूपमा प्रभावशाली यहूदी दलका सदस्यहरू।"
        }
      ]
    },
    "por": {
      "preferred_label": "saduceus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Membros de um partido judaico politicamente influente em Jerusalém na época de Jesus e dos apóstolos."
        }
      ]
    },
    "rus": {
      "preferred_label": "Саддукеи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Представители влиятельного политико-религиозного иудейского течения в Иерусалиме во времена Иисуса и апостолов."
        }
      ]
    },
    "swh": {
      "preferred_label": "Masadukayo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Washiriki wa chama cha Kiyahudi chenye ushawishi mkubwa wa kisiasa huko Yerusalemu wakati wa Yesu na mitume."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ol Sadyusi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol memba bilong wanpela bikpela lain bilong ol Juda long Jerusalem i gat bikpela strong long gavman long taim bilong Jisas na ol apositil."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Sa-đu-sê",
      "descriptions": [
        {
          "source": "acai",
          "description": "Các thành viên của một phe phái Do Thái có thế lực về mặt chính trị tại Giê-ru-sa-lem vào thời Chúa Giê-xu và các sứ đồ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "撒都该人",
      "descriptions": [
        {
          "source": "acai",
          "description": "耶稣和使徒时代在耶路撒冷具有政治影响力的犹太教派别成员。"
        }
      ]
    },
    "zht": {
      "preferred_label": "撒都該人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在耶穌和使徒時代，耶路撒冷境內在政治上具影響力的猶太黨派成員。"
        }
      ]
    }
  },
