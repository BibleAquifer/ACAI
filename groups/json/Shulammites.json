  "localizations": {
    "eng": {
      "preferred_label": "Shulammites",
      "alternate_labels": [
        "Shulammite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Shulammites",
          "article": "group:Shulammites",
          "description": "People from an unknown territory. The woman in the Song of Solomon was a Shulammite."
        }
      ]
    },
    "apd": {
      "preferred_label": "الشُولَمِّيِّين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس من منطقة ما معروفة. المرة الفي سفر نشيد الأنشاد كانت شُولَمِّيّة."
        }
      ]
    },
    "arb": {
      "preferred_label": "شُولَمِّيثِيُّون",
      "descriptions": [
        {
          "source": "acai",
          "description": "أناس من منطقة غير معروفة، وكانت المرأة في سفر نشيد الأنشاد شولميثية."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Sulam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man blong wan ples we yumi no save. Woman ya long Buk blong Sing blong Solomon hem i wan woman Sulam."
        }
      ]
    },
    "fra": {
      "preferred_label": "Sulamites",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personnes originaires d'un territoire inconnu. La femme du Cantique des Cantiques était une Sulamite."
        }
      ]
    },
    "hau": {
      "preferred_label": "Shulamiyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen wani yanki da ba a sani ba. Matar da ke cikin Waƙar Waƙoƙi 'yar Shulam ce (ko Bashulammiya)."
        }
      ]
    },
    "hin": {
      "preferred_label": "शूलेम्मी",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अज्ञात क्षेत्र के लोग। श्रेष्ठगीत की स्त्री एक शूलेम्मिन थी।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Shulam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị si nʼotu mpaghara a na-amaghị. Nwanyị ahụ nọ nʼAbụ Sọlọmọn bụ onye Shulam."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Sulam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang dari wilayah yang tidak dikenal. Perempuan dalam Kidung Agung adalah seorang gadis Sulam."
        }
      ]
    },
    "nep": {
      "preferred_label": "शूलम्मेमीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक अज्ञात क्षेत्रका मानिसहरू। सोलोमनको गीतमा भएकी स्त्री एक शूलम्मेमी थिइन्।"
        }
      ]
    },
    "por": {
      "preferred_label": "sulamitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas de um território desconhecido. A mulher em Cântico dos Cânticos era uma sulamita."
        }
      ]
    },
    "rus": {
      "preferred_label": "Суламитяне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жители неизвестной местности. Суламита из Песни Песней была родом оттуда."
        }
      ]
    },
    "spa": {
      "preferred_label": "sulamitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas de un territorio desconocido. La mujer en el Cantar de los Cantares era una sulamita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Washulami",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu kutoka eneo lisilojulikana. Mwanamke katika Wimbo Ulio Bora alikuwa Mshulami."
        }
      ]
    },
    "tpi": {
      "preferred_label": "lain Sulam",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri bilong wanpela hap ol i no save gut long em. Meri long Buk Song Bilong Solomon em wanpela meri bilong Sulam."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người Su-la-mít",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người đến từ một vùng đất chưa rõ. Người nữ trong sách Nhã Ca là một người Su-la-mít."
        }
      ]
    },
    "zhs": {
      "preferred_label": "书拉密人",
      "descriptions": [
        {
          "source": "acai",
          "description": "来自未知地域的人。《雅歌》中的女子就是一位书拉密人。"
        }
      ]
    },
    "zht": {
      "preferred_label": "書拉密人",
      "descriptions": [
        {
          "source": "acai",
          "description": "來自未知地區的人。雅歌中的女子是書拉密人（書拉密女）。"
        }
      ]
    }
  },
