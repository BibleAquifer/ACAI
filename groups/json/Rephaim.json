  "localizations": {
    "eng": {
      "preferred_label": "Rephaim",
      "alternate_labels": [
        "Zamzummin"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Rephaim",
          "article": "group:Rephaim",
          "description": "A people group who lived in pre-conquest Canaan. The Rephaim were a race of giants."
        }
      ]
    },
    "hin": {
      "preferred_label": "रपाईम",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनान पर विजय से पूर्व वहाँ रहने वाला एक जनसमूह। रपाईम दैत्यों (विशालकाय लोगों) की एक जाति थी।"
        }
      ]
    },
    "apd": {
      "preferred_label": "الرفائيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "مجموعة من الناس عاشوا في كنعان قبل الفتح، وكان الرفائيين سلالة من العمالقة."
        }
      ]
    },
    "arb": {
      "preferred_label": "الرفائيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب عاش في كنعان قبل الفتح. وكان الرفائيون سلالة من العمالقة."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol Refaem",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan grup blong man we oli bin stap laef long Kenan bifo long taem we ol man Isrel oli tekem kantri ya. Ol Refaem oli wan laen blong ol lariken man."
        }
      ]
    },
    "fra": {
      "preferred_label": "Rephaïm",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un peuple qui vivait en Canaan avant la conquête. Les Rephaïm étaient une race de géants."
        }
      ]
    },
    "hau": {
      "preferred_label": "Refahiyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙungiyar mutane da suka zauna a Kan’ana kafin a ci ta da yaƙi. Refahiyawa ƙabilan ƙattai ne."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Refaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu agbụrụ ndị biri na Kenan tupu a merie ya. Ndị Refaim bụ agbụrụ ndị dike dị ogologo."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Refaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Suatu suku bangsa yang tinggal di Kanaan sebelum penaklukan. Orang Refaim adalah bangsa raksasa."
        }
      ]
    },
    "nep": {
      "preferred_label": "रपाईहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "कनान विजय हुनुभन्दा अगाडि त्यहाँ बस्ने एक जाति। रपाईहरू दैत्य आकारका मानिसहरूको जाति थिए।"
        }
      ]
    },
    "por": {
      "preferred_label": "refains",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um grupo de pessoas que viveu em Canaã antes da conquista. Os refains eram uma raça de gigantes."
        }
      ]
    },
    "rus": {
      "preferred_label": "Рефаимы",
      "descriptions": [
        {
          "source": "acai",
          "description": "Народ, живший в Ханаане до его завоевания. Рефаимы были племенем великанов."
        }
      ]
    },
    "spa": {
      "preferred_label": "refaítas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Un grupo étnico que vivió en Canaán antes de la conquista. Los refaítas eran una raza de gigantes."
        }
      ]
    },
    "swh": {
      "preferred_label": "Warefai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kikundi cha watu walioishi Kanaani kabla ya kutekwa. Warefai walikuwa kizazi cha majitu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lain Refaim",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela lain manmeri i bin stap long graun Kenan bipo long ol Israel i kisim dispela graun. Ol Refaim em ol bikpela longpela manmeri tru (ol traipela man)."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người Rê-pha-im",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một sắc tộc sống ở Ca-na-an trước cuộc chinh phục. Người Rê-pha-im là một chủng tộc người khổng lồ."
        }
      ]
    },
    "zhs": {
      "preferred_label": "利乏音人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在征服前居住在迦南的一个族群。利乏音人是巨人族。"
        }
      ]
    },
    "zht": {
      "preferred_label": "利乏音人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在以色列人征服迦南之前居住在當地的族群。利乏音人是一個巨人族群。"
        }
      ]
    }
  },
