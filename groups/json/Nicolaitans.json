  "localizations": {
    "eng": {
      "preferred_label": "Nicolaitans",
      "alternate_labels": [
        "Nicolaitan"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Nicolaitans",
          "article": "group:Nicolaitans",
          "description": "A heretical group. One of the letters of Revelation was written to them (Revelation 2:6, 15)."
        }
      ]
    },
    "fra": {
      "preferred_label": "Nicolaïtes",
      "descriptions": [
        {
          "source": "acai",
          "description": "Groupe hérétique. L'une des lettres de l'Apocalypse leur a été adressée (Apocalypse 2:6, 15)."
        }
      ]
    },
    "spa": {
      "preferred_label": "nicolaíta",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grupo herético. Una de las cartas de Apocalipsis fue escrita a ellos (Apocalipsis 2:6, 15)."
        }
      ]
    },
    "apd": {
      "preferred_label": "نيقولاويين",
      "descriptions": [
        {
          "source": "acai",
          "description": "جماعة مبتدعة. واحدة من رسايل سفر الرؤيا اتكتبت ليهم (رؤيا 2: 6، 15)."
        }
      ]
    },
    "arb": {
      "preferred_label": "القولاويون",
      "descriptions": [
        {
          "source": "acai",
          "description": "جماعة هرطوقية. كُتبت إحدى رسائل سفر الرؤيا بشأنهم (رؤيا 2: 6، 15)."
        }
      ]
    },
    "bis": {
      "preferred_label": "Grup blong Nikolas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wan grup we i folem giaman tijing. Wan long ol leta blong Revelesen i tokbaot olgeta (Revelesen 2:6, 15)."
        }
      ]
    },
    "hau": {
      "preferred_label": "Nikolaitawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wata ƙungiya mai koyarwar bidi’a. An rubuta ɗaya daga cikin wasiƙun Ru’ya ta Yohanna game da su."
        }
      ]
    },
    "hin": {
      "preferred_label": "नीकुलई",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक पाखंडी समूह। प्रकाशितवाक्य के पत्रों में से एक पत्र में उनके विषय में लिखा गया था (प्रकाशितवाक्य 2:6, 15)।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Nikolaitan",
      "descriptions": [
        {
          "source": "acai",
          "description": "Otu ndị nkuzi ụgha. E deere ha otu nʼime akwụkwọ ozi dị na Mkpughe (Mkpughe 2:6, 15)."
        }
      ]
    },
    "ind": {
      "preferred_label": "pengikut Nikolaus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kelompok sesat. Salah satu surat dalam kitab Wahyu menyebutkan mereka (Wahyu 2:6, 15)."
        }
      ]
    },
    "nep": {
      "preferred_label": "निकोलाइटसहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "एक पाखण्डी समूह। प्रकाशको पुस्तकका पत्रहरूमध्ये एउटा तिनीहरूलाई सम्बोधन गरी लेखिएको थियो (प्रकाश २:६, १५)।"
        }
      ]
    },
    "por": {
      "preferred_label": "nicolaítas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Um grupo herético. Uma das cartas de Apocalipse foi escrita fazendo menção a eles (Apocalipse 2:6, 15)."
        }
      ]
    },
    "rus": {
      "preferred_label": "Николаиты",
      "descriptions": [
        {
          "source": "acai",
          "description": "Еретическая группа. Одно из посланий Откровения упоминает их (Откровение 2:6, 15)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wanikolai",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kikundi cha wazushi. Mojawapo ya nyaraka katika Ufunuo iliandikwa kuwahusu (Ufunuo 2:6, 15)."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ol lain bilong Nikolas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Wanpela lain i save bihainim giaman bilip. Wanpela bilong ol pas bilong Revelesen i bin go long ol (Revelesen 2:6, 15)."
        }
      ]
    },
    "vie": {
      "preferred_label": "phái Ni-cô-la",
      "descriptions": [
        {
          "source": "acai",
          "description": "Một nhóm dị giáo. Một trong các thư tín của sách Khải Huyền đã được viết gửi đến họ (Khải Huyền 2:6, 15)."
        }
      ]
    },
    "zhs": {
      "preferred_label": "尼哥拉党人",
      "descriptions": [
        {
          "source": "acai",
          "description": "一个异端群体。《启示录》中的书信之一提到了他们（启示录 2:6、15）。"
        }
      ]
    },
    "zht": {
      "preferred_label": "尼哥拉一黨人",
      "descriptions": [
        {
          "source": "acai",
          "description": "一個異端群體。《啟示錄》中的書信曾提及他們（啟示錄 2:6、15）。"
        }
      ]
    }
  },
