  "localizations": {
    "eng": {
      "preferred_label": "Hittites",
      "alternate_labels": [
        "Heth"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hittites",
          "article": "group:Hittite",
          "description": "People descended from Heth. An ethnic group dwelling in Canaan before the Israelite conquest."
        }
      ]
    },
    "fra": {
      "preferred_label": "Héthiens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Peuple descendant de Heth. Groupe ethnique habitant en Canaan avant la conquête israélite."
        }
      ]
    },
    "spa": {
      "preferred_label": "hititas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo descendiente de Het. Un grupo étnico que habitaba en Canaán antes de la conquista israelita."
        }
      ]
    },
    "hin": {
      "preferred_label": "हित्ती",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेत के वंशज; इस्राएलियों की विजय से पहले कनान में रहने वाला एक मानवजातीय समूह।"
        }
      ]
    },
    "apd": {
      "preferred_label": "الحثيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس من نسل حِث. جماعة عرقية كانت ساكنة في كنعان قبل فتح بني إسرائيل ليها."
        }
      ]
    },
    "arb": {
      "preferred_label": "الحثيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "منحدرون من حِثّ. جماعة عرقية سكنت كنعان قبل الفتح الإسرائيلي."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol laen blong Het",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol pipol we oli kamaot long laen blong Het. Wan laen blong man we oli bin stap long Kenan bifo we ol man Isrel oli kam tekem ples ya."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hittiyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suka fito daga zuriyar Hitti. Wata ƙabila ce da ta zauna a Kan’ana kafin cin nasarar Isra’ilawa."
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Het",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị si n'agbụrụ Het pụta. Otu agbụrụ bi na Kenan tupu ndị Izrel emerie ha."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Het",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang keturunan Het. Suatu kelompok etnis yang mendiami Kanaan sebelum penaklukan Israel."
        }
      ]
    },
    "nep": {
      "preferred_label": "हित्तीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "हेतका सन्तानहरू। इस्राएलीहरूको विजयभन्दा अगाडि कनानमा बसोबास गर्ने एउटा जाति समूह।"
        }
      ]
    },
    "por": {
      "preferred_label": "Hititas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas descendentes de Hete. Um grupo étnico que habitava em Canaã antes da conquista israelita."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хеттеи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Народ, происходящий от Хета. Этническая группа, обитавшая в Ханаане до израильского завоевания."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wahiti",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu waliozaliwa na Hethi. Kundi la kikabila lililoishi Kanaani kabla ya ushindi wa Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lain Hit",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol lain i kamap long Het. Wanpela lain pipel i bin stap long Kenan paslain long ol Israel i winim dispela graun."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người Hê-tít",
      "descriptions": [
        {
          "source": "acai",
          "description": "Dân tộc là hậu tự của Hếch. Một sắc tộc cư trú tại Ca-na-an trước cuộc chinh phục của người Y-sơ-ra-ên."
        }
      ]
    },
    "zhs": {
      "preferred_label": "赫人",
      "descriptions": [
        {
          "source": "acai",
          "description": "赫的后代。在以色列人征服之前居住在迦南的民族。"
        }
      ]
    },
    "zht": {
      "preferred_label": "赫人",
      "descriptions": [
        {
          "source": "acai",
          "description": "赫的後裔。在以色列人征服迦南前居住在當地的民族。"
        }
      ]
    }
  },
