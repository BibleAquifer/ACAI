        }
      ]
    },
    "hau": {
      "preferred_label": "Mutanen Tarshish",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suke zaune a Tarshish, inda Shawulu (wanda daga baya aka kira Bulus) ya kasance mazauninta mafi shahara."
        }
      ]
    },
    "hin": {
      "preferred_label": "तरसुसवासी",
      "descriptions": [
        {
          "source": "acai",
          "description": "तरसुस में रहने वाले लोग, जिनमें शाऊल (बाद में पौलुस) सबसे प्रमुख निवासी थे।"
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Tarsus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang yang tinggal di Tarsus, dengan Saulus (kemudian bernama Paulus) sebagai penduduknya yang paling terkenal."
        }
      ]
    },
    "por": {
      "preferred_label": "tarsenses",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas que habitam em Tarso, sendo Saulo (mais tarde chamado Paulo) seu residente mais notável."
        }
      ]
    },
    "rus": {
      "preferred_label": "Тарсяне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Жители Тарса, самым известным из которых был Савл (позже названный Павлом)."
        }
      ]
    },
    "swh": {
      "preferred_label": "Watarso",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu wanaoishi Tarso, ambapo Sauli (baadaye aliyeitwa Paulo) alikuwa mkazi wake mashuhuri zaidi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Ol man bilong Tarsus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri i save stap long Tarsus, na Sol (bihain nem bilong en Pol) em i man i gat biknem tru namel long ol."
        }
      ]
    },
    "apd": {
      "preferred_label": "الطرسوسيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس عايشين في طرسوس، وأشهر زول فيهم كان شاول (السمّوهو بولس بعدين)."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Tasas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli stap laef long Tasas, we Sol (we biaen nem blong hem Pol) i man we i moa gat nem long olgeta."
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Tasọs",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị bi na Tasọs, ebe Sọl (onye e mechara kpọọ Pọl) bụ onye kacha mara amara nʼime ha."
        }
      ]
    },
    "nep": {
      "preferred_label": "टार्ससका मानिसहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "टार्ससमा बस्ने मानिसहरू, जसमध्ये शाऊल (पछि पावल नाम दिइएका) सबैभन्दा प्रख्यात बासिन्दा थिए।"
        }
      ]
    },
    "vie": {
      "preferred_label": "người Tạt-sơ",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người sống ở Tạt-sơ, trong đó Sau-lơ (sau này đổi tên là Phao-lô) là cư dân nổi bật nhất."
        }
      ]
    },
    "zht": {
      "preferred_label": "大數人",
      "descriptions": [
        {
          "source": "acai",
          "description": "住在基利家大數的人，其中最著名的是掃羅（後名保羅）。"
        }
      ]
    }
  },
