  "localizations": {
    "eng": {
      "preferred_label": "Hivites",
      "alternate_labels": [
        "Hivite"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hivites",
          "article": "group:Hivites",
          "description": "People from one of the nations that inhabited the land of Canaan before the Israelite conquest."
        }
      ]
    },
    "apd": {
      "preferred_label": "الحويين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس من واحدة من الشعوب السكنت أرض كنعان قبل فتح بني إسرائيل ليها."
        }
      ]
    },
    "arb": {
      "preferred_label": "الحويون",
      "descriptions": [
        {
          "source": "acai",
          "description": "قوم من إحدى الشعوب التي سكنت أرض كنعان قبل الفتح الإسرائيلي."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol laen blong Hivi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol pipol blong wan neson we oli bin stap long graon blong Kenan bifo we ol man Isrel oli kam tekem ples ya."
        }
      ]
    },
    "fra": {
      "preferred_label": "Héviens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Peuple faisant partie des nations qui habitaient le pays de Canaan avant la conquête israélite."
        }
      ]
    },
    "hau": {
      "preferred_label": "Hiwiyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutane daga ɗaya daga cikin al’umman da suka zauna a ƙasar Kan’ana kafin cin nasarar Isra’ilawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "हिब्बी",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलियों की विजय से पहले कनान देश में बसने वाली जातियों में से एक के लोग।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Hiv",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị sitere n'otu n'ime mba ndị biri n'ala Kenan tupu ndị Izrel emerie ha."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Hewi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang dari salah satu bangsa yang mendiami tanah Kanaan sebelum penaklukan Israel."
        }
      ]
    },
    "nep": {
      "preferred_label": "हिव्वीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "इस्राएलीहरूको विजयभन्दा अगाडि कनान देशमा बसोबास गर्ने जातिहरूमध्ये एकका मानिसहरू।"
        }
      ]
    },
    "por": {
      "preferred_label": "Heveus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas de uma das nações que habitavam a terra de Canaã antes da conquista israelita."
        }
      ]
    },
    "rus": {
      "preferred_label": "Евеи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Один из народов, населявших землю Ханаан до израильского завоевания."
        }
      ]
    },
    "spa": {
      "preferred_label": "heveos",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pueblo de una de las naciones que habitaban la tierra de Canaán antes de la conquista israelita."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wahivi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu kutoka katika mojawapo ya mataifa yaliyoishi katika nchi ya Kanaani kabla ya ushindi wa Waisraeli."
        }
      ]
    },
    "tpi": {
      "preferred_label": "Lain Hivi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri bilong wanpela nesen i bin stap long graun bilong Kenan paslain long ol Israel i winim dispela graun."
        }
      ]
    },
    "vie": {
      "preferred_label": "Người Hê-vi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người thuộc một trong các dân tộc từng cư trú trên đất Ca-na-an trước cuộc chinh phục của người Y-sơ-ra-ên."
        }
      ]
    },
    "zhs": {
      "preferred_label": "希未人",
      "descriptions": [
        {
          "source": "acai",
          "description": "以色列人征服前居住在迦南地的民族之一。"
        }
      ]
    },
    "zht": {
      "preferred_label": "希未人",
      "descriptions": [
        {
          "source": "acai",
          "description": "在以色列人征服迦南前居住在當地的諸民族之一。"
        }
      ]
    }
  },
