          "description": "People from one of the nations that inhabited the land of Canaan before the Israelite conquest."
        }
      ]
    },
    "apd": {
      "preferred_label": "السينيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس من واحدة من الشعوب السكنت أرض كنعان قبل غزو بني إسرائيل."
        }
      ]
    },
    "arb": {
      "preferred_label": "السينيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب من إحدى الأمم التي سكنت أرض كنعان قبل الغزو الإسرائيلي."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol laen blong Sini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man blong wan long ol neson we oli bin stap laef long graon blong Kenan bifo we ol man Isrel oli tekem graon ya."
        }
      ]
    },
    "fra": {
      "preferred_label": "Siniens",
      "descriptions": [
        {
          "source": "acai",
          "description": "Peuple issu de l'une des nations qui habitaient le pays de Canaan avant la conquête israélite."
        }
      ]
    },
    "hau": {
      "preferred_label": "Siniyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suka fito daga ɗaya daga cikin al'umman da suka zauna a ƙasar Kan'ana kafin cin nasarar Isra'ilawa."
        }
      ]
    },
    "hin": {
      "preferred_label": "सीनी",
      "descriptions": [
        {
          "source": "acai",
