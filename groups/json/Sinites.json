        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Sini",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị si nʼotu nʼime mba ndị bi nʼala Kenan tupu ndị Izrel emerie ya."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Sini",
