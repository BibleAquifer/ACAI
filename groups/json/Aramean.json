        }
      ]
    },
    "spa": {
      "preferred_label": "arameo",
      "descriptions": [
        {
          "source": "acai",
          "description": "Grupos de pueblos que viven en Siria y comparten una lengua, el arameo."
        }
      ]
    },
    "hin": {
      "preferred_label": "अरामी",
      "descriptions": [
        {
          "source": "acai",
          "description": "सीरिया में रहने वाले जनसमूह जो अरामी भाषा बोलते हैं।"
        }
      ]
    },
    "apd": {
      "preferred_label": "الآراميين",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعوب ساكنة في سوريا وبيتكلموا لغة واحدة، وهي الآرامية."
        }
      ]
    },
    "arb": {
      "preferred_label": "أَرَامِيُّونَ",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعوب تعيش في سوريا تتشارك لغة واحدة، وهي الآرامية."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Siria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol laen we oli stap laef long Siria we oli sherem wan sem lanwis, Aramaik."
        }
      ]
    },
    "hau": {
      "preferred_label": "Arameyawa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ƙungiyoyin mutane da suke zama a Siriya waɗanda suke da yare ɗaya, wato Aramanci."
        }
      ]
    },
    "ibo": {
      "preferred_label": "ndị Aram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị dị iche iche bi na Siria ndị na-asụ otu asụsụ, ya bụ, asụsụ Aramaik."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Aram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Kelompok-kelompok bangsa yang tinggal di Siria yang memiliki bahasa yang sama, yaitu bahasa Aram."
        }
      ]
    },
    "nep": {
      "preferred_label": "आरामीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "सिरियामा बस्‍ने र अरामी भाषा बोल्‍ने जनसमूहहरू ।"
        }
      ]
    },
    "por": {
      "preferred_label": "arameus",
      "descriptions": [
        {
          "source": "acai",
          "description": "Povos que vivem na Síria e compartilham uma língua, o aramaico."
        }
      ]
    },
    "rus": {
      "preferred_label": "арамеи",
      "descriptions": [
        {
          "source": "acai",
          "description": "Народы, жившие в Сирии и говорившие на одном языке — арамейском."
        }
      ]
    },
    "swh": {
      "preferred_label": "Waaramu",
      "descriptions": [
        {
          "source": "acai",
          "description": "Makundi ya watu wanaoishi Siria wanaoshiriki lugha moja, Kiaramu."
        }
      ]
    },
    "tpi": {
      "preferred_label": "ol Siria",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol lain manmeri i stap long Siria na ol i save mekim wanpela kain tok ples, em tokples Aramik."
        }
      ]
    },
    "vie": {
      "preferred_label": "người A-ram",
      "descriptions": [
        {
          "source": "acai",
          "description": "Các nhóm dân sống ở Sy-ri cùng nói tiếng A-ram."
        }
      ]
    },
    "zhs": {
      "preferred_label": "亚兰人",
      "descriptions": [
        {
          "source": "acai",
          "description": "生活在叙利亚、共同使用亚兰语的族群。"
        }
      ]
    },
    "zht": {
      "preferred_label": "亞蘭人",
      "descriptions": [
        {
          "source": "acai",
          "description": "住在敘利亞、使用共同語言亞蘭語的族群。"
        }
      ]
    }
  },
