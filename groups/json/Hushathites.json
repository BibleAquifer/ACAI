  "localizations": {
    "eng": {
      "preferred_label": "Hushathites",
      "alternate_labels": [
        "Hushathite",
        "Sibbechai"
      ],
      "descriptions": [
        {
          "source": "acai",
          "gloss": "Hushathites",
          "article": "group:Hushathites",
          "description": "People descended from Hushah, the most notable being Sibbecai, one of King David's mighty men."
        }
      ]
    },
    "apd": {
      "preferred_label": "الحوشاتيين",
      "descriptions": [
        {
          "source": "acai",
          "description": "ناس بينحدروا من حوشة، وأبرزهم كان سبكاي، واحد من أبطال الملك داود."
        }
      ]
    },
    "arb": {
      "preferred_label": "الحوشاتيون",
      "descriptions": [
        {
          "source": "acai",
          "description": "شعب من نسل حوشة، وأبرزهم سبكاي أحد أبطال الملك داود."
        }
      ]
    },
    "bis": {
      "preferred_label": "ol man Husa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol man we oli kamaot long laen blong Husa. Man we i gat nem moa long olgeta hemia Sibekae, wan long ol strongfala soldia blong King Deved."
        }
      ]
    },
    "fra": {
      "preferred_label": "Huschatites",
      "descriptions": [
        {
          "source": "acai",
          "description": "Peuple descendant de Huscha, dont le plus remarquable était Sibbecaï, l’un des vaillants guerriers du roi David."
        }
      ]
    },
    "hau": {
      "preferred_label": "Mutanen Husha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Mutanen da suka fito daga zuriyar Husha, wanda ya fi fice a cikinsu shi ne Sibbekai, ɗaya daga cikin jaruman Sarki Dawuda."
        }
      ]
    },
    "hin": {
      "preferred_label": "हूशाई",
      "descriptions": [
        {
          "source": "acai",
          "description": "हूशाह के वंशज, जिनमें से सबसे प्रमुख राजा दाऊद के शूरवीरों में से एक सिब्बकै था।"
        }
      ]
    },
    "ibo": {
      "preferred_label": "Ndị Husha",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ndị sitere na Husha, onye kachasị mara amara nʼime ha bụ Sibekai, otu nʼime ndị dike Eze Devid."
        }
      ]
    },
    "ind": {
      "preferred_label": "orang Husa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Orang-orang keturunan Husa, yang paling terkemuka adalah Sibkhai, salah satu pahlawan Raja Daud."
        }
      ]
    },
    "nep": {
      "preferred_label": "हूशातीहरू",
      "descriptions": [
        {
          "source": "acai",
          "description": "हूशाका सन्तानहरू, जसमध्ये सबैभन्दा उल्लेखनीय राजा दाऊदका शक्तिशाली योद्धाहरूमध्ये एक सिब्‍बकै थिए।"
        }
      ]
    },
    "por": {
      "preferred_label": "husatitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Pessoas descendentes de Husa, sendo o mais notável Sibecai, um dos guerreiros do rei Davi."
        }
      ]
    },
    "rus": {
      "preferred_label": "Хушатяне",
      "descriptions": [
        {
          "source": "acai",
          "description": "Потомки Хуши; наиболее известным среди них был Совохай, один из храбрых воинов царя Давида."
        }
      ]
    },
    "spa": {
      "preferred_label": "husatitas",
      "descriptions": [
        {
          "source": "acai",
          "description": "Personas descendientes de Husa, siendo el más notable Sibecai, uno de los valientes del rey David."
        }
      ]
    },
    "swh": {
      "preferred_label": "Wahushathi",
      "descriptions": [
        {
          "source": "acai",
          "description": "Watu waliotokana na Husha, maarufu zaidi akiwa Sibekai, mmoja wa mashujaa wa Mfalme Daudi."
        }
      ]
    },
    "tpi": {
      "preferred_label": "lain Husa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Ol manmeri bilong lain bilong Husa; wanpela bilong ol em Sibekai, wanpela bilong ol strongpela soldia bilong King Devit."
        }
      ]
    },
    "vie": {
      "preferred_label": "người Hu-sa",
      "descriptions": [
        {
          "source": "acai",
          "description": "Những người thuộc dòng dõi Hu-sa, trong đó nhân vật nổi bật nhất là Si-bê-cai, một trong những dũng sĩ của Vua Đa-vít."
        }
      ]
    },
    "zhs": {
      "preferred_label": "户沙人",
      "descriptions": [
        {
          "source": "acai",
          "description": "户沙的后裔，其中最著名的是大卫王的勇士之一西比该。"
        }
      ]
    },
    "zht": {
      "preferred_label": "戶沙人",
      "descriptions": [
        {
          "source": "acai",
          "description": "戶沙的後裔，其中最著名的是大衛王勇士之一的西比該。"
        }
      ]
    }
  },
